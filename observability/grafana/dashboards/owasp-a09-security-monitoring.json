{
  "dashboard": {
    "title": "A09: Security Logging & Alerting - Real-Time Monitoring",
    "description": "OWASP Top 10:2025 - Security Event Monitoring & Anomaly Detection",
    "tags": ["security", "owasp", "a09", "monitoring"],
    "timezone": "UTC",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Security Event Timeline",
        "type": "graph",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "rate(security_events_total[5m])",
            "legendFormat": "{{event_type}}"
          }
        ],
        "alert": {
          "name": "High Rate of Security Events",
          "conditions": [
            {
              "evaluator": {"type": "gt", "params": [10]},
              "operator": "and",
              "query": {"params": ["A", "5m", "now"]}
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "message": "Security event rate exceeds threshold"
        }
      },
      {
        "id": 2,
        "title": "Failed Login Attempts (Last Hour)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "increase(security_events_total{event_type='AUTH_LOGIN_FAILURE'}[1h])",
            "legendFormat": "Failed Logins"
          }
        ],
        "thresholds": {"mode": "absolute", "steps": [
          {"color": "green", "value": null},
          {"color": "yellow", "value": 5},
          {"color": "red", "value": 20}
        ]}
      },
      {
        "id": 3,
        "title": "Rate Limit Violations",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 8},
        "targets": [
          {
            "expr": "increase(security_events_total{event_type='VULN_RATE_LIMIT_EXCEEDED'}[1h])",
            "legendFormat": "Rate Limit Hits"
          }
        ],
        "thresholds": {"mode": "absolute", "steps": [
          {"color": "green", "value": null},
          {"color": "yellow", "value": 10},
          {"color": "red", "value": 50}
        ]}
      },
      {
        "id": 4,
        "title": "Authorization Denials",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "increase(security_events_total{event_type='AUTHZ_DENIED'}[1h])",
            "legendFormat": "Auth Denied"
          }
        ],
        "thresholds": {"mode": "absolute", "steps": [
          {"color": "green", "value": null},
          {"color": "yellow", "value": 5},
          {"color": "red", "value": 20}
        ]}
      },
      {
        "id": 5,
        "title": "Critical Security Events",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 8},
        "targets": [
          {
            "expr": "increase(security_events_total{severity='CRITICAL'}[1h])",
            "legendFormat": "Critical Events"
          }
        ],
        "thresholds": {"mode": "absolute", "steps": [
          {"color": "green", "value": 0},
          {"color": "red", "value": 1}
        ]}
      },
      {
        "id": 6,
        "title": "Events by Type (Last Hour)",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [
          {
            "expr": "increase(security_events_total[1h])",
            "legendFormat": "{{event_type}}"
          }
        ]
      },
      {
        "id": 7,
        "title": "Events by Severity",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [
          {
            "expr": "increase(security_events_total[1h])",
            "legendFormat": "{{severity}}"
          }
        ]
      },
      {
        "id": 8,
        "title": "Top IPs with Failed Logins",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
        "targets": [
          {
            "expr": "topk(10, sum by (ip_address) (increase(security_events_total{event_type='AUTH_LOGIN_FAILURE'}[1h])))",
            "format": "table",
            "instant": true
          }
        ]
      },
      {
        "id": 9,
        "title": "Users with Most Authorization Denials",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
        "targets": [
          {
            "expr": "topk(10, sum by (user_id) (increase(security_events_total{event_type='AUTHZ_DENIED'}[1h])))",
            "format": "table",
            "instant": true
          }
        ]
      },
      {
        "id": 10,
        "title": "Security Events (Raw Logs)",
        "type": "logs",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 28},
        "targets": [
          {
            "expr": "{job='agentic-platform'} | json",
            "refId": "A"
          }
        ]
      },
      {
        "id": 11,
        "title": "Admin Actions Last 24h",
        "type": "table",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 36},
        "targets": [
          {
            "expr": "increase(security_events_total{event_type=~'ADMIN_.*'}[24h])",
            "format": "table",
            "instant": true
          }
        ]
      }
    ],
    "alerts": [
      {
        "name": "Brute Force Attack Detected",
        "condition": "A",
        "data": [
          {
            "refId": "A",
            "queryType": "",
            "model": {
              "expr": "increase(security_events_total{event_type='AUTH_LOGIN_FAILURE'}[15m]) > 5"
            }
          }
        ],
        "noDataState": "NoData",
        "execErrState": "Alerting",
        "frequency": "1m",
        "handler": 1,
        "message": "🚨 Brute force attack detected! More than 5 failed login attempts in 15 minutes"
      },
      {
        "name": "Rate Limit Attack",
        "condition": "A",
        "data": [
          {
            "refId": "A",
            "model": {
              "expr": "increase(security_events_total{event_type='VULN_RATE_LIMIT_EXCEEDED'}[5m]) > 50"
            }
          }
        ],
        "message": "🚨 Rate limiting triggered! Possible DoS attack"
      },
      {
        "name": "Critical Security Event",
        "condition": "A",
        "data": [
          {
            "refId": "A",
            "model": {
              "expr": "increase(security_events_total{severity='CRITICAL'}[1m]) > 0"
            }
          }
        ],
        "message": "🚨 CRITICAL security event detected!"
      },
      {
        "name": "Data Integrity Failure",
        "condition": "A",
        "data": [
          {
            "refId": "A",
            "model": {
              "expr": "increase(security_events_total{event_type='DATA_INTEGRITY_FAILURE'}[5m]) > 0"
            }
          }
        ],
        "message": "🚨 Data integrity failure! Possible tampering detected"
      },
      {
        "name": "Unusual Admin Access",
        "condition": "A",
        "data": [
          {
            "refId": "A",
            "model": {
              "expr": "increase(security_events_total{event_type=~'ADMIN_.*'}[1h]) > 20"
            }
          }
        ],
        "message": "⚠️  Unusual amount of admin activity detected"
      }
    ]
  },
  "grafana_version": "11.0.0",
  "uid": "owasp-a09-security-logging"
}
