<%- include('layout', { title: 'Agents', page: 'agents', body: `

<h1 class="text-glow-cyan">Agent Registry</h1>
<p class="subtitle" style="color:var(--text-3);margin-bottom:0.75rem">Register, configure, and manage your fleet of autonomous AI agents. Each agent = <strong style="color:#8b5cf6">LLM + Tools + Memory + Control Logic + Context</strong> in a reasoning loop.</p>
<p style="color:var(--text-3);font-size:0.78rem;margin-bottom:1.5rem;line-height:1.5">Start with one agent, scale to hundreds. Every agent runs the same <strong style="color:#06b6d4">LangGraph ReAct engine</strong> but with its own model, skills, knowledge base, and behavior constraints.</p>

<!-- Action Bar -->
<div class="flex-between mb-2">
  <div style="display:flex;gap:0.5rem;align-items:center">
    <span id="agent-count" class="badge" style="font-size:0.78rem">0 agents</span>
  </div>
  <button class="btn btn-primary" onclick="showAgentForm()">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    New Agent
  </button>
</div>

<!-- Create / Edit Form -->
<div class="card animate-fade-up" id="agent-form" style="display:none">
  <h3 id="agent-form-title">Create Agent</h3>
  <input type="hidden" id="agent-edit-id" value="">

  <!-- Identity -->
  <div style="margin-top:1rem">
    <div class="section-header"><h4 style="font-size:0.82rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-3)">Identity</h4></div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:0.5rem">
      <div>
        <label class="field-label">Name</label>
        <input type="text" id="agent-name" class="input" placeholder="e.g. Research Agent" maxlength="100">
      </div>
      <div>
        <label class="field-label">Description</label>
        <input type="text" id="agent-desc" class="input" placeholder="What this agent does" maxlength="1000">
      </div>
    </div>
  </div>

  <!-- Model -->
  <div style="margin-top:1.25rem">
    <div class="section-header"><h4 style="font-size:0.82rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-3)">Model</h4></div>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem;margin-top:0.5rem">
      <div>
        <label class="field-label">Provider</label>
        <select id="agent-provider" class="input">
          <option value="ollama">Ollama (Local)</option>
          <option value="azure-openai">Azure OpenAI</option>
        </select>
      </div>
      <div>
        <label class="field-label">Model</label>
        <select id="agent-model" class="input">
          <option value="llama3">llama3</option>
        </select>
      </div>
      <div>
        <label class="field-label" style="display:flex;align-items:center;gap:0.35rem">Temperature
          <span class="tc-info-icon" title="Controls randomness: lowering results in less random completions. As the temperature approaches zero, the model will become deterministic and repetitive.">&#9432;</span>
        </label>
        <input type="number" id="agent-temp" class="input" min="0" max="2" step="0.1" value="0.7">
      </div>
      <div>
        <label class="field-label" style="display:flex;align-items:center;gap:0.35rem">Top P
          <span class="tc-info-icon" title="Similar to temperature, this controls randomness but uses a different method. Lowering Top P will narrow the model's token selection to likelier tokens. Increasing Top P will let the model choose from tokens with both high and low likelihood. Try adjusting temperature or Top P but not both.">&#9432;</span>
        </label>
        <input type="number" id="agent-top-p" class="input" min="0" max="1" step="0.1" value="1">
      </div>
    </div>
  </div>

  <!-- Context Engineering -->
  <div style="margin-top:1.25rem">
    <div class="section-header"><h4 style="font-size:0.82rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-3)">Context Engineering</h4></div>
    <div style="margin-top:0.5rem">
      <label class="field-label">Prompt <span style="color:var(--text-3);font-weight:400;font-size:0.75rem">— instructional context: defines what the agent should do, its persona, and output format</span></label>
      <textarea id="agent-prompt" class="input" rows="4" placeholder="e.g. You are a senior code reviewer. Analyze code for bugs, security issues, and best practices. Always explain your reasoning..." style="resize:vertical;font-family:var(--mono)"></textarea>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:0.75rem">
      <div>
        <label class="field-label">Skills <span style="color:var(--text-3);font-weight:400">(select multiple)</span></label>
        <select id="agent-skills-list" class="input" multiple style="height:120px;font-size:0.82rem"></select>
      </div>
      <div>
        <label class="field-label">Tools <span style="color:var(--text-3);font-weight:400">(select multiple, empty = all)</span></label>
        <select id="agent-tools-list" class="input" multiple style="height:120px;font-size:0.82rem"></select>
      </div>
    </div>
  </div>

  <!-- Knowledge Base & Settings -->
  <div style="margin-top:1.25rem">
    <div class="section-header"><h4 style="font-size:0.82rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-3)">Knowledge Base</h4></div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:0.5rem">
      <div>
        <label class="field-label">Collection Name</label>
        <input type="text" id="agent-kb" class="input" value="agentic_docs" placeholder="ChromaDB collection name">
        <p style="color:var(--text-3);font-size:0.7rem;margin:0.25rem 0 0">The ChromaDB collection this agent retrieves knowledge from</p>
      </div>
      <div>
        <label class="field-label">Upload Knowledge <span style="color:var(--text-3);font-weight:400;font-size:0.75rem">— upload a file or paste text</span></label>
        <div style="display:flex;gap:0.5rem;align-items:center;margin-bottom:0.5rem">
          <label class="btn btn-sm" style="cursor:pointer;display:inline-flex;align-items:center;gap:0.35rem" for="agent-kb-file">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            Choose File
          </label>
          <input type="file" id="agent-kb-file" accept=".txt,.md,.csv,.json,.pdf,.html,.htm,.xml,.yaml,.yml,.log,.py,.js,.ts,.sql" style="display:none" onchange="handleFileSelect(this)">
          <span id="agent-kb-filename" style="color:var(--text-3);font-size:0.78rem">No file selected</span>
        </div>
        <textarea id="agent-kb-text" class="input" rows="3" placeholder="Or paste document text here... it will be chunked and embedded into the collection above." style="resize:vertical;font-size:0.82rem"></textarea>
        <div style="display:flex;gap:0.5rem;align-items:center;margin-top:0.5rem">
          <input type="text" id="agent-kb-source" class="input" placeholder="Source name (e.g. faq.pdf)" style="flex:1;font-size:0.82rem">
          <button type="button" class="btn btn-sm" onclick="uploadKB()" id="kb-upload-btn" style="white-space:nowrap">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            Upload
          </button>
        </div>
        <div id="kb-upload-result" style="font-size:0.75rem;margin-top:0.25rem;color:var(--success)"></div>
      </div>
    </div>
  </div>

  <!-- Settings -->
  <div style="margin-top:1.25rem">
    <div class="section-header"><h4 style="font-size:0.82rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-3)">Settings</h4></div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:0.5rem">
      <div>
        <label class="field-label">Max Iterations</label>
        <input type="number" id="agent-iterations" class="input" min="1" max="20" value="5">
      </div>
      <div>
        <label class="field-label">Memory</label>
        <select id="agent-memory" class="input">
          <option value="1">Enabled</option>
          <option value="0">Disabled</option>
        </select>
      </div>
    </div>
  </div>

  <div style="display:flex;gap:0.75rem;margin-top:1.5rem">
    <button class="btn btn-primary" onclick="saveAgent()">Save Agent</button>
    <button class="btn" onclick="hideAgentForm()">Cancel</button>
  </div>
</div>

<!-- Agents Grid -->
<div id="agents-grid" class="grid-2" style="margin-top:1rem"></div>

<script>
  let allSkillsList = [];
  let allToolsList = [];
  let allModelsList = [];

  async function loadSkillsList() {
    try {
      const r = await fetch('/api/skills');
      const d = await r.json();
      allSkillsList = d.skills || [];
    } catch(e) {}
  }

  async function loadToolsList() {
    try {
      const r = await fetch('/api/tools');
      const d = await r.json();
      allToolsList = (d.tools || []).map(t => t.name);
    } catch(e) {}
  }

  async function loadModelsList() {
    try {
      const r = await fetch('/api/models');
      const d = await r.json();
      allModelsList = (d.models || []).map(m => m.name || m.model || m);
    } catch(e) {}
  }

  function renderModelDropdown(selectedModel) {
    const el = document.getElementById('agent-model');
    const models = allModelsList.length > 0 ? allModelsList : ['llama3'];
    el.innerHTML = models.map(m =>
      '<option value="' + escapeHtml(m) + '"' + (m === selectedModel ? ' selected' : '') + '>' + escapeHtml(m) + '</option>'
    ).join('');
    if (selectedModel && !models.includes(selectedModel)) {
      el.innerHTML += '<option value="' + escapeHtml(selectedModel) + '" selected>' + escapeHtml(selectedModel) + '</option>';
    }
  }

  function renderToolCheckboxes(selectedIds) {
    const el = document.getElementById('agent-tools-list');
    if (allToolsList.length === 0) {
      el.innerHTML = '<option disabled>No tools available</option>';
      return;
    }
    el.innerHTML = allToolsList.map(t =>
      '<option value="' + escapeHtml(t) + '"' + (selectedIds.includes(t) ? ' selected' : '') + '>🔧 ' + escapeHtml(t) + '</option>'
    ).join('');
  }

  function getSelectedToolIds() {
    return Array.from(document.getElementById('agent-tools-list').selectedOptions).map(o => o.value);
  }

  function renderSkillCheckboxes(selectedIds) {
    const el = document.getElementById('agent-skills-list');
    if (allSkillsList.length === 0) {
      el.innerHTML = '<option disabled>No skills created yet</option>';
      return;
    }
    el.innerHTML = allSkillsList.map(s =>
      '<option value="' + escapeHtml(s.id) + '"' + (selectedIds.includes(s.id) ? ' selected' : '') + '>⚡ ' + escapeHtml(s.name) + '</option>'
    ).join('');
  }

  function getSelectedSkillIds() {
    return Array.from(document.getElementById('agent-skills-list').selectedOptions).map(o => o.value);
  }

  async function loadAgents() {
    try {
      const r = await fetch('/api/agents');
      const d = await r.json();
      const agents = d.agents || [];
      document.getElementById('agent-count').textContent = agents.length + ' agent' + (agents.length !== 1 ? 's' : '');
      const grid = document.getElementById('agents-grid');
      if (agents.length === 0) {
        grid.innerHTML = '<div class="card" style="grid-column:1/-1;text-align:center;padding:3rem;color:var(--text-3)"><p style="font-size:1.1rem">No agents found</p></div>';
        return;
      }
      grid.innerHTML = agents.map(a => {
        const skillBadges = (a.skill_ids||[]).map(sid => {
          const sk = allSkillsList.find(s => s.id === sid);
          return '<span class="badge">⚡ ' + escapeHtml(sk ? sk.name : sid) + '</span>';
        }).join(' ');
        const toolBadges = (a.tool_ids||[]).slice(0,3).map(t => '<span class="badge">' + escapeHtml(t) + '</span>').join(' ');
        const isDefault = a.is_default ? ' <span class="badge" style="background:rgba(6,182,212,0.15);color:#06b6d4">default</span>' : '';
        return '<div class="card animate-fade-up">' +
          '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem">' +
            '<h3 style="margin:0;font-size:1.05rem">🤖 ' + escapeHtml(a.name) + isDefault + '</h3>' +
            '<span class="mono" style="font-size:0.68rem;color:var(--text-3)">' + escapeHtml(a.id) + '</span>' +
          '</div>' +
          '<p style="color:var(--text-3);font-size:0.82rem;margin:0 0 0.75rem 0">' + escapeHtml(a.description || 'No description') + '</p>' +
          '<div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem;font-size:0.78rem;color:var(--text-2)">' +
            '<div><strong>Provider:</strong> ' + escapeHtml(a.provider) + '</div>' +
            '<div><strong>Model:</strong> ' + escapeHtml(a.model) + '</div>' +
            '<div><strong>Temp:</strong> ' + a.temperature + '</div>' +
            '<div><strong>Top P:</strong> ' + (a.top_p != null ? a.top_p : 1) + '</div>' +
            '<div><strong>Max Iter:</strong> ' + a.max_iterations + '</div>' +
            '<div><strong>KB:</strong> ' + escapeHtml(a.kb_collection) + '</div>' +
            '<div><strong>Memory:</strong> ' + (a.memory_enabled ? 'On' : 'Off') + '</div>' +
          '</div>' +
          (a.system_prompt ? '<div style="margin-top:0.75rem;background:var(--input-bg);border-radius:8px;padding:0.5rem 0.75rem;font-size:0.72rem;font-family:var(--mono);color:var(--text-2);max-height:50px;overflow:hidden">' + escapeHtml(a.system_prompt.slice(0,200)) + (a.system_prompt.length > 200 ? '...' : '') + '</div>' : '') +
          '<div style="display:flex;flex-wrap:wrap;gap:0.25rem;margin-top:0.75rem">' + skillBadges + ' ' + toolBadges + '</div>' +
          '<div style="display:flex;gap:0.5rem;margin-top:1rem;border-top:1px solid var(--glass-border);padding-top:0.75rem">' +
            '<button class="btn btn-sm" onclick="editAgent(\\'' + escapeHtml(a.id) + '\\')">Edit</button>' +
            (a.is_default ? '' : '<button class="btn btn-sm btn-danger" onclick="deleteAgent(\\'' + escapeHtml(a.id) + '\\')">Delete</button>') +
          '</div>' +
        '</div>';
      }).join('');
    } catch(e) {
      document.getElementById('agents-grid').innerHTML = '<div class="card" style="color:var(--danger)">Error: ' + escapeHtml(e.message) + '</div>';
    }
  }

  // ── Form state persistence (survives navigation) ──
  const DRAFT_KEY = 'agentDraft';
  function saveDraft() {
    const draft = {
      id: document.getElementById('agent-edit-id').value,
      name: document.getElementById('agent-name').value,
      desc: document.getElementById('agent-desc').value,
      provider: document.getElementById('agent-provider').value,
      model: document.getElementById('agent-model').value,
      temp: document.getElementById('agent-temp').value,
      prompt: document.getElementById('agent-prompt').value,
      tools: Array.from(document.getElementById('agent-tools-list').selectedOptions).map(o => o.value),
      skills: Array.from(document.getElementById('agent-skills-list').selectedOptions).map(o => o.value),
      kb: document.getElementById('agent-kb').value,
      iterations: document.getElementById('agent-iterations').value,
      memory: document.getElementById('agent-memory').value,
      formTitle: document.getElementById('agent-form-title').textContent,
    };
    if (draft.name || draft.prompt || draft.desc) {
      localStorage.setItem(DRAFT_KEY, JSON.stringify(draft));
    }
  }
  function clearAgentDraft() { localStorage.removeItem(DRAFT_KEY); }
  function restoreAgentDraft() {
    const raw = localStorage.getItem(DRAFT_KEY);
    if (!raw) return;
    try {
      const d = JSON.parse(raw);
      document.getElementById('agent-edit-id').value = d.id || '';
      document.getElementById('agent-name').value = d.name || '';
      document.getElementById('agent-desc').value = d.desc || '';
      document.getElementById('agent-provider').value = d.provider || 'ollama';
      if (d.model) renderModelDropdown(d.model);
      document.getElementById('agent-temp').value = d.temp || '0.7';
      document.getElementById('agent-prompt').value = d.prompt || '';
      if (d.tools && d.tools.length) renderToolCheckboxes(d.tools);
      if (d.skills && d.skills.length) renderSkillCheckboxes(d.skills);
      document.getElementById('agent-kb').value = d.kb || 'agentic_docs';
      document.getElementById('agent-iterations').value = d.iterations || '5';
      document.getElementById('agent-memory').value = d.memory || '1';
      document.getElementById('agent-form-title').textContent = d.formTitle || 'Create Agent';
      document.getElementById('agent-form').style.display = 'block';
    } catch(e) { clearAgentDraft(); }
  }
  // Auto-save on input
  ['agent-name','agent-desc','agent-provider','agent-model','agent-temp','agent-prompt','agent-kb','agent-iterations','agent-memory'].forEach(id => {
    const el = document.getElementById(id);
    if (el) { el.addEventListener('input', saveDraft); el.addEventListener('change', saveDraft); }
  });
  document.getElementById('agent-tools-list').addEventListener('change', saveDraft);
  document.getElementById('agent-skills-list').addEventListener('change', saveDraft);

  async function showAgentForm() {
    await Promise.all([loadSkillsList(), loadToolsList(), loadModelsList()]);
    clearAgentDraft();
    document.getElementById('agent-form-title').textContent = 'Create Agent';
    document.getElementById('agent-edit-id').value = '';
    document.getElementById('agent-name').value = '';
    document.getElementById('agent-desc').value = '';
    document.getElementById('agent-provider').value = 'ollama';
    renderModelDropdown('llama3');
    document.getElementById('agent-temp').value = '0.7';
    document.getElementById('agent-prompt').value = '';
    renderToolCheckboxes([]);
    document.getElementById('agent-kb').value = 'agentic_docs';
    document.getElementById('agent-iterations').value = '5';
    document.getElementById('agent-memory').value = '1';
    renderSkillCheckboxes([]);
    document.getElementById('agent-kb-filename').textContent = 'No file selected';
    document.getElementById('agent-kb-text').value = '';
    document.getElementById('agent-kb-source').value = '';
    document.getElementById('kb-upload-result').textContent = '';
    document.getElementById('agent-form').style.display = 'block';
    document.getElementById('agent-name').focus();
  }

  function hideAgentForm() {
    clearAgentDraft();
    document.getElementById('agent-form').style.display = 'none';
  }

  async function editAgent(id) {
    await Promise.all([loadSkillsList(), loadToolsList(), loadModelsList()]);
    try {
      const r = await fetch('/api/agents/' + id);
      const a = await r.json();
      document.getElementById('agent-form-title').textContent = 'Edit Agent';
      document.getElementById('agent-edit-id').value = a.id;
      document.getElementById('agent-name').value = a.name;
      document.getElementById('agent-desc').value = a.description || '';
      document.getElementById('agent-provider').value = a.provider || 'ollama';
      renderModelDropdown(a.model || 'llama3');
      document.getElementById('agent-temp').value = a.temperature || 0.7;
      document.getElementById('agent-top-p').value = a.top_p != null ? a.top_p : 1;
      document.getElementById('agent-prompt').value = a.system_prompt || '';
      renderToolCheckboxes(a.tool_ids || []);
      document.getElementById('agent-kb').value = a.kb_collection || 'agentic_docs';
      document.getElementById('agent-iterations').value = a.max_iterations || 5;
      document.getElementById('agent-memory').value = a.memory_enabled ? '1' : '0';
      renderSkillCheckboxes(a.skill_ids || []);
      document.getElementById('agent-kb-filename').textContent = 'No file selected';
      document.getElementById('agent-kb-text').value = '';
      document.getElementById('agent-kb-source').value = '';
      document.getElementById('kb-upload-result').textContent = '';
      document.getElementById('agent-form').style.display = 'block';
      document.getElementById('agent-name').focus();
    } catch(e) { alert('Error: ' + e.message); }
  }

  async function saveAgent() {
    const id = document.getElementById('agent-edit-id').value;
    const payload = {
      name: document.getElementById('agent-name').value.trim(),
      description: document.getElementById('agent-desc').value.trim(),
      provider: document.getElementById('agent-provider').value,
      model: document.getElementById('agent-model').value.trim(),
      temperature: parseFloat(document.getElementById('agent-temp').value) || 0.7,
      top_p: parseFloat(document.getElementById('agent-top-p').value),
      system_prompt: document.getElementById('agent-prompt').value.trim(),
      skill_ids: getSelectedSkillIds(),
      tool_ids: getSelectedToolIds(),
      kb_collection: document.getElementById('agent-kb').value.trim() || 'agentic_docs',
      max_iterations: parseInt(document.getElementById('agent-iterations').value) || 5,
      memory_enabled: document.getElementById('agent-memory').value === '1',
    };
    if (!payload.name) { alert('Name is required'); return; }
    try {
      const url = id ? '/api/agents/' + id : '/api/agents';
      const method = id ? 'PUT' : 'POST';
      await fetch(url, { method, headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
      clearAgentDraft();
      hideAgentForm();
      loadAgents();
    } catch(e) { alert('Error: ' + e.message); }
  }

  async function deleteAgent(id) {
    if (!confirm('Delete this agent?')) return;
    try {
      await fetch('/api/agents/' + id, { method: 'DELETE' });
      loadAgents();
    } catch(e) { alert('Error: ' + e.message); }
  }

  function handleFileSelect(input) {
    const file = input.files[0];
    const nameEl = document.getElementById('agent-kb-filename');
    if (!file) { nameEl.textContent = 'No file selected'; return; }
    nameEl.textContent = file.name;
    // Auto-fill source name from file name
    if (!document.getElementById('agent-kb-source').value.trim()) {
      document.getElementById('agent-kb-source').value = file.name;
    }
    // Read file as text
    const reader = new FileReader();
    reader.onload = function(e) {
      document.getElementById('agent-kb-text').value = e.target.result;
    };
    reader.onerror = function() {
      nameEl.textContent = 'Error reading file';
    };
    reader.readAsText(file);
  }

  async function uploadKB() {
    const text = document.getElementById('agent-kb-text').value.trim();
    const source = document.getElementById('agent-kb-source').value.trim();
    const collection = document.getElementById('agent-kb').value.trim() || 'agentic_docs';
    const resultEl = document.getElementById('kb-upload-result');
    if (!text) { resultEl.style.color='var(--danger)'; resultEl.textContent='Upload a file or paste text first'; return; }
    if (!source) { resultEl.style.color='var(--danger)'; resultEl.textContent='Enter a source name'; return; }
    const btn = document.getElementById('kb-upload-btn');
    btn.disabled = true; btn.textContent = 'Uploading...';
    resultEl.textContent = '';
    try {
      const r = await fetch('/api/documents/ingest', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ text, source, collection, chunk_size: 1000, chunk_overlap: 200 })
      });
      const d = await r.json();
      resultEl.style.color='var(--success)';
      resultEl.textContent = 'Uploaded ' + (d.chunks_stored || '?') + ' chunks to "' + collection + '"';
      document.getElementById('agent-kb-text').value = '';
      document.getElementById('agent-kb-source').value = '';
      document.getElementById('agent-kb-filename').textContent = 'No file selected';
      document.getElementById('agent-kb-file').value = '';
    } catch(e) {
      resultEl.style.color='var(--danger)';
      resultEl.textContent = 'Upload failed: ' + e.message;
    } finally {
      btn.disabled = false; btn.textContent = 'Upload';
    }
  }

  Promise.all([loadSkillsList(), loadToolsList(), loadModelsList()]).then(() => { loadAgents(); restoreAgentDraft(); });
</script>

` }) %>
