<%- include('layout', { title: 'Agent Registry', page: 'agents', body: `

<h1 class="text-glow-cyan">Agent Registry</h1>
<p class="subtitle" style="color:var(--text-3);margin-bottom:0.75rem">Register, configure, and manage your fleet of autonomous AI agents. Each agent = <strong style="color:#8b5cf6">LLM + Tools + Memory + Control Logic + Context</strong> in a reasoning loop.</p>
<p style="color:var(--text-3);font-size:0.78rem;margin-bottom:1.5rem;line-height:1.5">Start with one agent, scale to hundreds. Every agent runs the same <strong style="color:#06b6d4">LangGraph ReAct engine</strong> but with its own model, skills, knowledge base, and behavior constraints.</p>

<!-- Agent Anatomy & Scale (collapsible) -->
<style>
  details[open] > summary .details-chevron { transform: rotate(90deg); }
  details > summary::-webkit-details-marker { display: none; }
</style>
<details style="margin-bottom:1.5rem">
  <summary style="cursor:pointer;font-size:0.85rem;font-weight:600;color:var(--text-2);padding:0.6rem 0;list-style:none;display:flex;align-items:center;gap:0.5rem;user-select:none">
    <svg class="details-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" style="transition:transform 0.2s;flex-shrink:0"><path d="M9 18l6-6-6-6"/></svg>
    What is an Agent? — Anatomy &amp; Scale
  </summary>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:0.5rem">
  <!-- Left: Agent anatomy -->
  <div class="card animate-fade-up" style="margin:0;padding:1.25rem">
    <strong style="font-size:0.9rem;color:#8b5cf6;display:block;margin-bottom:0.75rem">Each Agent Has:</strong>
    <div style="display:flex;flex-direction:column;gap:0.5rem">
      <div style="display:flex;align-items:center;gap:0.6rem">
        <div style="width:28px;height:28px;border-radius:8px;background:rgba(139,92,246,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#8b5cf6" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83"/></svg>
        </div>
        <div><strong style="font-size:0.8rem">LLM (brain)</strong> <span style="color:var(--text-3);font-size:0.75rem">— Ollama, Azure OpenAI, OpenAI, or Foundry</span></div>
      </div>
      <div style="display:flex;align-items:center;gap:0.6rem">
        <div style="width:28px;height:28px;border-radius:8px;background:rgba(6,182,212,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#06b6d4" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        </div>
        <div><strong style="font-size:0.8rem">Tools (actions)</strong> <span style="color:var(--text-3);font-size:0.75rem">— web_search, code_execute, file_read, http_fetch</span></div>
      </div>
      <div style="display:flex;align-items:center;gap:0.6rem">
        <div style="width:28px;height:28px;border-radius:8px;background:rgba(244,63,94,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#f43f5e" stroke-width="2"><path d="M12 2a9 9 0 0 1 9 9c0 3.9-3.1 7.1-5 8.9a13 13 0 0 1-4 2.1 13 13 0 0 1-4-2.1C6.1 18.1 3 14.9 3 11a9 9 0 0 1 9-9z"/></svg>
        </div>
        <div><strong style="font-size:0.8rem">Memory (state)</strong> <span style="color:var(--text-3);font-size:0.75rem">— conversation history + session context</span></div>
      </div>
      <div style="display:flex;align-items:center;gap:0.6rem">
        <div style="width:28px;height:28px;border-radius:8px;background:rgba(245,158,11,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        </div>
        <div><strong style="font-size:0.8rem">Control Logic (skills)</strong> <span style="color:var(--text-3);font-size:0.75rem">— prompt + behavior constraints</span></div>
      </div>
      <div style="display:flex;align-items:center;gap:0.6rem">
        <div style="width:28px;height:28px;border-radius:8px;background:rgba(16,185,129,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#10b981" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        </div>
        <div><strong style="font-size:0.8rem">Knowledge Base (RAG)</strong> <span style="color:var(--text-3);font-size:0.75rem">— embed → ChromaDB → similarity search</span></div>
      </div>
      <div style="display:flex;align-items:center;gap:0.6rem">
        <div style="width:28px;height:28px;border-radius:8px;background:rgba(59,130,246,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#3b82f6" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </div>
        <div><strong style="font-size:0.8rem">Context (input)</strong> <span style="color:var(--text-3);font-size:0.75rem">— system prompt + user prompt + injected RAG docs</span></div>
      </div>
    </div>
  </div>

  <!-- Right: Scale vision -->
  <div class="card animate-fade-up" style="margin:0;padding:1.25rem">
    <strong style="font-size:0.9rem;color:#f59e0b;display:block;margin-bottom:0.5rem">Think: 100s of Agents</strong>
    <p style="color:var(--text-3);font-size:0.8rem;line-height:1.6;margin:0 0 0.75rem">This platform is an <strong style="color:var(--text-1)">agent registry</strong>. Each use case gets its own agent with a dedicated configuration. All share the same runtime engine.</p>
    <div style="display:flex;flex-direction:column;gap:0.4rem">
      <div style="padding:0.55rem 0.85rem;border-radius:10px;background:rgba(139,92,246,0.08);border:1px solid rgba(139,92,246,0.15);display:flex;justify-content:space-between;align-items:center">
        <div><strong style="font-size:0.78rem;color:#8b5cf6">Finance Analyst</strong> <span style="color:var(--text-3);font-size:0.68rem">llama3 &bull; web_search, file_read</span></div>
        <span style="font-size:0.65rem;color:var(--text-3)">Agent #1</span>
      </div>
      <div style="padding:0.55rem 0.85rem;border-radius:10px;background:rgba(6,182,212,0.08);border:1px solid rgba(6,182,212,0.15);display:flex;justify-content:space-between;align-items:center">
        <div><strong style="font-size:0.78rem;color:#06b6d4">Customer Support</strong> <span style="color:var(--text-3);font-size:0.68rem">gpt-4.1-mini (foundry) &bull; KB: faq-docs</span></div>
        <span style="font-size:0.65rem;color:var(--text-3)">Agent #2</span>
      </div>
      <div style="padding:0.55rem 0.85rem;border-radius:10px;background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.15);display:flex;justify-content:space-between;align-items:center">
        <div><strong style="font-size:0.78rem;color:#10b981">Content Writer</strong> <span style="color:var(--text-3);font-size:0.68rem">llama3 &bull; web_search, notes</span></div>
        <span style="font-size:0.65rem;color:var(--text-3)">Agent #3</span>
      </div>
      <div style="padding:0.55rem 0.85rem;border-radius:10px;background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.15);display:flex;justify-content:space-between;align-items:center">
        <div><strong style="font-size:0.78rem;color:#f59e0b">QA Tester</strong> <span style="color:var(--text-3);font-size:0.68rem">gpt-4o (azure) &bull; code_execute, http_fetch</span></div>
        <span style="font-size:0.65rem;color:var(--text-3)">Agent #4</span>
      </div>
      <div style="padding:0.55rem 0.85rem;border-radius:10px;background:rgba(139,92,246,0.05);border:1px dashed var(--glass-border);display:flex;justify-content:space-between;align-items:center">
        <div><span style="color:var(--text-3);font-size:0.78rem;font-style:italic">... Data Analyst, Compliance Checker, Sales Rep, Research Analyst ...</span></div>
        <span style="font-size:0.65rem;color:var(--text-3)">Agent #N</span>
      </div>
    </div>
    <p style="color:var(--text-3);font-size:0.72rem;margin:0.6rem 0 0;line-height:1.5">Every agent runs the same <strong style="color:#06b6d4">LangGraph ReAct loop</strong> — but each with its own LLM, tools, memory, knowledge base, and skills. Create one agent or create hundreds.</p>
  </div>
</div>
</details>

<!-- Action Bar -->
<div class="flex-between mb-2">
  <div style="display:flex;gap:0.5rem;align-items:center">
    <span id="agent-count" class="badge" style="font-size:0.78rem">0 agents</span>
    <select id="owner-filter" class="input" style="width:auto;min-width:160px;height:34px;font-size:0.78rem;display:none" onchange="loadAgents()">
      <option value="">All Users</option>
    </select>
  </div>
  <button class="btn btn-primary" onclick="showAgentForm()">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    New Agent
  </button>
</div>

<!-- Create / Edit Form -->
<div class="card animate-fade-up" id="agent-form" style="display:none">
  <h3 id="agent-form-title">Create Agent</h3>
  <input type="hidden" id="agent-edit-id" value="">

  <!-- Identity -->
  <div style="margin-top:1rem">
    <div class="section-header"><h4 style="font-size:0.82rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-3)">Identity</h4></div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:0.5rem">
      <div>
        <label class="field-label">Name</label>
        <input type="text" id="agent-name" class="input" placeholder="e.g. Research Agent" maxlength="100">
      </div>
      <div>
        <label class="field-label">Description</label>
        <input type="text" id="agent-desc" class="input" placeholder="What this agent does" maxlength="1000">
      </div>
    </div>
  </div>

  <!-- Model -->
  <div style="margin-top:1.25rem">
    <div class="section-header"><h4 style="font-size:0.82rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-3)">Model</h4></div>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem;margin-top:0.5rem">
      <div>
        <label class="field-label">Provider</label>
        <select id="agent-provider" class="input">
          <option value="ollama">Ollama (Local)</option>
          <option value="azure-openai">Azure OpenAI</option>
        </select>
      </div>
      <div>
        <label class="field-label">Model</label>
        <select id="agent-model" class="input">
          <option value="llama3">llama3</option>
        </select>
      </div>
      <div>
        <label class="field-label" style="display:flex;align-items:center;gap:0.35rem">Temperature
          <span class="tc-info-icon" data-tooltip="Controls randomness: lowering results in less random completions. As the temperature approaches zero, the model will become deterministic and repetitive.">&#9432;</span>
        </label>
        <input type="number" id="agent-temp" class="input" min="0" max="2" step="0.1" value="0.7">
      </div>
      <div>
        <label class="field-label" style="display:flex;align-items:center;gap:0.35rem">Top P
          <span class="tc-info-icon" data-tooltip="Similar to temperature, this controls randomness but uses a different method. Lowering Top P narrows token selection to likelier tokens. Increasing Top P lets the model choose from tokens with both high and low likelihood. Adjust temperature or Top P but not both.">&#9432;</span>
        </label>
        <input type="number" id="agent-top-p" class="input" min="0" max="1" step="0.1" value="1">
      </div>
    </div>
  </div>

  <!-- Context Engineering -->
  <div style="margin-top:1.25rem">
    <div class="section-header"><h4 style="font-size:0.82rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-3)">Context Engineering</h4></div>
    <div style="margin-top:0.5rem">
      <label class="field-label">Prompt <span style="color:var(--text-3);font-weight:400;font-size:0.75rem">— instructional context: defines what the agent should do, its persona, and output format</span></label>
      <textarea id="agent-prompt" class="input" rows="4" placeholder="e.g. You are a senior code reviewer. Analyze code for bugs, security issues, and best practices. Always explain your reasoning..." style="resize:vertical;font-family:var(--mono)"></textarea>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:0.75rem">
      <div>
        <label class="field-label">Skills <span style="color:var(--text-3);font-weight:400">(select multiple)</span></label>
        <select id="agent-skills-list" class="input" multiple style="height:120px;font-size:0.82rem"></select>
      </div>
      <div>
        <label class="field-label">Tools <span style="color:var(--text-3);font-weight:400">(select multiple, empty = all)</span></label>
        <select id="agent-tools-list" class="input" multiple style="height:120px;font-size:0.82rem"></select>
      </div>
    </div>
    <div style="margin-top:0.75rem">
      <label class="field-label">MCP Servers <span style="color:var(--text-3);font-weight:400">(select multiple — bind external tool servers)</span></label>
      <select id="agent-mcp-servers" class="input" multiple style="height:80px;font-size:0.82rem"></select>
    </div>
  </div>

  <!-- Knowledge Base & Settings -->
  <div style="margin-top:1.25rem">
    <div class="section-header"><h4 style="font-size:0.82rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-3)">Knowledge Base</h4></div>
    <p style="color:var(--text-3);font-size:0.72rem;margin:0.35rem 0 0.75rem;line-height:1.4">Each agent gets its own isolated knowledge base. Upload new documents or reuse existing ones from other collections.</p>

    <!-- Tab switcher -->
    <div style="display:flex;gap:0;margin-bottom:0.75rem;border:1px solid var(--glass-border);border-radius:8px;overflow:hidden">
      <button type="button" class="btn btn-sm" id="kb-tab-upload" onclick="switchKBTab('upload')" style="flex:1;border-radius:0;border:none;background:rgba(6,182,212,0.15);color:#06b6d4;font-size:0.78rem">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        Upload New
      </button>
      <button type="button" class="btn btn-sm" id="kb-tab-reuse" onclick="switchKBTab('reuse')" style="flex:1;border-radius:0;border:none;border-left:1px solid var(--glass-border);font-size:0.78rem">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
        Reuse Existing
      </button>
    </div>

    <!-- Upload tab -->
    <div id="kb-panel-upload">
      <div style="display:flex;gap:0.5rem;align-items:center;margin-bottom:0.5rem">
        <label class="btn btn-sm" style="cursor:pointer;display:inline-flex;align-items:center;gap:0.35rem" for="agent-kb-file">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          Choose File
        </label>
        <input type="file" id="agent-kb-file" accept=".txt,.md,.csv,.json,.pdf,.html,.htm,.xml,.yaml,.yml,.log,.py,.js,.ts,.sql" style="display:none" onchange="handleFileSelect(this)">
        <span id="agent-kb-filename" style="color:var(--text-3);font-size:0.78rem">No file selected</span>
      </div>
      <textarea id="agent-kb-text" class="input" rows="3" placeholder="Or paste document text here... it will be chunked and embedded into this agent's isolated collection." style="resize:vertical;font-size:0.82rem"></textarea>
      <div style="display:flex;gap:0.5rem;align-items:center;margin-top:0.5rem">
        <input type="text" id="agent-kb-source" class="input" placeholder="Source name (e.g. faq.pdf)" style="flex:1;font-size:0.82rem">
        <button type="button" class="btn btn-sm" onclick="uploadKB()" id="kb-upload-btn" style="white-space:nowrap">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          Upload
        </button>
      </div>
      <div id="kb-upload-result" style="font-size:0.75rem;margin-top:0.25rem;color:var(--success)"></div>
    </div>

    <!-- Reuse existing KB tab -->
    <div id="kb-panel-reuse" style="display:none">
      <p style="color:var(--text-3);font-size:0.72rem;margin:0 0 0.5rem">Select documents from existing knowledge bases to copy into this agent's collection:</p>
      <div id="kb-reuse-list" style="max-height:220px;overflow-y:auto;border:1px solid var(--glass-border);border-radius:8px;padding:0.5rem">
        <p style="color:var(--text-3);font-size:0.78rem;text-align:center">Loading collections...</p>
      </div>
      <div style="display:flex;gap:0.5rem;align-items:center;margin-top:0.5rem">
        <button type="button" class="btn btn-sm" onclick="copySelectedDocs()" id="kb-copy-btn" style="white-space:nowrap">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          Copy Selected to Agent KB
        </button>
        <span id="kb-copy-result" style="font-size:0.75rem;color:var(--success)"></span>
      </div>
    </div>

    <!-- Agent's KB documents -->
    <div id="agent-kb-docs" style="margin-top:0.75rem;display:none">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.35rem">
        <span style="font-size:0.75rem;color:var(--text-3);font-weight:600;text-transform:uppercase;letter-spacing:0.03em">Agent's Documents</span>
        <span id="agent-kb-doc-count" class="badge" style="font-size:0.7rem">0 docs</span>
      </div>
      <div id="agent-kb-doc-list" style="display:flex;flex-wrap:wrap;gap:0.35rem"></div>
    </div>

    <input type="hidden" id="agent-kb" value="">
  </div>

  <!-- Settings -->
  <div style="margin-top:1.25rem">
    <div class="section-header"><h4 style="font-size:0.82rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-3)">Settings</h4></div>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem;margin-top:0.5rem">
      <div>
        <label class="field-label">Max Iterations</label>
        <input type="number" id="agent-iterations" class="input" min="1" max="20" value="5">
      </div>
      <div>
        <label class="field-label">Memory</label>
        <select id="agent-memory" class="input">
          <option value="1">Enabled</option>
          <option value="0">Disabled</option>
        </select>
      </div>
      <div>
        <label class="field-label">Retrieval Mode</label>
        <select id="agent-retrieval-mode" class="input">
          <option value="basic">Basic (fast)</option>
          <option value="advanced">Advanced (hybrid + rerank)</option>
          <option value="none">None (tools only)</option>
        </select>
      </div>
    </div>
  </div>

  <div style="display:flex;gap:0.75rem;margin-top:1.5rem">
    <button class="btn btn-primary" onclick="saveAgent()">Save Agent</button>
    <button class="btn" onclick="hideAgentForm()">Cancel</button>
  </div>
</div>

<!-- Agents Grid -->
<div id="agents-grid" class="grid-2" style="margin-top:1rem"></div>

<script>
  let allSkillsList = [];
  let allToolsList = [];
  let allModelsList = [];
  let allCollections = [];

  async function loadSkillsList() {
    try {
      const r = await fetch('/api/skills');
      const d = await r.json();
      allSkillsList = d.skills || [];
    } catch(e) {}
  }

  async function loadToolsList() {
    try {
      const r = await fetch('/api/tools');
      const d = await r.json();
      allToolsList = (d.tools || []).map(t => t.name);
    } catch(e) {}
  }

  async function loadModelsList() {
    try {
      const r = await fetch('/api/models');
      const d = await r.json();
      allModelsList = (d.models || []).map(m => m.name || m.model || m);
    } catch(e) {}
  }

  async function loadCollections() {
    try {
      const r = await fetch('/api/documents/collections');
      const d = await r.json();
      allCollections = (d.collections || []).filter(c => c.unique_documents > 0);
    } catch(e) { allCollections = []; }
  }

  function renderModelDropdown(selectedModel) {
    const el = document.getElementById('agent-model');
    const models = allModelsList.length > 0 ? allModelsList : ['llama3'];
    el.innerHTML = models.map(m =>
      '<option value="' + escapeHtml(m) + '"' + (m === selectedModel ? ' selected' : '') + '>' + escapeHtml(m) + '</option>'
    ).join('');
    if (selectedModel && !models.includes(selectedModel)) {
      el.innerHTML += '<option value="' + escapeHtml(selectedModel) + '" selected>' + escapeHtml(selectedModel) + '</option>';
    }
  }

  function renderToolCheckboxes(selectedIds) {
    const el = document.getElementById('agent-tools-list');
    if (allToolsList.length === 0) {
      el.innerHTML = '<option disabled>No tools available</option>';
      return;
    }
    el.innerHTML = allToolsList.map(t =>
      '<option value="' + escapeHtml(t) + '"' + (selectedIds.includes(t) ? ' selected' : '') + '>🔧 ' + escapeHtml(t) + '</option>'
    ).join('');
  }

  function getSelectedToolIds() {
    return Array.from(document.getElementById('agent-tools-list').selectedOptions).map(o => o.value);
  }

  function renderSkillCheckboxes(selectedIds) {
    const el = document.getElementById('agent-skills-list');
    if (allSkillsList.length === 0) {
      el.innerHTML = '<option disabled>No skills created yet</option>';
      return;
    }
    el.innerHTML = allSkillsList.map(s =>
      '<option value="' + escapeHtml(s.id) + '"' + (selectedIds.includes(s.id) ? ' selected' : '') + '>⚡ ' + escapeHtml(s.name) + '</option>'
    ).join('');
  }

  function getSelectedSkillIds() {
    return Array.from(document.getElementById('agent-skills-list').selectedOptions).map(o => o.value);
  }

  let allMcpServers = [];
  async function loadMcpServersList() {
    try {
      const r = await fetch('/api/mcp/servers');
      const d = await r.json();
      allMcpServers = (d.servers || []).filter(s => s.enabled);
    } catch(e) { allMcpServers = []; }
  }

  function renderMcpServerCheckboxes(selectedIds) {
    const el = document.getElementById('agent-mcp-servers');
    if (allMcpServers.length === 0) {
      el.innerHTML = '<option disabled>No MCP servers registered</option>';
      return;
    }
    el.innerHTML = allMcpServers.map(s =>
      '<option value="' + escapeHtml(s.id) + '"' + ((selectedIds||[]).includes(s.id) ? ' selected' : '') + '>🔌 ' + escapeHtml(s.name) + ' (' + (s.tools||[]).length + ' tools)</option>'
    ).join('');
  }

  function getSelectedMcpServerIds() {
    return Array.from(document.getElementById('agent-mcp-servers').selectedOptions).map(o => o.value);
  }

  async function loadAgents() {
    try {
      var ownerFilter = document.getElementById('owner-filter').value;
      var qs = ownerFilter ? '?created_by=' + encodeURIComponent(ownerFilter) : '';
      const r = await fetch('/api/agents' + qs);
      const d = await r.json();
      const agents = d.agents || [];

      // Populate owner filter (admin only)
      if (window.__userRole === 'admin') {
        var ownerEl = document.getElementById('owner-filter');
        ownerEl.style.display = '';
        var owners = [...new Set(agents.map(function(a){ return a.created_by || 'system'; }))].sort();
        var curVal = ownerEl.value;
        ownerEl.innerHTML = '<option value="">All Users</option>' + owners.map(function(o){ return '<option value="' + escapeHtml(o) + '"' + (o === curVal ? ' selected' : '') + '>' + escapeHtml(o) + '</option>'; }).join('');
      }

      document.getElementById('agent-count').textContent = agents.length + ' agent' + (agents.length !== 1 ? 's' : '');
      const grid = document.getElementById('agents-grid');
      if (agents.length === 0) {
        grid.innerHTML = '<div class="card" style="grid-column:1/-1;text-align:center;padding:3rem;color:var(--text-3)"><p style="font-size:1.1rem">No agents found</p></div>';
        return;
      }
      grid.innerHTML = agents.map(a => {
        const skillBadges = (a.skill_ids||[]).map(sid => {
          const sk = allSkillsList.find(s => s.id === sid);
          return '<span class="badge">⚡ ' + escapeHtml(sk ? sk.name : sid) + '</span>';
        }).join(' ');
        const toolBadges = (a.tool_ids||[]).slice(0,3).map(t => '<span class="badge">' + escapeHtml(t) + '</span>').join(' ');
        const mcpBadges = (a.mcp_server_ids||[]).map(sid => {
          const srv = allMcpServers.find(s => s.id === sid);
          return '<span class="badge" style="background:rgba(168,85,247,0.15);color:#a855f7">🔌 ' + escapeHtml(srv ? srv.name : sid) + '</span>';
        }).join(' ');
        const isDefault = a.is_default ? ' <span class="badge" style="background:rgba(6,182,212,0.15);color:#06b6d4">default</span>' : '';
        var ownerBadge = a.created_by ? ' <span class="badge" style="background:rgba(99,102,241,0.12);color:#818cf8;font-size:0.65rem;font-weight:500">' + escapeHtml(a.created_by) + '</span>' : '';
        var scopeBadge = a.scope === 'global'
          ? ' <span class="badge" style="background:rgba(16,185,129,0.12);color:#10b981;font-size:0.6rem;font-weight:600">GLOBAL</span>'
          : ' <span class="badge" style="background:rgba(245,158,11,0.12);color:#f59e0b;font-size:0.6rem;font-weight:600">PRIVATE</span>';
        return '<div class="card animate-fade-up">' +
          '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem">' +
            '<h3 style="margin:0;font-size:1.05rem">🤖 ' + escapeHtml(a.name) + isDefault + scopeBadge + ownerBadge + '</h3>' +
            '<span class="mono" style="font-size:0.68rem;color:var(--text-3)">' + escapeHtml(a.id) + '</span>' +
          '</div>' +
          '<p style="color:var(--text-3);font-size:0.82rem;margin:0 0 0.75rem 0">' + escapeHtml(a.description || 'No description') + '</p>' +
          '<div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem;font-size:0.78rem;color:var(--text-2)">' +
            '<div><strong>Provider:</strong> ' + escapeHtml(a.provider) + '</div>' +
            '<div><strong>Model:</strong> ' + escapeHtml(a.model) + '</div>' +
            '<div><strong>Temp:</strong> ' + a.temperature + '</div>' +
            '<div><strong>Top P:</strong> ' + (a.top_p != null ? a.top_p : 1) + '</div>' +
            '<div><strong>Max Iter:</strong> ' + a.max_iterations + '</div>' +
            '<div><strong>KB:</strong> ' + escapeHtml(a.kb_collection) + '</div>' +
            '<div><strong>Memory:</strong> ' + (a.memory_enabled ? 'On' : 'Off') + '</div>' +
          '</div>' +
          (a.system_prompt ? '<div style="margin-top:0.75rem;background:var(--input-bg);border-radius:8px;padding:0.5rem 0.75rem;font-size:0.72rem;font-family:var(--mono);color:var(--text-2);max-height:50px;overflow:hidden">' + escapeHtml(a.system_prompt.slice(0,200)) + (a.system_prompt.length > 200 ? '...' : '') + '</div>' : '') +
          '<div style="display:flex;flex-wrap:wrap;gap:0.25rem;margin-top:0.75rem">' + skillBadges + ' ' + toolBadges + ' ' + mcpBadges + '</div>' +
          '<div style="display:flex;gap:0.5rem;margin-top:1rem;border-top:1px solid var(--glass-border);padding-top:0.75rem">' +
            '<button class="btn btn-sm" onclick="showAgentInfo(\\'' + escapeHtml(a.id) + '\\')">ℹ️ Info</button>' +
            '<button class="btn btn-sm" onclick="editAgent(\\'' + escapeHtml(a.id) + '\\')">✏️ Edit</button>' +
            (a.is_default ? '' : '<button class="btn btn-sm btn-danger" onclick="deleteAgent(\\'' + escapeHtml(a.id) + '\\')">🗑️ Delete</button>') +
          '</div>' +
        '</div>';
      }).join('');
    } catch(e) {
      document.getElementById('agents-grid').innerHTML = '<div class="card" style="color:var(--danger)">Error: ' + escapeHtml(e.message) + '</div>';
    }
  }

  // ── Form state persistence (survives navigation) ──
  const DRAFT_KEY = 'agentDraft';
  function saveDraft() {
    const draft = {
      id: document.getElementById('agent-edit-id').value,
      name: document.getElementById('agent-name').value,
      desc: document.getElementById('agent-desc').value,
      provider: document.getElementById('agent-provider').value,
      model: document.getElementById('agent-model').value,
      temp: document.getElementById('agent-temp').value,
      prompt: document.getElementById('agent-prompt').value,
      tools: Array.from(document.getElementById('agent-tools-list').selectedOptions).map(o => o.value),
      skills: Array.from(document.getElementById('agent-skills-list').selectedOptions).map(o => o.value),
      mcpServers: Array.from(document.getElementById('agent-mcp-servers').selectedOptions).map(o => o.value),
      kb: document.getElementById('agent-kb').value,
      iterations: document.getElementById('agent-iterations').value,
      memory: document.getElementById('agent-memory').value,
      formTitle: document.getElementById('agent-form-title').textContent,
    };
    if (draft.name || draft.prompt || draft.desc) {
      localStorage.setItem(DRAFT_KEY, JSON.stringify(draft));
    }
  }
  function clearAgentDraft() { localStorage.removeItem(DRAFT_KEY); }
  function restoreAgentDraft() {
    const raw = localStorage.getItem(DRAFT_KEY);
    if (!raw) return;
    try {
      const d = JSON.parse(raw);
      document.getElementById('agent-edit-id').value = d.id || '';
      document.getElementById('agent-name').value = d.name || '';
      document.getElementById('agent-desc').value = d.desc || '';
      document.getElementById('agent-provider').value = d.provider || 'ollama';
      if (d.model) renderModelDropdown(d.model);
      document.getElementById('agent-temp').value = d.temp || '0.7';
      document.getElementById('agent-prompt').value = d.prompt || '';
      if (d.tools && d.tools.length) renderToolCheckboxes(d.tools);
      if (d.skills && d.skills.length) renderSkillCheckboxes(d.skills);
      if (d.mcpServers && d.mcpServers.length) renderMcpServerCheckboxes(d.mcpServers);
      document.getElementById('agent-kb').value = d.kb || 'agentic_docs';
      document.getElementById('agent-iterations').value = d.iterations || '5';
      document.getElementById('agent-memory').value = d.memory || '1';
      document.getElementById('agent-form-title').textContent = d.formTitle || 'Create Agent';
      document.getElementById('agent-form').style.display = 'block';
    } catch(e) { clearAgentDraft(); }
  }
  // Auto-save on input
  ['agent-name','agent-desc','agent-provider','agent-model','agent-temp','agent-prompt','agent-kb','agent-iterations','agent-memory'].forEach(id => {
    const el = document.getElementById(id);
    if (el) { el.addEventListener('input', saveDraft); el.addEventListener('change', saveDraft); }
  });
  document.getElementById('agent-tools-list').addEventListener('change', saveDraft);
  document.getElementById('agent-skills-list').addEventListener('change', saveDraft);
  document.getElementById('agent-mcp-servers').addEventListener('change', saveDraft);

  async function showAgentForm() {
    await Promise.all([loadSkillsList(), loadToolsList(), loadMcpServersList(), loadModelsList(), loadCollections()]);
    clearAgentDraft();
    document.getElementById('agent-form-title').textContent = 'Create Agent';
    document.getElementById('agent-edit-id').value = '';
    document.getElementById('agent-name').value = '';
    document.getElementById('agent-desc').value = '';
    document.getElementById('agent-provider').value = 'ollama';
    renderModelDropdown('llama3');
    document.getElementById('agent-temp').value = '0.7';
    document.getElementById('agent-top-p').value = '1';
    document.getElementById('agent-prompt').value = '';
    renderToolCheckboxes([]);
    renderMcpServerCheckboxes([]);
    document.getElementById('agent-kb').value = '';
    document.getElementById('agent-iterations').value = '5';
    document.getElementById('agent-memory').value = '1';
    document.getElementById('agent-retrieval-mode').value = 'basic';
    renderSkillCheckboxes([]);
    document.getElementById('agent-kb-filename').textContent = 'No file selected';
    document.getElementById('agent-kb-text').value = '';
    document.getElementById('agent-kb-source').value = '';
    document.getElementById('kb-upload-result').textContent = '';
    switchKBTab('upload');
    renderKBReuse();
    hideAgentKBDocs();
    document.getElementById('agent-form').style.display = 'block';
    document.getElementById('agent-name').focus();
  }

  function hideAgentForm() {
    clearAgentDraft();
    document.getElementById('agent-form').style.display = 'none';
  }

  async function editAgent(id) {
    await Promise.all([loadSkillsList(), loadToolsList(), loadMcpServersList(), loadModelsList(), loadCollections()]);
    try {
      const r = await fetch('/api/agents/' + id);
      const a = await r.json();
      document.getElementById('agent-form-title').textContent = 'Edit Agent';
      document.getElementById('agent-edit-id').value = a.id;
      document.getElementById('agent-name').value = a.name;
      document.getElementById('agent-desc').value = a.description || '';
      document.getElementById('agent-provider').value = a.provider || 'ollama';
      renderModelDropdown(a.model || 'llama3');
      document.getElementById('agent-temp').value = a.temperature || 0.7;
      document.getElementById('agent-top-p').value = a.top_p != null ? a.top_p : 1;
      document.getElementById('agent-prompt').value = a.system_prompt || '';
      renderToolCheckboxes(a.tool_ids || []);
      renderMcpServerCheckboxes(a.mcp_server_ids || []);
      document.getElementById('agent-kb').value = a.kb_collection || '';
      document.getElementById('agent-iterations').value = a.max_iterations || 5;
      document.getElementById('agent-memory').value = a.memory_enabled ? '1' : '0';
      document.getElementById('agent-retrieval-mode').value = a.retrieval_mode || 'basic';
      renderSkillCheckboxes(a.skill_ids || []);
      document.getElementById('agent-kb-filename').textContent = 'No file selected';
      document.getElementById('agent-kb-text').value = '';
      document.getElementById('agent-kb-source').value = '';
      document.getElementById('kb-upload-result').textContent = '';
      switchKBTab('upload');
      renderKBReuse(a.kb_collection);
      loadAgentKBDocs(a.kb_collection);
      document.getElementById('agent-form').style.display = 'block';
      document.getElementById('agent-name').focus();
    } catch(e) { showToast('Error loading agent: ' + e.message, 'error'); }
  }

  function getAgentCollectionName() {
    const existing = document.getElementById('agent-kb').value.trim();
    if (existing) return existing;
    const editId = document.getElementById('agent-edit-id').value;
    if (editId) return 'agent_' + editId + '_kb';
    // For new agents, generate a temp name; will be re-generated after save with actual ID
    const tempId = Date.now().toString(36);
    return 'agent_' + tempId + '_kb';
  }

  async function saveAgent() {
    const id = document.getElementById('agent-edit-id').value;
    const kbVal = document.getElementById('agent-kb').value.trim();
    const payload = {
      name: document.getElementById('agent-name').value.trim(),
      description: document.getElementById('agent-desc').value.trim(),
      provider: document.getElementById('agent-provider').value,
      model: document.getElementById('agent-model').value.trim(),
      temperature: parseFloat(document.getElementById('agent-temp').value) || 0.7,
      top_p: parseFloat(document.getElementById('agent-top-p').value),
      system_prompt: document.getElementById('agent-prompt').value.trim(),
      skill_ids: getSelectedSkillIds(),
      tool_ids: getSelectedToolIds(),
      mcp_server_ids: getSelectedMcpServerIds(),
      kb_collection: kbVal || (id ? 'agent_' + id + '_kb' : ''),
      retrieval_mode: document.getElementById('agent-retrieval-mode').value,
      max_iterations: parseInt(document.getElementById('agent-iterations').value) || 5,
      memory_enabled: document.getElementById('agent-memory').value === '1',
    };
    if (!payload.name) { alert('Name is required'); return; }
    try {
      const url = id ? '/api/agents/' + id : '/api/agents';
      const method = id ? 'PUT' : 'POST';
      const resp = await fetch(url, { method, headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
      if (!resp.ok) {
        const err = await resp.text();
        showToast('Save failed: ' + (err || resp.statusText), 'error');
        return;
      }
      const result = await resp.json();
      // For new agents, update kb_collection with actual agent ID
      if (!id && result.id && !kbVal) {
        const newKb = 'agent_' + result.id + '_kb';
        await fetch('/api/agents/' + result.id, {
          method: 'PUT',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ ...payload, kb_collection: newKb })
        });
      }
      showToast(id ? 'Agent updated' : 'Agent created', 'success');
      clearAgentDraft();
      hideAgentForm();
      loadAgents();
    } catch(e) { showToast('Error: ' + e.message, 'error'); }
  }

  async function deleteAgent(id) {
    if (!confirm('Delete this agent? Its isolated KB documents will be removed. Any shared/global documents will keep their content but lose the agent tag.')) return;
    try {
      const res = await fetch('/api/agents/' + id, { method: 'DELETE' });
      if (!res.ok) { showToast('Delete failed: ' + res.statusText, 'error'); return; }
      showToast('Agent deleted. KB removed, global doc tags cleared.', 'success');
      loadAgents();
    } catch(e) { showToast('Error: ' + e.message, 'error'); }
  }

  // ── KB Tab / Reuse helpers ──
  function switchKBTab(tab) {
    document.getElementById('kb-panel-upload').style.display = tab === 'upload' ? '' : 'none';
    document.getElementById('kb-panel-reuse').style.display = tab === 'reuse' ? '' : 'none';
    const btnUp = document.getElementById('kb-tab-upload');
    const btnRe = document.getElementById('kb-tab-reuse');
    btnUp.style.background = tab === 'upload' ? 'rgba(6,182,212,0.15)' : 'transparent';
    btnUp.style.color = tab === 'upload' ? '#06b6d4' : 'var(--text-3)';
    btnRe.style.background = tab === 'reuse' ? 'rgba(6,182,212,0.15)' : 'transparent';
    btnRe.style.color = tab === 'reuse' ? '#06b6d4' : 'var(--text-3)';
  }

  function renderKBReuse(excludeCollection) {
    const container = document.getElementById('kb-reuse-list');
    const collections = allCollections.filter(c => c.name !== excludeCollection);
    if (!collections.length) {
      container.innerHTML = '<p style="color:var(--text-3);font-size:0.78rem;text-align:center">No existing knowledge bases with documents found.</p>';
      return;
    }
    let html = '';
    for (const coll of collections) {
      html += '<div style="margin-bottom:0.6rem;border-bottom:1px solid var(--glass-border);padding-bottom:0.5rem">';
      html += '<div style="font-size:0.78rem;font-weight:600;color:var(--text-2);margin-bottom:0.25rem">';
      html += '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:4px"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>';
      html += coll.name + ' <span style="font-weight:400;color:var(--text-3)">(' + coll.unique_documents + ' docs)</span></div>';
      for (const src of coll.sources) {
        const cbId = 'kb-reuse-' + coll.name + '--' + src;
        html += '<label style="display:flex;align-items:center;gap:0.35rem;font-size:0.75rem;color:var(--text-2);padding:0.15rem 0 0.15rem 1rem;cursor:pointer">';
        html += '<input type="checkbox" class="kb-reuse-cb" data-collection="' + coll.name + '" data-source="' + src + '" id="' + cbId + '">';
        html += '<span>' + src + '</span></label>';
      }
      html += '</div>';
    }
    container.innerHTML = html;
  }

  async function copySelectedDocs() {
    const checkboxes = document.querySelectorAll('.kb-reuse-cb:checked');
    if (!checkboxes.length) { showToast('Select at least one document to copy', 'error'); return; }
    const targetCollection = getAgentCollectionName();
    // Update the hidden field
    document.getElementById('agent-kb').value = targetCollection;
    // Group by source collection
    const groups = {};
    checkboxes.forEach(cb => {
      const from = cb.dataset.collection;
      if (!groups[from]) groups[from] = [];
      groups[from].push(cb.dataset.source);
    });
    const btn = document.getElementById('kb-copy-btn');
    btn.disabled = true; btn.textContent = 'Copying...';
    const resultEl = document.getElementById('kb-copy-result');
    let totalCopied = 0;
    try {
      for (const [fromColl, sources] of Object.entries(groups)) {
        const r = await fetch('/api/documents/copy', {
          method: 'POST',
          headers: {'Content-Type':'application/json'},
          body: JSON.stringify({ sources, from_collection: fromColl, to_collection: targetCollection })
        });
        const d = await r.json();
        totalCopied += (d.chunks_copied || 0);
      }
      resultEl.style.color = 'var(--success)';
      resultEl.textContent = 'Copied ' + totalCopied + ' chunks to "' + targetCollection + '"';
      // Uncheck all
      checkboxes.forEach(cb => cb.checked = false);
      loadAgentKBDocs(targetCollection);
    } catch(e) {
      resultEl.style.color = 'var(--danger)';
      resultEl.textContent = 'Copy failed: ' + e.message;
    } finally {
      btn.disabled = false; btn.textContent = 'Copy Selected to Agent KB';
    }
  }

  async function loadAgentKBDocs(collection) {
    const wrap = document.getElementById('agent-kb-docs');
    const list = document.getElementById('agent-kb-doc-list');
    const countEl = document.getElementById('agent-kb-doc-count');
    if (!collection) { wrap.style.display = 'none'; return; }
    try {
      const r = await fetch('/api/documents?collection=' + encodeURIComponent(collection));
      const d = await r.json();
      const docs = d.documents || [];
      if (!docs.length) { wrap.style.display = 'none'; return; }
      wrap.style.display = '';
      countEl.textContent = docs.length + ' doc' + (docs.length !== 1 ? 's' : '');
      list.innerHTML = docs.map(doc =>
        '<span class="badge" style="font-size:0.72rem;display:inline-flex;align-items:center;gap:0.25rem">' +
        '<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>' +
        doc.source + '</span>'
      ).join('');
    } catch(e) { wrap.style.display = 'none'; }
  }

  function hideAgentKBDocs() {
    document.getElementById('agent-kb-docs').style.display = 'none';
    document.getElementById('agent-kb-doc-list').innerHTML = '';
  }

  function handleFileSelect(input) {
    const file = input.files[0];
    const nameEl = document.getElementById('agent-kb-filename');
    if (!file) { nameEl.textContent = 'No file selected'; return; }
    nameEl.textContent = file.name;
    // Auto-fill source name from file name
    if (!document.getElementById('agent-kb-source').value.trim()) {
      document.getElementById('agent-kb-source').value = file.name;
    }
    // Read file as text
    const reader = new FileReader();
    reader.onload = function(e) {
      document.getElementById('agent-kb-text').value = e.target.result;
    };
    reader.onerror = function() {
      nameEl.textContent = 'Error reading file';
    };
    reader.readAsText(file);
  }

  async function uploadKB() {
    const text = document.getElementById('agent-kb-text').value.trim();
    const source = document.getElementById('agent-kb-source').value.trim();
    const collection = getAgentCollectionName();
    // Store the collection name so it persists
    document.getElementById('agent-kb').value = collection;
    const resultEl = document.getElementById('kb-upload-result');
    if (!text) { resultEl.style.color='var(--danger)'; resultEl.textContent='Upload a file or paste text first'; return; }
    if (!source) { resultEl.style.color='var(--danger)'; resultEl.textContent='Enter a source name'; return; }
    const btn = document.getElementById('kb-upload-btn');
    btn.disabled = true; btn.textContent = 'Uploading...';
    resultEl.textContent = '';
    try {
      const agentId = document.getElementById('agent-edit-id').value || '';
      const r = await fetch('/api/documents/ingest', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ text, source, collection, chunk_size: 1000, chunk_overlap: 200, agent_id: agentId || undefined })
      });
      const d = await r.json();
      resultEl.style.color='var(--success)';
      resultEl.textContent = 'Uploaded ' + (d.chunks_stored || '?') + ' chunks to "' + collection + '"';
      document.getElementById('agent-kb-text').value = '';
      document.getElementById('agent-kb-source').value = '';
      document.getElementById('agent-kb-filename').textContent = 'No file selected';
      document.getElementById('agent-kb-file').value = '';
      loadAgentKBDocs(collection);
    } catch(e) {
      resultEl.style.color='var(--danger)';
      resultEl.textContent = 'Upload failed: ' + e.message;
    } finally {
      btn.disabled = false; btn.textContent = 'Upload';
    }
  }

  async function showAgentInfo(id) {
    try {
      const r = await fetch('/api/agents/' + id);
      const a = await r.json();
      const skillNames = (a.skill_ids || []).map(sid => {
        const sk = allSkillsList.find(s => s.id === sid);
        return sk ? sk.name : sid;
      });
      const toolNames = a.tool_ids || [];
      const rows = [
        ['Name', a.name],
        ['Description', a.description || '—'],
        ['ID', '<code style="font-size:0.72rem">' + escapeHtml(a.id) + '</code>'],
        ['Provider', a.provider],
        ['Model', a.model],
        ['Temperature', a.temperature],
        ['Top P', a.top_p != null ? a.top_p : 1],
        ['Max Iterations', a.max_iterations],
        ['Memory', a.memory_enabled ? 'Enabled' : 'Disabled'],
        ['KB Collection', a.kb_collection || 'agentic_docs'],
        ['Retrieval Mode', a.retrieval_mode || 'basic'],
        ['Default Agent', a.is_default ? 'Yes' : 'No'],
        ['Created', a.created_at ? new Date(a.created_at).toLocaleString() : '—'],
        ['Updated', a.updated_at ? new Date(a.updated_at).toLocaleString() : '—'],
      ];
      let html = '<table style="width:100%;border-collapse:collapse;font-size:0.82rem">';
      rows.forEach(([label, val]) => {
        html += '<tr style="border-bottom:1px solid var(--glass-border)">' +
          '<td style="padding:0.45rem 0.75rem 0.45rem 0;font-weight:600;color:var(--text-3);white-space:nowrap;width:130px">' + escapeHtml(label) + '</td>' +
          '<td style="padding:0.45rem 0;color:var(--text-2)">' + (label === 'ID' ? val : escapeHtml(String(val))) + '</td></tr>';
      });
      html += '</table>';
      if (a.system_prompt) {
        html += '<div style="margin-top:1rem">' +
          '<div style="font-weight:600;color:var(--text-3);font-size:0.78rem;margin-bottom:0.35rem">System Prompt</div>' +
          '<div style="background:var(--input-bg);border-radius:8px;padding:0.75rem;font-size:0.78rem;font-family:var(--mono);color:var(--text-2);white-space:pre-wrap;max-height:200px;overflow-y:auto;line-height:1.5">' + escapeHtml(a.system_prompt) + '</div>' +
        '</div>';
      }
      if (skillNames.length) {
        html += '<div style="margin-top:0.75rem"><span style="font-weight:600;color:var(--text-3);font-size:0.78rem">Skills: </span>' +
          skillNames.map(s => '<span class="badge">⚡ ' + escapeHtml(s) + '</span>').join(' ') + '</div>';
      }
      if (toolNames.length) {
        html += '<div style="margin-top:0.5rem"><span style="font-weight:600;color:var(--text-3);font-size:0.78rem">Tools: </span>' +
          toolNames.map(t => '<span class="badge">🔧 ' + escapeHtml(t) + '</span>').join(' ') + '</div>';
      }
      const mcpNames = (a.mcp_server_ids || []).map(sid => {
        const srv = allMcpServers.find(s => s.id === sid);
        return srv ? srv.name : sid;
      });
      if (mcpNames.length) {
        html += '<div style="margin-top:0.5rem"><span style="font-weight:600;color:var(--text-3);font-size:0.78rem">MCP Servers: </span>' +
          mcpNames.map(n => '<span class="badge" style="background:rgba(168,85,247,0.15);color:#a855f7">🔌 ' + escapeHtml(n) + '</span>').join(' ') + '</div>';
      }
      showDetailModal('🤖 ' + escapeHtml(a.name), html);
    } catch(e) {
      showToast('Failed to load agent details', 'error');
    }
  }

  Promise.all([loadSkillsList(), loadToolsList(), loadMcpServersList(), loadModelsList(), loadCollections()]).then(() => { loadAgents(); restoreAgentDraft(); });
<\/script>

