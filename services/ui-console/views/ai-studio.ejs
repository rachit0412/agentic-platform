/* ── Init ── */
function studioInit() {
  // Load agents
  fetch('/api/agents').then(function(r) { return r.json(); }).then(function(d) {
    var sel = document.getElementById('studio-agent');
    (d.agents || []).forEach(function(a) {
      var opt = document.createElement('option');
      opt.value = a.id;
      opt.textContent = a.name;
      sel.appendChild(opt);
    });
  }).catch(function() {});

  // Load blank template by default
  studioLoadTemplate('blank');
  setupResizeHandles();
}

/* ── Templates ── */
function studioLoadTemplate(name) {
  var tpl = studioTemplates[name];
  if (!tpl) return;
  studioProject.files = {};
  studioProject.openTabs = [];
  studioProject.activeFile = null;
  studioProject.name = name;

  Object.keys(tpl).forEach(function(f) {
    studioProject.files[f] = tpl[f];
  });

  // Open first file
  var first = Object.keys(studioProject.files)[0];
  if (first) {
    studioProject.openTabs = [first];
    studioProject.activeFile = first;
  }
  studioRenderFileTree();
  studioRenderTabs();
  studioLoadFileInEditor(first);
  studioLog('info', 'Loaded template: ' + name + ' (' + Object.keys(studioProject.files).length + ' files)');
  studioSidebarTab('files');
}

/* ── File Tree ── */
function studioRenderFileTree() {
  var tree = document.getElementById('studio-file-tree');
  var files = Object.keys(studioProject.files).sort();
  tree.innerHTML = files.map(function(f) {
    var ext = f.split('.').pop();
    var icons = { html:'\\ud83c\\udf10', css:'\\ud83c\\udfa8', js:'\\u26a1', jsx:'\\u269b', json:'\\ud83d\\udcc4', md:'\\ud83d\\udcdd', txt:'\\ud83d\\udcc4' };
    var icon = icons[ext] || '\\ud83d\\udcc4';
    var active = studioProject.activeFile === f ? ' active' : '';
    return '<div class="file-tree-item' + active + '" onclick="studioOpenFile(\\'' + escapeHtml(f).replace(/'/g, "\\\\'") + '\\')" title="' + escapeHtml(f) + '">' +
      '<span class="ft-icon">' + icon + '</span>' +
      '<span>' + escapeHtml(f) + '</span>' +
    '</div>';
  }).join('');
}

/* ── Tabs ── */
function studioRenderTabs() {
  var tabs = document.getElementById('studio-tabs');
  tabs.innerHTML = studioProject.openTabs.map(function(f) {
    var active = studioProject.activeFile === f ? ' active' : '';
    var ext = f.split('.').pop();
    return '<div class="studio-tab' + active + '" onclick="studioOpenFile(\\'' + escapeHtml(f).replace(/'/g, "\\\\'") + '\\')">' +
      '<span>' + escapeHtml(f) + '</span>' +
      '<span class="tab-close" onclick="event.stopPropagation();studioCloseTab(\\'' + escapeHtml(f).replace(/'/g, "\\\\'") + '\\')">&times;</span>' +
    '</div>';
  }).join('');
}

/* ── File Operations ── */
function studioOpenFile(name) {
  if (!studioProject.files.hasOwnProperty(name)) return;
  // Save current
  if (studioProject.activeFile) {
    studioProject.files[studioProject.activeFile] = document.getElementById('studio-code').value;
  }
  // Add to tabs
  if (studioProject.openTabs.indexOf(name) === -1) {
    studioProject.openTabs.push(name);
  }
  studioProject.activeFile = name;
  studioLoadFileInEditor(name);
  studioRenderTabs();
  studioRenderFileTree();
}

function studioLoadFileInEditor(name) {
  if (!name) return;
  var code = studioProject.files[name] || '';
  document.getElementById('studio-code').value = code;
  var ext = name.split('.').pop();
  document.getElementById('studio-file-lang').textContent = ext;
  document.getElementById('studio-file-size').textContent = code.length + ' chars';
}

function studioCloseTab(name) {
  var idx = studioProject.openTabs.indexOf(name);
  if (idx === -1) return;
  studioProject.openTabs.splice(idx, 1);
  if (studioProject.activeFile === name) {
    studioProject.activeFile = studioProject.openTabs[Math.max(0, idx - 1)] || null;
    if (studioProject.activeFile) {
      studioLoadFileInEditor(studioProject.activeFile);
    } else {
      document.getElementById('studio-code').value = '';
      document.getElementById('studio-file-lang').textContent = '';
      document.getElementById('studio-file-size').textContent = '';
    }
  }
  studioRenderTabs();
  studioRenderFileTree();
}

function studioCodeChanged() {
  if (studioProject.activeFile) {
    studioProject.files[studioProject.activeFile] = document.getElementById('studio-code').value;
  }
  var code = document.getElementById('studio-code').value;
  document.getElementById('studio-file-size').textContent = code.length + ' chars';
}

function studioSaveFile() {
  studioCodeChanged();
  studioLog('info', 'Saved: ' + (studioProject.activeFile || '(none)'));
  showToast('File saved', 'success');
}

function studioNewFile() {
  var name = prompt('File name (e.g. component.jsx):');
  if (!name) return;
  name = name.trim();
  if (studioProject.files.hasOwnProperty(name)) {
    showToast('File already exists', 'error');
    return;
  }
  studioProject.files[name] = '';
  studioOpenFile(name);
  studioLog('info', 'Created: ' + name);
}

function studioNewFolder() {
  showToast('Folders are implicit \\u2014 use paths like folder/file.js', 'info');
}

function studioDeleteFile() {
  var f = studioProject.activeFile;
  if (!f) { showToast('No file selected', 'error'); return; }
  if (!confirm('Delete ' + f + '?')) return;
  delete studioProject.files[f];
  studioCloseTab(f);
  studioRenderFileTree();
  studioLog('info', 'Deleted: ' + f);
}

function studioFormatCode() {
  // Basic indentation cleanup
  var code = document.getElementById('studio-code').value;
  try {
    if (studioProject.activeFile && studioProject.activeFile.endsWith('.json')) {
      code = JSON.stringify(JSON.parse(code), null, 2);
      document.getElementById('studio-code').value = code;
      studioCodeChanged();
      showToast('Formatted JSON', 'success');
      return;
    }
  } catch(e) {}
  showToast('Format applied', 'info');
}

function studioHandleTab(e) {
  if (e.key === 'Tab') {
    e.preventDefault();
    var ta = e.target;
    var start = ta.selectionStart;
    var end = ta.selectionEnd;
    ta.value = ta.value.substring(0, start) + '  ' + ta.value.substring(end);
    ta.selectionStart = ta.selectionEnd = start + 2;
    studioCodeChanged();
  }
}

/* ── Export ── */
function studioExportProject() {
  studioCodeChanged();
  var data = JSON.stringify({ name: studioProject.name, files: studioProject.files }, null, 2);
  var blob = new Blob([data], { type: 'application/json' });
  var a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = studioProject.name + '-project.json';
  a.click();
  URL.revokeObjectURL(a.href);
  showToast('Project exported', 'success');
}

/* ── Preview ── */
function studioRun() {
  studioCodeChanged();
  var html = studioProject.files['index.html'];
  if (!html) {
    studioLog('error', 'No index.html found. Create one first.');
    showToast('No index.html', 'error');
    return;
  }

  // Inline CSS and JS into the HTML
  var combined = html;
  var Q = '[' + '"' + "'" + ']'; // regex char class matching " or '
  Object.keys(studioProject.files).forEach(function(f) {
    if (f === 'index.html') return;
    var content = studioProject.files[f];
    if (f.endsWith('.css')) {
      combined = combined.replace(
        new RegExp('<link[^>]+href=' + Q + f.replace('.', '\\\\.') + Q + '[^>]*>', 'g'),
        '<style>' + content + '<\\/style>'
      );
    }
    if (f.endsWith('.js') || f.endsWith('.jsx')) {
      var re = new RegExp('<script[^>]+src=' + Q + f.replace('.', '\\\\.') + Q + '[^>]*><\\\\/script>', 'g');
      var srcTag = combined.match(re);
      if (srcTag) {
        var typeAttr = '';
        if (srcTag[0].indexOf('text/babel') !== -1) typeAttr = ' type="text/babel"';
        combined = combined.replace(re, '<script' + typeAttr + '>' + content + '<\\/script>');
      }
    }
  });

  // Show in preview iframe
  studioSidebarTab('preview');
  var frame = document.getElementById('studio-preview-frame');
  var placeholder = document.getElementById('studio-preview-placeholder');
  placeholder.style.display = 'none';
  frame.style.display = 'block';
  frame.srcdoc = combined;
  studioLog('info', 'Preview updated');
}

/* ── Sidebar Tabs ── */
function studioSidebarTab(name) {
  document.querySelectorAll('.studio-sidebar-tab').forEach(function(t) { t.classList.remove('active'); });
  document.querySelectorAll('.studio-sidebar-panel').forEach(function(p) { p.classList.remove('active'); });
  document.querySelector('.studio-sidebar-tab:nth-child(' + ({files:1,preview:2,templates:3}[name]) + ')').classList.add('active');
  document.getElementById('sidebar-' + name).classList.add('active');
}

/* ── Console ── */
function studioLog(level, msg) {
  var c = document.getElementById('studio-console');
  var d = document.createElement('div');
  d.className = 'log-' + level;
  var time = new Date().toLocaleTimeString();
  d.textContent = '[' + time + '] ' + msg;
  c.appendChild(d);
  c.scrollTop = c.scrollHeight;
}

/* ── Chat / AI ── */
function studioAddMessage(text, role) {
  var container = document.getElementById('studio-messages');
  var div = document.createElement('div');
  div.className = 'studio-msg studio-msg-' + role;
  if (role === 'ai') {
    // Parse code blocks
    div.innerHTML = studioFormatAIResponse(text);
  } else {
    div.textContent = text;
  }
  container.appendChild(div);
  container.scrollTop = container.scrollHeight;
}

function studioFormatAIResponse(text) {
  // Convert markdown code blocks to styled output
  var safe = escapeHtml(text);
  var bt = String.fromCharCode(96); // backtick
  var codeBlockRe = new RegExp(bt+bt+bt+'(\\\\w*)?\\\\n([\\\\s\\\\S]*?)'+bt+bt+bt, 'g');
  safe = safe.replace(codeBlockRe, function(m, lang, code) {
    return '<pre><code>' + code + '</code></pre>';
  });
  var inlineCodeRe = new RegExp(bt+'([^'+bt+']+)'+bt, 'g');
  safe = safe.replace(inlineCodeRe, '<code style="background:rgba(0,0,0,0.3);padding:0.1rem 0.3rem;border-radius:4px;font-size:0.75rem">$1</code>');
  safe = safe.replace(/\\n/g, '<br>');
  return safe;
}

async function studioSend() {
  var input = document.getElementById('studio-prompt');
  var text = input.value.trim();
  if (!text) return;
  input.value = '';

  studioAddMessage(text, 'user');

  var btn = document.getElementById('studio-send-btn');
  btn.disabled = true;

  // Build context: include all current project files
  var fileContext = 'Current project files:\\n';
  Object.keys(studioProject.files).forEach(function(f) {
    fileContext += '\\n--- ' + f + ' ---\\n' + studioProject.files[f] + '\\n';
  });

  var systemPrompt = 'You are an AI coding assistant inside an in-browser IDE called AI Studio. ' +
    'The user is building a web application. You can generate or modify code files. ' +
    'When you want to create or update a file, use this exact format:\\n' +
    '===FILE: filename.ext===\\n(file content)\\n===END===\\n' +
    'You may output multiple ===FILE=== blocks. Only use this format for code changes. ' +
    'After the file blocks, add a brief explanation. ' +
    'The project runs in-browser with static HTML/CSS/JS. React is available via CDN with Babel. ' +
    'Here is the current project state:\\n' + fileContext;

  studioLog('info', 'Sending prompt to agent...');

  try {
    var agentId = document.getElementById('studio-agent').value || undefined;
    var r = await fetch('/api/agent-run', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        prompt: text,
        session_id: studioProject.sessionId,
        system_prompt: systemPrompt,
        agent_id: agentId
      })
    });
    var d = await r.json();
    var response = d.response || d.output || '';

    // Extract ===FILE=== blocks
    var filePattern = /===FILE:\\s*([\\w.\\/\\-]+)===\\n([\\s\\S]*?)===END===/g;
    var match;
    var filesUpdated = 0;
    while ((match = filePattern.exec(response)) !== null) {
      var fname = match[1].trim();
      var fcontent = match[2];
      // Remove trailing newline
      if (fcontent.endsWith('\\n')) fcontent = fcontent.slice(0, -1);
      studioProject.files[fname] = fcontent;
      filesUpdated++;
      studioLog('info', 'Updated file: ' + fname);
      // Open the file
      if (studioProject.openTabs.indexOf(fname) === -1) {
        studioProject.openTabs.push(fname);
      }
    }

    if (filesUpdated > 0) {
      studioRenderFileTree();
      studioRenderTabs();
      // Show last updated file
      var lastFile = studioProject.openTabs[studioProject.openTabs.length - 1];
      studioProject.activeFile = lastFile;
      studioLoadFileInEditor(lastFile);
      studioRenderFileTree();
      studioRenderTabs();
    }

    // Show response (strip out FILE blocks for display)
    var displayText = response.replace(/===FILE:[\\s\\S]*?===END===/g, '').trim();
    if (!displayText && filesUpdated > 0) {
      displayText = 'Updated ' + filesUpdated + ' file(s). Click "Run" to preview.';
    }
    studioAddMessage(displayText || response, 'ai');
    studioLog('info', 'Agent responded' + (filesUpdated > 0 ? ' \\u2014 ' + filesUpdated + ' files updated' : ''));
  } catch(e) {
    studioAddMessage('Error: ' + e.message, 'ai');
    studioLog('error', 'Agent error: ' + e.message);
  }
  btn.disabled = false;
}

/* ── Resize Handles ── */
function setupResizeHandles() {
  setupResize('resize-chat', 'studio-chat-panel', 'width', 200, 600);
  setupResize('resize-sidebar', 'studio-sidebar-panel', 'width', 180, 500, true);
}

function setupResize(handleId, panelId, prop, min, max, reverse) {
  var handle = document.getElementById(handleId);
  var panel = document.getElementById(panelId);
  if (!handle || !panel) return;
  var startX, startW;

  handle.addEventListener('mousedown', function(e) {
    e.preventDefault();
    startX = e.clientX;
    startW = panel.offsetWidth;
    handle.classList.add('dragging');
    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup', onUp);
  });

  function onMove(e) {
    var dx = e.clientX - startX;
    var newW = reverse ? startW - dx : startW + dx;
    newW = Math.max(min, Math.min(max, newW));
    panel.style.width = newW + 'px';
    panel.style.minWidth = newW + 'px';
  }
  function onUp() {
    handle.classList.remove('dragging');
    document.removeEventListener('mousemove', onMove);
    document.removeEventListener('mouseup', onUp);
  }
}

/* ── Boot ── */
studioInit();
