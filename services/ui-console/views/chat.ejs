<%- include('layout', { title: 'Agent Chat', page: 'chat', body: `

<style>
  .chat-container {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 1.5rem;
    height: calc(100vh - 200px);
    margin-bottom: 1.5rem;
  }

  .chat-sidebar {
    background: var(--glass-bg);
    border: 1px solid var(--divider);
    border-radius: 12px;
    padding: 1rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .chat-sidebar-header {
    font-weight: 600;
    color: var(--text-1);
    margin-bottom: 0.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .chat-new-btn {
    background: linear-gradient(135deg, #06b6d4, #0ea5e9);
    border: none;
    color: white;
    padding: 0.5rem;
    border-radius: 8px;
    cursor: pointer;
    font-size: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }

  .chat-new-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(6, 182, 212, 0.3);
  }

  .chat-conversation-item {
    padding: 0.75rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s;
    color: var(--text-2);
    font-size: 0.9rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chat-conversation-item:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-1);
  }

  .chat-conversation-item.active {
    background: linear-gradient(135deg, rgba(6, 182, 212, 0.2), rgba(14, 165, 233, 0.1));
    color: var(--accent);
    font-weight: 500;
    border-left: 2px solid var(--accent);
    padding-left: calc(0.75rem - 2px);
  }

  .chat-main {
    display: flex;
    flex-direction: column;
    background: var(--glass-bg);
    border: 1px solid var(--divider);
    border-radius: 12px;
    overflow: hidden;
  }

  .chat-header {
    padding: 1.25rem;
    border-bottom: 1px solid var(--divider);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .chat-header-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-1);
  }

  .chat-header-settings {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .chat-message {
    display: flex;
    animation: slideIn 0.3s ease-out;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .chat-message.user {
    justify-content: flex-end;
  }

  .chat-message.assistant {
    justify-content: flex-start;
  }

  .chat-message-content {
    max-width: 70%;
    padding: 0.75rem 1rem;
    border-radius: 12px;
    word-wrap: break-word;
  }

  .chat-message.user .chat-message-content {
    background: linear-gradient(135deg, #06b6d4, #0ea5e9);
    color: white;
    border-bottom-right-radius: 2px;
  }

  .chat-message.assistant .chat-message-content {
    background: var(--input-bg);
    color: var(--text-1);
    border-left: 2px solid var(--accent);
    border-bottom-left-radius: 2px;
  }

  .chat-input-area {
    padding: 1.25rem;
    border-top: 1px solid var(--divider);
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .chat-input-field {
    flex: 1;
    min-width: 200px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  #chat-input {
    resize: none;
    max-height: 120px;
    min-height: 50px;
  }

  .chat-controls {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: flex-end;
  }

  .chat-send-btn {
    background: linear-gradient(135deg, #06b6d4, #0ea5e9);
    color: white;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 500;
    transition: all 0.2s;
    height: 50px;
  }

  .chat-send-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(6, 182, 212, 0.3);
  }

  .chat-send-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .chat-options {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .chat-option-select {
    padding: 0.5rem;
    border-radius: 8px;
    background: var(--input-bg);
    border: 1px solid var(--divider);
    color: var(--text-1);
    font-size: 0.85rem;
  }

  .chat-loading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-3);
  }

  .chat-loading::after {
    content: '';
    width: 20px;
    height: 4px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    animation: loading 1.5s infinite;
  }

  @keyframes loading {
    0%, 100% { transform: scaleX(0); }
    50% { transform: scaleX(1); }
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--text-3);
    gap: 1rem;
  }

  .empty-state-icon {
    font-size: 3rem;
    opacity: 0.5;
  }

  @media (max-width: 768px) {
    .chat-container {
      grid-template-columns: 1fr;
      height: auto;
    }

    .chat-sidebar {
      display: none;
    }

    .chat-message-content {
      max-width: 90%;
    }
  }
</style>

<div>
  <h1 class="text-glow-cyan" style="margin-bottom:0.25rem">Agent Chat</h1>
  <p style="color:var(--text-3);font-size:0.82rem;margin-bottom:1.5rem">
    Chat with your AI agent using configurable compliance and ethical guidelines
  </p>

  <div class="chat-container">
    <!-- Sidebar: Conversation History -->
    <div class="chat-sidebar">
      <div class="chat-sidebar-header">
        <span>Conversations</span>
        <button class="chat-new-btn" onclick="startNewConversation()" title="New chat">
          ➕
        </button>
      </div>
      <div id="conversations-list" style="flex: 1; overflow-y: auto;">
        <!-- Populated by JavaScript -->
      </div>
    </div>

    <!-- Main Chat Area -->
    <div class="chat-main">
      <!-- Header -->
      <div class="chat-header">
        <div class="chat-header-title" id="chat-title">Start a new conversation</div>
        <div class="chat-header-settings">
          <button class="btn btn-sm" onclick="toggleCompliancePanel()" title="Compliance settings">
            ⚙️
          </button>
          <button class="btn btn-sm" onclick="clearChat()" title="Clear chat">
            🗑️
          </button>
        </div>
      </div>

      <!-- Messages Area -->
      <div class="chat-messages" id="chat-messages">
        <div class="empty-state">
          <div class="empty-state-icon">💬</div>
          <div>No messages yet. Start typing to begin!</div>
        </div>
      </div>

      <!-- Input Area -->
      <div class="chat-input-area">
        <div class="chat-input-field" style="flex: 1;">
          <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
            <textarea 
              id="chat-input" 
              placeholder="Type your message... (Shift+Enter for new line, Enter to send)"
              style="flex: 1; min-height: 50px; max-height: 120px; resize: none;"
              onkeydown="handleInputKeydown(event)"
            ></textarea>
            <button class="chat-send-btn" id="send-btn" onclick="sendMessage()" title="Send message">
              Send
            </button>
          </div>
          <div class="chat-options">
            <select id="agent-select" class="chat-option-select" style="min-width: 150px;">
              <option value="">Default Agent</option>
            </select>
            <select id="model-select" class="chat-option-select" style="min-width: 150px;">
              <option value="">Default Model</option>
            </select>
            <label style="display: flex; align-items: center; gap: 0.5rem; color: var(--text-2); font-size: 0.85rem;">
              <input type="checkbox" id="use-kb" checked />
              Use Knowledge Base
            </label>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Compliance Settings Panel -->
  <div id="compliance-panel" style="display: none; margin-top: 1.5rem;">
    <div class="card">
      <h3 style="margin-bottom: 1rem;">Compliance & Ethical Controls</h3>
      
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem;">
        <div>
          <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: 500; margin-bottom: 0.75rem;">
            <input type="checkbox" id="enable-compliance" checked />
            Enable Compliance Filtering
          </label>
          <p style="color: var(--text-3); font-size: 0.85rem;">Filter responses based on configured rules</p>
        </div>

        <div>
          <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: 500; margin-bottom: 0.75rem;">
            <input type="checkbox" id="enable-audit" checked />
            Enable Audit Logging
          </label>
          <p style="color: var(--text-3); font-size: 0.85rem;">Log all messages for compliance review</p>
        </div>

        <div>
          <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: 500; margin-bottom: 0.75rem;">
            <input type="checkbox" id="enable-pii-filter" checked />
            Filter PII Data
          </label>
          <p style="color: var(--text-3); font-size: 0.85rem;">Remove personally identifiable information</p>
        </div>

        <div>
          <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: 500; margin-bottom: 0.75rem;">
            <input type="checkbox" id="enable-harmful-content" checked />
            Filter Harmful Content
          </label>
          <p style="color: var(--text-3); font-size: 0.85rem;">Block responses with harmful content</p>
        </div>
      </div>

      <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--divider);">
        <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Compliance Level</label>
        <div style="display: flex; gap: 0.5rem;">
          <select id="compliance-level" class="chat-option-select" style="flex: 1;">
            <option value="low">Low (Basic filtering)</option>
            <option value="medium" selected>Medium (Standard protection)</option>
            <option value="high">High (Strict enforcement)</option>
            <option value="custom">Custom</option>
          </select>
          <button class="btn btn-sm" onclick="saveComplianceSettings()">Save</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  let currentConversationId = null;
  let conversationHistory = [];
  let complianceSettings = {
    enableCompliance: true,
    enableAudit: true,
    enablePIIFilter: true,
    enableHarmfulContent: true,
    complianceLevel: 'medium'
  };

  // Initialize
  document.addEventListener('DOMContentLoaded', async function() {
    await loadAgentsList();
    await loadModelsList();
    await loadComplianceSettings();
    await loadConversationsList();
    updateComplianceUI();
  });

  async function loadAgentsList() {
    try {
      const response = await fetch('/api/agents');
      const data = await response.json();
      const select = document.getElementById('agent-select');
      
      if (data.agents && Array.isArray(data.agents)) {
        data.agents.forEach(agent => {
          const option = document.createElement('option');
          option.value = agent.id;
          option.textContent = agent.name || agent.id;
          select.appendChild(option);
        });
      }
    } catch (error) {
      console.error('Error loading agents:', error);
    }
  }

  async function loadModelsList() {
    try {
      const response = await fetch('/api/models');
      const data = await response.json();
      const select = document.getElementById('model-select');
      
      if (data.models && Array.isArray(data.models)) {
        data.models.forEach(model => {
          const option = document.createElement('option');
          option.value = model.id;
          option.textContent = model.name || model.id;
          select.appendChild(option);
        });
      }
    } catch (error) {
      console.error('Error loading models:', error);
    }
  }

  async function loadConversationsList() {
    try {
      const response = await fetch('/api/chat/conversations');
      const data = await response.json();
      const list = document.getElementById('conversations-list');
      
      if (data.conversations && Array.isArray(data.conversations)) {
        conversationHistory = data.conversations;
        list.innerHTML = data.conversations.map(conv => \`
          <div 
            class="chat-conversation-item \${conv.id === currentConversationId ? 'active' : ''}"
            onclick="loadConversation('\${conv.id}')"
            title="\${conv.title}"
          >
            \${conv.title || 'Untitled'}
          </div>
        \`).join('');
      }
    } catch (error) {
      console.error('Error loading conversations:', error);
    }
  }

  async function loadConversation(conversationId) {
    try {
      currentConversationId = conversationId;
      const response = await fetch(\`/api/chat/conversations/\${conversationId}\`);
      const data = await response.json();
      
      document.getElementById('chat-title').textContent = data.title || 'Conversation';
      displayMessages(data.messages || []);
      
      // Highlight active conversation
      document.querySelectorAll('.chat-conversation-item').forEach(item => {
        item.classList.remove('active');
      });
      event.target.closest('.chat-conversation-item').classList.add('active');
    } catch (error) {
      console.error('Error loading conversation:', error);
    }
  }

  function startNewConversation() {
    currentConversationId = null;
    document.getElementById('chat-title').textContent = 'New Conversation';
    document.getElementById('chat-messages').innerHTML = \`
      <div class="empty-state">
        <div class="empty-state-icon">💬</div>
        <div>Start typing to begin a new conversation</div>
      </div>
    \`;
    document.getElementById('chat-input').focus();
    
    // Remove active state from all items
    document.querySelectorAll('.chat-conversation-item').forEach(item => {
      item.classList.remove('active');
    });
  }

  function clearChat() {
    if (confirm('Clear all messages in this conversation?')) {
      document.getElementById('chat-messages').innerHTML = \`
        <div class="empty-state">
          <div class="empty-state-icon">💬</div>
          <div>Conversation cleared</div>
        </div>
      \`;
    }
  }

  function toggleCompliancePanel() {
    const panel = document.getElementById('compliance-panel');
    panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
    updateComplianceUI();
  }

  function updateComplianceUI() {
    document.getElementById('enable-compliance').checked = complianceSettings.enableCompliance;
    document.getElementById('enable-audit').checked = complianceSettings.enableAudit;
    document.getElementById('enable-pii-filter').checked = complianceSettings.enablePIIFilter;
    document.getElementById('enable-harmful-content').checked = complianceSettings.enableHarmfulContent;
    document.getElementById('compliance-level').value = complianceSettings.complianceLevel;
  }

  async function saveComplianceSettings() {
    complianceSettings = {
      enableCompliance: document.getElementById('enable-compliance').checked,
      enableAudit: document.getElementById('enable-audit').checked,
      enablePIIFilter: document.getElementById('enable-pii-filter').checked,
      enableHarmfulContent: document.getElementById('enable-harmful-content').checked,
      complianceLevel: document.getElementById('compliance-level').value
    };

    try {
      await fetch('/api/admin/compliance/config', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(complianceSettings)
      });
      showNotification('Compliance settings saved', 'success');
    } catch (error) {
      console.error('Error saving settings:', error);
      showNotification('Failed to save settings', 'error');
    }
  }

  async function loadComplianceSettings() {
    try {
      const response = await fetch('/api/admin/compliance/config');
      const data = await response.json();
      if (data.config) {
        complianceSettings = data.config;
      }
    } catch (error) {
      console.error('Error loading compliance settings:', error);
    }
  }

  function handleInputKeydown(event) {
    if (event.key === 'Enter' && !event.shiftKey) {
      event.preventDefault();
      sendMessage();
    }
  }

  async function sendMessage() {
    const input = document.getElementById('chat-input');
    const message = input.value.trim();
    
    if (!message) return;

    // Show user message
    addMessage('user', message);
    input.value = '';
    
    // Disable send button
    document.getElementById('send-btn').disabled = true;

    try {
      // Get selected options
      const agentId = document.getElementById('agent-select').value;
      const model = document.getElementById('model-select').value;
      const useKB = document.getElementById('use-kb').checked;

      // Send to backend
      const response = await fetch('/api/chat/message', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          message,
          conversationId: currentConversationId,
          agentId: agentId || null,
          model: model || null,
          useKB,
          compliance: complianceSettings
        })
      });

      if (!response.ok) {
        throw new Error(\`HTTP \${response.status}\`);
      }

      // Stream response
      const reader = response.body.getReader();
      const decoder = new TextDecoder();
      let assistantMessage = '';
      
      // Add empty assistant message
      const messageId = 'msg-' + Date.now();
      addMessage('assistant', '', messageId);

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        const chunk = decoder.decode(value);
        assistantMessage += chunk;
        updateMessage(messageId, assistantMessage);
      }

      // Save conversation
      if (!currentConversationId) {
        const title = message.substring(0, 50) + (message.length > 50 ? '...' : '');
        currentConversationId = 'conv-' + Date.now();
        await loadConversationsList();
      }

    } catch (error) {
      console.error('Error sending message:', error);
      addMessage('assistant', '❌ Error: ' + error.message);
    } finally {
      document.getElementById('send-btn').disabled = false;
      document.getElementById('chat-input').focus();
    }
  }

  function addMessage(role, content, id = null) {
    const messagesDiv = document.getElementById('chat-messages');
    
    // Remove empty state if it exists
    const emptyState = messagesDiv.querySelector('.empty-state');
    if (emptyState) {
      emptyState.remove();
    }

    const messageDiv = document.createElement('div');
    messageDiv.className = 'chat-message ' + role;
    messageDiv.id = id;
    messageDiv.innerHTML = \`<div class="chat-message-content">\${escapeHtml(content)}</div>\`;
    messagesDiv.appendChild(messageDiv);
    messagesDiv.scrollTop = messagesDiv.scrollHeight;
  }

  function updateMessage(id, content) {
    const messageDiv = document.getElementById(id);
    if (messageDiv) {
      messageDiv.querySelector('.chat-message-content').textContent = content;
      messageDiv.parentElement.scrollTop = messageDiv.parentElement.scrollHeight;
    }
  }

  function displayMessages(messages) {
    const messagesDiv = document.getElementById('chat-messages');
    messagesDiv.innerHTML = messages.map(msg => \`
      <div class="chat-message \${msg.role}">
        <div class="chat-message-content">\${escapeHtml(msg.content)}</div>
      </div>
    \`).join('');
    messagesDiv.scrollTop = messagesDiv.scrollHeight;
  }

  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  function showNotification(message, type = 'success') {
    // Use existing notification system from layout
    if (window.showNotification) {
      window.showNotification(message, type);
    } else {
      alert(message);
    }
  }
</script>

` }) %>
