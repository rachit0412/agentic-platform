<%- include('layout', { title: 'Observability', page: 'observability', body: `

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem">
  <div>
    <h1 class="text-glow-cyan" style="margin:0">Observability</h1>
    <p style="color:var(--text-3);font-size:0.82rem;margin:0.25rem 0 0">Infrastructure health, Prometheus targets, Grafana dashboards &amp; telemetry pipeline</p>
  </div>
  <button class="btn btn-sm" onclick="obsRefreshAll()">
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
    Refresh
  </button>
</div>

<!-- Obs Stats -->
<div class="grid-4 mb-2" style="margin-bottom:1.25rem">
  <div class="stat-card animate-fade-up">
    <div class="stat-icon stat-icon-emerald"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div>
    <div class="stat-label">Healthy</div>
    <div class="stat-number" id="stat-healthy">-</div>
  </div>
  <div class="stat-card animate-fade-up delay-100">
    <div class="stat-icon" style="background:linear-gradient(135deg,rgba(244,63,94,0.15),rgba(244,63,94,0.08));color:#f43f5e"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg></div>
    <div class="stat-label">Unhealthy</div>
    <div class="stat-number" id="stat-unhealthy">-</div>
  </div>
  <div class="stat-card animate-fade-up delay-200">
    <div class="stat-icon stat-icon-cyan"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="2"/><path d="M22 12h-4M6 12H2M12 6V2M12 22v-4"/></svg></div>
    <div class="stat-label">Scrape Targets</div>
    <div class="stat-number" id="stat-targets">-</div>
  </div>
  <div class="stat-card animate-fade-up delay-300">
    <div class="stat-icon stat-icon-violet"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg></div>
    <div class="stat-label">Active Series</div>
    <div class="stat-number" id="stat-active-series">-</div>
  </div>
</div>

<!-- Stack Health -->
<div class="card animate-fade-up" style="margin-bottom:1.25rem">
  <div class="section-header mb-1">
    <h3 style="font-size:0.95rem">Stack Health</h3>
    <button class="btn btn-sm" onclick="obsRefreshHealth()">Refresh</button>
  </div>
  <div id="stack-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:0.75rem;margin-top:0.5rem">
    <div class="stat-card" style="text-align:left">
      <div style="display:flex;align-items:center;gap:6px;margin-bottom:0.4rem"><span class="pulse-dot" id="dot-prometheus" style="background:#555"></span><strong style="font-size:0.85rem">Prometheus</strong></div>
      <div style="color:var(--text-3);font-size:0.72rem">Metrics collection</div>
      <div class="mono" style="font-size:0.68rem;margin-top:0.2rem;color:var(--text-3)">:9090</div>
      <div id="status-prometheus" style="margin-top:0.3rem;font-size:0.68rem;color:var(--text-3)">Checking...</div>
    </div>
    <div class="stat-card" style="text-align:left">
      <div style="display:flex;align-items:center;gap:6px;margin-bottom:0.4rem"><span class="pulse-dot" id="dot-grafana" style="background:#555"></span><strong style="font-size:0.85rem">Grafana</strong></div>
      <div style="color:var(--text-3);font-size:0.72rem">Dashboards</div>
      <div class="mono" style="font-size:0.68rem;margin-top:0.2rem;color:var(--text-3)">:3003</div>
      <div id="status-grafana" style="margin-top:0.3rem;font-size:0.68rem;color:var(--text-3)">Checking...</div>
    </div>
    <div class="stat-card" style="text-align:left">
      <div style="display:flex;align-items:center;gap:6px;margin-bottom:0.4rem"><span class="pulse-dot" id="dot-loki" style="background:#555"></span><strong style="font-size:0.85rem">Loki</strong></div>
      <div style="color:var(--text-3);font-size:0.72rem">Log aggregation</div>
      <div class="mono" style="font-size:0.68rem;margin-top:0.2rem;color:var(--text-3)">:3100</div>
      <div id="status-loki" style="margin-top:0.3rem;font-size:0.68rem;color:var(--text-3)">Checking...</div>
    </div>
    <div class="stat-card" style="text-align:left">
      <div style="display:flex;align-items:center;gap:6px;margin-bottom:0.4rem"><span class="pulse-dot" id="dot-otel-collector" style="background:#555"></span><strong style="font-size:0.85rem">OTel Collector</strong></div>
      <div style="color:var(--text-3);font-size:0.72rem">Trace pipeline</div>
      <div class="mono" style="font-size:0.68rem;margin-top:0.2rem;color:var(--text-3)">:4317</div>
      <div id="status-otel-collector" style="margin-top:0.3rem;font-size:0.68rem;color:var(--text-3)">Checking...</div>
    </div>
  </div>
</div>

<!-- Prometheus Targets -->
<div class="card animate-fade-up delay-100" style="margin-bottom:1.25rem">
  <h3 style="font-size:0.95rem">Prometheus Scrape Targets</h3>
  <div id="targets-container" style="margin-top:0.5rem"><div style="color:var(--text-3);font-size:0.82rem">Loading targets...</div></div>
</div>

<!-- Grafana -->
<div class="card animate-fade-up delay-200" style="margin-bottom:1.25rem">
  <div class="section-header mb-1">
    <h3 style="font-size:0.95rem">Grafana &mdash; Platform Health</h3>
    <a href="${urls.grafana}" target="_blank" class="btn btn-primary btn-sm">Open Grafana</a>
  </div>
  <div id="grafana-container" style="position:relative;min-height:500px">
    <iframe id="grafana-iframe"
      src="${urls.grafana}/d/agentic-platform-health/platform-health?orgId=1&kiosk&refresh=30s"
      width="100%" height="500"
      style="background:var(--surface-1);border-radius:10px;border:1px solid var(--glass-border)"
      loading="lazy"
      allow="fullscreen"></iframe>
    <div id="grafana-fallback" style="display:none;position:absolute;inset:0;align-items:center;justify-content:center;flex-direction:column;gap:0.75rem;background:var(--glass-bg);border-radius:10px;border:1px solid var(--glass-border)">
      <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="var(--text-3)" stroke-width="1.5"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
      <p style="color:var(--text-3);font-size:0.82rem;margin:0">Grafana dashboard loading...</p>
      <a href="${urls.grafana}" target="_blank" class="btn btn-primary btn-sm" style="margin-top:0.25rem">Open Grafana Directly</a>
    </div>
  </div>
</div>

<!-- Pipeline Diagram -->
<div class="card animate-fade-up delay-300">
  <h3 style="font-size:0.95rem">Telemetry Pipeline</h3>
  <div style="margin-top:0.5rem;padding:1rem;border-radius:10px;background:var(--input-bg);border:1px solid var(--glass-border);font-family:monospace;font-size:0.75rem;line-height:2;color:var(--text-2)">
    <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap">
      <span style="background:rgba(139,92,246,0.15);padding:3px 8px;border-radius:6px;color:#8b5cf6;font-weight:600">agent-service</span>
      <span style="color:var(--text-3)">&rarr;</span>
      <span style="background:rgba(6,182,212,0.15);padding:3px 8px;border-radius:6px;color:#06b6d4;font-weight:600">OTel Collector</span>
      <span style="color:var(--text-3)">&rarr;</span>
      <span style="display:flex;flex-direction:column;gap:3px">
        <span style="background:rgba(245,158,11,0.15);padding:3px 8px;border-radius:6px;color:#f59e0b;font-weight:600">Prometheus (metrics)</span>
        <span style="background:rgba(16,185,129,0.15);padding:3px 8px;border-radius:6px;color:#10b981;font-weight:600">Loki (logs)</span>
      </span>
      <span style="color:var(--text-3)">&rarr;</span>
      <span style="background:rgba(244,63,94,0.15);padding:3px 8px;border-radius:6px;color:#f43f5e;font-weight:600">Grafana</span>
    </div>
    <div style="margin-top:0.6rem;display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap">
      <span style="background:rgba(139,92,246,0.15);padding:3px 8px;border-radius:6px;color:#8b5cf6;font-weight:600">agent-service</span>
      <span style="color:var(--text-3)">&rarr;</span>
      <span style="background:rgba(6,182,212,0.15);padding:3px 8px;border-radius:6px;color:#06b6d4;font-weight:600">Langfuse SDK</span>
      <span style="color:var(--text-3)">&rarr;</span>
      <span style="background:rgba(244,63,94,0.15);padding:3px 8px;border-radius:6px;color:#f43f5e;font-weight:600">Langfuse (LLM traces)</span>
    </div>
  </div>
</div>

<script>
function obsRefreshAll() {
  obsRefreshHealth();
  obsLoadTargets();
  obsLoadMetrics();
}

function obsRefreshHealth() {
  fetch('/api/observability/health').then(function(r) { return r.json(); }).then(function(data) {
    var healthy = 0, unhealthy = 0;
    (data.services || []).forEach(function(svc) {
      var dot = document.getElementById('dot-' + svc.name);
      var status = document.getElementById('status-' + svc.name);
      if (svc.status === 'healthy') {
        healthy++;
        if (dot) { dot.style.background = '#10b981'; dot.className = 'pulse-dot pulse-dot-emerald'; }
        if (status) status.innerHTML = '<span style="color:#10b981">Connected</span>';
      } else {
        unhealthy++;
        if (dot) { dot.style.background = '#ef4444'; dot.className = 'pulse-dot'; }
        if (status) status.innerHTML = '<span style="color:#ef4444">' + escapeHtml(svc.error || svc.status || 'Unhealthy') + '</span>';
      }
    });
    document.getElementById('stat-healthy').textContent = healthy;
    document.getElementById('stat-unhealthy').textContent = unhealthy;
  }).catch(function() {
    document.getElementById('stat-healthy').textContent = '?';
    document.getElementById('stat-unhealthy').textContent = '?';
  });
}

function obsLoadTargets() {
  fetch('/api/observability/prometheus/targets').then(function(r) { return r.json(); }).then(function(data) {
    var container = document.getElementById('targets-container');
    if (data.status === 'success' && data.data && data.data.activeTargets) {
      var targets = data.data.activeTargets;
      document.getElementById('stat-targets').textContent = targets.length;
      var html = '<table><tr><th>Job</th><th>Endpoint</th><th>State</th><th>Last Scrape</th></tr>';
      targets.forEach(function(t) {
        var stateColor = t.health === 'up' ? '#10b981' : '#ef4444';
        var lastScrape = t.lastScrape ? new Date(t.lastScrape).toLocaleTimeString() : '-';
        html += '<tr><td><strong>' + escapeHtml(t.labels ? t.labels.job : '-') + '</strong></td>'
          + '<td class="mono" style="font-size:0.75rem;color:var(--text-3)">' + escapeHtml(t.scrapeUrl || '-') + '</td>'
          + '<td><span style="display:inline-flex;align-items:center;gap:5px"><span style="width:7px;height:7px;border-radius:50%;background:' + stateColor + ';display:inline-block"></span>' + escapeHtml(t.health || '-') + '</span></td>'
          + '<td style="color:var(--text-3);font-size:0.75rem">' + lastScrape + '</td></tr>';
      });
      html += '</table>';
      container.innerHTML = html;
    } else {
      container.innerHTML = '<div style="color:var(--text-3);font-size:0.82rem">Could not fetch targets</div>';
      document.getElementById('stat-targets').textContent = '?';
    }
  }).catch(function() {
    document.getElementById('targets-container').innerHTML = '<div style="color:#ef4444;font-size:0.82rem">Prometheus unreachable</div>';
    document.getElementById('stat-targets').textContent = '?';
  });
}

function obsLoadMetrics() {
  fetch('/api/observability/prometheus/query?query=count(%7B__name__!%3D%22%22%7D)').then(function(r) { return r.json(); }).then(function(data) {
    if (data.status === 'success' && data.data && data.data.result && data.data.result[0]) {
      document.getElementById('stat-active-series').textContent = parseInt(data.data.result[0].value[1]).toLocaleString();
    } else {
      document.getElementById('stat-active-series').textContent = '-';
    }
  }).catch(function() { document.getElementById('stat-active-series').textContent = '?'; });
}

/* Init */
obsRefreshAll();
</script>
` }) %>
