/* ── EVALUATION HELPERS ── */
function gradeFor(pct) {
  if (pct >= 95) return '<span style="color:#10b981;font-weight:700">A</span>';
  if (pct >= 85) return '<span style="color:#06b6d4;font-weight:700">B</span>';
  if (pct >= 70) return '<span style="color:#f59e0b;font-weight:700">C</span>';
  if (pct >= 50) return '<span style="color:#f97316;font-weight:700">D</span>';
  return '<span style="color:#f43f5e;font-weight:700">F</span>';
}

function gradeColor(pct) {
  if (pct >= 95) return '#10b981';
  if (pct >= 85) return '#06b6d4';
  if (pct >= 70) return '#f59e0b';
  if (pct >= 50) return '#f97316';
  return '#f43f5e';
}

function computeScores(traces) {
  if (traces.length === 0) return { completion: 0, latency: 0, tool: 0, error: 0, overall: 0 };
  var success = traces.filter(function(t) { return t.status !== 'ERROR'; }).length;
  var completionPct = Math.round(success / traces.length * 100);
  var durations = traces.map(_traceLatency).filter(function(d) { return d > 0; });
  var under5s = durations.filter(function(d) { return d < 5000; }).length;
  var latencyPct = durations.length > 0 ? Math.round(under5s / durations.length * 100) : 0;
  var toolTraces = 0, toolSuccess = 0;
  traces.forEach(function(t) {
    var meta = t.metadata || {};
    var hasTools = (meta.tools_used && meta.tools_used.length > 0);
    if (!hasTools && t.observations) hasTools = t.observations.some(function(o) { return (o.name || '').toLowerCase().indexOf('tool') !== -1; });
    if (hasTools) { toolTraces++; if (t.status !== 'ERROR') toolSuccess++; }
  });
  var toolPct = toolTraces > 0 ? Math.round(toolSuccess / toolTraces * 100) : 100;
  var errorPct = Math.round((1 - (traces.length - success) / traces.length) * 100);
  var overall = Math.round(completionPct * 0.3 + latencyPct * 0.25 + toolPct * 0.2 + errorPct * 0.25);
  return { completion: completionPct, latency: latencyPct, tool: toolPct, error: errorPct, overall: overall };
}

/* ── RENDER EVALUATION TAB ── */
function renderEvaluation() {
  var traces = getFilteredTraces();
  var scores = computeScores(traces);
  var memRes = laMemoryStats;

  var banner = document.getElementById('agent-info-banner');
  if (laSelectedAgent !== '__all__') {
    var agent = laAllAgents.find(function(a) { return a.id === laSelectedAgent; });
    if (agent) {
      banner.style.display = 'block';
      document.getElementById('agent-info-name').textContent = agent.name;
      document.getElementById('agent-info-model').textContent = 'Model: ' + (agent.provider || '') + '/' + (agent.model || '');
      document.getElementById('agent-info-provider').textContent = 'Temp: ' + (agent.temperature != null ? agent.temperature : '-');
      document.getElementById('agent-info-tools').textContent = 'Tools: ' + (agent.tool_ids || []).length + ' | Skills: ' + (agent.skill_ids || []).length;
      document.getElementById('agent-trace-num').textContent = traces.length;
    }
  } else {
    banner.style.display = 'none';
  }

  document.getElementById('eval-completion').textContent = scores.completion + '%';
  document.getElementById('eval-completion-bar').style.width = scores.completion + '%';
  document.getElementById('eval-row-completion').textContent = scores.completion + '%';
  document.getElementById('eval-grade-completion').innerHTML = gradeFor(scores.completion);

  var durations = traces.map(_traceLatency).filter(function(d) { return d > 0; });
  document.getElementById('eval-latency').textContent = scores.latency + '%';
  document.getElementById('eval-latency-bar').style.width = scores.latency + '%';
  var avgLat = durations.length > 0 ? (durations.reduce(function(a, b) { return a + b; }, 0) / durations.length / 1000).toFixed(1) + 's avg' : '-';
  document.getElementById('eval-row-latency').textContent = avgLat;
  document.getElementById('eval-grade-latency').innerHTML = gradeFor(scores.latency);

  document.getElementById('eval-tool-eff').textContent = scores.tool + '%';
  document.getElementById('eval-tool-bar').style.width = scores.tool + '%';
  document.getElementById('eval-row-tools').textContent = scores.tool + '%';
  document.getElementById('eval-grade-tools').innerHTML = gradeFor(scores.tool);

  document.getElementById('eval-row-errors').textContent = scores.error + '%';
  document.getElementById('eval-grade-errors').innerHTML = gradeFor(scores.error);

  var mem = memRes.memory || {};
  var memPct = Math.min(100, Math.round((mem.sessions_with_summary || 0) / Math.max(mem.total_sessions || 1, 1) * 100));
  document.getElementById('eval-row-memory').textContent = memPct + '%';
  document.getElementById('eval-grade-memory').innerHTML = gradeFor(memPct);

  var overall = Math.round(scores.completion * 0.3 + scores.latency * 0.2 + scores.tool * 0.2 + scores.error * 0.2 + memPct * 0.1);
  document.getElementById('eval-row-overall').textContent = overall + '%';
  document.getElementById('eval-grade-overall').innerHTML = gradeFor(overall);
}

