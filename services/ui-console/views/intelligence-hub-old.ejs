<%- include('layout', { title: 'Intelligence Hub', page: 'intelligence-hub', body: `

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem">
  <div>
    <h1 class="text-glow-cyan" style="margin:0">Intelligence Hub</h1>
    <p style="color:var(--text-3);font-size:0.82rem;margin:0.25rem 0 0">Traceability, evaluation scoring &amp; infrastructure observability</p>
  </div>
  <button class="btn btn-sm" onclick="ihRefresh()">
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
    Refresh
  </button>
</div>

<!-- TAB BAR -->
<div id="la-tab-bar" style="display:flex;gap:0;border:1px solid var(--glass-border);border-radius:10px;overflow:hidden;margin-bottom:1.25rem">
  <a href="/intelligence-hub?tab=traces" class="la-tab" id="la-tab-traces" style="text-decoration:none">
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
    Traces
  </a>
  <a href="/intelligence-hub?tab=evaluation" class="la-tab" id="la-tab-evaluation" style="text-decoration:none;border-left:1px solid var(--glass-border)">
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
    Evaluation
  </a>
  <a href="/intelligence-hub?tab=observability" class="la-tab" id="la-tab-observability" style="text-decoration:none;border-left:1px solid var(--glass-border)">
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
    Observability
  </a>
</div>

<!-- ================================================================== -->
<!-- TAB: TRACES -->
<!-- ================================================================== -->
<div id="la-panel-traces">

<!-- Stats Row -->
<div class="grid-4 mb-2" style="margin-bottom:1.25rem">
  <div class="stat-card animate-fade-up">
    <div class="stat-icon stat-icon-cyan"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></div>
    <div class="stat-label">Total Traces</div>
    <div class="stat-number" id="stat-traces">-</div>
  </div>
  <div class="stat-card animate-fade-up delay-100">
    <div class="stat-icon stat-icon-emerald"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
    <div class="stat-label">Avg Latency</div>
    <div class="stat-number" id="stat-latency">-</div>
  </div>
  <div class="stat-card animate-fade-up delay-200">
    <div class="stat-icon stat-icon-violet"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg></div>
    <div class="stat-label">Tool Calls</div>
    <div class="stat-number" id="stat-tool-calls">-</div>
  </div>
  <div class="stat-card animate-fade-up delay-300">
    <div class="stat-icon" style="background:linear-gradient(135deg,rgba(244,63,94,0.15),rgba(244,63,94,0.08));color:#f43f5e"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg></div>
    <div class="stat-label">Errors</div>
    <div class="stat-number" id="stat-errors">-</div>
  </div>
</div>

<!-- Langfuse Dashboard -->
<div class="card animate-fade-up" style="margin-bottom:1.25rem">
  <div class="section-header mb-1">
    <div style="display:flex;align-items:center;gap:0.75rem">
      <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,rgba(244,63,94,0.15),rgba(244,63,94,0.08));display:flex;align-items:center;justify-content:center">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#f43f5e" stroke-width="2"><path d="M12 2a9 9 0 0 1 9 9c0 3.9-3.1 7.1-5 8.9a13 13 0 0 1-4 2.1 13 13 0 0 1-4-2.1C6.1 18.1 3 14.9 3 11a9 9 0 0 1 9-9z"/><circle cx="12" cy="11" r="3"/></svg>
      </div>
      <div>
        <h3 style="margin:0;font-size:0.95rem">Langfuse Analytics</h3>
        <p style="margin:0.15rem 0 0;color:var(--text-3);font-size:0.78rem">Token usage, latency distribution &amp; trace timeline</p>
      </div>
    </div>
    <a href="\${urls.langfuse}" target="_blank" class="btn btn-primary btn-sm">Open Langfuse</a>
  </div>

  <!-- KPI row -->
  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:0.75rem;margin-bottom:1rem">
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:10px;padding:0.6rem 0.75rem;text-align:center">
      <div style="font-size:0.68rem;color:var(--text-3);margin-bottom:0.2rem">Total Tokens</div>
      <div style="font-size:1.05rem;font-weight:700;color:var(--text-1)" id="lf-tokens">-</div>
    </div>
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:10px;padding:0.6rem 0.75rem;text-align:center">
      <div style="font-size:0.68rem;color:var(--text-3);margin-bottom:0.2rem">Avg Tokens/Trace</div>
      <div style="font-size:1.05rem;font-weight:700;color:var(--text-1)" id="lf-avg-tokens">-</div>
    </div>
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:10px;padding:0.6rem 0.75rem;text-align:center">
      <div style="font-size:0.68rem;color:var(--text-3);margin-bottom:0.2rem">Success Rate</div>
      <div style="font-size:1.05rem;font-weight:700;color:#10b981" id="lf-success">-</div>
    </div>
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:10px;padding:0.6rem 0.75rem;text-align:center">
      <div style="font-size:0.68rem;color:var(--text-3);margin-bottom:0.2rem">P95 Latency</div>
      <div style="font-size:1.05rem;font-weight:700;color:#f59e0b" id="lf-p95">-</div>
    </div>
  </div>

  <!-- Latency distribution -->
  <div style="margin-bottom:1rem">
    <div style="font-size:0.75rem;font-weight:600;color:var(--text-2);margin-bottom:0.4rem">Latency Distribution</div>
    <div id="lf-latency-bars" style="display:flex;gap:2px;height:36px;align-items:flex-end;border-radius:6px;overflow:hidden"></div>
    <div style="display:flex;justify-content:space-between;font-size:0.62rem;color:var(--text-3);margin-top:0.2rem">
      <span>&lt;1s</span><span>1-3s</span><span>3-5s</span><span>5-10s</span><span>10s+</span>
    </div>
  </div>

  <!-- Trace Timeline -->
  <div>
    <div style="font-size:0.75rem;font-weight:600;color:var(--text-2);margin-bottom:0.4rem">Trace Timeline</div>
    <div id="lf-timeline" style="display:flex;flex-direction:column;gap:0.3rem;max-height:160px;overflow-y:auto"></div>
  </div>
</div>

<!-- Recent Traces Table -->
<div class="card animate-fade-up delay-100">
  <div class="section-header">
    <h3 style="font-size:0.95rem">Recent Traces</h3>
    <button class="btn btn-secondary btn-sm" onclick="loadTraces()">Refresh</button>
  </div>
  <div id="traces-table" class="mt-1" style="color:var(--text-3);font-size:0.82rem">Loading...</div>
</div>

</div>

<!-- ================================================================== -->
<!-- TAB: EVALUATION -->
<!-- ================================================================== -->
<div id="la-panel-evaluation" style="display:none">

<!-- Agent Info Banner -->
<div id="agent-info-banner" class="card animate-fade-up" style="margin-bottom:1rem;padding:0.75rem 1.25rem;display:none">
  <div style="display:flex;align-items:center;gap:1rem">
    <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,rgba(6,182,212,0.15),rgba(6,182,212,0.08));display:flex;align-items:center;justify-content:center">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#06b6d4" stroke-width="2"><rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="12" cy="5" r="3"/></svg>
    </div>
    <div style="flex:1">
      <strong id="agent-info-name" style="font-size:0.88rem;color:var(--text-1)">-</strong>
      <div style="display:flex;gap:0.75rem;margin-top:0.25rem">
        <span id="agent-info-model" style="font-size:0.72rem;color:var(--text-3)">-</span>
        <span id="agent-info-provider" style="font-size:0.72rem;color:var(--text-3)">-</span>
        <span id="agent-info-tools" style="font-size:0.72rem;color:var(--text-3)">-</span>
      </div>
    </div>
    <div id="agent-trace-count" style="text-align:center">
      <div style="font-size:1.1rem;font-weight:700;color:var(--text-1)" id="agent-trace-num">-</div>
      <div style="font-size:0.68rem;color:var(--text-3)">traces</div>
    </div>
  </div>
</div>

<!-- Evaluation Matrix -->
<div class="card animate-fade-up" style="margin-bottom:1.25rem">
  <div class="section-header mb-1">
    <div style="display:flex;align-items:center;gap:0.75rem">
      <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,rgba(139,92,246,0.15),rgba(139,92,246,0.08));display:flex;align-items:center;justify-content:center">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#8b5cf6" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
      </div>
      <div>
        <h3 style="margin:0;font-size:0.95rem">Evaluation Matrix</h3>
        <p style="margin:0.15rem 0 0;color:var(--text-3);font-size:0.78rem">Quality scoring across key dimensions from trace data</p>
      </div>
    </div>
    <button class="btn btn-secondary btn-sm" onclick="loadEvaluation()">Refresh Scores</button>
  </div>

  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.75rem;margin-bottom:1rem">
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:0.85rem">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.6rem">
        <span style="font-size:0.82rem;font-weight:600;color:var(--text-1)">Completion Rate</span>
        <span id="eval-completion" style="font-size:1.05rem;font-weight:700;color:#10b981">-</span>
      </div>
      <div style="height:5px;background:var(--glass-border);border-radius:3px;overflow:hidden"><div id="eval-completion-bar" style="height:100%;background:linear-gradient(90deg,#10b981,#06b6d4);border-radius:3px;width:0%;transition:width 0.6s"></div></div>
      <div style="font-size:0.65rem;color:var(--text-3);margin-top:0.35rem">% of traces with successful output</div>
    </div>
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:0.85rem">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.6rem">
        <span style="font-size:0.82rem;font-weight:600;color:var(--text-1)">Latency Score</span>
        <span id="eval-latency" style="font-size:1.05rem;font-weight:700;color:#06b6d4">-</span>
      </div>
      <div style="height:5px;background:var(--glass-border);border-radius:3px;overflow:hidden"><div id="eval-latency-bar" style="height:100%;background:linear-gradient(90deg,#06b6d4,#8b5cf6);border-radius:3px;width:0%;transition:width 0.6s"></div></div>
      <div style="font-size:0.65rem;color:var(--text-3);margin-top:0.35rem">% completing under 5s threshold</div>
    </div>
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:0.85rem">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.6rem">
        <span style="font-size:0.82rem;font-weight:600;color:var(--text-1)">Tool Efficiency</span>
        <span id="eval-tool-eff" style="font-size:1.05rem;font-weight:700;color:#f59e0b">-</span>
      </div>
      <div style="height:5px;background:var(--glass-border);border-radius:3px;overflow:hidden"><div id="eval-tool-bar" style="height:100%;background:linear-gradient(90deg,#f59e0b,#f97316);border-radius:3px;width:0%;transition:width 0.6s"></div></div>
      <div style="font-size:0.65rem;color:var(--text-3);margin-top:0.35rem">% of tool-using traces that succeeded</div>
    </div>
  </div>

  <!-- Detailed Table -->
  <table class="mt-1" style="font-size:0.82rem">
    <tr><th>Dimension</th><th>Score</th><th>Grade</th><th>Details</th></tr>
    <tr><td style="font-weight:600">Completion Rate</td><td id="eval-row-completion" class="mono">-</td><td id="eval-grade-completion">-</td><td style="color:var(--text-3);font-size:0.78rem">Traces with valid non-error output</td></tr>
    <tr><td style="font-weight:600">Response Latency</td><td id="eval-row-latency" class="mono">-</td><td id="eval-grade-latency">-</td><td style="color:var(--text-3);font-size:0.78rem">Avg response time (target &lt; 5s)</td></tr>
    <tr><td style="font-weight:600">Tool Usage</td><td id="eval-row-tools" class="mono">-</td><td id="eval-grade-tools">-</td><td style="color:var(--text-3);font-size:0.78rem">Tool call success rate</td></tr>
    <tr><td style="font-weight:600">Error Rate</td><td id="eval-row-errors" class="mono">-</td><td id="eval-grade-errors">-</td><td style="color:var(--text-3);font-size:0.78rem">Inverted error percentage</td></tr>
    <tr><td style="font-weight:600">Memory Utilization</td><td id="eval-row-memory" class="mono">-</td><td id="eval-grade-memory">-</td><td style="color:var(--text-3);font-size:0.78rem">Sessions using multi-turn context</td></tr>
    <tr style="background:rgba(139,92,246,0.05)"><td style="font-weight:700;color:#8b5cf6">Overall Score</td><td id="eval-row-overall" class="mono" style="font-weight:700">-</td><td id="eval-grade-overall" style="font-weight:700">-</td><td style="color:var(--text-3);font-size:0.78rem">Weighted average across all dimensions</td></tr>
  </table>
</div>

<!-- Responsible AI Controls -->
<div class="card animate-fade-up delay-100" style="margin-bottom:1.25rem">
  <div class="section-header mb-1">
    <div style="display:flex;align-items:center;gap:0.75rem">
      <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,rgba(16,185,129,0.15),rgba(16,185,129,0.08));display:flex;align-items:center;justify-content:center">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#10b981" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <div>
        <h3 style="margin:0;font-size:0.95rem">Responsible AI Controls</h3>
        <p style="margin:0.15rem 0 0;color:var(--text-3);font-size:0.78rem" id="rai-subtitle">Governance guardrails, fairness checks &amp; safety monitoring</p>
      </div>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;margin-bottom:0.75rem">
    <!-- Safety -->
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:1rem">
      <div style="display:flex;align-items:center;gap:0.4rem;margin-bottom:0.6rem">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#10b981" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <strong style="font-size:0.82rem;color:#10b981">Content Safety</strong>
      </div>
      <div style="display:flex;flex-direction:column;gap:0.4rem">
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:0.75rem;color:var(--text-2)">Input Validation</span><span class="badge" style="font-size:0.65rem;background:rgba(16,185,129,0.12);color:#10b981">Active</span></div>
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:0.75rem;color:var(--text-2)">System Prompt Guard</span><span id="rai-sys-prompt" class="badge" style="font-size:0.65rem;background:rgba(16,185,129,0.12);color:#10b981">-</span></div>
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:0.75rem;color:var(--text-2)">Output Sanitization</span><span class="badge" style="font-size:0.65rem;background:rgba(16,185,129,0.12);color:#10b981">Active</span></div>
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:0.75rem;color:var(--text-2)">Error Disclosure Guard</span><span class="badge" style="font-size:0.65rem;background:rgba(16,185,129,0.12);color:#10b981">Active</span></div>
      </div>
    </div>
    <!-- Transparency -->
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:1rem">
      <div style="display:flex;align-items:center;gap:0.4rem;margin-bottom:0.6rem">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#06b6d4" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <strong style="font-size:0.82rem;color:#06b6d4">Transparency &amp; Audit</strong>
      </div>
      <div style="display:flex;flex-direction:column;gap:0.4rem">
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:0.75rem;color:var(--text-2)">Full Trace Logging</span><span class="badge" style="font-size:0.65rem;background:rgba(6,182,212,0.12);color:#06b6d4">Langfuse</span></div>
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:0.75rem;color:var(--text-2)">Decision Explainability</span><span class="badge" style="font-size:0.65rem;background:rgba(6,182,212,0.12);color:#06b6d4">Step-by-step</span></div>
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:0.75rem;color:var(--text-2)">Memory Enabled</span><span id="rai-memory" class="badge" style="font-size:0.65rem;background:rgba(6,182,212,0.12);color:#06b6d4">-</span></div>
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:0.75rem;color:var(--text-2)">Knowledge Base</span><span id="rai-kb" class="badge" style="font-size:0.65rem;background:rgba(6,182,212,0.12);color:#06b6d4">-</span></div>
      </div>
    </div>
    <!-- Access -->
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:1rem">
      <div style="display:flex;align-items:center;gap:0.4rem;margin-bottom:0.6rem">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#8b5cf6" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <strong style="font-size:0.82rem;color:#8b5cf6">Access Control</strong>
      </div>
      <div style="display:flex;flex-direction:column;gap:0.4rem">
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:0.75rem;color:var(--text-2)">Agent Isolation</span><span class="badge" style="font-size:0.65rem;background:rgba(139,92,246,0.12);color:#8b5cf6">Per-session</span></div>
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:0.75rem;color:var(--text-2)">Allowed Tools</span><span id="rai-tools" class="badge" style="font-size:0.65rem;background:rgba(139,92,246,0.12);color:#8b5cf6">-</span></div>
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:0.75rem;color:var(--text-2)">Assigned Skills</span><span id="rai-skills" class="badge" style="font-size:0.65rem;background:rgba(139,92,246,0.12);color:#8b5cf6">-</span></div>
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:0.75rem;color:var(--text-2)">Network Isolation</span><span class="badge" style="font-size:0.65rem;background:rgba(139,92,246,0.12);color:#8b5cf6">Docker net</span></div>
      </div>
    </div>
    <!-- Limits -->
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:1rem">
      <div style="display:flex;align-items:center;gap:0.4rem;margin-bottom:0.6rem">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M12 3v18M3 12h18M5.636 5.636l12.728 12.728M18.364 5.636L5.636 18.364"/></svg>
        <strong style="font-size:0.82rem;color:#f59e0b">Reliability &amp; Limits</strong>
      </div>
      <div style="display:flex;flex-direction:column;gap:0.4rem">
