        var dur = o.endTime && o.startTime ? ((new Date(o.endTime) - new Date(o.startTime)) / 1000).toFixed(2) + 's' : '';
        var oUsage = o.usage || {};
        var oTokens = oUsage.totalTokens || oUsage.total || 0;
        html += '<div style="display:flex;align-items:center;gap:0.6rem;padding:0.5rem 0.6rem;background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.04);border-radius:8px;border-left:3px solid ' + color + '">';
