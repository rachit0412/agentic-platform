<%- include('layout', { title: 'Run Agent', page: 'run-agent', body: `

<h1 class="text-glow-cyan">Run Agent</h1>

<div style="display:flex;gap:1.5rem">
  <div style="flex:1">
    <div class="card animate-fade-up">
      <div class="mb-1"><label style="font-size:0.82rem;font-weight:600;color:var(--text-2)">Prompt</label></div>
      <textarea id="prompt" rows="3" placeholder="Ask something... e.g. What is 42 * 13?" style="margin-bottom:0.75rem"></textarea>
      <div class="flex">
        <input id="session" placeholder="Session ID (auto)" style="max-width:250px" />
        <button class="btn btn-primary" id="sendBtn" onclick="runAgent()">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          Send
        </button>
      </div>
    </div>

    <div class="card animate-fade-up delay-100" id="result-card" style="display:none">
      <h3>Response</h3>
      <div id="response" style="white-space:pre-wrap;line-height:1.7;margin-top:0.75rem;color:var(--text-1)"></div>
      <div id="meta" class="mono mt-1" style="font-size:0.72rem"></div>
    </div>

    <div class="card animate-fade-up delay-200">
      <h3>Available Tools</h3>
      <div id="tools-list" class="mt-1" style="color:var(--text-3);font-size:0.82rem">Loading...</div>
    </div>
  </div>

  <div style="width:300px;min-width:300px">
    <div class="card animate-fade-up delay-100">
      <div class="section-header mb-1">
        <h3>Sessions</h3>
        <button class="btn btn-secondary btn-sm" onclick="loadSessions()">Refresh</button>
      </div>
      <div id="sessions-list" style="max-height:400px;overflow-y:auto">
        <span style="color:var(--text-3);font-size:0.82rem">Loading...</span>
      </div>
    </div>
  </div>
</div>

<script>
  async function runAgent() {
    const prompt = document.getElementById('prompt').value.trim();
    if (!prompt) return;
    const session = document.getElementById('session').value || ('s-' + Math.random().toString(36).slice(2,8));
    document.getElementById('session').value = session;
    document.getElementById('sendBtn').disabled = true;
    document.getElementById('sendBtn').style.opacity = '0.6';
    document.getElementById('result-card').style.display = 'block';
    document.getElementById('response').textContent = 'Thinking...';
    document.getElementById('response').style.color = 'var(--text-3)';
    document.getElementById('meta').textContent = '';

    try {
      const r = await fetch('/api/agent-run', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ prompt, sessionId: session })
      });
      const d = await r.json();
      document.getElementById('response').style.color = 'var(--text-1)';
      document.getElementById('response').textContent = d.response || d.error || JSON.stringify(d);
      document.getElementById('meta').textContent =
        'Tools: ' + (d.tools_used||[]).join(', ') +
        ' | Request: ' + (d.request_id||'') +
        ' | Trace: ' + (d.trace_id||'none');
      loadSessions();
    } catch(e) {
      document.getElementById('response').style.color = 'var(--danger)';
      document.getElementById('response').textContent = 'Error: ' + e.message;
    } finally {
      document.getElementById('sendBtn').disabled = false;
      document.getElementById('sendBtn').style.opacity = '1';
    }
  }

  async function loadSessions() {
    try {
      const r = await fetch('/api/sessions');
      const d = await r.json();
      const el = document.getElementById('sessions-list');
      if (!d.sessions || d.sessions.length === 0) {
        el.innerHTML = '<p style="color:var(--text-3);font-size:0.82rem">No sessions yet</p>';
        return;
      }
      el.innerHTML = d.sessions.map(s => \`
        <div class="glass-hover" style="padding:0.625rem 0.875rem;border-radius:12px;margin-bottom:0.5rem;cursor:pointer" onclick="document.getElementById('session').value='\${s.session_id}'">
          <div class="mono" style="font-size:0.72rem;word-break:break-all;color:var(--accent-text)">\${s.session_id}</div>
          <div style="font-size:0.72rem;color:var(--text-3);margin-top:0.25rem">\${s.message_count} messages</div>
        </div>
      \`).join('');
    } catch(e) {
      document.getElementById('sessions-list').innerHTML = '<p style="color:var(--danger);font-size:0.82rem">Failed to load</p>';
    }
  }

  async function loadTools() {
    try {
      const r = await fetch('/api/tools');
      const d = await r.json();
      const el = document.getElementById('tools-list');
      if (!d.tools || d.tools.length === 0) {
        el.innerHTML = '<p style="color:var(--text-3)">No tools registered</p>';
        return;
      }
      el.innerHTML = (d.tools||[]).map(t => \`
        <div style="padding:0.5rem 0;border-bottom:1px solid var(--divider)">
          <strong style="color:var(--text-1);font-size:0.82rem">\${t.name}</strong>
          <span style="color:var(--text-3);font-size:0.78rem"> — \${t.description.slice(0,100)}\${t.description.length>100?'...':''}</span>
        </div>
      \`).join('');
    } catch(e) {
      document.getElementById('tools-list').innerHTML = '<p style="color:var(--text-3)">Could not load tools</p>';
    }
  }

  document.getElementById('prompt').addEventListener('keydown', e => {
    if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) runAgent();
  });

  loadSessions();
  loadTools();
</script>
` }) %>
