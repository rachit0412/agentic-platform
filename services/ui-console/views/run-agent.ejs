<%- include('layout', { title: 'Run Agent', page: 'run-agent', body: `

<h1 class="text-glow-cyan" style="margin-bottom:0.25rem">Run Agent</h1>
<p style="color:var(--text-3);font-size:0.82rem;margin-bottom:1.5rem">Send prompts, pick a model, and watch the agent work in real-time</p>

<!-- Memory & Knowledge Base Status -->
<div class="grid-4 mb-2" style="margin-bottom:1.5rem">
  <a href="/llm-activity" class="stat-card animate-fade-up" style="text-decoration:none;color:inherit;cursor:pointer;transition:transform 0.15s,box-shadow 0.15s" onmouseenter="this.style.transform='translateY(-2px)';this.style.boxShadow='0 4px 20px rgba(6,182,212,0.15)'" onmouseleave="this.style.transform='';this.style.boxShadow=''">
    <div class="stat-icon stat-icon-cyan">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a10 10 0 0 1 10 10 10 10 0 0 1-10 10A10 10 0 0 1 2 12 10 10 0 0 1 12 2z"/><path d="M12 6v6l4 2"/></svg>
    </div>
    <div class="stat-label">Memory Sessions</div>
    <div class="stat-number" id="stat-sessions">-</div>
  </a>
  <a href="/llm-activity" class="stat-card animate-fade-up delay-100" style="text-decoration:none;color:inherit;cursor:pointer;transition:transform 0.15s,box-shadow 0.15s" onmouseenter="this.style.transform='translateY(-2px)';this.style.boxShadow='0 4px 20px rgba(139,92,246,0.15)'" onmouseleave="this.style.transform='';this.style.boxShadow=''">
    <div class="stat-icon stat-icon-violet">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    </div>
    <div class="stat-label">Total Messages</div>
    <div class="stat-number" id="stat-messages">-</div>
  </a>
  <a href="/documents" class="stat-card animate-fade-up delay-200" style="text-decoration:none;color:inherit;cursor:pointer;transition:transform 0.15s,box-shadow 0.15s" onmouseenter="this.style.transform='translateY(-2px)';this.style.boxShadow='0 4px 20px rgba(16,185,129,0.15)'" onmouseleave="this.style.transform='';this.style.boxShadow=''">
    <div class="stat-icon stat-icon-emerald">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
    </div>
    <div class="stat-label">KB Documents</div>
    <div class="stat-number" id="stat-kb-docs">-</div>
  </a>
  <a href="/documents" class="stat-card animate-fade-up delay-300" style="text-decoration:none;color:inherit;cursor:pointer;transition:transform 0.15s,box-shadow 0.15s" onmouseenter="this.style.transform='translateY(-2px)';this.style.boxShadow='0 4px 20px rgba(245,158,11,0.15)'" onmouseleave="this.style.transform='';this.style.boxShadow=''">
    <div class="stat-icon" style="background:linear-gradient(135deg,rgba(251,191,36,0.15),rgba(245,158,11,0.08));color:#f59e0b">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
    </div>
    <div class="stat-label">KB Chunks</div>
    <div class="stat-number" id="stat-kb-chunks">-</div>
  </a>
</div>

<div style="display:flex;gap:1.5rem">
  <div style="flex:1">
    <div class="card animate-fade-up">
      <div class="mb-1"><label style="font-size:0.82rem;font-weight:600;color:var(--text-2)">Prompt</label></div>
      <textarea id="prompt" rows="3" placeholder="Ask something... e.g. What is 42 * 13?" style="margin-bottom:0.75rem"></textarea>
      <div class="flex" style="gap:0.5rem;flex-wrap:wrap;align-items:center">
        <input id="session" placeholder="Session ID (auto)" style="max-width:200px" />
        <select id="agent-select" onchange="onAgentChanged()" style="width:auto;min-width:160px;font-size:0.82rem;padding:0.5rem 0.75rem;border-radius:10px;background:var(--glass-bg);border:1px solid var(--divider);color:var(--text-1)">
          <option value="">Default Agent</option>
        </select>
        <select id="model-select" style="width:auto;min-width:180px;font-size:0.82rem;padding:0.5rem 0.75rem;border-radius:10px;background:var(--glass-bg);border:1px solid var(--divider);color:var(--text-1)">
          <option value="">Default Model</option>
        </select>
        <label style="display:inline-flex;align-items:center;gap:0.35rem;font-size:0.78rem;color:var(--text-2);cursor:pointer;user-select:none;padding:0.35rem 0.6rem;background:var(--glass-bg);border:1px solid var(--divider);border-radius:8px" title="Toggle Knowledge Base retrieval. Disable for faster responses when KB context is not needed.">
          <input type="checkbox" id="use-kb-toggle" checked style="accent-color:#06b6d4;width:15px;height:15px;cursor:pointer" />
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          KB
        </label>
        <button class="btn btn-primary" id="sendBtn" onclick="runAgent()">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          Send
        </button>
        <button class="btn btn-secondary" id="stopBtn" onclick="stopAgent()" style="display:none;background:rgba(244,63,94,0.12);color:#f43f5e;border-color:#f43f5e">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
          Stop
        </button>
        <button class="btn btn-secondary btn-sm" onclick="toggleAdvanced()" style="font-size:0.75rem;padding:0.4rem 0.6rem">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          Settings
        </button>
      </div>

      <!-- Advanced LLM Settings -->
      <div id="advanced-settings" style="display:none;margin-top:0.75rem;padding:0.75rem;background:var(--glass-bg);border:1px solid var(--divider);border-radius:10px">
        <div style="font-size:0.75rem;font-weight:600;color:var(--accent-text);margin-bottom:0.5rem;display:flex;align-items:center;gap:0.4rem">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>
          LLM Parameters
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:0.5rem">
          <div>
            <label style="font-size:0.72rem;color:var(--text-3);display:block;margin-bottom:0.25rem">
              Max Tokens
              <span title="Maximum number of tokens the model can generate in the response. Lower = faster, higher = longer answers. gpt-5-nano supports up to 16384." style="cursor:help;color:var(--accent-text)">&#9432;</span>
            </label>
            <input id="adv-max-tokens" type="number" value="2048" min="1" max="32768" step="256" style="width:100%;font-size:0.82rem;padding:0.35rem 0.5rem" />
            <div style="font-size:0.65rem;color:var(--text-3);margin-top:0.15rem">Recommended: 1024–4096</div>
          </div>
          <div>
            <label style="font-size:0.72rem;color:var(--text-3);display:block;margin-bottom:0.25rem">
              Temperature
              <span title="Controls randomness. 0 = deterministic, 1 = creative, 2 = very random. Default 0.7 is a good balance." style="cursor:help;color:var(--accent-text)">&#9432;</span>
            </label>
            <input id="adv-temperature" type="number" value="0.7" min="0" max="2" step="0.1" style="width:100%;font-size:0.82rem;padding:0.35rem 0.5rem" />
            <div style="font-size:0.65rem;color:var(--text-3);margin-top:0.15rem">Recommended: 0.3–0.7</div>
          </div>
          <div>
            <label style="font-size:0.72rem;color:var(--text-3);display:block;margin-bottom:0.25rem">
              Top P
              <span title="Nucleus sampling: only tokens within the top P probability mass are considered. 1.0 = no filtering. Lower values make output more focused." style="cursor:help;color:var(--accent-text)">&#9432;</span>
            </label>
            <input id="adv-top-p" type="number" value="1.0" min="0" max="1" step="0.05" style="width:100%;font-size:0.82rem;padding:0.35rem 0.5rem" />
            <div style="font-size:0.65rem;color:var(--text-3);margin-top:0.15rem">Recommended: 0.9–1.0</div>
          </div>
        </div>
        <div style="font-size:0.65rem;color:var(--text-3);margin-top:0.5rem;padding-top:0.4rem;border-top:1px solid var(--divider)">
          💡 <strong>Tip:</strong> These values are sent per-request. To change defaults permanently, update environment variables in <code>docker-compose.yml</code> or <code>.env</code>.
        </div>
      </div>
      <div class="mono" style="font-size:0.72rem;color:var(--text-3);margin-top:0.5rem">
        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:middle"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        Use the <strong>KB</strong> toggle to enable/disable Knowledge Base retrieval. Disable it for faster responses.
      </div>
    </div>

    <!-- Skill Inputs Button (opens modal) -->
    <div id="skill-inputs-trigger" style="display:none;margin-top:0.5rem">
      <button class="btn btn-secondary btn-sm" onclick="openSkillModal()" style="font-size:0.75rem;padding:0.4rem 0.7rem;border:1px solid rgba(139,92,246,0.3);background:rgba(139,92,246,0.08);color:#8b5cf6">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#8b5cf6" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        Skill Inputs
        <span id="skill-input-count" style="font-size:0.65rem;background:rgba(139,92,246,0.2);padding:0.1rem 0.35rem;border-radius:4px;margin-left:0.25rem"></span>
      </button>
    </div>

    <!-- Skill Inputs Modal -->
    <div id="skill-inputs-modal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;z-index:1000;background:rgba(0,0,0,0.5);backdrop-filter:blur(4px);align-items:center;justify-content:center">
      <div style="background:var(--card-bg,#1a1a2e);border:1px solid rgba(139,92,246,0.3);border-radius:16px;padding:1.5rem;max-width:600px;width:90%;max-height:80vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,0.5)">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">
          <div style="display:flex;align-items:center;gap:0.5rem">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#8b5cf6" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <h3 style="margin:0;font-size:0.95rem;color:var(--text-1)">Skill Inputs</h3>
          </div>
          <button onclick="closeSkillModal()" style="background:none;border:none;color:var(--text-3);cursor:pointer;font-size:1.2rem;padding:0.25rem 0.5rem;border-radius:6px;transition:background 0.15s" onmouseenter="this.style.background='rgba(255,255,255,0.1)'" onmouseleave="this.style.background='none'">&times;</button>
        </div>
        <p style="font-size:0.72rem;color:var(--text-3);margin-bottom:0.75rem">Fill in parameters for this agent's skills (optional &mdash; the agent will ask if missing)</p>
        <div id="skill-inputs-list"></div>
        <div style="display:flex;justify-content:flex-end;gap:0.5rem;margin-top:1rem;padding-top:0.75rem;border-top:1px solid var(--divider)">
          <button class="btn btn-secondary btn-sm" onclick="closeSkillModal()">Cancel</button>
          <button class="btn btn-primary btn-sm" onclick="closeSkillModal()" style="font-size:0.78rem">Apply</button>
        </div>
      </div>
    </div>

    <div class="card animate-fade-up delay-100" id="result-card" style="display:none">
      <div style="display:flex;align-items:center;justify-content:space-between">
        <h3>Response</h3>
        <div style="display:flex;gap:0.35rem">
          <button class="btn btn-secondary btn-sm" onclick="copyResponse()" title="Copy response" style="font-size:0.72rem;padding:0.3rem 0.5rem">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            Copy
          </button>
          <button class="btn btn-secondary btn-sm" onclick="regenerateResponse()" title="Regenerate response" style="font-size:0.72rem;padding:0.3rem 0.5rem">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
            Retry
          </button>
          <button class="btn btn-secondary btn-sm" onclick="exportResponse()" title="Export" style="font-size:0.72rem;padding:0.3rem 0.5rem">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export
          </button>
        </div>
      </div>
      <div id="response" style="white-space:pre-wrap;line-height:1.7;margin-top:0.75rem;color:var(--text-1)"></div>
      <div id="meta" class="mono mt-1" style="font-size:0.72rem"></div>
    </div>

    <!-- Activity Panel moved to right sidebar -->

    <!-- LLM Execution Details -->
    <div class="card animate-fade-up delay-100" id="exec-detail-card" style="display:none">
      <h3 style="display:flex;align-items:center;gap:0.5rem;cursor:pointer" onclick="window.location.href='/llm-activity'" title="Click to view full LLM Activity Dashboard">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>
        LLM Execution Details
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="var(--text-3)" stroke-width="2" style="margin-left:auto"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      </h3>
      <div id="exec-detail-body" style="margin-top:0.75rem;display:grid;grid-template-columns:1fr 1fr 1fr;gap:0.75rem"></div>
    </div>

    <!-- Guardrail Results -->
    <div class="card animate-fade-up delay-100" id="guardrail-results-card" style="display:none">
      <h3 style="display:flex;align-items:center;gap:0.5rem">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Guardrail Results
      </h3>
      <div id="guardrail-results-body" style="margin-top:0.75rem"></div>
    </div>

    <!-- Control Matrix -->
    <div class="card animate-fade-up delay-100" id="control-matrix-card" style="display:none">
      <h3 style="display:flex;align-items:center;gap:0.5rem">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Control Matrix
        <span style="font-size:0.65rem;color:var(--text-3);font-weight:400">(Post-Run Quality Assessment)</span>
      </h3>
      <div id="control-matrix-body" style="margin-top:0.75rem;display:grid;grid-template-columns:1fr 1fr 1fr;gap:0.75rem"></div>
    </div>

    <div class="card animate-fade-up delay-200" style="display:none">
      <!-- Tools moved to /tools page -->
    </div>
  </div>

  <!-- Right sidebar: Agent Activity -->
  <div style="width:300px;min-width:300px">
    <div class="card animate-fade-up delay-100" id="activity-card" style="display:none">
      <div class="section-header" style="cursor:pointer" onclick="toggleActivity()">
        <h3 style="display:flex;align-items:center;gap:0.5rem;font-size:0.9rem">
          <svg id="activity-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" style="transition:transform 0.2s"><polyline points="6 9 12 15 18 9"/></svg>
          Agent Activity
          <span id="activity-status" class="badge" style="font-size:0.68rem">idle</span>
        </h3>
        <span id="activity-total-time" class="mono" style="font-size:0.72rem;color:var(--text-3)"></span>
      </div>
      <div id="activity-steps" style="margin-top:0.75rem;border-left:2px solid var(--accent);padding-left:0.75rem;max-height:500px;overflow-y:auto"></div>
    </div>
  </div>
</div>

<!-- Bottom Section: Summary + Sessions -->
<div style="display:flex;gap:1.5rem;margin-top:1.5rem">
  <div style="flex:1">
    <div class="card animate-fade-up delay-200" id="summary-card" style="display:none">
      <h3>Session Summary</h3>
      <div id="session-summary" class="mono" style="font-size:0.78rem;color:var(--text-2);white-space:pre-wrap;max-height:200px;overflow-y:auto;line-height:1.5"></div>
    </div>
  </div>
  <div style="flex:1">
    <div class="card animate-fade-up delay-100">
      <div class="section-header mb-1">
        <h3>Sessions</h3>
        <button class="btn btn-secondary btn-sm" onclick="loadSessions()">Refresh</button>
      </div>
      <div id="sessions-list" style="max-height:300px;overflow-y:auto">
        <span style="color:var(--text-3);font-size:0.82rem">Fetching sessions...</span>
      </div>
    </div>
  </div>
</div>

<script>
  let _abortController = null;

  function toggleAdvanced() {
    const el = document.getElementById('advanced-settings');
    el.style.display = el.style.display === 'none' ? 'block' : 'none';
  }

  function stopAgent() {
    if (_abortController) {
      _abortController.abort();
      _abortController = null;
    }
    document.getElementById('sendBtn').disabled = false;
    document.getElementById('sendBtn').style.opacity = '1';
    document.getElementById('stopBtn').style.display = 'none';
    document.getElementById('activity-status').textContent = 'stopped';
    document.getElementById('activity-status').style.background = 'rgba(245,158,11,0.15)';
    document.getElementById('activity-status').style.color = '#f59e0b';
    // Clear any live step timers
    document.querySelectorAll('#activity-steps div').forEach(el => {
      if (el._timerInterval) clearInterval(el._timerInterval);
    });
  }

  async function loadMemoryStats() {
    try {
      const r = await fetch('/api/memory/stats', { signal: AbortSignal.timeout(5000) });
      const d = await r.json();
      document.getElementById('stat-sessions').textContent = d.memory?.total_sessions || 0;
      document.getElementById('stat-messages').textContent = d.memory?.total_messages || 0;
      document.getElementById('stat-kb-docs').textContent = d.knowledge_base?.unique_documents || 0;
      document.getElementById('stat-kb-chunks').textContent = d.knowledge_base?.total_chunks || 0;
    } catch(e) {
      document.getElementById('stat-sessions').textContent = '0';
      document.getElementById('stat-messages').textContent = '0';
      document.getElementById('stat-kb-docs').textContent = '0';
      document.getElementById('stat-kb-chunks').textContent = '0';
    }
  }

  async function loadSessionSummary(sessionId) {
    try {
      const r = await fetch('/api/sessions/' + encodeURIComponent(sessionId) + '/summary');
      const d = await r.json();
      if (d.summary) {
        document.getElementById('summary-card').style.display = 'block';
        document.getElementById('session-summary').textContent = d.summary;
      } else {
        document.getElementById('summary-card').style.display = 'none';
      }
    } catch(e) {
      document.getElementById('summary-card').style.display = 'none';
    }
  }

  async function runAgent() {
    const prompt = document.getElementById('prompt').value.trim();
    if (!prompt) return;
    const session = document.getElementById('session').value || ('s-' + Math.random().toString(36).slice(2,8));
    document.getElementById('session').value = session;

    // Get selected model
    const modelSelect = document.getElementById('model-select');
    const selectedVal = modelSelect.value;
    let provider = null, model = null;
    if (selectedVal) {
      const parts = selectedVal.split(':');
      provider = parts[0];
      model = parts[1];
    }

    // Get selected agent
    const agentSelect = document.getElementById('agent-select');
    const agentId = agentSelect ? agentSelect.value : '';

    document.getElementById('sendBtn').disabled = true;
    document.getElementById('sendBtn').style.opacity = '0.6';
    document.getElementById('stopBtn').style.display = 'inline-flex';
    document.getElementById('result-card').style.display = 'block';
    document.getElementById('response').textContent = '';
    document.getElementById('response').style.color = 'var(--text-1)';
    document.getElementById('meta').textContent = '';

    // Show activity panel
    document.getElementById('activity-card').style.display = 'block';
    document.getElementById('activity-steps').innerHTML = '';
    document.getElementById('activity-status').textContent = 'running';
    document.getElementById('activity-status').style.background = 'rgba(6,182,212,0.15)';
    document.getElementById('activity-status').style.color = '#06b6d4';
    document.getElementById('activity-total-time').textContent = '';

    // Hide post-run cards from previous run
    document.getElementById('exec-detail-card').style.display = 'none';
    document.getElementById('guardrail-results-card').style.display = 'none';
    document.getElementById('control-matrix-card').style.display = 'none';

    const startTime = Date.now();
    const stepElements = {};

    try {
      const payload = { prompt, sessionId: session };
      if (provider) payload.provider = provider;
      if (model) payload.model = model;
      if (agentId) payload.agent_id = agentId;

      // Advanced LLM params
      var advMaxTokens = parseInt(document.getElementById('adv-max-tokens').value);
      var advTempEl = document.getElementById('adv-temperature');
      var advTemp = parseFloat(advTempEl.value);
      var advTopP = parseFloat(document.getElementById('adv-top-p').value);
      if (!isNaN(advMaxTokens) && advMaxTokens > 0) payload.max_completion_tokens = advMaxTokens;
      if (!advTempEl.disabled && !isNaN(advTemp)) payload.temperature = advTemp;
      if (!isNaN(advTopP)) payload.top_p = advTopP;
      payload.use_kb = document.getElementById('use-kb-toggle').checked;

      _abortController = new AbortController();

      const resp = await fetch('/api/agent-run/stream', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify(payload),
        signal: _abortController.signal,
      });

      const reader = resp.body.getReader();
      const decoder = new TextDecoder();
      let buffer = '';
      let fullResponse = '';
      let toolsUsed = [];
      let traceId = '';
      let requestId = '';
      let usageData = null;
      let modelInfo = '';
      let estimatedCost = null;
      let latencyMs = 0;
      let guardrailData = { input: [], output: [] };

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });

        const lines = buffer.split('\\n');
        buffer = lines.pop();

        let eventType = '';
        for (const line of lines) {
          if (line.startsWith('event: ')) {
            eventType = line.slice(7).trim();
          } else if (line.startsWith('data: ')) {
            const raw = line.slice(6);
            handleSSEEvent(eventType, raw, stepElements, {
              onToken: function(t) { fullResponse += t; document.getElementById('response').textContent = fullResponse; },
              onDone: function(d) { toolsUsed = d.tools_used || []; traceId = d.trace_id || ''; requestId = d.request_id || ''; usageData = d.usage || null; modelInfo = d.model ? ((d.provider||'') + '/' + d.model) : ''; estimatedCost = d.estimated_cost != null ? d.estimated_cost : null; latencyMs = d.latency_ms || 0; if (d.guardrails) guardrailData = d.guardrails; },
              onGuardrails: function(d) {
                if (d.phase === 'input') guardrailData.input = d.results || [];
                if (d.phase === 'output') guardrailData.output = d.results || [];
              }
            });
          }
        }
      }

      // Build meta line with tokens
      let metaParts = [];
      if (modelInfo) metaParts.push(modelInfo);
      if (usageData && usageData.total_tokens) {
        metaParts.push('\u{1F4CA} ' + usageData.prompt_tokens + ' in / ' + usageData.completion_tokens + ' out (' + usageData.total_tokens + ' total)');
        var cost = estimatedCost != null ? estimatedCost : _estimateCost(usageData, modelInfo);
        if (cost !== null && cost > 0) metaParts.push('\u{1F4B0} ~$' + cost.toFixed(6));
        else if (cost === 0 || cost === null) metaParts.push('\u{1F4B0} Free (local)');
      }
      metaParts.push('Tools: ' + (toolsUsed.join(', ') || 'none'));
      metaParts.push('Request: ' + requestId);
      if (traceId) metaParts.push('Trace: ' + traceId);
      document.getElementById('meta').textContent = metaParts.join('  \u00B7  ');

      // Render LLM Execution Details card
      _renderExecDetail(usageData, modelInfo, startTime, toolsUsed, traceId, requestId, estimatedCost, latencyMs);

      // Render Guardrail Results card
      _renderGuardrailResults(guardrailData);

      // Render Control Matrix card
      _renderControlMatrix(fullResponse, usageData, toolsUsed, guardrailData);

      document.getElementById('activity-status').textContent = 'done';
      document.getElementById('activity-status').style.background = 'rgba(16,185,129,0.15)';
      document.getElementById('activity-status').style.color = '#10b981';
      document.getElementById('activity-total-time').textContent = ((Date.now() - startTime)/1000).toFixed(1) + 's total';

      loadSessions();
      loadMemoryStats();
      loadSessionSummary(session);
    } catch(e) {
      if (e.name === 'AbortError') {
        document.getElementById('response').style.color = 'var(--warning, #f59e0b)';
        document.getElementById('response').textContent += '\\n\\n⏹ Request stopped by user.';
        document.getElementById('activity-status').textContent = 'stopped';
        document.getElementById('activity-status').style.background = 'rgba(245,158,11,0.15)';
        document.getElementById('activity-status').style.color = '#f59e0b';
      } else {
        document.getElementById('response').style.color = 'var(--danger)';
        document.getElementById('response').textContent = 'Error: ' + e.message;
        document.getElementById('activity-status').textContent = 'error';
        document.getElementById('activity-status').style.background = 'rgba(244,63,94,0.15)';
        document.getElementById('activity-status').style.color = '#f43f5e';
      }
    } finally {
      _abortController = null;
      document.getElementById('sendBtn').disabled = false;
      document.getElementById('sendBtn').style.opacity = '1';
      document.getElementById('stopBtn').style.display = 'none';
      // Clear any remaining live timers
      document.querySelectorAll('#activity-steps div').forEach(el => {
        if (el._timerInterval) clearInterval(el._timerInterval);
      });
    }
  }

  // Rough cost estimation based on model pricing (per 1M tokens)
  function _estimateCost(usage, modelStr) {
    if (!usage || !usage.total_tokens) return null;
    const m = (modelStr || '').toLowerCase();
    // Pricing: [input_per_1M, output_per_1M]
    const pricing = {
      'gpt-4o': [2.50, 10.00],
      'gpt-4o-mini': [0.15, 0.60],
      'gpt-4.1': [2.00, 8.00],
      'gpt-4.1-mini': [0.40, 1.60],
      'gpt-4.1-nano': [0.10, 0.40],
      'gpt-5-nano': [0.10, 0.40],
      'gpt-5.4-mini': [0.40, 1.60],
      'gpt-3.5-turbo': [0.50, 1.50],
    };
    let rate = null;
    for (const [key, val] of Object.entries(pricing)) {
      if (m.includes(key)) { rate = val; break; }
    }
    if (!rate) return null;
    return (usage.prompt_tokens * rate[0] / 1e6) + (usage.completion_tokens * rate[1] / 1e6);
  }

  // ── Render LLM Execution Details ──
  function _renderExecDetail(usage, modelStr, startTime, tools, traceId, requestId, backendCost, backendLatency) {
    var card = document.getElementById('exec-detail-card');
    var body = document.getElementById('exec-detail-body');
    if (!usage && !modelStr) { card.style.display = 'none'; return; }
    card.style.display = 'block';
    var elapsed = backendLatency ? (backendLatency / 1000).toFixed(1) : ((Date.now() - startTime) / 1000).toFixed(1);
    var cost = backendCost != null ? backendCost : _estimateCost(usage, modelStr);
    var costStr = (cost !== null && cost > 0) ? '$' + cost.toFixed(6) : 'Free (local)';
    var tokensPerSec = usage && usage.completion_tokens && elapsed > 0 ? (usage.completion_tokens / elapsed).toFixed(1) : '-';

    function _tile(label, value, color) {
      return '<div style="padding:0.6rem;border-radius:10px;background:var(--glass-bg);border:1px solid var(--divider);text-align:center">' +
        '<div style="font-size:0.68rem;color:var(--text-3);margin-bottom:0.25rem">' + label + '</div>' +
        '<div style="font-size:1.1rem;font-weight:700;color:' + color + '">' + value + '</div></div>';
    }

    body.innerHTML =
      _tile('Model', escapeHtml(modelStr || 'default'), 'var(--text-1)') +
      _tile('Total Time', elapsed + 's', '#06b6d4') +
      _tile('Est. Cost', costStr, '#10b981') +
      _tile('Prompt Tokens', usage ? usage.prompt_tokens : '-', '#8b5cf6') +
      _tile('Completion Tokens', usage ? usage.completion_tokens : '-', '#f59e0b') +
      _tile('Tokens/sec', tokensPerSec, '#06b6d4') +
      _tile('Total Tokens', usage ? usage.total_tokens : '-', 'var(--text-1)') +
      _tile('Tools Used', (tools || []).length, '#8b5cf6') +
      _tile('Trace ID', traceId ? '<a href="/traceability?traceId=' + encodeURIComponent(traceId) + '" style="font-size:0.55rem;word-break:break-all;color:var(--accent);text-decoration:underline;cursor:pointer" title="View in Traceability">' + escapeHtml(traceId.substring(0, 12)) + '...</a>' : 'N/A', 'var(--text-3)') +
      _tile('Request ID', requestId ? '<a href="/llm-activity?requestId=' + encodeURIComponent(requestId) + '" style="font-size:0.65rem;color:var(--accent);text-decoration:underline;cursor:pointer" title="View in LLM Activity">' + escapeHtml(requestId) + '</a>' : 'N/A', 'var(--text-3)');

    // Add "View Full Dashboard" link at bottom
    body.innerHTML += '<div style="grid-column:1/-1;text-align:center;padding-top:0.5rem"><a href="/llm-activity" style="color:var(--accent);font-size:0.78rem;text-decoration:none;display:inline-flex;align-items:center;gap:0.35rem">' +
      '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>' +
      'View LLM Activity Dashboard &rarr;</a></div>';
  }

  // ── Render Guardrail Results ──
  function _renderGuardrailResults(grData) {
    var card = document.getElementById('guardrail-results-card');
    var body = document.getElementById('guardrail-results-body');
    var all = (grData.input || []).concat(grData.output || []);
    if (!all.length) { card.style.display = 'none'; return; }
    card.style.display = 'block';
    var statusColors = { passed: '#10b981', flagged: '#f59e0b', blocked: '#f43f5e' };
    var statusIcons = { passed: '\\u2713', flagged: '\\u26A0', blocked: '\\u2717' };
    var html = '<div style="display:flex;gap:0.5rem;margin-bottom:0.75rem">';
    var passed = all.filter(function(g) { return g.status === 'passed'; }).length;
    var flagged = all.filter(function(g) { return g.status === 'flagged'; }).length;
    var blocked = all.filter(function(g) { return g.status === 'blocked'; }).length;
    html += '<span class="badge" style="background:rgba(16,185,129,0.15);color:#10b981">' + passed + ' passed</span>';
    if (flagged) html += '<span class="badge" style="background:rgba(245,158,11,0.15);color:#f59e0b">' + flagged + ' flagged</span>';
    if (blocked) html += '<span class="badge" style="background:rgba(244,63,94,0.15);color:#f43f5e">' + blocked + ' blocked</span>';
    html += '</div>';

    if (grData.input && grData.input.length) {
      html += '<div style="font-size:0.72rem;font-weight:600;color:var(--text-3);margin-bottom:0.35rem">🛡️ Input Checks</div>';
      grData.input.forEach(function(g) {
        var c = statusColors[g.status] || 'var(--text-3)';
        var latency = g.latency_ms ? '<span class="mono" style="font-size:0.65rem;color:var(--text-3);margin-left:0.25rem">' + g.latency_ms + 'ms</span>' : '';
        var bgColor = g.status === 'blocked' ? 'rgba(244,63,94,0.08)' : g.status === 'flagged' ? 'rgba(245,158,11,0.06)' : 'var(--glass-bg)';
        var border = g.status === 'blocked' ? 'border:1px solid rgba(244,63,94,0.2);' : g.status === 'flagged' ? 'border:1px solid rgba(245,158,11,0.15);' : '';
        html += '<div style="display:flex;align-items:center;gap:0.5rem;padding:0.45rem 0.6rem;margin-bottom:0.25rem;border-radius:8px;background:' + bgColor + ';' + border + 'font-size:0.78rem">' +
          '<span style="color:' + c + ';font-weight:700;font-size:0.88rem">' + (statusIcons[g.status] || '?') + '</span>' +
          '<span style="color:var(--text-2);font-weight:500">' + escapeHtml(g.guardrail) + '</span>' + latency +
          '<span style="margin-left:auto;font-size:0.68rem;color:' + c + ';font-weight:500">' + escapeHtml(g.detail || g.status) + '</span></div>';
      });
    }
    if (grData.output && grData.output.length) {
      html += '<div style="font-size:0.72rem;font-weight:600;color:var(--text-3);margin:0.5rem 0 0.35rem">🛡️ Output Checks</div>';
      grData.output.forEach(function(g) {
        var c = statusColors[g.status] || 'var(--text-3)';
        var latency = g.latency_ms ? '<span class="mono" style="font-size:0.65rem;color:var(--text-3);margin-left:0.25rem">' + g.latency_ms + 'ms</span>' : '';
        var bgColor = g.status === 'blocked' ? 'rgba(244,63,94,0.08)' : g.status === 'flagged' ? 'rgba(245,158,11,0.06)' : 'var(--glass-bg)';
        var border = g.status === 'blocked' ? 'border:1px solid rgba(244,63,94,0.2);' : g.status === 'flagged' ? 'border:1px solid rgba(245,158,11,0.15);' : '';
        html += '<div style="display:flex;align-items:center;gap:0.5rem;padding:0.45rem 0.6rem;margin-bottom:0.25rem;border-radius:8px;background:' + bgColor + ';' + border + 'font-size:0.78rem">' +
          '<span style="color:' + c + ';font-weight:700;font-size:0.88rem">' + (statusIcons[g.status] || '?') + '</span>' +
          '<span style="color:var(--text-2);font-weight:500">' + escapeHtml(g.guardrail) + '</span>' + latency +
          '<span style="margin-left:auto;font-size:0.68rem;color:' + c + ';font-weight:500">' + escapeHtml(g.detail || g.status) + '</span></div>';
      });
    }
    body.innerHTML = html;
  }

  // ── Render Control Matrix (Post-Run Quality Scores) ──
  function _renderControlMatrix(response, usage, tools, grData) {
    var card = document.getElementById('control-matrix-card');
    var body = document.getElementById('control-matrix-body');
    if (!response) { card.style.display = 'none'; return; }
    card.style.display = 'block';

    // Heuristic scoring
    var allGr = (grData.input || []).concat(grData.output || []);
    var grPassed = allGr.filter(function(g) { return g.status === 'passed'; }).length;
    var grTotal = allGr.length || 1;

    // Hallucination score: based on presence of hedging language and citation patterns
    var hedgeWords = ['I think', 'probably', 'might be', 'I believe', 'not sure', 'may not be accurate'];
    var hedgeCount = 0;
    hedgeWords.forEach(function(w) { if (response.toLowerCase().indexOf(w.toLowerCase()) !== -1) hedgeCount++; });
    var citationPattern = /\\[.*?\\]|according to|source:|based on/gi;
    var citations = (response.match(citationPattern) || []).length;
    var hallucinationScore = Math.max(0, Math.min(100, 85 - (hedgeCount * 15) + (citations * 10)));

    // Groundedness score: based on whether KB was used and response has concrete refs
    var hasToolResults = tools && tools.length > 0;
    var groundedness = hasToolResults ? 80 : (citations > 0 ? 75 : 55);
    groundedness = Math.min(100, groundedness + (citations * 5));

    // Drift score: for a single-turn, measure topic coherence (simplified)
    var driftScore = 90; // Base high for single-turn

    // Safety score: based on guardrail results
    var safetyScore = Math.round((grPassed / grTotal) * 100);

    // Completeness: based on response length and structure
    var wordCount = response.split(/\\s+/).length;
    var completeness = wordCount < 10 ? 40 : (wordCount < 30 ? 60 : (wordCount < 100 ? 80 : 90));
    if (response.indexOf('\\n') !== -1) completeness = Math.min(100, completeness + 5);

    // Token efficiency
    var tokenEfficiency = 85;
    if (usage && usage.total_tokens) {
      tokenEfficiency = usage.completion_tokens < 500 ? 95 : (usage.completion_tokens < 1500 ? 85 : 70);
    }

    function _scoreColor(score) {
      if (score >= 80) return '#10b981';
      if (score >= 60) return '#f59e0b';
      return '#f43f5e';
    }

    function _scoreTile(label, score, description) {
      var color = _scoreColor(score);
      return '<div style="padding:0.75rem;border-radius:10px;background:var(--glass-bg);border:1px solid var(--divider);text-align:center" title="' + escapeHtml(description) + '">' +
        '<div style="font-size:0.68rem;color:var(--text-3);margin-bottom:0.35rem">' + label + '</div>' +
        '<div style="position:relative;width:50px;height:50px;margin:0 auto 0.35rem">' +
          '<svg viewBox="0 0 36 36" style="width:50px;height:50px;transform:rotate(-90deg)">' +
            '<circle cx="18" cy="18" r="15.9" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="3"/>' +
            '<circle cx="18" cy="18" r="15.9" fill="none" stroke="' + color + '" stroke-width="3" ' +
              'stroke-dasharray="' + score + ' ' + (100 - score) + '" stroke-linecap="round"/>' +
          '</svg>' +
          '<div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:0.85rem;font-weight:700;color:' + color + '">' + score + '</div>' +
        '</div>' +
        '<div style="font-size:0.6rem;color:var(--text-3)">' + (score >= 80 ? 'Good' : score >= 60 ? 'Fair' : 'Low') + '</div></div>';
    }

    body.innerHTML =
      _scoreTile('Hallucination', hallucinationScore, 'Likelihood the response is factually grounded vs fabricated. Higher = better.') +
      _scoreTile('Groundedness', groundedness, 'How well the response is supported by retrieved context and tool results.') +
      _scoreTile('Drift', driftScore, 'Whether the response stays on topic relative to the prompt.') +
      _scoreTile('Safety', safetyScore, 'Guardrail compliance score. Percentage of guardrail checks passed.') +
      _scoreTile('Completeness', completeness, 'How thoroughly the response addresses the prompt.') +
      _scoreTile('Efficiency', tokenEfficiency, 'Token usage efficiency. Lower token count for good answers = higher score.');
  }

  function handleSSEEvent(type, raw, stepElements, callbacks) {
    if (type === 'step') {
      try {
        const d = JSON.parse(raw);
        const key = d.step + (d.tool || '');
        const stepsEl = document.getElementById('activity-steps');
        if (d.status === 'started') {
          const icons = {
            retrieve_context: '\\u{1F50D}',
            load_memory: '\\u{1F4AD}',
            reason: '\\u{1F9E0}',
            tool_call: '\\u{1F527}',
            generate_response: '\\u{270D}\\uFE0F',
          };
          const el = document.createElement('div');
          el.style.cssText = 'margin-bottom:0.5rem;padding:0.5rem 0.75rem;background:var(--glass-bg);border-radius:8px;display:flex;align-items:center;justify-content:space-between;font-size:0.82rem;transition:all 0.3s';
          el.innerHTML = '<div style="display:flex;align-items:center;gap:0.5rem">' +
            '<span class="step-spinner"></span> ' +
            '<span>' + (icons[d.step]||'\u{1F4CC}') + ' ' + escapeHtml(d.label||d.step) + '</span>' +
            '</div><span class="mono step-timer" style="font-size:0.72rem;color:var(--text-3)">0.0s</span>';
          stepsEl.appendChild(el);
          stepElements[key] = el;
          // Start live elapsed timer
          const timerEl = el.querySelector('.step-timer');
          const stepStart = Date.now();
          el._timerInterval = setInterval(() => {
            timerEl.textContent = ((Date.now() - stepStart) / 1000).toFixed(1) + 's';
          }, 100);
        } else if (d.status === 'done' && stepElements[key]) {
          const el = stepElements[key];
          if (el._timerInterval) clearInterval(el._timerInterval);
          el.querySelector('.step-spinner').outerHTML = '<span style="color:#10b981">\\u2713</span>';
          const dur = el.querySelector('span.mono');
          if (dur) dur.textContent = (d.duration_ms ? (d.duration_ms/1000).toFixed(2) + 's' : '') + (d.detail ? ' — ' + d.detail : '');
        }
      } catch(e) {}
    } else if (type === 'token') {
      try { callbacks.onToken(JSON.parse(raw)); } catch(e) { callbacks.onToken(raw); }
    } else if (type === 'done') {
      try { callbacks.onDone(JSON.parse(raw)); } catch(e) {}
    } else if (type === 'guardrails') {
      try { if (callbacks.onGuardrails) callbacks.onGuardrails(JSON.parse(raw)); } catch(e) {}
    }
  }

  function toggleActivity() {
    const steps = document.getElementById('activity-steps');
    const chevron = document.getElementById('activity-chevron');
    if (steps.style.display === 'none') {
      steps.style.display = 'block';
      chevron.style.transform = 'rotate(0deg)';
    } else {
      steps.style.display = 'none';
      chevron.style.transform = 'rotate(-90deg)';
    }
  }

  async function loadSessions() {
    try {
      const r = await fetch('/api/sessions', { signal: AbortSignal.timeout(5000) });
      const d = await r.json();
      const el = document.getElementById('sessions-list');
      if (!d.sessions || d.sessions.length === 0) {
        el.innerHTML = '<p style="color:var(--text-3);font-size:0.82rem">No sessions yet</p>';
        return;
      }
      el.innerHTML = d.sessions.map(s => \`
        <div class="glass-hover" style="padding:0.625rem 0.875rem;border-radius:12px;margin-bottom:0.5rem;cursor:pointer" onclick="selectSession('\${escapeHtml(s.session_id)}')">
          <div class="mono" style="font-size:0.72rem;word-break:break-all;color:var(--accent-text)">\${escapeHtml(s.session_id)}</div>
          <div style="font-size:0.72rem;color:var(--text-3);margin-top:0.25rem">\${s.message_count} messages</div>
        </div>
      \`).join('');
    } catch(e) {
      document.getElementById('sessions-list').innerHTML = '<p style="color:var(--text-3);font-size:0.82rem">No sessions yet</p>';
    }
  }

  function selectSession(id) {
    document.getElementById('session').value = id;
    loadSessionSummary(id);
  }

  async function loadTools() {
    try {
      const r = await fetch('/api/tools', { signal: AbortSignal.timeout(5000) });
      const d = await r.json();
      const el = document.getElementById('tools-list');
      if (!d.tools || d.tools.length === 0) {
        el.innerHTML = '<p style="color:var(--text-3)">No tools registered</p>';
        return;
      }
      el.innerHTML = (d.tools||[]).map(t => \`
        <div style="padding:0.5rem 0;border-bottom:1px solid var(--divider)">
          <strong style="color:var(--text-1);font-size:0.82rem">\${escapeHtml(t.name)}</strong>
          <span style="color:var(--text-3);font-size:0.78rem"> — \${escapeHtml(t.description.slice(0,100))}\${t.description.length>100?'...':''}</span>
        </div>
      \`).join('');
    } catch(e) {
      document.getElementById('tools-list').innerHTML = '<p style="color:var(--text-3);font-size:0.82rem">No tools registered</p>';
    }
  }

  document.getElementById('prompt').addEventListener('keydown', e => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); runAgent(); }
  });

  var _modelCaps = {}; // provider:model → capabilities

  async function loadModels() {
    try {
      const r = await fetch('/api/models', { signal: AbortSignal.timeout(5000) });
      const d = await r.json();
      const sel = document.getElementById('model-select');
      sel.innerHTML = '';
      if (!d.models || d.models.length === 0) {
        sel.innerHTML = '<option value="">Default Model</option>';
        return;
      }
      d.models.forEach(function(m) {
        var key = m.provider + ':' + m.model;
        _modelCaps[key] = m.capabilities || {};
        var opt = document.createElement('option');
        opt.value = key;
        var provLabel = m.provider === 'azure-openai' ? '\\u2601\\uFE0F Azure' : m.provider === 'openai' ? '\\uD83D\\uDD11 OpenAI' : m.provider === 'azure-foundry' ? '\\uD83C\\uDFED Foundry' : '\\uD83E\\uDD99 Ollama';
        opt.textContent = provLabel + ' \\u2014 ' + m.model;
        if (m.active) opt.selected = true;
        sel.appendChild(opt);
      });
      _updateSettingsForModel();
      sel.addEventListener('change', _updateSettingsForModel);
    } catch(e) {
      document.getElementById('model-select').innerHTML = '<option value="">Default Model</option>';
    }
  }

  function _updateSettingsForModel() {
    var sel = document.getElementById('model-select');
    var key = sel.value;
    var caps = _modelCaps[key] || {};
    var tempInput = document.getElementById('adv-temperature');
    var topPInput = document.getElementById('adv-top-p');
    var maxTokInput = document.getElementById('adv-max-tokens');
    if (caps.temperature === false) {
      tempInput.disabled = true;
      tempInput.value = 1;
      tempInput.style.opacity = '0.4';
      tempInput.title = 'Temperature is not configurable for this model';
      tempInput.parentElement.querySelector('div').textContent = 'Not supported by this model';
    } else {
      tempInput.disabled = false;
      tempInput.style.opacity = '1';
      tempInput.title = '';
      tempInput.parentElement.querySelector('div').textContent = 'Recommended: 0.3\\u20130.7';
    }
    if (caps.max_tokens) {
      maxTokInput.max = caps.max_tokens;
      if (parseInt(maxTokInput.value) > caps.max_tokens) maxTokInput.value = Math.min(2048, caps.max_tokens);
      maxTokInput.parentElement.querySelector('div').textContent = 'Max: ' + caps.max_tokens;
    }
  }

  async function loadAgentsDropdown() {
    try {
      const r = await fetch('/api/agents', { signal: AbortSignal.timeout(5000) });
      const d = await r.json();
      const sel = document.getElementById('agent-select');
      sel.innerHTML = '';
      const agents = d.agents || [];
      if (agents.length === 0) {
        sel.innerHTML = '<option value="">Default Agent</option>';
        return;
      }
      agents.forEach(a => {
        const opt = document.createElement('option');
        opt.value = a.id;
        opt.textContent = '🤖 ' + a.name;
        if (a.is_default) opt.selected = true;
        sel.appendChild(opt);
      });
      // trigger skill input load for the initially selected agent
      onAgentChanged();
    } catch(e) {
      document.getElementById('agent-select').innerHTML = '<option value="">Default Agent</option>';
    }
  }

  // ── Skill Input Parameters ──
  var _agentSkillsCache = {};

  async function onAgentChanged() {
    var list = document.getElementById('skill-inputs-list');
    var trigger = document.getElementById('skill-inputs-trigger');
    var agentId = document.getElementById('agent-select').value;
    if (!agentId) { trigger.style.display = 'none'; list.innerHTML = ''; return; }
    try {
      var agent = _agentSkillsCache[agentId];
      if (!agent) {
        var r = await fetch('/api/agents/' + encodeURIComponent(agentId));
        agent = await r.json();
        _agentSkillsCache[agentId] = agent;
      }
      var skillIds = agent.skill_ids || [];
      if (skillIds.length === 0) { trigger.style.display = 'none'; list.innerHTML = ''; return; }

      // Fetch skills in parallel
      var skills = await Promise.all(skillIds.map(async function(sid) {
        try {
          var sr = await fetch('/api/skills/' + encodeURIComponent(sid));
          return await sr.json();
        } catch(e) { return null; }
      }));
      skills = skills.filter(Boolean);

      // Filter to skills that have input_parameters
      var withParams = skills.filter(function(s) {
        var params = s.input_parameters;
        return params && (typeof params === 'string' ? JSON.parse(params) : params).length > 0;
      });
      var trigger = document.getElementById('skill-inputs-trigger');
      if (withParams.length === 0) { trigger.style.display = 'none'; list.innerHTML = ''; return; }

      // Show trigger button with count
      trigger.style.display = 'block';
      var totalParams = 0;
      withParams.forEach(function(sk) { var p = sk.input_parameters; if (typeof p === 'string') p = JSON.parse(p); totalParams += p.length; });
      document.getElementById('skill-input-count').textContent = totalParams + ' params';
      var html = '';
      withParams.forEach(function(sk) {
        var params = sk.input_parameters;
        if (typeof params === 'string') params = JSON.parse(params);
        html += '<div style="margin-bottom:0.75rem;padding:0.65rem 0.75rem;border-radius:10px;background:var(--glass-bg);border:1px solid var(--divider)">';
        html += '<div style="display:flex;align-items:center;gap:0.4rem;margin-bottom:0.5rem">';
        html += '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#8b5cf6" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>';
        html += '<strong style="font-size:0.82rem;color:var(--text-1)">' + (sk.name || 'Skill') + '</strong>';
        if (sk.description) html += '<span style="font-size:0.7rem;color:var(--text-3);margin-left:0.25rem">' + sk.description.substring(0,60) + '</span>';
        html += '</div>';
        html += '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:0.5rem">';
        params.forEach(function(p) {
          var inputId = 'skill-param-' + sk.id + '-' + p.name;
          var required = p.required;
          html += '<div>';
          html += '<label style="font-size:0.72rem;color:var(--text-2);display:block;margin-bottom:0.2rem">';
          html += p.name;
          if (required) html += ' <span style="color:#ef4444">*</span>';
          html += '</label>';
          if (p.type === 'boolean') {
            html += '<select id="' + inputId + '" data-skill="' + sk.id + '" data-param="' + p.name + '" class="skill-param-input" style="width:100%;font-size:0.8rem;padding:0.35rem 0.5rem;border-radius:8px;background:var(--glass-bg);border:1px solid var(--divider);color:var(--text-1)">';
            html += '<option value="">—</option><option value="true">Yes</option><option value="false">No</option>';
            html += '<\/select>';
          } else {
            html += '<input id="' + inputId + '" data-skill="' + sk.id + '" data-param="' + p.name + '" class="skill-param-input" type="text" placeholder="' + (p.default_value || p.type || '') + '" style="width:100%;font-size:0.8rem;padding:0.35rem 0.5rem;border-radius:8px;background:var(--glass-bg);border:1px solid var(--divider);color:var(--text-1)" />';
          }
          html += '</div>';
        });
        html += '</div>';
        // Show constraints as subtle hints
        var constraints = sk.constraints;
        if (typeof constraints === 'string') try { constraints = JSON.parse(constraints); } catch(e) { constraints = []; }
        if (constraints && constraints.length > 0) {
          html += '<div style="margin-top:0.4rem;font-size:0.65rem;color:var(--text-3)">';
          html += '📋 ' + constraints.slice(0,3).join(' · ');
          html += '</div>';
        }
        html += '</div>';
      });
      list.innerHTML = html;
    } catch(e) {
      panel.style.display = 'none';
      list.innerHTML = '';
    }
  }

  function collectSkillInputs() {
    var inputs = document.querySelectorAll('.skill-param-input');
    var bySkill = {};
    inputs.forEach(function(el) {
      var val = el.value.trim();
      if (!val) return;
      var sid = el.getAttribute('data-skill');
      var pname = el.getAttribute('data-param');
      if (!bySkill[sid]) bySkill[sid] = {};
      bySkill[sid][pname] = val;
    });
    if (Object.keys(bySkill).length === 0) return '';
    var lines = ['[Skill Inputs]'];
    Object.keys(bySkill).forEach(function(sid) {
      var params = bySkill[sid];
      Object.keys(params).forEach(function(k) {
        lines.push(k + ': ' + params[k]);
      });
    });
    return lines.join('\\n');
  }

  // ── Copy / Regenerate / Export ──
  var _lastPrompt = '';

  var _origRunAgent = runAgent;
  runAgent = function() {
    _lastPrompt = document.getElementById('prompt').value.trim();
    // Inject filled skill inputs into the prompt
    var skillContext = collectSkillInputs();
    if (skillContext) {
      document.getElementById('prompt').value = _lastPrompt + '\\n\\n' + skillContext;
    }
    return _origRunAgent();
  };

  function copyResponse() {
    var text = document.getElementById('response').textContent;
    if (!text) return;
    navigator.clipboard.writeText(text).then(function() {
      showToast('Response copied to clipboard', 'success');
    }).catch(function() {
      showToast('Failed to copy', 'error');
    });
  }

  function regenerateResponse() {
    if (!_lastPrompt) { showToast('No previous prompt to retry', 'warning'); return; }
    document.getElementById('prompt').value = _lastPrompt;
    runAgent();
  }

  function exportResponse() {
    var text = document.getElementById('response').textContent;
    var meta = document.getElementById('meta').textContent;
    if (!text) { showToast('No response to export', 'warning'); return; }
    var session = document.getElementById('session').value || 'unknown';
    var content = '# Agent Response Export\\n\\n';
    content += '**Session:** ' + session + '\\n';
    content += '**Date:** ' + new Date().toISOString() + '\\n';
    content += '**Prompt:** ' + _lastPrompt + '\\n\\n';
    content += '## Response\\n\\n' + text + '\\n\\n';
    content += '## Metadata\\n\\n' + meta + '\\n';
    var blob = new Blob([content], { type: 'text/markdown' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'agent-response-' + session + '.md';
    a.click();
    URL.revokeObjectURL(a.href);
    showToast('Response exported', 'success');
  }

  function openSkillModal() {
    var modal = document.getElementById('skill-inputs-modal');
    modal.style.display = 'flex';
  }
  function closeSkillModal() {
    document.getElementById('skill-inputs-modal').style.display = 'none';
  }
  // Close modal on backdrop click
  document.getElementById('skill-inputs-modal').addEventListener('click', function(e) {
    if (e.target === this) closeSkillModal();
  });
  // Close modal on Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeSkillModal();
  });

  loadSessions();
  loadMemoryStats();
  loadModels();
  loadAgentsDropdown();
<\/script>
` }) %>
