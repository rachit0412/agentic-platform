        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#06b6d4" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <strong style="font-size:0.82rem;color:#06b6d4">Transparency &amp; Audit</strong>
      </div>
      <div style="display:flex;flex-direction:column;gap:0.4rem">
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:0.75rem;color:var(--text-2)">Full Trace Logging</span><span class="badge" style="font-size:0.65rem;background:rgba(6,182,212,0.12);color:#06b6d4">Langfuse</span></div>
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:0.75rem;color:var(--text-2)">Decision Explainability</span><span class="badge" style="font-size:0.65rem;background:rgba(6,182,212,0.12);color:#06b6d4">Step-by-step</span></div>
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:0.75rem;color:var(--text-2)">Memory Enabled</span><span id="rai-memory" class="badge" style="font-size:0.65rem;background:rgba(6,182,212,0.12);color:#06b6d4">-</span></div>
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:0.75rem;color:var(--text-2)">Knowledge Base</span><span id="rai-kb" class="badge" style="font-size:0.65rem;background:rgba(6,182,212,0.12);color:#06b6d4">-</span></div>
      </div>
    </div>
    <!-- Access -->
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:1rem">
      <div style="display:flex;align-items:center;gap:0.4rem;margin-bottom:0.6rem">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#8b5cf6" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <strong style="font-size:0.82rem;color:#8b5cf6">Access Control</strong>
      </div>
      <div style="display:flex;flex-direction:column;gap:0.4rem">
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:0.75rem;color:var(--text-2)">Agent Isolation</span><span class="badge" style="font-size:0.65rem;background:rgba(139,92,246,0.12);color:#8b5cf6">Per-session</span></div>
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:0.75rem;color:var(--text-2)">Allowed Tools</span><span id="rai-tools" class="badge" style="font-size:0.65rem;background:rgba(139,92,246,0.12);color:#8b5cf6">-</span></div>
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:0.75rem;color:var(--text-2)">Assigned Skills</span><span id="rai-skills" class="badge" style="font-size:0.65rem;background:rgba(139,92,246,0.12);color:#8b5cf6">-</span></div>
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:0.75rem;color:var(--text-2)">Network Isolation</span><span class="badge" style="font-size:0.65rem;background:rgba(139,92,246,0.12);color:#8b5cf6">Docker net</span></div>
      </div>
    </div>
    <!-- Limits -->
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:1rem">
      <div style="display:flex;align-items:center;gap:0.4rem;margin-bottom:0.6rem">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M12 3v18M3 12h18M5.636 5.636l12.728 12.728M18.364 5.636L5.636 18.364"/></svg>
        <strong style="font-size:0.82rem;color:#f59e0b">Reliability &amp; Limits</strong>
      </div>
      <div style="display:flex;flex-direction:column;gap:0.4rem">
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:0.75rem;color:var(--text-2)">Max Iterations</span><span id="rai-max-iter" class="badge" style="font-size:0.65rem;background:rgba(245,158,11,0.12);color:#f59e0b">-</span></div>
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:0.75rem;color:var(--text-2)">Temperature</span><span id="rai-temperature" class="badge" style="font-size:0.65rem;background:rgba(245,158,11,0.12);color:#f59e0b">-</span></div>
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:0.75rem;color:var(--text-2)">Top P</span><span id="rai-top-p" class="badge" style="font-size:0.65rem;background:rgba(245,158,11,0.12);color:#f59e0b">-</span></div>
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:0.75rem;color:var(--text-2)">Error Rate</span><span id="rai-error-threshold" class="badge" style="font-size:0.65rem;background:rgba(245,158,11,0.12);color:#f59e0b">-</span></div>
      </div>
    </div>
  </div>

  <!-- RAI Summary -->
  <div style="display:flex;align-items:center;gap:0.6rem;padding:0.7rem 0.85rem;background:linear-gradient(135deg,rgba(16,185,129,0.04),rgba(6,182,212,0.04));border:1px solid rgba(16,185,129,0.15);border-radius:10px">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#10b981" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
    <div>
      <strong style="font-size:0.78rem;color:var(--text-1)" id="rai-status">Responsible AI: Checking...</strong>
      <p style="margin:0.1rem 0 0;font-size:0.68rem;color:var(--text-3)" id="rai-detail">Evaluating guardrails and safety controls</p>
    </div>
  </div>
</div>

<!-- Agent Comparison -->
<div class="card animate-fade-up delay-200" id="agent-comparison-card">
  <div class="section-header mb-1">
    <div style="display:flex;align-items:center;gap:0.75rem">
      <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,rgba(6,182,212,0.15),rgba(6,182,212,0.08));display:flex;align-items:center;justify-content:center">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#06b6d4" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
      </div>
      <h3 style="margin:0;font-size:0.95rem">Agent Comparison</h3>
    </div>
  </div>
  <div id="agent-comparison-table" style="color:var(--text-3);font-size:0.82rem">Loading...</div>
</div>

<script>
/* ── STATE ── */
var laAllAgents = [];
var laAllTraces = [];
var laSelectedAgent = '__all__';
var laMemoryStats = {};

function laAgentChanged() {
  laSelectedAgent = document.getElementById('la-agent-select').value;
  renderEvaluation();
  renderRAI();
  renderComparison();
}

function laRefresh() { fetchAllData(); }

/* ── TRACE HELPERS ── */
function _traceLatency(t) {
  if (t.latency && t.latency > 0) return t.latency;
  if (t.updatedAt && t.timestamp) { var diff = new Date(t.updatedAt) - new Date(t.timestamp); if (diff > 0) return diff; }
  var meta = t.metadata || {};
  if (meta.duration_ms) return meta.duration_ms;
  return 0;
}

function getFilteredTraces() {
  if (laSelectedAgent === '__all__') return laAllTraces;
  var agent = laAllAgents.find(function(a) { return a.id === laSelectedAgent; });
  if (!agent) return laAllTraces;
  var agentName = agent.name.toLowerCase();
  var agentId = agent.id.toLowerCase();
  return laAllTraces.filter(function(t) {
    var name = (t.name || '').toLowerCase();
    var meta = JSON.stringify(t.metadata || {}).toLowerCase();
    return name.indexOf(agentName) !== -1 || meta.indexOf(agentName) !== -1 || meta.indexOf(agentId) !== -1;
  });
}

function gradeFor(pct) {
  if (pct >= 95) return '<span style="color:#10b981;font-weight:700">A</span>';
  if (pct >= 85) return '<span style="color:#06b6d4;font-weight:700">B</span>';
  if (pct >= 70) return '<span style="color:#f59e0b;font-weight:700">C</span>';
  if (pct >= 50) return '<span style="color:#f97316;font-weight:700">D</span>';
  return '<span style="color:#f43f5e;font-weight:700">F</span>';
}

function gradeColor(pct) {
  if (pct >= 95) return '#10b981';
  if (pct >= 85) return '#06b6d4';
  if (pct >= 70) return '#f59e0b';
  if (pct >= 50) return '#f97316';
  return '#f43f5e';
}

function computeScores(traces) {
  if (traces.length === 0) return { completion: 0, latency: 0, tool: 0, error: 0, overall: 0 };
  var success = traces.filter(function(t) { return t.status !== 'ERROR'; }).length;
  var completionPct = Math.round(success / traces.length * 100);
  var durations = traces.map(_traceLatency).filter(function(d) { return d > 0; });
  var under5s = durations.filter(function(d) { return d < 5000; }).length;
  var latencyPct = durations.length > 0 ? Math.round(under5s / durations.length * 100) : 0;
  var toolTraces = 0, toolSuccess = 0;
  traces.forEach(function(t) {
    var meta = t.metadata || {};
    var hasTools = (meta.tools_used && meta.tools_used.length > 0);
    if (!hasTools && t.observations) hasTools = t.observations.some(function(o) { return (o.name || '').toLowerCase().indexOf('tool') !== -1; });
    if (hasTools) { toolTraces++; if (t.status !== 'ERROR') toolSuccess++; }
  });
  var toolPct = toolTraces > 0 ? Math.round(toolSuccess / toolTraces * 100) : 100;
  var errorPct = Math.round((1 - (traces.length - success) / traces.length) * 100);
  var overall = Math.round(completionPct * 0.3 + latencyPct * 0.25 + toolPct * 0.2 + errorPct * 0.25);
  return { completion: completionPct, latency: latencyPct, tool: toolPct, error: errorPct, overall: overall };
}

/* ── DATA FETCH ── */
function fetchAllData() {
  Promise.all([
    fetch('/api/agents').then(function(r) { return r.json(); }).catch(function() { return []; }),
    fetch('/api/traces').then(function(r) { return r.json(); }).catch(function() { return { traces: [] }; }),
    fetch('/api/memory/stats').then(function(r) { return r.json(); }).catch(function() { return {}; })
  ]).then(function(results) {
    laAllAgents = results[0].agents || results[0] || [];
    laAllTraces = results[1].traces || [];
    laMemoryStats = results[2];

    /* populate agent selector */
    var sel = document.getElementById('la-agent-select');
    var curVal = sel.value;
    var html = '<option value="__all__">All Agents</option>';
    laAllAgents.forEach(function(a) {
      html += '<option value="' + escapeHtml(a.id) + '"' + (a.id === curVal ? ' selected' : '') + '>' + escapeHtml(a.name) + (a.is_default ? ' (default)' : '') + '</option>';
    });
    sel.innerHTML = html;
    if (curVal && curVal !== '__all__') sel.value = curVal;
    laSelectedAgent = sel.value;

    renderEvaluation();
    renderRAI();
    renderComparison();
  }).catch(function(e) { console.error('fetchAllData failed:', e); });
}

/* ── RENDER EVALUATION ── */
function renderEvaluation() {
  var traces = getFilteredTraces();
  var scores = computeScores(traces);
  var memRes = laMemoryStats;

  var banner = document.getElementById('agent-info-banner');
  if (laSelectedAgent !== '__all__') {
    var agent = laAllAgents.find(function(a) { return a.id === laSelectedAgent; });
    if (agent) {
      banner.style.display = 'block';
      document.getElementById('agent-info-name').textContent = agent.name;
      document.getElementById('agent-info-model').textContent = 'Model: ' + (agent.provider || '') + '/' + (agent.model || '');
      document.getElementById('agent-info-provider').textContent = 'Temp: ' + (agent.temperature != null ? agent.temperature : '-');
      document.getElementById('agent-info-tools').textContent = 'Tools: ' + (agent.tool_ids || []).length + ' | Skills: ' + (agent.skill_ids || []).length;
      document.getElementById('agent-trace-num').textContent = traces.length;
    }
  } else {
    banner.style.display = 'none';
  }

  document.getElementById('eval-completion').textContent = scores.completion + '%';
  document.getElementById('eval-completion-bar').style.width = scores.completion + '%';
  document.getElementById('eval-row-completion').textContent = scores.completion + '%';
  document.getElementById('eval-grade-completion').innerHTML = gradeFor(scores.completion);

  var durations = traces.map(_traceLatency).filter(function(d) { return d > 0; });
  document.getElementById('eval-latency').textContent = scores.latency + '%';
  document.getElementById('eval-latency-bar').style.width = scores.latency + '%';
  var avgLat = durations.length > 0 ? (durations.reduce(function(a, b) { return a + b; }, 0) / durations.length / 1000).toFixed(1) + 's avg' : '-';
  document.getElementById('eval-row-latency').textContent = avgLat;
  document.getElementById('eval-grade-latency').innerHTML = gradeFor(scores.latency);

  document.getElementById('eval-tool-eff').textContent = scores.tool + '%';
  document.getElementById('eval-tool-bar').style.width = scores.tool + '%';
  document.getElementById('eval-row-tools').textContent = scores.tool + '%';
  document.getElementById('eval-grade-tools').innerHTML = gradeFor(scores.tool);

  document.getElementById('eval-row-errors').textContent = scores.error + '%';
  document.getElementById('eval-grade-errors').innerHTML = gradeFor(scores.error);

  var mem = memRes.memory || {};
  var memPct = Math.min(100, Math.round((mem.sessions_with_summary || 0) / Math.max(mem.total_sessions || 1, 1) * 100));
  document.getElementById('eval-row-memory').textContent = memPct + '%';
  document.getElementById('eval-grade-memory').innerHTML = gradeFor(memPct);

  var overall = Math.round(scores.completion * 0.3 + scores.latency * 0.2 + scores.tool * 0.2 + scores.error * 0.2 + memPct * 0.1);
  document.getElementById('eval-row-overall').textContent = overall + '%';
  document.getElementById('eval-grade-overall').innerHTML = gradeFor(overall);
}

/* ── RENDER RAI ── */
function renderRAI() {
  var agent = (laSelectedAgent !== '__all__') ? laAllAgents.find(function(a) { return a.id === laSelectedAgent; }) : null;
  var traces = getFilteredTraces();
  var errorCount = traces.filter(function(t) { return t.status === 'ERROR'; }).length;
  var errorRate = traces.length > 0 ? (errorCount / traces.length * 100).toFixed(1) : '0.0';

  if (agent) {
    document.getElementById('rai-subtitle').textContent = 'Governance controls for agent: ' + agent.name;
    document.getElementById('rai-sys-prompt').textContent = agent.system_prompt ? 'Configured' : 'None';
    document.getElementById('rai-sys-prompt').style.color = agent.system_prompt ? '#10b981' : '#f59e0b';
    document.getElementById('rai-sys-prompt').style.background = agent.system_prompt ? 'rgba(16,185,129,0.12)' : 'rgba(245,158,11,0.12)';
    document.getElementById('rai-memory').textContent = agent.memory_enabled ? 'Enabled' : 'Disabled';
    document.getElementById('rai-memory').style.color = agent.memory_enabled ? '#06b6d4' : '#f59e0b';
    document.getElementById('rai-kb').textContent = agent.kb_collection || 'None';
    document.getElementById('rai-tools').textContent = (agent.tool_ids || []).length + ' tools';
    document.getElementById('rai-skills').textContent = (agent.skill_ids || []).length + ' skills';
    document.getElementById('rai-max-iter').textContent = (agent.max_iterations || 10) + ' loops';
    document.getElementById('rai-temperature').textContent = agent.temperature != null ? agent.temperature : '-';
    document.getElementById('rai-temperature').style.color = (agent.temperature || 0) > 1.0 ? '#f43f5e' : '#f59e0b';
    document.getElementById('rai-temperature').style.background = (agent.temperature || 0) > 1.0 ? 'rgba(244,63,94,0.12)' : 'rgba(245,158,11,0.12)';
    document.getElementById('rai-top-p').textContent = agent.top_p != null ? agent.top_p : '1';
  } else {
    document.getElementById('rai-subtitle').textContent = 'Global governance guardrails, fairness checks & safety monitoring';
    ['rai-sys-prompt','rai-memory','rai-kb','rai-tools','rai-skills','rai-max-iter','rai-top-p'].forEach(function(id) {
      var el = document.getElementById(id);
      if (el) el.textContent = 'Per-agent';
    });
    document.getElementById('rai-temperature').textContent = 'Per-agent';
    document.getElementById('rai-temperature').style.color = '#f59e0b';
    document.getElementById('rai-temperature').style.background = 'rgba(245,158,11,0.12)';
  }

  document.getElementById('rai-error-threshold').textContent = errorRate + '%';
  document.getElementById('rai-error-threshold').style.color = parseFloat(errorRate) > 10 ? '#f43f5e' : '#f59e0b';
  document.getElementById('rai-error-threshold').style.background = parseFloat(errorRate) > 10 ? 'rgba(244,63,94,0.12)' : 'rgba(245,158,11,0.12)';

  var issues = [];
  if (parseFloat(errorRate) > 20) issues.push('high error rate (' + errorRate + '%)');
  if (traces.length === 0) issues.push('no traces recorded');
  if (agent && !agent.system_prompt) issues.push('no system prompt');
  if (agent && (agent.temperature || 0) > 1.0) issues.push('high temperature');

  var raiEl = document.getElementById('rai-status');
  var raiDetail = document.getElementById('rai-detail');
  if (issues.length === 0) {
    raiEl.textContent = 'Responsible AI: All Controls Active';
    raiEl.style.color = '#10b981';
    raiDetail.textContent = traces.length + ' traces monitored \\u2014 ' + errorRate + '% error rate \\u2014 guardrails operational';
  } else {
    raiEl.textContent = 'Responsible AI: ' + issues.length + ' concern(s)';
    raiEl.style.color = '#f59e0b';
    raiDetail.textContent = issues.join(', ');
  }
}

/* ── RENDER COMPARISON ── */
function renderComparison() {
  if (laSelectedAgent !== '__all__') {
    document.getElementById('agent-comparison-card').style.display = 'none';
    return;
  }
  document.getElementById('agent-comparison-card').style.display = 'block';
  if (laAllAgents.length === 0) {
    document.getElementById('agent-comparison-table').innerHTML = '<p style="color:var(--text-3)">No agents registered yet.</p>';
    return;
  }
  var html = '<table><tr><th>Agent</th><th>Model</th><th>Traces</th><th>Completion</th><th>Latency</th><th>Error Rate</th><th>Overall</th><th>RAI</th></tr>';
  laAllAgents.forEach(function(agent) {
    var agentName = agent.name.toLowerCase();
    var agentId = agent.id.toLowerCase();
    var agentTraces = laAllTraces.filter(function(t) {
      var name = (t.name || '').toLowerCase();
      var meta = JSON.stringify(t.metadata || {}).toLowerCase();
      return name.indexOf(agentName) !== -1 || meta.indexOf(agentName) !== -1 || meta.indexOf(agentId) !== -1;
    });
    var scores = computeScores(agentTraces);
    var raiIssues = [];
    if (!agent.system_prompt) raiIssues.push('no prompt');
    if ((agent.temperature || 0) > 1.0) raiIssues.push('high temp');
    if (scores.error < 80 && agentTraces.length > 0) raiIssues.push('errors');
    var raiBadge = raiIssues.length === 0
      ? '<span class="badge" style="font-size:0.65rem;background:rgba(16,185,129,0.12);color:#10b981">OK</span>'
      : '<span class="badge" style="font-size:0.65rem;background:rgba(245,158,11,0.12);color:#f59e0b">' + raiIssues.length + ' issue(s)</span>';
    html += '<tr>' +
      '<td style="font-weight:600">' + escapeHtml(agent.name) + (agent.is_default ? ' <span style="font-size:0.62rem;color:var(--text-3)">(default)</span>' : '') + '</td>' +
      '<td class="mono" style="font-size:0.75rem">' + escapeHtml(agent.provider || '') + '/' + escapeHtml(agent.model || '') + '</td>' +
      '<td class="mono">' + agentTraces.length + '</td>' +
      '<td><span style="color:' + gradeColor(scores.completion) + ';font-weight:600">' + scores.completion + '%</span></td>' +
      '<td><span style="color:' + gradeColor(scores.latency) + ';font-weight:600">' + scores.latency + '%</span></td>' +
      '<td><span style="color:' + gradeColor(scores.error) + ';font-weight:600">' + scores.error + '%</span></td>' +
      '<td><span style="font-weight:700">' + scores.overall + '% ' + gradeFor(scores.overall) + '</span></td>' +
      '<td>' + raiBadge + '</td></tr>';
  });
  html += '</table>';
  document.getElementById('agent-comparison-table').innerHTML = html;
}

fetchAllData();
</script>
