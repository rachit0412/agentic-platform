<%- include('layout', { title: 'Workflows', page: 'workflows', body: `

<h1 class="text-glow-cyan">Workflows</h1>

<!-- When to Use n8n -->
<div class="card animate-fade-up" style="margin-bottom:1.5rem;border:1px solid rgba(245,158,11,0.2);background:linear-gradient(135deg, rgba(245,158,11,0.04), rgba(6,182,212,0.03))">
  <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1rem">
    <div style="width:36px;height:36px;border-radius:10px;background:rgba(245,158,11,0.12);display:flex;align-items:center;justify-content:center">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#f59e0b" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
    </div>
    <div>
      <h3 style="margin:0;font-size:1.05rem">When to Use n8n vs. Running an Agent Directly</h3>
      <p style="margin:0;color:var(--text-3);font-size:0.78rem">n8n orchestrates the <em>outside world</em> — LangGraph handles the <em>agent brain</em>.</p>
    </div>
  </div>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
    <div style="padding:1rem;border-radius:12px;background:rgba(245,158,11,0.06);border:1px solid rgba(245,158,11,0.15)">
      <strong style="font-size:0.88rem;color:#f59e0b;display:block;margin-bottom:0.5rem">Use n8n when you need:</strong>
      <ul style="color:var(--text-2);font-size:0.82rem;line-height:1.8;margin:0;padding-left:1.25rem">
        <li><strong>Scheduled runs</strong> — daily summaries, hourly health checks, cron-based reports</li>
        <li><strong>Webhook triggers</strong> — Slack messages, GitHub events, form submissions trigger an agent</li>
        <li><strong>Multi-step pipelines</strong> — chain multiple API calls, transform data, then feed to an agent</li>
        <li><strong>RAG ingest automation</strong> — scrape a URL, extract text, embed into ChromaDB on a schedule</li>
        <li><strong>External API chains</strong> — connect to CRMs, databases, email, Slack, or any REST API</li>
      </ul>
    </div>
    <div style="padding:1rem;border-radius:12px;background:rgba(6,182,212,0.06);border:1px solid rgba(6,182,212,0.15)">
      <strong style="font-size:0.88rem;color:#06b6d4;display:block;margin-bottom:0.5rem">Use the Agent directly when you need:</strong>
      <ul style="color:var(--text-2);font-size:0.82rem;line-height:1.8;margin:0;padding-left:1.25rem">
        <li><strong>Interactive chat</strong> — real-time Q&A, conversation with streaming responses</li>
        <li><strong>One-off tasks</strong> — "summarize this document", "review this code"</li>
        <li><strong>Debugging & testing</strong> — iterate on prompts, check tool calls, tune behavior</li>
        <li><strong>Real-time RAG</strong> — ask questions against the knowledge base interactively</li>
        <li><strong>Agent development</strong> — build and test agents before automating with n8n</li>
      </ul>
    </div>
  </div>
  <p style="color:var(--text-3);font-size:0.78rem;margin:0.75rem 0 0;line-height:1.5"><strong style="color:var(--text-2)">Typical pattern:</strong> Build &amp; test your agent in <a href="/run-agent" style="color:#06b6d4;text-decoration:none">Run Agent</a>, then connect it to n8n workflows for automated, production-scale operation.</p>
</div>

<!-- n8n Editor -->
<div class="card animate-fade-up delay-100" style="margin-bottom:1.5rem">
  <div class="section-header mb-1">
    <h3>n8n Workflow Editor</h3>
    <a href="${urls.n8n}" target="_blank" class="btn btn-primary btn-sm">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      Open n8n
    </a>
  </div>
  <div style="display:flex;align-items:center;justify-content:center;height:200px;background:linear-gradient(135deg,rgba(0,210,255,0.06),rgba(139,92,246,0.06));border-radius:16px;border:1px dashed var(--glass-border)">
    <div style="text-align:center">
      <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="var(--accent-text)" stroke-width="1.5" style="margin-bottom:1rem;opacity:0.7"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
      <p style="color:var(--text-2);font-size:0.92rem;margin-bottom:0.75rem">n8n opens in a separate window for security</p>
      <a href="${urls.n8n}" target="_blank" class="btn btn-primary">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        Launch n8n Editor
      </a>
      <p class="mono" style="color:var(--text-3);font-size:0.72rem;margin-top:0.5rem">${urls.n8n}</p>
    </div>
  </div>
</div>

<div class="card animate-fade-up delay-200" style="margin-bottom:1.5rem">
  <div class="section-header mb-1">
    <h3>Workflow Templates</h3>
    <button class="btn btn-secondary btn-sm" onclick="loadWorkflows()">Refresh</button>
  </div>
  <p style="color:var(--text-3);font-size:0.78rem;margin-bottom:0.75rem">Pre-built workflows in <code style="font-size:0.75rem">n8n/workflows/</code>. Import them into n8n to get started quickly.</p>
  <table class="mt-1">
    <tr><th>Name</th><th>Use Case</th><th>How It Works</th><th>Status</th></tr>
    <tr>
      <td><strong>Agent Run Webhook</strong></td>
      <td style="color:var(--text-2);font-size:0.82rem">Expose your agent as an API for external apps</td>
      <td class="mono" style="font-size:0.78rem;color:var(--text-3)">POST /webhook/agent-run → agent-service → response + traceId</td>
      <td><span class="badge badge-success">Active</span></td>
    </tr>
    <tr>
      <td><strong>RAG Document Ingest</strong></td>
      <td style="color:var(--text-2);font-size:0.82rem">Auto-feed documents into the knowledge base via API</td>
      <td class="mono" style="font-size:0.78rem;color:var(--text-3)">POST /webhook/rag-ingest → chunk + embed → ChromaDB</td>
      <td><span class="badge badge-warning">Template</span></td>
    </tr>
    <tr>
      <td><strong>Scheduled Summary</strong></td>
      <td style="color:var(--text-2);font-size:0.82rem">Daily automated report generation at 9 AM</td>
      <td class="mono" style="font-size:0.78rem;color:var(--text-3)">Cron 9am → agent prompt → save report to data/notes/</td>
      <td><span class="badge badge-warning">Template</span></td>
    </tr>
    <tr>
      <td><strong>Web Research Pipeline</strong></td>
      <td style="color:var(--text-2);font-size:0.82rem">Search the web, then have the agent analyze results</td>
      <td class="mono" style="font-size:0.78rem;color:var(--text-3)">POST /webhook/web-research → DuckDuckGo → agent summarization</td>
      <td><span class="badge badge-warning">Template</span></td>
    </tr>
  </table>
</div>

<div class="card animate-fade-up delay-200">
  <h3>n8n API — Active Workflows</h3>
  <div id="n8n-workflows" class="mt-1" style="color:var(--text-3);font-size:0.82rem">Loading...</div>
</div>

<script>
async function loadWorkflows() {
  try {
    const r = await fetch('/api/n8n/workflows');
    const d = await r.json();
    const el = document.getElementById('n8n-workflows');
    if (!d.workflows || d.workflows.length === 0) {
      el.innerHTML = '<p style="color:var(--text-3)">No active workflows found. Import templates via n8n.</p>';
      return;
    }
    el.innerHTML = '<table><tr><th>ID</th><th>Name</th><th>Active</th><th>Updated</th></tr>' +
      d.workflows.map(w => \`<tr>
        <td class="mono">\${w.id}</td>
        <td>\${w.name || '-'}</td>
        <td><span class="badge \${w.active ? 'badge-success' : 'badge-warning'}">\${w.active ? 'Active' : 'Inactive'}</span></td>
        <td class="mono">\${w.updatedAt ? new Date(w.updatedAt).toLocaleDateString() : '-'}</td>
      </tr>\`).join('') + '</table>';
  } catch(e) {
    document.getElementById('n8n-workflows').innerHTML = '<p style="color:var(--text-3)">Could not connect to n8n API</p>';
  }
}
loadWorkflows();
</script>
` }) %>
