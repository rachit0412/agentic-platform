<%- include('layout', { title: 'Traceability', page: 'traceability', body: `

<h1 class="text-glow-cyan">Traceability</h1>

<!-- Stats Row -->
<div class="grid-4 mb-2" style="margin-bottom:1.5rem">
  <div class="stat-card animate-fade-up">
    <div class="stat-icon stat-icon-cyan">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
    </div>
    <div class="stat-label">Total Traces</div>
    <div class="stat-number" id="stat-traces">-</div>
  </div>
  <div class="stat-card animate-fade-up delay-100">
    <div class="stat-icon stat-icon-emerald">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    </div>
    <div class="stat-label">Avg Latency</div>
    <div class="stat-number" id="stat-latency">-</div>
  </div>
  <div class="stat-card animate-fade-up delay-200">
    <div class="stat-icon stat-icon-violet">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
    </div>
    <div class="stat-label">Tool Calls</div>
    <div class="stat-number" id="stat-tool-calls">-</div>
  </div>
  <div class="stat-card animate-fade-up delay-300">
    <div class="stat-icon" style="background:linear-gradient(135deg,rgba(244,63,94,0.15),rgba(244,63,94,0.08));color:#f43f5e">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
    </div>
    <div class="stat-label">Errors</div>
    <div class="stat-number" id="stat-errors">-</div>
  </div>
</div>

<!-- Langfuse Dashboard (Native) -->
<div class="card animate-fade-up" style="margin-bottom:1.5rem">
  <div class="section-header mb-1">
    <div style="display:flex;align-items:center;gap:1rem">
      <div style="width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,rgba(244,63,94,0.15),rgba(244,63,94,0.08));display:flex;align-items:center;justify-content:center">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#f43f5e" stroke-width="2"><path d="M12 2a9 9 0 0 1 9 9c0 3.9-3.1 7.1-5 8.9a13 13 0 0 1-4 2.1 13 13 0 0 1-4-2.1C6.1 18.1 3 14.9 3 11a9 9 0 0 1 9-9z"/><circle cx="12" cy="11" r="3"/></svg>
      </div>
      <div>
        <h3 style="margin:0">Langfuse Dashboard</h3>
        <p style="margin:0.25rem 0 0;color:var(--text-3);font-size:0.82rem">Tracing, cost analysis & latency breakdown — data via Langfuse API</p>
      </div>
    </div>
    <a href="${urls.langfuse}" target="_blank" class="btn btn-primary btn-sm">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      Open Full Langfuse
    </a>
  </div>

  <!-- Langfuse KPI row -->
  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:0.75rem;margin-bottom:1rem">
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:0.75rem 1rem;text-align:center">
      <div style="font-size:0.72rem;color:var(--text-3);margin-bottom:0.25rem">Total Tokens</div>
      <div style="font-size:1.15rem;font-weight:700;color:var(--text-1)" id="lf-tokens">-</div>
    </div>
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:0.75rem 1rem;text-align:center">
      <div style="font-size:0.72rem;color:var(--text-3);margin-bottom:0.25rem">Avg Tokens/Trace</div>
      <div style="font-size:1.15rem;font-weight:700;color:var(--text-1)" id="lf-avg-tokens">-</div>
    </div>
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:0.75rem 1rem;text-align:center">
      <div style="font-size:0.72rem;color:var(--text-3);margin-bottom:0.25rem">Success Rate</div>
      <div style="font-size:1.15rem;font-weight:700;color:#10b981" id="lf-success">-</div>
    </div>
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:0.75rem 1rem;text-align:center">
      <div style="font-size:0.72rem;color:var(--text-3);margin-bottom:0.25rem">P95 Latency</div>
      <div style="font-size:1.15rem;font-weight:700;color:#f59e0b" id="lf-p95">-</div>
    </div>
  </div>

  <!-- Latency distribution bar -->
  <div style="margin-bottom:1rem">
    <div style="font-size:0.78rem;font-weight:600;color:var(--text-2);margin-bottom:0.5rem">Latency Distribution</div>
    <div id="lf-latency-bars" style="display:flex;gap:2px;height:40px;align-items:flex-end;border-radius:6px;overflow:hidden"></div>
    <div style="display:flex;justify-content:space-between;font-size:0.65rem;color:var(--text-3);margin-top:0.25rem">
      <span>&lt;1s</span><span>1-3s</span><span>3-5s</span><span>5-10s</span><span>10s+</span>
    </div>
  </div>

  <!-- Trace Timeline -->
  <div>
    <div style="font-size:0.78rem;font-weight:600;color:var(--text-2);margin-bottom:0.5rem">Trace Timeline</div>
    <div id="lf-timeline" style="display:flex;flex-direction:column;gap:0.35rem;max-height:180px;overflow-y:auto"></div>
  </div>
</div>

<!-- Recent Traces -->
<div class="card animate-fade-up delay-100" style="margin-bottom:1.5rem">
  <div class="section-header">
    <h3>Recent Traces</h3>
    <button class="btn btn-secondary btn-sm" onclick="loadTraces()">Refresh</button>
  </div>
  <div id="traces-table" class="mt-1" style="color:var(--text-3);font-size:0.82rem">Loading...</div>
</div>

<!-- Trace detail is shown via showDetailModal -->

<script>
function _traceLatency(t) {
  // Prefer Langfuse-computed latency, fall back to timestamp diff
  if (t.latency && t.latency > 0) return t.latency;
  if (t.updatedAt && t.timestamp) {
    var diff = new Date(t.updatedAt) - new Date(t.timestamp);
    if (diff > 0) return diff;
  }
  // Check metadata for duration
  var meta = t.metadata || {};
  if (meta.duration_ms) return meta.duration_ms;
  return 0;
}

function _traceTokens(t) {
  var u = t.usage || t.totalUsage || {};
  var meta = t.metadata || {};
  if (meta.usage) u = meta.usage;
  return {
    input: u.promptTokens || u.inputTokens || u.input_tokens || u.prompt_tokens || u.input || 0,
    output: u.completionTokens || u.outputTokens || u.output_tokens || u.completion_tokens || u.output || 0,
    total: u.totalTokens || u.total_tokens || u.total || 0,
  };
}

function _traceModel(t) {
  var meta = t.metadata || {};
  if (meta.model) return (meta.provider ? meta.provider + '/' : '') + meta.model;
  return '';
}

function loadTraces() {
  fetch('/api/traces').then(r=>r.json()).then(d=>{
    var el = document.getElementById('traces-table');
    var traces = d.traces || [];

    // Update top stats
    document.getElementById('stat-traces').textContent = traces.length;
    var durations = traces.map(t=>_traceLatency(t)).filter(d=>d>0);
    var avgMs = durations.length ? durations.reduce(function(a,b){return a+b},0)/durations.length : 0;
    document.getElementById('stat-latency').textContent = durations.length
      ? (avgMs/1000).toFixed(1) + 's' : '-';

    var toolCount = 0;
    traces.forEach(function(t) {
      var meta = t.metadata || {};
      if (meta.tools_used && Array.isArray(meta.tools_used)) { toolCount += meta.tools_used.length; return; }
      if (t.observations) {
        toolCount += t.observations.filter(function(o) { return o.type === 'SPAN' && (o.name||'').toLowerCase().includes('tool'); }).length;
      }
    });
    document.getElementById('stat-tool-calls').textContent = toolCount;

    var errorTraces = traces.filter(function(t){return t.status==='ERROR'});
    document.getElementById('stat-errors').textContent = errorTraces.length;

    // Token stats
    var totalTokens = 0, tracesWithTokens = 0;
    traces.forEach(function(t) {
      var toks = _traceTokens(t);
      if (toks.total > 0) { totalTokens += toks.total; tracesWithTokens++; }
    });
    document.getElementById('lf-tokens').textContent = totalTokens > 0 ? totalTokens.toLocaleString() : '-';
    document.getElementById('lf-avg-tokens').textContent = tracesWithTokens > 0 ? Math.round(totalTokens/tracesWithTokens).toLocaleString() : '-';

    // Success rate
    var successCount = traces.filter(function(t) { return t.status !== 'ERROR'; }).length;
    document.getElementById('lf-success').textContent = traces.length > 0
      ? Math.round(successCount/traces.length*100) + '%' : '-';
    document.getElementById('lf-success').style.color = traces.length > 0 && successCount/traces.length < 0.9 ? '#f43f5e' : '#10b981';

    // P95 latency
    if (durations.length > 0) {
      var sorted = durations.slice().sort(function(a,b){return a-b});
      var p95idx = Math.min(Math.floor(sorted.length * 0.95), sorted.length-1);
      document.getElementById('lf-p95').textContent = (sorted[p95idx]/1000).toFixed(1) + 's';
    }

    // Latency distribution bars
    var buckets = [0,0,0,0,0];
    durations.forEach(function(ms) {
      var s = ms/1000;
      if (s < 1) buckets[0]++;
      else if (s < 3) buckets[1]++;
      else if (s < 5) buckets[2]++;
      else if (s < 10) buckets[3]++;
      else buckets[4]++;
    });
    var maxBucket = Math.max.apply(null, buckets.concat([1]));
    var colors = ['#10b981','#06b6d4','#f59e0b','#f97316','#f43f5e'];
    document.getElementById('lf-latency-bars').innerHTML = buckets.map(function(b,i) {
      return '<div style="flex:1;background:' + colors[i] + ';height:' + Math.max(4, b/maxBucket*40) + 'px;border-radius:3px;opacity:0.85;position:relative" title="' + b + ' traces"><span style="position:absolute;top:-14px;left:50%;transform:translateX(-50%);font-size:0.6rem;color:var(--text-3)">' + b + '</span></div>';
    }).join('');

    // Timeline
    var timelineEl = document.getElementById('lf-timeline');
    if (traces.length === 0) {
      timelineEl.innerHTML = '<div style="color:var(--text-3);font-size:0.78rem;padding:0.5rem">No traces yet \\u2014 run an agent prompt to generate data</div>';
    } else {
      var maxDuration = Math.max.apply(null, durations.concat([1]));
      timelineEl.innerHTML = traces.slice(0, 12).map(function(t) {
        var lat = _traceLatency(t);
        var dur = lat > 0 ? (lat/1000).toFixed(1) + 's' : '-';
        var time = t.timestamp ? new Date(t.timestamp).toLocaleTimeString() : '-';
        var statusColor = t.status === 'ERROR' ? '#f43f5e' : '#10b981';
        var barWidth = lat > 0 ? Math.max(8, Math.min(100, lat / maxDuration * 100)) : 8;
        return '<div style="display:flex;align-items:center;gap:0.5rem;font-size:0.75rem">' +
          '<span style="width:6px;height:6px;border-radius:50%;background:' + statusColor + ';flex-shrink:0"></span>' +
          '<span style="width:60px;flex-shrink:0;color:var(--text-3);font-family:monospace;font-size:0.68rem">' + time + '</span>' +
          '<span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text-2)">' + escapeHtml(t.name||t.id?.slice(0,12)||'-') + '</span>' +
          '<div style="width:100px;height:8px;background:var(--glass-bg);border-radius:4px;overflow:hidden;flex-shrink:0"><div style="width:' + barWidth + '%;height:100%;background:' + (lat > 5000 ? '#f59e0b' : '#06b6d4') + ';border-radius:4px"></div></div>' +
          '<span style="width:40px;text-align:right;font-family:monospace;font-size:0.68rem;color:var(--text-3);flex-shrink:0">' + dur + '</span>' +
          '</div>';
      }).join('');
    }

    // Traces table
    if (traces.length === 0) {
      el.innerHTML = '<p style="color:var(--text-3)">' + (d.error || 'No traces found. Run an agent prompt to generate traces.') + '</p>';
      return;
    }
    el.innerHTML = '<table><tr><th>Trace ID</th><th>Name</th><th>Session</th><th>Input</th><th>Model</th><th>Tokens</th><th>Latency</th><th>Status</th><th></th></tr>' +
      traces.map(function(t) {
        var lat = _traceLatency(t);
        var latStr = lat > 0 ? (lat/1000).toFixed(2) + 's' : '-';
        var toks = _traceTokens(t);
        var tokStr = toks.total > 0 ? toks.total.toLocaleString() : '-';
        var model = _traceModel(t);
        var statusBadge = t.status === 'ERROR'
          ? '<span style="color:#f43f5e;font-size:0.72rem">\\u2716 Error</span>'
          : '<span style="color:#10b981;font-size:0.72rem">\\u2714 OK</span>';
        return '<tr>' +
        '<td class="mono" style="font-size:0.78rem">' + escapeHtml((t.id||'').slice(0,10)) + '</td>' +
        '<td>' + escapeHtml(t.name||'-') + '</td>' +
        '<td class="mono" style="font-size:0.78rem">' + escapeHtml((t.sessionId||'-').slice(0,12)) + '</td>' +
        '<td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + escapeHtml(t.input ? (typeof t.input==='string'?t.input:JSON.stringify(t.input)).slice(0,50) : '-') + '</td>' +
        '<td class="mono" style="font-size:0.72rem;color:var(--text-3)">' + escapeHtml(model || '-') + '</td>' +
        '<td class="mono" style="font-size:0.78rem;color:' + (toks.total > 0 ? '#8b5cf6' : 'var(--text-3)') + '">' + tokStr + '</td>' +
        '<td class="mono" style="font-size:0.78rem;color:' + (lat > 5000 ? '#f59e0b' : lat > 0 ? '#10b981' : 'var(--text-3)') + '">' + latStr + '</td>' +
        '<td>' + statusBadge + '</td>' +
        '<td><button class="btn btn-secondary btn-sm" onclick="viewTrace(\\'' + escapeHtml(t.id) + '\\')">Detail</button></td>' +
        '</tr>';
      }).join('') + '</table>';
  }).catch(function(e){
    document.getElementById('traces-table').innerHTML = '<p style="color:var(--danger)">Failed to load traces</p>';
  });
}

function viewTrace(traceId) {
  showDetailModal('Loading Trace...', '<p style="color:var(--text-3)">Fetching trace detail...</p>');

  fetch('/api/traces/' + traceId).then(function(r){return r.json()}).then(function(d){
    var t = d.trace || d;
    var lat = _traceLatency(t);
    var toks = _traceTokens(t);
    var model = _traceModel(t);

    // Header info grid
    var html = '<div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.25rem">';

    // Left column: trace info
    html += '<div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:1rem">';
    html += '<div style="font-size:0.72rem;font-weight:600;color:var(--text-3);text-transform:uppercase;margin-bottom:0.75rem">Trace Info</div>';
    html += '<div style="display:flex;flex-direction:column;gap:0.4rem">';
    html += '<div style="display:flex;justify-content:space-between"><span style="color:var(--text-3);font-size:0.78rem">Trace ID</span><span class="mono" style="font-size:0.75rem">' + escapeHtml((t.id||'-').slice(0,16)) + '</span></div>';
    html += '<div style="display:flex;justify-content:space-between"><span style="color:var(--text-3);font-size:0.78rem">Session</span><span class="mono" style="font-size:0.75rem">' + escapeHtml(t.sessionId||'-') + '</span></div>';
    html += '<div style="display:flex;justify-content:space-between"><span style="color:var(--text-3);font-size:0.78rem">Timestamp</span><span style="font-size:0.78rem">' + (t.timestamp ? new Date(t.timestamp).toLocaleString() : '-') + '</span></div>';
    html += '<div style="display:flex;justify-content:space-between"><span style="color:var(--text-3);font-size:0.78rem">Status</span><span style="color:' + (t.status==='ERROR' ? '#f43f5e' : '#10b981') + ';font-weight:600;font-size:0.78rem">' + (t.status==='ERROR' ? '\\u2716 Error' : '\\u2714 Success') + '</span></div>';
    html += '</div></div>';

    // Right column: performance
    html += '<div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:1rem">';
    html += '<div style="font-size:0.72rem;font-weight:600;color:var(--text-3);text-transform:uppercase;margin-bottom:0.75rem">Performance</div>';
    html += '<div style="display:flex;flex-direction:column;gap:0.4rem">';
    html += '<div style="display:flex;justify-content:space-between"><span style="color:var(--text-3);font-size:0.78rem">Latency</span><span style="font-weight:600;font-size:0.82rem;color:' + (lat > 5000 ? '#f59e0b' : '#10b981') + '">' + (lat > 0 ? (lat/1000).toFixed(2) + 's' : '-') + '</span></div>';
    if (model) html += '<div style="display:flex;justify-content:space-between"><span style="color:var(--text-3);font-size:0.78rem">Model</span><span class="mono" style="font-size:0.75rem">' + escapeHtml(model) + '</span></div>';
    html += '<div style="display:flex;justify-content:space-between"><span style="color:var(--text-3);font-size:0.78rem">Tokens In</span><span class="mono" style="font-size:0.78rem;color:#8b5cf6">' + (toks.input > 0 ? toks.input.toLocaleString() : '-') + '</span></div>';
    html += '<div style="display:flex;justify-content:space-between"><span style="color:var(--text-3);font-size:0.78rem">Tokens Out</span><span class="mono" style="font-size:0.78rem;color:#06b6d4">' + (toks.output > 0 ? toks.output.toLocaleString() : '-') + '</span></div>';
    html += '<div style="display:flex;justify-content:space-between"><span style="color:var(--text-3);font-size:0.78rem">Total Tokens</span><span class="mono" style="font-size:0.78rem;font-weight:600">' + (toks.total > 0 ? toks.total.toLocaleString() : '-') + '</span></div>';
    html += '</div></div>';
    html += '</div>';

    // Input / Output cards
    html += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.25rem">';
    html += '<div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:1rem">';
    html += '<div style="font-size:0.72rem;font-weight:600;color:var(--text-3);text-transform:uppercase;margin-bottom:0.5rem">\\u{1F4E5} Input</div>';
    html += '<div style="white-space:pre-wrap;font-size:0.82rem;color:var(--text-1);max-height:150px;overflow-y:auto;word-break:break-word">' + escapeHtml(t.input ? (typeof t.input==='string'?t.input:JSON.stringify(t.input,null,2)).slice(0,600) : '-') + '</div>';
    html += '</div>';
    html += '<div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:1rem">';
    html += '<div style="font-size:0.72rem;font-weight:600;color:var(--text-3);text-transform:uppercase;margin-bottom:0.5rem">\\u{1F4E4} Output</div>';
    html += '<div style="white-space:pre-wrap;font-size:0.82rem;color:var(--text-1);max-height:200px;overflow-y:auto;word-break:break-word">' + escapeHtml(t.output ? (typeof t.output==='string'?t.output:JSON.stringify(t.output,null,2)).slice(0,1200) : '-') + '</div>';
    html += '</div>';
    html += '</div>';

    // Observations / Steps timeline
    var obs = d.observations || [];
    if (obs.length > 0) {
      html += '<div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:1rem">';
      html += '<div style="font-size:0.72rem;font-weight:600;color:var(--text-3);text-transform:uppercase;margin-bottom:0.75rem">\\u{1F4CB} Steps (' + obs.length + ')</div>';
      html += '<div style="display:flex;flex-direction:column;gap:0.5rem">';
      obs.forEach(function(o) {
        var isGen = o.type === 'GENERATION';
        var isTool = (o.name||'').toLowerCase().includes('tool');
        var icon = isGen ? '\\u{1F9E0}' : isTool ? '\\u{1F527}' : '\\u{1F4CD}';
        var color = isGen ? '#8b5cf6' : isTool ? '#f59e0b' : '#06b6d4';
        var dur = o.endTime && o.startTime ? ((new Date(o.endTime) - new Date(o.startTime))/1000).toFixed(2) + 's' : '';
        var oUsage = o.usage || {};
        var oTokens = (oUsage.totalTokens || oUsage.total || 0);

        html += '<div style="display:flex;align-items:center;gap:0.75rem;padding:0.6rem 0.75rem;background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.04);border-radius:10px;border-left:3px solid ' + color + '">';
        html += '<span style="font-size:1rem">' + icon + '</span>';
        html += '<div style="flex:1;min-width:0">';
        html += '<div style="display:flex;justify-content:space-between;align-items:center">';
        html += '<strong style="font-size:0.82rem;color:var(--text-1)">' + escapeHtml(o.name||o.type||'-') + '</strong>';
        html += '<div style="display:flex;gap:0.5rem;align-items:center">';
        if (oTokens > 0) html += '<span class="badge" style="font-size:0.65rem;background:rgba(139,92,246,0.12);color:#8b5cf6">' + oTokens + ' tokens</span>';
        if (dur) html += '<span class="badge" style="font-size:0.65rem;background:rgba(6,182,212,0.12);color:#06b6d4">' + dur + '</span>';
        html += '<span class="badge" style="font-size:0.65rem;background:rgba(255,255,255,0.06);color:var(--text-3)">' + o.type + '</span>';
        html += '</div></div>';
        if (o.input) {
          var inputStr = typeof o.input==='string' ? o.input : JSON.stringify(o.input);
          if (inputStr.length > 120) inputStr = inputStr.slice(0,120) + '...';
          html += '<div style="margin-top:0.25rem;font-size:0.72rem;color:var(--text-3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">In: ' + escapeHtml(inputStr) + '</div>';
        }
        if (o.output) {
          var outStr = typeof o.output==='string' ? o.output : JSON.stringify(o.output);
          if (outStr.length > 200) outStr = outStr.slice(0,200) + '...';
          html += '<div style="margin-top:0.15rem;font-size:0.72rem;color:var(--text-2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Out: ' + escapeHtml(outStr) + '</div>';
        }
        html += '</div></div>';
      });
      html += '</div></div>';
    } else {
      html += '<div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:1rem;text-align:center">';
      html += '<div style="color:var(--text-3);font-size:0.82rem">No observations recorded for this trace</div>';
      html += '<div style="color:var(--text-3);font-size:0.72rem;margin-top:0.25rem">Older traces may not have step-level detail</div>';
      html += '</div>';
    }

    showDetailModal('\\u{1F50D} Trace: ' + escapeHtml(t.input ? (typeof t.input==='string'?t.input:t.input).toString().slice(0,40) : (t.name||t.id||'-').slice(0,40)), html);
  }).catch(function(e) {
    showDetailModal('Trace Error', '<p style="color:#ef4444">Failed to load trace detail: ' + escapeHtml(e.message) + '</p>');
  });
}

loadTraces();
</script>
