<%- include('layout', { title: 'Observability', page: 'observability', body: `

<h1 class="text-glow-cyan">Observability</h1>

<!-- ── Stats Row ── -->
<div class="stats-row" id="obs-stats" style="margin-bottom:1.5rem">
  <div class="stat-card"><div class="stat-value" id="stat-healthy">-</div><div class="stat-label">Healthy</div></div>
  <div class="stat-card"><div class="stat-value" id="stat-unhealthy">-</div><div class="stat-label">Unhealthy</div></div>
  <div class="stat-card"><div class="stat-value" id="stat-targets">-</div><div class="stat-label">Scrape Targets</div></div>
  <div class="stat-card"><div class="stat-value" id="stat-active-series">-</div><div class="stat-label">Active Series</div></div>
</div>

<!-- ── Observability Stack Status ── -->
<div class="card animate-fade-up" style="margin-bottom:1.5rem">
  <div class="section-header mb-1">
    <h3>Stack Health</h3>
    <button class="btn btn-sm" onclick="refreshHealth()" id="btn-refresh">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
      Refresh
    </button>
  </div>
  <div id="stack-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-top:0.75rem">
    <div class="stat-card" style="text-align:left">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:0.5rem">
        <span class="pulse-dot" id="dot-prometheus" style="background:#555"></span>
        <strong style="font-size:0.9rem">Prometheus</strong>
      </div>
      <div style="color:var(--text-3);font-size:0.78rem">Metrics collection & storage</div>
      <div class="mono" style="font-size:0.72rem;margin-top:0.3rem;color:var(--text-3)">:9090</div>
      <div id="status-prometheus" style="margin-top:0.4rem;font-size:0.72rem;color:var(--text-3)">Checking...</div>
    </div>
    <div class="stat-card" style="text-align:left">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:0.5rem">
        <span class="pulse-dot" id="dot-grafana" style="background:#555"></span>
        <strong style="font-size:0.9rem">Grafana</strong>
      </div>
      <div style="color:var(--text-3);font-size:0.78rem">Dashboards & visualization</div>
      <div class="mono" style="font-size:0.72rem;margin-top:0.3rem;color:var(--text-3)">:3013</div>
      <div id="status-grafana" style="margin-top:0.4rem;font-size:0.72rem;color:var(--text-3)">Checking...</div>
    </div>
    <div class="stat-card" style="text-align:left">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:0.5rem">
        <span class="pulse-dot" id="dot-loki" style="background:#555"></span>
        <strong style="font-size:0.9rem">Loki</strong>
      </div>
      <div style="color:var(--text-3);font-size:0.78rem">Log aggregation</div>
      <div class="mono" style="font-size:0.72rem;margin-top:0.3rem;color:var(--text-3)">:3100</div>
      <div id="status-loki" style="margin-top:0.4rem;font-size:0.72rem;color:var(--text-3)">Checking...</div>
    </div>
    <div class="stat-card" style="text-align:left">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:0.5rem">
        <span class="pulse-dot" id="dot-otel-collector" style="background:#555"></span>
        <strong style="font-size:0.9rem">OTel Collector</strong>
      </div>
      <div style="color:var(--text-3);font-size:0.78rem">Trace & metric pipeline</div>
      <div class="mono" style="font-size:0.72rem;margin-top:0.3rem;color:var(--text-3)">:4317 / :4318</div>
      <div id="status-otel-collector" style="margin-top:0.4rem;font-size:0.72rem;color:var(--text-3)">Checking...</div>
    </div>
  </div>
</div>

<!-- ── Prometheus Scrape Targets ── -->
<div class="card animate-fade-up delay-100" style="margin-bottom:1.5rem">
  <h3>Prometheus Scrape Targets</h3>
  <div id="targets-container" style="margin-top:0.75rem">
    <div style="color:var(--text-3);font-size:0.82rem">Loading targets...</div>
  </div>
</div>

<!-- ── Grafana Dashboard ── -->
<div class="card animate-fade-up delay-200" style="margin-bottom:1.5rem">
  <div class="section-header mb-1">
    <h3>Grafana — Platform Health</h3>
    <a href="${urls.grafana}" target="_blank" class="btn btn-primary btn-sm">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      Open Grafana
    </a>
  </div>
  <iframe id="grafana-iframe" src="${urls.grafana}/d/agentic-platform-health?orgId=1&kiosk" width="100%" height="600" style="background:var(--surface-1);border-radius:12px;border:1px solid var(--glass-border)" loading="lazy"></iframe>
</div>

<!-- ── Pipeline Diagram ── -->
<div class="card animate-fade-up delay-300">
  <h3>Telemetry Pipeline</h3>
  <div style="margin-top:0.75rem;padding:1.25rem;border-radius:12px;background:var(--input-bg);border:1px solid var(--glass-border);font-family:monospace;font-size:0.78rem;line-height:2;color:var(--text-2)">
    <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap">
      <span style="background:rgba(139,92,246,0.15);padding:4px 10px;border-radius:8px;color:#8b5cf6;font-weight:600">agent-service</span>
      <span style="color:var(--text-3)">→</span>
      <span style="background:rgba(6,182,212,0.15);padding:4px 10px;border-radius:8px;color:#06b6d4;font-weight:600">OTel Collector</span>
      <span style="color:var(--text-3)">→</span>
      <span style="display:flex;flex-direction:column;gap:4px">
        <span style="background:rgba(245,158,11,0.15);padding:4px 10px;border-radius:8px;color:#f59e0b;font-weight:600">Prometheus (metrics)</span>
        <span style="background:rgba(16,185,129,0.15);padding:4px 10px;border-radius:8px;color:#10b981;font-weight:600">Loki (logs)</span>
      </span>
      <span style="color:var(--text-3)">→</span>
      <span style="background:rgba(244,63,94,0.15);padding:4px 10px;border-radius:8px;color:#f43f5e;font-weight:600">Grafana</span>
    </div>
    <div style="margin-top:0.75rem;display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap">
      <span style="background:rgba(139,92,246,0.15);padding:4px 10px;border-radius:8px;color:#8b5cf6;font-weight:600">agent-service</span>
      <span style="color:var(--text-3)">→</span>
      <span style="background:rgba(6,182,212,0.15);padding:4px 10px;border-radius:8px;color:#06b6d4;font-weight:600">Langfuse SDK</span>
      <span style="color:var(--text-3)">→</span>
      <span style="background:rgba(244,63,94,0.15);padding:4px 10px;border-radius:8px;color:#f43f5e;font-weight:600">Langfuse (LLM traces)</span>
    </div>
  </div>
</div>

<script>
(function(){
  async function refreshHealth() {
    try {
      const resp = await fetch('/api/observability/health');
      const data = await resp.json();
      let healthy = 0, unhealthy = 0;
      (data.services || []).forEach(svc => {
        const dot = document.getElementById('dot-' + svc.name);
        const status = document.getElementById('status-' + svc.name);
        if (svc.status === 'healthy') {
          healthy++;
          if (dot) { dot.style.background = '#10b981'; dot.className = 'pulse-dot pulse-dot-emerald'; }
          if (status) status.innerHTML = '<span style="color:#10b981">Connected</span>';
        } else {
          unhealthy++;
          if (dot) { dot.style.background = '#ef4444'; dot.className = 'pulse-dot'; }
          if (status) status.innerHTML = '<span style="color:#ef4444">' + escapeHtml(svc.error || 'Unhealthy') + '</span>';
        }
      });
      document.getElementById('stat-healthy').textContent = healthy;
      document.getElementById('stat-unhealthy').textContent = unhealthy;
    } catch(e) {
      document.getElementById('stat-healthy').textContent = '?';
      document.getElementById('stat-unhealthy').textContent = '?';
    }
  }

  async function loadTargets() {
    try {
      const resp = await fetch('/api/observability/prometheus/targets');
      const data = await resp.json();
      const container = document.getElementById('targets-container');
      if (data.status === 'success' && data.data && data.data.activeTargets) {
        const targets = data.data.activeTargets;
        document.getElementById('stat-targets').textContent = targets.length;
        let html = '<table><tr><th>Job</th><th>Endpoint</th><th>State</th><th>Last Scrape</th></tr>';
        targets.forEach(t => {
          const stateColor = t.health === 'up' ? '#10b981' : '#ef4444';
          const lastScrape = t.lastScrape ? new Date(t.lastScrape).toLocaleTimeString() : '-';
          html += '<tr><td><strong>' + escapeHtml(t.labels.job) + '</strong></td>'
            + '<td class="mono" style="font-size:0.78rem;color:var(--text-3)">' + escapeHtml(t.scrapeUrl) + '</td>'
            + '<td><span style="display:inline-flex;align-items:center;gap:6px"><span style="width:8px;height:8px;border-radius:50%;background:' + stateColor + ';display:inline-block"></span> ' + escapeHtml(t.health) + '</span></td>'
            + '<td style="color:var(--text-3);font-size:0.78rem">' + lastScrape + '</td></tr>';
        });
        html += '</table>';
        container.innerHTML = html;
      } else {
        container.innerHTML = '<div style="color:var(--text-3);font-size:0.82rem">Could not fetch targets from Prometheus</div>';
        document.getElementById('stat-targets').textContent = '?';
      }
    } catch(e) {
      document.getElementById('targets-container').innerHTML = '<div style="color:#ef4444;font-size:0.82rem">Prometheus unreachable</div>';
      document.getElementById('stat-targets').textContent = '?';
    }
  }

  async function loadMetrics() {
    try {
      const resp = await fetch('/api/observability/prometheus/query?query=count({__name__!=""})');
      const data = await resp.json();
      if (data.status === 'success' && data.data && data.data.result && data.data.result[0]) {
        document.getElementById('stat-active-series').textContent = parseInt(data.data.result[0].value[1]).toLocaleString();
      } else {
        document.getElementById('stat-active-series').textContent = '-';
      }
    } catch(e) {
      document.getElementById('stat-active-series').textContent = '?';
    }
  }

  window.refreshHealth = refreshHealth;
  refreshHealth();
  loadTargets();
  loadMetrics();
  setInterval(refreshHealth, 30000);
})();
</script>
` }) %>
