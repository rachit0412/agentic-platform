      '<div><span style="font-size:0.72rem;color:var(--text-3);text-transform:uppercase">Path</span><br><code style="color:var(--accent-text);font-size:0.78rem">' + escapeHtml(d.db_path||'unknown') + '</code></div>' +
      '<div><span style="font-size:0.72rem;color:var(--text-3);text-transform:uppercase">Size</span><br><span class="mono" style="font-size:0.95rem;font-weight:600">' + sizeMB + ' MB</span></div>' +
      '<div><span style="font-size:0.72rem;color:var(--text-3);text-transform:uppercase">Total Records</span><br><span class="mono" style="font-size:0.95rem;font-weight:600">' + totalRecords.toLocaleString() + '</span></div>' +
    '</div>' +
      '<table><tr><th>Table</th><th>Records</th><th>% of Total</th></tr>' +
