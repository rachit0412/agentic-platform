  document.getElementById('persona-name').focus();
}

function toggleAllChecks(className, checked) {
  document.querySelectorAll('.' + className).forEach(function(cb) { cb.checked = checked; });
}

async function savePersona(personaId) {
  var errEl = document.getElementById('persona-modal-error');
  var name = document.getElementById('persona-name').value.trim();
  var description = document.getElementById('persona-description').value.trim();
  if (!name) { errEl.style.display = 'block'; errEl.textContent = 'Name is required'; return; }
  var nav = []; document.querySelectorAll('.persona-nav-check:checked').forEach(function(cb) { nav.push(cb.value); });
  var actions = []; document.querySelectorAll('.persona-action-check:checked').forEach(function(cb) { actions.push(cb.value); });
  var body = { name: name, description: description, permissions: { nav: nav, actions: actions } };
  var url = personaId ? '/api/personas/' + personaId : '/api/personas';
  var method = personaId ? 'PUT' : 'POST';
  try {
    var r = await fetch(url, { method: method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    if (!r.ok) { var d = await r.json(); errEl.style.display = 'block'; errEl.textContent = d.error || 'Failed to save persona'; return; }
    var el = document.getElementById('persona-modal-overlay');
    if (el) el.remove();
    showToast(personaId ? 'Persona updated' : 'Persona created', 'success');
    loadPersonas();
  } catch(e) { errEl.style.display = 'block'; errEl.textContent = 'Error: ' + e.message; }
}

async function deletePersona(personaId, name) {
  if (!confirm('Delete persona "' + name + '"? Users with this persona will lose it.')) return;
  try {
    var r = await fetch('/api/personas/' + personaId, { method: 'DELETE' });
    if (!r.ok) { var d = await r.json(); showToast(d.error || 'Cannot delete persona', 'error'); return; }
    showToast('Persona "' + name + '" deleted', 'success');
    loadPersonas();
    loadUserPersonaAssignments();
  } catch(e) { showToast('Error: ' + e.message, 'error'); }
}

/* ═══ USER PERSONA ASSIGNMENTS ═══ */
async function loadUserPersonaAssignments() {
  var container = document.getElementById('user-persona-assignments');
  try {
    var [ur, pr] = await Promise.all([fetch('/api/users'), fetch('/api/personas')]);
    var users = (await ur.json()).users || [];
    var personas = (await pr.json()).personas || [];
    if (!users.length) { container.innerHTML = '<p style="color:var(--text-3)">No users found.</p>'; return; }
    var html = '<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse">'
      + '<thead><tr style="border-bottom:2px solid var(--glass-border)">'
      + '<th style="text-align:left;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600">User</th>'
      + '<th style="text-align:left;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600">Assigned Personas</th>'
      + '<th style="text-align:right;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600">Actions</th>'
      + '</tr></thead><tbody>';
    users.forEach(function(u) {
      var userPersonas = u.personas || [];
      var chips = userPersonas.map(function(p) {
        return '<span style="display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:99px;font-size:0.68rem;font-weight:500;background:rgba(6,182,212,0.08);color:var(--accent-text);border:1px solid rgba(6,182,212,0.15)">'
          + escapeHtml(p.name)
          + '<button onclick="removePersonaFromUser(&#39;' + u.id + '&#39;,&#39;' + p.id + '&#39;)" style="border:none;background:none;cursor:pointer;color:var(--text-3);font-size:0.75rem;padding:0 2px;line-height:1" title="Remove">&times;</button>'
          + '</span>';
      }).join(' ');
      if (!chips) chips = '<span style="font-size:0.7rem;color:var(--text-3);opacity:0.5">None</span>';
      var options = personas.filter(function(p) {
        return !userPersonas.some(function(up) { return up.id === p.id; });
      }).map(function(p) {
        return '<option value="' + p.id + '">' + escapeHtml(p.name) + '</option>';
      }).join('');
      var addSelect = options ? '<select id="add-persona-' + u.id + '" class="input" style="font-size:0.72rem;padding:3px 8px;min-width:100px"><option value="">Add...</option>' + options + '</select>'
        + '<button class="btn btn-sm" onclick="addPersonaToUser(&#39;' + u.id + '&#39;)" style="font-size:0.62rem;padding:3px 6px">+</button>' : '';
      html += '<tr style="border-bottom:1px solid var(--glass-border)">'
        + '<td style="padding:10px 12px"><div style="font-weight:600;font-size:0.82rem;color:var(--text-1)">' + escapeHtml(u.display_name || u.username) + '</div><div style="font-size:0.68rem;color:var(--text-3)">@' + escapeHtml(u.username) + '</div></td>'
        + '<td style="padding:10px 12px"><div style="display:flex;flex-wrap:wrap;gap:4px;align-items:center">' + chips + '</div></td>'
        + '<td style="padding:10px 12px;text-align:right"><div style="display:flex;gap:4px;justify-content:flex-end;align-items:center">' + addSelect + '</div></td>'
        + '</tr>';
    });
    html += '</tbody></table></div>';
    container.innerHTML = html;
  } catch(e) { container.innerHTML = '<p style="color:var(--danger)">Failed to load: ' + escapeHtml(e.message) + '</p>'; }
}

async function addPersonaToUser(userId) {
  var sel = document.getElementById('add-persona-' + userId);
  if (!sel || !sel.value) return;
  try {
    var r = await fetch('/api/users/' + userId + '/personas', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ persona_id: sel.value })
    });
    if (!r.ok) { var d = await r.json(); showToast(d.error || 'Failed to assign', 'error'); return; }
    showToast('Persona assigned', 'success');
    loadUserPersonaAssignments();
  } catch(e) { showToast('Error: ' + e.message, 'error'); }
}

async function removePersonaFromUser(userId, personaId) {
  try {
    var r = await fetch('/api/users/' + userId + '/personas/' + personaId, { method: 'DELETE' });
    if (!r.ok) { showToast('Failed to remove persona', 'error'); return; }
    showToast('Persona removed', 'success');
    loadUserPersonaAssignments();
  } catch(e) { showToast('Error: ' + e.message, 'error'); }
}

