      if (typeof opts.headers.set === 'function') {
        if (!opts.headers.has('x-user-role')) opts.headers.set('x-user-role', window.__userRole || 'member');
      } else {
        if (!opts.headers['x-user-role']) opts.headers['x-user-role'] = window.__userRole || 'member';
