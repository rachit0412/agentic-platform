          '<div style="display:flex;align-items:center;gap:0.5rem">' +
            '<strong style="font-size:0.82rem;color:var(--text-1)">' + escapeHtml(s.name) + '</strong>' +
            typeBadge +
          '</div>' +
          '<div style="font-size:0.72rem;color:' + statusColor + ';font-weight:600;text-transform:uppercase;margin-top:0.15rem">' + s.status + '</div>' +
          (url ? '<div class="mono" style="font-size:0.65rem;color:var(--text-3);margin-top:0.1rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">' + escapeHtml(url) + '</div>' : '') +
        '</div>' +
        '<div style="text-align:right">' +
          '<div class="mono" style="font-size:0.72rem;color:var(--text-3)">' + s.latency + 'ms</div>' +
          (s.code ? '<div class="mono" style="font-size:0.68rem;color:var(--text-3)">HTTP ' + s.code + '</div>' : '') +
        '</div>' +
      '</div>';
    }).join('');
  } catch(e) {
    document.getElementById('service-health-grid').innerHTML = '<div style="color:var(--danger);grid-column:1/-1">Failed to load service health: ' + escapeHtml(e.message) + '</div>';
  }
