<%- include('layout', { title: 'Admin Plane', page: 'admin', body: `

<!-- ── Admin Content ── -->
<div id="admin-content">

<!-- Header -->
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem">
  <div>
    <h1 class="text-glow-cyan" style="margin-bottom:0.25rem">Admin Plane</h1>
    <p style="color:var(--text-3);font-size:0.82rem;margin:0">System health, user management, configuration, services &amp; audit controls</p>
  </div>
  <div style="display:flex;gap:0.5rem;align-items:center">
    <span id="admin-last-refresh" style="font-size:0.68rem;color:var(--text-3)"></span>
    <button class="btn btn-sm" onclick="adminLoadAll()" title="Refresh all" style="font-size:0.72rem">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
      Refresh
    </button>
  </div>
</div>

<!-- Two-level admin nav -->
<div class="admin-nav" id="admin-nav">
  <div class="admin-section-tabs" id="admin-section-tabs">
    <button class="admin-stab" data-section="operations">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      Operations
    </button>
    <button class="admin-stab" data-section="identity">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      Identity &amp; Access
    </button>
    <button class="admin-stab" data-section="ai">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"/></svg>
      AI Platform
    </button>
    <button class="admin-stab" data-section="data">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
      Data Platform
    </button>
    <button class="admin-stab" data-section="infrastructure">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="2" y1="17" x2="22" y2="17"/><line x1="6" y1="21" x2="6" y2="17"/><line x1="12" y1="21" x2="12" y2="17"/><line x1="18" y1="21" x2="18" y2="17"/></svg>
      Infrastructure
    </button>
    <button class="admin-stab" data-section="compliance">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
      Compliance & Ethics
    </button>
  </div>
  <div class="admin-subtab-row">
    <div class="admin-subtabs" id="subtabs-operations">
      <button class="admin-subtab" data-tab="health">Service Health</button>
      <button class="admin-subtab" data-tab="overview">Platform Overview</button>
      <button class="admin-subtab" data-tab="audit">Audit Log</button>
      <button class="admin-subtab" data-tab="api-reference">API Reference</button>
    </div>
    <div class="admin-subtabs" id="subtabs-identity" style="display:none">
      <button class="admin-subtab" data-tab="users">Users &amp; Access</button>
      <button class="admin-subtab" data-tab="personas">Personas</button>
    </div>
    <div class="admin-subtabs" id="subtabs-ai" style="display:none">
      <button class="admin-subtab" data-tab="llm">LLM &amp; Models</button>
      <button class="admin-subtab" data-tab="config">Configuration</button>
    </div>
    <div class="admin-subtabs" id="subtabs-data" style="display:none">
      <button class="admin-subtab" data-tab="database">Database &amp; Data</button>
    </div>
    <div class="admin-subtabs" id="subtabs-infrastructure" style="display:none">
      <button class="admin-subtab" data-tab="docker-images">Docker Images</button>
      <button class="admin-subtab" data-tab="environment-vars">Environment Variables</button>
    </div>
    <div class="admin-subtabs" id="subtabs-compliance" style="display:none">
      <button class="admin-subtab" data-tab="compliance-rules">Rules & Policies</button>
      <button class="admin-subtab" data-tab="compliance-audit">Audit Log</button>
      <button class="admin-subtab" data-tab="secret-scan">Secret Scanning</button>
      <button class="admin-subtab" data-tab="owasp-scan">OWASP Assessment</button>
      <button class="admin-subtab" data-tab="clamav-scan">Antivirus Scan</button>
    </div>
    <div class="admin-subtabs" id="subtabs-config" style="display:none">
      <button class="admin-subtab" data-tab="config-appearance">Appearance</button>
      <button class="admin-subtab" data-tab="config-access">Access Control</button>
      <button class="admin-subtab" data-tab="config-system">System Config</button>
      <button class="admin-subtab" data-tab="config-extensions">Guardrails &amp; Workflows</button>
      <button class="admin-subtab" data-tab="config-links">External Links</button>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════ -->
<!-- TAB: USERS & ACCESS                                    -->
<!-- ═══════════════════════════════════════════════════════ -->
<div id="tab-users" class="admin-tab-content" style="display:none">

  <!-- User Stats Summary -->
  <div id="user-stats-bar" style="display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-bottom:1.5rem">
    <div class="card" style="text-align:center;padding:1rem;cursor:pointer;transition:all 0.18s" onclick="filterUsers('all')" title="Show all users">
      <div style="font-size:1.8rem;font-weight:700;color:var(--text-1)" id="user-count-total">—</div>
      <div style="font-size:0.7rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em">Total Users</div>
    </div>
    <div class="card" style="text-align:center;padding:1rem;cursor:pointer;transition:all 0.18s" onclick="filterUsers('active')" title="Show active users">
      <div style="font-size:1.8rem;font-weight:700;color:var(--success)" id="user-count-active">—</div>
      <div style="font-size:0.7rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em">Active</div>
    </div>
    <div class="card" style="text-align:center;padding:1rem;cursor:pointer;transition:all 0.18s" onclick="filterUsers('verified')" title="Show verified users">
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent-text)" id="user-count-verified">—</div>
      <div style="font-size:0.7rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em">Verified</div>
    </div>
    <div class="card" style="text-align:center;padding:1rem;cursor:pointer;transition:all 0.18s" onclick="filterUsers('admin')" title="Show admin users">
      <div style="font-size:1.8rem;font-weight:700;color:var(--danger)" id="user-count-admins">—</div>
      <div style="font-size:0.7rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em">Admins</div>
    </div>
  </div>

  <!-- User Management -->
  <div class="card animate-fade-up" style="margin-bottom:1.5rem">
    <div class="section-header">
      <h3>User Management</h3>
      <div style="display:flex;gap:0.5rem">
        <button class="btn btn-secondary btn-sm" onclick="loadUsers()">
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15A9 9 0 1 1 21 12"/></svg>
          Refresh
        </button>
        <button class="btn btn-primary btn-sm" onclick="showCreateUserModal()">
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Add User
        </button>
      </div>
    </div>
    <div id="users-table-container" style="margin-top:0.75rem">
      <div style="color:var(--text-3);font-size:0.82rem">Loading users...</div>
    </div>
  </div>

  <!-- Workspace Management -->
  <div class="card animate-fade-up">
    <div class="section-header">
      <h3>Workspace Management</h3>
      <button class="btn btn-primary btn-sm" onclick="showCreateWorkspaceModal()">
        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        New Workspace
      </button>
    </div>
    <div id="workspaces-admin-table" style="margin-top:0.75rem">
      <div style="color:var(--text-3);font-size:0.82rem">Loading workspaces...</div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════ -->
<!-- TAB: PERSONAS                                          -->
<!-- ═══════════════════════════════════════════════════════ -->
<div id="tab-personas" class="admin-tab-content" style="display:none">

  <!-- Persona Cards -->
  <div class="card animate-fade-up" style="margin-bottom:1.5rem">
    <div class="section-header">
      <h3>Persona Definitions</h3>
      <div style="display:flex;gap:0.5rem">
        <button class="btn btn-secondary btn-sm" onclick="loadPersonas()">
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15A9 9 0 1 1 21 12"/></svg>
          Refresh
        </button>
        <button class="btn btn-primary btn-sm" onclick="showCreatePersonaModal()">
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Create Persona
        </button>
      </div>
    </div>
    <p style="font-size:0.75rem;color:var(--text-3);margin:0.25rem 0 1rem">Define access profiles that control which navigation items and platform capabilities are available. Assign personas to users to enable role-switching.</p>
    <div id="personas-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1rem">
      <div style="color:var(--text-3);font-size:0.82rem">Loading personas...</div>
    </div>
  </div>

  <!-- User Persona Assignments -->
  <div class="card animate-fade-up">
    <div class="section-header">
      <h3>User Persona Assignments</h3>
    </div>
    <p style="font-size:0.75rem;color:var(--text-3);margin:0.25rem 0 1rem">Assign one or more personas to each user. Users can switch between their assigned personas at any time.</p>
    <div id="user-persona-assignments">
      <div style="color:var(--text-3);font-size:0.82rem">Loading...</div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════ -->
<!-- TAB 1: SERVICE HEALTH                                  -->
<!-- ═══════════════════════════════════════════════════════ -->
<div id="tab-health" class="admin-tab-content">

  <!-- Health Summary Bar -->
  <div id="health-summary" style="display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-bottom:1.5rem">
    <div class="card" style="text-align:center;padding:1rem">
      <div style="font-size:2rem;font-weight:700;color:var(--success)" id="health-count-healthy">—</div>
      <div style="font-size:0.72rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em">Healthy</div>
    </div>
    <div class="card" style="text-align:center;padding:1rem">
      <div style="font-size:2rem;font-weight:700;color:var(--danger)" id="health-count-unhealthy">—</div>
      <div style="font-size:0.72rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em">Unhealthy</div>
    </div>
    <div class="card" style="text-align:center;padding:1rem">
      <div style="font-size:2rem;font-weight:700;color:var(--text-1)" id="health-count-total">—</div>
      <div style="font-size:0.72rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em">Total Services</div>
    </div>
    <div class="card" style="text-align:center;padding:1rem">
      <div style="font-size:1rem;font-weight:600;color:var(--accent-text)" id="health-timestamp">—</div>
      <div style="font-size:0.72rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em">Last Check</div>
    </div>
  </div>

  <!-- Service Health Grid -->
  <div class="card animate-fade-up" style="margin-bottom:1.5rem">
    <div class="section-header">
      <h3>All Services</h3>
      <div>
        <button class="btn btn-secondary btn-sm" onclick="loadServiceHealth()">
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15A9 9 0 1 1 21 12"/></svg>
          Check Now
        </button>
      </div>
    </div>
    <div id="service-health-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:0.75rem;margin-top:0.75rem">
      <div style="color:var(--text-3);font-size:0.82rem;grid-column:1/-1">Loading service health...</div>
    </div>
  </div>

  <!-- Environment Info -->
  <div class="card animate-fade-up delay-100" style="margin-bottom:1.5rem">
    <h3>Environment &amp; Endpoints</h3>
    <table class="mt-1">
      <tr><th>Service</th><th>Internal URL</th><th>External URL</th></tr>
      <tr><td>Agent Service</td><td class="mono" style="font-size:0.75rem">http://agent-service:8000</td><td class="mono" style="color:var(--accent-text);font-size:0.75rem">${urls.agent}</td></tr>
      <tr><td>Tools Service</td><td class="mono" style="font-size:0.75rem">http://tools-service:8001</td><td class="mono" style="color:var(--accent-text);font-size:0.75rem">http://localhost:8011</td></tr>
      <tr><td>n8n</td><td class="mono" style="font-size:0.75rem">http://n8n:5678</td><td class="mono" style="color:var(--accent-text);font-size:0.75rem">${urls.n8n}</td></tr>
      <tr><td>Langfuse</td><td class="mono" style="font-size:0.75rem">http://langfuse:3000</td><td class="mono" style="color:var(--accent-text);font-size:0.75rem">${urls.langfuse}</td></tr>
      <tr><td>Grafana</td><td class="mono" style="font-size:0.75rem">http://grafana:3000</td><td class="mono" style="color:var(--accent-text);font-size:0.75rem">${urls.grafana}</td></tr>
      <tr><td>ChromaDB</td><td class="mono" style="font-size:0.75rem">http://chromadb:8000</td><td class="mono" style="color:var(--accent-text);font-size:0.75rem">http://localhost:8200</td></tr>
      <tr><td>Ollama</td><td class="mono" style="font-size:0.75rem">http://ollama:11434</td><td class="mono" style="color:var(--accent-text);font-size:0.75rem">http://localhost:11436</td></tr>
      <tr><td>Prometheus</td><td class="mono" style="font-size:0.75rem">http://prometheus:9090</td><td class="mono" style="color:var(--accent-text);font-size:0.75rem">http://localhost:9090</td></tr>
      <tr><td>Loki</td><td class="mono" style="font-size:0.75rem">http://loki:3100</td><td class="mono" style="color:var(--accent-text);font-size:0.75rem">http://localhost:3100</td></tr>
      <tr><td>OTel Collector</td><td class="mono" style="font-size:0.75rem">http://otel-collector:4318</td><td class="mono" style="color:var(--accent-text);font-size:0.75rem">http://localhost:4318</td></tr>
    </table>
  </div>

  <!-- Service Versions -->
  <div class="card animate-fade-up delay-200">
    <h3>Service Versions</h3>
    <table class="mt-1">
      <tr><th>Service</th><th>Version</th><th>Stack</th></tr>
      <tr><td>Agent Service</td><td class="mono" style="font-size:0.78rem">2.0.0</td><td style="font-size:0.75rem;color:var(--text-3)">FastAPI + LangGraph + LangChain + LlamaIndex</td></tr>
      <tr><td>Tools Service</td><td class="mono" style="font-size:0.78rem">2.0.0</td><td style="font-size:0.75rem;color:var(--text-3)">FastAPI + DuckDuckGo + Code Sandbox</td></tr>
      <tr><td>UI Console</td><td class="mono" style="font-size:0.78rem">2.0.0</td><td style="font-size:0.75rem;color:var(--text-3)">Express.js + EJS + SSE</td></tr>
      <tr><td>ChromaDB</td><td class="mono" style="font-size:0.78rem">0.6.3</td><td style="font-size:0.75rem;color:var(--text-3)">Vector Store</td></tr>
      <tr><td>PostgreSQL</td><td class="mono" style="font-size:0.78rem">16</td><td style="font-size:0.75rem;color:var(--text-3)">Document Registry (datastore-db)</td></tr>
      <tr><td>Ollama</td><td class="mono" style="font-size:0.78rem">latest</td><td style="font-size:0.75rem;color:var(--text-3)">Local LLM Runtime</td></tr>
      <tr><td>n8n</td><td class="mono" style="font-size:0.78rem">latest</td><td style="font-size:0.75rem;color:var(--text-3)">Workflow Orchestration</td></tr>
      <tr><td>Langfuse</td><td class="mono" style="font-size:0.78rem">2.x</td><td style="font-size:0.75rem;color:var(--text-3)">LLM Tracing &amp; Observability</td></tr>
      <tr><td>Grafana</td><td class="mono" style="font-size:0.78rem">11.0.0</td><td style="font-size:0.75rem;color:var(--text-3)">Metrics Dashboards</td></tr>
      <tr><td>Prometheus</td><td class="mono" style="font-size:0.78rem">latest</td><td style="font-size:0.75rem;color:var(--text-3)">Metrics Aggregation</td></tr>
      <tr><td>Loki</td><td class="mono" style="font-size:0.78rem">3.0.0</td><td style="font-size:0.75rem;color:var(--text-3)">Log Aggregation</td></tr>
      <tr><td>OTel Collector</td><td class="mono" style="font-size:0.78rem">0.100.0</td><td style="font-size:0.75rem;color:var(--text-3)">Telemetry Pipeline</td></tr>
    </table>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════ -->
<!-- TAB 2: PLATFORM OVERVIEW                               -->
<!-- ═══════════════════════════════════════════════════════ -->
<div id="tab-overview" class="admin-tab-content" style="display:none">

  <!-- Resource Counts Grid -->
  <div id="overview-counts" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:0.75rem;margin-bottom:1.5rem"></div>

  <!-- Feature Toggles -->
  <div class="card animate-fade-up" style="margin-bottom:1.5rem">
    <h3>Platform Capabilities</h3>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;margin-top:0.75rem" id="feature-grid">
      <div style="display:flex;align-items:center;gap:0.5rem;padding:0.5rem 0.75rem;background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:8px">
        <span style="width:8px;height:8px;border-radius:50%;background:var(--success);flex-shrink:0"></span>
        <span style="font-size:0.78rem">LangChain + LangGraph</span>
      </div>
      <div style="display:flex;align-items:center;gap:0.5rem;padding:0.5rem 0.75rem;background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:8px">
        <span style="width:8px;height:8px;border-radius:50%;background:var(--success);flex-shrink:0"></span>
        <span style="font-size:0.78rem">LlamaIndex (Advanced RAG)</span>
      </div>
      <div style="display:flex;align-items:center;gap:0.5rem;padding:0.5rem 0.75rem;background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:8px">
        <span style="width:8px;height:8px;border-radius:50%;background:var(--success);flex-shrink:0"></span>
        <span style="font-size:0.78rem">Vector Memory (ChromaDB)</span>
      </div>
      <div style="display:flex;align-items:center;gap:0.5rem;padding:0.5rem 0.75rem;background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:8px">
        <span style="width:8px;height:8px;border-radius:50%;background:var(--success);flex-shrink:0"></span>
        <span style="font-size:0.78rem">RAG Pipeline (5 modes)</span>
      </div>
      <div style="display:flex;align-items:center;gap:0.5rem;padding:0.5rem 0.75rem;background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:8px">
        <span style="width:8px;height:8px;border-radius:50%;background:var(--success);flex-shrink:0"></span>
        <span style="font-size:0.78rem">Multi-Provider LLM</span>
      </div>
      <div style="display:flex;align-items:center;gap:0.5rem;padding:0.5rem 0.75rem;background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:8px">
        <span style="width:8px;height:8px;border-radius:50%;background:var(--success);flex-shrink:0"></span>
        <span style="font-size:0.78rem">Web Search (DuckDuckGo)</span>
      </div>
      <div style="display:flex;align-items:center;gap:0.5rem;padding:0.5rem 0.75rem;background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:8px">
        <span style="width:8px;height:8px;border-radius:50%;background:var(--success);flex-shrink:0"></span>
        <span style="font-size:0.78rem">Code Execution (Sandbox)</span>
      </div>
      <div style="display:flex;align-items:center;gap:0.5rem;padding:0.5rem 0.75rem;background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:8px">
        <span style="width:8px;height:8px;border-radius:50%;background:var(--success);flex-shrink:0"></span>
