/* ═══ GLOBAL CONSTRAINTS ═══ */
async function loadGlobalConstraints() {
  try {
    var r = await fetch('/api/admin/global-constraints');
    var d = await r.json();
    document.getElementById('global-constraints-editor').value = JSON.stringify(d, null, 2);
  } catch(e) {
    document.getElementById('global-constraints-editor').value = '{}';
  }
}

async function saveGlobalConstraints() {
  try {
    var text = document.getElementById('global-constraints-editor').value;
    var data = JSON.parse(text);
    var r = await fetch('/api/admin/global-constraints', { method: 'PUT', headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) });
    if (r.ok) { showToast('Global constraints saved', 'success'); }
    else { showToast('Failed to save constraints', 'error'); }
  } catch(e) { showToast('Invalid JSON: ' + e.message, 'error'); }
}

/* ═══ GUARDRAILS ═══ */
async function loadGuardrails() {
  try {
    var r = await fetch('/api/guardrails');
    var d = await r.json();
    var el = document.getElementById('guardrails-list');
    var items = Array.isArray(d) ? d : (d.guardrails || []);
    if (items.length === 0) {
      el.innerHTML = '<p style="color:var(--text-3)">No guardrails configured. Create them from the <a href="/guardrails" style="color:var(--accent-text)">Guardrails</a> page.</p>';
      return;
    }
    el.innerHTML = '<table><tr><th>Name</th><th>Status</th><th>Checks</th></tr>' +
      items.map(function(g) {
        var status = g.enabled !== false ? '<span class="badge badge-success">Active</span>' : '<span class="badge" style="font-size:0.68rem">Disabled</span>';
        var checks = '';
        if (g.checks_config) {
          try {
            var cfg = typeof g.checks_config === 'string' ? JSON.parse(g.checks_config) : g.checks_config;
            checks = Object.keys(cfg).filter(function(k) { return cfg[k]; }).join(', ');
          } catch(e2) { checks = 'custom'; }
        }
        return '<tr><td>' + escapeHtml(g.name || g.id) + '</td><td>' + status + '</td><td style="font-size:0.75rem;color:var(--text-3)">' + escapeHtml(checks) + '</td></tr>';
      }).join('') + '</table>';
  } catch(e) { document.getElementById('guardrails-list').innerHTML = '<p style="color:var(--text-3)">Guardrails unavailable</p>'; }
}

/* ═══ N8N WORKFLOWS ═══ */
async function loadN8nWorkflows() {
  try {
    var r = await fetch('/api/admin/n8n/workflows');
    var d = await r.json();
    var el = document.getElementById('n8n-workflows');
    var items = d.data || [];
    if (items.length === 0) {
      el.innerHTML = '<p style="color:var(--text-3)">No n8n workflows found. ' + (d.error ? 'Error: ' + escapeHtml(d.error) : 'Create workflows from the <a href="/workflows" style="color:var(--accent-text)">Workflows</a> page.') + '</p>';
      return;
    }
    el.innerHTML = '<table><tr><th>Name</th><th>Status</th><th>Created</th></tr>' +
      items.map(function(w) {
        var status = w.active ? '<span class="badge badge-success">Active</span>' : '<span class="badge" style="font-size:0.68rem">Inactive</span>';
        var created = w.createdAt ? new Date(w.createdAt).toLocaleDateString() : String.fromCharCode(0x2014);
        return '<tr><td>' + escapeHtml(w.name || w.id) + '</td><td>' + status + '</td><td class="mono" style="font-size:0.75rem">' + created + '</td></tr>';
      }).join('') + '</table>';
  } catch(e) { document.getElementById('n8n-workflows').innerHTML = '<p style="color:var(--text-3)">n8n unavailable</p>'; }
}

/* ═══ AUDIT LOG ═══ */
async function loadAuditLog() {
  try {
    var typeFilter = document.getElementById('audit-filter-type').value;
    var actionFilter = document.getElementById('audit-filter-action').value;
    var params = new URLSearchParams({limit: '100'});
    if (typeFilter) params.set('entity_type', typeFilter);
    if (actionFilter) params.set('action', actionFilter);
    var r = await fetch('/api/audit-log?' + params.toString());
    var d = await r.json();
    var el = document.getElementById('audit-log');
    if (!d.entries || d.entries.length === 0) {
      el.innerHTML = '<p style="color:var(--text-3)">No audit log entries yet. Changes to agents, skills, prompts, and other entities will appear here.</p>';
      return;
    }
    var actionColors = {create:'var(--success)',update:'var(--info)',delete:'var(--danger)',rollback:'var(--warning)'};
    el.innerHTML = '<table><tr><th>Time</th><th>Action</th><th>Type</th><th>Name</th><th>Details</th></tr>' +
      d.entries.map(function(e) {
        var time = new Date(e.created_at).toLocaleString();
        var color = actionColors[e.action] || 'var(--text-3)';
        var details = e.details && Object.keys(e.details).length > 0 ? escapeHtml(JSON.stringify(e.details)).substring(0, 120) : '';
        return '<tr><td class="mono" style="font-size:0.72rem;white-space:nowrap">' + time + '</td>' +
          '<td><span style="color:' + color + ';font-weight:600;text-transform:uppercase;font-size:0.72rem">' + escapeHtml(e.action) + '</span></td>' +
          '<td style="font-size:0.78rem">' + escapeHtml(e.entity_type) + '</td>' +
          '<td style="font-size:0.78rem">' + escapeHtml(e.entity_name || e.entity_id) + '</td>' +
          '<td class="mono" style="font-size:0.72rem;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="' + details + '">' + details + '</td></tr>';
      }).join('') + '</table>';
  } catch(e) { document.getElementById('audit-log').innerHTML = '<p style="color:var(--danger)">Failed to load audit log</p>'; }
}

document.getElementById('audit-filter-type').addEventListener('change', loadAuditLog);
document.getElementById('audit-filter-action').addEventListener('change', loadAuditLog);

