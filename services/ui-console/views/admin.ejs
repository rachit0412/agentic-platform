      html += '</div>';
    }
    html += '</div>';
    if (d.by_model && d.by_model.length > 0) {
      html += '<h4 style="margin-top:1rem;margin-bottom:0.5rem;font-size:0.85rem">By Model</h4><table><tr><th>Model</th><th>Provider</th><th>Calls</th><th>Tokens</th><th>Cost</th></tr>';
      for (var i = 0; i < d.by_model.length; i++) {
        var m = d.by_model[i];
        html += '<tr><td>' + escapeHtml(m.model || 'unknown') + '</td><td>' + escapeHtml(m.provider || '') + '</td><td class="mono">' + (m.requests || m.calls || 0) + '</td><td class="mono">' + (m.tokens || 0).toLocaleString() + '</td><td class="mono">$' + (m.cost || 0).toFixed(4) + '</td></tr>';
      }
      html += '</table>';
    }
    el.innerHTML = html;
  } catch(e) { document.getElementById('llm-usage-summary').innerHTML = '<p style="color:var(--text-3)">LLM usage summary unavailable</p>'; }
}

