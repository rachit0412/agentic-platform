<script>
/* ═══ INIT ═══ */
document.getElementById('admin-content').style.display = 'block';

/* ═══ USER MANAGEMENT ═══ */
var _usersCache = [];
function filterUsers(filter) {
  if (filter === 'all') { renderUsersTable(_usersCache); return; }
  var filtered = _usersCache.filter(function(u) {
    if (filter === 'active') return u.is_active !== false;
    if (filter === 'verified') return u.email_verified;
    if (filter === 'admin') return u.role === 'admin';
    return true;
  });
  renderUsersTable(filtered);
  /* Highlight the active stat card */
  document.querySelectorAll('#user-stats-bar .card').forEach(function(c) { c.style.boxShadow = ''; });
  var idx = { all: 0, active: 1, verified: 2, admin: 3 }[filter];
  var cards = document.querySelectorAll('#user-stats-bar .card');
  if (cards[idx]) cards[idx].style.boxShadow = '0 0 0 2px var(--accent)';
}
async function loadUsers() {
  try {
    var r = await fetch('/api/users');
    if (r.status === 403) { document.getElementById('users-table-container').innerHTML = '<p style="color:var(--danger)">Access denied. Admin role required.</p>'; return; }
    var data = await r.json();
    var users = Array.isArray(data) ? data : (data.users || []);
    _usersCache = users;
    renderUsersTable(users);
    /* Update stats bar */
    var total = users.length;
    var active = users.filter(function(u) { return u.is_active !== false; }).length;
    var verified = users.filter(function(u) { return u.email_verified; }).length;
    var admins = users.filter(function(u) { return u.role === 'admin'; }).length;
    document.getElementById('user-count-total').textContent = total;
    document.getElementById('user-count-active').textContent = active;
    document.getElementById('user-count-verified').textContent = verified;
    document.getElementById('user-count-admins').textContent = admins;
  } catch(e) { document.getElementById('users-table-container').innerHTML = '<p style="color:var(--danger)">Failed to load users: ' + escapeHtml(e.message) + '</p>'; }
}

function renderUsersTable(users) {
  if (!users || users.length === 0) {
    document.getElementById('users-table-container').innerHTML = '<p style="color:var(--text-3)">No users found.</p>';
    return;
  }
  var roleColors = { admin: 'var(--danger)', member: 'var(--accent-text)', viewer: 'var(--text-3)' };
  var html = '<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse">'
    + '<thead><tr style="border-bottom:2px solid var(--glass-border)">'
    + '<th style="text-align:left;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600">User</th>'
    + '<th style="text-align:left;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600">Email</th>'
    + '<th style="text-align:left;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600">Role</th>'
    + '<th style="text-align:left;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600">Workspace</th>'
    + '<th style="text-align:center;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600">Status</th>'
    + '<th style="text-align:center;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600">Verified</th>'
    + '<th style="text-align:right;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600">Actions</th>'
    + '</tr></thead><tbody>';
  users.forEach(function(u) {
    var initials = (u.display_name || u.username || '?').split(' ').map(function(w){return w[0]}).join('').substring(0,2).toUpperCase();
    var roleColor = roleColors[u.role] || 'var(--text-3)';
    var isActive = u.is_active !== false;
    var statusBadge = isActive
      ? '<span style="display:inline-flex;align-items:center;gap:4px;font-size:0.68rem;padding:3px 10px;border-radius:99px;background:var(--success-bg);color:var(--success);border:1px solid var(--success-border);font-weight:500"><span style="width:6px;height:6px;border-radius:50%;background:var(--success);display:inline-block"></span>Active</span>'
      : '<span style="display:inline-flex;align-items:center;gap:4px;font-size:0.68rem;padding:3px 10px;border-radius:99px;background:var(--danger-bg);color:var(--danger);border:1px solid var(--danger-border);font-weight:500"><span style="width:6px;height:6px;border-radius:50%;background:var(--danger);display:inline-block"></span>Disabled</span>';
    var verifiedBadge = u.email_verified
      ? '<span style="display:inline-flex;align-items:center;gap:4px;font-size:0.68rem;padding:3px 10px;border-radius:99px;background:var(--success-bg);color:var(--success);border:1px solid var(--success-border);font-weight:500"><svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>Verified</span>'
