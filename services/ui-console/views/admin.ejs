});

/* ═══ DESIGN THEME ═══ */
function applyDesignTheme(name) {
  if (typeof setDesignTheme === 'function') setDesignTheme(name);
  highlightThemeCard();
}
function highlightThemeCard() {
  var current = (typeof getDesignTheme === 'function') ? getDesignTheme() : 'midnight';
  var themes = ['midnight', 'aurora', 'softui', 'horizon'];
  for (var i = 0; i < themes.length; i++) {
    var el = document.getElementById('theme-card-' + themes[i]);
    if (!el) continue;
    if (themes[i] === current) {
      el.style.borderColor = 'var(--accent)';
      el.style.boxShadow = '0 0 0 1px var(--accent)';
    } else {
      el.style.borderColor = 'var(--glass-border)';
      el.style.boxShadow = 'none';
    }
  }
}

/* ═══ LOAD ALL ═══ */
function adminLoadAll() {
  document.getElementById('admin-last-refresh').textContent = 'Refreshed: ' + new Date().toLocaleTimeString();
  var hash = (location.hash || '').replace('#', '');
  var sectionDefaults = { operations: 'health', identity: 'users', ai: 'llm', data: 'database' };
  var validTabs = ['health','users','personas','overview','llm','database','config','audit'];
  var startTab;
  if (sectionDefaults[hash]) {
    startTab = sectionDefaults[hash];
  } else if (validTabs.indexOf(hash) >= 0) {
    startTab = hash;
  } else {
    startTab = 'health';
  }
  switchTab(startTab);
}

