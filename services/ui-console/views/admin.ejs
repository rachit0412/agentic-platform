odal-border);border-radius:16px;box-shadow:var(--modal-shadow)\\">\' +\n    \'<div style=\\"display:flex;justify-content:space-between;align-items:center;margin-bottom:20px\\"><h3 style=\\"margin:0;font-size:1.05rem;font-weight:700;color:var(--text-1)\\">Edit User</h3><button onclick=\\"closeUserModal()\\" style=\\"border:none;background:transparent;cursor:pointer;color:var(--text-3);font-size:1.3rem;line-height:1;padding:4px\\">&times;</button></div>\' +\n    \'<div style=\\"display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:10px;background:var(--modal-field-bg);margin-bottom:18px\\">\' +\n    \'<div style=\\"width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--accent),rgba(139,92,246,0.7));display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;color:#fff;flex-shrink:0\\">\' + escapeHtml((u.display_name || u.username || \'?\').charAt(0).toUpperCase()) + \'</div>\' +\n    \'<div><div style=\\"font-weight:600;font-size:0.82rem;color:var(--text-1)\\">@\' + escapeHtml(u.username) + \'</div><div style=\\"font-size:0.68rem;color:var(--text-3)\\">ID: \' + escapeHtml(u.id) + \' &middot; Status: \' + statusInfo + \' &middot; Email: \' + verifiedInfo + \'</div></div></div>\' +\n    \'<div style=\\"display:flex;flex-direction:column;gap:14px\\">\' +\n    \'<div><label style=\\"font-size:0.68rem;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em;display:block;margin-bottom:6px\\">Display Name</label><input type=\\"text\\" id=\\"edit-user-display\\" class=\\"input\\" value=\\"\' + escapeHtml(u.display_name || \'\') + \'\\" style=\\"width:100%;padding:10px 14px;border-radius:10px;background:var(--modal-field-bg);border:1px solid var(--modal-border);color:var(--text-1);box-sizing:border-box\\"></div>\' +\n    \'<div><label style=\\"font-size:0.68rem;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em;display:block;margin-bottom:6px\\">Email</label><input type=\\"email\\" id=\\"edit-user-email\\" class=\\"input\\" value=\\"\' + escapeHtml(u.email || \'\') + \'\\" style=\\"width:100%;padding:10px 14px;border-radius:10px;background:var(--modal-field-bg);border:1px solid var(--modal-border);color:var(--text-1);box-sizing:border-box\\"></div>\' +\n    \'<div><label style=\\"font-size:0.68rem;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em;display:block;margin-bottom:6px\\">Role</label><select id=\\"edit-user-role\\" class=\\"input\\" style=\\"width:100%;padding:10px 14px;border-radius:10px;background:var(--modal-field-bg);border:1px solid var(--modal-border);color:var(--text-1);box-sizing:border-box\\"><option value=\\"member\\"\' + (u.role === \'member\' ? \' selected\' : \'\') + \'>Member</option><option value=\\"admin\\"\' + (u.role === \'admin\' ? \' selected\' : \'\') + \'>Admin</option><option value=\\"viewer\\"\' + (u.role === \'viewer\' ? \' selected\' : \'\') + \'>Viewer</option></select></div>\' +\n    \'<div><label style=\\"font-size:0.68rem;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em;display:block;margin-bottom:6px\\">New Password <span style=\\"font-weight:400;color:var(--text-3)\\">(leave blank to keep)</span></label><input type=\\"password\\" id=\\"edit-user-password\\" class=\\"input\\" placeholder=\\"Unchanged\\" style=\\"width:100%;padding:10px 14px;border-radius:10px;background:var(--modal-field-bg);border:1px solid var(--modal-border);color:var(--text-1);box-sizing:border-box\\"></div>\' +\n    \'<div id=\\"edit-user-error\\" style=\\"display:none;color:var(--danger);font-size:0.75rem;text-align:center;padding:10px 14px;background:var(--danger-bg);border:1px solid var(--danger-border);border-radius:10px\\"></div>\' +\n    \'<div style=\\"display:flex;gap:8px;margin-top:4px\\"><button class=\\"btn btn-primary\\" onclick=\\"saveUser(&#39;\' + userId + \'&#39;)\\" style=\\"flex:1;padding:11px;border-radius:10px;font-weight:600\\">Save Changes</button><button class=\\"btn btn-secondary\\" onclick=\\"closeUserModal()\\" style=\\"flex:1;padding:11px;border-radius:10px\\">Cancel</button></div>\' +\n    \\\'</div></div>\\\';\n  document.body.appendChild(overlay);\n}\n\nasync function saveUser(userId) {\n  var errEl = document.getElementById(\'edit-user-error\');\n  var body = {};\n  var display = document.getElementById(\'edit-user-display\').value.trim();\n  var email = document.getElementById(\'edit-user-email\').value.trim();\n  var role = document.getElementById(\'edit-user-role\').value;\n  var password = document.getElementById(\'edit-user-password\').value;\n  if (display) body.display_name = display;\n  if (email) body.email = email;\n  body.role = role;\n  if (password) { if (password.length < 6) { errEl.style.display = \\\'block\\\'; errEl.textContent = \\\'Password must be at least 6 characters\\\'; return; } body.password = password; }\n  try {\n    var r = await fetch(\'/api/users/\' + userId, {\n      method: \\\'PUT\\\',\n      headers: { \\\'Content-Type\\\': \\\'application/json\\\' },\n      body: JSON.stringify(body)\n    });\n    if (!r.ok) { var d = await r.json(); errEl.style.display = \'block\'; errEl.textContent = d.error || d.detail || \'Failed to update user\'; return; }\n    closeUserModal();\n    showToast(\\\'User updated\\\', \\\'success\\\');\n    loadUsers();\n  } catch(e) { errEl.style.display = \\\'block\\\'; errEl.textContent = \\\'Error: \\\' + e.message; }\n}\n\nasync function deleteUser(userId, username) {\n  if (!confirm(\'Delete user \\"\' + username + \'\\"? This cannot be undone.\')) return;\n  try {\n    var r = await fetch(\'/api/users/\' + userId, { method: \'DELETE\' });\n    if (r.status === 403) { showToast(\\\'Cannot delete admin user\\\', \\\'error\\\'); return; }\n    if (!r.ok) { showToast(\\\'Failed to delete user\\\', \\\'error\\\'); return; }\n    showToast(\'User \\"\' + username + \'\\" deleted\', \'success\');\n    loadUsers();\n  } catch(e) { showToast(\\\'Error: \\\' + e.message, \\\'error\\\'); }\n}\n\nfunction closeUserModal() {\n  var overlay = document.getElementById(\'user-modal-overlay\');\n  if (overlay) overlay.remove();\n}\n\nasync function toggleUserActive(userId, activate) {\n  var action = activate ? \'enable\' : \'disable\';\n  if (!confirm(\\\'Are you sure you want to \\\' + action + \\\' this user?\\\')) return;\n  try {\n    var r = await fetch(\'/api/users/\' + userId, {\n      method: \\\'PUT\\\',\n      headers: { \\\'Content-Type\\\': \\\'application/json\\\' },\n      body: JSON.stringify({ is_active: activate })\n    });\n    if (!r.ok) { showToast(\\\'Failed to \\\' + action + \\\' user\\\', \\\'error\\\'); return; }\n    showToast(\\\'User \\\' + action + \\\'d successfully\\\', \\\'success\\\');\n    loadUsers();\n  } catch(e) { showToast(\\\'Error: \\\' + e.message, \\\'error\\\'); }\n}\n\nasync function adminVerifyUser(userId) {\n  if (!confirm(\\\'Mark this user as email verified?\\\')) return;\n  try {\n    var r = await fetch(\'/api/users/\' + userId + \'/verify\', {\n      method: \\\'POST\\\',\n      headers: { \\\'Content-Type\\\': \\\'application/json\\\' }\n    });\n    if (!r.ok) { showToast(\\\'Failed to verify user\\\', \\\'error\\\'); return; }\n    showToast(\\\'User verified successfully\\\', \\\'success\\\');\n    loadUsers();\n  } catch(e) { showToast(\\\'Error: \\\' + e.message, \\\'error\\\'); }\n}\n\nfunction showCreateWorkspaceModal() {\n  showToast(\\\'Workspace creation is available from the workspace selector\\\', \\\'info\\\');\n}\n\nasync function loadWorkspacesAdmin() {\n  try {\n    var r = await fetch(\'/api/workspaces\');\n    var d = await r.json();\n    var items = Array.isArray(d) ? d : (d.workspaces || []);\n    if (items.length === 0) {\n      document.getElementById(\'workspaces-admin-table\').innerHTML = \'<p style=\\"color:var(--text-3)\\">No workspaces configured.</p>\';\n      return;\n    }\n    var html = \'<table><tr><th>Name</th><th>ID</th><th>Members</th><th>Created</th></tr>\';\n    items.forEach(function(w) {\n      var created = w.created_at ? new Date(w.created_at).toLocaleDateString() : String.fromCharCode(0x2014);\n      var members = Array.isArray(w.members) ? w.members.length : (w.member_count || String.fromCharCode(0x2014));\n      html += \'<tr><td style=\\"font-weight:600\\">\' + escapeHtml(w.name || w.id) + \'</td>\' +\n        \'<td class=\\"mono\\" style=\\"font-size:0.75rem\\">\' + escapeHtml(w.id) + \'</td>\' +\n        \\\'<td>\\\' + members + \\\'</td>\\\' +\n        \'<td class=\\"mono\\" style=\\"font-size:0.75rem\\">\' + created + \'</td></tr>\';\n    });\n    html += \\\'</table>\\\';\n    document.getElementById(\\\'workspaces-admin-table\\\').innerHTML = html;\n  } catch(e) { document.getElementById(\'workspaces-admin-table\').innerHTML = \'<p style=\\"color:var(--text-3)\\">Failed to load workspaces</p>\'; }\n}\n\n/* ═══ NAVIGATION ═══ */\nvar SECTION_TABS = {\n  operations: [\\\'health\\\', \\\'overview\\\', \\\'audit\\\'],\n  identity: [\\\'users\\\', \\\'personas\\\'],\n  ai: [\\\'llm\\\', \\\'config\\\'],\n  data: [\\\'database\\\'],\n  infrastructure: [\\\'docker-images\\\', \\\'environment-vars\\\'],\n  compliance: [\\\'compliance-rules\\\', \\\'compliance-audit\\\', \\\'secret-scan\\\']\n};\nvar TAB_SECTION = {\n  health: \\\'operations\\\', overview: \\\'operations\\\', audit: \\\'operations\\\',\n  users: \\\'identity\\\', personas: \\\'identity\\\',\n  llm: \\\'ai\\\', config: \\\'ai\\\',\n  database: \\\'data\\\',\n  \\\'docker-images\\\': \\\'infrastructure\\\', \\\'environment-vars\\\': \\\'infrastructure\\\',\n  \\\'compliance-rules\\\': \\\'compliance\\\', \\\'compliance-audit\\\': \\\'compliance\\\', \\\'secret-scan\\\': \\\'compliance\\\'\n};\n\nfunction switchSection(section) {\n  /* Update section tab active states */\n  document.querySelectorAll(\'.admin-stab\').forEach(function(el) {\n    el.classList.toggle(\\\'active\\\', el.getAttribute(\\\'data-section\\\') === section);\n  });\n  /* Show only the matching subtab row */\n  document.querySelectorAll(\'.admin-subtabs\').forEach(function(el) {\n    el.style.display = el.id === \\\'subtabs-\\\' + section ? \\\'flex\\\' : \\\'none\\\';\n  });\n  /* Navigate to first tab of section */\n  var firstTab = (SECTION_TABS[section] || [])[0];\n  if (firstTab) switchTab(firstTab, true);\n}\n\nfunction switchTab(tab, fromSection) {\n  /* Sync section if needed */\n  if (!fromSection) {\n    var sec = TAB_SECTION[tab];\n    if (sec) {\n      document.querySelectorAll(\'.admin-stab\').forEach(function(el) {\n        el.classList.toggle(\\\'active\\\', el.getAttribute(\\\'data-section\\\') === sec);\n      });\n      document.querySelectorAll(\'.admin-subtabs\').forEach(function(el) {\n        el.style.display = el.id === \\\'subtabs-\\\' + sec ? \\\'flex\\\' : \\\'none\\\';\n      });\n    }\n  }\n  /* Update subtab active states */\n  document.querySelectorAll(\'.admin-subtab\').forEach(function(el) {\n    el.classList.toggle(\\\'active\\\', el.getAttribute(\\\'data-tab\\\') === tab);\n  });\n  /* Show content panel */\n  document.querySelectorAll(\'.admin-tab-content\').forEach(function(el) {\n    el.style.display = \\\'none\\\';\n  });\n  var panel = document.getElementById(\'tab-\' + tab);\n  if (panel) panel.style.display = \\\'block\\\';\n  history.replaceState(null, \\\'\\\', \\\'#\\\' + tab);\n  /* Load data */\n  if (tab === \\\'health\\\') loadServiceHealth();\n  if (tab === \\\'users\\\') { loadUsers(); loadWorkspacesAdmin(); }\n  if (tab === \\\'personas\\\') { loadPersonas(); loadUserPersonaAssignments(); }\n  if (tab === \\\'overview\\\') { loadOverviewCounts(); loadMemoryStats(); }\n  if (tab === \\\'llm\\\') { loadLlmConfig(); loadModels(); loadLlmSummary(); }\n  if (tab === \\\'database\\\') { loadDbStats(); loadChromaStats(); loadDocStats(); }\n  if (tab === \'config\') { loadUISettings(); loadGlobalConstraints(); loadSecurityConsiderations(); loadBestPractices(); loadGuardrails(); loadN8nWorkflows(); highlightThemeCard(); setTimeout(function() { switchConfigTab(\'appearance\'); }, 50); }\n  if (tab === \'docker-images\') { loadDockerImages(); loadDockerSecuritySummary(); if (typeof initDockerManagement === \'function\') { setTimeout(initDockerManagement, 100); } }\n  if (tab === \\\'environment-vars\\\') { loadEnvVars(); loadLLMProviderSelection(); }\n  if (tab === \\\'audit\\\') loadAuditLog();\n  if (tab === \\\'compliance-rules\\\') { loadComplianceSettings(); }\n  if (tab === \\\'compliance-audit\\\') { loadAuditLog(\\\'compliance\\\'); }\n}\n\n/* Wire up nav via event delegation (avoids inline onclick in template literal) */\ndocument.getElementById(\'admin-section-tabs\').addEventListener(\'click\', function(e) {\n  var btn = e.target.closest(\'.admin-stab\');\n  if (btn) switchSection(btn.getAttribute(\\\'data-section\\\'));\n});\ndocument.querySelectorAll(\'.admin-subtabs\').forEach(function(row) {\n  row.addEventListener(\'click\', function(e) {\n    var btn = e.target.closest(\'.admin-subtab\');\n    if (btn) switchTab(btn.getAttribute(\\\'data-tab\\\'));\n  });\n});\n\n/* Hash-change: sidebar links like /admin#identity navigate here without reload */\nwindow.addEventListener(\'hashchange\', function() {\n  adminLoadAll();\n});\n\n/* ═══ DESIGN THEME ═══ */\nfunction applyDesignTheme(name) {\n  if (typeof setDesignTheme === \'function\') setDesignTheme(name);\n  highlightThemeCard();\n}\nfunction highlightThemeCard() {\n  var current = (typeof getDesignTheme === \'function\') ? getDesignTheme() : \'midnight\';\n  var themes = [\'midnight\', \'aurora\', \'softui\', \'horizon\'];\n  for (var i = 0; i < themes.length; i++) {\n    var el = document.getElementById(\'theme-card-\' + themes[i]);\n    if (!el) continue;\n    if (themes[i] === current) {\n      el.style.borderColor = \\\'var(--accent)\\\';\n      el.style.boxShadow = \\\'0 0 0 1px var(--accent)\\\';\n    } else {\n      el.style.borderColor = \\\'var(--glass-border)\\\';\n      el.style.boxShadow = \\\'none\\\';\n    }\n  }\n}\n\n/* ═══ LOAD ALL ═══ */\nfunction adminLoadAll() {\n  document.getElementById(\\\'admin-last-refresh\\\').textContent = \\\'Refreshed: \\\' + new Date().toLocaleTimeString();\n  var hash = (location.hash || \'\').replace(\'#\', \'\');\n  var sectionDefaults = { operations: \'health\', identity: \'users\', ai: \'llm\', data: \'database\', infrastructure: \'docker-images\', compliance: \'compliance-rules\' };\n  var validTabs = [\'health\',\'users\',\'personas\',\'overview\',\'llm\',\'database\',\'config\',\'audit\',\'docker-images\',\'environment-vars\',\'compliance-rules\',\'compliance-audit\',\'secret-scan\'];\n  var startTab;\n  if (sectionDefaults[hash]) {\n    startTab = sectionDefaults[hash];\n  } else if (validTabs.indexOf(hash) >= 0) {\n    startTab = hash;\n  } else {\n    startTab = \\\'health\\\';\n  }\n  switchTab(startTab);\n}\n\n/* ═══ SERVICE HEALTH ═══ */\nasync function loadServiceHealth() {\n  try {\n    var r = await fetch(\'/api/admin/services/health\');\n    var d = await r.json();\n    /* Summary */\n    document.getElementById(\\\'health-count-healthy\\\').textContent = d.summary.healthy;\n    document.getElementById(\\\'health-count-unhealthy\\\').textContent = d.summary.unhealthy;\n    document.getElementById(\\\'health-count-total\\\').textContent = d.summary.total;\n    document.getElementById(\\\'health-timestamp\\\').textContent = new Date(d.summary.timestamp).toLocaleTimeString();\n    /* Grid */\n    var grid = document.getElementById(\'service-health-grid\');\n    grid.innerHTML = d.services.map(function(s) {\n      var statusColor = s.status === \'healthy\' ? \'var(--success)\' : s.status === \'unhealthy\' ? \'var(--danger)\' : \'var(--text-3)\';\n      var typeBadge = s.type === \'core\' ? \'<span class=\\"badge badge-info\\" style=\\"font-size:0.62rem\\">core</span>\' :\n                      s.type === \'integration\' ? \'<span class=\\"badge badge-warning\\" style=\\"font-size:0.62rem\\">integration</span>\' :\n                      \'<span class=\\"badge\\" style=\\"font-size:0.62rem;background:rgba(139,92,246,0.1);color:#a78bfa\\">observability</span>\';\n      var url = s.url || \'\';\n      var clickAttr = url ? \' style=\\"cursor:pointer\\" onclick=\\"window.open(&#39;\' + escapeHtml(url) + \'&#39;,&#39;_blank&#39;)\\" title=\\"Open \' + escapeHtml(s.name) + \'\\"\' : \'\';\n      return \'<div class=\\"health-card\\"\' + clickAttr + \'>\' +\n        \'<div class=\\"health-dot \' + s.status + \'\\"></div>\' +\n        \'<div style=\\"flex:1;min-width:0\\">\' +\n          \'<div style=\\"display:flex;align-items:center;gap:0.5rem\\">\' +\n            \'<strong style=\\"font-size:0.82rem;color:var(--text-1)\\">\' + escapeHtml(s.name) + \'</strong>\' +\n            typeBadge +\n          \\\'</div>\\\' +\n          \'<div style=\\"font-size:0.72rem;color:\' + statusColor + \';font-weight:600;text-transform:uppercase;margin-top:0.15rem\\">\' + s.status + \'</div>\' +\n          (url ? \'<div class=\\"mono\\" style=\\"font-size:0.65rem;color:var(--text-3);margin-top:0.1rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\\">\' + escapeHtml(url) + \'</div>\' : \'\') +\n        \\\'</div>\\\' +\n        \'<div style=\\"text-align:right\\">\' +\n          \'<div class=\\"mono\\" style=\\"font-size:0.72rem;color:var(--text-3)\\">\' + s.latency + \'ms</div>\' +\n          (s.code ? \'<div class=\\"mono\\" style=\\"font-size:0.68rem;color:var(--text-3)\\">HTTP \' + s.code + \'</div>\' : \'\') +\n        \\\'</div>\\\' +\n      \\\'</div>\\\';\n    }).join(\\\'\\\');\n  } catch(e) {\n    document.getElementById(\'service-health-grid\').innerHTML = \'<div style=\\"color:var(--danger);grid-column:1/-1\\">Failed to load service health: \' + escapeHtml(e.message) + \'</div>\';\n  }\n}\n\n/* ═══ PLATFORM OVERVIEW ═══ */\nasync function loadOverviewCounts() {\n  try {\n    var r = await fetch(\'/api/admin/overview\');\n    var d = await r.json();\n    var el = document.getElementById(\'overview-counts\');\n    var items = [\n      { key: \\\'agents\\\',      label: \\\'Agents\\\',       icon: \\\'&#x1F916;\\\', href: \\\'/agents\\\' },\n      { key: \\\'skills\\\',      label: \\\'Skills\\\',        icon: \\\'&#x26A1;\\\',  href: \\\'/skills\\\' },\n      { key: \\\'prompts\\\',     label: \\\'Prompts\\\',       icon: \\\'&#x1F4DD;\\\', href: \\\'/prompts\\\' },\n      { key: \\\'tools\\\',       label: \\\'Tools\\\',         icon: \\\'&#x1F527;\\\', href: \\\'/tools\\\' },\n      { key: \\\'custom_tools\\\',label: \\\'Custom Tools\\\',  icon: \\\'&#x1F6E0;\\\', href: \\\'/tools\\\' },\n      { key: \\\'sessions\\\',    label: \\\'Sessions\\\',      icon: \\\'&#x1F4AC;\\\', href: \\\'/chat\\\' },\n      { key: \\\'guardrails\\\',  label: \\\'Guardrails\\\',    icon: \\\'&#x1F6E1;\\\', href: \\\'/admin#config\\\' },\n      { key: \\\'a2a_peers\\\',   label: \\\'A2A Peers\\\',     icon: \\\'&#x1F310;\\\', href: \\\'/tools\\\' },\n      { key: \\\'mcp_servers\\\', label: \\\'MCP Servers\\\',   icon: \\\'&#x1F50C;\\\', href: \\\'/tools\\\' },\n      { key: \\\'connectors\\\',  label: \\\'Connectors\\\',    icon: \\\'&#x1F517;\\\', href: \\\'/data\\\' },\n    ];\n    el.innerHTML = items.map(function(it) {\n      return \'<a href=\\"\' + it.href + \'\\" style=\\"text-decoration:none\\">\'\n        + \'<div class=\\"count-card\\" style=\\"cursor:pointer;transition:all 0.18s\\" onmouseover=\\"this.style.borderColor=&#39;var(--accent-border)&#39;;this.style.transform=&#39;translateY(-2px)&#39;\\" onmouseout=\\"this.style.borderColor=&#39;&#39;;this.style.transform=&#39;&#39;\\">\'\n        + \'<div class=\\"count-num\\">\' + (d[it.key] || 0) + \'</div>\'\n        + \'<div class=\\"count-label\\">\' + it.icon + \' \' + it.label + \'</div>\'\n        + \\\'</div></a>\\\';\n    }).join(\\\'\\\');\n  } catch(e) {\n    document.getElementById(\'overview-counts\').innerHTML = \'<div style=\\"color:var(--danger)\\">Failed to load overview</div>\';\n  }\n}\n\n/* ═══ MEMORY STATS ═══ */\nasync function loadMemoryStats() {\n  try {\n    var r = await fetch(\'/api/admin/memory-stats\');\n    var d = await r.json();\n    var el = document.getElementById(\'memory-stats\');\n    var html = \'<div style=\\"display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:0.75rem\\">\';\n    for (var k in d) {\n      if (typeof d[k] === \\\'object\\\' && d[k] !== null) {\n        html += \'<div style=\\"padding:0.75rem;background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:8px\\">\';\n        html += \'<div style=\\"font-size:0.72rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem\\">\' + escapeHtml(k) + \'</div>\';\n        for (var sk in d[k]) {\n          html += \'<div style=\\"display:flex;justify-content:space-between;font-size:0.78rem;padding:0.15rem 0\\"><span style=\\"color:var(--text-2)\\">\' + escapeHtml(sk) + \'</span><span class=\\"mono\\" style=\\"color:var(--text-1)\\">\' + d[k][sk] + \'</span></div>\';\n        }\n        html += \\\'</div>\\\';\n      } else {\n        html += \'<div style=\\"padding:0.75rem;background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:8px;text-align:center\\">\';\n        html += \'<div style=\\"font-size:1.5rem;font-weight:700;color:var(--text-1)\\">\' + d[k] + \'</div>\';\n        html += \'<div style=\\"font-size:0.68rem;color:var(--text-3);text-transform:uppercase\\">\' + escapeHtml(k) + \'</div>\';\n        html += \\\'</div>\\\';\n      }\n    }\n    html += \\\'</div>\\\';\n    el.innerHTML = html;\n  } catch(e) { document.getElementById(\'memory-stats\').innerHTML = \'<p style=\\"color:var(--text-3)\\">Memory stats unavailable</p>\'; }\n}\n\n/* ═══ LLM CONFIG ═══ */\nasync function loadLlmConfig() {\n  try {\n    var r = await fetch(\'/api/models\');\n    var d = await r.json();\n    var el = document.getElementById(\'llm-active-config\');\n    if (!d.active) { el.innerHTML = \'<p style=\\"color:var(--text-3)\\">No active model configuration</p>\'; return; }\n    var a = d.active;\n    el.innerHTML = \'<div style=\\"display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:0.75rem\\">\' +\n      \'<div style=\\"padding:0.75rem;background:rgba(16,185,129,0.05);border:1px solid rgba(16,185,129,0.2);border-radius:8px\\">\' +\n        \'<div style=\\"font-size:0.68rem;color:var(--text-3);text-transform:uppercase\\">Provider</div>\' +\n        \'<div style=\\"font-size:1rem;font-weight:600;color:var(--success);margin-top:0.25rem\\">\' + escapeHtml(a.provider || \'unknown\') + \'</div>\' +\n      \\\'</div>\\\' +\n      \'<div style=\\"padding:0.75rem;background:rgba(6,182,212,0.05);border:1px solid rgba(6,182,212,0.2);border-radius:8px\\">\' +\n        \'<div style=\\"font-size:0.68rem;color:var(--text-3);text-transform:uppercase\\">Model</div>\' +\n        \'<div style=\\"font-size:1rem;font-weight:600;color:var(--accent-text);margin-top:0.25rem\\">\' + escapeHtml(a.model || \'unknown\') + \'</div>\' +\n      \\\'</div>\\\' +\n      \'<div style=\\"padding:0.75rem;background:rgba(139,92,246,0.05);border:1px solid rgba(139,92,246,0.2);border-radius:8px\\">\' +\n        \'<div style=\\"font-size:0.68rem;color:var(--text-3);text-transform:uppercase\\">Embedding</div>\' +\n        \'<div style=\\"font-size:1rem;font-weight:600;color:#a78bfa;margin-top:0.25rem\\">\' + escapeHtml(a.embedding_model || \'default\') + \'</div>\' +\n      \\\'</div>\\\' +\n    \\\'</div>\\\';\n    filterEmbeddingsByProvider(a.provider, d.available_embedding_providers || []);\n    highlightActiveEmbedding(a.embedding_provider || a.provider, a.embedding_model || \\\'nomic-embed-text\\\');\n  } catch(e) { document.getElementById(\'llm-active-config\').innerHTML = \'<p style=\\"color:var(--danger)\\">Failed to load LLM config</p>\'; }\n}\n\nvar _EMBED_COMPAT = {\n  \\\'ollama\\\': [\\\'ollama\\\'],\n  \\\'openai\\\': [\\\'openai\\\'],\n  \\\'azure-openai\\\': [\\\'azure-openai\\\'],\n  \\\'azure-foundry\\\': [\\\'azure-foundry\\\', \\\'openai\\\']\n};\n\nfunction filterEmbeddingsByProvider(llmProvider, availableProviders) {\n  var compatible = _EMBED_COMPAT[llmProvider] || [\'ollama\'];\n  document.querySelectorAll(\'.embed-option\').forEach(function(el) {\n    var p = el.dataset.provider;\n    var isCompat = compatible.indexOf(p) !== -1;\n    var isConfigured = availableProviders.indexOf(p) !== -1;\n    el.style.display = (isCompat && isConfigured) ? \\\'\\\' : \\\'none\\\';\n  });\n  var hint = document.getElementById(\'embed-provider-hint\');\n  if (hint) hint.textContent = \\\'Showing embeddings compatible with \\\' + llmProvider;\n}\n\nfunction highlightActiveEmbedding(provider, model) {\n  document.querySelectorAll(\'.embed-option\').forEach(function(el) {\n    var isActive = el.dataset.provider === provider && el.dataset.model === model;\n    el.style.borderColor = isActive ? \\\'var(--accent)\\\' : \\\'var(--glass-border)\\\';\n    el.style.boxShadow = isActive ? \\\'0 0 0 1px var(--accent)\\\' : \\\'none\\\';\n    el.style.background = isActive ? \\\'rgba(6,182,212,0.06)\\\' : \\\'transparent\\\';\n    var badge = el.querySelector(\'.badge\');\n    if (isActive && badge) {\n      var old = badge.querySelector(\'.embed-active-dot\');\n      if (!old) {\n        var dot = document.createElement(\'span\');\n        dot.className = \\\'embed-active-dot\\\';\n        dot.style.cssText = \\\'display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--success);margin-right:4px\\\';\n        badge.insertBefore(dot, badge.firstChild);\n      }\n    } else if (badge) {\n      var dot = badge.querySelector(\'.embed-active-dot\');\n      if (dot) dot.remove();\n    }\n  });\n}\n\nasync function selectEmbedding(el) {\n  var provider = el.dataset.provider;\n  var model = el.dataset.model;\n  try {\n    var r = await fetch(\'/api/models/embedding\', { method: \'POST\', headers: {\'Content-Type\':\'application/json\'}, body: JSON.stringify({ provider: provider, model: model }) });\n    var d = await r.json();\n    if (r.ok) {\n      showToast(\\\'Embedding switched to \\\' + provider + \\\' / \\\' + model, \\\'success\\\');\n      highlightActiveEmbedding(provider, model);\n      loadLlmConfig();\n    } else {\n      showToast(\\\'Embedding switch failed: \\\' + (d.detail || d.error || \\\'Unknown error\\\'), \\\'error\\\');\n    }\n  } catch(e) { showToast(\\\'Embedding switch failed: \\\' + e.message, \\\'error\\\'); }\n}\n\nasync function activateModel(provider, model) {\n  try {\n    var r = await fetch(\'/api/models/switch\', { method: \'POST\', headers: {\'Content-Type\':\'application/json\'}, body: JSON.stringify({ provider: provider, model: model }) });\n    var d = await r.json();\n    if (r.ok) {\n      showToast(\\\'Switched to \\\' + provider + \\\' / \\\' + model, \\\'success\\\');\n      // Auto-switch embedding to the best compatible default for this provider\n      var embedDefaults = {\n        \\\'ollama\\\': { provider: \\\'ollama\\\', model: \\\'nomic-embed-text\\\' },\n        \\\'openai\\\': { provider: \\\'openai\\\', model: \\\'text-embedding-3-small\\\' },\n        \\\'azure-openai\\\': { provider: \\\'azure-openai\\\', model: \\\'text-embedding-ada-002\\\' },\n        \\\'azure-foundry\\\': { provider: \\\'azure-foundry\\\', model: \\\'text-embedding-ada-002\\\' }\n      };\n      var emb = embedDefaults[provider] || embedDefaults[\'ollama\'];\n      await fetch(\\\'/api/models/embedding\\\', { method:\\\'POST\\\', headers:{\\\'Content-Type\\\':\\\'application/json\\\'}, body: JSON.stringify(emb) });\n      loadLlmConfig();\n      loadModels();\n    } else {\n      showToast(\\\'Switch failed: \\\' + (d.detail || d.error || \\\'Unknown error\\\'), \\\'error\\\');\n    }\n  } catch(e) { showToast(\\\'Switch failed: \\\' + e.message, \\\'error\\\'); }\n}\n\n/* ═══ MODELS ═══ */\nasync function loadModels() {\n  try {\n    var r = await fetch(\'/api/models\');\n    var d = await r.json();\n    var el = document.getElementById(\'models-list\');\n    var ollamaMsg = \'\';\n    if (d.ollama_status && !d.ollama_status.enabled) {\n      var reason = escapeHtml(d.ollama_status.reason || \'Configured model is not pulled\');\n      var cmd = escapeHtml(d.ollama_status.pull_command || \'docker compose exec -T ollama ollama pull llama3\');\n      ollamaMsg = \'<div style=\\"margin-bottom:0.65rem;padding:0.6rem 0.75rem;border-radius:10px;background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.25);color:#b45309\\">\' +\n        \\\'<strong>Ollama not enabled:</strong> \\\' + reason + \\\'<br>\\\' +\n        \'<span style=\\"font-size:0.75rem\\">Enable with: <code style=\\"color:#92400e\\">\' + cmd + \'</code></span>\' +\n        \\\'</div>\\\';\n    }\n    if (!d.models || d.models.length === 0) {\n      el.innerHTML = ollamaMsg + \'<p style=\\"color:var(--text-3)\\">No models found. Pull models with: <code style=\\"color:var(--accent-text)\\">docker compose exec -T ollama ollama pull llama3</code></p>\';\n      return;\n    }\n    el.innerHTML = ollamaMsg + \'<table><tr><th>Model</th><th>Provider</th><th>Size</th><th>Status</th><th style=\\"width:1%\\"></th></tr>\' +\n      d.models.map(function(m) {\n        var name = escapeHtml(m.full_name || m.model || \'\');\n        var provider = escapeHtml(m.provider || \'\');\n        var model = escapeHtml(m.model || \'\');\n        var size = m.size ? (m.size / 1e9).toFixed(1) + \' GB\' : String.fromCharCode(0x2014);\n        var ollamaUnavailable = m.provider === \'ollama\' && (m.installed === false || m.status === \'not_pulled\');\n        var badge = m.active\n          ? \'<span class=\\"badge badge-success\\">active</span>\'\n          : (ollamaUnavailable\n            ? \'<span class=\\"badge\\" style=\\"font-size:0.68rem;background:rgba(244,63,94,0.12);color:#f43f5e\\">not enabled</span>\'\n            : \'<span class=\\"badge\\" style=\\"font-size:0.68rem\\">available</span>\');\n        var action = (m.active || ollamaUnavailable)\n          ? \\\'\\\'\n          : \'<button class=\\"btn btn-primary btn-sm\\" style=\\"padding:0.2rem 0.6rem;font-size:0.7rem;white-space:nowrap\\" onclick=\\"activateModel(&apos;\' + provider + \'&apos;,&apos;\' + model + \'&apos;)\\">Use</button>\';\n        var note = m.note ? \'<div style=\\"font-size:0.68rem;color:#b45309;margin-top:0.2rem\\">\' + escapeHtml(m.note) + \'</div>\' : \'\';\n        return \'<tr><td>\' + name + note + \'</td><td class=\\"mono\\" style=\\"font-size:0.78rem\\">\' + provider + \'</td><td class=\\"mono\\">\' + size + \'</td><td>\' + badge + \'</td><td>\' + action + \'</td></tr>\';\n      }).join(\\\'\\\') + \\\'</table>\\\';\n  } catch(e) {\n    document.getElementById(\'models-list\').innerHTML = \'<p style=\\"color:var(--danger)\\">Failed to load models</p>\';\n  }\n}\n\n/* ═══ LLM USAGE SUMMARY ═══ */\nasync function loadLlmSummary() {\n  try {\n    var r = await fetch(\'/api/admin/llm-summary\');\n    var d = await r.json();\n    var el = document.getElementById(\'llm-usage-summary\');\n    if (!d || (typeof d === \\\'object\\\' && Object.keys(d).length === 0)) {\n      el.innerHTML = \'<p style=\\"color:var(--text-3)\\">No LLM usage data yet. Run some agent prompts to generate usage data.</p>\';\n      return;\n    }\n    var html = \'<div style=\\"display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:0.75rem\\">\';\n    var metricLabels = { total_calls: \'Total Calls\', total_tokens: \'Total Tokens\', total_input_tokens: \'Input Tokens\', total_output_tokens: \'Output Tokens\', avg_latency_ms: \'Avg Latency\', total_cost: \'Est. Cost\' };\n    for (var k in d) {\n      if (k === \\\'by_model\\\' || k === \\\'by_provider\\\' || k === \\\'recent\\\') continue;\n      var label = metricLabels[k] || k;\n      var val = typeof d[k] === \'number\' ? (k.includes(\'cost\') ? \'$\' + d[k].toFixed(4) : k.includes(\'latency\') ? d[k].toFixed(0) + \'ms\' : d[k].toLocaleString()) : d[k];\n      html += \'<div style=\\"padding:0.75rem;background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:8px;text-align:center\\">\';\n      html += \'<div style=\\"font-size:1.25rem;font-weight:700;color:var(--text-1)\\">\' + val + \'</div>\';\n      html += \'<div style=\\"font-size:0.68rem;color:var(--text-3);text-transform:uppercase\\">\' + escapeHtml(label) + \'</div>\';\n      html += \\\'</div>\\\';\n    }\n    html += \\\'</div>\\\';\n    if (d.by_model && d.by_model.length > 0) {\n      html += \'<h4 style=\\"margin-top:1rem;margin-bottom:0.5rem;font-size:0.85rem\\">By Model</h4><table><tr><th>Model</th><th>Provider</th><th>Calls</th><th>Tokens</th><th>Cost</th></tr>\';\n      for (var i = 0; i < d.by_model.length; i++) {\n        var m = d.by_model[i];\n        html += \'<tr><td>\' + escapeHtml(m.model || \'unknown\') + \'</td><td>\' + escapeHtml(m.provider || \'\') + \'</td><td class=\\"mono\\">\' + (m.requests || m.calls || 0) + \'</td><td class=\\"mono\\">\' + (m.tokens || 0).toLocaleString() + \'</td><td class=\\"mono\\">$\' + (m.cost || 0).toFixed(4) + \'</td></tr>\';\n      }\n      html += \\\'</table>\\\';\n    }\n    el.innerHTML = html;\n  } catch(e) { document.getElementById(\'llm-usage-summary\').innerHTML = \'<p style=\\"color:var(--text-3)\\">LLM usage summary unavailable</p>\'; }\n}\n\n/* ═══ DB STATS ═══ */\nasync function loadDbStats() {\n  try {\n    var r = await fetch(\'/api/db-stats\');\n    var d = await r.json();\n    var el = document.getElementById(\'db-stats\');\n    var sizeMB = (d.db_size_bytes / (1024*1024)).toFixed(2);\n    var tables = [\'agents\',\'skills\',\'prompts\',\'conversations\',\'documents\',\'mcp_servers\',\'a2a_peers\',\'guardrails\',\'custom_tools\',\'session_summaries\',\'connectors\',\'sync_jobs\',\'version_history\',\'audit_log\'];\n    var totalRecords = tables.reduce(function(sum, t) { return sum + (d[t] || 0); }, 0);\n    el.innerHTML = \'<div style=\\"display:flex;gap:1.5rem;margin-bottom:0.75rem;flex-wrap:wrap\\">\' +\n      \'<div><span style=\\"font-size:0.72rem;color:var(--text-3);text-transform:uppercase\\">Path</span><br><code style=\\"color:var(--accent-text);font-size:0.78rem\\">\' + escapeHtml(d.db_path||\'unknown\') + \'</code></div>\' +\n      \'<div><span style=\\"font-size:0.72rem;color:var(--text-3);text-transform:uppercase\\">Size</span><br><span class=\\"mono\\" style=\\"font-size:0.95rem;font-weight:600\\">\' + sizeMB + \' MB</span></div>\' +\n      \'<div><span style=\\"font-size:0.72rem;color:var(--text-3);text-transform:uppercase\\">Total Records</span><br><span class=\\"mono\\" style=\\"font-size:0.95rem;font-weight:600\\">\' + totalRecords.toLocaleString() + \'</span></div>\' +\n    \\\'</div>\\\' +\n      \\\'<table><tr><th>Table</th><th>Records</th><th>% of Total</th></tr>\\\' +\n      tables.map(function(t) {\n        var count = d[t] || 0;\n        var pct = totalRecords > 0 ? ((count / totalRecords) * 100).toFixed(1) : \'0.0\';\n        var barWidth = totalRecords > 0 ? Math.max(2, (count / totalRecords) * 100) : 0;\n        return \'<tr><td>\' + t + \'</td><td class=\\"mono\\">\' + count.toLocaleString() + \'</td>\' +\n          \'<td><div style=\\"display:flex;align-items:center;gap:0.5rem\\"><div style=\\"width:80px;height:6px;background:var(--glass-border);border-radius:3px;overflow:hidden\\"><div style=\\"width:\' + barWidth + \'%;height:100%;background:var(--accent-text);border-radius:3px\\"></div></div><span class=\\"mono\\" style=\\"font-size:0.72rem;color:var(--text-3)\\">\' + pct + \'%</span></div></td></tr>\';\n      }).join(\\\'\\\') + \\\'</table>\\\';\n  } catch(e) { document.getElementById(\'db-stats\').innerHTML = \'<p style=\\"color:var(--danger)\\">Failed to load DB stats</p>\'; }\n}\n\n/* ═══ EXPORT/IMPORT ═══ */\nasync function exportData() {\n  try {\n    var r = await fetch(\'/api/export\');\n    var d = await r.json();\n    var blob = new Blob([JSON.stringify(d, null, 2)], {type:\'application/json\'});\n    var a = document.createElement(\'a\');\n    a.href = URL.createObjectURL(blob);\n    a.download = \\\'agentic-platform-export-\\\' + new Date().toISOString().slice(0,10) + \\\'.json\\\';\n    a.click();\n    URL.revokeObjectURL(a.href);\n    showToast(\\\'Data exported successfully\\\', \\\'success\\\');\n  } catch(e) { showToast(\\\'Export failed: \\\' + e.message, \\\'error\\\'); }\n}\n\nasync function importData(evt) {\n  var file = evt.target.files[0];\n  if (!file) return;\n  try {\n    var text = await file.text();\n    var data = JSON.parse(text);\n    var r = await fetch(\'/api/import\', { method:\'POST\', headers:{\'Content-Type\':\'application/json\'}, body: JSON.stringify(data) });\n    if (!r.ok) { showToast(\\\'Import failed: \\\' + r.statusText, \\\'error\\\'); return; }\n    await r.json();\n    showToast(\\\'Import complete\\\', \\\'success\\\');\n    loadDbStats();\n  } catch(e) { showToast(\\\'Import failed: \\\' + e.message, \\\'error\\\'); }\n  evt.target.value = \\\'\\\';\n}\n\n/* ═══ CHROMADB ═══ */\nasync function loadChromaStats() {\n  try {\n    var r1 = await fetch(\'/api/chromadb/stats\');\n    var hb = await r1.json();\n    var r2 = await fetch(\'/api/admin/chromadb/collections\');\n    var cols = await r2.json();\n    var el = document.getElementById(\'chroma-stats\');\n    var statusBadge = hb.status === \'connected\' ? \'<span class=\\"badge badge-success\\">Connected</span>\' : \'<span class=\\"badge\\" style=\\"background:rgba(239,68,68,0.1);color:#f87171\\">Unreachable</span>\';\n    var html = \'<div style=\\"margin-bottom:0.75rem\\">\' + statusBadge + \'</div>\';\n    if (Array.isArray(cols) || (cols && cols.collections)) {\n      var collections = cols.collections || cols;\n      if (Array.isArray(collections) && collections.length > 0) {\n        html += \\\'<table><tr><th>Collection</th><th>Documents</th></tr>\\\';\n        collections.forEach(function(c) {\n          var name = typeof c === \'string\' ? c : (c.name || c.id || \'unknown\');\n          var count = c.count || c.document_count || String.fromCharCode(0x2014);\n          html += \'<tr><td>\' + escapeHtml(name) + \'</td><td class=\\"mono\\">\' + count + \'</td></tr>\';\n        });\n        html += \\\'</table>\\\';\n      } else {\n        html += \'<p style=\\"color:var(--text-3)\\">No collections found</p>\';\n      }\n    } else {\n      html += \'<p style=\\"color:var(--text-3)\\">Collections data unavailable</p>\';\n    }\n    el.innerHTML = html;\n  } catch(e) { document.getElementById(\'chroma-stats\').innerHTML = \'<p style=\\"color:var(--danger)\\">Failed to load ChromaDB stats</p>\'; }\n}\n\n/* ═══ DOC STATS ═══ */\nasync function loadDocStats() {\n  try {\n    var r = await fetch(\'/api/admin/documents/stats\');\n    var d = await r.json();\n    var el = document.getElementById(\'doc-stats\');\n    if (!d || typeof d !== \'object\') { el.innerHTML = \'<p style=\\"color:var(--text-3)\\">No document stats available</p>\'; return; }\n    var html = \'<div style=\\"display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:0.75rem\\">\';\n    for (var k in d) {\n      if (typeof d[k] === \\\'number\\\' || typeof d[k] === \\\'string\\\') {\n        html += \'<div style=\\"padding:0.75rem;background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:8px;text-align:center\\">\';\n        html += \'<div style=\\"font-size:1.25rem;font-weight:700;color:var(--text-1)\\">\' + (typeof d[k] === \'number\' ? d[k].toLocaleString() : escapeHtml(String(d[k]))) + \'</div>\';\n        html += \'<div style=\\"font-size:0.68rem;color:var(--text-3);text-transform:uppercase\\">\' + escapeHtml(k.replace(/_/g, \' \')) + \'</div>\';\n        html += \\\'</div>\\\';\n      }\n    }\n    html += \\\'</div>\\\';\n    el.innerHTML = html;\n  } catch(e) { document.getElementById(\'doc-stats\').innerHTML = \'<p style=\\"color:var(--text-3)\\">Document stats unavailable</p>\'; }\n}\n\n/* ═══ SSO STATUS ═══ */\nasync function loadSSOStatus() {\n  try {\n    var r = await fetch(\'/auth/sso/status\');\n    var d = await r.json();\n    [\'google\',\'github\',\'microsoft\'].forEach(function(p) {\n      var el = document.getElementById(\'sso-\' + p + \'-status\');\n      var card = document.getElementById(\'sso-card-\' + p);\n      if (d[p]) {\n        el.innerHTML = \'<svg viewBox=\\"0 0 24 24\\" width=\\"10\\" height=\\"10\\" fill=\\"none\\" stroke=\\"currentColor\\" stroke-width=\\"2.5\\" style=\\"vertical-align:-1px;margin-right:2px;color:var(--success)\\"><path d=\\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\\"/></svg>Configured &amp; Encrypted\';\n        el.style.color = \\\'var(--success)\\\';\n        card.style.borderColor = \\\'var(--success)\\\';\n      } else {\n        el.textContent = \\\'Not configured\\\';\n        el.style.color = \\\'var(--text-3)\\\';\n        card.style.borderColor = \\\'var(--glass-border)\\\';\n      }\n    });\n  } catch(e) {\n    [\'google\',\'github\',\'microsoft\'].forEach(function(p) {\n      var el = document.getElementById(\'sso-\' + p + \'-status\');\n      if (el) { el.textContent = \\\'Error loading\\\'; el.style.color = \\\'var(--danger)\\\'; }\n    });\n  }\n}\nloadSSOStatus();\n\nfunction toggleSSOForm(provider) {\n  var form = document.getElementById(\'sso-form-\' + provider);\n  if (!form) return;\n  if (form.style.display === \\\'none\\\') {\n    form.style.display = \\\'block\\\';\n    // Pre-fill client ID if already configured\n    fetch(\'/api/admin/sso-config\').then(function(r) { return r.json(); }).then(function(d) {\n      if (d[provider] && d[provider].clientId) {\n        document.getElementById(\\\'sso-\\\' + provider + \\\'-id\\\').value = d[provider].clientId;\n      }\n    }).catch(function() {});\n  } else {\n    form.style.display = \\\'none\\\';\n  }\n}\n\nasync function saveSSO(provider) {\n  var clientId = document.getElementById(\'sso-\' + provider + \'-id\').value.trim();\n  var clientSecret = document.getElementById(\'sso-\' + provider + \'-secret\').value.trim();\n  if (!clientId || !clientSecret) { showToast(\\\'Client ID and Secret are required\\\', \\\'error\\\'); return; }\n  try {\n    var r = await fetch(\'/api/admin/sso-config\', {\n      method: \\\'PUT\\\',\n      headers: { \\\'Content-Type\\\': \\\'application/json\\\' },\n      body: JSON.stringify({ provider: provider, clientId: clientId, clientSecret: clientSecret })\n    });\n    var d = await r.json();\n    if (r.ok && d.ok) {\n      showToast((provider.charAt(0).toUpperCase() + provider.slice(1)) + \\\' SSO configured\\\', \\\'success\\\');\n      if (d.warning) showToast(d.warning, \\\'warn\\\');\n      document.getElementById(\\\'sso-form-\\\' + provider).style.display = \\\'none\\\';\n      document.getElementById(\\\'sso-\\\' + provider + \\\'-secret\\\').value = \\\'\\\';\n      loadSSOStatus();\n    } else {\n      showToast(d.error || \\\'Failed to save SSO config\\\', \\\'error\\\');\n    }\n  } catch(e) { showToast(\\\'Failed to save SSO config\\\', \\\'error\\\'); }\n}\n\n/* ═══ GLOBAL CONSTRAINTS ═══ */\nasync function loadGlobalConstraints() {\n  try {\n    var r = await fetch(\'/api/admin/global-constraints\');\n    var d = await r.json();\n    document.getElementById(\\\'global-constraints-editor\\\').value = JSON.stringify(d, null, 2);\n  } catch(e) {\n    document.getElementById(\\\'global-constraints-editor\\\').value = \\\'{}\\\';\n  }\n}\n\nasync function saveGlobalConstraints() {\n  try {\n    var text = document.getElementById(\'global-constraints-editor\').value;\n    var data = JSON.parse(text);\n    var r = await fetch(\'/api/admin/global-constraints\', { method: \'PUT\', headers: {\'Content-Type\':\'application/json\'}, body: JSON.stringify(data) });\n    if (r.ok) { showToast(\\\'Global constraints saved\\\', \\\'success\\\'); }\n    else { showToast(\\\'Failed to save constraints\\\', \\\'error\\\'); }\n  } catch(e) { showToast(\\\'Invalid JSON: \\\' + e.message, \\\'error\\\'); }\n}\n\n/* ═══ SECURITY CONSIDERATIONS ═══ */\nvar _defaultSC = [\n  \\\'Exercise caution when adding scripts to your skill\\\',\n  \\\'Never hardcode API keys, passwords, or secrets in prompts or constraints\\\',\n  \\\'Review any skills you download before enabling them\\\',\n  \\\'Use appropriate MCP connections for external service access\\\',\n  \\\'Validate input parameters to prevent injection attacks\\\'\n];\n\nasync function loadSecurityConsiderations() {\n  try {\n    var r = await fetch(\'/api/admin/security-considerations\');\n    var d = await r.json();\n    var items = d.items || [];\n    document.getElementById(\\\'security-editor\\\').value = items.length ? items.join(\\\'\\\\n\\\') : _defaultSC.join(\\\'\\\\n\\\');\n  } catch(e) {\n    document.getElementById(\\\'security-editor\\\').value = _defaultSC.join(\\\'\\\\n\\\');\n  }\n}\n\nasync function saveSecurityConsiderations() {\n  var lines = document.getElementById(\'security-editor\').value.split(\'\\\\n\').map(function(l){return l.trim()}).filter(Boolean);\n  if (lines.length === 0) { showToast(\\\'Add at least one security consideration\\\', \\\'error\\\'); return; }\n  try {\n    var r = await fetch(\'/api/admin/security-considerations\', { method: \'PUT\', headers: {\'Content-Type\':\'application/json\'}, body: JSON.stringify({ items: lines }) });\n    var d = await r.json();\n    if (d.error) { showToast(\\\'Error: \\\' + d.error, \\\'error\\\'); return; }\n    showToast(\\\'Security considerations saved (\\\' + (d.items || lines).length + \\\' items)\\\', \\\'success\\\');\n  } catch(e) { showToast(\\\'Error: \\\' + e.message, \\\'error\\\'); }\n}\n\nfunction resetSecurityConsiderations() {\n  document.getElementById(\\\'security-editor\\\').value = _defaultSC.join(\\\'\\\\n\\\');\n  showToast(\\\'Reset to defaults \\\\u2014 click Save All to persist\\\', \\\'info\\\');\n}\n\n/* ═══ BEST PRACTICES ═══ */\nvar _defaultBP = [\n  \\\'Write a clear, specific description so agents know WHEN to activate this skill (progressive disclosure)\\\',\n  \\\'Keep prompts under 5,000 tokens \\u2014 move reference docs, templates, and assets to external files\\\',\n  \'Define input parameters with types and defaults for reusable, composable skills (like function arguments)\',\n  \\\'Limit allowed tools to only what the skill needs (principle of least privilege)\\\',\n  \'Add constraints as behavioral guardrails (e.g. \\"Max 500 words\\", \\"Always cite sources\\", \\"Never output PII\\")\',\n  \\\'Include examples of expected inputs & outputs in the prompt for consistency and auditability\\\',\n  \\\'Bundle scripts, reference materials, and templates alongside the skill for self-contained execution\\\',\n  \\\'Capture domain expertise and org-specific workflows as repeatable, version-controlled procedures\\\',\n  \\\'Design skills to be portable and cross-product \\u2014 follow the Agent Skills open standard (agentskills.io)\\\',\n  \\\'Use MCP connections for external services instead of hardcoding credentials or secrets\\\',\n  \\\'Test your skill with edge cases and adversarial inputs before deploying to production\\\'\n];\n\nasync function loadBestPractices() {\n  try {\n    var r = await fetch(\'/api/admin/best-practices\');\n    var d = await r.json();\n    var items = d.practices || [];\n    document.getElementById(\\\'best-practices-editor\\\').value = items.length ? items.join(\\\'\\\\n\\\') : _defaultBP.join(\\\'\\\\n\\\');\n  } catch(e) {\n    document.getElementById(\\\'best-practices-editor\\\').value = _defaultBP.join(\\\'\\\\n\\\');\n  }\n}\n\nasync function saveBestPractices() {\n  var lines = document.getElementById(\'best-practices-editor\').value.split(\'\\\\n\').map(function(l){return l.trim()}).filter(Boolean);\n  if (lines.length === 0) { showToast(\\\'Add at least one best practice\\\', \\\'error\\\'); return; }\n  try {\n    var r = await fetch(\'/api/admin/best-practices\', { method: \'PUT\', headers: {\'Content-Type\':\'application/json\'}, body: JSON.stringify({ practices: lines }) });\n    var d = await r.json();\n    if (d.error) { showToast(\\\'Error: \\\' + d.error, \\\'error\\\'); return; }\n    showToast(\\\'Best practices saved (\\\' + (d.practices || lines).length + \\\' items)\\\', \\\'success\\\');\n  } catch(e) { showToast(\\\'Error: \\\' + e.message, \\\'error\\\'); }\n}\n\nfunction resetBestPractices() {\n  document.getElementById(\\\'best-practices-editor\\\').value = _defaultBP.join(\\\'\\\\n\\\');\n  showToast(\\\'Reset to defaults \\u2014 click Save to persist\\\', \\\'info\\\');\n}\n\n/* ═══ GUARDRAILS ═══ */\nasync function loadGuardrails() {\n  try {\n    var r = await fetch(\'/api/guardrails\');\n    var d = await r.json();\n    var el = document.getElementById(\'guardrails-list\');\n    var items = Array.isArray(d) ? d : (d.guardrails || []);\n    if (items.length === 0) {\n      el.innerHTML = \'<p style=\\"color:var(--text-3)\\">No guardrails configured. Create them from the <a href=\\"/guardrails\\" style=\\"color:var(--accent-text)\\">Guardrails</a> page.</p>\';\n      return;\n    }\n    el.innerHTML = \\\'<table><tr><th>Name</th><th>Status</th><th>Checks</th></tr>\\\' +\n      items.map(function(g) {\n        var status = g.enabled !== false ? \'<span class=\\"badge badge-success\\">Active</span>\' : \'<span class=\\"badge\\" style=\\"font-size:0.68rem\\">Disabled</span>\';\n        var checks = \'\';\n        if (g.checks_config) {\n          try {\n            var cfg = typeof g.checks_config === \'string\' ? JSON.parse(g.checks_config) : g.checks_config;\n            checks = Object.keys(cfg).filter(function(k) { return cfg[k]; }).join(\', \');\n          } catch(e2) { checks = \\\'custom\\\'; }\n        }\n        return \'<tr><td>\' + escapeHtml(g.name || g.id) + \'</td><td>\' + status + \'</td><td style=\\"font-size:0.75rem;color:var(--text-3)\\">\' + escapeHtml(checks) + \'</td></tr>\';\n      }).join(\\\'\\\') + \\\'</table>\\\';\n  } catch(e) { document.getElementById(\'guardrails-list\').innerHTML = \'<p style=\\"color:var(--text-3)\\">Guardrails unavailable</p>\'; }\n}\n\n/* ═══ N8N WORKFLOWS ═══ */\nasync function loadN8nWorkflows() {\n  try {\n    var r = await fetch(\'/api/admin/n8n/workflows\');\n    var d = await r.json();\n    var el = document.getElementById(\'n8n-workflows\');\n    var items = d.data || [];\n    if (items.length === 0) {\n      el.innerHTML = \'<p style=\\"color:var(--text-3)\\">No n8n workflows found. \' + (d.error ? \'Error: \' + escapeHtml(d.error) : \'Create workflows from the <a href=\\"/workflows\\" style=\\"color:var(--accent-text)\\">Workflows</a> page.\') + \'</p>\';\n      return;\n    }\n    el.innerHTML = \\\'<table><tr><th>Name</th><th>Status</th><th>Created</th></tr>\\\' +\n      items.map(function(w) {\n        var status = w.active ? \'<span class=\\"badge badge-success\\">Active</span>\' : \'<span class=\\"badge\\" style=\\"font-size:0.68rem\\">Inactive</span>\';\n        var created = w.createdAt ? new Date(w.createdAt).toLocaleDateString() : String.fromCharCode(0x2014);\n        return \'<tr><td>\' + escapeHtml(w.name || w.id) + \'</td><td>\' + status + \'</td><td class=\\"mono\\" style=\\"font-size:0.75rem\\">\' + created + \'</td></tr>\';\n      }).join(\\\'\\\') + \\\'</table>\\\';\n  } catch(e) { document.getElementById(\'n8n-workflows\').innerHTML = \'<p style=\\"color:var(--text-3)\\">n8n unavailable</p>\'; }\n}\n\n/* ═══ AUDIT LOG ═══ */\nasync function loadAuditLog(type) {\n  try {\n    // Determine which container to use\n    const isComplianceTab = type === \'compliance\' || document.getElementById(\'tab-compliance-audit\').style.display !== \'none\';\n    const tableContainer = isComplianceTab ? document.getElementById(\'audit-log-table\') : document.getElementById(\'audit-log\');\n    \n    if (!tableContainer) {\n      console.error(\\\'Audit log table container not found\\\');\n      return;\n    }\n    \n    // Get filter values\n    const typeFilterEl = document.getElementById(\'audit-filter-type\');\n    const actionFilterEl = document.getElementById(\'audit-filter-action\');\n    const complianceFilterEl = document.getElementById(\'audit-filter\');\n    \n    const typeVal = typeFilterEl ? typeFilterEl.value : \'\';\n    const actionVal = actionFilterEl ? actionFilterEl.value : \'\';\n    const complianceVal = complianceFilterEl ? complianceFilterEl.value : \'\';\n    \n    // Build query parameters\n    const params = new URLSearchParams({ limit: \'100\' });\n    if (typeVal) params.set(\\\'entity_type\\\', typeVal);\n    if (actionVal) params.set(\\\'action\\\', actionVal);\n    if (complianceVal) params.set(\\\'event_type\\\', complianceVal);\n    \n    // Fetch audit log\n    const response = await fetch(\'/api/audit-log?\' + params.toString());\n    if (!response.ok) throw new Error(\\\'HTTP \\\' + response.status);\n    \n    const data = await response.json();\n    \n    if (!data.entries || data.entries.length === 0) {\n      if (isComplianceTab) {\n        tableContainer.innerHTML = \'<table style=\\"width:100%;border-collapse:collapse;font-size:0.9rem\\"><thead><tr style=\\"border-bottom:2px solid var(--divider)\\"><th style=\\"text-align:left;padding:0.75rem;font-weight:600\\">Timestamp</th><th style=\\"text-align:left;padding:0.75rem;font-weight:600\\">User</th><th style=\\"text-align:left;padding:0.75rem;font-weight:600\\">Event Type</th><th style=\\"text-align:left;padding:0.75rem;font-weight:600\\">Details</th></tr></thead><tbody><tr style=\\"border-bottom:1px solid var(--divider);color:var(--text-3)\\"><td colspan=\\"4\\" style=\\"padding:2rem;text-align:center\\">No audit events yet</td></tr></tbody></table>\';\n      } else {\n        tableContainer.innerHTML = \'<p style=\\"color:var(--text-3)\\">No audit log entries yet. Changes will appear here.</p>\';\n      }\n      return;\n    }\n    \n    if (isComplianceTab) {\n      // Render compliance audit table\n      let tableHtml = \'<table style=\\"width:100%;border-collapse:collapse;font-size:0.9rem\\"><thead><tr style=\\"border-bottom:2px solid var(--divider)\\"><th style=\\"text-align:left;padding:0.75rem;font-weight:600\\">Timestamp</th><th style=\\"text-align:left;padding:0.75rem;font-weight:600\\">User</th><th style=\\"text-align:left;padding:0.75rem;font-weight:600\\">Event Type</th><th style=\\"text-align:left;padding:0.75rem;font-weight:600\\">Details</th></tr></thead><tbody>\';\n      \n      data.entries.forEach(function(entry) {\n        const time = new Date(entry.created_at).toLocaleString();\n        const user = entry.user_id || entry.username || \'System\';\n        const eventType = entry.action || entry.event_type || \'Unknown\';\n        const details = entry.details ? (typeof entry.details === \'string\' ? entry.details : JSON.stringify(entry.details).substring(0, 150)) : \'\';\n        \n        tableHtml += \'<tr style=\\"border-bottom:1px solid var(--divider);color:var(--text-1)\\">\'\n          + \'<td style=\\"padding:0.75rem;font-family:monospace;font-size:0.8rem;white-space:nowrap\\">\' + escapeHtml(time) + \'</td>\'\n          + \'<td style=\\"padding:0.75rem\\">\' + escapeHtml(user) + \'</td>\'\n          + \'<td style=\\"padding:0.75rem;font-weight:500\\">\' + escapeHtml(eventType) + \'</td>\'\n          + \'<td style=\\"padding:0.75rem;font-size:0.85rem;color:var(--text-2);max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap\\" title=\\"\' + escapeHtml(details) + \'\\">\' + escapeHtml(details) + \'</td>\'\n          + \\\'</tr>\\\';\n      });\n      \n      tableHtml += \\\'</tbody></table>\\\';\n      tableContainer.innerHTML = tableHtml;\n    } else {\n      // Render regular audit log table\n      const actionColors = { create: \'var(--success)\', update: \'var(--info)\', delete: \'var(--danger)\', rollback: \'var(--warning)\' };\n      let html = \'<table><tr><th>Time</th><th>Action</th><th>Type</th><th>Name</th><th>Details</th></tr>\';\n      \n      html += data.entries.map(function(e) {\n        const time = new Date(e.created_at).toLocaleString();\n        const color = actionColors[e.action] || \'var(--text-3)\';\n        const details = e.details && Object.keys(e.details).length > 0 ? escapeHtml(JSON.stringify(e.details)).substring(0, 120) : \'\';\n        return \'<tr><td class=\\"mono\\" style=\\"font-size:0.72rem;white-space:nowrap\\">\' + time + \'</td>\'\n          + \'<td><span style=\\"color:\' + color + \';font-weight:600;text-transform:uppercase;font-size:0.72rem\\">\' + escapeHtml(e.action) + \'</span></td>\'\n          + \'<td style=\\"font-size:0.78rem\\">\' + escapeHtml(e.entity_type) + \'</td>\'\n          + \'<td style=\\"font-size:0.78rem\\">\' + escapeHtml(e.entity_name || e.entity_id) + \'</td>\'\n          + \'<td class=\\"mono\\" style=\\"font-size:0.72rem;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap\\" title=\\"\' + details + \'\\">\' + details + \'</td></tr>\';\n      }).join(\\\'\\\');\n      \n      html += \\\'</table>\\\';\n      tableContainer.innerHTML = html;\n    }\n  } catch(e) {\n    console.error(\\\'Error loading audit log:\\\', e);\n    const tableContainer = document.getElementById(type === \'compliance\' ? \'audit-log-table\' : \'audit-log\');\n    if (tableContainer) {\n      tableContainer.innerHTML = \'<p style=\\"color:var(--danger)\\">Failed to load audit log: \' + escapeHtml(e.message) + \'</p>\';\n    }\n  }\n}\n\n// Safely attach event listeners\nsetTimeout(function() {\n  var typeFilter = document.getElementById(\'audit-filter-type\');\n  var actionFilter = document.getElementById(\'audit-filter-action\');\n  var complianceFilter = document.getElementById(\'audit-filter\');\n  \n  if (typeFilter) typeFilter.addEventListener(\'change\', function() { loadAuditLog(); });\n  if (actionFilter) actionFilter.addEventListener(\'change\', function() { loadAuditLog(); });\n  if (complianceFilter) complianceFilter.addEventListener(\'change\', function() { loadAuditLog(\'compliance\'); });\n}, 100);\n\nfunction exportAuditLog() {\n  try {\n    const table = document.getElementById(\'audit-log-table\');\n    if (!table) throw new Error(\\\'Table not found\\\');\n    \n    const rows = table.querySelectorAll(\'tr\');\n    if (rows.length < 2) {\n      showToast(\\\'No audit entries to export\\\', \\\'warning\\\');\n      return;\n    }\n    \n    // Extract table data to CSV\n    let csvContent = \'Timestamp,User,Event Type,Details\\n\';\n    for (let i = 1; i < rows.length; i++) {\n      const cells = rows[i].querySelectorAll(\'td\');\n      if (cells.length >= 4) {\n        const time = cells[0].textContent.trim();\n        const user = cells[1].textContent.trim();\n        const eventType = cells[2].textContent.trim();\n        const details = cells[3].textContent.trim();\n        csvContent += \'\\"\' + time + \'\\",\\"\' + user + \'\\",\\"\' + eventType + \'\\",\\"\' + details.replace(/\\"/g, \'\\"\\"\') + \'\\"\\n\';\n      }\n    }\n    \n    // Download CSV\n    const timestamp = new Date().toISOString().slice(0, 10);\n    const filename = \'audit-log-\' + timestamp + \'.csv\';\n    const blob = new Blob([csvContent], { type: \'text/csv\' });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement(\'a\');\n    a.href = url;\n    a.download = filename;\n    a.click();\n    URL.revokeObjectURL(url);\n    \n    showToast(\'Exported \' + (rows.length - 1) + \' audit entries\', \'success\');\n  } catch(e) {\n    showToast(\\\'Error exporting audit log: \\\' + e.message, \\\'error\\\');\n  }\n}\n\n\n/* ═══ PERSONA MANAGEMENT ═══ */\nvar _personasCache = [];\nvar _allNavItems = [\n  { id: \\\'overview\\\', label: \\\'Overview\\\' },\n  { id: \\\'run-agent\\\', label: \\\'Run Agent\\\' },\n  { id: \\\'agent-builder\\\', label: \\\'Agent Builder\\\' },\n  { id: \\\'agent-hub\\\', label: \\\'Agent Hub\\\' },\n  { id: \\\'agents\\\', label: \\\'Agents\\\' },\n  { id: \\\'skills\\\', label: \\\'Skills\\\' },\n  { id: \\\'prompts\\\', label: \\\'Prompts\\\' },\n  { id: \\\'tools\\\', label: \\\'Tools\\\' },\n  { id: \\\'ai-studio\\\', label: \\\'AI Studio\\\' },\n  { id: \\\'documents\\\', label: \\\'Documents\\\' },\n  { id: \\\'data-ingestion\\\', label: \\\'Data Ingestion\\\' },\n  { id: \\\'workflows\\\', label: \\\'Workflows\\\' },\n  { id: \\\'a2a\\\', label: \\\'A2A Protocol\\\' },\n  { id: \\\'mcp\\\', label: \\\'MCP Protocol\\\' },\n  { id: \\\'rest\\\', label: \\\'REST Protocol\\\' },\n  { id: \\\'intelligence-hub\\\', label: \\\'Intelligence Hub\\\' },\n  { id: \\\'llm-activity\\\', label: \\\'LLM Activity\\\' },\n  { id: \\\'traceability\\\', label: \\\'Traceability\\\' },\n  { id: \\\'evaluation\\\', label: \\\'Evaluation\\\' },\n  { id: \\\'observability\\\', label: \\\'Observability\\\' },\n  { id: \\\'guardrails\\\', label: \\\'Guardrails\\\' },\n  { id: \\\'marketplace\\\', label: \\\'Marketplace\\\' },\n  { id: \\\'docs\\\', label: \\\'Docs\\\' },\n  { id: \\\'admin\\\', label: \\\'Admin Plane\\\' }\n];\nvar _allActions = [\n  { id: \\\'create_agents\\\', label: \\\'Create Agents\\\' },\n  { id: \\\'run_agents\\\', label: \\\'Run Agents\\\' },\n  { id: \\\'manage_tools\\\', label: \\\'Manage Tools\\\' },\n  { id: \\\'manage_users\\\', label: \\\'Manage Users\\\' },\n  { id: \\\'access_admin\\\', label: \\\'Access Admin\\\' },\n  { id: \\\'view_observability\\\', label: \\\'View Observability\\\' },\n  { id: \\\'ingest_data\\\', label: \\\'Ingest Data\\\' },\n  { id: \\\'manage_workflows\\\', label: \\\'Manage Workflows\\\' },\n  { id: \\\'access_protocols\\\', label: \\\'Access Protocols\\\' },\n  { id: \\\'manage_guardrails\\\', label: \\\'Manage Guardrails\\\' },\n  { id: \\\'create_global\\\', label: \\\'Create Global Resources\\\' }\n];\n\nasync function loadPersonas() {\n  try {\n    var r = await fetch(\'/api/personas\');\n    var data = await r.json();\n    _personasCache = data.personas || [];\n    renderPersonasGrid(_personasCache);\n  } catch(e) { document.getElementById(\'personas-grid\').innerHTML = \'<p style=\\"color:var(--danger)\\">Failed to load personas</p>\'; }\n}\n\nfunction renderPersonasGrid(personas) {\n  var grid = document.getElementById(\'personas-grid\');\n  if (!personas.length) { grid.innerHTML = \'<p style=\\"color:var(--text-3)\\">No personas defined.</p>\'; return; }\n  grid.innerHTML = personas.map(function(p) {\n    var navCount = (p.permissions && p.permissions.nav) ? p.permissions.nav.length : 0;\n    var actionCount = (p.permissions && p.permissions.actions) ? p.permissions.actions.length : 0;\n    var systemBadge = p.is_system ? \'<span style=\\"font-size:0.58rem;padding:2px 6px;border-radius:4px;background:rgba(139,92,246,0.12);color:#a78bfa;font-weight:600;margin-left:6px\\">SYSTEM</span>\' : \'\';\n    var editBtn = \'<button class=\\"btn btn-sm\\" onclick=\\"showEditPersonaModal(&#39;\' + p.id + \'&#39;)\\" style=\\"font-size:0.66rem;padding:3px 8px\\">Edit</button>\';\n    var deleteBtn = p.is_system ? \'\' : \'<button class=\\"btn btn-sm\\" onclick=\\"deletePersona(&#39;\' + p.id + \'&#39;,&#39;\' + escapeHtml(p.name) + \'&#39;)\\" style=\\"font-size:0.66rem;padding:3px 8px;color:var(--danger)\\">Delete</button>\';\n    var navTags = (p.permissions && p.permissions.nav || []).slice(0, 6).map(function(n) {\n      return \'<span style=\\"display:inline-block;padding:2px 6px;border-radius:4px;font-size:0.6rem;background:rgba(6,182,212,0.08);color:var(--accent-text);border:1px solid rgba(6,182,212,0.15);margin:1px\\">\' + escapeHtml(n) + \'</span>\';\n    }).join(\\\'\\\');\n    var moreNav = navCount > 6 ? \'<span style=\\"font-size:0.6rem;color:var(--text-3)\\">+\' + (navCount - 6) + \' more</span>\' : \'\';\n    return \'<div style=\\"padding:1rem;border-radius:12px;border:1px solid var(--glass-border);background:var(--glass-bg)\\">\'\n      + \'<div style=\\"display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:0.5rem\\">\'\n      + \'<div><div style=\\"font-weight:700;font-size:0.88rem;color:var(--text-1)\\">\' + escapeHtml(p.name) + systemBadge + \'</div>\'\n      + \'<div style=\\"font-size:0.7rem;color:var(--text-3);margin-top:2px\\">\' + escapeHtml(p.description) + \'</div></div>\'\n      + \'<div style=\\"display:flex;gap:4px\\">\' + editBtn + deleteBtn + \'</div></div>\'\n      + \'<div style=\\"display:flex;gap:1rem;margin:0.5rem 0\\">\'\n      + \'<div style=\\"font-size:0.65rem;color:var(--text-3)\\"><strong style=\\"color:var(--text-2)\\">\' + navCount + \'</strong> nav items</div>\'\n      + \'<div style=\\"font-size:0.65rem;color:var(--text-3)\\"><strong style=\\"color:var(--text-2)\\">\' + actionCount + \'</strong> actions</div></div>\'\n      + \'<div style=\\"display:flex;flex-wrap:wrap;gap:2px;margin-top:0.4rem\\">\' + navTags + moreNav + \'</div>\'\n      + \\\'</div>\\\';\n  }).join(\\\'\\\');\n}\n\nfunction showCreatePersonaModal() {\n  _showPersonaModal(null);\n}\nfunction showEditPersonaModal(personaId) {\n  var p = _personasCache.find(function(x) { return x.id === personaId; });\n  if (!p) return;\n  _showPersonaModal(p);\n}\n\nfunction _showPersonaModal(persona) {\n  var isEdit = !!persona;\n  var title = isEdit ? \'Edit Persona\' : \'Create Persona\';\n  var currentNav = (persona && persona.permissions && persona.permissions.nav) || [];\n  var currentActions = (persona && persona.permissions && persona.permissions.actions) || [];\n  var overlay = document.createElement(\'div\');\n  overlay.id = \\\'persona-modal-overlay\\\';\n  overlay.style.cssText = \\\'position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;background:var(--modal-overlay);backdrop-filter:blur(6px)\\\';\n  overlay.onclick = function(e) { if (e.target === overlay) overlay.remove(); };\n  var navChecks = _allNavItems.map(function(n) {\n    var checked = currentNav.indexOf(n.id) >= 0 ? \' checked\' : \'\';\n    return \'<label style=\\"display:flex;align-items:center;gap:6px;font-size:0.72rem;color:var(--text-2);cursor:pointer;padding:3px 0\\"><input type=\\"checkbox\\" class=\\"persona-nav-check\\" value=\\"\' + n.id + \'\\"\' + checked + \' style=\\"accent-color:var(--accent)\\"> \' + escapeHtml(n.label) + \'</label>\';\n  }).join(\\\'\\\');\n  var actionChecks = _allActions.map(function(a) {\n    var checked = currentActions.indexOf(a.id) >= 0 ? \' checked\' : \'\';\n    return \'<label style=\\"display:flex;align-items:center;gap:6px;font-size:0.72rem;color:var(--text-2);cursor:pointer;padding:3px 0\\"><input type=\\"checkbox\\" class=\\"persona-action-check\\" value=\\"\' + a.id + \'\\"\' + checked + \' style=\\"accent-color:var(--accent)\\"> \' + escapeHtml(a.label) + \'</label>\';\n  }).join(\\\'\\\');\n  overlay.innerHTML = \'<div style=\\"width:560px;max-height:85vh;overflow-y:auto;padding:28px 32px;background:var(--modal-bg);border:1px solid var(--modal-border);border-radius:16px;box-shadow:var(--modal-shadow)\\">\'\n    + \'<div style=\\"display:flex;justify-content:space-between;align-items:center;margin-bottom:20px\\"><h3 style=\\"margin:0;font-size:1.05rem;font-weight:700;color:var(--text-1)\\">\' + title + \'</h3><button onclick=\\"document.getElementById(&#39;persona-modal-overlay&#39;).remove()\\" style=\\"border:none;background:transparent;cursor:pointer;color:var(--text-3);font-size:1.3rem;line-height:1;padding:4px\\">&times;</button></div>\'\n    + \'<div style=\\"display:flex;flex-direction:column;gap:14px\\">\'\n    + \'<div><label style=\\"font-size:0.68rem;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em;display:block;margin-bottom:6px\\">Name *</label><input type=\\"text\\" id=\\"persona-name\\" class=\\"input\\" value=\\"\' + escapeHtml(persona ? persona.name : \'\') + \'\\" placeholder=\\"e.g. Data Engineer\\" style=\\"width:100%;padding:10px 14px;border-radius:10px;background:var(--modal-field-bg);border:1px solid var(--modal-border);color:var(--text-1);box-sizing:border-box\\"></div>\'\n    + \'<div><label style=\\"font-size:0.68rem;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em;display:block;margin-bottom:6px\\">Description</label><input type=\\"text\\" id=\\"persona-description\\" class=\\"input\\" value=\\"\' + escapeHtml(persona ? persona.description : \'\') + \'\\" placeholder=\\"Brief description of this persona\\" style=\\"width:100%;padding:10px 14px;border-radius:10px;background:var(--modal-field-bg);border:1px solid var(--modal-border);color:var(--text-1);box-sizing:border-box\\"></div>\'\n    + \'<div><label style=\\"font-size:0.68rem;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em;display:block;margin-bottom:6px\\">Navigation Items</label>\'\n    + \'<div style=\\"display:flex;gap:6px;margin-bottom:8px\\"><button class=\\"btn btn-sm\\" onclick=\\"toggleAllChecks(&#39;persona-nav-check&#39;,true)\\" style=\\"font-size:0.62rem;padding:2px 8px\\">Select All</button><button class=\\"btn btn-sm\\" onclick=\\"toggleAllChecks(&#39;persona-nav-check&#39;,false)\\" style=\\"font-size:0.62rem;padding:2px 8px\\">Clear All</button></div>\'\n    + \'<div style=\\"display:grid;grid-template-columns:1fr 1fr;gap:0 16px;padding:10px 14px;border-radius:10px;background:var(--modal-field-bg);border:1px solid var(--modal-border);max-height:200px;overflow-y:auto\\">\' + navChecks + \'</div></div>\'\n    + \'<div><label style=\\"font-size:0.68rem;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em;display:block;margin-bottom:6px\\">Allowed Actions</label>\'\n    + \'<div style=\\"display:flex;gap:6px;margin-bottom:8px\\"><button class=\\"btn btn-sm\\" onclick=\\"toggleAllChecks(&#39;persona-action-check&#39;,true)\\" style=\\"font-size:0.62rem;padding:2px 8px\\">Select All</button><button class=\\"btn btn-sm\\" onclick=\\"toggleAllChecks(&#39;persona-action-check&#39;,false)\\" style=\\"font-size:0.62rem;padding:2px 8px\\">Clear All</button></div>\'\n    + \'<div style=\\"display:grid;grid-template-columns:1fr 1fr;gap:0 16px;padding:10px 14px;border-radius:10px;background:var(--modal-field-bg);border:1px solid var(--modal-border)\\">\' + actionChecks + \'</div></div>\'\n    + \'<div id=\\"persona-modal-error\\" style=\\"display:none;color:var(--danger);font-size:0.75rem;text-align:center;padding:10px 14px;background:var(--danger-bg);border:1px solid var(--danger-border);border-radius:10px\\"></div>\'\n    + \'<div style=\\"display:flex;gap:8px;margin-top:4px\\"><button class=\\"btn btn-primary\\" onclick=\\"savePersona(\' + (isEdit ? \\"&#39;\\" + persona.id + \\"&#39;\\" : \'null\') + \')\\" style=\\"flex:1;padding:11px;border-radius:10px;font-weight:600\\">\' + (isEdit ? \'Save Changes\' : \'Create Persona\') + \'</button><button class=\\"btn btn-secondary\\" onclick=\\"document.getElementById(&#39;persona-modal-overlay&#39;).remove()\\" style=\\"flex:1;padding:11px;border-radius:10px\\">Cancel</button></div>\'\n    + \\\'</div></div>\\\';\n  document.body.appendChild(overlay);\n  document.getElementById(\\\'persona-name\\\').focus();\n}\n\nfunction toggleAllChecks(className, checked) {\n  document.querySelectorAll(\'.\' + className).forEach(function(cb) { cb.checked = checked; });\n}\n\nasync function savePersona(personaId) {\n  var errEl = document.getElementById(\'persona-modal-error\');\n  var name = document.getElementById(\'persona-name\').value.trim();\n  var description = document.getElementById(\'persona-description\').value.trim();\n  if (!name) { errEl.style.display = \\\'block\\\'; errEl.textContent = \\\'Name is required\\\'; return; }\n  var nav = []; document.querySelectorAll(\'.persona-nav-check:checked\').forEach(function(cb) { nav.push(cb.value); });\n  var actions = []; document.querySelectorAll(\'.persona-action-check:checked\').forEach(function(cb) { actions.push(cb.value); });\n  var body = { name: name, description: description, permissions: { nav: nav, actions: actions } };\n  var url = personaId ? \'/api/personas/\' + personaId : \'/api/personas\';\n  var method = personaId ? \'PUT\' : \'POST\';\n  try {\n    var r = await fetch(url, { method: method, headers: { \'Content-Type\': \'application/json\' }, body: JSON.stringify(body) });\n    if (!r.ok) { var d = await r.json(); errEl.style.display = \'block\'; errEl.textContent = d.error || \'Failed to save persona\'; return; }\n    var el = document.getElementById(\'persona-modal-overlay\');\n    if (el) el.remove();\n    showToast(personaId ? \\\'Persona updated\\\' : \\\'Persona created\\\', \\\'success\\\');\n    loadPersonas();\n  } catch(e) { errEl.style.display = \\\'block\\\'; errEl.textContent = \\\'Error: \\\' + e.message; }\n}\n\nasync function deletePersona(personaId, name) {\n  if (!confirm(\'Delete persona \\"\' + name + \'\\"? Users with this persona will lose it.\')) return;\n  try {\n    var r = await fetch(\'/api/personas/\' + personaId, { method: \'DELETE\' });\n    if (!r.ok) { var d = await r.json(); showToast(d.error || \'Cannot delete persona\', \'error\'); return; }\n    showToast(\'Persona \\"\' + name + \'\\" deleted\', \'success\');\n    loadPersonas();\n    loadUserPersonaAssignments();\n  } catch(e) { showToast(\\\'Error: \\\' + e.message, \\\'error\\\'); }\n}\n\n/* ═══ USER PERSONA ASSIGNMENTS ═══ */\nasync function loadUserPersonaAssignments() {\n  var container = document.getElementById(\'user-persona-assignments\');\n  try {\n    var [ur, pr] = await Promise.all([fetch(\'/api/users\'), fetch(\'/api/personas\')]);\n    var users = (await ur.json()).users || [];\n    var personas = (await pr.json()).personas || [];\n    if (!users.length) { container.innerHTML = \'<p style=\\"color:var(--text-3)\\">No users found.</p>\'; return; }\n    var html = \'<div style=\\"overflow-x:auto\\"><table style=\\"width:100%;border-collapse:collapse\\">\'\n      + \'<thead><tr style=\\"border-bottom:2px solid var(--glass-border)\\">\'\n      + \'<th style=\\"text-align:left;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600\\">User</th>\'\n      + \'<th style=\\"text-align:left;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600\\">Assigned Personas</th>\'\n      + \'<th style=\\"text-align:right;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600\\">Actions</th>\'\n      + \\\'</tr></thead><tbody>\\\';\n    users.forEach(function(u) {\n      var userPersonas = u.personas || [];\n      var chips = userPersonas.map(function(p) {\n        return \'<span style=\\"display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:99px;font-size:0.68rem;font-weight:500;background:rgba(6,182,212,0.08);color:var(--accent-text);border:1px solid rgba(6,182,212,0.15)\\">\'\n          + escapeHtml(p.name)\n          + \'<button onclick=\\"removePersonaFromUser(&#39;\' + u.id + \'&#39;,&#39;\' + p.id + \'&#39;)\\" style=\\"border:none;background:none;cursor:pointer;color:var(--text-3);font-size:0.75rem;padding:0 2px;line-height:1\\" title=\\"Remove\\">&times;</button>\'\n          + \\\'</span>\\\';\n      }).join(\\\' \\\');\n      if (!chips) chips = \'<span style=\\"font-size:0.7rem;color:var(--text-3);opacity:0.5\\">None</span>\';\n      var options = personas.filter(function(p) {\n        return !userPersonas.some(function(up) { return up.id === p.id; });\n      }).map(function(p) {\n        return \'<option value=\\"\' + p.id + \'\\">\' + escapeHtml(p.name) + \'</option>\';\n      }).join(\\\'\\\');\n      var addSelect = options ? \'<select id=\\"add-persona-\' + u.id + \'\\" class=\\"input\\" style=\\"font-size:0.72rem;padding:3px 8px;min-width:100px\\"><option value=\\"\\">Add...</option>\' + options + \'</select>\'\n        + \'<button class=\\"btn btn-sm\\" onclick=\\"addPersonaToUser(&#39;\' + u.id + \'&#39;)\\" style=\\"font-size:0.62rem;padding:3px 6px\\">+</button>\' : \'\';\n      html += \'<tr style=\\"border-bottom:1px solid var(--glass-border)\\">\'\n        + \'<td style=\\"padding:10px 12px\\"><div style=\\"font-weight:600;font-size:0.82rem;color:var(--text-1)\\">\' + escapeHtml(u.display_name || u.username) + \'</div><div style=\\"font-size:0.68rem;color:var(--text-3)\\">@\' + escapeHtml(u.username) + \'</div></td>\'\n        + \'<td style=\\"padding:10px 12px\\"><div style=\\"display:flex;flex-wrap:wrap;gap:4px;align-items:center\\">\' + chips + \'</div></td>\'\n        + \'<td style=\\"padding:10px 12px;text-align:right\\"><div style=\\"display:flex;gap:4px;justify-content:flex-end;align-items:center\\">\' + addSelect + \'</div></td>\'\n        + \\\'</tr>\\\';\n    });\n    html += \\\'</tbody></table></div>\\\';\n    container.innerHTML = html;\n  } catch(e) { container.innerHTML = \'<p style=\\"color:var(--danger)\\">Failed to load: \' + escapeHtml(e.message) + \'</p>\'; }\n}\n\nasync function addPersonaToUser(userId) {\n  var sel = document.getElementById(\'add-persona-\' + userId);\n  if (!sel || !sel.value) return;\n  try {\n    var r = await fetch(\'/api/users/\' + userId + \'/personas\', {\n      method: \\\'POST\\\',\n      headers: { \\\'Content-Type\\\': \\\'application/json\\\' },\n      body: JSON.stringify({ persona_id: sel.value })\n    });\n    if (!r.ok) { var d = await r.json(); showToast(d.error || \'Failed to assign\', \'error\'); return; }\n    showToast(\\\'Persona assigned\\\', \\\'success\\\');\n    loadUserPersonaAssignments();\n  } catch(e) { showToast(\\\'Error: \\\' + e.message, \\\'error\\\'); }\n}\n\nasync function removePersonaFromUser(userId, personaId) {\n  try {\n    var r = await fetch(\'/api/users/\' + userId + \'/personas/\' + personaId, { method: \'DELETE\' });\n    if (!r.ok) { showToast(\\\'Failed to remove persona\\\', \\\'error\\\'); return; }\n    showToast(\\\'Persona removed\\\', \\\'success\\\');\n    loadUserPersonaAssignments();\n  } catch(e) { showToast(\\\'Error: \\\' + e.message, \\\'error\\\'); }\n}\n\n/* ═══ INIT ═══ */\nadminLoadAll();\n\n<\\/script>\n\' }) %>\n\n// Config subtab switching\nfunction switchConfigTab(tabName) {\n  document.querySelectorAll(\'[id^=\\"config-\\"]\').forEach(function(el) { el.style.display = \'none\'; });\n  var tab = document.getElementById(\'config-\' + tabName);\n  if (tab) tab.style.display = \'block\';\n  document.querySelectorAll(\'#subtabs-config .admin-subtab\').forEach(function(el) { el.classList.remove(\'active\'); });\n  var btn = document.querySelector(\'#subtabs-config [data-tab=\\"config-\' + tabName + \'\\"]\');\n  if (btn) btn.classList.add(\'active\');\n}\n\n/* Attach click handlers to config subtabs */\ndocument.querySelectorAll(\'#subtabs-config .admin-subtab\').forEach(function(btn) {\n  btn.addEventListener(\'click\', function() {\n    var tabName = this.getAttribute(\'data-tab\').replace(\'config-\', \'\');\n    switchConfigTab(tabName);\n  });\n});\n\n// ────────────────────────────────────────────────────────\n// COMPLIANCE & ETHICS MANAGEMENT\n// ────────────────────────────────────────────────────────\n\n// ── UI/UX SETTINGS ────────────────────────────────────────\nfunction loadUISettings() {\n  try {\n    // Gate is DISABLED by default - only enabled if explicitly set to \'true\'\n    const gateEnabled = localStorage.getItem(\'agentic_intro_gate_enabled\') === \'true\';\n    document.getElementById(\'intro-gate-toggle\').checked = gateEnabled;\n    document.getElementById(\'intro-gate-status\').textContent = gateEnabled ? \'Enabled\' : \'Disabled (Default)\';\n  } catch(e) {\n    console.error(\'Error loading UI settings:\', e);\n  }\n}\n\nfunction saveUISettings() {\n  try {\n    const isEnabled = document.getElementById(\'intro-gate-toggle\').checked;\n    localStorage.setItem(\'agentic_intro_gate_enabled\', isEnabled ? \'true\' : \'false\');\n    document.getElementById(\'intro-gate-status\').textContent = isEnabled ? \'Enabled\' : \'Disabled (Default)\';\n    showToast(isEnabled ? \'Intro gate animation enabled\' : \'Intro gate animation disabled\', \'success\');\n  } catch(e) {\n    showToast(\'Error saving UI settings: \' + e.message, \'error\');\n  }\n}\n\nasync function loadComplianceSettings() {\n  try {\n    const response = await fetch(\'/api/admin/compliance/config\');\n    const data = await response.json();\n    const config = data.config || {};\n\n    // Update UI with current settings\n    document.getElementById(\'enable-compliance\').checked = config.enableCompliance !== false;\n    document.getElementById(\'enable-audit\').checked = config.enableAudit !== false;\n    document.getElementById(\'enable-pii-filter\').checked = config.enablePIIFilter !== false;\n    document.getElementById(\'enable-harmful-content\').checked = config.enableHarmfulContent !== false;\n    document.getElementById(\'enable-profanity\').checked = config.enableProfanity !== false;\n    document.getElementById(\'enable-rate-limit\').checked = config.enableRateLimit !== false;\n    document.getElementById(\'compliance-level\').value = config.complianceLevel || \'medium\';\n    document.getElementById(\'ethical-guidelines\').value = config.ethicalGuidelines || \'\';\n    document.getElementById(\'active-compliance-level\').textContent = (config.complianceLevel || \'medium\').charAt(0).toUpperCase() + (config.complianceLevel || \'medium\').slice(1);\n\n    // Update compliance level selector styling\n    document.querySelectorAll(\'[data-level]\').forEach(function(el) {\n      const isActive = el.getAttribute(\'data-level\') === (config.complianceLevel || \'medium\');\n      el.style.borderColor = isActive ? \'rgba(59, 130, 246, 0.7)\' : \'transparent\';\n      el.style.background = isActive ? \'linear-gradient(135deg,rgba(14,165,233,0.1),rgba(59,130,246,0.05))\' : \'var(--input-bg)\';\n    });\n\n    updateFilterCount();\n\n  } catch (error) {\n    console.error(\'Error loading compliance settings:\', error);\n  }\n}\n\nfunction updateFilterCount() {\n  const filters = [\n    document.getElementById(\'enable-compliance\').checked,\n    document.getElementById(\'enable-audit\').checked,\n    document.getElementById(\'enable-pii-filter\').checked,\n    document.getElementById(\'enable-harmful-content\').checked,\n    document.getElementById(\'enable-profanity\').checked,\n    document.getElementById(\'enable-rate-limit\').checked\n  ];\n  const activeCount = filters.filter(f => f).length;\n  document.getElementById(\'active-filters-count\').textContent = activeCount;\n  \n  const statusBadge = document.getElementById(\'compliance-status-badge\');\n  if (document.getElementById(\'enable-compliance\').checked) {\n    statusBadge.textContent = \'Enabled\';\n    statusBadge.style.background = \'rgba(16,185,129,0.2)\';\n    statusBadge.style.color = \'#10b981\';\n  } else {\n    statusBadge.textContent = \'Disabled\';\n    statusBadge.style.background = \'rgba(107,114,128,0.2)\';\n    statusBadge.style.color = \'#6b7280\';\n  }\n}\n\nfunction selectComplianceLevel(level) {\n  document.getElementById(\'compliance-level\').value = level;\n  document.getElementById(\'active-compliance-level\').textContent = level.charAt(0).toUpperCase() + level.slice(1);\n  \n  // Update visual state\n  document.querySelectorAll(\'[data-level]\').forEach(function(el) {\n    const isActive = el.getAttribute(\'data-level\') === level;\n    el.style.borderColor = isActive ? \'rgba(59, 130, 246, 0.7)\' : \'transparent\';\n    el.style.background = isActive ? \'linear-gradient(135deg,rgba(14,165,233,0.1),rgba(59,130,246,0.05))\' : \'var(--input-bg)\';\n  });\n}\n\nasync function saveComplianceSettings() {\n  try {\n    const settings = {\n      enableCompliance: document.getElementById(\'enable-compliance\').checked,\n      enableAudit: document.getElementById(\'enable-audit\').checked,\n      enablePIIFilter: document.getElementById(\'enable-pii-filter\').checked,\n      enableHarmfulContent: document.getElementById(\'enable-harmful-content\').checked,\n      enableProfanity: document.getElementById(\'enable-profanity\').checked,\n      enableRateLimit: document.getElementById(\'enable-rate-limit\').checked,\n      complianceLevel: document.getElementById(\'compliance-level\').value,\n      ethicalGuidelines: document.getElementById(\'ethical-guidelines\').value\n    };\n\n    const response = await fetch(\'/api/admin/compliance/config\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify(settings)\n    });\n\n    if (response.ok) {\n      showNotification(\'Compliance settings saved successfully\', \'success\');\n    } else {\n      throw new Error(\'Failed to save settings\');\n    }\n  } catch (error) {\n    console.error(\'Error saving compliance settings:\', error);\n    showNotification(\'Error saving settings: \' + error.message, \'error\');\n  }\n}\n\nfunction resetComplianceSettings() {\n  if (confirm(\'Reset all compliance settings to defaults?\')) {\n    document.getElementById(\'enable-compliance\').checked = true;\n    document.getElementById(\'enable-audit\').checked = true;\n    document.getElementById(\'enable-pii-filter\').checked = true;\n    document.getElementById(\'enable-harmful-content\').checked = true;\n    document.getElementById(\'enable-profanity\').checked = true;\n    document.getElementById(\'enable-rate-limit\').checked = true;\n    selectComplianceLevel(\'medium\');\n    document.getElementById(\'ethical-guidelines\').value = \'\';\n    saveComplianceSettings();\n  }\n}\n\nfunction showCompliancePreview() {\n  const settings = {\n    enableCompliance: document.getElementById(\'enable-compliance\').checked,\n    enableAudit: document.getElementById(\'enable-audit\').checked,\n    enablePIIFilter: document.getElementById(\'enable-pii-filter\').checked,\n    enableHarmfulContent: document.getElementById(\'enable-harmful-content\').checked,\n    enableProfanity: document.getElementById(\'enable-profanity\').checked,\n    enableRateLimit: document.getElementById(\'enable-rate-limit\').checked,\n    complianceLevel: document.getElementById(\'compliance-level\').value,\n    ethicalGuidelines: document.getElementById(\'ethical-guidelines\').value\n  };\n\n  const preview = \'Compliance Configuration:\\n\\n\' +\n    \'Level: \' + settings.complianceLevel.toUpperCase() + \'\\n\' +\n    \'Status: \' + (settings.enableCompliance ? \'ENABLED\' : \'DISABLED\') + \'\\n\\n\' +\n    \'Active Filters:\\n\' +\n    (settings.enableAudit ? \'Audit Logging\\n\' : \'\') +\n    (settings.enablePIIFilter ? \'PII Filtering\\n\' : \'\') +\n    (settings.enableHarmfulContent ? \'Harmful Content Blocking\\n\' : \'\') +\n    (settings.enableProfanity ? \'Profanity Filtering\\n\' : \'\') +\n    (settings.enableRateLimit ? \'Rate Limiting\\n\' : \'\') +\n    \'\\nEthical Guidelines:\\n\' + (settings.ethicalGuidelines || \'(Using defaults)\');\n\n  alert(preview);\n}\n\n// ── Secret Scan Functions ─────────────────────────────\nasync function runSecretScan() {\n  const scanPath = document.getElementById(\'scan-path-input\').value || \'/app\';\n  const format = document.getElementById(\'scan-format-select\').value || \'json\';\n  const btn = document.getElementById(\'secret-scan-btn\');\n  const btnText = document.getElementById(\'scan-btn-text\');\n  const spinner = document.getElementById(\'scan-btn-spinner\');\n  \n  try {\n    btn.disabled = true;\n    btnText.textContent = \'Scanning...\';\n    spinner.style.display = \'inline-block\';\n    \n    const response = await fetch(\'/api/admin/secret-scan\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify({ scanPath, format })\n    });\n    \n    if (!response.ok) {\n      const error = await response.json();\n      throw new Error(error.error || \'Scan failed\');\n    }\n    \n    const result = await response.json();\n    displaySecretScanResults(result);\n    \n  } catch (error) {\n    alert(\'Secret scan error: \' + error.message);\n  } finally {\n    btn.disabled = false;\n    btnText.textContent = \'🔍 Run Secret Scan\';\n    spinner.style.display = \'none\';\n  }\n}\n\nfunction displaySecretScanResults(result) {\n  document.getElementById(\'secret-scan-empty\').style.display = \'none\';\n  document.getElementById(\'secret-scan-results\').style.display = \'block\';\n  document.getElementById(\'export-secret-btn\').style.display = \'inline-block\';\n  \n  // Update metadata\n  const timestamp = new Date(result.timestamp).toLocaleString();\n  document.getElementById(\'scan-result-info\').textContent = \'Scanned at \' + timestamp + \' • Path: \' + result.scanPath;\n  document.getElementById(\'scan-timestamp\').textContent = new Date(result.timestamp).toLocaleTimeString();\n  \n  let secretsData = [];\n  \n  // Parse results\n  if (result.results) {\n    if (typeof result.results === \'string\') {\n      try {\n        secretsData = JSON.parse(result.results);\n      } catch {\n        document.getElementById(\'raw-output-container\').style.display = \'block\';\n        document.getElementById(\'raw-output\').textContent = result.results;\n        document.getElementById(\'secrets-found-count\').textContent = \'?\';\n        document.getElementById(\'scan-severity-high\').textContent = \'?\';\n        return;\n      }\n    } else if (Array.isArray(result.results)) {\n      secretsData = result.results;\n    } else if (result.results.matches) {\n      secretsData = result.results.matches;\n    } else if (typeof result.results === \'object\') {\n      secretsData = [result.results];\n    }\n  }\n  \n  // Calculate severity breakdown\n  let highCount = 0, mediumCount = 0, lowCount = 0;\n  secretsData.forEach(s => {\n    const sev = (s.Severity || s.severity || \'MEDIUM\').toUpperCase();\n    if (sev === \'HIGH\') highCount++;\n    else if (sev === \'MEDIUM\') mediumCount++;\n    else lowCount++;\n  });\n  \n  // Update summary counts\n  document.getElementById(\'secrets-found-count\').textContent = secretsData.length;\n  document.getElementById(\'scan-severity-high\').textContent = highCount;\n  \n  if (secretsData.length === 0) {\n    const tbody = document.getElementById(\'secrets-table-body\');\n    tbody.innerHTML = \'<tr style=\\"border-bottom:1px solid var(--divider)\\"><td colspan=\\"6\\" style=\\"padding:2rem;text-align:center;color:var(--success)\\">No secrets detected</td></tr>\';\n    return;\n  }\n  \n  // Build detailed results display\n  const tbody = document.getElementById(\'secrets-table-body\');\n  tbody.innerHTML = \'\';\n  \n  secretsData.forEach((secret, idx) => {\n    const sev = (secret.Severity || secret.severity || \'MEDIUM\').toUpperCase();\n    const ruleId = secret.RuleID || secret.Rule || secret.Type || \'Unknown\';\n    const ruleTitle = secret.RuleTitle || \'Secret Detected\';\n    const filePath = secret.File || secret.file || \'Unknown\';\n    const lineNum = secret.StartLine || secret.LineNumber || secret.line || \'N/A\';\n    const match = secret.Match || secret.Secret || secret.secret || \'(redacted)\';\n    \n    // Secret type descriptions and remediation\n    const secretTypes = {\n      \'aws-api-key\': { desc: \'AWS Access Key ID\', risk: \'Can be used to access AWS resources\', fix: \'Rotate the AWS access key immediately\' },\n      \'github-token\': { desc: \'GitHub Personal Access Token\', risk: \'Can be used to access private GitHub repositories\', fix: \'Revoke the token in GitHub settings\' },\n      \'slack-token\': { desc: \'Slack API Token\', risk: \'Can be used to send messages and access workspace\', fix: \'Regenerate the token in Slack admin panel\' },\n      \'stripe-key\': { desc: \'Stripe API Key\', risk: \'Can be used to access payment information\', fix: \'Rotate the key in Stripe dashboard\' },\n      \'private-key\': { desc: \'Private SSH/RSA Key\', risk: \'Can be used for unauthorized access\', fix: \'Revoke and generate new key pair\' },\n      \'database-password\': { desc: \'Database Password\', risk: \'Unauthorized database access\', fix: \'Change password immediately\' },\n      \'api-key\': { desc: \'Generic API Key\', risk: \'Unauthorized API access\', fix: \'Regenerate the key in service dashboard\' },\n      \'oauth-token\': { desc: \'OAuth Token\', risk: \'Unauthorized account access\', fix: \'Revoke token in account settings\' }\n    };\n    \n    // Try to identify secret type from rule\n    let typeInfo = secretTypes[ruleId.toLowerCase()] || { \n      desc: ruleTitle, \n      risk: \'This secret was detected and should be treated as compromised\', \n      fix: \'Rotate or revoke this credential immediately\' \n    };\n    \n    const row = tbody.insertRow();\n    row.style.borderBottom = \'1px solid var(--divider)\';\n    row.style.display = \'table-row\';\n    \n    // Severity badge\n    const severityCell = row.insertCell(0);\n    const severityColor = sev === \'HIGH\' ? \'#ef4444\' : sev === \'MEDIUM\' ? \'#f59e0b\' : \'#10b981\';\n    severityCell.innerHTML = \'<span style=\\"display:inline-block;padding:0.3rem 0.6rem;border-radius:4px;background:\' + severityColor + \'20;color:\' + severityColor + \';font-weight:600;font-size:0.75rem\\">\' + sev + \'</span>\';\n    severityCell.style.padding = \'1rem 0.75rem\';\n    \n    // Type & Description\n    const typeCell = row.insertCell(1);\n    typeCell.innerHTML = \'<div style=\\"font-weight:600;color:var(--text-1)\\">\' + typeInfo.desc + \'</div><div style=\\"font-size:0.8rem;color:var(--text-3);margin-top:0.25rem\\">\' + typeInfo.risk + \'</div>\';\n    typeCell.style.padding = \'0.75rem\';\n    typeCell.style.minWidth = \'200px\';\n    \n    // Location (file + line)\n    const locationCell = row.insertCell(2);\n    locationCell.innerHTML = \'<div style=\\"font-family:monospace;font-size:0.75rem;color:var(--text-2)\\">\' + filePath + \'</div><div style=\\"font-size:0.75rem;color:var(--text-3);margin-top:0.25rem\\">Line \' + lineNum + \'</div>\';\n    locationCell.style.padding = \'0.75rem\';\n    locationCell.style.fontSize = \'0.75rem\';\n    \n    // Remediation\n    const fixCell = row.insertCell(3);\n    fixCell.innerHTML = \'<div style=\\"font-size:0.8rem;color:var(--text-2);padding:0.5rem;background:rgba(251,146,60,0.1);border-radius:4px;border-left:2px solid #fb923c\\">\' + typeInfo.fix + \'</div>\';\n    fixCell.style.padding = \'0.75rem\';\n    fixCell.style.minWidth = \'220px\';\n    \n    // Matched value (obfuscated)\n    const matchCell = row.insertCell(4);\n    const displayMatch = (match || \'\').substring(0, 15) + (match && match.length > 15 ? \'...\' : \'\');\n    matchCell.innerHTML = \'<span style=\\"font-family:monospace;font-size:0.75rem;color:var(--accent);background:var(--input-bg);padding:0.4rem 0.6rem;border-radius:4px\\">\' + escapeHtml(displayMatch) + \'</span>\';\n    matchCell.style.padding = \'0.75rem\';\n    \n    // Rule ID\n    const ruleCell = row.insertCell(5);\n    ruleCell.textContent = ruleId;\n    ruleCell.style.padding = \'0.75rem\';\n    ruleCell.style.fontSize = \'0.75rem\';\n    ruleCell.style.color = \'var(--text-3)\';\n    \n    // Color background by severity\n    if (sev === \'HIGH\') {\n      row.style.background = \'rgba(239, 68, 68, 0.08)\';\n    } else if (sev === \'MEDIUM\') {\n      row.style.background = \'rgba(251, 191, 36, 0.08)\';\n    } else {\n      row.style.background = \'rgba(34, 197, 94, 0.05)\';\n    }\n  });\n}\n\nfunction exportSecretResults() {\n  const resultsHtml = document.getElementById(\'secret-scan-results\').innerHTML;\n  const timestamp = new Date().toISOString().slice(0, 10);\n  const filename = \'secret-scan-\' + timestamp + \'.html\';\n  \n  const html = \'<!DOCTYPE html>\\n\' +\n    \'<html>\\n\' +\n    \'<head>\\n\' +\n    \'<title>Secret Scan Report - \' + timestamp + \'</title>\\n\' +\n    \'<style>\\n\' +\n    \'body { font-family: monospace; background: #0a0a0f; color: #d1d5db; margin: 2rem; }\\n\' +\n    \'h1 { color: #10b981; border-bottom: 2px solid #10b981; padding-bottom: 1rem; }\\n\' +\n    \'table { border-collapse: collapse; width: 100%; margin-top: 1rem; }\\n\' +\n    \'th { background: rgba(0,0,0,0.5); padding: 0.75rem; text-align: left; border-bottom: 2px solid #10b981; }\\n\' +\n    \'td { padding: 0.75rem; border-bottom: 1px solid #333; }\\n\' +\n    \'.high { background: rgba(239, 68, 68, 0.1); }\\n\' +\n    \'.timestamp { color: #888; font-size: 0.9rem; }\\n\' +\n    \'</style>\\n\' +\n    \'</head>\\n\' +\n    \'<body>\\n\' +\n    \'<h1>Secret Scan Report</h1>\\n\' +\n    \'<p class=\\"timestamp\\">Generated: \' + new Date().toLocaleString() + \'</p>\\n\' +\n    resultsHtml +\n    \'</body>\\n\' +\n    \'</html>\';\n  \n  const blob = new Blob([html], { type: \'text/html\' });\n  const url = URL.createObjectURL(blob);\n  const a = document.createElement(\'a\');\n  a.href = url;\n  a.download = filename;\n  a.click();\n  URL.revokeObjectURL(url);\n}\n\n/* ═══ DOCKER IMAGE MANAGEMENT ═══ */\nvar dockerImagesCache = [];\nvar dockerSecurityCache = {};\n\nasync function loadDockerImages() {\n  const container = document.getElementById(\'docker-images-table\');\n  if (!container) return;\n  container.innerHTML = \'<div style=\\"color:var(--text-3);font-size:0.82rem\\">Loading Docker images...</div>\';\n  \n  try {\n    const response = await fetch(\'/api/admin/docker/images\');\n    if (!response.ok) throw new Error(\'HTTP \' + response.status);\n    const data = await response.json();\n    \n    if (!data.images || data.images.length === 0) {\n      container.innerHTML = \'<p style=\\"color:var(--text-3)\\">No Docker images found. Make sure Docker daemon is running.</p>\';\n      return;\n    }\n    \n    dockerImagesCache = data.images;\n    \n    let html = \'<table style=\\"width:100%;border-collapse:collapse\\"><thead><tr style=\\"border-bottom:2px solid var(--glass-border)\\">\'\n      + \'<th style=\\"text-align:left;padding:0.75rem;color:var(--text-3);font-size:0.7rem\\">Image</th>\'\n      + \'<th style=\\"text-align:left;padding:0.75rem;color:var(--text-3);font-size:0.7rem\\">Tag</th>\'\n      + \'<th style=\\"text-align:center;padding:0.75rem;color:var(--text-3);font-size:0.7rem\\">Size</th>\'\n      + \'<th style=\\"text-align:center;padding:0.75rem;color:var(--text-3);font-size:0.7rem\\">Created</th>\'\n      + \'<th style=\\"text-align:center;padding:0.75rem;color:var(--text-3);font-size:0.7rem\\">Status</th>\'\n      + \'<th style=\\"text-align:right;padding:0.75rem;color:var(--text-3);font-size:0.7rem\\">Actions</th>\'\n      + \'</tr></thead><tbody>\';\n    \n    data.images.forEach(function(img) {\n      const size = img.size ? (img.size / 1024 / 1024).toFixed(1) + \' MB\' : \'N/A\';\n      const created = img.created ? new Date(img.created).toLocaleDateString() : \'Unknown\';\n      const status = img.status || \'ready\';\n      const statusColor = status === \'ready\' ? \'var(--success)\' : status === \'pending\' ? \'var(--warning)\' : \'var(--danger)\';\n      \n      html += \'<tr style=\\"border-bottom:1px solid var(--glass-border)\\">\'\n        + \'<td style=\\"padding:0.75rem;font-family:monospace;font-size:0.75rem;word-break:break-all\\">\' + escapeHtml(img.name || img.repository) + \'</td>\'\n        + \'<td style=\\"padding:0.75rem;font-size:0.75rem\\">\' + escapeHtml(img.tag || \'latest\') + \'</td>\'\n        + \'<td style=\\"padding:0.75rem;text-align:center;font-size:0.75rem\\">\' + size + \'</td>\'\n        + \'<td style=\\"padding:0.75rem;text-align:center;font-size:0.75rem\\">\' + created + \'</td>\'\n        + \'<td style=\\"padding:0.75rem;text-align:center\\"><span style=\\"color:\' + statusColor + \';font-size:0.7rem;font-weight:600;text-transform:uppercase\\">\' + status + \'</span></td>\'\n        + \'<td style=\\"padding:0.75rem;text-align:right\\"><button class=\\"btn btn-sm btn-secondary\\" onclick=\\"scanDockerImage(\\\'\' + escapeHtml(img.name || img.repository) + \'\\\', \\\'\' + escapeHtml(img.tag || \'latest\') + \'\\\')\\">Scan</button></td>\'\n        + \'</tr>\';\n    });\n    \n    html += \'</tbody></table>\';\n    container.innerHTML = html;\n  } catch(e) {\n    container.innerHTML = \'<p style=\\"color:var(--danger)\\">Failed to load images: \' + escapeHtml(e.message) + \'</p>\';\n    console.error(\'Error loading Docker images:\', e);\n  }\n}\n\nasync function loadDockerSecuritySummary() {\n  const container = document.getElementById(\'docker-security-cards\');\n  if (!container) return;\n  \n  try {\n    const response = await fetch(\'/api/admin/docker/security-summary\');\n    if (!response.ok) throw new Error(\'HTTP \' + response.status);\n    const data = await response.json();\n    \n    const summary = data.summary || { total: 0, critical: 0, high: 0, medium: 0, low: 0 };\n    \n    let html = \'<div style=\\"display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem\\">\'\n      + \'<div style=\\"background:rgba(59,130,246,0.08);border:1px solid rgba(59,130,246,0.2);border-radius:8px;padding:1rem\\">\'\n      + \'<div style=\\"color:var(--text-3);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em\\">Total Images</div>\'\n      + \'<div style=\\"font-size:2rem;font-weight:700;color:var(--text-1);margin-top:0.5rem\\">\' + summary.total + \'</div>\'\n      + \'</div>\';\n    \n    if (summary.critical > 0) {\n      html += \'<div style=\\"background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.2);border-radius:8px;padding:1rem\\">\'\n        + \'<div style=\\"color:var(--text-3);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em\\">Critical Issues</div>\'\n        + \'<div style=\\"font-size:2rem;font-weight:700;color:#ef4444;margin-top:0.5rem\\">\' + summary.critical + \'</div>\'\n        + \'</div>\';\n    }\n    \n    if (summary.high > 0) {\n      html += \'<div style=\\"background:rgba(251,191,36,0.08);border:1px solid rgba(251,191,36,0.2);border-radius:8px;padding:1rem\\">\'\n        + \'<div style=\\"color:var(--text-3);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em\\">High Issues</div>\'\n        + \'<div style=\\"font-size:2rem;font-weight:700;color:#fbbf24;margin-top:0.5rem\\">\' + summary.high + \'</div>\'\n        + \'</div>\';\n    }\n    \n    html += \'<div style=\\"background:rgba(34,197,94,0.08);border:1px solid rgba(34,197,94,0.2);border-radius:8px;padding:1rem\\">\'\n      + \'<div style=\\"color:var(--text-3);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em\\">Healthy Images</div>\'\n      + \'<div style=\\"font-size:2rem;font-weight:700;color:#22c55e;margin-top:0.5rem\\">\' + (summary.total - summary.critical - summary.high) + \'</div>\'\n      + \'</div></div>\';\n    \n    container.innerHTML = html;\n    dockerSecurityCache = summary;\n  } catch(e) {\n    console.error(\'Error loading security summary:\', e);\n    container.innerHTML = \'<p style=\\"color:var(--danger)\\">Failed to load security summary</p>\';\n  }\n}\n\nasync function checkDockerUpdates(event) {\n  if (event) event.preventDefault();\n  \n  const btn = event ? event.target.closest(\'button\') : null;\n  if (btn) btn.disabled = true;\n  \n  try {\n    const response = await fetch(\'/api/admin/docker/check-updates\', { method: \'POST\' });\n    const data = await response.json();\n    \n    if (data.updates && data.updates.length > 0) {\n      const container = document.getElementById(\'docker-updates-available\');\n      let html = \'<div class=\\"card\\" style=\\"border-left:4px solid var(--warning)\\">\'\n        + \'<h3 style=\\"margin:0 0 1rem;color:var(--text-1)\\">📦 Updates Available</h3>\'\n        + \'<div style=\\"display:grid;gap:0.5rem\\">\';\n      \n      data.updates.forEach(function(upd) {\n        html += \'<div style=\\"background:rgba(251,191,36,0.08);border:1px solid rgba(251,191,36,0.2);border-radius:6px;padding:0.75rem\\">\'\n          + \'<div style=\\"font-weight:600;color:var(--text-1);font-size:0.9rem\\">\' + escapeHtml(upd.image) + \'</div>\'\n          + \'<div style=\\"font-size:0.8rem;color:var(--text-2);margin-top:0.25rem\\">\'\n          + escapeHtml(upd.current) + \' → \' + escapeHtml(upd.latest)\n          + \'</div>\'\n          + \'</div>\';\n      });\n      \n      html += \'</div></div>\';\n      container.innerHTML = html;\n      container.style.display = \'block\';\n    } else {\n      const container = document.getElementById(\'docker-updates-available\');\n      container.innerHTML = \'<div class=\\"card\\" style=\\"border-left:4px solid var(--success);background:rgba(34,197,94,0.05)\\">\'\n        + \'<div style=\\"color:var(--success);font-weight:600\\">All images are up to date</div></div>\';\n    }\n    \n    await loadDockerImages();\n  } catch(e) {\n    showToast(\'Error checking updates: \' + e.message, \'error\');\n  } finally {\n    if (btn) btn.disabled = false;\n  }\n}\n\nasync function scanDockerImage(name, tag) {\n  try {\n    const response = await fetch(\'/api/admin/docker/scan-image\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify({ image: name, tag: tag })\n    });\n    const data = await response.json();\n    \n    if (data.vulnerabilities && data.vulnerabilities.length > 0) {\n      showToast(\'Found \' + data.vulnerabilities.length + \' vulnerabilities\', \'warning\');\n    } else {\n      showToast(\'No vulnerabilities found\', \'success\');\n    }\n    \n    await loadDockerImages();\n    await loadDockerSecuritySummary();\n  } catch(e) {\n    showToast(\'Error scanning image: \' + e.message, \'error\');\n  }\n}\n\nasync function scanAllDockerImages() {\n  const btn = event.target.closest(\'button\');\n  btn.disabled = true;\n  \n  try {\n    showToast(\'Scanning all images (this may take a few minutes)...\', \'info\');\n    const response = await fetch(\'/api/admin/docker/scan-all\', { method: \'POST\' });\n    const data = await response.json();\n    \n    showToast(\'Scan complete: \' + data.total + \' images scanned, \' + data.vulnerabilities_found + \' vulnerabilities found\', \'success\');\n    \n    await loadDockerImages();\n    await loadDockerSecuritySummary();\n  } catch(e) {\n    showToast(\'Error scanning images: \' + e.message, \'error\');\n  } finally {\n    btn.disabled = false;\n  }\n}\n\nfunction initDockerManagement() {\n  const container = document.getElementById(\'tab-docker-images\');\n  if (!container || container.style.display === \'none\') return;\n  \n  loadDockerImages();\n  loadDockerSecuritySummary();\n}\n\n</script>\n' }) %>