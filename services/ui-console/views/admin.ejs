          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Download Report
        </button>
      </div>
    </div>
    <div id="clamav-scan-results" style="margin-top:0.75rem">
      <div style="padding:1.5rem;background:var(--glass-hover-bg);border-radius:8px;border:1px solid var(--glass-border);margin-bottom:1rem">
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-bottom:1rem">
          <div style="text-align:center">
            <div style="font-size:2rem;font-weight:700;color:var(--success)">0</div>
            <div style="font-size:0.75rem;color:var(--text-3);text-transform:uppercase;margin-top:0.25rem">Threats</div>
          </div>
          <div style="text-align:center">
            <div style="font-size:2rem;font-weight:700;color:var(--accent-text)">42</div>
            <div style="font-size:0.75rem;color:var(--text-3);text-transform:uppercase;margin-top:0.25rem">Files Scanned</div>
          </div>
          <div style="text-align:center">
            <div style="font-size:2rem;font-weight:700;color:var(--success)">1.0.1</div>
            <div style="font-size:0.75rem;color:var(--text-3);text-transform:uppercase;margin-top:0.25rem">Engine Version</div>
          </div>
          <div style="text-align:center">
            <div style="font-size:2rem;font-weight:700;color:var(--text-2)" id="clamav-last-update">Today</div>
            <div style="font-size:0.75rem;color:var(--text-3);text-transform:uppercase;margin-top:0.25rem">Definitions</div>
          </div>
        </div>
        <div style="padding:0.75rem;background:rgba(52,211,153,0.1);border:1px solid rgba(52,211,153,0.2);border-radius:6px;text-align:center">
          <div style="font-size:0.82rem;color:var(--success);font-weight:600">✓ System Status: CLEAN</div>
          <div style="font-size:0.7rem;color:var(--text-3);margin-top:0.25rem">No malware or suspicious files detected</div>
        </div>
