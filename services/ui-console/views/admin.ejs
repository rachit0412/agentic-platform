        var r = await fetch('/api/switch-persona', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ persona_id: personaId })
        });
        var data = await r.json();
        if (r.ok && data.active_persona) {
          window.__activePersona = data.active_persona;
          // Re-render switcher chips
          var pr = await fetch('/api/my-personas');
          var pd = await pr.json();
          renderPersonaSwitcher(pd.personas || [], data.active_persona);
          applyPersonaNav(data.active_persona);
          showToast('Switched to ' + data.active_persona.name + ' persona', 'success');
          // Reload to reflect role changes; redirect away from admin if not allowed
          var nav = (data.active_persona.permissions && data.active_persona.permissions.nav) || [];
          var actions = (data.active_persona.permissions && data.active_persona.permissions.actions) || [];
          var noAdmin = nav.indexOf('admin') === -1 && actions.indexOf('access_admin') === -1;
          setTimeout(function() {
            if (noAdmin && window.location.pathname === '/admin') {
              window.location.href = '/';
            } else {
              window.location.reload();
            }
          }, 400);
        } else {
          showToast(data.error || 'Failed to switch persona', 'error');
