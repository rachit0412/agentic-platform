a href=\\"http://localhost:9090\\" target=\\"_blank\\" style=\\"display:flex;flex-direction:column;align-items:flex-start;gap:0.5rem;padding:1rem;background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:8px;text-decoration:none;color:var(--text-1);transition:all 0.2s\\" onmouseover=\\"this.style.borderColor=\'var(--accent-border)\'\\" onmouseout=\\"this.style.borderColor=\'var(--glass-border)\'\\">\n          <div style=\\"display:flex;align-items:center;gap:0.5rem;width:100%\\">\n            <svg viewBox=\\"0 0 24 24\\" width=\\"20\\" height=\\"20\\" fill=\\"none\\" stroke=\\"#ef4444\\" stroke-width=\\"2\\"><path d=\\"M22 12h-4l-3 9L9 3l-3 9H2\\"/></svg>\n            <span style=\\"font-weight:600;color:var(--text-1);font-size:0.85rem\\">Prometheus</span>\n          </div>\n          <span style=\\"font-size:0.72rem;color:var(--text-3)\\">Metrics collection</span>\n        </a>\n        <a href=\\"http://localhost:8010/docs\\" target=\\"_blank\\" style=\\"display:flex;flex-direction:column;align-items:flex-start;gap:0.5rem;padding:1rem;background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:8px;text-decoration:none;color:var(--text-1);transition:all 0.2s\\" onmouseover=\\"this.style.borderColor=\'var(--accent-border)\'\\" onmouseout=\\"this.style.borderColor=\'var(--glass-border)\'\\">\n          <div style=\\"display:flex;align-items:center;gap:0.5rem;width:100%\\">\n            <svg viewBox=\\"0 0 24 24\\" width=\\"20\\" height=\\"20\\" fill=\\"none\\" stroke=\\"#10b981\\" stroke-width=\\"2\\"><path d=\\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\\"/><polyline points=\\"14 2 14 8 20 8\\"/></svg>\n            <span style=\\"font-weight:600;color:var(--text-1);font-size:0.85rem\\">Agent API</span>\n          </div>\n          <span style=\\"font-size:0.72rem;color:var(--text-3)\\">REST API documentation</span>\n        </a>\n        <a href=\\"http://localhost:8011/docs\\" target=\\"_blank\\" style=\\"display:flex;flex-direction:column;align-items:flex-start;gap:0.5rem;padding:1rem;background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:8px;text-decoration:none;color:var(--text-1);transition:all 0.2s\\" onmouseover=\\"this.style.borderColor=\'var(--accent-border)\'\\" onmouseout=\\"this.style.borderColor=\'var(--glass-border)\'\\">\n          <div style=\\"display:flex;align-items:center;gap:0.5rem;width:100%\\">\n            <svg viewBox=\\"0 0 24 24\\" width=\\"20\\" height=\\"20\\" fill=\\"none\\" stroke=\\"#10b981\\" stroke-width=\\"2\\"><path d=\\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\\"/><polyline points=\\"14 2 14 8 20 8\\"/></svg>\n            <span style=\\"font-weight:600;color:var(--text-1);font-size:0.85rem\\">Tools API</span>\n          </div>\n          <span style=\\"font-size:0.72rem;color:var(--text-3)\\">Tools service documentation</span>\n        </a>\n      </div>\n    </div>\n  </div>\n\n</div>\n<!-- ═══════════════════════════════════════════════════════ -->\n<div id=\\"tab-audit\\" class=\\"admin-tab-content\\" style=\\"display:none\\">\n  <div class=\\"card animate-fade-up\\">\n    <div class=\\"section-header\\">\n      <h3>Audit Log</h3>\n      <div style=\\"display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap\\">\n        <select id=\\"audit-filter-type\\" class=\\"input\\" style=\\"font-size:0.78rem;padding:0.25rem 0.5rem;min-width:100px\\">\n          <option value=\\"\\">All Types</option>\n          <option value=\\"agent\\">Agents</option>\n          <option value=\\"skill\\">Skills</option>\n          <option value=\\"prompt\\">Prompts</option>\n          <option value=\\"guardrail\\">Guardrails</option>\n          <option value=\\"custom_tool\\">Custom Tools</option>\n          <option value=\\"a2a_peer\\">A2A Peers</option>\n          <option value=\\"mcp_server\\">MCP Servers</option>\n          <option value=\\"connector\\">Connectors</option>\n        </select>\n        <select id=\\"audit-filter-action\\" class=\\"input\\" style=\\"font-size:0.78rem;padding:0.25rem 0.5rem;min-width:100px\\">\n          <option value=\\"\\">All Actions</option>\n          <option value=\\"create\\">Create</option>\n          <option value=\\"update\\">Update</option>\n          <option value=\\"delete\\">Delete</option>\n          <option value=\\"rollback\\">Rollback</option>\n        </select>\n        <button class=\\"btn btn-secondary btn-sm\\" onclick=\\"loadAuditLog()\\">\n          <svg viewBox=\\"0 0 24 24\\" width=\\"12\\" height=\\"12\\" fill=\\"none\\" stroke=\\"currentColor\\" stroke-width=\\"2\\"><polyline points=\\"23 4 23 10 17 10\\"/><path d=\\"M20.49 15A9 9 0 1 1 21 12\\"/></svg>\n          Refresh\n        </button>\n      </div>\n    </div>\n    <div id=\\"audit-log\\" class=\\"mt-1\\" style=\\"color:var(--text-3);font-size:0.82rem;max-height:600px;overflow-y:auto\\">Loading...</div>\n  </div>\n</div>\n\n</div><!-- /admin-content -->\n\n<style>\n/* ── Admin two-level navigation ── */\n.admin-nav { margin-bottom:2rem; background:var(--glass-bg); border:1px solid var(--glass-border); border-radius:14px; overflow:hidden; }\n.admin-section-tabs { display:flex; background:rgba(0,0,0,0.06); border-bottom:1px solid var(--glass-border); padding:0 0.5rem; }\n.admin-stab { display:flex; align-items:center; gap:0.45rem; background:transparent; border:none; border-bottom:2px solid transparent; color:var(--text-3); padding:0.8rem 1.1rem; font-size:0.82rem; font-weight:500; cursor:pointer; transition:all 0.18s; margin-bottom:-1px; white-space:nowrap; user-select:none; }\n.admin-stab svg { flex-shrink:0; opacity:0.55; transition:opacity 0.18s; }\n.admin-stab:hover { color:var(--text-1); background:rgba(255,255,255,0.04); border-radius:8px 8px 0 0; }\n.admin-stab:hover svg { opacity:0.85; }\n.admin-stab.active { color:var(--accent-text); border-bottom-color:var(--accent); font-weight:600; }\n.admin-stab.active svg { opacity:1; }\n.admin-subtab-row { padding:0.6rem 1rem 0.7rem; }\n.admin-subtabs { display:flex; gap:0.35rem; flex-wrap:wrap; }\n.admin-subtab { background:transparent; border:1px solid transparent; color:var(--text-3); border-radius:20px; padding:0.3rem 0.85rem; font-size:0.75rem; cursor:pointer; transition:all 0.15s; user-select:none; }\n.admin-subtab:hover { color:var(--text-1); border-color:var(--glass-border); background:var(--glass-hover-bg); }\n.admin-subtab.active { color:var(--accent-text); border-color:var(--accent-border); background:var(--accent-bg); font-weight:600; }\n.health-card { padding:0.75rem;border-radius:10px;border:1px solid var(--glass-border);background:var(--glass-bg);display:flex;align-items:center;gap:0.75rem;transition:all 0.2s }\n.health-card:hover { border-color:var(--accent-border) }\n.health-dot { width:10px;height:10px;border-radius:50%;flex-shrink:0 }\n.health-dot.healthy { background:var(--success);box-shadow:0 0 8px rgba(16,185,129,0.4) }\n.health-dot.unhealthy { background:var(--danger);box-shadow:0 0 8px rgba(239,68,68,0.4) }\n.health-dot.unreachable { background:var(--text-3);box-shadow:0 0 8px rgba(100,116,139,0.3) }\n.count-card { padding:1rem;border-radius:10px;border:1px solid var(--glass-border);background:var(--glass-bg);text-align:center }\n.count-card .count-num { font-size:1.75rem;font-weight:700;color:var(--text-1) }\n.count-card .count-label { font-size:0.68rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em;margin-top:0.15rem }\n</style>\n\n<script>\n/* ═══ INIT ═══ */\ndocument.getElementById(\\\'admin-content\\\').style.display = \\\'block\\\';\n\n/* ═══ USER MANAGEMENT ═══ */\nvar _usersCache = [];\nfunction filterUsers(filter) {\n  if (filter === \\\'all\\\') { renderUsersTable(_usersCache); return; }\n  var filtered = _usersCache.filter(function(u) {\n    if (filter === \\\'active\\\') return u.is_active !== false;\n    if (filter === \\\'verified\\\') return u.email_verified;\n    if (filter === \\\'admin\\\') return u.role === \\\'admin\\\';\n    return true;\n  });\n  renderUsersTable(filtered);\n  /* Highlight the active stat card */\n  document.querySelectorAll(\'#user-stats-bar .card\').forEach(function(c) { c.style.boxShadow = \'\'; });\n  var idx = { all: 0, active: 1, verified: 2, admin: 3 }[filter];\n  var cards = document.querySelectorAll(\'#user-stats-bar .card\');\n  if (cards[idx]) cards[idx].style.boxShadow = \\\'0 0 0 2px var(--accent)\\\';\n}\nasync function loadUsers() {\n  try {\n    var r = await fetch(\'/api/users\');\n    if (r.status === 403) { document.getElementById(\'users-table-container\').innerHTML = \'<p style=\\"color:var(--danger)\\">Access denied. Admin role required.</p>\'; return; }\n    var data = await r.json();\n    var users = Array.isArray(data) ? data : (data.users || []);\n    _usersCache = users;\n    renderUsersTable(users);\n    /* Update stats bar */\n    var total = users.length;\n    var active = users.filter(function(u) { return u.is_active !== false; }).length;\n    var verified = users.filter(function(u) { return u.email_verified; }).length;\n    var admins = users.filter(function(u) { return u.role === \'admin\'; }).length;\n    document.getElementById(\\\'user-count-total\\\').textContent = total;\n    document.getElementById(\\\'user-count-active\\\').textContent = active;\n    document.getElementById(\\\'user-count-verified\\\').textContent = verified;\n    document.getElementById(\\\'user-count-admins\\\').textContent = admins;\n  } catch(e) { document.getElementById(\'users-table-container\').innerHTML = \'<p style=\\"color:var(--danger)\\">Failed to load users: \' + escapeHtml(e.message) + \'</p>\'; }\n}\n\nfunction renderUsersTable(users) {\n  if (!users || users.length === 0) {\n    document.getElementById(\'users-table-container\').innerHTML = \'<p style=\\"color:var(--text-3)\\">No users found.</p>\';\n    return;\n  }\n  var roleColors = { admin: \'var(--danger)\', member: \'var(--accent-text)\', viewer: \'var(--text-3)\' };\n  var html = \'<div style=\\"overflow-x:auto\\"><table style=\\"width:100%;border-collapse:collapse\\">\'\n    + \'<thead><tr style=\\"border-bottom:2px solid var(--glass-border)\\">\'\n    + \'<th style=\\"text-align:left;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600\\">User</th>\'\n    + \'<th style=\\"text-align:left;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600\\">Email</th>\'\n    + \'<th style=\\"text-align:left;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600\\">Role</th>\'\n    + \'<th style=\\"text-align:left;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600\\">Workspace</th>\'\n    + \'<th style=\\"text-align:center;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600\\">Status</th>\'\n    + \'<th style=\\"text-align:center;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600\\">Verified</th>\'\n    + \'<th style=\\"text-align:right;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600\\">Actions</th>\'\n    + \\\'</tr></thead><tbody>\\\';\n  users.forEach(function(u) {\n    var initials = (u.display_name || u.username || \'?\').split(\' \').map(function(w){return w[0]}).join(\'\').substring(0,2).toUpperCase();\n    var roleColor = roleColors[u.role] || \'var(--text-3)\';\n    var isActive = u.is_active !== false;\n    var statusBadge = isActive\n      ? \'<span style=\\"display:inline-flex;align-items:center;gap:4px;font-size:0.68rem;padding:3px 10px;border-radius:99px;background:var(--success-bg);color:var(--success);border:1px solid var(--success-border);font-weight:500\\"><span style=\\"width