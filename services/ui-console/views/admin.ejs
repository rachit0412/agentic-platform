var _EMBED_COMPAT = {
  'ollama': ['ollama'],
  'openai': ['openai'],
  'azure-openai': ['azure-openai'],
  'azure-foundry': ['azure-foundry', 'openai']
};

function filterEmbeddingsByProvider(llmProvider, availableProviders) {
  var compatible = _EMBED_COMPAT[llmProvider] || ['ollama'];
  document.querySelectorAll('.embed-option').forEach(function(el) {
    var p = el.dataset.provider;
    var isCompat = compatible.indexOf(p) !== -1;
    var isConfigured = availableProviders.indexOf(p) !== -1;
    el.style.display = (isCompat && isConfigured) ? '' : 'none';
  });
  var hint = document.getElementById('embed-provider-hint');
  if (hint) hint.textContent = 'Showing embeddings compatible with ' + llmProvider;
}

function highlightActiveEmbedding(provider, model) {
  document.querySelectorAll('.embed-option').forEach(function(el) {
    var isActive = el.dataset.provider === provider && el.dataset.model === model;
    el.style.borderColor = isActive ? 'var(--accent)' : 'var(--glass-border)';
    el.style.boxShadow = isActive ? '0 0 0 1px var(--accent)' : 'none';
    el.style.background = isActive ? 'rgba(6,182,212,0.06)' : 'transparent';
    var badge = el.querySelector('.badge');
    if (isActive && badge) {
      var old = badge.querySelector('.embed-active-dot');
      if (!old) {
        var dot = document.createElement('span');
        dot.className = 'embed-active-dot';
        dot.style.cssText = 'display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--success);margin-right:4px';
        badge.insertBefore(dot, badge.firstChild);
      }
    } else if (badge) {
      var dot = badge.querySelector('.embed-active-dot');
      if (dot) dot.remove();
    }
  });
}

async function selectEmbedding(el) {
  var provider = el.dataset.provider;
  var model = el.dataset.model;
  try {
    var r = await fetch('/api/models/embedding', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ provider: provider, model: model }) });
    var d = await r.json();
    if (r.ok) {
      showToast('Embedding switched to ' + provider + ' / ' + model, 'success');
      highlightActiveEmbedding(provider, model);
      loadLlmConfig();
    } else {
      showToast('Embedding switch failed: ' + (d.detail || d.error || 'Unknown error'), 'error');
    }
  } catch(e) { showToast('Embedding switch failed: ' + e.message, 'error'); }
}

async function activateModel(provider, model) {
  try {
    var r = await fetch('/api/models/switch', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ provider: provider, model: model }) });
    var d = await r.json();
    if (r.ok) {
      showToast('Switched to ' + provider + ' / ' + model, 'success');
      // Auto-switch embedding to the best compatible default for this provider
      var embedDefaults = {
        'ollama': { provider: 'ollama', model: 'nomic-embed-text' },
        'openai': { provider: 'openai', model: 'text-embedding-3-small' },
        'azure-openai': { provider: 'azure-openai', model: 'text-embedding-ada-002' },
        'azure-foundry': { provider: 'azure-foundry', model: 'text-embedding-ada-002' }
      };
      var emb = embedDefaults[provider] || embedDefaults['ollama'];
      await fetch('/api/models/embedding', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(emb) });
      loadLlmConfig();
      loadModels();
    } else {
      showToast('Switch failed: ' + (d.detail || d.error || 'Unknown error'), 'error');
    }
  } catch(e) { showToast('Switch failed: ' + e.message, 'error'); }
}

/* ═══ MODELS ═══ */
async function loadModels() {
  try {
    var r = await fetch('/api/models');
    var d = await r.json();
    var el = document.getElementById('models-list');
    var ollamaMsg = '';
    if (d.ollama_status && !d.ollama_status.enabled) {
      var reason = escapeHtml(d.ollama_status.reason || 'Configured model is not pulled');
      var cmd = escapeHtml(d.ollama_status.pull_command || 'docker compose exec -T ollama ollama pull llama3');
      ollamaMsg = '<div style="margin-bottom:0.65rem;padding:0.6rem 0.75rem;border-radius:10px;background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.25);color:#b45309">' +
        '<strong>Ollama not enabled:</strong> ' + reason + '<br>' +
        '<span style="font-size:0.75rem">Enable with: <code style="color:#92400e">' + cmd + '</code></span>' +
        '</div>';
    }
    if (!d.models || d.models.length === 0) {
      el.innerHTML = ollamaMsg + '<p style="color:var(--text-3)">No models found. Pull models with: <code style="color:var(--accent-text)">docker compose exec -T ollama ollama pull llama3</code></p>';
      return;
    }
    el.innerHTML = ollamaMsg + '<table><tr><th>Model</th><th>Provider</th><th>Size</th><th>Status</th><th style="width:1%"></th></tr>' +
      d.models.map(function(m) {
        var name = escapeHtml(m.full_name || m.model || '');
        var provider = escapeHtml(m.provider || '');
        var model = escapeHtml(m.model || '');
        var size = m.size ? (m.size / 1e9).toFixed(1) + ' GB' : String.fromCharCode(0x2014);
        var ollamaUnavailable = m.provider === 'ollama' && (m.installed === false || m.status === 'not_pulled');
        var badge = m.active
          ? '<span class="badge badge-success">active</span>'
          : (ollamaUnavailable
            ? '<span class="badge" style="font-size:0.68rem;background:rgba(244,63,94,0.12);color:#f43f5e">not enabled</span>'
            : '<span class="badge" style="font-size:0.68rem">available</span>');
        var action = (m.active || ollamaUnavailable)
          ? ''
          : '<button class="btn btn-primary btn-sm" style="padding:0.2rem 0.6rem;font-size:0.7rem;white-space:nowrap" onclick="activateModel(&apos;' + provider + '&apos;,&apos;' + model + '&apos;)">Use</button>';
        var note = m.note ? '<div style="font-size:0.68rem;color:#b45309;margin-top:0.2rem">' + escapeHtml(m.note) + '</div>' : '';
        return '<tr><td>' + name + note + '</td><td class="mono" style="font-size:0.78rem">' + provider + '</td><td class="mono">' + size + '</td><td>' + badge + '</td><td>' + action + '</td></tr>';
      }).join('') + '</table>';
  } catch(e) {
    document.getElementById('models-list').innerHTML = '<p style="color:var(--danger)">Failed to load models</p>';
  }
}

/* ═══ LLM USAGE SUMMARY ═══ */
async function loadLlmSummary() {
  try {
    var r = await fetch('/api/admin/llm-summary');
    var d = await r.json();
    var el = document.getElementById('llm-usage-summary');
    if (!d || (typeof d === 'object' && Object.keys(d).length === 0)) {
      el.innerHTML = '<p style="color:var(--text-3)">No LLM usage data yet. Run some agent prompts to generate usage data.</p>';
      return;
    }
    var html = '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:0.75rem">';
    var metricLabels = { total_calls: 'Total Calls', total_tokens: 'Total Tokens', total_input_tokens: 'Input Tokens', total_output_tokens: 'Output Tokens', avg_latency_ms: 'Avg Latency', total_cost: 'Est. Cost' };
    for (var k in d) {
      if (k === 'by_model' || k === 'by_provider' || k === 'recent') continue;
      var label = metricLabels[k] || k;
      var val = typeof d[k] === 'number' ? (k.includes('cost') ? '$' + d[k].toFixed(4) : k.includes('latency') ? d[k].toFixed(0) + 'ms' : d[k].toLocaleString()) : d[k];
      html += '<div style="padding:0.75rem;background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:8px;text-align:center">';
      html += '<div style="font-size:1.25rem;font-weight:700;color:var(--text-1)">' + val + '</div>';
      html += '<div style="font-size:0.68rem;color:var(--text-3);text-transform:uppercase">' + escapeHtml(label) + '</div>';
      html += '</div>';
    }
    html += '</div>';
    if (d.by_model && d.by_model.length > 0) {
      html += '<h4 style="margin-top:1rem;margin-bottom:0.5rem;font-size:0.85rem">By Model</h4><table><tr><th>Model</th><th>Provider</th><th>Calls</th><th>Tokens</th><th>Cost</th></tr>';
      for (var i = 0; i < d.by_model.length; i++) {
        var m = d.by_model[i];
        html += '<tr><td>' + escapeHtml(m.model || 'unknown') + '</td><td>' + escapeHtml(m.provider || '') + '</td><td class="mono">' + (m.requests || m.calls || 0) + '</td><td class="mono">' + (m.tokens || 0).toLocaleString() + '</td><td class="mono">$' + (m.cost || 0).toFixed(4) + '</td></tr>';
      }
      html += '</table>';
    }
    el.innerHTML = html;
  } catch(e) { document.getElementById('llm-usage-summary').innerHTML = '<p style="color:var(--text-3)">LLM usage summary unavailable</p>'; }
}

