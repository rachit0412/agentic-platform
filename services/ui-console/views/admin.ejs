e=\\"font-weight:600;font-size:0.85rem;color:var(--text-1)\\">text-embedding-ada-002</span>\n          <span class=\\"badge\\" style=\\"font-size:0.65rem;background:rgba(0,120,212,0.15);color:#0078d4\\">Azure OpenAI</span>\n        </div>\n        <div style=\\"font-size:0.72rem;color:var(--text-3);margin-top:0.35rem\\">Cloud &middot; 1536 dims &middot; Azure OpenAI hosted. Requires Azure OpenAI deployment.</div>\n      </div>\n      <div class=\\"embed-option\\" data-provider=\\"azure-foundry\\" data-model=\\"text-embedding-ada-002\\" onclick=\\"selectEmbedding(this)\\" style=\\"padding:0.75rem;border:1px solid var(--glass-border);border-radius:8px;cursor:pointer;transition:all 0.2s\\">\n        <div style=\\"display:flex;justify-content:space-between;align-items:center\\">\n          <span style=\\"font-weight:600;font-size:0.85rem;color:var(--text-1)\\">text-embedding-ada-002</span>\n          <span class=\\"badge\\" style=\\"font-size:0.65rem;background:rgba(0,120,212,0.15);color:#0078d4\\">Azure Foundry</span>\n        </div>\n        <div style=\\"font-size:0.72rem;color:var(--text-3);margin-top:0.35rem\\">Cloud &middot; 1536 dims &middot; Azure AI Foundry hosted embedding. Uses your Foundry endpoint.</div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Available Models -->\n  <div class=\\"card animate-fade-up delay-200\\" style=\\"margin-bottom:1.5rem\\">\n    <div class=\\"section-header\\">\n      <h3>Available Models</h3>\n      <button class=\\"btn btn-secondary btn-sm\\" onclick=\\"loadModels()\\">Refresh</button>\n    </div>\n    <div id=\\"models-list\\" class=\\"mt-1\\" style=\\"color:var(--text-3);font-size:0.82rem\\">Loading...</div>\n  </div>\n\n  <!-- LLM Usage Summary -->\n  <div class=\\"card animate-fade-up delay-300\\">\n    <div class=\\"section-header\\">\n      <h3>LLM Usage Summary</h3>\n      <button class=\\"btn btn-secondary btn-sm\\" onclick=\\"loadLlmSummary()\\">Refresh</button>\n    </div>\n    <div id=\\"llm-usage-summary\\" class=\\"mt-1\\" style=\\"color:var(--text-3);font-size:0.82rem\\">Loading...</div>\n  </div>\n</div>\n\n<!-- ═══════════════════════════════════════════════════════ -->\n<!-- TAB 4: DATABASE & DATA                                 -->\n<!-- ═══════════════════════════════════════════════════════ -->\n<div id=\\"tab-database\\" class=\\"admin-tab-content\\" style=\\"display:none\\">\n\n  <!-- Database Status -->\n  <div class=\\"card animate-fade-up\\" style=\\"margin-bottom:1.5rem\\">\n    <div class=\\"section-header\\">\n      <h3>SQLite Database</h3>\n      <div style=\\"display:flex;gap:0.5rem\\">\n        <button class=\\"btn btn-secondary btn-sm\\" onclick=\\"loadDbStats()\\">Refresh</button>\n        <button class=\\"btn btn-primary btn-sm\\" onclick=\\"exportData()\\">\n          <svg viewBox=\\"0 0 24 24\\" width=\\"12\\" height=\\"12\\" fill=\\"none\\" stroke=\\"currentColor\\" stroke-width=\\"2\\"><path d=\\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\\"/><polyline points=\\"7 10 12 15 17 10\\"/><line x1=\\"12\\" y1=\\"15\\" x2=\\"12\\" y2=\\"3\\"/></svg>\n          Export All\n        </button>\n        <label class=\\"btn btn-secondary btn-sm\\" style=\\"cursor:pointer\\">\n          <svg viewBox=\\"0 0 24 24\\" width=\\"12\\" height=\\"12\\" fill=\\"none\\" stroke=\\"currentColor\\" stroke-width=\\"2\\"><path d=\\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\\"/><polyline points=\\"17 8 12 3 7 8\\"/><line x1=\\"12\\" y1=\\"3\\" x2=\\"12\\" y2=\\"15\\"/></svg>\n          Import\n          <input type=\\"file\\" accept=\\".json\\" style=\\"display:none\\" onchange=\\"importData(event)\\">\n        </label>\n      </div>\n    </div>\n    <div id=\\"db-stats\\" class=\\"mt-1\\" style=\\"color:var(--text-3);font-size:0.82rem\\">Loading...</div>\n  </div>\n\n  <!-- ChromaDB Collections -->\n  <div class=\\"card animate-fade-up delay-100\\" style=\\"margin-bottom:1.5rem\\">\n    <div class=\\"section-header\\">\n      <h3>ChromaDB / Vector Store</h3>\n      <button class=\\"btn btn-secondary btn-sm\\" onclick=\\"loadChromaStats()\\">Refresh</button>\n    </div>\n    <div id=\\"chroma-stats\\" class=\\"mt-1\\" style=\\"color:var(--text-3);font-size:0.82rem\\">Loading...</div>\n  </div>\n\n  <!-- Document Stats -->\n  <div class=\\"card animate-fade-up delay-200\\">\n    <div class=\\"section-header\\">\n      <h3>Knowledge Base Stats</h3>\n      <button class=\\"btn btn-secondary btn-sm\\" onclick=\\"loadDocStats()\\">Refresh</button>\n    </div>\n    <div id=\\"doc-stats\\" class=\\"mt-1\\" style=\\"color:var(--text-3);font-size:0.82rem\\">Loading...</div>\n  </div>\n</div>\n\n<!-- ═══════════════════════════════════════════════════════ -->\n<!-- TAB: DOCKER IMAGES                                     -->\n<!-- ═══════════════════════════════════════════════════════ -->\n<div id=\\"tab-docker-images\\" class=\\"admin-tab-content\\" style=\\"display:none\\">\n\n  <!-- Header -->\n  <div style=\\"display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem\\">\n    <div>\n      <h2 style=\\"margin:0;color:var(--text-1)\\">🐳 Docker Image Management</h2>\n      <p style=\\"margin:0.25rem 0 0;color:var(--text-3);font-size:0.82rem\\">Monitor image versions, scan for vulnerabilities, and manage updates</p>\n    </div>\n    <div style=\\"display:flex;gap:0.5rem\\">\n      <button class=\\"btn btn-secondary btn-sm\\" onclick=\\"loadDockerImages()\\">\n        <svg viewBox=\\"0 0 24 24\\" width=\\"12\\" height=\\"12\\" fill=\\"none\\" stroke=\\"currentColor\\" stroke-width=\\"2\\"><polyline points=\\"23 4 23 10 17 10\\"/><path d=\\"M20.49 15A9 9 0 1 1 21 12\\"/></svg>\n        Refresh\n      </button>\n      <button class=\\"btn btn-primary btn-sm\\" onclick=\\"scanAllDockerImages()\\">\n        <svg viewBox=\\"0 0 24 24\\" width=\\"12\\" height=\\"12\\" fill=\\"none\\" stroke=\\"currentColor\\" stroke-width=\\"2\\"><path d=\\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\\"/></svg>\n        Scan All\n      </button>\n    </div>\n  </div>\n\n  <!-- Security Summary Cards -->\n  <div id=\\"docker-security-cards\\">\n    <div style=\\"color:var(--text-3);font-size:0.82rem\\">Loading security summary...</div>\n  </div>\n\n  <!-- Needs Attention -->\n  <div id=\\"docker-attention-needed\\" style=\\"margin-bottom:1.5rem\\"></div>\n\n  <!-- Updates Available -->\n  <div id=\\"docker-updates-available\\" style=\\"margin-bottom:1.5rem\\"></div>\n\n  <!-- Docker Images Table -->\n  <div class=\\"card animate-fade-up\\">\n    <div class=\\"section-header\\">\n      <h3>Managed Images</h3>\n      <div style=\\"display:flex;gap:0.5rem;flex-wrap:wrap\\">\n        <button class=\\"btn btn-secondary btn-sm\\" onclick=\\"checkDockerUpdates(event)\\">Check for Updates</button>\n      </div>\n    </div>\n    <div id=\\"docker-images-table\\" style=\\"margin-top:1rem\\">\n      <div id=\\"docker-loading\\" style=\\"color:var(--text-3);font-size:0.82rem\\">Loading images...</div>\n    </div>\n  </div>\n\n  <!-- Docker Documentation Link -->\n  <div class=\\"card animate-fade-up\\" style=\\"margin-top:1rem;border-left:4px solid var(--accent-text);background:rgba(6,182,212,0.05)\\">\n    <h4 style=\\"margin:0 0 0.5rem\\">📚 Learn More</h4>\n    <p style=\\"margin:0;font-size:0.9rem;color:var(--text-2)\\">\n      See <a href=\\"/docs/DOCKER-SECURITY.md\\" target=\\"_blank\\" style=\\"color:var(--accent-text);text-decoration:underline\\">DOCKER-SECURITY.md</a> for:\n      <ul style=\\"margin:0.5rem 0;padding-left:1.5rem\\">\n        <li>Vulnerability descriptions and fixes</li>\n        <li>Version update strategies</li>\n        <li>Security scanning procedures</li>\n        <li>Production deployment recommendations</li>\n      </ul>\n    </p>\n  </div>\n\n</div>\n\n<!-- ═══════════════════════════════════════════════════════ -->\n<!-- TAB: ENVIRONMENT VARIABLES                             -->\n<!-- ═══════════════════════════════════════════════════════ -->\n<div id=\\"tab-environment-vars\\" class=\\"admin-tab-content\\" style=\\"display:none\\">\n\n  <div style=\\"display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem\\">\n    <div>\n      <h2 style=\\"margin:0;color:var(--text-1)\\">⚙️ Environment Variables</h2>\n      <p style=\\"margin:0.25rem 0 0;color:var(--text-3);font-size:0.82rem\\">Manage Docker image versions and platform configuration</p>\n    </div>\n    <button class=\\"btn btn-secondary btn-sm\\" onclick=\\"loadEnvVars()\\">\n      <svg viewBox=\\"0 0 24 24\\" width=\\"12\\" height=\\"12\\" fill=\\"none\\" stroke=\\"currentColor\\" stroke-width=\\"2\\"><polyline points=\\"23 4 23 10 17 10\\"/><path d=\\"M20.49 15A9 9 0 1 1 21 12\\"/></svg>\n      Refresh\n    </button>\n  </div>\n\n  <!-- Docker Image Versions -->\n  <div class=\\"card animate-fade-up\\" style=\\"margin-bottom:1.5rem\\">\n    <div class=\\"section-header\\">\n      <h3>🐳 Docker Image Versions</h3>\n      <p style=\\"font-size:0.75rem;color:var(--text-3);margin:0\\">Configure which version of each Docker image to use</p>\n    </div>\n    <div id=\\"docker-env-vars\\" style=\\"margin-top:1rem\\">\n      <div style=\\"color:var(--text-3);font-size:0.82rem\\">Loading...</div>\n    </div>\n  </div>\n\n  <!-- LLM Configuration -->\n  <div class=\\"card animate-fade-up\\">\n    <div class=\\"section-header\\">\n      <h3>🤖 LLM Provider Selection</h3>\n      <p style=\\"font-size:0.75rem;color:var(--text-3);margin:0\\">Choose which LLM provider to use as default</p>\n    </div>\n    <div id=\\"llm-config-vars\\" style=\\"margin-top:1rem\\">\n      <div style=\\"color:var(--text-3);font-size:0.82rem\\">Loading...</div>\n    </div>\n  </div>\n\n  <!-- Documentation -->\n  <div class=\\"card animate-fade-up\\" style=\\"margin-top:1rem;border-left:4px solid var(--success);background:rgba(16,185,129,0.05)\\">\n    <h4 style=\\"margin:0 0 0.5rem\\">📖 Full Documentation</h4>\n    <p style=\\"margin:0;font-size:0.9rem;color:var(--text-2)\\">\n      See <a href=\\"/docs/ENVIRONMENT-VARIABLES.md\\" target=\\"_blank\\" style=\\"color:var(--success);text-decoration:underline\\">ENVIRONMENT-VARIABLES.md</a> for complete reference:\n      <ul style=\\"margin:0.5rem 0;padding-left:1.5rem;font-size:0.85rem\\">\n        <li>All environment variables</li>\n        <li>LLM provider configuration</li>\n        <li>Database and auth settings</li>\n        <li>Production best practices</li>\n      </ul>\n    </p>\n  </div>\n\n</div>\n\n<script src=\\"/docker-management.js\\"><\\/script>\n\n<!-- TAB: COMPLIANCE RULES & POLICIES                        -->\n<div id=\\"tab-compliance-rules\\" class=\\"admin-tab-content\\" style=\\"display:none\\">\n  <div style=\\"max-width:1200px\\">\n    <!-- Header -->\n    <div style=\\"margin-bottom:2rem\\">\n      <h2 style=\\"margin:0 0 0.5rem;font-size:1.8rem;font-weight:600\\">🛡️ Compliance & Ethical Controls</h2>\n      <p style=\\"margin:0;color:var(--text-3);font-size:0.95rem\\">Configure filtering rules, compliance levels, and ethical guidelines for all agent interactions</p>\n    </div>\n\n    <!-- Status Overview Card -->\n    <div style=\\"padding:1.5rem;background:linear-gradient(135deg,rgba(6,182,212,0.1),rgba(14,165,233,0.05));border:1px solid rgba(6,182,212,0.2);border-radius:12px;margin-bottom:2rem;display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1.5rem\\">\n      <div>\n        <div style=\\"font-size:0.75rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem\\">Status</div>\n        <div style=\\"font-size:1.3rem;font-weight:600;color:var(--text-1)\\">\n          <span id=\\"compliance-status-badge\\" style=\\"background:rgba(16,185,129,0.2);color:#10b981;padding:0.25rem 0.75rem;border-radius:20px;font-size:0.9rem\\">Enabled</span>\n        </div>\n      </div>\n      <div>\n        <div style=\\"font-size:0.75rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem\\">Active Level</div>\n        <div style=\\"font-size:1.3rem;font-weight:600;color:var(--text-1)\\" id=\\"active-compliance-level\\">Medium</div>\n      </div>\n      <div>\n        <div style=\\"font-size:0.75rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem\\">Filters Active</div>\n        <div style=\\"font-size:1.3rem;font-weight:600;color:var(--text-1)\\" id=\\"active-filters-count\\">4</div>\n      </div>\n    </div>\n\n    <!-- Compliance Level Selection -->\n    <div style=\\"margin-bottom:2rem\\">\n      <div style=\\"margin-bottom:1rem\\">\n        <h3 style=\\"margin:0 0 0.5rem;font-size:1.1rem;font-weight:600\\">Compliance Level</h3>\n        <p style=\\"margin:0;color:var(--text-3);font-size:0.9rem\\">Choose the strictness of compliance enforcement</p>\n      </div>\n\n      <div style=\\"display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1rem;margin-bottom:1rem\\">\n        <!-- Low Level -->\n        <div style=\\"padding:1.25rem;background:var(--input-bg);border:2px solid transparent;border-radius:10px;cursor:pointer;transition:all 0.3s\\" data-level=\\"low\\" onclick=\\"selectComplianceLevel(\'low\')\\">\n          <div style=\\"display:flex;align-items:flex-start;gap:1rem;margin-bottom:0.75rem\\">\n            <div style=\\"font-size:1.5rem;line-height:1\\">🟢</div>\n            <div style=\\"flex:1\\">\n              <div style=\\"font-weight:600;color:var(--text-1);font-size:1rem;margin-bottom:0.25rem\\">Low</div>\n              <div style=\\"color:var(--text-3);font-size:0.85rem\\">Minimal protection</div>\n            </div>\n          </div>\n          <ul style=\\"margin:0;padding-left:1.5rem;color:var(--text-2);font-size:0.85rem;line-height:1.6\\">\n            <li>Basic content filtering only</li>\n            <li>No PII masking</li>\n            <li>Audit logging optional</li>\n          </ul>\n        </div>\n\n        <!-- Medium Level (Default) -->\n        <div style=\\"padding:1.25rem;background:linear-gradient(135deg,rgba(14,165,233,0.1),rgba(59,130,246,0.05));border:2px solid rgba(59,130,246,0.5);border-radius:10px;cursor:pointer;transition:all 0.3s\\" data-level=\\"medium\\" onclick=\\"selectComplianceLevel(\'medium\')\\">\n          <div style=\\"display:flex;align-items:flex-start;gap:1rem;margin-bottom:0.75rem\\">\n            <div style=\\"font-size:1.5rem;line-height:1\\">🟡</div>\n            <div style=\\"flex:1\\">\n              <div style=\\"font-weight:600;color:var(--text-1);font-size:1rem;margin-bottom:0.25rem\\">Medium <span style=\\"background:rgba(59,130,246,0.2);color:#3b82f6;font-size:0.7rem;padding:0.2rem 0.5rem;border-radius:3px;margin-left:0.5rem\\">DEFAULT</span></div>\n              <div style=\\"color:var(--text-3);font-size:0.85rem\\">Recommended for production</div>\n            </div>\n          </div>\n          <ul style=\\"margin:0;padding-left:1.5rem;color:var(--text-2);font-size:0.85rem;line-height:1.6\\">\n            <li>PII masking enabled</li>\n            <li>Harmful content blocking</li>\n            <li>Comprehensive audit trail</li>\n          </ul>\n        </div>\n\n        <!-- High Level -->\n        <div style=\\"padding:1.25rem;background:var(--input-bg);border:2px solid transparent;border-radius:10px;cursor:pointer;transition:all 0.3s\\" data-level=\\"high\\" onclick=\\"selectComplianceLevel(\'high\')\\">\n          <div style=\\"display:flex;align-items:flex-start;gap:1rem;margin-bottom:0.75rem\\">\n            <div style=\\"font-size:1.5rem;line-height:1\\">🔴</div>\n            <div style=\\"flex:1\\">\n              <div style=\\"font-weight:600;color:var(--text-1);font-size:1rem;margin-bottom:0.25rem\\">High</div>\n              <div style=\\"color:var(--text-3);font-size:0.85rem\\">Strict enforcement</div>\n            </div>\n          </div>\n          <ul style=\\"margin:0;padding-left:1.5rem;color:var(--text-2);font-size:0.85rem;line-height:1.6\\">\n            <li>All filters enabled</li>\n            <li>Strict content blocking</li>\n            <li>Rate limiting enforced</li>\n          </ul>\n        </div>\n      </div>\n      <input type=\\"hidden\\" id=\\"compliance-level\\" value=\\"medium\\" />\n    </div>\n\n    <!-- Filter Controls Section -->\n    <div style=\\"margin-bottom:2rem\\">\n      <div style=\\"margin-bottom:1rem\\">\n        <h3 style=\\"margin:0 0 0.5rem;font-size:1.1rem;font-weight:600\\">Filter Configuration</h3>\n        <p style=\\"margin:0;color:var(--text-3);font-size:0.9rem\\">Enable or disable individual compliance filters</p>\n      </div>\n\n      <div style=\\"display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1rem\\">\n        <!-- Compliance Filtering Toggle -->\n        <div style=\\"padding:1.25rem;background:var(--input-bg);border:1px solid var(--divider);border-radius:10px;display:flex;align-items:flex-start;gap:1rem\\">\n          <div style=\\"flex:1\\">\n            <div style=\\"display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem\\">\n              <span style=\\"font-size:1.2rem\\">🔒</span>\n              <label style=\\"font-weight:600;color:var(--text-1);margin:0;cursor:pointer\\">Enable Compliance Filtering</label>\n            </div>\n            <p style=\\"margin:0;color:var(--text-3);font-size:0.85rem;line-height:1.5\\">Master toggle for all compliance rules. When disabled, all filters are bypassed.</p>\n          </div>\n          <div style=\\"width:50px;display:flex;align-items:center;justify-content:center;flex-shrink:0\\">\n            <input type=\\"checkbox\\" id=\\"enable-compliance\\" checked style=\\"width:24px;height:24px;cursor:pointer\\" onchange=\\"updateFilterCount()\\"/>\n          </div>\n        </div>\n\n        <!-- Audit Logging Toggle -->\n        <div style=\\"padding:1.25rem;background:var(--input-bg);border:1px solid var(--divider);border-radius:10px;display:flex;align-items:flex-start;gap:1rem\\">\n          <div style=\\"flex:1\\">\n            <div style=\\"display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem\\">\n              <span style=\\"font-size:1.2rem\\">📝</span>\n              <label style=\\"font-weight:600;color:var(--text-1);margin:0;cursor:pointer\\">Enable Audit Logging</label>\n            </div>\n            <p style=\\"margin:0;color:var(--text-3);font-size:0.85rem;line-height:1.5\\">Log all agent interactions for compliance review and audit trails.</p>\n          </div>\n          <div style=\\"width:50px;display:flex;align-items:center;justify-content:center;flex-shrink:0\\">\n            <input type=\\"checkbox\\" id=\\"enable-audit\\" checked style=\\"width:24px;height:24px;cursor:pointer\\" onchange=\\"updateFilterCount()\\"/>\n          </div>\n        </div>\n\n        <!-- PII Filtering Toggle -->\n        <div style=\\"padding:1.25rem;background:var(--input-bg);border:1px solid var(--divider);border-radius:10px;display:flex;align-items:flex-start;gap:1rem\\">\n          <div style=\\"flex:1\\">\n            <div style=\\"display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem\\">\n              <span style=\\"font-size:1.2rem\\">🔐</span>\n              <label style=\\"font-weight:600;color:var(--text-1);margin:0;cursor:pointer\\">Filter PII Data</label>\n            </div>\n            <p style=\\"margin:0;color:var(--text-3);font-size:0.85rem;line-height:1.5\\">Masks emails, phone numbers, SSNs, credit cards, and sensitive personal data.</p>\n            <div style=\\"margin-top:0.5rem;padding:0.5rem;background:rgba(0,0,0,0.2);border-radius:4px;font-size:0.75rem;color:var(--text-3);font-family:monospace\\">\n              john@example.com → [EMAIL], 555-123-4567 → [PHONE]\n            </div>\n          </div>\n          <div style=\\"width:50px;display:flex;align-items:center;justify-content:center;flex-shrink:0\\">\n            <input type=\\"checkbox\\" id=\\"enable-pii-filter\\" checked style=\\"width:24px;height:24px;cursor:pointer\\" onchange=\\"updateFilterCount()\\"/>\n          </div>\n        </div>\n\n        <!-- Harmful Content Filter Toggle -->\n        <div style=\\"padding:1.25rem;background:var(--input-bg);border:1px solid var(--divider);border-radius:10px;display:flex;align-items:flex-start;gap:1rem\\">\n          <div style=\\"flex:1\\">\n            <div style=\\"display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem\\">\n              <span style=\\"font-size:1.2rem\\">⚠️</span>\n              <label style=\\"font-weight:600;color:var(--text-1);margin:0;cursor:pointer\\">Filter Harmful Content</label>\n            </div>\n            <p style=\\"margin:0;color:var(--text-3);font-size:0.85rem;line-height:1.5\\">Blocks responses with illegal instructions, violence, or dangerous information.</p>\n            <div style=\\"margin-top:0.5rem;padding:0.5rem;background:rgba(239,68,68,0.1);border-radius:4px;border-left:2px solid #ef4444;font-size:0.75rem;color:var(--text-3)\\">\n              Contains harmful patterns → Replaced with warning message\n            </div>\n          </div>\n          <div style=\\"width:50px;display:flex;align-items:center;justify-content:center;flex-shrink:0\\">\n            <input type=\\"checkbox\\" id=\\"enable-harmful-content\\" checked style=\\"width:24px;height:24px;cursor:pointer\\" onchange=\\"updateFilterCount()\\"/>\n          </div>\n        </div>\n\n        <!-- Profanity Filter Toggle -->\n        <div style=\\"padding:1.25rem;background:var(--input-bg);border:1px solid var(--divider);border-radius:10px;display:flex;align-items:flex-start;gap:1rem\\">\n          <div style=\\"flex:1\\">\n            <div style=\\"display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem\\">\n              <span style=\\"font-size:1.2rem\\">🚫</span>\n              <label style=\\"font-weight:600;color:var(--text-1);margin:0;cursor:pointer\\">Filter Profanity</label>\n            </div>\n            <p style=\\"margin:0;color:var(--text-3);font-size:0.85rem;line-height:1.5\\">Removes offensive language and profanity from agent responses.</p>\n          </div>\n          <div style=\\"width:50px;display:flex;align-items:center;justify-content:center;flex-shrink:0\\">\n            <input type=\\"checkbox\\" id=\\"enable-profanity\\" checked style=\\"width:24px;height:24px;cursor:pointer\\" onchange=\\"updateFilterCount()\\"/>\n          </div>\n        </div>\n\n        <!-- Rate Limiting Toggle -->\n        <div style=\\"padding:1.25rem;background:var(--input-bg);border:1px solid var(--divider);border-radius:10px;display:flex;align-items:flex-start;gap:1rem\\">\n          <div style=\\"flex:1\\">\n            <div style=\\"display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem\\">\n              <span style=\\"font-size:1.2rem\\">⏱️</span>\n              <label style=\\"font-weight:600;color:var(--text-1);margin:0;cursor:pointer\\">Enable Rate Limiting</label>\n            </div>\n            <p style=\\"margin:0;color:var(--text-3);font-size:0.85rem;line-height:1.5\\">Prevents abuse by enforcing request rate limits per user and globally.</p>\n          </div>\n          <div style=\\"width:50px;display:flex;align-items:center;justify-content:center;flex-shrink:0\\">\n            <input type=\\"checkbox\\" id=\\"enable-rate-limit\\" checked style=\\"width:24px;height:24px;cursor:pointer\\" onchange=\\"updateFilterCount()\\"/>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Ethical Guidelines Section -->\n    <div style=\\"margin-bottom:2rem\\">\n      <div style=\\"margin-bottom:1rem\\">\n        <h3 style=\\"margin:0 0 0.5rem;font-size:1.1rem;font-weight:600\\">Ethical Guidelines</h3>\n        <p style=\\"margin:0;color:var(--text-3);font-size:0.9rem\\">Custom ethical framework sent with each agent request. Leave empty to use defaults.</p>\n      </div>\n\n      <div style=\\"padding:1.25rem;background:var(--input-bg);border:1px solid var(--divider);border-radius:10px\\">\n        <textarea \n          id=\\"ethical-guidelines\\" \n          placeholder=\\"Enter ethical guidelines for the AI agent...\nExamples:\n• Always prioritize user safety and privacy\n• Refuse requests for illegal or harmful content\n• Maintain professional and respectful communication\n• Respect intellectual property rights\n• Disclose limitations and uncertainties\\"\n          style=\\"width:100%;min-height:150px;padding:0.75rem;background:rgba(0,0,0,0.2);border:1px solid var(--divider);border-radius:6px;color:var(--text-1);font-family:monospace;font-size:0.85rem;resize:vertical\\"\n        ></textarea>\n        <div style=\\"margin-top:0.75rem;padding:0.75rem;background:rgba(59,130,246,0.1);border-left:3px solid #3b82f6;border-radius:4px;color:var(--text-2);font-size:0.85rem;line-height:1.5\\">\n          💡 <strong>Tip:</strong> These guidelines are included in the system prompt for every agent interaction. Use clear, concise language describing the values and principles the agent should follow.\n        </div>\n      </div>\n    </div>\n\n    <!-- Action Buttons -->\n    <div style=\\"display:flex;gap:0.75rem;flex-wrap:wrap\\">\n      <button class=\\"btn btn-primary\\" onclick=\\"saveComplianceSettings()\\" style=\\"padding:0.75rem 1.5rem;font-weight:600\\">\n        💾 Save Settings\n      </button>\n      <button class=\\"btn btn-secondary\\" onclick=\\"resetComplianceSettings()\\" style=\\"padding:0.75rem 1.5rem\\">\n        ↺ Reset to Defaults\n      </button>\n      <button class=\\"btn btn-secondary\\" onclick=\\"showCompliancePreview()\\" style=\\"padding:0.75rem 1.5rem\\">\n        👁️ Preview Rules\n      </button>\n    </div>\n  </div>\n</div>\n\n<!-- TAB: COMPLIANCE AUDIT LOG                               -->\n<div id=\\"tab-compliance-audit\\" class=\\"admin-tab-content\\" style=\\"display:none\\">\n  <div class=\\"card\\">\n    <h2 style=\\"margin:0 0 1.5rem\\">📋 Compliance Audit Log</h2>\n    \n    <div style=\\"display:flex;gap:0.75rem;margin-bottom:1.5rem;flex-wrap:wrap\\">\n      <select id=\\"audit-filter\\" class=\\"input\\" style=\\"min-width:180px\\">\n        <option value=\\"\\">All Events</option>\n        <option value=\\"user-message\\">User Messages</option>\n        <option value=\\"compliance-block\\">Compliance Blocks</option>\n        <option value=\\"pii-filtered\\">PII Filtered</option>\n        <option value=\\"harmful-blocked\\">Harmful Content Blocked</option>\n      </select>\n      <button class=\\"btn btn-secondary\\" onclick=\\"loadAuditLog()\\">🔄 Refresh</button>\n      <button class=\\"btn btn-secondary\\" onclick=\\"exportAuditLog()\\">📥 Export</button>\n    </div>\n\n    <div id=\\"audit-log-table\\" style=\\"overflow-x:auto\\">\n      <table style=\\"width:100%;border-collapse:collapse;font-size:0.9rem\\">\n        <thead>\n          <tr style=\\"border-bottom:2px solid var(--divider)\\">\n            <th style=\\"text-align:left;padding:0.75rem;font-weight:600\\">Timestamp</th>\n            <th style=\\"text-align:left;padding:0.75rem;font-weight:600\\">User</th>\n            <th style=\\"text-align:left;padding:0.75rem;font-weight:600\\">Event Type</th>\n            <th style=\\"text-align:left;padding:0.75rem;font-weight:600\\">Details</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr style=\\"border-bottom:1px solid var(--divider);color:var(--text-3)\\">\n            <td colspan=\\"4\\" style=\\"padding:2rem;text-align:center\\">\n              No audit events yet\n            </td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n</div>\n\n<!-- TAB: SECRET SCANNING (GITLEAKS)                        -->\n<div id=\\"tab-secret-scan\\" class=\\"admin-tab-content\\" style=\\"display:none\\">\n  <div class=\\"card\\">\n    <h2 style=\\"margin:0 0 1.5rem\\">🔐 Secret Scanning (Gitleaks)</h2>\n    <p style=\\"color:var(--text-3);font-size:0.9rem;margin-bottom:1.5rem\\">Scan the repository and codebase for hardcoded secrets, API keys, credentials, and sensitive data.</p>\n    \n    <!-- What Gitleaks Scans For -->\n    <div style=\\"background:linear-gradient(135deg,rgba(59,130,246,0.05),rgba(6,182,212,0.05));border:1px solid rgba(59,130,246,0.2);border-radius:10px;padding:1rem;margin-bottom:1.5rem\\">\n      <div style=\\"font-weight:600;color:var(--text-1);margin-bottom:0.75rem\\">📋 What This Scan Looks For:</div>\n      <div style=\\"display:grid;grid-template-columns:1fr 1fr;gap:1rem;font-size:0.85rem;color:var(--text-2)\\">\n        <div><span style=\\"color:var(--accent)\\">🔑</span> AWS Access Keys & Secrets</div>\n        <div><span style=\\"color:var(--accent)\\">🔑</span> GitHub Tokens & PATs</div>\n        <div><span style=\\"color:var(--accent)\\">🔑</span> Database Passwords</div>\n        <div><span style=\\"color:var(--accent)\\">🔑</span> Private SSH Keys</div>\n        <div><span style=\\"color:var(--accent)\\">🔑</span> API Keys (Stripe, Slack, etc.)</div>\n        <div><span style=\\"color:var(--accent)\\">🔑</span> OAuth Tokens</div>\n        <div><span style=\\"color:var(--accent)\\">🔑</span> Firebase Keys</div>\n        <div><span style=\\"color:var(--accent)\\">🔑</span> Encryption Passwords</div>\n      </div>\n      <div style=\\"margin-top:1rem;padding-top:1rem;border-top:1px solid rgba(59,130,246,0.1);font-size:0.8rem;color:var(--text-3)\\">\n        ⚠️ <strong>Action Required:</strong> Any secrets found should be considered <strong>compromised</strong> and must be rotated immediately. If found in git history, use <code style=\\"background:var(--input-bg);padding:0.2rem 0.4rem;border-radius:3px;font-family:monospace;font-size:0.75rem\\">git-filter-branch</code> or <code style=\\"background:var(--input-bg);padding:0.2rem 0.4rem;border-radius:3px;font-family:monospace;font-size:0.75rem\\">git-filter-repo</code> to remove them.\n      </div>\n    </div>\n    \n    <div class=\\"section-header\\" style=\\"margin-bottom:1.5rem\\">\n      <h3>Scan Configuration</h3>\n    </div>\n\n    <div style=\\"display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.5rem\\">\n      <div>\n        <label class=\\"input-label\\">Scan Path</label>\n        <input id=\\"scan-path-input\\" type=\\"text\\" class=\\"input\\" value=\\"/app\\" placeholder=\\"/app\\" style=\\"font-size:0.9rem\\">\n        <div style=\\"font-size:0.72rem;color:var(--text-3);margin-top:0.25rem\\">Enter the path to scan (e.g., /app, /app/services)</div>\n      </div>\n      <div>\n        <label class=\\"input-label\\">Output Format</label>\n        <select id=\\"scan-format-select\\" class=\\"input\\" style=\\"font-size:0.9rem\\">\n          <option value=\\"json\\">JSON (Detailed)</option>\n          <option value=\\"csv\\">CSV</option>\n          <option value=\\"sarif\\">SARIF (Security)</option>\n        </select>\n        <div style=\\"font-size:0.72rem;color:var(--text-3);margin-top:0.25rem\\">Format for scan results</div>\n      </div>\n    </div>\n\n    <div style=\\"display:flex;gap:0.75rem;margin-bottom:2rem;flex-wrap:wrap\\">\n      <button class=\\"btn btn-primary\\" onclick=\\"runSecretScan()\\" id=\\"secret-scan-btn\\" style=\\"padding:0.75rem 1.5rem\\">\n        <span id=\\"scan-btn-text\\">🔍 Run Secret Scan</span>\n        <span id=\\"scan-btn-spinner\\" style=\\"display:none;margin-left:0.5rem\\">\n          <svg width=\\"14\\" height=\\"14\\" viewBox=\\"0 0 24 24\\" fill=\\"none\\" stroke=\\"currentColor\\" stroke-width=\\"2\\" style=\\"animation:spin 1s linear infinite\\"><circle cx=\\"12\\" cy=\\"12\\" r=\\"10\\"/><path d=\\"M12 2a10 10 0 0 1 10 10\\"/></svg>\n        </span>\n      </button>\n      <button class=\\"btn btn-secondary\\" onclick=\\"clearSecretResults()\\" style=\\"padding:0.75rem 1.5rem\\">🗑️ Clear Results</button>\n      <button class=\\"btn btn-secondary\\" onclick=\\"exportSecretResults()\\" id=\\"export-secret-btn\\" style=\\"padding:0.75rem 1.5rem;display:none\\">📥 Export Results</button>\n    </div>\n\n    <!-- Scan Results -->\n    <div id=\\"secret-scan-results\\" style=\\"display:none\\">\n      <div class=\\"section-header\\" style=\\"margin-bottom:1rem;border-top:2px solid var(--divider);padding-top:1.5rem\\">\n        <h3>Scan Results</h3>\n        <span id=\\"scan-result-info\\" style=\\"font-size:0.72rem;color:var(--text-3)\\"></span>\n      </div>\n\n      <!-- Summary Stats -->\n      <div style=\\"display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-bottom:1.5rem\\">\n        <div class=\\"card\\" style=\\"text-align:center;padding:1rem\\">\n          <div style=\\"font-size:1.5rem;font-weight:700;color:var(--text-1)\\" id=\\"secrets-found-count\\">0</div>\n          <div style=\\"font-size:0.7rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em\\">Secrets Found</div>\n        </div>\n        <div class=\\"card\\" style=\\"text-align:center;padding:1rem\\">\n          <div style=\\"font-size:1.5rem;font-weight:700;color:var(--accent)\\" id=\\"scan-severity-high\\">0</div>\n          <div style=\\"font-size:0.7rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em\\">High Severity</div>\n        </div>\n        <div class=\\"card\\" style=\\"text-align:center;padding:1rem\\">\n          <div style=\\"font-size:1.5rem;font-weight:700;color:var(--success)\\" id=\\"scan-timestamp\\">—</div>\n          <div style=\\"font-size:0.7rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em\\">Last Scan</div>\n        </div>\n      </div>\n\n      <!-- Secrets Table -->\n      <div id=\\"secrets-table-container\\" style=\\"overflow-x:auto\\">\n        <table style=\\"width:100%;border-collapse:collapse;font-size:0.85rem\\">\n          <thead>\n            <tr style=\\"border-bottom:2px solid var(--divider);background:rgba(0,0,0,0.2)\\">\n              <th style=\\"text-align:left;padding:0.75rem;font-weight:600\\">Severity</th>\n              <th style=\\"text-align:left;padding:0.75rem;font-weight:600\\">What & Why</th>\n              <th style=\\"text-align:left;padding:0.75rem;font-weight:600\\">Location</th>\n              <th style=\\"text-align:left;padding:0.75rem;font-weight:600\\">What to Do</th>\n              <th style=\\"text-align:left;padding:0.75rem;font-weight:600\\">Value</th>\n              <th style=\\"text-align:left;padding:0.75rem;font-weight:600\\">Rule</th>\n            </tr>\n          </thead>\n          <tbody id=\\"secrets-table-body\\">\n            <tr style=\\"border-bottom:1px solid var(--divider)\\">\n              <td colspan=\\"6\\" style=\\"padding:2rem;text-align:center;color:var(--text-3)\\">\n                No secrets detected\n              </td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n\n      <!-- Raw Output -->\n      <div style=\\"margin-top:1.5rem;display:none\\" id=\\"raw-output-container\\">\n        <div class=\\"section-header\\" style=\\"margin-bottom:1rem;border-top:2px solid var(--divider);padding-top:1.5rem\\">\n          <h3>Raw Scan Output</h3>\n        </div>\n        <pre id=\\"raw-output\\" style=\\"background:rgba(0,0,0,0.5);padding:1rem;border-radius:8px;overflow-x:auto;max-height:400px;font-size:0.75rem;color:var(--text-3)\\"></pre>\n      </div>\n    </div>\n\n    <!-- No Results Yet -->\n    <div id=\\"secret-scan-empty\\" style=\\"text-align:center;padding:3rem;color:var(--text-3)\\">\n      <div style=\\"font-size:2rem;margin-bottom:1rem\\">🔍</div>\n      <p style=\\"margin:0;font-size:0.9rem\\">Run a secret scan to detect hardcoded credentials, API keys, and sensitive data in your codebase.</p>\n    </div>\n  </div>\n</div>\n\n<!-- TAB 5: CONFIGURATION                                   -->\n<!-- ═══════════════════════════════════════════════════════ -->\n<div id=\\"tab-config\\" class=\\"admin-tab-content\\" style=\\"display:none\\">\n\n  <!-- APPEARANCE TAB -->\n  <div id=\\"config-appearance\\" class=\\"admin-tab-subcontent\\" style=\\"display:none\\">\n    <div class=\\"card animate-fade-up\\" style=\\"margin-bottom:1.5rem\\">\n      <div class=\\"section-header\\">\n        <h3>Design Theme</h3>\n        <span style=\\"font-size:0.72rem;color:var(--text-3)\\">Choose a visual style for the platform</span>\n      </div>\n      <div style=\\"display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1rem\\">\n        <!-- Midnight Theme Card -->\n        <div id=\\"theme-card-midnight\\" onclick=\\"applyDesignTheme(\'midnight\')\\" style=\\"cursor:pointer;padding:1.25rem;border-radius:12px;border:2px solid var(--glass-border);background:var(--glass-bg);transition:all 0.2s\\">\n          <div style=\\"display:flex;align-items:center;gap:0.75rem;margin-bottom:0.75rem\\">\n            <div style=\\"width:36px;height:36px;border-radius:4px;background:#0a0a0f;display:flex;align-items:center;justify-content:center;border:1px solid rgba(16,185,129,0.3)\\">\n              <svg viewBox=\\"0 0 24 24\\" width=\\"18\\" height=\\"18\\" fill=\\"none\\" stroke=\\"#34d399\\" stroke-width=\\"2\\"><polyline points=\\"4 17 10 11 4 5\\"/><line x1=\\"12\\" y1=\\"19\\" x2=\\"20\\" y2=\\"19\\"/></svg>\n            </div>\n            <div>\n              <div style=\\"font-weight:600;color:var(--text-1);font-size:0.9rem\\">Midnight</div>\n              <div style=\\"font-size:0.72rem;color:var(--text-3)\\">Default</div>\n            </div>\n          </div>\n          <p style=\\"font-size:0.78rem;color:var(--text-3);margin:0;line-height:1.5\\">Dark terminal aesthetic, neon emerald accents, monospace type, sharp edges. Hacker-inspired and bold.</p>\n          <div style=\\"display:flex;gap:6px;margin-top:0.75rem\\">\n            <span style=\\"width:16px;height:16px;border-radius:50%;background:#10b981;border:2px solid var(--glass-border)\\"></span>\n            <span style=\\"width:16px;height:16px;border-radius:50%;background:#34d399;border:2px solid var(--glass-border)\\"></span>\n            <span style=\\"width:16px;height:16px;border-radius:50%;background:#0a0a0f;border:2px solid var(--glass-border)\\"></span>\n            <span style=\\"width:16px;height:16px;border-radius:50%;background:#d1fae5;border:2px solid var(--glass-border)\\"></span>\n          </div>\n        </div>\n        <!-- Aurora Theme Card -->\n        <div id=\\"theme-card-aurora\\" onclick=\\"applyDesignTheme(\'aurora\')\\" style=\\"cursor:pointer;padding:1.25rem;border-radius:12px;border:2px solid var(--glass-border);background:var(--glass-bg);transition:all 0.2s\\">\n          <div style=\\"display:flex;align-items:center;gap:0.75rem;margin-bottom:0.75rem\\">\n            <div style=\\"width:36px;height:36px;border-radius:14px;background:linear-gradient(135deg,#d97706,#f59e0b);display:flex;align-items:center;justify-content:center\\">\n              <svg viewBox=\\"0 0 24 24\\" width=\\"18\\" height=\\"18\\" fill=\\"none\\" stroke=\\"#fff\\" stroke-width=\\"2\\"><circle cx=\\"12\\" cy=\\"12\\" r=\\"5\\"/><line x1=\\"12\\" y1=\\"1\\" x2=\\"12\\" y2=\\"3\\"/><line x1=\\"12\\" y1=\\"21\\" x2=\\"12\\" y2=\\"23\\"/><line x1=\\"4.22\\" y1=\\"4.22\\" x2=\\"5.64\\" y2=\\"5.64\\"/><line x1=\\"18.36\\" y1=\\"18.36\\" x2=\\"19.78\\" y2=\\"19.78\\"/><line x1=\\"1\\" y1=\\"12\\" x2=\\"3\\" y2=\\"12\\"/><line x1=\\"21\\" y1=\\"12\\" x2=\\"23\\" y2=\\"12\\"/><line x1=\\"4.22\\" y1=\\"19.78\\" x2=\\"5.64\\" y2=\\"18.36\\"/><line x1=\\"18.36\\" y1=\\"5.64\\" x2=\\"19.78\\" y2=\\"4.22\\"/></svg>\n            </div>\n            <div>\n              <div style=\\"font-weight:600;color:var(--text-1);font-size:0.9rem\\">Aurora</div>\n              <div style=\\"font-size:0.72rem;color:var(--text-3)\\">Warm</div>\n            </div>\n          </div>\n          <p style=\\"font-size:0.78rem;color:var(--text-3);margin:0;line-height:1.5\\">Warm amber gradients, soft rounded surfaces, organic curves, rose-gold palette. Friendly and elegant.</p>\n          <div style=\\"display:flex;gap:6px;margin-top:0.75rem\\">\n            <span style=\\"width:16px;height:16px;border-radius:50%;background:#d97706;border:2px solid var(--glass-border)\\"></span>\n            <span style=\\"width:16px;height:16px;border-radius:50%;background:#f59e0b;border:2px solid var(--glass-border)\\"></span>\n            <span style=\\"width:16px;height:16px;border-radius:50%;background:#1c1917;border:2px solid var(--glass-border)\\"></span>\n            <span style=\\"width:16px;height:16px;border-radius:50%;background:#fef3c7;border:2px solid var(--glass-border)\\"></span>\n          </div>\n        </div>\n        <!-- shadcn Theme Card -->\n        <div id=\\"theme-card-softui\\" onclick=\\"applyDesignTheme(\'softui\')\\" style=\\"cursor:pointer;padding:1.25rem;border-radius:12px;border:2px solid var(--glass-border);background:var(--glass-bg);transition:all 0.2s\\">\n          <div style=\\"display:flex;align-items:center;gap:0.75rem;margin-bottom:0.75rem\\">\n            <div style=\\"width:36px;height:36px;border-radius:8px;background:#18181b;display:flex;align-items:center;justify-content:center\\">\n              <svg viewBox=\\"0 0 24 24\\" width=\\"18\\" height=\\"18\\" fill=\\"none\\" stroke=\\"#fafafa\\" stroke-width=\\"2\\"><rect x=\\"3\\" y=\\"3\\" width=\\"7\\" height=\\"7\\" rx=\\"1\\"/><rect x=\\"14\\" y=\\"3\\" width=\\"7\\" height=\\"7\\" rx=\\"1\\"/><rect x=\\"3\\" y=\\"14\\" width=\\"7\\" height=\\"7\\" rx=\\"1\\"/><rect x=\\"14\\" y=\\"14\\" width=\\"7\\" height=\\"7\\" rx=\\"1\\"/></svg>\n            </div>\n            <div>\n              <div style=\\"font-weight:600;color:var(--text-1);font-size:0.9rem\\">shadcn</div>\n              <div style=\\"font-size:0.72rem;color:var(--text-3)\\">Minimal</div>\n            </div>\n          </div>\n          <p style=\\"font-size:0.78rem;color:var(--text-3);margin:0;line-height:1.5\\">Clean borders, neutral palette, precise typography. Inspired by shadcn/ui design system.</p>\n          <div style=\\"display:flex;gap:6px;margin-top:0.75rem\\">\n            <span style=\\"width:16px;height:16px;border-radius:50%;background:#18181b;border:2px solid var(--glass-border)\\"></span>\n            <span style=\\"width:16px;height:16px;border-radius:50%;background:#71717a;border:2px solid var(--glass-border)\\"></span>\n            <span style=\\"width:16px;height:16px;border-radius:50%;background:#e4e4e7;border:2px solid var(--glass-border)\\"></span>\n            <span style=\\"width:16px;height:16px;border-radius:50%;background:#fafafa;border:2px solid var(--glass-border)\\"></span>\n          </div>\n        </div>\n        <!-- Liquid Glass Theme Card -->\n        <div id=\\"theme-card-horizon\\" onclick=\\"applyDesignTheme(\'horizon\')\\" style=\\"cursor:pointer;padding:1.25rem;border-radius:12px;border:2px solid var(--glass-border);background:var(--glass-bg);transition:all 0.2s\\">\n          <div style=\\"display:flex;align-items:center;gap:0.75rem;margin-bottom:0.75rem\\">\n            <div style=\\"width:36px;height:36px;border-radius:12px;background:linear-gradient(135deg,#007aff,#5ac8fa,#af52de);display:flex;align-items:center;justify-content:center;backdrop-filter:blur(8px)\\">\n              <svg viewBox=\\"0 0 24 24\\" width=\\"18\\" height=\\"18\\" fill=\\"none\\" stroke=\\"#fff\\" stroke-width=\\"2\\"><circle cx=\\"12\\" cy=\\"12\\" r=\\"10\\"/><path d=\\"M12 2a10 10 0 0 1 0 20\\"/><path d=\\"M8 12c0-3 2-6 4-8\\"/><path d=\\"M16 12c0 3-2 6-4 8\\"/></svg>\n            </div>\n            <div>\n              <div style=\\"font-weight:600;color:var(--text-1);font-size:0.9rem\\">Liquid Glass</div>\n              <div style=\\"font-size:0.72rem;color:var(--text-3)\\">Apple-inspired</div>\n            </div>\n          </div>\n          <p style=\\"font-size:0.78rem;color:var(--text-3);margin:0;line-height:1.5\\">Frosted translucency, specular highlights, refractive surfaces, depth through light. Apple Liquid Glass inspired.</p>\n          <div style=\\"display:flex;gap:6px;margin-top:0.75rem\\">\n            <span style=\\"width:16px;height:16px;border-radius:50%;background:#007aff;border:2px solid var(--glass-border)\\"></span>\n            <span style=\\"width:16px;height:16px;border-radius:50%;background:#5ac8fa;border:2px solid var(--glass-border)\\"></span>\n            <span style=\\"width:16px;height:16px;border-radius:50%;background:#af52de;border:2px solid var(--glass-border)\\"></span>\n            <span style=\\"width:16px;height:16px;border-radius:50%;background:rgba(255,255,255,0.55);border:2px solid var(--glass-border)\\"></span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- ACCESS CONTROL TAB -->\n  <div id=\\"config-access\\" class=\\"admin-tab-subcontent\\" style=\\"display:none\\">\n    <!-- SSO / OAuth Configuration -->\n    <div class=\\"card animate-fade-up\\" style=\\"margin-bottom:1.5rem\\">\n      <div class=\\"section-header\\">\n        <h3>SSO / OAuth Providers</h3>\n        <button class=\\"btn btn-secondary btn-sm\\" onclick=\\"loadSSOStatus()\\">Refresh</button>\n      </div>\n      <p style=\\"font-size:0.78rem;color:var(--text-3);margin:0.5rem 0 1rem\\">Configure Single Sign-On providers for the login page. Credentials are <strong style=\\"color:var(--success)\\">encrypted at rest</strong> (AES-256-GCM) and OAuth flows use <strong style=\\"color:var(--success)\\">PKCE</strong> + time-limited state tokens for maximum security.</p>\n      <div id=\\"sso-status-grid\\" style=\\"display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem\\">\n        <!-- Google -->\n        <div id=\\"sso-card-google\\" style=\\"padding:1.25rem;border-radius:12px;border:1px solid var(--glass-border);background:var(--glass-bg)\\">\n          <div style=\\"display:flex;align-items:center;gap:0.75rem;margin-bottom:0.75rem\\">\n            <div style=\\"width:36px;height:36px;border-radius:10px;background:#fff;border:1px solid #e5e7eb;display:flex;align-items:center;justify-content:center\\">\n              <svg viewBox=\\"0 0 24 24\\" width=\\"18\\" height=\\"18\\"><path d=\\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z\\" fill=\\"#4285F4\\"/><path d=\\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\\" fill=\\"#34A853\\"/><path d=\\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\\" fill=\\"#FBBC05\\"/><path d=\\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\\" fill=\\"#EA4335\\"/></svg>\n            </div>\n            <div style=\\"flex:1\\">\n              <div style=\\"font-weight:600;color:var(--text-1);font-size:0.88rem\\">Google</div>\n              <div id=\\"sso-google-status\\" style=\\"font-size:0.72rem;color:var(--text-3)\\">Checking...</div>\n            </div>\n            <button class=\\"btn btn-secondary btn-sm\\" style=\\"font-size:0.68rem;padding:3px 8px\\" onclick=\\"toggleSSOForm(\'google\')\\">Configure</button>\n          </div>\n          <div id=\\"sso-form-google\\" style=\\"display:none;margin-top:0.5rem\\">\n            <div style=\\"margin-bottom:0.5rem\\">\n              <label style=\\"font-size:0.7rem;color:var(--text-3);display:block;margin-bottom:3px\\">Client ID</label>\n              <input id=\\"sso-google-id\\" class=\\"input\\" style=\\"width:100%;font-size:0.75rem;padding:5px 8px\\" placeholder=\\"Google Client ID\\" autocomplete=\\"off\\">\n            </div>\n            <div style=\\"margin-bottom:0.65rem\\">\n              <label style=\\"font-size:0.7rem;color:var(--text-3);display:block;margin-bottom:3px\\">Client Secret</label>\n              <input id=\\"sso-google-secret\\" class=\\"input\\" type=\\"password\\" style=\\"width:100%;font-size:0.75rem;padding:5px 8px\\" placeholder=\\"Google Client Secret\\" autocomplete=\\"off\\">\n            </div>\n            <button class=\\"btn btn-primary btn-sm\\" style=\\"width:100%;font-size:0.73rem\\" onclick=\\"saveSSO(\'google\')\\">Save Google SSO</button>\n          </div>\n          <div style=\\"font-size:0.72rem;color:var(--text-3);line-height:1.5;margin-top:0.5rem\\">\n            <code style=\\"font-size:0.68rem\\">SSO_GOOGLE_CLIENT_ID</code><br>\n            <code style=\\"font-size:0.68rem\\">SSO_GOOGLE_CLIENT_SECRET</code>\n          </div>\n        </div>\n        <!-- GitHub -->\n        <div id=\\"sso-card-github\\" style=\\"padding:1.25rem;border-radius:12px;border:1px solid var(--glass-border);background:var(--glass-bg)\\">\n          <div style=\\"display:flex;align-items:center;gap:0.75rem;margin-bottom:0.75rem\\">\n            <div style=\\"width:36px;height:36px;border-radius:10px;background:#24292e;display:flex;align-items:center;justify-content:center\\">\n              <svg viewBox=\\"0 0 24 24\\" width=\\"18\\" height=\\"18\\" fill=\\"#fff\\"><path d=\\"M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z\\"/></svg>\n            </div>\n            <div style=\\"flex:1\\">\n              <div style=\\"font-weight:600;color:var(--text-1);font-size:0.88rem\\">GitHub</div>\n              <div id=\\"sso-github-status\\" style=\\"font-size:0.72rem;color:var(--text-3)\\">Checking...</div>\n            </div>\n            <button class=\\"btn btn-secondary btn-sm\\" style=\\"font-size:0.68rem;padding:3px 8px\\" onclick=\\"toggleSSOForm(\'github\')\\">Configure</button>\n          </div>\n          <div id=\\"sso-form-github\\" style=\\"display:none;margin-top:0.5rem\\">\n            <div style=\\"margin-bottom:0.5rem\\">\n              <label style=\\"font-size:0.7rem;color:var(--text-3);display:block;margin-bottom:3px\\">Client ID</label>\n              <input id=\\"sso-github-id\\" class=\\"input\\" style=\\"width:100%;font-size:0.75rem;padding:5px 8px\\" placeholder=\\"GitHub Client ID\\" autocomplete=\\"off\\">\n            </div>\n            <div style=\\"margin-bottom:0.65rem\\">\n              <label style=\\"font-size:0.7rem;color:var(--text-3);display:block;margin-bottom:3px\\">Client Secret</label>\n              <input id=\\"sso-github-secret\\" class=\\"input\\" type=\\"password\\" style=\\"width:100%;font-size:0.75rem;padding:5px 8px\\" placeholder=\\"GitHub Client Secret\\" autocomplete=\\"off\\">\n            </div>\n            <button class=\\"btn btn-primary btn-sm\\" style=\\"width:100%;font-size:0.73rem\\" onclick=\\"saveSSO(\'github\')\\">Save GitHub SSO</button>\n          </div>\n          <div style=\\"font-size:0.72rem;color:var(--text-3);line-height:1.5;margin-top:0.5rem\\">\n            <code style=\\"font-size:0.68rem\\">SSO_GITHUB_CLIENT_ID</code><br>\n            <code style=\\"font-size:0.68rem\\">SSO_GITHUB_CLIENT_SECRET</code>\n          </div>\n        </div>\n        <!-- Microsoft -->\n        <div id=\\"sso-card-microsoft\\" style=\\"padding:1.25rem;border-radius:12px;border:1px solid var(--glass-border);background:var(--glass-bg)\\">\n          <div style=\\"display:flex;align-items:center;gap:0.75rem;margin-bottom:0.75rem\\">\n            <div style=\\"width:36px;height:36px;border-radius:10px;background:#fff;border:1px solid #e5e7eb;display:flex;align-items:center;justify-content:center\\">\n              <svg viewBox=\\"0 0 24 24\\" width=\\"16\\" height=\\"16\\"><rect x=\\"1\\" y=\\"1\\" width=\\"10\\" height=\\"10\\" fill=\\"#f25022\\"/><rect x=\\"13\\" y=\\"1\\" width=\\"10\\" height=\\"10\\" fill=\\"#7fba00\\"/><rect x=\\"1\\" y=\\"13\\" width=\\"10\\" height=\\"10\\" fill=\\"#00a4ef\\"/><rect x=\\"13\\" y=\\"13\\" width=\\"10\\" height=\\"10\\" fill=\\"#ffb900\\"/></svg>\n            </div>\n            <div style=\\"flex:1\\">\n              <div style=\\"font-weight:600;color:var(--text-1);font-size:0.88rem\\">Microsoft</div>\n              <div id=\\"sso-microsoft-status\\" style=\\"font-size:0.72rem;color:var(--text-3)\\">Checking...</div>\n            </div>\n            <button class=\\"btn btn-secondary btn-sm\\" style=\\"font-size:0.68rem;padding:3px 8px\\" onclick=\\"toggleSSOForm(\'microsoft\')\\">Configure</button>\n          </div>\n          <div id=\\"sso-form-microsoft\\" style=\\"display:none;margin-top:0.5rem\\">\n            <div style=\\"margin-bottom:0.5rem\\">\n              <label style=\\"font-size:0.7rem;color:var(--text-3);display:block;margin-bottom:3px\\">Client ID</label>\n              <input id=\\"sso-microsoft-id\\" class=\\"input\\" style=\\"width:100%;font-size:0.75rem;padding:5px 8px\\" placeholder=\\"Microsoft Client ID\\" autocomplete=\\"off\\">\n            </div>\n            <div style=\\"margin-bottom:0.65rem\\">\n              <label style=\\"font-size:0.7rem;color:var(--text-3);display:block;margin-bottom:3px\\">Client Secret</label>\n              <input id=\\"sso-microsoft-secret\\" class=\\"input\\" type=\\"password\\" style=\\"width:100%;font-size:0.75rem;padding:5px 8px\\" placeholder=\\"Microsoft Client Secret\\" autocomplete=\\"off\\">\n            </div>\n            <button class=\\"btn btn-primary btn-sm\\" style=\\"width:100%;font-size:0.73rem\\" onclick=\\"saveSSO(\'microsoft\')\\">Save Microsoft SSO</button>\n          </div>\n          <div style=\\"font-size:0.72rem;color:var(--text-3);line-height:1.5;margin-top:0.5rem\\">\n            <code style=\\"font-size:0.68rem\\">SSO_MICROSOFT_CLIENT_ID</code><br>\n            <code style=\\"font-size:0.68rem\\">SSO_MICROSOFT_CLIENT_SECRET</code>\n          </div>\n        </div>\n      </div>\n      <div style=\\"margin-top:1rem;padding:0.85rem 1rem;border-radius:8px;background:var(--badge-bg);border:1px solid var(--badge-border)\\">\n        <p style=\\"font-size:0.75rem;color:var(--text-2);margin:0;line-height:1.6\\"><strong>Setup:</strong> Register an OAuth app with each provider, set the callback URL to <code style=\\"font-size:0.68rem\\">&lt;your-domain&gt;/auth/sso/&lt;provider&gt;/callback</code>, then use the <strong>Configure</strong> button above to enter your credentials. Also set <code style=\\"font-size:0.68rem\\">SSO_BASE_URL</code> to your public URL.</p>\n        <div style=\\"margin-top:0.6rem;padding-top:0.6rem;border-top:1px solid var(--divider)\\">\n          <p style=\\"font-size:0.72rem;color:var(--text-3);margin:0;line-height:1.6\\">\n            <svg viewBox=\\"0 0 24 24\\" width=\\"12\\" height=\\"12\\" fill=\\"none\\" stroke=\\"currentColor\\" stroke-width=\\"2\\" style=\\"vertical-align:-2px;margin-right:3px\\"><path d=\\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\\"/></svg>\n            <strong>Security:</strong> Set <code style=\\"font-size:0.66rem\\">SSO_ENCRYPTION_KEY</code> (64-char hex) for production encryption. Set <code style=\\"font-size:0.66rem\\">SESSION_SECRET</code> for stable sessions. Enable <code style=\\"font-size:0.66rem\\">secure: true</code> cookies behind HTTPS.\n          </p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Security Considerations -->\n    <div class=\\"card animate-fade-up\\" style=\\"margin-bottom:1.5rem\\">\n      <div class=\\"section-header\\">\n        <h3>Security Considerations</h3>\n        <div>\n          <button class=\\"btn btn-secondary btn-sm\\" onclick=\\"loadSecurityConsiderations()\\">Refresh</button>\n          <button class=\\"btn btn-primary btn-sm\\" onclick=\\"saveSecurityConsiderations()\\" style=\\"margin-left:0.5rem\\">Save</button>\n        </div>\n      </div>\n      <div style=\\"background:rgba(239,68,68,0.05);border:1px solid rgba(239,68,68,0.15);border-radius:8px;padding:0.75rem 1rem;margin-top:0.75rem\\">\n        <textarea id=\\"security-editor\\" class=\\"input\\" rows=\\"12\\" placeholder=\\"One security consideration per line...\\" style=\\"width:100%;font-size:0.78rem;line-height:1.6;resize:vertical;font-family:var(--font-mono)\\"></textarea>\n        <div style=\\"display:flex;gap:0.5rem;margin-top:0.5rem;align-items:center\\">\n          <button class=\\"btn btn-sm\\" onclick=\\"resetSecurityConsiderations()\\" style=\\"font-size:0.72rem;padding:0.2rem 0.6rem;color:#ef4444;border-color:#ef444444\\">Reset to Defaults</button>\n          <span style=\\"margin-left:auto;font-size:0.68rem;color:var(--text-3)\\">One item per line. These are security best practices displayed across the platform.</span>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- SYSTEM CONFIG TAB -->\n  <div id=\\"config-system\\" class=\\"admin-tab-subcontent\\" style=\\"display:none\\">\n    <!-- UI/UX Settings -->\n    <div class=\\"card animate-fade-up\\" style=\\"margin-bottom:1.5rem\\">\n      <div class=\\"section-header\\">\n        <h3>UI/UX Settings</h3>\n        <span style=\\"font-size:0.72rem;color:var(--text-3)\\">Control visual elements and animations</span>\n      </div>\n      \n      <div style=\\"margin-top:1rem;padding:1rem;background:var(--input-bg);border:1px solid var(--border);border-radius:8px\\">\n        <div style=\\"display:flex;align-items:center;justify-content:space-between;gap:1rem\\">\n          <div>\n            <div style=\\"font-weight:600;color:var(--text-1);margin-bottom:0.25rem\\">🎬 Intro Gate Animation</div>\n            <div style=\\"font-size:0.75rem;color:var(--text-3)\\">Show boot sequence animation on first visit to login page</div>\n          </div>\n          <div style=\\"display:flex;align-items:center;gap:0.5rem\\">\n            <input type=\\"checkbox\\" id=\\"intro-gate-toggle\\" style=\\"width:20px;height:20px;cursor:pointer;accent-color:var(--accent)\\" onchange=\\"saveUISettings()\\">\n            <label for=\\"intro-gate-toggle\\" style=\\"cursor:pointer;font-size:0.85rem;font-weight:500\\" id=\\"intro-gate-status\\">Enabled</label>\n          </div>\n        </div>\n      </div>\n      \n      <div style=\\"margin-top:0.75rem;padding:0.75rem;background:rgba(59,130,246,0.08);border:1px solid rgba(59,130,246,0.2);border-radius:6px;font-size:0.72rem;color:var(--text-3)\\">\n        💡 When enabled: Shows animated boot sequence (1.5s) on first visit  \n        <br/>When disabled: Goes directly to login form\n      </div>\n    </div>\n\n    <!-- Global Constraints -->\n    <div class=\\"card animate-fade-up\\" style=\\"margin-bottom:1.5rem\\">\n      <div class=\\"section-header\\">\n        <h3>Global Constraints</h3>\n        <div>\n          <button class=\\"btn btn-secondary btn-sm\\" onclick=\\"loadGlobalConstraints()\\">Refresh</button>\n          <button class=\\"btn btn-primary btn-sm\\" onclick=\\"saveGlobalConstraints()\\" style=\\"margin-left:0.5rem\\">Save</button>\n        </div>\n      </div>\n      <div style=\\"margin-top:0.75rem\\">\n        <textarea id=\\"global-constraints-editor\\" class=\\"input\\" style=\\"width:100%;min-height:200px;font-family:var(--font-mono);font-size:0.78rem;resize:vertical\\" placeholder=\\"Loading constraints...\\"></textarea>\n        <p style=\\"font-size:0.68rem;color:var(--text-3);margin-top:0.35rem\\">JSON format. These constraints apply to all agents globally (e.g. content policies, response length limits).</p>\n      </div>\n    </div>\n\n    <!-- Best Practices -->\n    <div class=\\"card animate-fade-up\\">\n      <div class=\\"section-header\\">\n        <h3>Best Practices</h3>\n        <div>\n          <button class=\\"btn btn-secondary btn-sm\\" onclick=\\"loadBestPractices()\\">Refresh</button>\n          <button class=\\"btn btn-primary btn-sm\\" onclick=\\"saveBestPractices()\\" style=\\"margin-left:0.5rem\\">Save</button>\n        </div>\n      </div>\n      <div style=\\"background:rgba(34,197,94,0.05);border:1px solid rgba(34,197,94,0.15);border-radius:8px;padding:0.75rem 1rem;margin-top:0.75rem\\">\n        <textarea id=\\"best-practices-editor\\" class=\\"input\\" rows=\\"12\\" placeholder=\\"One best practice per line...\\" style=\\"width:100%;font-size:0.78rem;line-height:1.6;resize:vertical;font-family:var(--font-mono)\\"></textarea>\n        <div style=\\"display:flex;gap:0.5rem;margin-top:0.5rem;align-items:center\\">\n          <button class=\\"btn btn-sm\\" onclick=\\"resetBestPractices()\\" style=\\"font-size:0.72rem;padding:0.2rem 0.6rem;color:#ef4444;border-color:#ef444444\\">Reset to Defaults</button>\n          <span style=\\"margin-left:auto;font-size:0.68rem;color:var(--text-3)\\">One practice per line. These appear as guidance on the Skills page.</span>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- GUARDRAILS & WORKFLOWS TAB -->\n  <div id=\\"config-extensions\\" class=\\"admin-tab-subcontent\\" style=\\"display:none\\">\n    <!-- Guardrails Registry -->\n    <div class=\\"card animate-fade-up\\" style=\\"margin-bottom:1.5rem\\">\n      <div class=\\"section-header\\">\n        <h3>Guardrails Registry</h3>\n        <button class=\\"btn btn-secondary btn-sm\\" onclick=\\"loadGuardrails()\\">Refresh</button>\n      </div>\n      <p style=\\"font-size:0.75rem;color:var(--text-3);margin:0.5rem 0 1rem\\">Guardrails are rules that constrain agent behavior. Manage them from the <a href=\\"/guardrails\\" style=\\"color:var(--accent-text)\\">Guardrails</a> page.</p>\n      <div id=\\"guardrails-list\\" class=\\"mt-1\\" style=\\"color:var(--text-3);font-size:0.82rem\\">Loading...</div>\n    </div>\n\n    <!-- n8n Workflows -->\n    <div class=\\"card animate-fade-up\\">\n      <div class=\\"section-header\\">\n        <h3>n8n Workflows</h3>\n        <button class=\\"btn btn-secondary btn-sm\\" onclick=\\"loadN8nWorkflows()\\">Refresh</button>\n      </div>\n      <p style=\\"font-size:0.75rem;color:var(--text-3);margin:0.5rem 0 1rem\\">Active workflows from n8n. Manage and build new workflows at <a href=\\"http://localhost:5678\\" target=\\"_blank\\" style=\\"color:var(--accent-text)\\">n8n Console</a>.</p>\n      <div id=\\"n8n-workflows\\" class=\\"mt-1\\" style=\\"color:var(--text-3);font-size:0.82rem\\">Loading...</div>\n    </div>\n  </div>\n\n  <!-- EXTERNAL LINKS TAB -->\n  <div id=\\"config-links\\" class=\\"admin-tab-subcontent\\" style=\\"display:none\\">\n    <div class=\\"card animate-fade-up\\">\n      <h3>External Links & Services</h3>\n      <p style=\\"font-size:0.75rem;color:var(--text-3);margin:0.5rem 0 1rem\\">Quick access to monitoring, logging, and configuration dashboards for external services.</p>\n      <div style=\\"display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.75rem;margin-top:0.75rem\\">\n        <a href=\\"http://localhost:3001\\" target=\\"_blank\\" style=\\"display:flex;flex-direction:column;align-items:flex-start;gap:0.5rem;padding:1rem;background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:8px;text-decoration:none;color:var(--text-1);transition:all 0.2s\\" onmouseover=\\"this.style.borderColor=\'var(--accent-border)\'\\" onmouseout=\\"this.style.borderColor=\'var(--glass-border)\'\\" >\n          <div style=\\"display:flex;align-items:center;gap:0.5rem;width:100%\\">\n            <svg viewBox=\\"0 0 24 24\\" width=\\"20\\" height=\\"20\\" fill=\\"none\\" stroke=\\"#f59e0b\\" stroke-width=\\"2\\"><rect x=\\"3\\" y=\\"3\\" width=\\"18\\" height=\\"18\\" rx=\\"2\\" ry=\\"2\\"/><line x1=\\"3\\" y1=\\"9\\" x2=\\"21\\" y2=\\"9\\"/><line x1=\\"9\\" y1=\\"21\\" x2=\\"9\\" y2=\\"9\\"/></svg>\n            <span style=\\"font-weight:600;color:var(--text-1);font-size:0.85rem\\">Grafana</span>\n          </div>\n          <span style=\\"font-si