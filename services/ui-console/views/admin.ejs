    @media (max-width:640px) { .tc-panel { width:100%; } .tc-activity-rail { width:130px; } }
    .tc-panel.tc-fullscreen { width:100% !important; }
    .tc-panel.tc-fullscreen .tc-activity-rail { width:220px; }
    .tc-panel.tc-fullscreen .tc-messages .tc-msg { max-width:70%; }
  </style>

  <script>
    /* ── Test Chat Panel Logic ── */
    var TC_NL = String.fromCharCode(10);
    var TC_STATE_KEY = 'testChatState';
    var tcSessionId = '';
    var tcMessages = [];
    var tcIsOpen = false;
    var tcConfigOpen = false;
    var tcFlowSteps = [];
    var tcStartTime = null;
    var tcElapsedTimer = null;
    var tcActiveModel = '';
    var _tcAbortController = null;
    var tcLastPrompt = '';
    var tcGuardrailData = { input: [], output: [] };
    var tcTraceId = '';
    var tcRequestId = '';
    var tcIsFullscreen = false;

    function stopTestChat() {
      if (_tcAbortController) {
        _tcAbortController.abort();
        _tcAbortController = null;
      }
      document.getElementById('tc-send').disabled = false;
      document.getElementById('tc-send').style.display = '';
      document.getElementById('tc-stop').style.display = 'none';
      stopElapsedTimer();
    }

    function toggleTestChat() {
      var panel = document.getElementById('test-chat-panel');
      var fab = document.getElementById('test-chat-fab');
      tcIsOpen = !tcIsOpen;
      panel.style.display = tcIsOpen ? 'flex' : 'none';
      fab.classList.toggle('active', tcIsOpen);
      if (tcIsOpen) {
        loadTCAgents();
        loadTCModels();
        document.getElementById('tc-prompt').focus();
      }
      saveTCState();
    }

    function toggleTCConfig() {
      tcConfigOpen = !tcConfigOpen;
      document.getElementById('tc-config').style.display = tcConfigOpen ? 'flex' : 'none';
      document.getElementById('tc-config-toggle').classList.toggle('active', tcConfigOpen);
    }

    function applyTCSettings() {
      var temp = document.getElementById('tc-temp').value;
      var topP = document.getElementById('tc-top-p').value;
      var maxTokens = document.getElementById('tc-max-tokens').value;
      var kb = document.getElementById('tc-use-kb').checked ? 'ON' : 'OFF';
      showToast('Settings applied — Temp: ' + temp + ', Top P: ' + topP + ', Max Tokens: ' + maxTokens + ', KB: ' + kb, 'success');
      toggleTCConfig();
    }

    document.getElementById('tc-temp').addEventListener('input', function() {
      document.getElementById('tc-temp-val').textContent = this.value;
    });

    document.getElementById('tc-top-p').addEventListener('input', function() {
      document.getElementById('tc-top-p-val').textContent = this.value;
    });

    function clearTestChat() {
      tcSessionId = 'tc-' + Math.random().toString(36).slice(2, 8);
      tcMessages = [];
      tcFlowSteps = [];
      tcActiveModel = '';
      stopElapsedTimer();
      renderTCMessages();
      document.getElementById('tc-activity-rail').style.display = 'none';
      document.getElementById('tc-flowchart').innerHTML = '';
      document.getElementById('tc-activity-summary').style.display = 'none';
      document.getElementById('tc-activity-model').style.display = 'none';
      document.getElementById('tc-model-badge').style.display = 'none';
      document.getElementById('tc-elapsed').textContent = '';
      saveTCState();
    }

    function renderTCMessages() {
      var el = document.getElementById('tc-messages');
      if (tcMessages.length === 0) {
        el.innerHTML = '<div style="text-align:center;color:var(--text-3);font-size:0.8rem;margin:auto;padding:2rem 1rem">' +
          '<div class="tc-header-icon" style="margin:0 auto 0.75rem;width:48px;height:48px;border-radius:14px">' +
            '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>' +
          '</div>' +
          '<p style="font-weight:600;color:var(--text-2);margin-bottom:0.25rem;font-size:0.88rem">Test your agent</p>' +
          '<p style="font-size:0.74rem;opacity:0.7;max-width:220px;margin:0 auto">Configure model and settings, then start chatting</p></div>';
        return;
      }
      var html = '';
      tcMessages.forEach(function(m, i) {
        var isUser = m.role === 'user';
        var isStreaming = !isUser && i === tcMessages.length - 1 && m.content === '' && document.getElementById('tc-send').disabled;
        html += '<div class="tc-msg-group">';
        html += '<span class="tc-msg-label tc-msg-label-' + (isUser ? 'user' : 'assistant') + '">' + (isUser ? 'You' : 'Agent') + '</span>';
        if (isStreaming) {
          html += '<div class="tc-typing"><div class="tc-typing-dot"></div><div class="tc-typing-dot"></div><div class="tc-typing-dot"></div></div>';
        } else {
          html += '<div class="tc-msg tc-msg-' + (isUser ? 'user' : 'assistant') + '" style="position:relative">' + escapeHtml(m.content || '...');
          if (!isUser && m.content) {
            html += '<button onclick="copyTCMessage(' + i + ')" title="Copy" style="position:absolute;top:4px;right:4px;background:none;border:none;color:var(--text-3);cursor:pointer;padding:3px;border-radius:4px;opacity:0.5;transition:opacity 0.15s" onmouseenter="this.style.opacity=1" onmouseleave="this.style.opacity=0.5"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button>';
          }
          html += '</div>';
        }
        if (m.time) {
          html += '<span class="tc-msg-meta' + (isUser ? ' tc-msg-meta-user' : '') + '">' + escapeHtml(m.time) + '</span>';
        }
        html += '</div>';
      });
      el.innerHTML = html;
      el.scrollTop = el.scrollHeight;
      /* Show/hide regenerate button */
      var regenBtn = document.getElementById('tc-regen');
      if (regenBtn) regenBtn.style.display = tcLastPrompt && tcMessages.length > 0 ? '' : 'none';
    }

    function renderFlowchart() {
      var el = document.getElementById('tc-flowchart');
      var html = '';
      var totalMs = 0;
      tcFlowSteps.forEach(function(s, i) {
        var isLast = i === tcFlowSteps.length - 1;
        var stateClass = s.done ? 'done' : (s.running ? 'running' : 'waiting');
        var connClass = s.done ? 'done' : (s.running ? 'running' : '');
        if (s.durationMs) totalMs += s.durationMs;
        html += '<div class="tc-flow-step">';
        html += '<div class="tc-flow-line">';
        html += '<div class="tc-flow-dot ' + stateClass + '"></div>';
        if (!isLast) html += '<div class="tc-flow-connector ' + connClass + '"></div>';
        html += '</div>';
        html += '<div class="tc-flow-info">';
        html += '<div class="tc-flow-label ' + stateClass + '">' + escapeHtml(s.icon + ' ' + s.label) + '</div>';
        if (s.detail) html += '<div class="tc-flow-detail">' + escapeHtml(s.detail) + '</div>';
        if (s.time) html += '<div class="tc-flow-time">' + escapeHtml(s.time) + '</div>';
        html += '</div></div>';
      });
      el.innerHTML = html;
    }

    function startElapsedTimer() {
      tcStartTime = Date.now();
      var elEl = document.getElementById('tc-elapsed');
      stopElapsedTimer();
      tcElapsedTimer = setInterval(function() {
        var sec = ((Date.now() - tcStartTime) / 1000).toFixed(1);
        elEl.textContent = sec + 's';
      }, 100);
    }

    function stopElapsedTimer() {
      if (tcElapsedTimer) { clearInterval(tcElapsedTimer); tcElapsedTimer = null; }
    }

    function _tcEstimateCost(usage, modelStr) {
      if (!usage || !usage.total_tokens) return null;
      var m = (modelStr || '').toLowerCase();
      var pricing = {
        'gpt-4o': [2.50, 10.00],
        'gpt-4o-mini': [0.15, 0.60],
        'gpt-4.1': [2.00, 8.00],
        'gpt-4.1-mini': [0.40, 1.60],
        'gpt-4.1-nano': [0.10, 0.40],
        'gpt-5-nano': [0.10, 0.40],
        'gpt-5.4-mini': [0.40, 1.60],
        'gpt-3.5-turbo': [0.50, 1.50]
      };
      var rate = null;
      for (var key in pricing) {
        if (m.indexOf(key) !== -1) { rate = pricing[key]; break; }
      }
      if (!rate) return null;
      return (usage.prompt_tokens * rate[0] / 1e6) + (usage.completion_tokens * rate[1] / 1e6);
    }

    function showActivitySummary(totalMs, usageData, modelStr) {
      var el = document.getElementById('tc-activity-summary');
      var steps = tcFlowSteps.length;
      var html = '<div class="summary-row"><span class="summary-label">Steps</span><span class="summary-value">' + steps + '</span></div>';
      html += '<div class="summary-row"><span class="summary-label">Total</span><span class="summary-value">' + (totalMs / 1000).toFixed(2) + 's</span></div>';
      if (tcActiveModel) {
        html += '<div class="summary-row"><span class="summary-label">Model</span><span class="summary-value">' + escapeHtml(tcActiveModel) + '</span></div>';
      }
      if (usageData && usageData.total_tokens) {
        html += '<div class="summary-row"><span class="summary-label">Tokens</span><span class="summary-value">' + usageData.prompt_tokens + ' in / ' + usageData.completion_tokens + ' out (' + usageData.total_tokens + ')</span></div>';
        var cost = _tcEstimateCost(usageData, modelStr || tcActiveModel);
        if (cost !== null) {
          html += '<div class="summary-row"><span class="summary-label">Est. Cost</span><span class="summary-value">~$' + cost.toFixed(6) + '</span></div>';
        }
      }
      el.innerHTML = html;
      el.style.display = 'block';
    }

    async function loadTCAgents() {
      var sel = document.getElementById('tc-agent');
      if (sel.options.length > 1) return;
      try {
        var r = await fetch('/api/agents');
        var d = await r.json();
        var agents = d.agents || [];
        sel.innerHTML = '<option value="">Default agent</option>';
        agents.forEach(function(a) {
          var opt = document.createElement('option');
          opt.value = a.id;
          opt.textContent = a.name;
          if (a.is_default) opt.selected = true;
          sel.appendChild(opt);
        });
      } catch(e) {
        sel.innerHTML = '<option value="">Failed to load</option>';
      }
    }

    async function loadTCModels() {
      var sel = document.getElementById('tc-model');
      if (sel.options.length > 1) return;
      try {
        var r = await fetch('/api/models');
        var d = await r.json();
        var models = d.models || [];
        sel.innerHTML = '<option value="">Platform default</option>';
        models.forEach(function(m) {
          if (m.model === 'nomic-embed-text') return;
          var opt = document.createElement('option');
          opt.value = m.provider + ':' + m.model;
          opt.textContent = m.model + ' (' + m.provider + ')';
          if (m.active) opt.textContent += ' *';
          sel.appendChild(opt);
        });
      } catch(e) {}
    }

    async function sendTestChat() {
      var promptEl = document.getElementById('tc-prompt');
      var prompt = promptEl.value.trim();
      if (!prompt) return;

      if (!tcSessionId) tcSessionId = 'tc-' + Math.random().toString(36).slice(2, 8);
      tcLastPrompt = prompt;

      var now = new Date();
      var timeStr = now.getHours().toString().padStart(2,'0') + ':' + now.getMinutes().toString().padStart(2,'0');
      tcMessages.push({ role: 'user', content: prompt, time: timeStr });
      renderTCMessages();
      promptEl.value = '';

      var sendBtn = document.getElementById('tc-send');
      sendBtn.disabled = true;
      document.getElementById('tc-stop').style.display = '';

      /* Build payload with config parameters */
      var payload = { prompt: prompt, sessionId: tcSessionId };

      var agentId = document.getElementById('tc-agent').value;
      if (agentId) payload.agent_id = agentId;

      /* Include temperature, top_p, max_completion_tokens, use_kb from settings */
      payload.temperature = parseFloat(document.getElementById('tc-temp').value);
      payload.top_p = parseFloat(document.getElementById('tc-top-p').value);
      var tcMaxTokens = parseInt(document.getElementById('tc-max-tokens').value);
      if (!isNaN(tcMaxTokens) && tcMaxTokens > 0) payload.max_completion_tokens = tcMaxTokens;
      payload.use_kb = document.getElementById('tc-use-kb').checked;
      var sysPromptOverride = document.getElementById('tc-sysprompt').value.trim();
      if (sysPromptOverride) payload.system_prompt = sysPromptOverride;

      var modelVal = document.getElementById('tc-model').value;
      if (modelVal) {
        var parts = modelVal.split(':');
        payload.provider = parts[0];
        payload.model = parts[1];
        tcActiveModel = parts[1];
      } else {
        tcActiveModel = 'default';
      }

      /* Update model badge in header */
      var badgeEl = document.getElementById('tc-model-badge');
      badgeEl.textContent = tcActiveModel;
      badgeEl.style.display = 'inline-block';

      /* Reset flowchart + start timer */
      tcFlowSteps = [];
      tcGuardrailData = { input: [], output: [] };
      tcTraceId = '';
      tcRequestId = '';
      document.getElementById('tc-activity-rail').style.display = 'block';
      document.getElementById('tc-activity-summary').style.display = 'none';
      document.getElementById('tc-guardrail-bar').style.display = 'none';
      document.getElementById('tc-trace-info').style.display = 'none';

      /* Show model in activity rail */
      var modelInfoEl = document.getElementById('tc-activity-model');
      modelInfoEl.innerHTML = '\u{1F916} ' + escapeHtml(tcActiveModel);
      modelInfoEl.style.display = 'flex';

      startElapsedTimer();
      renderFlowchart();

      /* Add assistant placeholder */
      var assistantIdx = tcMessages.length;
      tcMessages.push({ role: 'assistant', content: '', time: '' });
      renderTCMessages();

      var fullResponse = '';
      var tcUsageData = null;
      var tcDoneModelInfo = '';
      var STEP_ICONS = {
        retrieve_context: '\u{1F50D}',
        load_memory: '\u{1F4AD}',
        reason: '\u{1F9E0}',
        tool_call: '\u{1F527}',
        generate_response: '\u{270D}\uFE0F'
      };

      _tcAbortController = new AbortController();

      try {
        var resp = await fetch('/api/agent-run/stream', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
          signal: _tcAbortController.signal
        });

        if (!resp.ok) {
          tcMessages[assistantIdx].content = 'Error: Server returned ' + resp.status;
          renderTCMessages();
          return;
        }

        var reader = resp.body.getReader();
        var decoder = new TextDecoder();
        var buffer = '';
        var eventType = '';

        while (true) {
          var result = await reader.read();
          if (result.done) break;
          buffer += decoder.decode(result.value, { stream: true });

          var lines = buffer.split(TC_NL);
          buffer = lines.pop();

          for (var li = 0; li < lines.length; li++) {
            var line = lines[li];
            if (line.indexOf('event: ') === 0) {
              eventType = line.slice(7).trim();
            } else if (line.indexOf('data: ') === 0) {
              var raw = line.slice(6);
              if (eventType === 'step') {
                try {
                  var d = JSON.parse(raw);
                  var key = d.step + (d.tool || '');
                  if (d.status === 'started') {
                    tcFlowSteps.push({
                      key: key,
                      icon: STEP_ICONS[d.step] || '\u{1F4CC}',
                      label: d.label || d.step,
                      detail: '',
                      time: '',
                      durationMs: 0,
                      running: true,
                      done: false
                    });
                    renderFlowchart();
                  } else if (d.status === 'done') {
                    for (var si = tcFlowSteps.length - 1; si >= 0; si--) {
                      if (tcFlowSteps[si].key === key && !tcFlowSteps[si].done) {
                        tcFlowSteps[si].done = true;
                        tcFlowSteps[si].running = false;
                        tcFlowSteps[si].detail = d.detail || '';
                        tcFlowSteps[si].durationMs = d.duration_ms || 0;
                        tcFlowSteps[si].time = d.duration_ms ? (d.duration_ms / 1000).toFixed(1) + 's' : '';
                        break;
                      }
                    }
                    renderFlowchart();
                  }
                } catch(e) {}
              } else if (eventType === 'token') {
                fullResponse += raw;
                tcMessages[assistantIdx].content = fullResponse;
                renderTCMessages();
              } else if (eventType === 'guardrails') {
                try {
                  var grEvt = JSON.parse(raw);
                  if (grEvt.phase === 'input') tcGuardrailData.input = grEvt.results || [];
                  if (grEvt.phase === 'output') tcGuardrailData.output = grEvt.results || [];
                  renderTCGuardrails();
                } catch(e) {}
              } else if (eventType === 'done') {
                try {
                  var doneData = JSON.parse(raw);
                  tcUsageData = doneData.usage || null;
                  tcDoneModelInfo = doneData.model ? ((doneData.provider || '') + '/' + doneData.model) : '';
                  tcTraceId = doneData.trace_id || '';
                  tcRequestId = doneData.request_id || '';
                  if (doneData.guardrails) {
                    tcGuardrailData = doneData.guardrails;
                    renderTCGuardrails();
                  }
                } catch(e) {}
              }
            }
          }
        }
      } catch(e) {
        if (e.name === 'AbortError') {
          tcMessages[assistantIdx].content = fullResponse + '\n\n\u23F9 Request stopped by user.';
        } else {
          tcMessages[assistantIdx].content = 'Error: ' + e.message;
        }
        renderTCMessages();
      } finally {
        _tcAbortController = null;
        document.getElementById('tc-stop').style.display = 'none';
        stopElapsedTimer();
        var totalMs = tcStartTime ? Date.now() - tcStartTime : 0;
        document.getElementById('tc-elapsed').textContent = (totalMs / 1000).toFixed(1) + 's';
        var doneTime = new Date();
        tcMessages[assistantIdx].time = doneTime.getHours().toString().padStart(2,'0') + ':' + doneTime.getMinutes().toString().padStart(2,'0');
        showActivitySummary(totalMs, tcUsageData, tcDoneModelInfo);
        renderTCTraceInfo();
        sendBtn.disabled = false;
        renderTCMessages();
        saveTCState();
      }
    }

    function saveTCState() {
      try {
        localStorage.setItem(TC_STATE_KEY, JSON.stringify({
          sessionId: tcSessionId,
          messages: tcMessages,
          isOpen: tcIsOpen,
          lastPrompt: tcLastPrompt,
          agentId: document.getElementById('tc-agent') ? document.getElementById('tc-agent').value : '',
          modelVal: document.getElementById('tc-model') ? document.getElementById('tc-model').value : '',
          maxTokens: document.getElementById('tc-max-tokens') ? document.getElementById('tc-max-tokens').value : '2048',
          temperature: document.getElementById('tc-temp') ? document.getElementById('tc-temp').value : '0.7',
          topP: document.getElementById('tc-top-p') ? document.getElementById('tc-top-p').value : '1',
          useKb: document.getElementById('tc-use-kb') ? document.getElementById('tc-use-kb').checked : true,
        }));
      } catch(e) {}
    }

    function restoreTCState() {
      var raw = localStorage.getItem(TC_STATE_KEY);
      if (!raw) return;
      try {
        var s = JSON.parse(raw);
        tcSessionId = s.sessionId || '';
        tcMessages = s.messages || [];
        tcIsOpen = s.isOpen || false;
        tcLastPrompt = s.lastPrompt || '';
        renderTCMessages();
        if (s.maxTokens) document.getElementById('tc-max-tokens').value = s.maxTokens;
        if (s.temperature) { document.getElementById('tc-temp').value = s.temperature; document.getElementById('tc-temp-val').textContent = s.temperature; }
        if (s.topP) { document.getElementById('tc-top-p').value = s.topP; document.getElementById('tc-top-p-val').textContent = s.topP; }
        if (typeof s.useKb === 'boolean') document.getElementById('tc-use-kb').checked = s.useKb;
        if (tcIsOpen) {
          document.getElementById('test-chat-panel').style.display = 'flex';
          document.getElementById('test-chat-fab').classList.add('active');
          loadTCAgents().then(function() {
            if (s.agentId) document.getElementById('tc-agent').value = s.agentId;
          });
          loadTCModels().then(function() {
            if (s.modelVal) document.getElementById('tc-model').value = s.modelVal;
          });
        }
      } catch(e) { localStorage.removeItem(TC_STATE_KEY); }
    }

    document.getElementById('tc-prompt').addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendTestChat(); }
    });

    /* ── New Enhancement Functions ── */

    function copyTCMessage(idx) {
      var msg = tcMessages[idx];
      if (!msg || !msg.content) return;
      navigator.clipboard.writeText(msg.content).then(function() {
        showToast('Copied to clipboard', 'success');
      }).catch(function() { showToast('Failed to copy', 'error'); });
    }

    function regenerateTC() {
      if (!tcLastPrompt) { showToast('No previous prompt', 'warning'); return; }
      /* Remove the last assistant response */
      if (tcMessages.length > 0 && tcMessages[tcMessages.length - 1].role === 'assistant') {
        tcMessages.pop();
      }
      /* Remove the last user message too (sendTestChat will re-add it) */
      if (tcMessages.length > 0 && tcMessages[tcMessages.length - 1].role === 'user') {
        tcMessages.pop();
      }
      document.getElementById('tc-prompt').value = tcLastPrompt;
      sendTestChat();
    }

    function exportTestChat() {
      if (tcMessages.length === 0) { showToast('No conversation to export', 'warning'); return; }
      var lines = '# Test Agent Conversation Export\n\n';
      lines += '**Session:** ' + (tcSessionId || 'unknown') + '\n';
      lines += '**Date:** ' + new Date().toISOString() + '\n';
      lines += '**Model:** ' + (tcActiveModel || 'default') + '\n\n---\n\n';
      tcMessages.forEach(function(m) {
        lines += '### ' + (m.role === 'user' ? 'You' : 'Agent') + ' (' + (m.time || '') + ')\n\n';
        lines += m.content + '\n\n';
      });
      var blob = new Blob([lines], { type: 'text/markdown' });
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'conversation-' + (tcSessionId || 'export') + '.md';
      a.click();
      URL.revokeObjectURL(a.href);
      showToast('Conversation exported', 'success');
    }

    function toggleTCFullscreen() {
      var panel = document.getElementById('test-chat-panel');
      tcIsFullscreen = !tcIsFullscreen;
      panel.classList.toggle('tc-fullscreen', tcIsFullscreen);
      var btn = document.getElementById('tc-fullscreen-btn');
      if (tcIsFullscreen) {
        btn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 14 10 14 10 20"/><polyline points="20 10 14 10 14 4"/><line x1="14" y1="10" x2="21" y2="3"/><line x1="3" y1="21" x2="10" y2="14"/></svg>';
        btn.title = 'Exit fullscreen';
      } else {
        btn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>';
        btn.title = 'Fullscreen';
      }
    }

    function renderTCGuardrails() {
      var bar = document.getElementById('tc-guardrail-bar');
      var all = (tcGuardrailData.input || []).concat(tcGuardrailData.output || []);
      if (all.length === 0) { bar.style.display = 'none'; return; }
      var passed = all.filter(function(g) { return g.status === 'passed'; }).length;
      var flagged = all.filter(function(g) { return g.status === 'flagged'; }).length;
      var blocked = all.filter(function(g) { return g.status === 'blocked'; }).length;
      var bgColor = blocked > 0 ? 'rgba(244,63,94,0.08)' : flagged > 0 ? 'rgba(245,158,11,0.06)' : 'rgba(16,185,129,0.06)';
      var borderColor = blocked > 0 ? 'rgba(244,63,94,0.2)' : flagged > 0 ? 'rgba(245,158,11,0.15)' : 'rgba(16,185,129,0.15)';
      var html = '<div style="display:flex;align-items:center;gap:0.3rem;flex-wrap:wrap">';
      html += '<svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--text-3)"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>';
      html += '<span style="color:#10b981;font-weight:600">' + passed + '</span>';
      if (flagged) html += '<span style="color:#f59e0b;font-weight:600">' + flagged + ' warn</span>';
      if (blocked) html += '<span style="color:#f43f5e;font-weight:600">' + blocked + ' blocked</span>';
      html += '</div>';
      bar.innerHTML = html;
      bar.style.display = 'block';
      bar.style.background = bgColor;
      bar.style.borderColor = borderColor;
    }

    function renderTCTraceInfo() {
      var el = document.getElementById('tc-trace-info');
      if (!tcTraceId && !tcRequestId) { el.style.display = 'none'; return; }
      var html = '';
      if (tcRequestId) html += 'req: ' + escapeHtml(tcRequestId.substring(0, 16));
      if (tcTraceId) html += (html ? '<br>' : '') + 'trace: ' + escapeHtml(tcTraceId.substring(0, 16));
      el.innerHTML = html;
      el.style.display = 'block';
    }

    restoreTCState();

    /* ── Mobile Navigation ── */
    function toggleMobileNav() {
      var rail = document.querySelector('.icon-rail');
      var backdrop = document.getElementById('mobile-nav-backdrop');
      if (!backdrop) {
        backdrop = document.createElement('div');
        backdrop.id = 'mobile-nav-backdrop';
        backdrop.className = 'mobile-nav-backdrop';
        backdrop.onclick = function() { toggleMobileNav(); };
        document.body.appendChild(backdrop);
      }
      var isOpen = rail.classList.contains('mobile-open');
      if (isOpen) {
        rail.classList.remove('mobile-open');
        backdrop.classList.remove('active');
      } else {
        rail.classList.add('mobile-open');
        backdrop.classList.add('active');
      }
    }
    // Close mobile nav on link click
    document.querySelectorAll('.icon-rail a').forEach(function(a) {
      a.addEventListener('click', function() {
        var rail = document.querySelector('.icon-rail');
        var backdrop = document.getElementById('mobile-nav-backdrop');
        if (rail.classList.contains('mobile-open')) {
          rail.classList.remove('mobile-open');
          if (backdrop) backdrop.classList.remove('active');
        }
      });
    });
  </script>

  <!-- ── Global LLM Activity Toast ── -->
  <div id="llm-usage-toast" class="llm-toast-container">
    <div class="llm-toast-header">
      <span class="llm-toast-title">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        LLM Activity
      </span>
      <button onclick="closeLlmToast()" class="llm-toast-close">&times;</button>
    </div>
    <div id="llm-usage-toast-body" class="llm-toast-body"></div>
  </div>
  <style>
    @keyframes llmToastIn { from { opacity:0; transform:translateY(20px) scale(.95); } to { opacity:1; transform:translateY(0) scale(1); } }
    @keyframes llmPulse { 0%,100% { opacity:.6; } 50% { opacity:1; } }
    .llm-toast-container {
      display:none; position:fixed; bottom:24px; right:24px; z-index:99999;
      min-width:340px; max-width:420px;
      background: var(--glass-bg); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
      border:1px solid var(--glass-border); border-radius:14px;
      box-shadow: var(--glass-shadow); padding:0; font-family:inherit;
      animation: llmToastIn .3s ease;
    }
    .llm-toast-header {
      display:flex; align-items:center; justify-content:space-between;
      padding:12px 16px 8px; border-bottom:1px solid var(--divider);
    }
    .llm-toast-title {
      display:flex; align-items:center; gap:8px;
      font-size:13px; font-weight:600; color:var(--text-1);
    }
    .llm-toast-close {
      background:none; border:none; color:var(--text-3); cursor:pointer;
      font-size:18px; line-height:1; padding:4px;
    }
    .llm-toast-close:hover { color:var(--text-1); }
    .llm-toast-body { padding:12px 16px 16px; display:grid; grid-template-columns:1fr 1fr; gap:8px; }
    .llm-toast-body .llm-tile {
      background: var(--input-bg); border:1px solid var(--border-base);
      border-radius:8px; padding:8px 10px;
    }
    .llm-toast-body .llm-tile-label {
      font-size:10px; text-transform:uppercase; letter-spacing:.5px;
      color:var(--text-3); margin-bottom:2px;
    }
    .llm-toast-body .llm-tile-value { font-size:14px; font-weight:600; color:var(--text-1); }
    .llm-toast-body .llm-tile-value.loading { animation: llmPulse 1.2s ease-in-out infinite; color:var(--text-2); }
    .llm-toast-body .llm-spinner {
      display:inline-block; width:14px; height:14px; border:2px solid var(--text-3);
      border-top-color:var(--accent); border-radius:50%; animation:spin .8s linear infinite;
      vertical-align:middle; margin-right:6px;
    }
    @keyframes spin { to { transform:rotate(360deg); } }
  </style>
  <script>
    function showLlmUsageToastLoading(feature) {
      var toast = document.getElementById('llm-usage-toast');
      var body = document.getElementById('llm-usage-toast-body');
      body.innerHTML =
        '<div class="llm-tile" style="grid-column:span 2"><div class="llm-tile-label">Feature</div><div class="llm-tile-value"><span class="llm-spinner"></span>' + (feature || 'AI Processing') + '</div></div>' +
        '<div class="llm-tile"><div class="llm-tile-label">Status</div><div class="llm-tile-value loading">Calling LLM...</div></div>' +
        '<div class="llm-tile"><div class="llm-tile-label">Latency</div><div class="llm-tile-value loading" id="llm-toast-elapsed">0.0s</div></div>' +
        '<div class="llm-tile"><div class="llm-tile-label">Tokens</div><div class="llm-tile-value loading">—</div></div>' +
        '<div class="llm-tile"><div class="llm-tile-label">Cost</div><div class="llm-tile-value loading">—</div></div>';
      toast.style.display = 'block';
      clearTimeout(window._llmToastTimer);
      // Live elapsed timer
      window._llmToastStart = Date.now();
      clearInterval(window._llmToastElapsed);
      window._llmToastElapsed = setInterval(function() {
        var el = document.getElementById('llm-toast-elapsed');
        if (el) el.textContent = ((Date.now() - window._llmToastStart) / 1000).toFixed(1) + 's';
      }, 100);
    }
    function showLlmUsageToast(usage) {
      if (!usage) return;
      clearInterval(window._llmToastElapsed);
      var toast = document.getElementById('llm-usage-toast');
      var body = document.getElementById('llm-usage-toast-body');
      var cost = typeof usage.estimated_cost === 'number' ? '$' + usage.estimated_cost.toFixed(5) : '$0.00';
      var latency = usage.latency_ms ? (usage.latency_ms / 1000).toFixed(2) + 's' : '—';
      var tokPerSec = (usage.completion_tokens && usage.latency_ms) ? Math.round(usage.completion_tokens / (usage.latency_ms / 1000)) : '—';
      body.innerHTML =
        '<div class="llm-tile"><div class="llm-tile-label">Provider</div><div class="llm-tile-value">' + (usage.provider || '—') + '</div></div>' +
        '<div class="llm-tile"><div class="llm-tile-label">Model</div><div class="llm-tile-value">' + (usage.model || '—') + '</div></div>' +
        '<div class="llm-tile"><div class="llm-tile-label">Feature</div><div class="llm-tile-value">' + (usage.feature || '—') + '</div></div>' +
        '<div class="llm-tile"><div class="llm-tile-label">Latency</div><div class="llm-tile-value">' + latency + '</div></div>' +
        '<div class="llm-tile"><div class="llm-tile-label">Prompt Tokens</div><div class="llm-tile-value">' + (usage.prompt_tokens || 0) + '</div></div>' +
        '<div class="llm-tile"><div class="llm-tile-label">Completion Tokens</div><div class="llm-tile-value">' + (usage.completion_tokens || 0) + '</div></div>' +
        '<div class="llm-tile"><div class="llm-tile-label">Total Tokens</div><div class="llm-tile-value">' + (usage.total_tokens || 0) + '</div></div>' +
        '<div class="llm-tile"><div class="llm-tile-label">Tokens/sec</div><div class="llm-tile-value">' + tokPerSec + '</div></div>' +
        '<div class="llm-tile" style="grid-column:span 2"><div class="llm-tile-label">Est. Cost</div><div class="llm-tile-value">' + cost + '</div></div>';
      toast.style.display = 'block';
      clearTimeout(window._llmToastTimer);
      window._llmToastTimer = setTimeout(closeLlmToast, 15000);
    }
    function closeLlmToast() {
      var toast = document.getElementById('llm-usage-toast');
      if (toast) toast.style.display = 'none';
      clearTimeout(window._llmToastTimer);
      clearInterval(window._llmToastElapsed);
    }
  </script>
</body>
</html>
