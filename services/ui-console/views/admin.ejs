function toggleSSOForm(provider) {
  var form = document.getElementById('sso-form-' + provider);
  if (!form) return;
  if (form.style.display === 'none') {
    form.style.display = 'block';
    // Pre-fill client ID if already configured
    fetch('/api/admin/sso-config').then(function(r) { return r.json(); }).then(function(d) {
      if (d[provider] && d[provider].clientId) {
        document.getElementById('sso-' + provider + '-id').value = d[provider].clientId;
      }
    }).catch(function() {});
  } else {
    form.style.display = 'none';
  }
}

async function saveSSO(provider) {
  var clientId = document.getElementById('sso-' + provider + '-id').value.trim();
  var clientSecret = document.getElementById('sso-' + provider + '-secret').value.trim();
  if (!clientId || !clientSecret) { showToast('Client ID and Secret are required', 'error'); return; }
  try {
    var r = await fetch('/api/admin/sso-config', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ provider: provider, clientId: clientId, clientSecret: clientSecret })
    });
    var d = await r.json();
    if (r.ok && d.ok) {
      showToast((provider.charAt(0).toUpperCase() + provider.slice(1)) + ' SSO configured', 'success');
      if (d.warning) showToast(d.warning, 'warn');
      document.getElementById('sso-form-' + provider).style.display = 'none';
      document.getElementById('sso-' + provider + '-secret').value = '';
      loadSSOStatus();
    } else {
      showToast(d.error || 'Failed to save SSO config', 'error');
    }
  } catch(e) { showToast('Failed to save SSO config', 'error'); }
}

