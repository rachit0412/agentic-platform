    function switchProfileTab(tabName) {
      document.querySelectorAll('.profile-tab').forEach(function(t) { t.style.display = 'none'; });
      document.querySelectorAll('.profile-tab-btn').forEach(function(b) { b.style.color = 'var(--text-3)'; b.style.borderBottomColor = 'transparent'; });
      document.querySelector('[data-tab="' + tabName + '"].profile-tab').style.display = 'block';
      document.querySelector('[data-tab="' + tabName + '"].profile-tab-btn').style.color = 'var(--text-1)';
      document.querySelector('[data-tab="' + tabName + '"].profile-tab-btn').style.borderBottomColor = 'var(--accent)';
    }

    function saveProfileChanges() {
      var displayName = document.getElementById('profile-display-name').value.trim();
      var email = document.getElementById('profile-email').value.trim();
      var bio = document.getElementById('profile-bio').value.trim();
      var msgEl = document.getElementById('profile-general-msg');
      
      msgEl.style.display = 'none';
      
      if (!displayName) {
        msgEl.style.background = 'var(--danger-bg)';
        msgEl.style.color = 'var(--danger)';
        msgEl.textContent = 'Display name cannot be empty';
        msgEl.style.display = 'block';
        return;
      }
      
      if (email && !email.match(/^[^\s@]+@[^\s@]+\.[^\s@]+$/)) {
        msgEl.style.background = 'var(--danger-bg)';
        msgEl.style.color = 'var(--danger)';
        msgEl.textContent = 'Please enter a valid email address';
        msgEl.style.display = 'block';
        return;
      }
      
      fetch('/api/update-profile', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ display_name: displayName, email: email, bio: bio })
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.error) throw new Error(d.error);
        window.__userDisplayName = displayName;
        window.__userEmail = email;
        var tooltipEl = document.querySelector('.rail-profile-group > .rail-item > .rail-tooltip');
        if (tooltipEl) tooltipEl.textContent = displayName;
        var titleEl = document.querySelector('.rail-profile-group .rail-submenu-title');
        if (titleEl) titleEl.textContent = displayName;
        msgEl.style.background = 'var(--success-bg)';
        msgEl.style.color = 'var(--success)';
        msgEl.textContent = 'Profile updated successfully!';
        msgEl.style.display = 'block';
        setTimeout(function() { var m = document.getElementById('profile-modal'); if (m) m.remove(); }, 1500);
      }).catch(function(err) {
        msgEl.style.background = 'var(--danger-bg)';
        msgEl.style.color = 'var(--danger)';
        msgEl.textContent = err.message;
        msgEl.style.display = 'block';
      });
    }

    function loadNotificationPreferences() {
      var prefs = window.__userNotificationPrefs || { email: true, workflow: true, agent: false };
      document.getElementById('notif-email').checked = prefs.email === true;
      document.getElementById('notif-workflow').checked = prefs.workflow === true;
      document.getElementById('notif-agent').checked = prefs.agent === true;
    }

    function updateNotificationPrefs() {
      var prefs = {
        email: document.getElementById('notif-email').checked,
        workflow: document.getElementById('notif-workflow').checked,
        agent: document.getElementById('notif-agent').checked
      };
      var msgEl = document.getElementById('notif-msg');
      msgEl.style.display = 'none';
      
      fetch('/api/update-profile', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ notification_preferences: prefs })
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.error) throw new Error(d.error);
        window.__userNotificationPrefs = prefs;
        msgEl.style.background = 'var(--success-bg)';
        msgEl.style.color = 'var(--success)';
        msgEl.textContent = 'Preferences updated!';
        msgEl.style.display = 'block';
      }).catch(function(err) {
        msgEl.style.background = 'var(--danger-bg)';
        msgEl.style.color = 'var(--danger)';
        msgEl.textContent = err.message;
        msgEl.style.display = 'block';
      });
    }

    function handle2FAToggle() {
      if (window.__userTwoFactorEnabled) {
        disable2FA();
      } else {
        setup2FA();
      }
    }

    function updateTFAButton() {
      var btn = document.getElementById('tfa-btn');
      if (btn) {
        if (window.__userTwoFactorEnabled) {
          btn.textContent = 'Disable';
          btn.className = 'btn btn-danger';
        } else {
          btn.textContent = 'Enable';
          btn.className = 'btn btn-outline';
        }
      }
    }

    function setup2FA() {
      var msgEl = document.getElementById('security-msg');
      fetch('/api/setup-2fa', { method: 'POST' })
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (d.error) throw new Error(d.error);
          var m = document.createElement('div');
          m.id = 'tfa-setup-modal';
          m.style.cssText = 'position:fixed;inset:0;z-index:201;display:flex;align-items:center;justify-content:center;background:var(--modal-overlay);backdrop-filter:blur(6px);';
          m.onclick = function(e) { if (e.target === m) m.remove(); };
          m.innerHTML = '<div style="background:var(--modal-bg);border:1px solid var(--modal-border);border-radius:16px;padding:28px 32px;min-width:360px;max-width:480px;box-shadow:var(--modal-shadow);">' +
            '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;"><h3 style="margin:0;font-size:1.05rem;font-weight:700;color:var(--text-1);">Setup Two-Factor Authentication</h3><button onclick="document.getElementById(\'tfa-setup-modal\').remove()" style="border:none;background:transparent;cursor:pointer;color:var(--text-3);font-size:1.3rem;line-height:1;padding:4px;">&times;</button></div>' +
            '<div style="margin-bottom:20px;"><div style="font-size:0.75rem;color:var(--text-3);margin-bottom:12px;">Scan this QR code with an authenticator app like Google Authenticator or Microsoft Authenticator:</div><div style="text-align:center;padding:16px;border-radius:12px;background:var(--modal-field-bg);"><img src="' + d.qrCode + '" style="max-width:200px;height:auto;border-radius:8px;" /></div></div>' +
            '<div style="margin-bottom:20px;"><div style="font-size:0.75rem;font-weight:600;color:var(--text-3);margin-bottom:8px;">Manual Entry Code:</div><div style="padding:12px;border-radius:10px;background:var(--modal-field-bg);border:1px solid var(--modal-border);font-family:monospace;font-size:0.85rem;color:var(--accent);letter-spacing:2px;text-align:center;word-break:break-all;">' + d.secret + '</div></div>' +
            '<div style="margin-bottom:20px;"><div style="font-size:0.75rem;font-weight:600;color:var(--text-3);margin-bottom:8px;">Backup Codes (Save these in a safe place):</div><div style="padding:12px;border-radius:10px;background:var(--modal-field-bg);border:1px solid var(--modal-border);font-family:monospace;font-size:0.75rem;color:var(--text-1);line-height:1.8;">' + d.backupCodes.join('<br />') + '</div></div>' +
            '<div><label style="display:block;font-size:0.68rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-3);margin-bottom:6px;">Enter 6-digit code from your authenticator</label><input type="text" id="tfa-verify-code" maxlength="6" placeholder="000000" style="width:100%;padding:10px 14px;border-radius:10px;border:1px solid var(--modal-border);background:var(--modal-field-bg);color:var(--text-1);font-size:0.82rem;box-sizing:border-box;text-align:center;letter-spacing:4px;font-weight:600;" /></div>' +
            '<div id="tfa-verify-msg" style="display:none;font-size:0.75rem;text-align:center;padding:10px 14px;border-radius:10px;margin-top:8px;"></div>' +
            '<button onclick="verify2FA(\'' + d.secret + '\')" class="btn btn-primary" style="width:100%;padding:11px;border-radius:10px;font-size:0.78rem;font-weight:600;cursor:pointer;margin-top:12px;">Verify &amp; Enable 2FA</button>' +
            '</div>';
          document.body.appendChild(m);
          document.getElementById('tfa-verify-code').focus();
        })
        .catch(function(err) {
          msgEl.style.background = 'var(--danger-bg)';
          msgEl.style.color = 'var(--danger)';
          msgEl.textContent = err.message;
          msgEl.style.display = 'block';
        });
    }

    function verify2FA(secret) {
      var code = document.getElementById('tfa-verify-code').value.trim();
      var msgEl = document.getElementById('tfa-verify-msg');
      
      if (!code || code.length !== 6) {
        msgEl.style.background = 'var(--danger-bg)';
        msgEl.style.color = 'var(--danger)';
        msgEl.textContent = 'Please enter a valid 6-digit code';
        msgEl.style.display = 'block';
        return;
      }
      
      fetch('/api/confirm-2fa', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token: code, secret: secret })
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.error) throw new Error(d.error);
        window.__userTwoFactorEnabled = true;
        msgEl.style.background = 'var(--success-bg)';
        msgEl.style.color = 'var(--success)';
        msgEl.textContent = '2FA enabled successfully!';
        msgEl.style.display = 'block';
        setTimeout(function() { 
          document.getElementById('tfa-setup-modal').remove();
          updateTFAButton();
          var secMsg = document.getElementById('security-msg');
          if (secMsg) {
            secMsg.style.background = 'var(--success-bg)';
            secMsg.style.color = 'var(--success)';
            secMsg.textContent = 'Two-factor authentication is now enabled';
            secMsg.style.display = 'block';
          }
        }, 1000);
      }).catch(function(err) {
        msgEl.style.background = 'var(--danger-bg)';
        msgEl.style.color = 'var(--danger)';
        msgEl.textContent = err.message;
        msgEl.style.display = 'block';
      });
    }

    function disable2FA() {
      var pwd = prompt('Enter your password to disable 2FA:');
      if (!pwd) return;
      
      var msgEl = document.getElementById('security-msg');
      fetch('/api/disable-2fa', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: pwd })
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.error) throw new Error(d.error);
        window.__userTwoFactorEnabled = false;
        updateTFAButton();
        msgEl.style.background = 'var(--success-bg)';
        msgEl.style.color = 'var(--success)';
        msgEl.textContent = '2FA has been disabled';
        msgEl.style.display = 'block';
      }).catch(function(err) {
        msgEl.style.background = 'var(--danger-bg)';
        msgEl.style.color = 'var(--danger)';
        msgEl.textContent = err.message;
        msgEl.style.display = 'block';
      });
    }

    // ── Change Password Modal ──
    function openChangePasswordModal() {
      var existing = document.getElementById('password-modal');
      if (existing) existing.remove();
      var m = document.createElement('div');
      m.id = 'password-modal';
      m.style.cssText = 'position:fixed;inset:0;z-index:200;display:flex;align-items:center;justify-content:center;background:var(--modal-overlay);backdrop-filter:blur(6px);';
      m.onclick = function(e) { if (e.target === m) m.remove(); };
      m.innerHTML = '<div style="background:var(--modal-bg);border:1px solid var(--modal-border);border-radius:16px;padding:28px 32px;min-width:360px;max-width:440px;box-shadow:var(--modal-shadow);">'
        + '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;"><h3 style="margin:0;font-size:1.05rem;font-weight:700;color:var(--text-1);">Change Password</h3><button onclick="document.getElementById(\'password-modal\').remove()" style="border:none;background:transparent;cursor:pointer;color:var(--text-3);font-size:1.3rem;line-height:1;padding:4px;">&times;</button></div>'
        + '<div id="pw-error" style="display:none;margin-bottom:14px;padding:10px 14px;border-radius:10px;background:var(--danger-bg);border:1px solid var(--danger-border);color:var(--danger);font-size:0.75rem;"></div>'
        + '<div id="pw-success" style="display:none;margin-bottom:14px;padding:10px 14px;border-radius:10px;background:var(--success-bg);border:1px solid var(--success-border);color:var(--success);font-size:0.75rem;"></div>'
        + '<form onsubmit="handleChangePassword(event)" style="display:grid;gap:14px;">'
        + '<div><label style="display:block;font-size:0.68rem;font-weight:600;text-transform:uppercase;letter-spacing:0.04em;color:var(--text-3);margin-bottom:6px;">Current Password</label><input type="password" id="pw-current" required placeholder="Enter current password" style="width:100%;padding:10px 14px;border-radius:10px;border:1px solid var(--modal-border);background:var(--modal-field-bg);color:var(--text-1);font-size:0.82rem;box-sizing:border-box;" /></div>'
        + '<div><label style="display:block;font-size:0.68rem;font-weight:600;text-transform:uppercase;letter-spacing:0.04em;color:var(--text-3);margin-bottom:6px;">New Password</label><input type="password" id="pw-new" required minlength="8" placeholder="Min. 8 characters" style="width:100%;padding:10px 14px;border-radius:10px;border:1px solid var(--modal-border);background:var(--modal-field-bg);color:var(--text-1);font-size:0.82rem;box-sizing:border-box;" /></div>'
        + '<div><label style="display:block;font-size:0.68rem;font-weight:600;text-transform:uppercase;letter-spacing:0.04em;color:var(--text-3);margin-bottom:6px;">Confirm Password</label><input type="password" id="pw-confirm" required minlength="8" placeholder="Re-enter password" style="width:100%;padding:10px 14px;border-radius:10px;border:1px solid var(--modal-border);background:var(--modal-field-bg);color:var(--text-1);font-size:0.82rem;box-sizing:border-box;" /></div>'
        + '<button type="submit" class="btn btn-primary" style="padding:11px;border-radius:10px;font-size:0.78rem;font-weight:600;cursor:pointer;margin-top:4px;">Update Password</button>'
        + '</form></div>';
      document.body.appendChild(m);
    }
    async function handleChangePassword(e) {
      e.preventDefault();
      var errEl = document.getElementById('pw-error');
      var succEl = document.getElementById('pw-success');
      errEl.style.display = 'none';
      succEl.style.display = 'none';
      var np = document.getElementById('pw-new').value;
      var cp = document.getElementById('pw-confirm').value;
      var cur = document.getElementById('pw-current').value;
      if (!cur) { errEl.textContent = 'Current password is required.'; errEl.style.display = 'block'; return; }
      if (np.length < 8) { errEl.textContent = 'Password must be at least 8 characters.'; errEl.style.display = 'block'; return; }
      if (np !== cp) { errEl.textContent = 'Passwords do not match.'; errEl.style.display = 'block'; return; }
      try {
        var r = await fetch('/api/change-password', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ current_password: cur, new_password: np }) });
        var d = await r.json();
        if (!r.ok) throw new Error(d.error || 'Failed');
        succEl.textContent = 'Password updated successfully!';
        succEl.style.display = 'block';
        document.getElementById('pw-current').value = '';
        document.getElementById('pw-new').value = '';
        document.getElementById('pw-confirm').value = '';
        setTimeout(function() { var m = document.getElementById('password-modal'); if (m) m.remove(); }, 1500);
      } catch(err) {
        errEl.textContent = err.message;
        errEl.style.display = 'block';
      }
    }

    // ── Global HTML Escape (XSS Prevention) ──
    function escapeHtml(str) {
      if (str == null) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    // ── Theme Toggle ──
    function toggleTheme() {
      const html = document.documentElement;
      const isDark = html.classList.contains('dark');
      html.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'light' : 'dark');
      updateThemeIcons();
    }
    function updateThemeIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      document.getElementById('theme-icon-sun').style.display = isDark ? 'block' : 'none';
      document.getElementById('theme-icon-moon').style.display = isDark ? 'none' : 'block';
      const label = document.getElementById('theme-label');
      if (label) label.textContent = isDark ? 'Light' : 'Dark';
    }
    // Restore theme
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme === 'light') document.documentElement.classList.remove('dark');
    updateThemeIcons();

    // ── Sidebar Toggle ──
    function toggleSidebar() {
      var html = document.documentElement;
      html.classList.toggle('sidebar-expanded');
      localStorage.setItem('sidebarExpanded', html.classList.contains('sidebar-expanded'));
    }

    // ── Expandable Rail Groups (collapsed by default in expanded sidebar) ──
    document.querySelectorAll('.rail-group > .rail-item').forEach(function(item) {
      item.addEventListener('click', function(e) {
        if (!document.documentElement.classList.contains('sidebar-expanded')) return;
        e.preventDefault();
        var group = item.closest('.rail-group');
        group.classList.toggle('open');
      });
    });
    // Enable smooth transitions after initial render (prevents flash on page load)
    requestAnimationFrame(function() {
      requestAnimationFrame(function() {
        document.documentElement.classList.add('sidebar-animated');
      });
    });

    // ── Design Theme Switcher ──
    function setDesignTheme(name) {
      var html = document.documentElement;
      html.classList.remove('theme-midnight', 'theme-aurora', 'theme-softui', 'theme-horizon');
      if (name === 'midnight') html.classList.add('theme-midnight');
      else if (name === 'aurora') html.classList.add('theme-aurora');
      else if (name === 'softui') html.classList.add('theme-softui');
      else if (name === 'horizon') html.classList.add('theme-horizon');
      localStorage.setItem('designTheme', name);
    }
    function getDesignTheme() {
      return localStorage.getItem('designTheme') || 'midnight';
    }

    // ── Topbar Health Indicator ──
    (function checkHealth(retries) {
      fetch('/api/health-check').then(r=>r.json()).then(d=>{
        const allHealthy = d.services.every(s => s.status === 'healthy');
        const dot = document.getElementById('topbar-health-dot');
        const text = document.getElementById('topbar-health-text');
        if (allHealthy) {
          dot.className = 'pulse-dot-emerald';
          text.textContent = 'All Systems Healthy';
        } else {
          dot.className = 'pulse-dot-rose';
          text.textContent = d.services.filter(s=>s.status!=='healthy').length + ' service(s) down';
        }
      }).catch(()=>{
        if (retries > 0) {
          setTimeout(() => checkHealth(retries - 1), 3000);
        } else {
          document.getElementById('topbar-health-dot').className = 'pulse-dot-rose';
          document.getElementById('topbar-health-text').textContent = 'Disconnected';
        }
      });
    })(3);

    // ── Toast Notifications ──
    function showToast(message, type = 'info', duration = 3500) {
      let container = document.getElementById('toast-container');
      if (!container) {
        container = document.createElement('div');
        container.id = 'toast-container';
        container.style.cssText = 'position:fixed;top:1rem;right:1rem;z-index:99999;display:flex;flex-direction:column;gap:0.5rem;pointer-events:none';
        document.body.appendChild(container);
      }
      const colors = { success:'#10b981', error:'#ef4444', info:'#06b6d4', warning:'#f59e0b' };
      const icons = { success:'✓', error:'✕', info:'ℹ', warning:'⚠' };
      const toast = document.createElement('div');
      toast.style.cssText = 'pointer-events:auto;display:flex;align-items:center;gap:0.5rem;padding:0.65rem 1rem;border-radius:10px;font-size:0.82rem;color:#fff;background:rgba(15,23,42,0.92);border:1px solid ' + (colors[type]||colors.info) + '40;backdrop-filter:blur(12px);box-shadow:0 8px 32px rgba(0,0,0,0.3);transform:translateX(120%);transition:transform 0.3s ease';
      toast.innerHTML = '<span style="font-size:1rem;color:' + (colors[type]||colors.info) + '">' + (icons[type]||icons.info) + '</span><span>' + escapeHtml(message) + '</span>';
      container.appendChild(toast);
      requestAnimationFrame(() => { toast.style.transform = 'translateX(0)'; });
      setTimeout(() => {
        toast.style.transform = 'translateX(120%)';
        setTimeout(() => toast.remove(), 350);
      }, duration);
    }

    // ── Global Detail Modal ──
    function showDetailModal(title, contentHtml) {
      let overlay = document.getElementById('detail-modal-overlay');
      if (!overlay) {
        overlay = document.createElement('div');
        overlay.id = 'detail-modal-overlay';
        overlay.style.cssText = 'position:fixed;inset:0;z-index:99998;background:rgba(0,0,0,0.6);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity 0.2s ease';
        overlay.addEventListener('click', function(e) { if (e.target === overlay) closeDetailModal(); });
        document.body.appendChild(overlay);
      }
      overlay.innerHTML = '<div style="background:var(--bg);border:1px solid var(--glass-border);border-radius:16px;padding:1.5rem;max-width:640px;width:90%;max-height:80vh;overflow-y:auto;box-shadow:0 25px 50px rgba(0,0,0,0.5);backdrop-filter:blur(12px);transform:scale(0.95);transition:transform 0.2s ease" id="detail-modal-body">' +
        '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">' +
          '<h3 style="margin:0;font-size:1.1rem">' + title + '</h3>' +
          '<button onclick="closeDetailModal()" style="background:none;border:none;color:var(--text-3);cursor:pointer;font-size:1.2rem;padding:0.25rem" title="Close">✕</button>' +
        '</div>' +
        '<div>' + contentHtml + '</div>' +
      '</div>';
      requestAnimationFrame(() => {
        overlay.style.opacity = '1';
        document.getElementById('detail-modal-body').style.transform = 'scale(1)';
      });
      document.addEventListener('keydown', _modalEscHandler);
    }
    function closeDetailModal() {
      const overlay = document.getElementById('detail-modal-overlay');
      if (overlay) {
        overlay.style.opacity = '0';
        setTimeout(() => overlay.remove(), 200);
      }
      document.removeEventListener('keydown', _modalEscHandler);
    }
    function _modalEscHandler(e) { if (e.key === 'Escape') closeDetailModal(); }

    // ── Sign-Out Animation ──
    function performSignOut() {
      const overlay = document.createElement('div');
      overlay.id = 'signout-overlay';
      overlay.innerHTML = `
        <div class="signout-content">
          <div class="signout-icon">
            <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
              <polyline points="16 17 21 12 16 7"/>
              <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
          </div>
          <div class="signout-title">Signing Out</div>
          <div class="signout-steps">
            <div class="signout-step" id="so-step-1"><span class="signout-dot"></span>Clearing session data</div>
            <div class="signout-step" id="so-step-2"><span class="signout-dot"></span>Revoking tokens</div>
            <div class="signout-step" id="so-step-3"><span class="signout-dot"></span>Disconnecting services</div>
          </div>
          <div class="signout-bar-track"><div class="signout-bar-fill" id="so-bar"></div></div>
          <div class="signout-status" id="so-status">Initializing...</div>
        </div>
      `;
      document.body.appendChild(overlay);
      requestAnimationFrame(() => overlay.classList.add('active'));

      const steps = [
        { id: 'so-step-1', text: 'Clearing session data...', pct: 30 },
        { id: 'so-step-2', text: 'Revoking tokens...', pct: 65 },
        { id: 'so-step-3', text: 'Disconnecting services...', pct: 100 },
      ];
      const bar = document.getElementById('so-bar');
      const status = document.getElementById('so-status');
      let i = 0;

      function nextStep() {
        if (i < steps.length) {
          const s = steps[i];
          document.getElementById(s.id).classList.add('done');
          bar.style.width = s.pct + '%';
          status.textContent = s.text;
          i++;
          setTimeout(nextStep, 500 + Math.random() * 300);
        } else {
          status.textContent = 'Session terminated. Redirecting...';
          // Set flag in sessionStorage to skip gate on login page
          try { sessionStorage.setItem('skipLoginGate', 'true'); } catch (e) {}
          fetch('/auth/logout', { method: 'POST' })
            .finally(() => {
              setTimeout(() => { window.location.href = '/login?logout=true'; }, 600);
            });
        }
      }
      setTimeout(nextStep, 400);
    }
  </script>

