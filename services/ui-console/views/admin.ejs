  </div>
</div>

</div><!-- /admin-content -->

<style>
/* ── Admin two-level navigation ── */
.admin-nav { margin-bottom:2rem; background:var(--glass-bg); border:1px solid var(--glass-border); border-radius:14px; overflow:hidden; }
.admin-section-tabs { display:flex; background:rgba(0,0,0,0.06); border-bottom:1px solid var(--glass-border); padding:0 0.5rem; }
.admin-stab { display:flex; align-items:center; gap:0.45rem; background:transparent; border:none; border-bottom:2px solid transparent; color:var(--text-3); padding:0.8rem 1.1rem; font-size:0.82rem; font-weight:500; cursor:pointer; transition:all 0.18s; margin-bottom:-1px; white-space:nowrap; user-select:none; }
.admin-stab svg { flex-shrink:0; opacity:0.55; transition:opacity 0.18s; }
.admin-stab:hover { color:var(--text-1); background:rgba(255,255,255,0.04); border-radius:8px 8px 0 0; }
.admin-stab:hover svg { opacity:0.85; }
.admin-stab.active { color:var(--accent-text); border-bottom-color:var(--accent); font-weight:600; }
.admin-stab.active svg { opacity:1; }
.admin-subtab-row { padding:0.6rem 1rem 0.7rem; }
.admin-subtabs { display:flex; gap:0.35rem; flex-wrap:wrap; }
.admin-subtab { background:transparent; border:1px solid transparent; color:var(--text-3); border-radius:20px; padding:0.3rem 0.85rem; font-size:0.75rem; cursor:pointer; transition:all 0.15s; user-select:none; }
.admin-subtab:hover { color:var(--text-1); border-color:var(--glass-border); background:var(--glass-hover-bg); }
.admin-subtab.active { color:var(--accent-text); border-color:var(--accent-border); background:var(--accent-bg); font-weight:600; }
.health-card { padding:0.75rem;border-radius:10px;border:1px solid var(--glass-border);background:var(--glass-bg);display:flex;align-items:center;gap:0.75rem;transition:all 0.2s }
.health-card:hover { border-color:var(--accent-border) }
.health-dot { width:10px;height:10px;border-radius:50%;flex-shrink:0 }
.health-dot.healthy { background:var(--success);box-shadow:0 0 8px rgba(16,185,129,0.4) }
.health-dot.unhealthy { background:var(--danger);box-shadow:0 0 8px rgba(239,68,68,0.4) }
.health-dot.unreachable { background:var(--text-3);box-shadow:0 0 8px rgba(100,116,139,0.3) }
.count-card { padding:1rem;border-radius:10px;border:1px solid var(--glass-border);background:var(--glass-bg);text-align:center }
.count-card .count-num { font-size:1.75rem;font-weight:700;color:var(--text-1) }
.count-card .count-label { font-size:0.68rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em;margin-top:0.15rem }
</style>

<script>
/* ═══ INIT ═══ */
document.getElementById('admin-content').style.display = 'block';

/* ═══ USER MANAGEMENT ═══ */
var _usersCache = [];
function filterUsers(filter) {
  if (filter === 'all') { renderUsersTable(_usersCache); return; }
  var filtered = _usersCache.filter(function(u) {
    if (filter === 'active') return u.is_active !== false;
    if (filter === 'verified') return u.email_verified;
    if (filter === 'admin') return u.role === 'admin';
    return true;
  });
  renderUsersTable(filtered);
  /* Highlight the active stat card */
  document.querySelectorAll('#user-stats-bar .card').forEach(function(c) { c.style.boxShadow = ''; });
  var idx = { all: 0, active: 1, verified: 2, admin: 3 }[filter];
  var cards = document.querySelectorAll('#user-stats-bar .card');
  if (cards[idx]) cards[idx].style.boxShadow = '0 0 0 2px var(--accent)';
}
async function loadUsers() {
  try {
    var r = await fetch('/api/users');
    if (r.status === 403) { document.getElementById('users-table-container').innerHTML = '<p style="color:var(--danger)">Access denied. Admin role required.</p>'; return; }
    var data = await r.json();
    var users = Array.isArray(data) ? data : (data.users || []);
    _usersCache = users;
    renderUsersTable(users);
    /* Update stats bar */
    var total = users.length;
    var active = users.filter(function(u) { return u.is_active !== false; }).length;
    var verified = users.filter(function(u) { return u.email_verified; }).length;
    var admins = users.filter(function(u) { return u.role === 'admin'; }).length;
    document.getElementById('user-count-total').textContent = total;
    document.getElementById('user-count-active').textContent = active;
    document.getElementById('user-count-verified').textContent = verified;
    document.getElementById('user-count-admins').textContent = admins;
  } catch(e) { document.getElementById('users-table-container').innerHTML = '<p style="color:var(--danger)">Failed to load users: ' + escapeHtml(e.message) + '</p>'; }
}

function renderUsersTable(users) {
  if (!users || users.length === 0) {
    document.getElementById('users-table-container').innerHTML = '<p style="color:var(--text-3)">No users found.</p>';
    return;
  }
  var roleColors = { admin: 'var(--danger)', member: 'var(--accent-text)', viewer: 'var(--text-3)' };
  var html = '<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse">'
    + '<thead><tr style="border-bottom:2px solid var(--glass-border)">'
    + '<th style="text-align:left;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600">User</th>'
    + '<th style="text-align:left;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600">Email</th>'
    + '<th style="text-align:left;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600">Role</th>'
    + '<th style="text-align:left;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600">Workspace</th>'
    + '<th style="text-align:center;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600">Status</th>'
    + '<th style="text-align:center;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600">Verified</th>'
    + '<th style="text-align:right;padding:10px 12px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-3);font-weight:600">Actions</th>'
    + '</tr></thead><tbody>';
  users.forEach(function(u) {
    var initials = (u.display_name || u.username || '?').split(' ').map(function(w){return w[0]}).join('').substring(0,2).toUpperCase();
    var roleColor = roleColors[u.role] || 'var(--text-3)';
    var isActive = u.is_active !== false;
    var statusBadge = isActive
      ? '<span style="display:inline-flex;align-items:center;gap:4px;font-size:0.68rem;padding:3px 10px;border-radius:99px;background:var(--success-bg);color:var(--success);border:1px solid var(--success-border);font-weight:500"><span style="width:6px;height:6px;border-radius:50%;background:var(--success);display:inline-block"></span>Active</span>'
      : '<span style="display:inline-flex;align-items:center;gap:4px;font-size:0.68rem;padding:3px 10px;border-radius:99px;background:var(--danger-bg);color:var(--danger);border:1px solid var(--danger-border);font-weight:500"><span style="width:6px;height:6px;border-radius:50%;background:var(--danger);display:inline-block"></span>Disabled</span>';
    var verifiedBadge = u.email_verified
      ? '<span style="display:inline-flex;align-items:center;gap:4px;font-size:0.68rem;padding:3px 10px;border-radius:99px;background:var(--success-bg);color:var(--success);border:1px solid var(--success-border);font-weight:500"><svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>Verified</span>'
      : '<span style="display:inline-flex;align-items:center;gap:4px;font-size:0.68rem;padding:3px 10px;border-radius:99px;background:var(--warn-bg);color:var(--warning);border:1px solid var(--warn-border);font-weight:500"><svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>Unverified</span>';
    /* Action buttons */
    var actions = '<div style="display:flex;gap:4px;justify-content:flex-end;flex-wrap:nowrap">';
    actions += '<button class="btn btn-sm" onclick="editUser(&#39;' + u.id + '&#39;)" style="font-size:0.66rem;padding:3px 8px" title="Edit user">Edit</button>';
    if (u.username !== 'admin') {
      if (isActive) {
        actions += '<button class="btn btn-sm" onclick="toggleUserActive(&#39;' + u.id + '&#39;,false)" style="font-size:0.66rem;padding:3px 8px;color:var(--warn)" title="Disable user">Disable</button>';
      } else {
        actions += '<button class="btn btn-sm" onclick="toggleUserActive(&#39;' + u.id + '&#39;,true)" style="font-size:0.66rem;padding:3px 8px;color:var(--success)" title="Enable user">Enable</button>';
      }
      if (!u.email_verified) {
        actions += '<button class="btn btn-sm" onclick="adminVerifyUser(&#39;' + u.id + '&#39;)" style="font-size:0.66rem;padding:3px 8px;color:var(--accent-text)" title="Mark as verified">Verify</button>';
      }
      actions += '<button class="btn btn-sm" onclick="deleteUser(&#39;' + u.id + '&#39;,&#39;' + escapeHtml(u.username) + '&#39;)" style="font-size:0.66rem;padding:3px 8px;color:var(--danger)" title="Delete user">Delete</button>';
    }
    actions += '</div>';
    html += '<tr style="border-bottom:1px solid var(--glass-border)">' +
      '<td style="padding:10px 12px"><div style="display:flex;align-items:center;gap:10px"><div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--accent),rgba(139,92,246,0.7));display:flex;align-items:center;justify-content:center;font-size:0.65rem;font-weight:700;color:#fff;flex-shrink:0">' + escapeHtml(initials) + '</div><div><div style="font-weight:600;font-size:0.82rem;color:var(--text-1)">' + escapeHtml(u.display_name || u.username) + '</div><div style="font-size:0.7rem;color:var(--text-3)" class="mono">@' + escapeHtml(u.username) + '</div></div></div></td>' +
      '<td style="padding:10px 12px;font-size:0.78rem;color:var(--text-2)">' + escapeHtml(u.email || String.fromCharCode(0x2014)) + '</td>' +
      '<td style="padding:10px 12px"><span style="display:inline-block;padding:3px 10px;border-radius:99px;font-size:0.68rem;font-weight:600;text-transform:uppercase;letter-spacing:0.04em;color:' + roleColor + ';background:' + roleColor + '15;border:1px solid ' + roleColor + '25">' + escapeHtml(u.role) + '</span></td>' +
      '<td style="padding:10px 12px" class="mono"><span style="font-size:0.75rem;color:var(--text-2)">' + escapeHtml(u.default_workspace || 'default') + '</span></td>' +
      '<td style="padding:10px 12px;text-align:center">' + statusBadge + '</td>' +
      '<td style="padding:10px 12px;text-align:center">' + verifiedBadge + '</td>' +
      '<td style="padding:10px 12px">' + actions + '</td></tr>';
  });
  html += '</tbody></table></div>';
  document.getElementById('users-table-container').innerHTML = html;
}

function showCreateUserModal() {
  var overlay = document.createElement('div');
  overlay.id = 'user-modal-overlay';
  overlay.style.cssText = 'position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;background:var(--modal-overlay);backdrop-filter:blur(6px)';
  overlay.onclick = function(e) { if (e.target === overlay) closeUserModal(); };
  overlay.innerHTML = '<div style="width:440px;padding:28px 32px;background:var(--modal-bg);border:1px solid var(--modal-border);border-radius:16px;box-shadow:var(--modal-shadow)">' +
    '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px"><h3 style="margin:0;font-size:1.05rem;font-weight:700;color:var(--text-1)">Create User</h3><button onclick="closeUserModal()" style="border:none;background:transparent;cursor:pointer;color:var(--text-3);font-size:1.3rem;line-height:1;padding:4px">&times;</button></div>' +
    '<div style="display:flex;flex-direction:column;gap:14px">' +
    '<div><label style="font-size:0.68rem;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em;display:block;margin-bottom:6px">Username *</label><input type="text" id="new-user-username" class="input" placeholder="john.doe" style="width:100%;padding:10px 14px;border-radius:10px;background:var(--modal-field-bg);border:1px solid var(--modal-border);color:var(--text-1);box-sizing:border-box"></div>' +
    '<div><label style="font-size:0.68rem;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em;display:block;margin-bottom:6px">Display Name</label><input type="text" id="new-user-display" class="input" placeholder="John Doe" style="width:100%;padding:10px 14px;border-radius:10px;background:var(--modal-field-bg);border:1px solid var(--modal-border);color:var(--text-1);box-sizing:border-box"></div>' +
    '<div><label style="font-size:0.68rem;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em;display:block;margin-bottom:6px">Email</label><input type="email" id="new-user-email" class="input" placeholder="john@company.com" style="width:100%;padding:10px 14px;border-radius:10px;background:var(--modal-field-bg);border:1px solid var(--modal-border);color:var(--text-1);box-sizing:border-box"></div>' +
    '<div><label style="font-size:0.68rem;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em;display:block;margin-bottom:6px">Password *</label><input type="password" id="new-user-password" class="input" placeholder="Min 6 characters" style="width:100%;padding:10px 14px;border-radius:10px;background:var(--modal-field-bg);border:1px solid var(--modal-border);color:var(--text-1);box-sizing:border-box"></div>' +
    '<div><label style="font-size:0.68rem;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em;display:block;margin-bottom:6px">Role</label><select id="new-user-role" class="input" style="width:100%;padding:10px 14px;border-radius:10px;background:var(--modal-field-bg);border:1px solid var(--modal-border);color:var(--text-1);box-sizing:border-box"><option value="member">Member</option><option value="admin">Admin</option><option value="viewer">Viewer</option></select></div>' +
    '<div style="padding:10px 14px;border-radius:10px;background:var(--modal-field-bg);font-size:0.72rem;color:var(--text-3)"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:4px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>Admin-created users are automatically verified and can log in immediately.</div>' +
    '<div id="create-user-error" style="display:none;color:var(--danger);font-size:0.75rem;text-align:center;padding:10px 14px;background:var(--danger-bg);border:1px solid var(--danger-border);border-radius:10px"></div>' +
    '<div style="display:flex;gap:8px;margin-top:4px"><button class="btn btn-primary" onclick="createUser()" style="flex:1;padding:11px;border-radius:10px;font-weight:600">Create User</button><button class="btn btn-secondary" onclick="closeUserModal()" style="flex:1;padding:11px;border-radius:10px">Cancel</button></div>' +
    '</div></div>';
  document.body.appendChild(overlay);
  document.getElementById('new-user-username').focus();
}

async function createUser() {
  var errEl = document.getElementById('create-user-error');
  var username = document.getElementById('new-user-username').value.trim();
  var display_name = document.getElementById('new-user-display').value.trim();
  var email = document.getElementById('new-user-email').value.trim();
  var password = document.getElementById('new-user-password').value;
  var role = document.getElementById('new-user-role').value;
  if (!username || !password) { errEl.style.display = 'block'; errEl.textContent = 'Username and password are required'; return; }
  if (password.length < 6) { errEl.style.display = 'block'; errEl.textContent = 'Password must be at least 6 characters'; return; }
  try {
    var r = await fetch('/api/users', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username: username, password: password, display_name: display_name || username, email: email, role: role })
    });
    if (r.status === 409) { var d = await r.json(); errEl.style.display = 'block'; errEl.textContent = d.error || 'Username or email already exists'; return; }
    if (!r.ok) { var d = await r.json(); errEl.style.display = 'block'; errEl.textContent = d.error || d.detail || 'Failed to create user'; return; }
    closeUserModal();
    showToast('User "' + username + '" created', 'success');
    loadUsers();
  } catch(e) { errEl.style.display = 'block'; errEl.textContent = 'Error: ' + e.message; }
}

function editUser(userId) {
  var u = _usersCache.find(function(x) { return x.id === userId; });
  if (!u) return;
  var overlay = document.createElement('div');
  overlay.id = 'user-modal-overlay';
  overlay.style.cssText = 'position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;background:var(--modal-overlay);backdrop-filter:blur(6px)';
  overlay.onclick = function(e) { if (e.target === overlay) closeUserModal(); };
  var statusInfo = u.is_active !== false
    ? '<span style="color:var(--success);font-weight:500">Active</span>'
    : '<span style="color:var(--danger);font-weight:500">Disabled</span>';
  var verifiedInfo = u.email_verified
    ? '<span style="color:var(--success);font-weight:500">Verified</span>'
    : '<span style="color:var(--warning);font-weight:500">Unverified</span>';
  overlay.innerHTML = '<div style="width:440px;padding:28px 32px;background:var(--modal-bg);border:1px solid var(--modal-border);border-radius:16px;box-shadow:var(--modal-shadow)">' +
    '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px"><h3 style="margin:0;font-size:1.05rem;font-weight:700;color:var(--text-1)">Edit User</h3><button onclick="closeUserModal()" style="border:none;background:transparent;cursor:pointer;color:var(--text-3);font-size:1.3rem;line-height:1;padding:4px">&times;</button></div>' +
    '<div style="display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:10px;background:var(--modal-field-bg);margin-bottom:18px">' +
    '<div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--accent),rgba(139,92,246,0.7));display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;color:#fff;flex-shrink:0">' + escapeHtml((u.display_name || u.username || '?').charAt(0).toUpperCase()) + '</div>' +
    '<div><div style="font-weight:600;font-size:0.82rem;color:var(--text-1)">@' + escapeHtml(u.username) + '</div><div style="font-size:0.68rem;color:var(--text-3)">ID: ' + escapeHtml(u.id) + ' &middot; Status: ' + statusInfo + ' &middot; Email: ' + verifiedInfo + '</div></div></div>' +
    '<div style="display:flex;flex-direction:column;gap:14px">' +
    '<div><label style="font-size:0.68rem;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em;display:block;margin-bottom:6px">Display Name</label><input type="text" id="edit-user-display" class="input" value="' + escapeHtml(u.display_name || '') + '" style="width:100%;padding:10px 14px;border-radius:10px;background:var(--modal-field-bg);border:1px solid var(--modal-border);color:var(--text-1);box-sizing:border-box"></div>' +
    '<div><label style="font-size:0.68rem;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em;display:block;margin-bottom:6px">Email</label><input type="email" id="edit-user-email" class="input" value="' + escapeHtml(u.email || '') + '" style="width:100%;padding:10px 14px;border-radius:10px;background:var(--modal-field-bg);border:1px solid var(--modal-border);color:var(--text-1);box-sizing:border-box"></div>' +
