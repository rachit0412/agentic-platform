function adminLoadAll() {
  document.getElementById('admin-last-refresh').textContent = 'Refreshed: ' + new Date().toLocaleTimeString();
  var hash = (location.hash || '').replace('#', '');
  var sectionDefaults = { operations: 'health', identity: 'users', ai: 'llm', data: 'database', infrastructure: 'docker-images', compliance: 'compliance-rules' };
  var validTabs = ['health','users','personas','overview','llm','database','config','audit','docker-images','environment-vars','compliance-rules','compliance-audit','secret-scan'];
  var startTab;
  if (sectionDefaults[hash]) {
    startTab = sectionDefaults[hash];
  } else if (validTabs.indexOf(hash) >= 0) {
    startTab = hash;
  } else {
    startTab = 'health';
  }
  switchTab(startTab);
}

