<div id="tab-secret-scan" class="admin-tab-content" style="display:none">
  <div class="card">
    <h2 style="margin:0 0 1.5rem">🔐 Secret Scanning (Gitleaks)</h2>
    <p style="color:var(--text-3);font-size:0.9rem;margin-bottom:1.5rem">Scan the repository and codebase for hardcoded secrets, API keys, credentials, and sensitive data.</p>
    
    <!-- What Gitleaks Scans For -->
    <div style="background:linear-gradient(135deg,rgba(59,130,246,0.05),rgba(6,182,212,0.05));border:1px solid rgba(59,130,246,0.2);border-radius:10px;padding:1rem;margin-bottom:1.5rem">
      <div style="font-weight:600;color:var(--text-1);margin-bottom:0.75rem">📋 What This Scan Looks For:</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;font-size:0.85rem;color:var(--text-2)">
        <div><span style="color:var(--accent)">🔑</span> AWS Access Keys & Secrets</div>
        <div><span style="color:var(--accent)">🔑</span> GitHub Tokens & PATs</div>
        <div><span style="color:var(--accent)">🔑</span> Database Passwords</div>
        <div><span style="color:var(--accent)">🔑</span> Private SSH Keys</div>
        <div><span style="color:var(--accent)">🔑</span> API Keys (Stripe, Slack, etc.)</div>
        <div><span style="color:var(--accent)">🔑</span> OAuth Tokens</div>
        <div><span style="color:var(--accent)">🔑</span> Firebase Keys</div>
        <div><span style="color:var(--accent)">🔑</span> Encryption Passwords</div>
      </div>
      <div style="margin-top:1rem;padding-top:1rem;border-top:1px solid rgba(59,130,246,0.1);font-size:0.8rem;color:var(--text-3)">
        ⚠️ <strong>Action Required:</strong> Any secrets found should be considered <strong>compromised</strong> and must be rotated immediately. If found in git history, use <code style="background:var(--input-bg);padding:0.2rem 0.4rem;border-radius:3px;font-family:monospace;font-size:0.75rem">git-filter-branch</code> or <code style="background:var(--input-bg);padding:0.2rem 0.4rem;border-radius:3px;font-family:monospace;font-size:0.75rem">git-filter-repo</code> to remove them.
      </div>
    </div>
    
    <div class="section-header" style="margin-bottom:1.5rem">
      <h3>Scan Configuration</h3>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.5rem">
      <div>
        <label class="input-label">Scan Path</label>
        <input id="scan-path-input" type="text" class="input" value="/app" placeholder="/app" style="font-size:0.9rem">
        <div style="font-size:0.72rem;color:var(--text-3);margin-top:0.25rem">Enter the path to scan (e.g., /app, /app/services)</div>
      </div>
      <div>
        <label class="input-label">Output Format</label>
        <select id="scan-format-select" class="input" style="font-size:0.9rem">
          <option value="json">JSON (Detailed)</option>
          <option value="csv">CSV</option>
          <option value="sarif">SARIF (Security)</option>
        </select>
        <div style="font-size:0.72rem;color:var(--text-3);margin-top:0.25rem">Format for scan results</div>
      </div>
    </div>

    <div style="display:flex;gap:0.75rem;margin-bottom:2rem;flex-wrap:wrap">
      <button class="btn btn-primary" onclick="runSecretScan()" id="secret-scan-btn" style="padding:0.75rem 1.5rem">
        <span id="scan-btn-text">🔍 Run Secret Scan</span>
        <span id="scan-btn-spinner" style="display:none;margin-left:0.5rem">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation:spin 1s linear infinite"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 1 10 10"/></svg>
        </span>
