async function saveUser(userId) {
  var errEl = document.getElementById('edit-user-error');
  var body = {};
  var display = document.getElementById('edit-user-display').value.trim();
  var email = document.getElementById('edit-user-email').value.trim();
  var role = document.getElementById('edit-user-role').value;
  var password = document.getElementById('edit-user-password').value;
  if (display) body.display_name = display;
  if (email) body.email = email;
  body.role = role;
  if (password) { if (password.length < 6) { errEl.style.display = 'block'; errEl.textContent = 'Password must be at least 6 characters'; return; } body.password = password; }
  try {
    var r = await fetch('/api/users/' + userId, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    });
    if (!r.ok) { var d = await r.json(); errEl.style.display = 'block'; errEl.textContent = d.error || d.detail || 'Failed to update user'; return; }
    closeUserModal();
    showToast('User updated', 'success');
    loadUsers();
  } catch(e) { errEl.style.display = 'block'; errEl.textContent = 'Error: ' + e.message; }
}

async function deleteUser(userId, username) {
  if (!confirm('Delete user "' + username + '"? This cannot be undone.')) return;
  try {
    var r = await fetch('/api/users/' + userId, { method: 'DELETE' });
    if (r.status === 403) { showToast('Cannot delete admin user', 'error'); return; }
    if (!r.ok) { showToast('Failed to delete user', 'error'); return; }
    showToast('User "' + username + '" deleted', 'success');
    loadUsers();
  } catch(e) { showToast('Error: ' + e.message, 'error'); }
}

function closeUserModal() {
  var overlay = document.getElementById('user-modal-overlay');
  if (overlay) overlay.remove();
}

async function toggleUserActive(userId, activate) {
  var action = activate ? 'enable' : 'disable';
  if (!confirm('Are you sure you want to ' + action + ' this user?')) return;
  try {
    var r = await fetch('/api/users/' + userId, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ is_active: activate })
    });
    if (!r.ok) { showToast('Failed to ' + action + ' user', 'error'); return; }
    showToast('User ' + action + 'd successfully', 'success');
    loadUsers();
  } catch(e) { showToast('Error: ' + e.message, 'error'); }
}

async function adminVerifyUser(userId) {
  if (!confirm('Mark this user as email verified?')) return;
  try {
    var r = await fetch('/api/users/' + userId + '/verify', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    });
    if (!r.ok) { showToast('Failed to verify user', 'error'); return; }
