async function loadWorkspacesAdmin() {
  try {
    var r = await fetch('/api/workspaces');
    var d = await r.json();
    var items = Array.isArray(d) ? d : (d.workspaces || []);
    if (items.length === 0) {
      document.getElementById('workspaces-admin-table').innerHTML = '<p style="color:var(--text-3)">No workspaces configured.</p>';
      return;
    }
    var html = '<table><tr><th>Name</th><th>ID</th><th>Members</th><th>Created</th></tr>';
    items.forEach(function(w) {
      var created = w.created_at ? new Date(w.created_at).toLocaleDateString() : String.fromCharCode(0x2014);
      var members = Array.isArray(w.members) ? w.members.length : (w.member_count || String.fromCharCode(0x2014));
      html += '<tr><td style="font-weight:600">' + escapeHtml(w.name || w.id) + '</td>' +
        '<td class="mono" style="font-size:0.75rem">' + escapeHtml(w.id) + '</td>' +
        '<td>' + members + '</td>' +
        '<td class="mono" style="font-size:0.75rem">' + created + '</td></tr>';
    });
    html += '</table>';
    document.getElementById('workspaces-admin-table').innerHTML = html;
  } catch(e) { document.getElementById('workspaces-admin-table').innerHTML = '<p style="color:var(--text-3)">Failed to load workspaces</p>'; }
}

/* ═══ NAVIGATION ═══ */
var SECTION_TABS = {
  operations: ['health', 'overview', 'audit'],
  identity: ['users', 'personas'],
  ai: ['llm', 'config'],
  data: ['database'],
  infrastructure: ['docker-images', 'environment-vars'],
  compliance: ['compliance-rules', 'compliance-audit', 'secret-scan']
};
var TAB_SECTION = {
  health: 'operations', overview: 'operations', audit: 'operations',
  users: 'identity', personas: 'identity',
  llm: 'ai', config: 'ai',
  database: 'data',
  'docker-images': 'infrastructure', 'environment-vars': 'infrastructure',
  'compliance-rules': 'compliance', 'compliance-audit': 'compliance', 'secret-scan': 'compliance'
};

function switchSection(section) {
  /* Update section tab active states */
  document.querySelectorAll('.admin-stab').forEach(function(el) {
    el.classList.toggle('active', el.getAttribute('data-section') === section);
  });
  /* Show only the matching subtab row */
  document.querySelectorAll('.admin-subtabs').forEach(function(el) {
    el.style.display = el.id === 'subtabs-' + section ? 'flex' : 'none';
  });
  /* Navigate to first tab of section */
  var firstTab = (SECTION_TABS[section] || [])[0];
  if (firstTab) switchTab(firstTab, true);
}

function switchTab(tab, fromSection) {
  /* Sync section if needed */
  if (!fromSection) {
    var sec = TAB_SECTION[tab];
    if (sec) {
      document.querySelectorAll('.admin-stab').forEach(function(el) {
        el.classList.toggle('active', el.getAttribute('data-section') === sec);
      });
      document.querySelectorAll('.admin-subtabs').forEach(function(el) {
        el.style.display = el.id === 'subtabs-' + sec ? 'flex' : 'none';
      });
    }
  }
  /* Update subtab active states */
  document.querySelectorAll('.admin-subtab').forEach(function(el) {
    el.classList.toggle('active', el.getAttribute('data-tab') === tab);
  });
  /* Show content panel */
  document.querySelectorAll('.admin-tab-content').forEach(function(el) {
    el.style.display = 'none';
  });
  var panel = document.getElementById('tab-' + tab);
  if (panel) panel.style.display = 'block';
  history.replaceState(null, '', '#' + tab);
  /* Load data */
  if (tab === 'health') loadServiceHealth();
  if (tab === 'users') { loadUsers(); loadWorkspacesAdmin(); }
  if (tab === 'personas') { loadPersonas(); loadUserPersonaAssignments(); }
  if (tab === 'overview') { loadOverviewCounts(); loadMemoryStats(); }
  if (tab === 'llm') { loadLlmConfig(); loadModels(); loadLlmSummary(); }
  if (tab === 'database') { loadDbStats(); loadChromaStats(); loadDocStats(); }
  if (tab === 'config') { loadUISettings(); loadGlobalConstraints(); loadSecurityConsiderations(); loadBestPractices(); loadGuardrails(); loadN8nWorkflows(); highlightThemeCard(); setTimeout(function() { switchConfigTab('appearance'); }, 50); }
  if (tab === 'docker-images') { loadDockerImages(); loadDockerSecuritySummary(); if (typeof initDockerManagement === 'function') { setTimeout(initDockerManagement, 100); } }
  if (tab === 'environment-vars') { loadEnvVars(); loadLLMProviderSelection(); }
  if (tab === 'audit') loadAuditLog();
  if (tab === 'compliance-rules') { loadComplianceSettings(); }
  if (tab === 'compliance-audit') { loadAuditLog('compliance'); }
}

/* Wire up nav via event delegation (avoids inline onclick in template literal) */
document.getElementById('admin-section-tabs').addEventListener('click', function(e) {
  var btn = e.target.closest('.admin-stab');
  if (btn) switchSection(btn.getAttribute('data-section'));
});
document.querySelectorAll('.admin-subtabs').forEach(function(row) {
  row.addEventListener('click', function(e) {
    var btn = e.target.closest('.admin-subtab');
    if (btn) switchTab(btn.getAttribute('data-tab'));
  });
});

/* Hash-change: sidebar links like /admin#identity navigate here without reload */
window.addEventListener('hashchange', function() {
  adminLoadAll();
});

/* ═══ DESIGN THEME ═══ */
function applyDesignTheme(name) {
  if (typeof setDesignTheme === 'function') setDesignTheme(name);
  highlightThemeCard();
}
function highlightThemeCard() {
  var current = (typeof getDesignTheme === 'function') ? getDesignTheme() : 'midnight';
  var themes = ['midnight', 'aurora', 'softui', 'horizon'];
  for (var i = 0; i < themes.length; i++) {
    var el = document.getElementById('theme-card-' + themes[i]);
    if (!el) continue;
    if (themes[i] === current) {
      el.style.borderColor = 'var(--accent)';
      el.style.boxShadow = '0 0 0 1px var(--accent)';
    } else {
      el.style.borderColor = 'var(--glass-border)';
      el.style.boxShadow = 'none';
    }
  }
}

