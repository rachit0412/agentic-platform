/* ═══ AUDIT LOG ═══ */
async function loadAuditLog(type) {
  try {
    // Determine which container to use
    const isComplianceTab = type === 'compliance' || document.getElementById('tab-compliance-audit').style.display !== 'none';
    const tableContainer = isComplianceTab ? document.getElementById('audit-log-table') : document.getElementById('audit-log');
    
    if (!tableContainer) {
      console.error('Audit log table container not found');
      return;
    }
    
    // Get filter values
    const typeFilterEl = document.getElementById('audit-filter-type');
    const actionFilterEl = document.getElementById('audit-filter-action');
    const complianceFilterEl = document.getElementById('audit-filter');
    
    const typeVal = typeFilterEl ? typeFilterEl.value : '';
    const actionVal = actionFilterEl ? actionFilterEl.value : '';
    const complianceVal = complianceFilterEl ? complianceFilterEl.value : '';
    
    // Build query parameters
    const params = new URLSearchParams({ limit: '100' });
    if (typeVal) params.set('entity_type', typeVal);
    if (actionVal) params.set('action', actionVal);
    if (complianceVal) params.set('event_type', complianceVal);
    
    // Fetch audit log
    const response = await fetch('/api/audit-log?' + params.toString());
    if (!response.ok) throw new Error('HTTP ' + response.status);
    
    const data = await response.json();
    
    if (!data.entries || data.entries.length === 0) {
      if (isComplianceTab) {
        tableContainer.innerHTML = '<table style="width:100%;border-collapse:collapse;font-size:0.9rem"><thead><tr style="border-bottom:2px solid var(--divider)"><th style="text-align:left;padding:0.75rem;font-weight:600">Timestamp</th><th style="text-align:left;padding:0.75rem;font-weight:600">User</th><th style="text-align:left;padding:0.75rem;font-weight:600">Event Type</th><th style="text-align:left;padding:0.75rem;font-weight:600">Details</th></tr></thead><tbody><tr style="border-bottom:1px solid var(--divider);color:var(--text-3)"><td colspan="4" style="padding:2rem;text-align:center">No audit events yet</td></tr></tbody></table>';
      } else {
        tableContainer.innerHTML = '<p style="color:var(--text-3)">No audit log entries yet. Changes will appear here.</p>';
      }
      return;
    }
    
    if (isComplianceTab) {
      // Render compliance audit table
      let tableHtml = '<table style="width:100%;border-collapse:collapse;font-size:0.9rem"><thead><tr style="border-bottom:2px solid var(--divider)"><th style="text-align:left;padding:0.75rem;font-weight:600">Timestamp</th><th style="text-align:left;padding:0.75rem;font-weight:600">User</th><th style="text-align:left;padding:0.75rem;font-weight:600">Event Type</th><th style="text-align:left;padding:0.75rem;font-weight:600">Details</th></tr></thead><tbody>';
      
      data.entries.forEach(function(entry) {
        const time = new Date(entry.created_at).toLocaleString();
        const user = entry.user_id || entry.username || 'System';
        const eventType = entry.action || entry.event_type || 'Unknown';
        const details = entry.details ? (typeof entry.details === 'string' ? entry.details : JSON.stringify(entry.details).substring(0, 150)) : '';
        
        tableHtml += '<tr style="border-bottom:1px solid var(--divider);color:var(--text-1)">'
          + '<td style="padding:0.75rem;font-family:monospace;font-size:0.8rem;white-space:nowrap">' + escapeHtml(time) + '</td>'
          + '<td style="padding:0.75rem">' + escapeHtml(user) + '</td>'
          + '<td style="padding:0.75rem;font-weight:500">' + escapeHtml(eventType) + '</td>'
          + '<td style="padding:0.75rem;font-size:0.85rem;color:var(--text-2);max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="' + escapeHtml(details) + '">' + escapeHtml(details) + '</td>'
          + '</tr>';
      });
      
      tableHtml += '</tbody></table>';
      tableContainer.innerHTML = tableHtml;
    } else {
      // Render regular audit log table
      const actionColors = { create: 'var(--success)', update: 'var(--info)', delete: 'var(--danger)', rollback: 'var(--warning)' };
      let html = '<table><tr><th>Time</th><th>Action</th><th>Type</th><th>Name</th><th>Details</th></tr>';
      
      html += data.entries.map(function(e) {
        const time = new Date(e.created_at).toLocaleString();
        const color = actionColors[e.action] || 'var(--text-3)';
        const details = e.details && Object.keys(e.details).length > 0 ? escapeHtml(JSON.stringify(e.details)).substring(0, 120) : '';
        return '<tr><td class="mono" style="font-size:0.72rem;white-space:nowrap">' + time + '</td>'
          + '<td><span style="color:' + color + ';font-weight:600;text-transform:uppercase;font-size:0.72rem">' + escapeHtml(e.action) + '</span></td>'
          + '<td style="font-size:0.78rem">' + escapeHtml(e.entity_type) + '</td>'
          + '<td style="font-size:0.78rem">' + escapeHtml(e.entity_name || e.entity_id) + '</td>'
          + '<td class="mono" style="font-size:0.72rem;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="' + details + '">' + details + '</td></tr>';
      }).join('');
      
      html += '</table>';
      tableContainer.innerHTML = html;
    }
  } catch(e) {
    console.error('Error loading audit log:', e);
    const tableContainer = document.getElementById(type === 'compliance' ? 'audit-log-table' : 'audit-log');
    if (tableContainer) {
      tableContainer.innerHTML = '<p style="color:var(--danger)">Failed to load audit log: ' + escapeHtml(e.message) + '</p>';
    }
  }
}

// Safely attach event listeners
setTimeout(function() {
  var typeFilter = document.getElementById('audit-filter-type');
  var actionFilter = document.getElementById('audit-filter-action');
  var complianceFilter = document.getElementById('audit-filter');
  
  if (typeFilter) typeFilter.addEventListener('change', function() { loadAuditLog(); });
  if (actionFilter) actionFilter.addEventListener('change', function() { loadAuditLog(); });
  if (complianceFilter) complianceFilter.addEventListener('change', function() { loadAuditLog('compliance'); });
}, 100);

function exportAuditLog() {
  try {
    const table = document.getElementById('audit-log-table');
    if (!table) throw new Error('Table not found');
    
    const rows = table.querySelectorAll('tr');
    if (rows.length < 2) {
      showToast('No audit entries to export', 'warning');
      return;
    }
    
    // Extract table data to CSV
    let csvContent = 'Timestamp,User,Event Type,Details\n';
    for (let i = 1; i < rows.length; i++) {
      const cells = rows[i].querySelectorAll('td');
      if (cells.length >= 4) {
        const time = cells[0].textContent.trim();
        const user = cells[1].textContent.trim();
        const eventType = cells[2].textContent.trim();
        const details = cells[3].textContent.trim();
        csvContent += `"${time}","${user}","${eventType}","${details.replace(/"/g, '""')}"\n`;
      }
    }
    
    // Download CSV
    const timestamp = new Date().toISOString().slice(0, 10);
    const filename = `audit-log-${timestamp}.csv`;
    const blob = new Blob([csvContent], { type: 'text/csv' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    a.click();
    URL.revokeObjectURL(url);
    
    showToast(`Exported ${rows.length - 1} audit entries`, 'success');
  } catch(e) {
    showToast('Error exporting audit log: ' + e.message, 'error');
  }
}


