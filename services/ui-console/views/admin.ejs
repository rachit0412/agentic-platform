<%- include('layout', { title: 'Admin Plane', page: 'admin', body: `

<!-- ── Auth Overlay ── -->
<div id="admin-auth-overlay" style="position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;background:rgba(2,6,23,0.92);backdrop-filter:blur(12px)">
  <div style="width:360px;padding:2rem;background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:16px;box-shadow:0 25px 50px rgba(0,0,0,0.5)">
    <div style="text-align:center;margin-bottom:1.5rem">
      <div style="width:48px;height:48px;border-radius:14px;background:linear-gradient(135deg,rgba(244,63,94,0.2),rgba(139,92,246,0.2));display:inline-flex;align-items:center;justify-content:center;margin-bottom:0.75rem">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#f43f5e" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      </div>
      <h2 style="margin:0;font-size:1.25rem;color:var(--text-1)">Admin Plane</h2>
      <p style="margin:0.35rem 0 0;color:var(--text-3);font-size:0.82rem">Enter credentials to access the admin panel</p>
    </div>
    <div style="display:flex;flex-direction:column;gap:0.75rem">
      <div>
        <label style="font-size:0.72rem;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em;display:block;margin-bottom:0.25rem">Username</label>
        <input type="text" id="admin-user" class="input" placeholder="admin" autocomplete="username" style="width:100%">
      </div>
      <div>
        <label style="font-size:0.72rem;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em;display:block;margin-bottom:0.25rem">Password</label>
        <input type="password" id="admin-pass" class="input" placeholder="\\u2022\\u2022\\u2022\\u2022\\u2022\\u2022\\u2022\\u2022" autocomplete="current-password" style="width:100%" onkeydown="if(event.key==='Enter')adminLogin()">
      </div>
      <div id="admin-auth-error" style="display:none;color:#f43f5e;font-size:0.78rem;text-align:center;padding:0.35rem;background:rgba(244,63,94,0.08);border-radius:8px"></div>
      <button class="btn btn-primary" onclick="adminLogin()" style="width:100%;margin-top:0.25rem">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
        Sign In
      </button>
      <p style="text-align:center;font-size:0.68rem;color:var(--text-3);margin:0">Default: admin / admin</p>
    </div>
  </div>
</div>

<!-- ── Admin Content (hidden until authenticated) ── -->
<div id="admin-content" style="display:none">

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem">
  <div>
    <h1 class="text-glow-cyan" style="margin-bottom:0.25rem">Admin Plane</h1>
    <p style="color:var(--text-3);font-size:0.82rem;margin:0">System configuration, service management, and operational controls</p>
  </div>
  <div style="display:flex;gap:0.5rem;align-items:center">
    <span id="admin-session-user" style="font-size:0.78rem;color:var(--text-3)"></span>
    <button class="btn btn-sm" onclick="adminLogout()" style="font-size:0.72rem">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      Sign Out
    </button>
  </div>
</div>

<div class="card animate-fade-up" style="margin-bottom:1.5rem">
  <h3>Environment Info</h3>
  <table class="mt-1">
    <tr><th>Variable</th><th>Value</th></tr>
    <tr><td>Node Environment</td><td class="mono">${process.env.NODE_ENV || 'development'}</td></tr>
    <tr><td>Agent Service</td><td class="mono" style="color:var(--accent-text)">${urls.agent}</td></tr>
    <tr><td>n8n</td><td class="mono" style="color:var(--accent-text)">${urls.n8n}</td></tr>
    <tr><td>Langfuse</td><td class="mono" style="color:var(--accent-text)">${urls.langfuse}</td></tr>
    <tr><td>Grafana</td><td class="mono" style="color:var(--accent-text)">${urls.grafana}</td></tr>
  </table>
</div>

<div class="card animate-fade-up delay-100" style="margin-bottom:1.5rem">
  <div class="section-header">
    <h3>Ollama Models</h3>
    <button class="btn btn-secondary btn-sm" onclick="loadModels()">Refresh</button>
  </div>
  <div id="models-list" class="mt-1" style="color:var(--text-3);font-size:0.82rem">Loading...</div>
</div>

<div class="card animate-fade-up delay-200" style="margin-bottom:1.5rem">
  <h3>Service Versions</h3>
  <table class="mt-1">
    <tr><th>Service</th><th>Version</th></tr>
    <tr><td>Agent Service</td><td class="mono" style="font-size:0.78rem">2.0.0 (FastAPI + LangGraph + LangChain)</td></tr>
    <tr><td>Tools Service</td><td class="mono" style="font-size:0.78rem">2.0.0 (FastAPI + Web Search + Code Exec)</td></tr>
    <tr><td>UI Console</td><td class="mono" style="font-size:0.78rem">2.0.0 (Express + EJS)</td></tr>
    <tr><td>ChromaDB</td><td class="mono" style="font-size:0.78rem">latest (Vector Store)</td></tr>
    <tr><td>Ollama</td><td class="mono" style="font-size:0.78rem">latest</td></tr>
    <tr><td>n8n</td><td class="mono" style="font-size:0.78rem">latest</td></tr>
    <tr><td>Langfuse</td><td class="mono" style="font-size:0.78rem">2.x</td></tr>
    <tr><td>Grafana</td><td class="mono" style="font-size:0.78rem">latest</td></tr>
  </table>
</div>

<div class="card animate-fade-up delay-300" style="margin-bottom:1.5rem">
  <div class="section-header">
    <h3>Database Status</h3>
    <div>
      <button class="btn btn-secondary btn-sm" onclick="loadDbStats()">Refresh</button>
      <button class="btn btn-primary btn-sm" onclick="exportData()" style="margin-left:.5rem">Export All</button>
      <label class="btn btn-secondary btn-sm" style="margin-left:.5rem;cursor:pointer">Import
        <input type="file" accept=".json" style="display:none" onchange="importData(event)">
      </label>
    </div>
  </div>
  <div id="db-stats" class="mt-1" style="color:var(--text-3);font-size:0.82rem">Loading...</div>
</div>

<div class="card animate-fade-up delay-300">
  <h3>Feature Toggles</h3>
  <table class="mt-1">
    <tr><th>Feature</th><th>Status</th></tr>
    <tr>
      <td>LangChain Integration</td>
      <td><span class="badge badge-success">Enabled</span></td>
    </tr>
    <tr>
      <td>Vector Memory (ChromaDB)</td>
      <td><span class="badge badge-success">Enabled (Core)</span></td>
    </tr>
    <tr>
      <td>RAG Pipeline</td>
      <td><span class="badge badge-success">Enabled</span></td>
    </tr>
    <tr>
      <td>Web Search (DuckDuckGo)</td>
      <td><span class="badge badge-success">Enabled</span></td>
    </tr>
    <tr>
      <td>Code Execution (Sandboxed)</td>
      <td><span class="badge badge-success">Enabled</span></td>
    </tr>
    <tr>
      <td>LLM Tracing (Langfuse)</td>
      <td><span class="badge badge-success">Enabled</span></td>
    </tr>
    <tr>
      <td>OpenTelemetry</td>
      <td><span class="badge badge-success">Enabled</span></td>
    </tr>
    <tr>
      <td>Streaming SSE</td>
      <td><span class="badge badge-success">Enabled</span></td>
    </tr>
    <tr>
      <td>ReAct Agent Loop</td>
      <td><span class="badge badge-success">Enabled (max 5 iters)</span></td>
    </tr>
    <tr>
      <td>Version History</td>
      <td><span class="badge badge-success">Enabled</span></td>
    </tr>
    <tr>
      <td>Audit Logging</td>
      <td><span class="badge badge-success">Enabled</span></td>
    </tr>
  </table>
</div>

<div class="card animate-fade-up delay-400" style="margin-top:1.5rem">
  <div class="section-header">
    <h3>Audit Log</h3>
    <div>
      <select id="audit-filter-type" style="background:var(--input-bg);color:var(--text-1);border:1px solid var(--glass-border);border-radius:6px;padding:0.25rem 0.5rem;font-size:0.78rem;margin-right:.5rem">
        <option value="">All Types</option>
        <option value="agent">Agents</option>
        <option value="skill">Skills</option>
        <option value="prompt">Prompts</option>
      </select>
      <select id="audit-filter-action" style="background:var(--input-bg);color:var(--text-1);border:1px solid var(--glass-border);border-radius:6px;padding:0.25rem 0.5rem;font-size:0.78rem;margin-right:.5rem">
        <option value="">All Actions</option>
        <option value="create">Create</option>
        <option value="update">Update</option>
        <option value="delete">Delete</option>
        <option value="rollback">Rollback</option>
      </select>
      <button class="btn btn-secondary btn-sm" onclick="loadAuditLog()">Refresh</button>
    </div>
  </div>
  <div id="audit-log" class="mt-1" style="color:var(--text-3);font-size:0.82rem;max-height:400px;overflow-y:auto">Loading...</div>
</div>

</div><!-- /admin-content -->

<script>
/* ═══ AUTH ═══ */
var ADMIN_CREDS = { admin: 'admin' };

function adminLogin() {
  var user = document.getElementById('admin-user').value.trim();
  var pass = document.getElementById('admin-pass').value;
  var errEl = document.getElementById('admin-auth-error');
  if (!user || !pass) { errEl.style.display = 'block'; errEl.textContent = 'Please enter username and password'; return; }
  if (ADMIN_CREDS[user] && ADMIN_CREDS[user] === pass) {
    sessionStorage.setItem('admin_auth', JSON.stringify({user: user, ts: Date.now()}));
    showAdminContent(user);
  } else {
    errEl.style.display = 'block';
    errEl.textContent = 'Invalid credentials. Try again.';
    document.getElementById('admin-pass').value = '';
    document.getElementById('admin-pass').focus();
  }
}

function adminLogout() {
  sessionStorage.removeItem('admin_auth');
  document.getElementById('admin-content').style.display = 'none';
  document.getElementById('admin-auth-overlay').style.display = 'flex';
  document.getElementById('admin-pass').value = '';
  document.getElementById('admin-user').value = '';
  document.getElementById('admin-auth-error').style.display = 'none';
}

function showAdminContent(user) {
  document.getElementById('admin-auth-overlay').style.display = 'none';
  document.getElementById('admin-content').style.display = 'block';
  document.getElementById('admin-session-user').innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:3px"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>' + escapeHtml(user);
  adminLoadAll();
}

function adminCheckSession() {
  try {
    var s = JSON.parse(sessionStorage.getItem('admin_auth') || 'null');
    if (s && s.user && (Date.now() - s.ts) < 3600000) {
      showAdminContent(s.user);
      return;
    }
  } catch(e) {}
  document.getElementById('admin-auth-overlay').style.display = 'flex';
  document.getElementById('admin-user').focus();
}

function adminLoadAll() {
  loadDbStats();
  loadModels();
  loadAuditLog();
}
async function loadDbStats() {
  try {
    const r = await fetch('/api/db-stats');
    const d = await r.json();
    const el = document.getElementById('db-stats');
    const sizeMB = (d.db_size_bytes / (1024*1024)).toFixed(2);
    const tables = ['agents','skills','prompts','conversations','documents','mcp_servers','a2a_peers','guardrails','custom_tools','session_summaries','version_history','audit_log'];
    el.innerHTML = '<p style="margin-bottom:.5rem"><strong>DB Path:</strong> <code style="color:var(--accent-text)">' + escapeHtml(d.db_path||'unknown') + '</code> &nbsp; <strong>Size:</strong> ' + sizeMB + ' MB</p>' +
      '<table><tr><th>Table</th><th>Records</th></tr>' +
      tables.map(t => '<tr><td>' + t + '</td><td class="mono">' + (d[t]||0) + '</td></tr>').join('') + '</table>';
  } catch(e) { document.getElementById('db-stats').innerHTML = '<p style="color:var(--danger)">Failed to load DB stats</p>'; }
}
async function exportData() {
  try {
    const r = await fetch('/api/export');
    const d = await r.json();
    const blob = new Blob([JSON.stringify(d, null, 2)], {type:'application/json'});
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'agentic-platform-export-' + new Date().toISOString().slice(0,10) + '.json';
    a.click();
    URL.revokeObjectURL(a.href);
    showToast('Data exported successfully', 'success');
  } catch(e) { showToast('Export failed: ' + e.message, 'error'); }
}
async function importData(evt) {
  const file = evt.target.files[0];
  if (!file) return;
  try {
    const text = await file.text();
    const data = JSON.parse(text);
    const r = await fetch('/api/import', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(data) });
    if (!r.ok) { showToast('Import failed: ' + r.statusText, 'error'); return; }
    const result = await r.json();
    showToast('Import complete', 'success');
    loadDbStats();
  } catch(e) { showToast('Import failed: ' + e.message, 'error'); }
  evt.target.value = '';
}

async function loadModels() {
  try {
    const r = await fetch('/api/models');
    const d = await r.json();
    const el = document.getElementById('models-list');
    if (!d.models || d.models.length === 0) {
      el.innerHTML = '<p style="color:var(--text-3)">No models found. Pull models with: <code style="color:var(--accent-text)">docker exec ollama ollama pull llama3</code></p>';
      return;
    }
    var activeModel = d.active ? d.active.model : '';
    el.innerHTML = '<table><tr><th>Model</th><th>Provider</th><th>Size</th></tr>' +
      d.models.map(m => \`<tr>
        <td>\${escapeHtml(m.full_name || m.model)} \${m.active ? '<span class="badge badge-success">active</span>' : ''}</td>
        <td class="mono" style="font-size:0.78rem">\${escapeHtml(m.provider || '')}</td>
        <td class="mono">\${m.size ? (m.size / 1e9).toFixed(1) + ' GB' : '—'}</td>
      </tr>\`).join('') + '</table>';
  } catch(e) {
    document.getElementById('models-list').innerHTML = '<p style="color:var(--danger)">Failed to load models</p>';
  }
}

async function loadAuditLog() {
  try {
    const typeFilter = document.getElementById('audit-filter-type').value;
    const actionFilter = document.getElementById('audit-filter-action').value;
    const params = new URLSearchParams({limit: '100'});
    if (typeFilter) params.set('entity_type', typeFilter);
    if (actionFilter) params.set('action', actionFilter);
    const r = await fetch('/api/audit-log?' + params.toString());
    const d = await r.json();
    const el = document.getElementById('audit-log');
    if (!d.entries || d.entries.length === 0) {
      el.innerHTML = '<p style="color:var(--text-3)">No audit log entries yet. Changes to agents, skills, and prompts will appear here.</p>';
      return;
    }
    const actionColors = {create:'var(--success)',update:'var(--info)',delete:'var(--danger)',rollback:'var(--warning)'};
    el.innerHTML = '<table><tr><th>Time</th><th>Action</th><th>Type</th><th>Name</th><th>Details</th></tr>' +
      d.entries.map(e => {
        const time = new Date(e.created_at).toLocaleString();
        const color = actionColors[e.action] || 'var(--text-3)';
        const details = e.details && Object.keys(e.details).length > 0 ? escapeHtml(JSON.stringify(e.details)) : '';
        return '<tr><td class="mono" style="font-size:0.72rem;white-space:nowrap">' + time + '</td>' +
          '<td><span style="color:' + color + ';font-weight:600;text-transform:uppercase;font-size:0.72rem">' + escapeHtml(e.action) + '</span></td>' +
          '<td style="font-size:0.78rem">' + escapeHtml(e.entity_type) + '</td>' +
          '<td style="font-size:0.78rem">' + escapeHtml(e.entity_name || e.entity_id) + '</td>' +
          '<td class="mono" style="font-size:0.72rem;max-width:200px;overflow:hidden;text-overflow:ellipsis">' + details + '</td></tr>';
      }).join('') + '</table>';
  } catch(e) { document.getElementById('audit-log').innerHTML = '<p style="color:var(--danger)">Failed to load audit log</p>'; }
}
document.getElementById('audit-filter-type').addEventListener('change', loadAuditLog);
document.getElementById('audit-filter-action').addEventListener('change', loadAuditLog);
adminCheckSession();
<\/script>
` }) %>
