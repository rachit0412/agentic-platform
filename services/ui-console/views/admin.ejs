        html += '<div style="font-size:1.25rem;font-weight:700;color:var(--text-1)">' + (typeof d[k] === 'number' ? d[k].toLocaleString() : escapeHtml(String(d[k]))) + '</div>';
        html += '<div style="font-size:0.68rem;color:var(--text-3);text-transform:uppercase">' + escapeHtml(k.replace(/_/g, ' ')) + '</div>';
