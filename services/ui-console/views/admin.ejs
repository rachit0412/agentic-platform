          var anyAllowed = false;
          subLinks.forEach(function(sl) {
            var sp = (sl.getAttribute('href') || '').replace(/^\//, '').split('?')[0];
            if (allowedNav.indexOf(sp) !== -1) { anyAllowed = true; sl.style.display = ''; }
