      var clickAttr = url ? ' style="cursor:pointer" onclick="window.open(&#39;' + escapeHtml(url) + '&#39;,&#39;_blank&#39;)" title="Open ' + escapeHtml(s.name) + '"' : '';
      return '<div class="health-card"' + clickAttr + '>' +
        '<div class="health-dot ' + s.status + '"></div>' +
