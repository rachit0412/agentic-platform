<%- include('layout', { title: 'Admin Plane', page: 'admin', body: '\n\n<!-- ── Admin Content ── -->\n<div id=\\"admin-content\\">\n\n<!-- Header -->\n<div style=\\"display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem\\">\n  <div>\n    <h1 class=\\"text-glow-cyan\\" style=\\"margin-bottom:0.25rem\\">Admin Plane</h1>\n    <p style=\\"color:var(--text-3);font-size:0.82rem;margin:0\\">System health, user management, configuration, services &amp; audit controls</p>\n  </div>\n  <div style=\\"display:flex;gap:0.5rem;align-items:center\\">\n    <span id=\\"admin-last-refresh\\" style=\\"font-size:0.68rem;color:var(--text-3)\\"></span>\n    <button class=\\"btn btn-sm\\" onclick=\\"adminLoadAll()\\" title=\\"Refresh all\\" style=\\"font-size:0.72rem\\">\n      <svg viewBox=\\"0 0 24 24\\" width=\\"14\\" height=\\"14\\" fill=\\"none\\" stroke=\\"currentColor\\" stroke-width=\\"2\\"><polyline points=\\"23 4 23 10 17 10\\"/><polyline points=\\"1 20 1 14 7 14\\"/><path d=\\"M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15\\"/></svg>\n      Refresh\n    </button>\n  </div>\n</div>\n\n<!-- Two-level admin nav -->\n<div class=\\"admin-nav\\" id=\\"admin-nav\\">\n  <div class=\\"admin-section-tabs\\" id=\\"admin-section-tabs\\">\n    <button class=\\"admin-stab\\" data-section=\\"operations\\">\n      <svg viewBox=\\"0 0 24 24\\" width=\\"14\\" height=\\"14\\" fill=\\"none\\" stroke=\\"currentColor\\" stroke-width=\\"2\\"><polyline points=\\"22 12 18 12 15 21 9 3 6 12 2 12\\"/></svg>\n      Operations\n    </button>\n    <button class=\\"admin-stab\\" data-section=\\"identity\\">\n      <svg viewBox=\\"0 0 24 24\\" width=\\"14\\" height=\\"14\\" fill=\\"none\\" stroke=\\"currentColor\\" stroke-width=\\"2\\"><path d=\\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\\"/><circle cx=\\"9\\" cy=\\"7\\" r=\\"4\\"/><path d=\\"M23 21v-2a4 4 0 0 0-3-3.87\\"/><path d=\\"M16 3.13a4 4 0 0 1 0 7.75\\"/></svg>\n      Identity &amp; Access\n    </button>\n    <button class=\\"admin-stab\\" data-section=\\"ai\\">\n      <svg viewBox=\\"0 0 24 24\\" width=\\"14\\" height=\\"14\\" fill=\\"none\\" stroke=\\"currentColor\\" stroke-width=\\"2\\"><path d=\\"M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z\\"/></svg>\n      AI Platform\n    </button>\n    <button class=\\"admin-stab\\" data-section=\\"data\\">\n      <svg viewBox=\\"0 0 24 24\\" width=\\"14\\" height=\\"14\\" fill=\\"none\\" stroke=\\"currentColor\\" stroke-width=\\"2\\"><ellipse cx=\\"12\\" cy=\\"5\\" rx=\\"9\\" ry=\\"3\\"/><path d=\\"M21 12c0 1.66-4 3-9 3s-9-1.34-9-3\\"/><path d=\\"M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5\\"/></svg>\n      Data Platform\n    </button>\n    <button class=\\"admin-stab\\" data-section=\\"infrastructure\\">\n      <svg viewBox=\\"0 0 24 24\\" width=\\"14\\" height=\\"14\\" fill=\\"none\\" stroke=\\"currentColor\\" stroke-width=\\"2\\"><rect x=\\"2\\" y=\\"3\\" width=\\"20\\" height=\\"14\\" rx=\\"2\\"/><line x1=\\"2\\" y1=\\"17\\" x2=\\"22\\" y2=\\"17\\"/><line x1=\\"6\\" y1=\\"21\\" x2=\\"6\\" y2=\\"17\\"/><line x1=\\"12\\" y1=\\"21\\" x2=\\"12\\" y2=\\"17\\"/><line x1=\\"18\\" y1=\\"21\\" x2=\\"18\\" y2=\\"17\\"/></svg>\n      Infrastructure\n    </button>\n    <button class=\\"admin-stab\\" data-section=\\"compliance\\">\n      <svg viewBox=\\"0 0 24 24\\" width=\\"14\\" height=\\"14\\" fill=\\"none\\" stroke=\\"currentColor\\" stroke-width=\\"2\\"><path d=\\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\\"/><path d=\\"M9 12l2 2 4-4\\"/></svg>\n      Compliance & Ethics\n    </button>\n  </div>\n  <div class=\\"admin-subtab-row\\">\n    <div class=\\"admin-subtabs\\" id=\\"subtabs-operations\\">\n      <button class=\\"admin-subtab\\" data-tab=\\"health\\">Service Health</button>\n      <button class=\\"admin-subtab\\" data-tab=\\"overview\\">Platform Overview</button>\n      <button class=\\"admin-subtab\\" data-tab=\\"audit\\">Audit Log</button>\n    </div>\n    <div class=\\"admin-subtabs\\" id=\\"subtabs-identity\\" style=\\"display:none\\">\n      <button class=\\"admin-subtab\\" data-tab=\\"users\\">Users &amp; Access</button>\n      <button class=\\"admin-subtab\\" data-tab=\\"personas\\">Personas</button>\n    </div>\n    <div class=\\"admin-subtabs\\" id=\\"subtabs-ai\\" style=\\"display:none\\">\n      <button class=\\"admin-subtab\\" data-tab=\\"llm\\">LLM &amp; Models</button>\n      <button class=\\"admin-subtab\\" data-tab=\\"config\\">Configuration</button>\n    </div>\n    <div class=\\"admin-subtabs\\" id=\\"subtabs-data\\" style=\\"display:none\\">\n      <button class=\\"admin-subtab\\" data-tab=\\"database\\">Database &amp; Data</button>\n    </div>\n    <div class=\\"admin-subtabs\\" id=\\"subtabs-infrastructure\\" style=\\"display:none\\">\n      <button class=\\"admin-subtab\\" data-tab=\\"docker-images\\">Docker Images</button>\n      <button class=\\"admin-subtab\\" data-tab=\\"environment-vars\\">Environment Variables</button>\n    </div>\n    <div class=\\"admin-subtabs\\" id=\\"subtabs-compliance\\" style=\\"display:none\\">\n      <button class=\\"admin-subtab\\" data-tab=\\"compliance-rules\\">Rules &amp; Policies</button>\n      <button class=\\"admin-subtab\\" data-tab=\\"compliance-audit\\">Audit Log</button>\n      <button class=\\"admin-subtab\\" data-tab=\\"secret-scan\\">Secret Scanning</button>\n    </div>\n    <div class=\\"admin-subtabs\\" id=\\"subtabs-config\\" style=\\"display:none\\">\n      <button class=\\"admin-subtab\\" data-tab=\\"config-appearance\\">Appearance</button>\n      <button class=\\"admin-subtab\\" data-tab=\\"config-access\\">Access Control</button>\n      <button class=\\"admin-subtab\\" data-tab=\\"config-system\\">System Config</button>\n      <button class=\\"admin-subtab\\" data-tab=\\"config-extensions\\">Guardrails &amp; Workflows</button>\n      <button class=\\"admin-subtab\\" data-tab=\\"config-links\\">External Links</button>\n    </div>\n  </div>\n</div>\n\n<!-- ═══════════════════════════════════════════════════════ -->\n<!-- TAB: USERS & ACCESS                                    -->\n<!-- ═══════════════════════════════════════════════════════ -->\n<div id=\\"tab-users\\" class=\\"admin-tab-content\\" style=\\"display:none\\">\n\n  <!-- User Stats Summary -->\n  <div id=\\"user-stats-bar\\" style=\\"display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-bottom:1.5rem\\">\n    <div class=\\"card\\" style=\\"text-align:center;padding:1rem;cursor:pointer;transition:all 0.18s\\" onclick=\\"filterUsers(\'all\')\\" title=\\"Show all users\\">\n      <div style=\\"font-size:1.8rem;font-weight:700;color:var(--text-1)\\" id=\\"user-count-total\\">—</div>\n      <div style=\\"font-size:0.7rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em\\">Total Users</div>\n    </div>\n    <div class=\\"card\\" style=\\"text-align:center;padding:1rem;cursor:pointer;transition:all 0.18s\\" onclick=\\"filterUsers(\'active\')\\" title=\\"Show active users\\">\n      <div style=\\"font-size:1.8rem;font-weight:700;color:var(--success)\\" id=\\"user-count-active\\">—</div>\n      <div style=\\"font-size:0.7rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em\\">Active</div>\n    </div>\n    <div class=\\"card\\" style=\\"text-align:center;padding:1rem;cursor:pointer;transition:all 0.18s\\" onclick=\\"filterUsers(\'verified\')\\" title=\\"Show verified users\\">\n      <div style=\\"font-size:1.8rem;font-weight:700;color:var(--accent-text)\\" id=\\"user-count-verified\\">—</div>\n      <div style=\\"font-size:0.7rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em\\">Verified</div>\n    </div>\n    <div class=\\"card\\" style=\\"text-align:center;padding:1rem;cursor:pointer;transition:all 0.18s\\" onclick=\\"filterUsers(\'admin\')\\" title=\\"Show admin users\\">\n      <div style=\\"font-size:1.8rem;font-weight:700;color:var(--danger)\\" id=\\"user-count-admins\\">—</div>\n      <div style=\\"font-size:0.7rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em\\">Admins</div>\n    </div>\n  </div>\n\n  <!-- User Management -->\n  <div class=\\"card animate-fade-up\\" style=\\"margin-bottom:1.5rem\\">\n    <div class=\\"section-header\\">\n      <h3>User Management</h3>\n      <div style=\\"display:flex;gap:0.5rem\\">\n        <button class=\\"btn btn-secondary btn-sm\\" onclick=\\"loadUsers()\\">\n          <svg viewBox=\\"0 0 24 24\\" width=\\"12\\" height=\\"12\\" fill=\\"none\\" stroke=\\"currentColor\\" stroke-width=\\"2\\"><polyline points=\\"23 4 23 10 17 10\\"/><path d=\\"M20.49 15A9 9 0 1 1 21 12\\"/></svg>\n          Refresh\n        </button>\n        <button class=\\"btn btn-primary btn-sm\\" onclick=\\"showCreateUserModal()\\">\n          <svg viewBox=\\"0 0 24 24\\" width=\\"12\\" height=\\"12\\" fill=\\"none\\" stroke=\\"currentColor\\" stroke-width=\\"2\\"><line x1=\\"12\\" y1=\\"5\\" x2=\\"12\\" y2=\\"19\\"/><line x1=\\"5\\" y1=\\"12\\" x2=\\"19\\" y2=\\"12\\"/></svg>\n          Add User\n        </button>\n      </div>\n    </div>\n    <div id=\\"users-table-container\\" style=\\"margin-top:0.75rem\\">\n      <div style=\\"color:var(--text-3);font-size:0.82rem\\">Loading users...</div>\n    </div>\n  </div>\n\n  <!-- Workspace Management -->\n  <div class=\\"card animate-fade-up\\">\n    <div class=\\"section-header\\">\n      <h3>Workspace Management</h3>\n      <button class=\\"btn btn-primary btn-sm\\" onclick=\\"showCreateWorkspaceModal()\\">\n        <svg viewBox=\\"0 0 24 24\\" width=\\"12\\" height=\\"12\\" fill=\\"none\\" stroke=\\"currentColor\\" stroke-width=\\"2\\"><line x1=\\"12\\" y1=\\"5\\" x2=\\"12\\" y2=\\"19\\"/><line x1=\\"5\\" y1=\\"12\\" x2=\\"19\\" y2=\\"12\\"/></svg>\n        New Workspace\n      </button>\n    </div>\n    <div id=\\"workspaces-admin-table\\" style=\\"margin-top:0.75rem\\">\n      <div style=\\"color:var(--text-3);font-size:0.82rem\\">Loading workspaces...</div>\n    </div>\n  </div>\n</div>\n\n<!-- ═══════════════════════════════════════════════════════ -->\n<!-- TAB: PERSONAS                                          -->\n<!-- ═══════════════════════════════════════════════════════ -->\n<div id=\\"tab-personas\\" class=\\"admin-tab-content\\" style=\\"display:none\\">\n\n  <!-- Persona Cards -->\n  <div class=\\"card animate-fade-up\\" style=\\"margin-bottom:1.5rem\\">\n    <div class=\\"section-header\\">\n      <h3>Persona Definitions</h3>\n      <div style=\\"display:flex;gap:0.5rem\\">\n        <button class=\\"btn btn-secondary btn-sm\\" onclick=\\"loadPersonas()\\">\n          <svg viewBox=\\"0 0 24 24\\" width=\\"12\\" height=\\"12\\" fill=\\"none\\" stroke=\\"currentColor\\" stroke-width=\\"2\\"><polyline points=\\"23 4 23 10 17 10\\"/><path d=\\"M20.49 15A9 9 0 1 1 21 12\\"/></svg>\n          Refresh\n        </button>\n        <button class=\\"btn btn-primary btn-sm\\" onclick=\\"showCreatePersonaModal()\\">\n          <svg viewBox=\\"0 0 24 24\\" width=\\"12\\" height=\\"12\\" fill=\\"none\\" stroke=\\"currentColor\\" stroke-width=\\"2\\"><line x1=\\"12\\" y1=\\"5\\" x2=\\"12\\" y2=\\"19\\"/><line x1=\\"5\\" y1=\\"12\\" x2=\\"19\\" y2=\\"12\\"/></svg>\n          Create Persona\n        </button>\n      </div>\n    </div>\n    <p style=\\"font-size:0.75rem;color:var(--text-3);margin:0.25rem 0 1rem\\">Define access profiles that control which navigation items and platform capabilities are available. Assign personas to users to enable role-switching.</p>\n    <div id=\\"personas-grid\\" style=\\"display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1rem\\">\n      <div style=\\"color:var(--text-3);font-size:0.82rem\\">Loading personas...</div>\n    </div>\n  </div>\n\n  <!-- User Persona Assignments -->\n  <div class=\\"card animate-fade-up\\">\n    <div class=\\"section-header\\">\n      <h3>User Persona Assignments</h3>\n    </div>\n    <p style=\\"font-size:0.75rem;color:var(--text-3);margin:0.25rem 0 1rem\\">Assign one or more personas to each user. Users can switch between their assigned personas at any time.</p>\n    <div id=\\"user-persona-assignments\\">\n      <div style=\\"color:var(--text-3);font-size:0.82rem\\">Loading...</div>\n    </div>\n  </div>\n</div>\n\n<!-- ═══════════════════════════════════════════════════════ -->\n<!-- TAB 1: SERVICE HEALTH                                  -->\n<!-- ═══════════════════════════════════════════════════════ -->\n<div id=\\"tab-health\\" class=\\"admin-tab-content\\">\n\n  <!-- Health Summary Bar -->\n  <div id=\\"health-summary\\" style=\\"display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-bottom:1.5rem\\">\n    <div class=\\"card\\" style=\\"text-align:center;padding:1rem\\">\n      <div style=\\"font-size:2rem;font-weight:700;color:var(--success)\\" id=\\"health-count-healthy\\">—</div>\n      <div style=\\"font-size:0.72rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em\\">Healthy</div>\n    </div>\n    <div class=\\"card\\" style=\\"text-align:center;padding:1rem\\">\n      <div style=\\"font-size:2rem;font-weight:700;color:var(--danger)\\" id=\\"health-count-unhealthy\\">—</div>\n      <div style=\\"font-size:0.72rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em\\">Unhealthy</div>\n    </div>\n    <div class=\\"card\\" style=\\"text-align:center;padding:1rem\\">\n      <div style=\\"font-size:2rem;font-weight:700;color:var(--text-1)\\" id=\\"health-count-total\\">—</div>\n      <div style=\\"font-size:0.72rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em\\">Total Services</div>\n    </div>\n    <div class=\\"card\\" style=\\"text-align:center;padding:1rem\\">\n      <div style=\\"font-size:1rem;font-weight:600;color:var(--accent-text)\\" id=\\"health-timestamp\\">—</div>\n      <div style=\\"font-size:0.72rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em\\">Last Check</div>\n    </div>\n  </div>\n\n  <!-- Service Health Grid -->\n  <div class=\\"card animate-fade-up\\" style=\\"margin-bottom:1.5rem\\">\n    <div class=\\"section-header\\">\n      <h3>All Services</h3>\n      <div>\n        <button class=\\"btn btn-secondary btn-sm\\" onclick=\\"loadServiceHealth()\\">\n          <svg viewBox=\\"0 0 24 24\\" width=\\"12\\" height=\\"12\\" fill=\\"none\\" stroke=\\"currentColor\\" stroke-width=\\"2\\"><polyline points=\\"23 4 23 10 17 10\\"/><path d=\\"M20.49 15A9 9 0 1 1 21 12\\"/></svg>\n          Check Now\n        </button>\n      </div>\n    </div>\n    <div id=\\"service-health-grid\\" style=\\"display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:0.75rem;margin-top:0.75rem\\">\n      <div style=\\"color:var(--text-3);font-size:0.82rem;grid-column:1/-1\\">Loading service health...</div>\n    </div>\n  </div>\n\n  <!-- Environment Info -->\n  <div class=\\"card animate-fade-up delay-100\\" style=\\"margin-bottom:1.5rem\\">\n    <h3>Environment &amp; Endpoints</h3>\n    <table class=\\"mt-1\\">\n      <tr><th>Service</th><th>Internal URL</th><th>External URL</th></tr>\n      <tr><td>Agent Service</td><td class=\\"mono\\" style=\\"font-size:0.75rem\\">http://agent-service:8000</td><td class=\\"mono\\" style=\\"color:var(--accent-text);font-size:0.75rem\\">http://localhost:8010</td></tr>\n      <tr><td>Tools Service</td><td class=\\"mono\\" style=\\"font-size:0.75rem\\">http://tools-service:8001</td><td class=\\"mono\\" style=\\"color:var(--accent-text);font-size:0.75rem\\">http://localhost:8011</td></tr>\n      <tr><td>n8n</td><td class=\\"mono\\" style=\\"font-size:0.75rem\\">http://n8n:5678</td><td class=\\"mono\\" style=\\"color:var(--accent-text);font-size:0.75rem\\">http://localhost:5679</td></tr>\n      <tr><td>Langfuse</td><td class=\\"mono\\" style=\\"font-size:0.75rem\\">http://langfuse:3000</td><td class=\\"mono\\" style=\\"color:var(--accent-text);font-size:0.75rem\\">http://localhost:3002</td></tr>\n      <tr><td>Grafana</td><td class=\\"mono\\" style=\\"font-size:0.75rem\\">http://grafana:3000</td><td class=\\"mono\\" style=\\"color:var(--accent-text);font-size:0.75rem\\">http://localhost:3001</td></tr>\n      <tr><td>ChromaDB</td><td class=\\"mono\\" style=\\"font-size:0.75rem\\">http://chromadb:8000</td><td class=\\"mono\\" style=\\"color:var(--accent-text);font-size:0.75rem\\">http://localhost:8200</td></tr>\n      <tr><td>Ollama</td><td class=\\"mono\\" style=\\"font-size:0.75rem\\">http://ollama:11434</td><td class=\\"mono\\" style=\\"color:var(--accent-text);font-size:0.75rem\\">http://localhost:11436</td></tr>\n      <tr><td>Prometheus</td><td class=\\"mono\\" style=\\"font-size:0.75rem\\">http://prometheus:9090</td><td class=\\"mono\\" style=\\"color:var(--accent-text);font-size:0.75rem\\">http://localhost:9090</td></tr>\n      <tr><td>Loki</td><td class=\\"mono\\" style=\\"font-size:0.75rem\\">http://loki:3100</td><td class=\\"mono\\" style=\\"color:var(--accent-text);font-size:0.75rem\\">http://localhost:3100</td></tr>\n      <tr><td>OTel Collector</td><td class=\\"mono\\" style=\\"font-size:0.75rem\\">http://otel-collector:4318</td><td class=\\"mono\\" style=\\"color:var(--accent-text);font-size:0.75rem\\">http://localhost:4318</td></tr>\n    </table>\n  </div>\n\n  <!-- Service Versions -->\n  <div class=\\"card animate-fade-up delay-200\\">\n    <h3>Service Versions</h3>\n    <table class=\\"mt-1\\">\n      <tr><th>Service</th><th>Version</th><th>Stack</th></tr>\n      <tr><td>Agent Service</td><td class=\\"mono\\" style=\\"font-size:0.78rem\\">2.0.0</td><td style=\\"font-size:0.75rem;color:var(--text-3)\\">FastAPI + LangGraph + LangChain + LlamaIndex</td></tr>\n      <tr><td>Tools Service</td><td class=\\"mono\\" style=\\"font-size:0.78rem\\">2.0.0</td><td style=\\"font-size:0.75rem;color:var(--text-3)\\">FastAPI + DuckDuckGo + Code Sandbox</td></tr>\n      <tr><td>UI Console</td><td class=\\"mono\\" style=\\"font-size:0.78rem\\">2.0.0</td><td style=\\"font-size:0.75rem;color:var(--text-3)\\">Express.js + EJS + SSE</td></tr>\n      <tr><td>ChromaDB</td><td class=\\"mono\\" style=\\"font-size:0.78rem\\">0.6.3</td><td style=\\"font-size:0.75rem;color:var(--text-3)\\">Vector Store</td></tr>\n      <tr><td>PostgreSQL</td><td class=\\"mono\\" style=\\"font-size:0.78rem\\">16</td><td style=\\"font-size:0.75rem;color:var(--text-3)\\">Document Registry (datastore-db)</td></tr>\n      <tr><td>Ollama</td><td class=\\"mono\\" style=\\"font-size:0.78rem\\">latest</td><td style=\\"font-size:0.75rem;color:var(--text-3)\\">Local LLM Runtime</td></tr>\n      <tr><td>n8n</td><td class=\\"mono\\" style=\\"font-size:0.78rem\\">latest</td><td style=\\"font-size:0.75rem;color:var(--text-3)\\">Workflow Orchestration</td></tr>\n      <tr><td>Langfuse</td><td class=\\"mono\\" style=\\"font-size:0.78rem\\">2.x</td><td style=\\"font-size:0.75rem;color:var(--text-3)\\">LLM Tracing &amp; Observability</td></tr>\n      <tr><td>Grafana</td><td class=\\"mono\\" style=\\"font-size:0.78rem\\">11.0.0</td><td style=\\"font-size:0.75rem;color:var(--text-3)\\">Metrics Dashboards</td></tr>\n      <tr><td>Prometheus</td><td class=\\"mono\\" style=\\"font-size:0.78rem\\">latest</td><td style=\\"font-size:0.75rem;color:var(--text-3)\\">Metrics Aggregation</td></tr>\n      <tr><td>Loki</td><td class=\\"mono\\" style=\\"font-size:0.78rem\\">3.0.0</td><td style=\\"font-size:0.75rem;color:var(--text-3)\\">Log Aggregation</td></tr>\n      <tr><td>OTel Collector</td><td class=\\"mono\\" style=\\"font-size:0.78rem\\">0.100.0</td><td style=\\"font-size:0.75rem;color:var(--text-3)\\">Telemetry Pipeline</td></tr>\n    </table>\n  </div>\n</div>\n\n<!-- ═══════════════════════════════════════════════════════ -->\n<!-- TAB 2: PLATFORM OVERVIEW                               -->\n<!-- ═══════════════════════════════════════════════════════ -->\n<div id=\\"tab-overview\\" class=\\"admin-