    grid.innerHTML = d.services.map(function(s) {
      var statusColor = s.status === 'healthy' ? 'var(--success)' : s.status === 'unhealthy' ? 'var(--danger)' : 'var(--text-3)';
      var typeBadge = s.type === 'core' ? '<span class="badge badge-info" style="font-size:0.62rem">core</span>' :
                      s.type === 'integration' ? '<span class="badge badge-warning" style="font-size:0.62rem">integration</span>' :
