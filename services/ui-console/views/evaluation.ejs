<script>
let allAgents = [];
let allTraces = [];
let selectedAgentId = '__all__';

function gradeFor(pct) {
  if (pct >= 95) return '<span style="color:#10b981;font-weight:700">A</span>';
  if (pct >= 85) return '<span style="color:#06b6d4;font-weight:700">B</span>';
  if (pct >= 70) return '<span style="color:#f59e0b;font-weight:700">C</span>';
  if (pct >= 50) return '<span style="color:#f97316;font-weight:700">D</span>';
  return '<span style="color:#f43f5e;font-weight:700">F</span>';
}

function gradeColor(pct) {
  if (pct >= 95) return '#10b981';
  if (pct >= 85) return '#06b6d4';
  if (pct >= 70) return '#f59e0b';
  if (pct >= 50) return '#f97316';
  return '#f43f5e';
}

function computeScores(traces) {
  if (traces.length === 0) return { completion: 0, latency: 0, tool: 0, error: 0, overall: 0 };
  const success = traces.filter(t => t.status !== 'ERROR').length;
  const completionPct = Math.round(success / traces.length * 100);
  const durations = traces.filter(t => t.latency != null).map(t => t.latency);
  const under5s = durations.filter(d => d < 5000).length;
  const latencyPct = durations.length > 0 ? Math.round(under5s / durations.length * 100) : 0;
  const toolPct = success > 0 ? Math.round(success / traces.length * 100) : 0;
  const errorPct = Math.round((1 - (traces.length - success) / traces.length) * 100);
  const overall = Math.round(completionPct * 0.3 + latencyPct * 0.25 + toolPct * 0.2 + errorPct * 0.25);
  return { completion: completionPct, latency: latencyPct, tool: toolPct, error: errorPct, overall };
}

async function init() {
  try {
    const [agentRes, traceRes] = await Promise.all([
      fetch('/api/agents').then(r => r.json()),
      fetch('/api/traces').then(r => r.json())
    ]);
    allAgents = agentRes.agents || agentRes || [];
    allTraces = traceRes.traces || [];

    // Populate agent selector
    const sel = document.getElementById('agent-select');
    allAgents.forEach(a => {
      const opt = document.createElement('option');
      opt.value = a.id;
      opt.textContent = a.name + (a.is_default ? ' (default)' : '');
      sel.appendChild(opt);
    });

    loadEvaluation();
  } catch (e) {
    console.error('Init failed:', e);
  }
}

function onAgentChange() {
  selectedAgentId = document.getElementById('agent-select').value;
  loadEvaluation();
}

function getFilteredTraces() {
  if (selectedAgentId === '__all__') return allTraces;
  const agent = allAgents.find(a => a.id === selectedAgentId);
  if (!agent) return allTraces;
  // Filter traces by agent name (Langfuse traces use agent name in trace name/metadata)
  return allTraces.filter(t => {
    const name = (t.name || '').toLowerCase();
    const meta = JSON.stringify(t.metadata || {}).toLowerCase();
    const agentName = agent.name.toLowerCase();
    return name.includes(agentName) || meta.includes(agentName) || meta.includes(agent.id);
  });
}

async function loadEvaluation() {
  // Re-fetch fresh data
  try {
    const [traceRes, memRes] = await Promise.all([
      fetch('/api/traces').then(r => r.json()),
      fetch('/api/memory/stats').then(r => r.json())
    ]);
    allTraces = traceRes.traces || [];
    const traces = getFilteredTraces();
    const scores = computeScores(traces);

    // Update agent info banner
    const banner = document.getElementById('agent-info-banner');
    if (selectedAgentId !== '__all__') {
      const agent = allAgents.find(a => a.id === selectedAgentId);
      if (agent) {
        banner.style.display = 'block';
        document.getElementById('agent-info-name').textContent = agent.name;
        document.getElementById('agent-info-model').textContent = 'Model: ' + agent.provider + '/' + agent.model;
        document.getElementById('agent-info-provider').textContent = 'Temp: ' + agent.temperature;
        document.getElementById('agent-info-tools').textContent = 'Tools: ' + (agent.tool_ids || []).length + ' | Skills: ' + (agent.skill_ids || []).length;
        document.getElementById('agent-trace-count').querySelector('div').textContent = traces.length;
      }
    } else {
      banner.style.display = 'none';
    }

    // Completion rate
    document.getElementById('eval-completion').textContent = scores.completion + '%';
    document.getElementById('eval-completion-bar').style.width = scores.completion + '%';
    document.getElementById('eval-row-completion').textContent = scores.completion + '%';
    document.getElementById('eval-grade-completion').innerHTML = gradeFor(scores.completion);

    // Latency score
    const durations = traces.filter(t => t.latency != null).map(t => t.latency);
    document.getElementById('eval-latency').textContent = scores.latency + '%';
    document.getElementById('eval-latency-bar').style.width = scores.latency + '%';
    const avgLat = durations.length > 0 ? (durations.reduce((a,b)=>a+b,0)/durations.length/1000).toFixed(1) + 's avg' : '-';
    document.getElementById('eval-row-latency').textContent = avgLat;
    document.getElementById('eval-grade-latency').innerHTML = gradeFor(scores.latency);

    // Tool efficiency
    document.getElementById('eval-tool-eff').textContent = scores.tool + '%';
    document.getElementById('eval-tool-bar').style.width = scores.tool + '%';
    document.getElementById('eval-row-tools').textContent = scores.tool + '%';
    document.getElementById('eval-grade-tools').innerHTML = gradeFor(scores.tool);

    // Error rate
    document.getElementById('eval-row-errors').textContent = scores.error + '%';
    document.getElementById('eval-grade-errors').innerHTML = gradeFor(scores.error);

    // Memory utilization
    const mem = memRes.memory || {};
    const sessionsWithMulti = mem.sessions_with_summary || 0;
    const totalSess = mem.total_sessions || 1;
    const memPct = Math.min(100, Math.round(sessionsWithMulti / totalSess * 100));
    document.getElementById('eval-row-memory').textContent = memPct + '%';
    document.getElementById('eval-grade-memory').innerHTML = gradeFor(memPct);

    // Overall
    const overall = Math.round(scores.completion * 0.3 + scores.latency * 0.2 + scores.tool * 0.2 + scores.error * 0.2 + memPct * 0.1);
    document.getElementById('eval-row-overall').textContent = overall + '%';
    document.getElementById('eval-grade-overall').innerHTML = gradeFor(overall);

    // Load RAI controls for this agent
    loadRAIForAgent();

    // Load agent comparison table if global view
    if (selectedAgentId === '__all__') {
      document.getElementById('agent-comparison-card').style.display = 'block';
      loadAgentComparison();
    } else {
      document.getElementById('agent-comparison-card').style.display = 'none';
    }

  } catch(e) {
    console.error('loadEvaluation failed:', e);
  }
}

function loadRAIForAgent() {
  const agent = selectedAgentId !== '__all__' ? allAgents.find(a => a.id === selectedAgentId) : null;
  const traces = getFilteredTraces();
  const errorCount = traces.filter(t => t.status === 'ERROR').length;
  const errorRate = traces.length > 0 ? (errorCount / traces.length * 100).toFixed(1) : '0.0';

  // Per-agent config items
  if (agent) {
    document.getElementById('rai-subtitle').textContent = 'Governance controls for agent: ' + agent.name;
    document.getElementById('rai-sys-prompt').textContent = agent.system_prompt ? 'Configured' : 'None';
    document.getElementById('rai-sys-prompt').style.color = agent.system_prompt ? '#10b981' : '#f59e0b';
    document.getElementById('rai-sys-prompt').style.background = agent.system_prompt ? 'rgba(16,185,129,0.12)' : 'rgba(245,158,11,0.12)';
    document.getElementById('rai-memory').textContent = agent.memory_enabled ? 'Enabled' : 'Disabled';
    document.getElementById('rai-memory').style.color = agent.memory_enabled ? '#06b6d4' : '#f59e0b';
    document.getElementById('rai-kb').textContent = agent.kb_collection || 'None';
    document.getElementById('rai-tools').textContent = (agent.tool_ids || []).length + ' tools';
    document.getElementById('rai-skills').textContent = (agent.skill_ids || []).length + ' skills';
    document.getElementById('rai-max-iter').textContent = agent.max_iterations + ' loops';
    document.getElementById('rai-temperature').textContent = agent.temperature;
    document.getElementById('rai-temperature').style.color = agent.temperature > 1.0 ? '#f43f5e' : '#f59e0b';
    document.getElementById('rai-temperature').style.background = agent.temperature > 1.0 ? 'rgba(244,63,94,0.12)' : 'rgba(245,158,11,0.12)';
  } else {
    document.getElementById('rai-subtitle').textContent = 'Global governance guardrails, fairness checks & safety monitoring';
    document.getElementById('rai-sys-prompt').textContent = 'Per-agent';
    document.getElementById('rai-sys-prompt').style.color = '#10b981';
    document.getElementById('rai-sys-prompt').style.background = 'rgba(16,185,129,0.12)';
    document.getElementById('rai-memory').textContent = 'Per-agent';
    document.getElementById('rai-memory').style.color = '#06b6d4';
    document.getElementById('rai-kb').textContent = 'Per-agent';
    document.getElementById('rai-tools').textContent = 'Per-agent';
    document.getElementById('rai-skills').textContent = 'Per-agent';
    document.getElementById('rai-max-iter').textContent = 'Per-agent';
    document.getElementById('rai-temperature').textContent = 'Per-agent';
    document.getElementById('rai-temperature').style.color = '#f59e0b';
    document.getElementById('rai-temperature').style.background = 'rgba(245,158,11,0.12)';
  }

  document.getElementById('rai-error-threshold').textContent = errorRate + '%';
  document.getElementById('rai-error-threshold').style.color = parseFloat(errorRate) > 10 ? '#f43f5e' : '#f59e0b';
  document.getElementById('rai-error-threshold').style.background = parseFloat(errorRate) > 10 ? 'rgba(244,63,94,0.12)' : 'rgba(245,158,11,0.12)';

  // Overall RAI status
  const issues = [];
  if (parseFloat(errorRate) > 20) issues.push('high error rate (' + errorRate + '%)');
  if (traces.length === 0) issues.push('no traces recorded');
  if (agent && !agent.system_prompt) issues.push('no system prompt configured');
  if (agent && agent.temperature > 1.0) issues.push('high temperature (' + agent.temperature + ')');

  const raiEl = document.getElementById('rai-status');
  const raiDetail = document.getElementById('rai-detail');
  if (issues.length === 0) {
    raiEl.textContent = 'Responsible AI: All Controls Active';
    raiEl.style.color = '#10b981';
    raiDetail.textContent = traces.length + ' traces monitored — ' + errorRate + '% error rate — guardrails operational';
  } else {
    raiEl.textContent = 'Responsible AI: ' + issues.length + ' concern(s)';
    raiEl.style.color = '#f59e0b';
    raiDetail.textContent = issues.join(', ');
  }
}

function loadAgentComparison() {
  if (allAgents.length === 0) {
    document.getElementById('agent-comparison-table').innerHTML = '<p style="color:var(--text-3)">No agents registered yet.</p>';
    return;
  }

  let html = '<table><tr><th>Agent</th><th>Model</th><th>Traces</th><th>Completion</th><th>Latency</th><th>Error Rate</th><th>Overall</th><th>RAI Status</th></tr>';
  allAgents.forEach(agent => {
    const agentTraces = allTraces.filter(t => {
      const name = (t.name || '').toLowerCase();
      const meta = JSON.stringify(t.metadata || {}).toLowerCase();
      const agentName = agent.name.toLowerCase();
      return name.includes(agentName) || meta.includes(agentName) || meta.includes(agent.id);
    });
    const scores = computeScores(agentTraces);
    const raiIssues = [];
    if (!agent.system_prompt) raiIssues.push('no prompt');
    if (agent.temperature > 1.0) raiIssues.push('high temp');
    if (scores.error < 80 && agentTraces.length > 0) raiIssues.push('errors');

    const raiBadge = raiIssues.length === 0
      ? '<span class="badge" style="font-size:0.68rem;background:rgba(16,185,129,0.12);color:#10b981">OK</span>'
      : '<span class="badge" style="font-size:0.68rem;background:rgba(245,158,11,0.12);color:#f59e0b">' + raiIssues.length + ' issue(s)</span>';

    html += '<tr>' +
      '<td style="font-weight:600">' + agent.name + (agent.is_default ? ' <span style="font-size:0.65rem;color:var(--text-3)">(default)</span>' : '') + '</td>' +
      '<td class="mono" style="font-size:0.78rem">' + agent.provider + '/' + agent.model + '</td>' +
      '<td class="mono">' + agentTraces.length + '</td>' +
      '<td><span style="color:' + gradeColor(scores.completion) + ';font-weight:600">' + scores.completion + '%</span></td>' +
      '<td><span style="color:' + gradeColor(scores.latency) + ';font-weight:600">' + scores.latency + '%</span></td>' +
      '<td><span style="color:' + gradeColor(scores.error) + ';font-weight:600">' + scores.error + '%</span></td>' +
      '<td><span style="font-weight:700">' + scores.overall + '% ' + gradeFor(scores.overall).replace('font-weight:700', 'font-weight:700;font-size:0.88rem') + '</span></td>' +
      '<td>' + raiBadge + '</td>' +
      '</tr>';
  });
  html += '</table>';
  document.getElementById('agent-comparison-table').innerHTML = html;
}

init();
</script>
