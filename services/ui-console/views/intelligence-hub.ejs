<%- include('layout', { title: 'Intelligence Hub', page: 'intelligence-hub', body: `

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem">
  <div>
    <h1 class="text-glow-cyan" style="margin:0">Intelligence Hub</h1>
    <p style="color:var(--text-3);font-size:0.82rem;margin:0.25rem 0 0">Traceability, evaluation scoring &amp; infrastructure observability</p>
  </div>
  <button class="btn btn-sm" onclick="ihRefresh()">
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
    Refresh
  </button>
</div>

<!-- Stats Cards -->
<div class="grid-4 mb-2" style="margin-bottom:1.25rem">
  <a href="/traceability" style="text-decoration:none">
    <div class="stat-card animate-fade-up" style="cursor:pointer">
      <div class="stat-icon stat-icon-cyan">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      </div>
      <div class="stat-label">Total Traces</div>
      <div class="stat-number" id="ih-traces">-</div>
    </div>
  </a>
  <a href="/evaluation" style="text-decoration:none">
    <div class="stat-card animate-fade-up delay-100" style="cursor:pointer">
      <div class="stat-icon stat-icon-violet">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
      </div>
      <div class="stat-label">Eval Score</div>
      <div class="stat-number" id="ih-eval-score">-</div>
    </div>
  </a>
  <a href="/observability" style="text-decoration:none">
    <div class="stat-card animate-fade-up delay-200" style="cursor:pointer">
      <div class="stat-icon stat-icon-emerald">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      </div>
      <div class="stat-label">Stack Health</div>
      <div class="stat-number" id="ih-health">-</div>
    </div>
  </a>
  <a href="/traceability" style="text-decoration:none">
    <div class="stat-card animate-fade-up delay-300" style="cursor:pointer">
      <div class="stat-icon" style="background:linear-gradient(135deg,rgba(245,158,11,0.15),rgba(245,158,11,0.08));color:#f59e0b">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div class="stat-label">Avg Latency</div>
      <div class="stat-number" id="ih-latency">-</div>
    </div>
  </a>
  <a href="/llm-activity" style="text-decoration:none">
    <div class="stat-card animate-fade-up delay-100" style="cursor:pointer">
      <div class="stat-icon" style="background:linear-gradient(135deg,rgba(6,182,212,0.15),rgba(6,182,212,0.08));color:#06b6d4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
      </div>
      <div class="stat-label">LLM Calls</div>
      <div class="stat-number" id="ih-llm-calls">-</div>
    </div>
  </a>
  <a href="/llm-activity" style="text-decoration:none">
    <div class="stat-card animate-fade-up delay-200" style="cursor:pointer">
      <div class="stat-icon" style="background:linear-gradient(135deg,rgba(16,185,129,0.15),rgba(16,185,129,0.08));color:#10b981">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
      </div>
      <div class="stat-label">Est. Cost</div>
      <div class="stat-number" id="ih-total-cost">-</div>
    </div>
  </a>
  <a href="/llm-activity" style="text-decoration:none">
    <div class="stat-card animate-fade-up delay-300" style="cursor:pointer">
      <div class="stat-icon" style="background:linear-gradient(135deg,rgba(139,92,246,0.15),rgba(139,92,246,0.08));color:#8b5cf6">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
      </div>
      <div class="stat-label">Total Tokens</div>
      <div class="stat-number" id="ih-total-tokens">-</div>
    </div>
  </a>
  <a href="/guardrails" style="text-decoration:none">
    <div class="stat-card animate-fade-up delay-300" style="cursor:pointer">
      <div class="stat-icon" style="background:linear-gradient(135deg,rgba(244,63,94,0.15),rgba(244,63,94,0.08));color:#f43f5e">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <div class="stat-label">Guardrails</div>
      <div class="stat-number" id="ih-guardrail-count">-</div>
    </div>
  </a>
</div>

<!-- Quick Access Cards -->
<div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:1rem;margin-bottom:1.25rem">

  <!-- Traceability Card -->
  <div class="card animate-fade-up">
    <div class="section-header mb-1">
      <div style="display:flex;align-items:center;gap:0.75rem">
        <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,rgba(6,182,212,0.15),rgba(6,182,212,0.08));display:flex;align-items:center;justify-content:center">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#06b6d4" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        </div>
        <h3 style="margin:0;font-size:0.95rem">Traceability</h3>
      </div>
      <a href="/traceability" class="btn btn-primary btn-sm">View</a>
    </div>
    <div id="ih-traces-list" style="font-size:0.82rem;color:var(--text-3)">Loading...</div>
  </div>

  <!-- Evaluation Card -->
  <div class="card animate-fade-up delay-100">
    <div class="section-header mb-1">
      <div style="display:flex;align-items:center;gap:0.75rem">
        <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,rgba(139,92,246,0.15),rgba(139,92,246,0.08));display:flex;align-items:center;justify-content:center">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#8b5cf6" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        </div>
        <h3 style="margin:0;font-size:0.95rem">Evaluation</h3>
      </div>
      <a href="/evaluation" class="btn btn-primary btn-sm">View</a>
    </div>
    <div id="ih-eval-summary" style="font-size:0.82rem;color:var(--text-3)">Loading...</div>
  </div>

  <!-- Guardrails Card -->
  <div class="card animate-fade-up delay-200">
    <div class="section-header mb-1">
      <div style="display:flex;align-items:center;gap:0.75rem">
        <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,rgba(245,158,11,0.15),rgba(245,158,11,0.08));display:flex;align-items:center;justify-content:center">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h3 style="margin:0;font-size:0.95rem">Guardrails</h3>
      </div>
      <a href="/guardrails" class="btn btn-primary btn-sm">View</a>
    </div>
    <div id="ih-guardrails-summary" style="font-size:0.82rem;color:var(--text-3)">Loading...</div>
  </div>

  <!-- Observability Card -->
  <div class="card animate-fade-up delay-300">
    <div class="section-header mb-1">
      <div style="display:flex;align-items:center;gap:0.75rem">
        <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,rgba(16,185,129,0.15),rgba(16,185,129,0.08));display:flex;align-items:center;justify-content:center">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#10b981" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        </div>
        <h3 style="margin:0;font-size:0.95rem">Observability</h3>
      </div>
      <a href="/observability" class="btn btn-primary btn-sm">View</a>
    </div>
    <div id="ih-obs-summary" style="font-size:0.82rem;color:var(--text-3)">Loading...</div>
  </div>

</div>

<!-- Agent Performance Overview -->
<div class="card animate-fade-up delay-300">
  <div class="section-header mb-1">
    <h3 style="font-size:0.95rem">Agent Performance Overview</h3>
  </div>
  <div id="ih-agent-table" style="font-size:0.82rem;color:var(--text-3)">Loading...</div>
</div>

<!-- Guardrail Activity -->
<div class="card animate-fade-up delay-300" style="margin-top:1.25rem">
  <div class="section-header mb-1" style="cursor:pointer" onclick="toggleGrActivity()">
    <div style="display:flex;align-items:center;gap:0.75rem">
      <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,rgba(245,158,11,0.15),rgba(245,158,11,0.08));display:flex;align-items:center;justify-content:center">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <div>
        <h3 style="margin:0;font-size:0.95rem">Guardrail Activity</h3>
        <p style="margin:0.15rem 0 0;color:var(--text-3);font-size:0.78rem">Real-time safety control checks from agent runs</p>
      </div>
    </div>
    <div style="display:flex;gap:0.5rem;align-items:center">
      <span id="gr-activity-badges" style="display:flex;gap:0.35rem"></span>
      <svg id="gr-activity-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" style="transition:transform 0.2s"><polyline points="6 9 12 15 18 9"/></svg>
    </div>
  </div>
  <div id="gr-activity-body" style="display:none;margin-top:0.75rem">
    <div id="gr-activity-content" style="font-size:0.82rem;color:var(--text-3)">Click to load guardrail activity...</div>
  </div>
</div>

<!-- AI Safety Posture -->
<div class="card animate-fade-up delay-300" style="margin-top:1.25rem">
  <div class="section-header mb-1">
    <div style="display:flex;align-items:center;gap:0.75rem">
      <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,rgba(6,182,212,0.15),rgba(139,92,246,0.08));display:flex;align-items:center;justify-content:center">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#06b6d4" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
      </div>
      <div>
        <h3 style="margin:0;font-size:0.95rem">AI Safety Posture</h3>
        <p style="margin:0.15rem 0 0;color:var(--text-3);font-size:0.78rem">Must-have controls coverage for production readiness</p>
      </div>
    </div>
    <a href="/guardrails" class="btn btn-primary btn-sm">Harden</a>
  </div>
  <div id="ih-safety-posture" style="font-size:0.82rem;color:var(--text-3)">Loading...</div>
</div>

<!-- Platform Health Monitoring -->
<div class="card animate-fade-up delay-300" style="margin-top:1.25rem">
  <div class="section-header mb-1">
    <div style="display:flex;align-items:center;gap:0.75rem">
      <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,rgba(244,63,94,0.15),rgba(244,63,94,0.08));display:flex;align-items:center;justify-content:center">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#f43f5e" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
      </div>
      <div>
        <h3 style="margin:0;font-size:0.95rem">Platform Health Monitoring</h3>
        <p style="margin:0.15rem 0 0;color:var(--text-3);font-size:0.78rem">Live resource usage from Prometheus (last 30 min)</p>
      </div>
    </div>
    <button class="btn btn-sm" onclick="phRefresh()">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
      Refresh
    </button>
  </div>

  <!-- Resource Gauges -->
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.75rem;margin-bottom:1rem">
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:1rem">
      <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.6rem">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#06b6d4" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>
        <strong style="font-size:0.82rem;color:var(--text-1)">CPU Usage</strong>
      </div>
      <div id="ph-cpu-gauges" style="display:flex;flex-direction:column;gap:0.5rem">
        <div style="color:var(--text-3);font-size:0.75rem">Loading...</div>
      </div>
    </div>
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:1rem">
      <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.6rem">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#8b5cf6" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"/><line x1="6" y1="10" x2="6" y2="14"/><line x1="10" y1="10" x2="10" y2="14"/><line x1="14" y1="10" x2="14" y2="14"/><line x1="18" y1="10" x2="18" y2="14"/></svg>
        <strong style="font-size:0.82rem;color:var(--text-1)">Memory (RSS)</strong>
      </div>
      <div id="ph-mem-gauges" style="display:flex;flex-direction:column;gap:0.5rem">
        <div style="color:var(--text-3);font-size:0.75rem">Loading...</div>
      </div>
    </div>
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:1rem">
      <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.6rem">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#10b981" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <strong style="font-size:0.82rem;color:var(--text-1)">Service Uptime</strong>
      </div>
      <div id="ph-uptime" style="display:flex;flex-direction:column;gap:0.5rem">
        <div style="color:var(--text-3);font-size:0.75rem">Loading...</div>
      </div>
    </div>
  </div>

  <!-- Charts -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem">
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:1rem">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem">
        <strong style="font-size:0.82rem;color:var(--text-1)">Memory Usage Over Time</strong>
        <span style="font-size:0.68rem;color:var(--text-3)">Last 30 min</span>
      </div>
      <canvas id="ph-mem-chart" height="180" style="width:100%"></canvas>
    </div>
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:1rem">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem">
        <strong style="font-size:0.82rem;color:var(--text-1)">CPU Usage Over Time</strong>
        <span style="font-size:0.68rem;color:var(--text-3)">Last 30 min</span>
      </div>
      <canvas id="ph-cpu-chart" height="180" style="width:100%"></canvas>
    </div>
  </div>

  <!-- HTTP Requests Chart -->
  <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:1rem;margin-top:0.75rem">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem">
      <strong style="font-size:0.82rem;color:var(--text-1)">HTTP Request Rate</strong>
      <span style="font-size:0.68rem;color:var(--text-3)">Last 30 min</span>
    </div>
    <canvas id="ph-req-chart" height="140" style="width:100%"></canvas>
  </div>
</div>

<!-- LLM Activity & Cost Analysis -->
<div class="card animate-fade-up delay-300" style="margin-top:1.25rem">
  <div class="section-header mb-1">
    <div style="display:flex;align-items:center;gap:0.75rem">
      <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,rgba(139,92,246,0.15),rgba(139,92,246,0.08));display:flex;align-items:center;justify-content:center">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#8b5cf6" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
      </div>
      <div>
        <h3 style="margin:0;font-size:0.95rem">LLM Activity & Cost Analysis</h3>
        <p style="margin:0.15rem 0 0;color:var(--text-3);font-size:0.78rem">Token usage, cost breakdown, and model performance across all runs</p>
      </div>
    </div>
    <div style="display:flex;gap:0.5rem;align-items:center">
      <a href="/llm-activity" class="btn btn-primary btn-sm">Full Report</a>
      <button class="btn btn-sm" onclick="llmActivityRefresh()">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
      </button>
    </div>
  </div>

  <!-- Summary stat chips -->
  <div id="llm-summary-chips" style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:1rem">
    <div style="color:var(--text-3);font-size:0.78rem">Loading LLM activity...</div>
  </div>

  <!-- Two-column: model breakdown + recent activity -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">

    <!-- Model Breakdown -->
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:1rem">
      <strong style="font-size:0.82rem;color:var(--text-1);display:block;margin-bottom:0.75rem">Model Breakdown</strong>
      <div id="llm-model-breakdown" style="font-size:0.78rem;color:var(--text-3)">Loading...</div>
    </div>

    <!-- Cost Trend -->
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:1rem">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem">
        <strong style="font-size:0.82rem;color:var(--text-1)">Cost & Token Trend</strong>
        <span style="font-size:0.68rem;color:var(--text-3)">Last 20 runs</span>
      </div>
      <canvas id="llm-cost-chart" height="160" style="width:100%"></canvas>
    </div>

  </div>

  <!-- Recent LLM calls -->
  <div style="margin-top:1rem;background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:1rem">
    <strong style="font-size:0.82rem;color:var(--text-1);display:block;margin-bottom:0.75rem">Recent LLM Calls</strong>
    <div id="llm-recent-calls" style="font-size:0.78rem;color:var(--text-3)">Loading...</div>
  </div>
</div>

<script>
var _grActivityLoaded = false;
function toggleGrActivity() {
  var body = document.getElementById('gr-activity-body');
  var chevron = document.getElementById('gr-activity-chevron');
  var isOpen = body.style.display !== 'none';
  body.style.display = isOpen ? 'none' : 'block';
  chevron.style.transform = isOpen ? '' : 'rotate(180deg)';
  if (!isOpen && !_grActivityLoaded) { loadGrActivity(); _grActivityLoaded = true; }
}
function loadGrActivity() {
  fetch('/api/guardrails', { signal: AbortSignal.timeout(5000) })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      var guardrails = d.guardrails || [];
      var el = document.getElementById('gr-activity-content');
      var badges = document.getElementById('gr-activity-badges');
      if (!guardrails.length) { el.innerHTML = '<p>No guardrails configured. <a href="/guardrails">Set up guardrails</a></p>'; return; }
      var active = guardrails.filter(function(g) { return g.enabled; }).length;
      var disabled = guardrails.length - active;
      badges.innerHTML = '<span class="badge" style="background:rgba(16,185,129,0.15);color:#10b981;font-size:0.62rem">' + active + ' active</span>' +
        (disabled ? '<span class="badge" style="background:rgba(239,68,68,0.15);color:#ef4444;font-size:0.62rem">' + disabled + ' off</span>' : '');
      var cats = {};
      guardrails.forEach(function(g) { if (!cats[g.category]) cats[g.category] = []; cats[g.category].push(g); });
      var catIcons = { content_safety:'🛡️', quality:'✨', fairness:'⚖️', compliance:'📋', operational:'⚙️' };
      var catLabels = { content_safety:'Content Safety', quality:'Quality', fairness:'Fairness', compliance:'Compliance', operational:'Operational' };
      var html = '<div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem">';
      Object.keys(cats).forEach(function(cat) {
        var items = cats[cat];
        var catActive = items.filter(function(g) { return g.enabled; }).length;
        html += '<div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:10px;padding:0.75rem">' +
          '<div style="display:flex;align-items:center;gap:0.4rem;margin-bottom:0.5rem">' +
          '<span>' + (catIcons[cat] || '⚙️') + '</span>' +
          '<strong style="font-size:0.82rem;color:var(--text-1)">' + (catLabels[cat] || cat) + '</strong>' +
          '<span class="badge" style="margin-left:auto;font-size:0.6rem;background:' + (catActive === items.length ? 'rgba(16,185,129,0.15);color:#10b981' : 'rgba(245,158,11,0.15);color:#f59e0b') + '">' + catActive + '/' + items.length + '</span>' +
          '</div>';
        items.forEach(function(g) {
          var color = g.enabled ? '#10b981' : '#64748b';
          html += '<div style="display:flex;align-items:center;gap:0.4rem;padding:0.25rem 0;font-size:0.78rem">' +
            '<span style="width:6px;height:6px;border-radius:50%;background:' + color + ';flex-shrink:0"></span>' +
            '<span style="color:var(--text-2)">' + escapeHtml(g.name) + '</span>' +
            '<span style="margin-left:auto;font-size:0.65rem;color:var(--text-3)">' + g.severity + '</span></div>';
        });
        html += '</div>';
      });
      html += '</div>';
      html += '<a href="/guardrails" style="display:block;text-align:center;padding:0.5rem;font-size:0.78rem;color:#f59e0b;margin-top:0.5rem">Manage guardrails →</a>';
      el.innerHTML = html;
    })
    .catch(function() {
      document.getElementById('gr-activity-content').innerHTML = '<p style="color:var(--text-3)">Guardrail data unavailable</p>';
    });
}

function ihRefresh() { ihLoad(); }

function ihGuardrailCoverage(guardrailsData) {
  var enabled = guardrailsData.filter(function(g) { return g.enabled; });
  function hasCategory(cat) {
    return enabled.some(function(g) { return (g.category || '').toLowerCase() === cat; });
  }
  function hasPattern(re) {
    return enabled.some(function(g) {
      var txt = [g.id || '', g.name || '', g.description || '', g.category || ''].join(' ').toLowerCase();
      return re.test(txt);
    });
  }
  return [
    {
      id: 'prompt-injection',
      label: 'Prompt Injection Defense',
      status: hasPattern(/injection|jailbreak|prompt attack/) ? 'active' : 'missing',
      hint: 'Detect role hijack, ignore-instruction, and jailbreak prompts.'
    },
    {
      id: 'pii-secrets',
      label: 'PII & Secret Leakage',
      status: hasPattern(/pii|data leak|secret|credential|api key|password/) ? 'active' : 'missing',
      hint: 'Block sensitive identifiers and secret exfiltration in outputs.'
    },
    {
      id: 'grounding',
      label: 'Groundedness & Citations',
      status: hasPattern(/hallucination|citation|ground/) ? 'active' : 'missing',
      hint: 'Reduce fabricated claims and require source-backed responses.'
    },
    {
      id: 'toxicity-bias',
      label: 'Toxicity & Bias Moderation',
      status: hasPattern(/toxicity|bias|hate|fairness/) ? 'active' : 'missing',
      hint: 'Prevent harmful language and discriminatory outputs.'
    },
    {
      id: 'policy-compliance',
      label: 'Policy Compliance Gate',
      status: hasCategory('compliance') ? 'active' : 'missing',
      hint: 'Enforce org/regulatory policy checks before final response.'
    },
    {
      id: 'operational-fallback',
      label: 'Operational Fallback Rules',
      status: hasCategory('operational') ? 'active' : 'missing',
      hint: 'Add deterministic fallback rules when model checks fail.'
    }
  ];
}

function ihRenderSafetyPosture(guardrailsData, traces) {
  var el = document.getElementById('ih-safety-posture');
  if (!el) return;
  if (!guardrailsData || guardrailsData.length === 0) {
    el.innerHTML = '<p>No guardrails configured yet. Start with baseline controls in <a href="/guardrails">Guardrails</a>.</p>';
    return;
  }
  var controls = ihGuardrailCoverage(guardrailsData);
  var activeCount = controls.filter(function(c) { return c.status === 'active'; }).length;
  var score = Math.round((activeCount / controls.length) * 100);
  var scoreColor = score >= 85 ? '#10b981' : score >= 60 ? '#f59e0b' : '#f43f5e';
  var blocked = (traces || []).filter(function(t) { return (t.guardrail_status || '').toLowerCase() === 'blocked'; }).length;

  el.innerHTML =
    '<div style="display:flex;align-items:center;justify-content:space-between;gap:0.75rem;margin-bottom:0.7rem">' +
      '<div style="display:flex;align-items:center;gap:0.5rem">' +
        '<span class="badge" style="background:rgba(6,182,212,0.12);color:#06b6d4">Coverage ' + activeCount + '/' + controls.length + '</span>' +
        '<span class="badge" style="background:rgba(245,158,11,0.12);color:#f59e0b">Blocked Events ' + blocked + '</span>' +
      '</div>' +
      '<strong style="font-size:1rem;color:' + scoreColor + '">' + score + '%</strong>' +
    '</div>' +
    '<div style="display:grid;grid-template-columns:1fr 1fr;gap:0.6rem">' +
      controls.map(function(c) {
        var badge = c.status === 'active'
          ? '<span class="badge" style="font-size:0.62rem;background:rgba(16,185,129,0.15);color:#10b981">active</span>'
          : '<span class="badge" style="font-size:0.62rem;background:rgba(244,63,94,0.15);color:#f43f5e">missing</span>';
        return '<div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:10px;padding:0.65rem">' +
          '<div style="display:flex;justify-content:space-between;gap:0.5rem;align-items:center">' +
            '<strong style="font-size:0.76rem;color:var(--text-1)">' + c.label + '</strong>' + badge +
          '</div>' +
          '<p style="margin:0.35rem 0 0;font-size:0.72rem;color:var(--text-3);line-height:1.4">' + c.hint + '</p>' +
        '</div>';
      }).join('') +
    '</div>' +
    '<p style="margin:0.7rem 0 0;font-size:0.72rem;color:var(--text-3)">Tip: enable all missing controls before production rollout.</p>';
}

function ihLoad() {
  Promise.all([
    fetch('/api/traces').then(function(r) { return r.json(); }).catch(function() { return { traces: [] }; }),
    fetch('/api/agents').then(function(r) { return r.json(); }).catch(function() { return []; }),
    fetch('/api/observability/health').then(function(r) { return r.json(); }).catch(function() { return {}; }),
    fetch('/api/guardrails').then(function(r) { return r.json(); }).catch(function() { return { guardrails: [] }; }),
    fetch('/api/llm-activity/summary').then(function(r) { return r.json(); }).catch(function() { return {}; })
  ]).then(function(results) {
    var traces = results[0].traces || [];
    var agents = (results[1].agents || results[1] || []);
    var healthData = results[2];
    var guardrailsData = results[3].guardrails || [];
    var llmSummary = results[4] || {};

    /* Stats */
    document.getElementById('ih-traces').textContent = traces.length;

    var durations = traces.map(function(t) {
      if (t.latency && t.latency > 0) return t.latency;
      if (t.updatedAt && t.timestamp) { var d = new Date(t.updatedAt) - new Date(t.timestamp); if (d > 0) return d; }
      var m = t.metadata || {}; if (m.duration_ms) return m.duration_ms;
      return 0;
    }).filter(function(d) { return d > 0; });
    var avgMs = durations.length ? durations.reduce(function(a, b) { return a + b; }, 0) / durations.length : 0;
    document.getElementById('ih-latency').textContent = durations.length ? (avgMs / 1000).toFixed(1) + 's' : '-';

    /* Eval score */
    if (traces.length > 0) {
      var success = traces.filter(function(t) { return t.status !== 'ERROR'; }).length;
      var completionPct = Math.round(success / traces.length * 100);
      var under5s = durations.filter(function(d) { return d < 5000; }).length;
      var latencyPct = durations.length > 0 ? Math.round(under5s / durations.length * 100) : 0;
      var errorPct = Math.round((1 - (traces.length - success) / traces.length) * 100);
      var overall = Math.round(completionPct * 0.35 + latencyPct * 0.3 + errorPct * 0.35);
      document.getElementById('ih-eval-score').textContent = overall + '%';
      document.getElementById('ih-eval-score').style.color = overall >= 85 ? '#10b981' : overall >= 70 ? '#f59e0b' : '#f43f5e';
    } else {
      document.getElementById('ih-eval-score').textContent = '-';
    }

    /* Health */
    var services = healthData.services || [];
    var healthyCount = services.filter(function(s) { return s.status === 'healthy'; }).length;
    document.getElementById('ih-health').textContent = services.length > 0 ? healthyCount + '/' + services.length : '-';
    if (services.length > 0) {
      document.getElementById('ih-health').style.color = healthyCount === services.length ? '#10b981' : '#f59e0b';
    }

    /* LLM summary stats */
    var llmCalls = llmSummary.total_calls || 0;
    var llmTokens = llmSummary.total_tokens || 0;
    var llmCost = llmSummary.total_cost || 0;
    var llmCallsEl = document.getElementById('ih-llm-calls');
    var llmTokensEl = document.getElementById('ih-total-tokens');
    var llmCostEl = document.getElementById('ih-total-cost');
    var grCountEl = document.getElementById('ih-guardrail-count');
    if (llmCallsEl) llmCallsEl.textContent = llmCalls > 0 ? llmCalls : '-';
    if (llmTokensEl) llmTokensEl.textContent = llmTokens > 0 ? (llmTokens >= 1000 ? (llmTokens / 1000).toFixed(1) + 'K' : llmTokens) : '-';
    if (llmCostEl) {
      if (llmCost > 0) {
        llmCostEl.textContent = llmCost < 0.01 ? '$' + (llmCost * 1000).toFixed(2) + 'm' : '$' + llmCost.toFixed(4);
        llmCostEl.style.color = '#10b981';
      } else {
        llmCostEl.textContent = '-';
      }
    }
    if (grCountEl) {
      var grActive = guardrailsData.filter(function(g) { return g.enabled; }).length;
      grCountEl.textContent = guardrailsData.length > 0 ? grActive + '/' + guardrailsData.length : '-';
      if (guardrailsData.length > 0) grCountEl.style.color = grActive === guardrailsData.length ? '#10b981' : '#f59e0b';
    }

    /* Recent traces list */
    if (traces.length === 0) {
      document.getElementById('ih-traces-list').innerHTML = '<p>No traces yet. <a href="/run-agent">Run an agent</a> to generate data.</p>';
    } else {
      document.getElementById('ih-traces-list').innerHTML = traces.slice(0, 5).map(function(t) {
        var statusColor = t.status === 'ERROR' ? '#f43f5e' : '#10b981';
        var lat = 0;
        if (t.latency && t.latency > 0) lat = t.latency;
        else if (t.updatedAt && t.timestamp) { var d = new Date(t.updatedAt) - new Date(t.timestamp); if (d > 0) lat = d; }
        var latStr = lat > 0 ? (lat / 1000).toFixed(1) + 's' : '-';
        return '<div style="display:flex;align-items:center;justify-content:space-between;padding:0.4rem 0;border-bottom:1px solid var(--glass-border)">' +
          '<div style="display:flex;align-items:center;gap:0.4rem"><span style="width:6px;height:6px;border-radius:50%;background:' + statusColor + '"></span>' +
          '<span style="color:var(--text-1);font-size:0.78rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:160px">' + escapeHtml(t.name || (t.id || '-').slice(0, 12)) + '</span></div>' +
          '<span class="mono" style="font-size:0.72rem;color:var(--text-3)">' + latStr + '</span></div>';
      }).join('') + '<a href="/traceability" style="display:block;text-align:center;padding:0.5rem;font-size:0.78rem;color:#06b6d4">View all ' + traces.length + ' traces</a>';
    }

    /* Eval summary */
    if (traces.length === 0) {
      document.getElementById('ih-eval-summary').innerHTML = '<p>No data to evaluate yet.</p>';
    } else {
      var success = traces.filter(function(t) { return t.status !== 'ERROR'; }).length;
      var errorCount = traces.length - success;
      document.getElementById('ih-eval-summary').innerHTML =
        '<div style="display:flex;flex-direction:column;gap:0.5rem">' +
        '<div style="display:flex;justify-content:space-between;padding:0.35rem 0;border-bottom:1px solid var(--glass-border)"><span>Completion Rate</span><span style="font-weight:600;color:#10b981">' + Math.round(success / traces.length * 100) + '%</span></div>' +
        '<div style="display:flex;justify-content:space-between;padding:0.35rem 0;border-bottom:1px solid var(--glass-border)"><span>Error Rate</span><span style="font-weight:600;color:' + (errorCount > 0 ? '#f43f5e' : '#10b981') + '">' + Math.round(errorCount / traces.length * 100) + '%</span></div>' +
        '<div style="display:flex;justify-content:space-between;padding:0.35rem 0;border-bottom:1px solid var(--glass-border)"><span>Avg Latency</span><span class="mono" style="font-weight:600">' + (avgMs > 0 ? (avgMs / 1000).toFixed(1) + 's' : '-') + '</span></div>' +
        '</div>' +
        '<a href="/evaluation" style="display:block;text-align:center;padding:0.5rem;font-size:0.78rem;color:#8b5cf6">Full evaluation</a>';
    }

    /* Obs summary */
    if (services.length === 0) {
      document.getElementById('ih-obs-summary').innerHTML = '<p>Observability stack not detected.</p>';
    } else {
      document.getElementById('ih-obs-summary').innerHTML = services.map(function(svc) {
        var color = svc.status === 'healthy' ? '#10b981' : '#f43f5e';
        var icon = svc.status === 'healthy' ? '\\u2714' : '\\u2716';
        return '<div style="display:flex;align-items:center;justify-content:space-between;padding:0.35rem 0;border-bottom:1px solid var(--glass-border)">' +
          '<span style="color:var(--text-1);text-transform:capitalize">' + escapeHtml(svc.name) + '</span>' +
          '<span style="color:' + color + ';font-size:0.78rem">' + icon + ' ' + svc.status + '</span></div>';
      }).join('') +
        '<a href="/observability" style="display:block;text-align:center;padding:0.5rem;font-size:0.78rem;color:#10b981">Full observability</a>';
    }

    /* Guardrails summary */
    if (guardrailsData.length === 0) {
      document.getElementById('ih-guardrails-summary').innerHTML = '<p>No guardrails configured. <a href="/guardrails">Set up guardrails</a></p>';
    } else {
      var grActive = guardrailsData.filter(function(g) { return g.enabled; }).length;
      var grDisabled = guardrailsData.length - grActive;
      var catCounts = {};
      guardrailsData.forEach(function(g) { catCounts[g.category] = (catCounts[g.category] || 0) + 1; });
      var catLabels = { content_safety:'Content Safety', quality:'Quality', fairness:'Fairness', compliance:'Compliance', operational:'Operational' };
      document.getElementById('ih-guardrails-summary').innerHTML =
        '<div style="display:flex;flex-direction:column;gap:0.4rem">' +
        '<div style="display:flex;justify-content:space-between;padding:0.35rem 0;border-bottom:1px solid var(--glass-border)"><span>Active</span><span style="font-weight:600;color:#10b981">' + grActive + ' / ' + guardrailsData.length + '</span></div>' +
        (grDisabled > 0 ? '<div style="display:flex;justify-content:space-between;padding:0.35rem 0;border-bottom:1px solid var(--glass-border)"><span>Disabled</span><span style="font-weight:600;color:#f43f5e">' + grDisabled + '</span></div>' : '') +
        Object.keys(catCounts).slice(0, 3).map(function(cat) {
          return '<div style="display:flex;justify-content:space-between;padding:0.35rem 0;border-bottom:1px solid var(--glass-border)"><span>' + (catLabels[cat] || cat) + '</span><span class="mono" style="font-weight:600">' + catCounts[cat] + '</span></div>';
        }).join('') +
        '</div>' +
        '<a href="/guardrails" style="display:block;text-align:center;padding:0.5rem;font-size:0.78rem;color:#f59e0b">Manage guardrails</a>';
    }

      ihRenderSafetyPosture(guardrailsData, traces);

    /* Agent table */
    if (agents.length === 0) {
      document.getElementById('ih-agent-table').innerHTML = '<p>No agents registered yet. <a href="/agents">Create one</a></p>';
    } else {
      var html = '<table><tr><th>Agent</th><th>Model</th><th>Traces</th><th>Error Rate</th><th>Avg Latency</th></tr>';
      agents.forEach(function(agent) {
        var agentName = agent.name.toLowerCase();
        var agentId = agent.id.toLowerCase();
        var agentTraces = traces.filter(function(t) {
          var n = (t.name || '').toLowerCase();
          var m = JSON.stringify(t.metadata || {}).toLowerCase();
          return n.indexOf(agentName) !== -1 || m.indexOf(agentName) !== -1 || m.indexOf(agentId) !== -1;
        });
        var errs = agentTraces.filter(function(t) { return t.status === 'ERROR'; }).length;
        var errRate = agentTraces.length > 0 ? Math.round(errs / agentTraces.length * 100) : 0;
        var durs = agentTraces.map(function(t) {
          if (t.latency && t.latency > 0) return t.latency;
          if (t.updatedAt && t.timestamp) { var d = new Date(t.updatedAt) - new Date(t.timestamp); if (d > 0) return d; }
          return 0;
        }).filter(function(d) { return d > 0; });
        var avg = durs.length > 0 ? (durs.reduce(function(a, b) { return a + b; }, 0) / durs.length / 1000).toFixed(1) + 's' : '-';
        html += '<tr>' +
          '<td style="font-weight:600">' + escapeHtml(agent.name) + (agent.is_default ? ' <span style="font-size:0.62rem;color:var(--text-3)">(default)</span>' : '') + '</td>' +
          '<td class="mono" style="font-size:0.75rem">' + escapeHtml((agent.provider || '') + '/' + (agent.model || '')) + '</td>' +
          '<td class="mono">' + agentTraces.length + '</td>' +
          '<td><span style="color:' + (errRate > 10 ? '#f43f5e' : '#10b981') + ';font-weight:600">' + errRate + '%</span></td>' +
          '<td class="mono">' + avg + '</td></tr>';
      });
      html += '</table>';
      document.getElementById('ih-agent-table').innerHTML = html;
    }
  }).catch(function(e) {
    console.error('Intelligence Hub load failed:', e);
    var errMsg = '<p style="color:var(--text-3)">Unable to load data. <button class="btn btn-sm" onclick="ihLoad()">Retry</button></p>';
    ['ih-traces-list','ih-eval-summary','ih-guardrails-summary','ih-obs-summary','ih-agent-table'].forEach(function(id) {
      var el = document.getElementById(id);
      if (el && el.textContent.trim() === 'Loading...') el.innerHTML = errMsg;
    });
    var postureEl = document.getElementById('ih-safety-posture');
    if (postureEl && postureEl.textContent.trim() === 'Loading...') postureEl.innerHTML = errMsg;
  });
}

ihLoad();

/* ── Platform Health Monitoring ── */
var phColors = { 'agent-service': '#06b6d4', 'tools-service': '#8b5cf6', 'otel-collector': '#f59e0b' };
var phCharts = {};

function phFormatBytes(b) {
  if (b > 1073741824) return (b / 1073741824).toFixed(1) + ' GB';
  if (b > 1048576) return (b / 1048576).toFixed(1) + ' MB';
  if (b > 1024) return (b / 1024).toFixed(1) + ' KB';
  return b + ' B';
}

function phPromQuery(query) {
  return fetch('/api/observability/prometheus/query?query=' + encodeURIComponent(query))
    .then(function(r) { return r.json(); })
    .then(function(d) { return (d.status === 'success' && d.data && d.data.result) ? d.data.result : []; })
    .catch(function() { return []; });
}

function phPromRange(query, start, end, step) {
  return fetch('/api/observability/prometheus/query_range?query=' + encodeURIComponent(query) + '&start=' + start + '&end=' + end + '&step=' + step)
    .then(function(r) { return r.json(); })
    .then(function(d) { return (d.status === 'success' && d.data && d.data.result) ? d.data.result : []; })
    .catch(function() { return []; });
}

function phDrawGauges() {
  Promise.all([
    phPromQuery('rate(process_cpu_seconds_total[1m])'),
    phPromQuery('process_resident_memory_bytes'),
    phPromQuery('up'),
    phPromQuery('process_start_time_seconds')
  ]).then(function(results) {
    var cpuData = results[0];
    var memData = results[1];
    var upData = results[2];
    var startData = results[3];

    /* CPU gauges */
    if (cpuData.length > 0) {
      document.getElementById('ph-cpu-gauges').innerHTML = cpuData.map(function(r) {
        var job = r.metric.job || '?';
        var pct = Math.min(100, (parseFloat(r.value[1]) * 100));
        var color = pct > 75 ? '#f43f5e' : pct > 50 ? '#f59e0b' : '#10b981';
        return '<div><div style="display:flex;justify-content:space-between;font-size:0.75rem;margin-bottom:3px"><span style="color:var(--text-2)">' + job + '</span><span style="color:' + color + ';font-weight:600">' + pct.toFixed(1) + '%</span></div>' +
          '<div style="height:5px;background:var(--glass-border);border-radius:3px;overflow:hidden"><div style="height:100%;width:' + pct + '%;background:' + color + ';border-radius:3px;transition:width 0.5s"></div></div></div>';
      }).join('');
    } else {
      document.getElementById('ph-cpu-gauges').innerHTML = '<div style="color:var(--text-3);font-size:0.75rem">No CPU data</div>';
    }

    /* Memory gauges */
    if (memData.length > 0) {
      document.getElementById('ph-mem-gauges').innerHTML = memData.map(function(r) {
        var job = r.metric.job || '?';
        var bytes = parseFloat(r.value[1]);
        var maxMb = 512;
        var pct = Math.min(100, bytes / (maxMb * 1048576) * 100);
        var color = pct > 75 ? '#f43f5e' : pct > 50 ? '#f59e0b' : '#8b5cf6';
        return '<div><div style="display:flex;justify-content:space-between;font-size:0.75rem;margin-bottom:3px"><span style="color:var(--text-2)">' + job + '</span><span style="color:' + color + ';font-weight:600">' + phFormatBytes(bytes) + '</span></div>' +
          '<div style="height:5px;background:var(--glass-border);border-radius:3px;overflow:hidden"><div style="height:100%;width:' + pct + '%;background:' + color + ';border-radius:3px;transition:width 0.5s"></div></div></div>';
      }).join('');
    } else {
      document.getElementById('ph-mem-gauges').innerHTML = '<div style="color:var(--text-3);font-size:0.75rem">No memory data</div>';
    }

    /* Uptime */
    if (upData.length > 0) {
      document.getElementById('ph-uptime').innerHTML = upData.map(function(r) {
        var job = r.metric.job || '?';
        var isUp = r.value[1] === '1';
        var startTs = 0;
        var startMatch = startData.find(function(s) { return s.metric.job === job; });
        if (startMatch) startTs = parseFloat(startMatch.value[1]);
        var uptimeStr = '-';
        if (startTs > 0) {
          var secs = Math.floor(Date.now() / 1000 - startTs);
          if (secs > 86400) uptimeStr = Math.floor(secs / 86400) + 'd ' + Math.floor((secs % 86400) / 3600) + 'h';
          else if (secs > 3600) uptimeStr = Math.floor(secs / 3600) + 'h ' + Math.floor((secs % 3600) / 60) + 'm';
          else uptimeStr = Math.floor(secs / 60) + 'm';
        }
        return '<div style="display:flex;justify-content:space-between;align-items:center;font-size:0.75rem"><span style="display:flex;align-items:center;gap:4px"><span style="width:6px;height:6px;border-radius:50%;background:' + (isUp ? '#10b981' : '#f43f5e') + '"></span><span style="color:var(--text-2)">' + job + '</span></span><span class="mono" style="color:var(--text-3)">' + uptimeStr + '</span></div>';
      }).join('');
    } else {
      document.getElementById('ph-uptime').innerHTML = '<div style="color:var(--text-3);font-size:0.75rem">No uptime data</div>';
    }
  });
}

function phDrawChart(canvasId, rangeData, unit, formatter) {
  var canvas = document.getElementById(canvasId);
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  var w = canvas.parentElement.clientWidth - 32;
  var h = 180;
  canvas.width = w * (window.devicePixelRatio || 1);
  canvas.height = h * (window.devicePixelRatio || 1);
  canvas.style.width = w + 'px';
  canvas.style.height = h + 'px';
  ctx.scale(window.devicePixelRatio || 1, window.devicePixelRatio || 1);

  if (rangeData.length === 0) {
    ctx.fillStyle = 'rgba(255,255,255,0.3)';
    ctx.font = '12px sans-serif';
    ctx.fillText('No data available', w / 2 - 50, h / 2);
    return;
  }

  var padL = 60, padR = 10, padT = 10, padB = 30;
  var cw = w - padL - padR;
  var ch = h - padT - padB;

  /* Find global min/max */
  var allVals = [];
  rangeData.forEach(function(series) {
    series.values.forEach(function(v) { allVals.push(parseFloat(v[1])); });
  });
  var minV = Math.min.apply(null, allVals);
  var maxV = Math.max.apply(null, allVals);
  if (maxV === minV) { maxV = minV + 1; }
  var range = maxV - minV;

  /* Time range */
  var allTimes = rangeData[0].values.map(function(v) { return v[0]; });
  var tMin = allTimes[0], tMax = allTimes[allTimes.length - 1];
  var tRange = tMax - tMin || 1;

  /* Grid lines */
  ctx.strokeStyle = 'rgba(255,255,255,0.06)';
  ctx.lineWidth = 1;
  for (var g = 0; g <= 4; g++) {
    var gy = padT + ch - (g / 4) * ch;
    ctx.beginPath(); ctx.moveTo(padL, gy); ctx.lineTo(padL + cw, gy); ctx.stroke();
    ctx.fillStyle = 'rgba(255,255,255,0.35)';
    ctx.font = '10px monospace';
    ctx.textAlign = 'right';
    var labelVal = minV + (g / 4) * range;
    ctx.fillText(formatter ? formatter(labelVal) : labelVal.toFixed(1), padL - 6, gy + 3);
  }

  /* Time labels */
  ctx.textAlign = 'center';
  ctx.fillStyle = 'rgba(255,255,255,0.35)';
  for (var ti = 0; ti <= 4; ti++) {
    var tx = padL + (ti / 4) * cw;
    var tVal = new Date((tMin + (ti / 4) * tRange) * 1000);
    ctx.fillText(tVal.getHours().toString().padStart(2, '0') + ':' + tVal.getMinutes().toString().padStart(2, '0'), tx, h - 5);
  }

  /* Draw lines */
  var colorIdx = 0;
  var colorList = ['#06b6d4', '#8b5cf6', '#f59e0b', '#10b981', '#f43f5e'];
  var legendItems = [];
  rangeData.forEach(function(series) {
    var color = phColors[series.metric.job] || colorList[colorIdx % colorList.length];
    colorIdx++;
    legendItems.push({ name: series.metric.job || '?', color: color });

    ctx.strokeStyle = color;
    ctx.lineWidth = 2;
    ctx.beginPath();
    series.values.forEach(function(v, i) {
      var x = padL + ((v[0] - tMin) / tRange) * cw;
      var y = padT + ch - ((parseFloat(v[1]) - minV) / range) * ch;
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    });
    ctx.stroke();

    /* Area fill */
    ctx.globalAlpha = 0.08;
    ctx.fillStyle = color;
    ctx.lineTo(padL + cw, padT + ch);
    ctx.lineTo(padL, padT + ch);
    ctx.closePath();
    ctx.fill();
    ctx.globalAlpha = 1;
  });

  /* Legend */
  var lx = padL + 5;
  legendItems.forEach(function(item) {
    ctx.fillStyle = item.color;
    ctx.fillRect(lx, padT + 2, 8, 8);
    ctx.fillStyle = 'rgba(255,255,255,0.5)';
    ctx.font = '10px sans-serif';
    ctx.textAlign = 'left';
    ctx.fillText(item.name, lx + 12, padT + 10);
    lx += ctx.measureText(item.name).width + 24;
  });
}

function phDrawCharts() {
  var now = Math.floor(Date.now() / 1000);
  var start = now - 1800;
  var step = 30;

  Promise.all([
    phPromRange('process_resident_memory_bytes', start, now, step),
    phPromRange('rate(process_cpu_seconds_total[1m])', start, now, step),
    phPromRange('sum(rate(http_requests_total[2m])) by (job)', start, now, step)
  ]).then(function(results) {
    phDrawChart('ph-mem-chart', results[0], 'bytes', phFormatBytes);
    phDrawChart('ph-cpu-chart', results[1], 'percent', function(v) { return (v * 100).toFixed(1) + '%'; });
    phDrawChart('ph-req-chart', results[2], 'req/s', function(v) { return v.toFixed(2); });
  });
}

function phRefresh() {
  phDrawGauges();
  phDrawCharts();
}

/* ── LLM Activity & Cost Analysis ── */

function llmFmtCost(c) {
  if (!c || c === 0) return '$0.00';
  if (c < 0.001) return '$' + (c * 1000).toFixed(4) + 'm';
  return '$' + parseFloat(c).toFixed(4);
}
function llmFmtTokens(n) {
  if (!n) return '0';
  if (n >= 1000000) return (n / 1000000).toFixed(1) + 'M';
  if (n >= 1000) return (n / 1000).toFixed(1) + 'K';
  return '' + n;
}

function llmActivityLoad() {
  Promise.all([
    fetch('/api/llm-activity?limit=200').then(function(r) { return r.json(); }).catch(function() { return { entries: [] }; }),
    fetch('/api/llm-activity/summary').then(function(r) { return r.json(); }).catch(function() { return {}; })
  ]).then(function(res) {
    var entries = res[0].entries || [];
    var summary = res[1] || {};

    /* Summary chips */
    var totalTokens = summary.total_tokens || entries.reduce(function(a, e) { return a + (e.total_tokens || 0); }, 0);
    var totalCost   = summary.total_cost   || entries.reduce(function(a, e) { return a + (e.estimated_cost || 0); }, 0);
    var totalCalls  = summary.total_calls  || entries.length;
    var avgLatency  = summary.avg_latency_ms;
    if (!avgLatency && entries.length) {
      avgLatency = entries.reduce(function(a, e) { return a + (e.latency_ms || 0); }, 0) / entries.length;
    }

    document.getElementById('llm-summary-chips').innerHTML =
      '<div style="display:flex;align-items:center;gap:0.4rem;padding:0.5rem 0.85rem;border-radius:8px;background:rgba(139,92,246,0.08);border:1px solid rgba(139,92,246,0.2)">' +
        '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#8b5cf6" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>' +
        '<span style="font-size:0.78rem;color:var(--text-2)">Calls</span>' +
        '<strong style="font-size:0.9rem;color:#8b5cf6">' + totalCalls + '</strong></div>' +
      '<div style="display:flex;align-items:center;gap:0.4rem;padding:0.5rem 0.85rem;border-radius:8px;background:rgba(6,182,212,0.08);border:1px solid rgba(6,182,212,0.2)">' +
        '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#06b6d4" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>' +
        '<span style="font-size:0.78rem;color:var(--text-2)">Tokens</span>' +
        '<strong style="font-size:0.9rem;color:#06b6d4">' + llmFmtTokens(totalTokens) + '</strong></div>' +
      '<div style="display:flex;align-items:center;gap:0.4rem;padding:0.5rem 0.85rem;border-radius:8px;background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.2)">' +
        '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#10b981" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>' +
        '<span style="font-size:0.78rem;color:var(--text-2)">Est. Cost</span>' +
        '<strong style="font-size:0.9rem;color:#10b981">' + llmFmtCost(totalCost) + '</strong></div>' +
      (avgLatency ? '<div style="display:flex;align-items:center;gap:0.4rem;padding:0.5rem 0.85rem;border-radius:8px;background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.2)">' +
        '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#f59e0b" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>' +
        '<span style="font-size:0.78rem;color:var(--text-2)">Avg Latency</span>' +
        '<strong style="font-size:0.9rem;color:#f59e0b">' + (avgLatency / 1000).toFixed(2) + 's</strong></div>' : '') +
      '<a href="/llm-activity" style="display:flex;align-items:center;gap:0.3rem;padding:0.5rem 0.85rem;border-radius:8px;background:var(--glass-bg);border:1px solid var(--glass-border);font-size:0.75rem;color:var(--text-2);text-decoration:none">' +
        'Full Activity <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>';

    /* Model breakdown */
    var byModel = {};
    entries.forEach(function(e) {
      var key = (e.provider || 'unknown') + '/' + (e.model || 'unknown');
      if (!byModel[key]) byModel[key] = { calls: 0, tokens: 0, cost: 0, latencies: [] };
      byModel[key].calls++;
      byModel[key].tokens += (e.total_tokens || 0);
      byModel[key].cost += (e.estimated_cost || 0);
      if (e.latency_ms) byModel[key].latencies.push(e.latency_ms);
    });

    var modelKeys = Object.keys(byModel).sort(function(a, b) { return byModel[b].calls - byModel[a].calls; });
    if (modelKeys.length === 0) {
      document.getElementById('llm-model-breakdown').innerHTML = '<p>No LLM activity yet. <a href="/run-agent">Run an agent</a> to generate data.</p>';
    } else {
      var maxCalls = Math.max.apply(null, modelKeys.map(function(k) { return byModel[k].calls; }));
      document.getElementById('llm-model-breakdown').innerHTML =
        '<div style="display:flex;flex-direction:column;gap:0.6rem">' +
        modelKeys.slice(0, 6).map(function(key) {
          var d = byModel[key];
          var pct = Math.round(d.calls / maxCalls * 100);
          var avgLat = d.latencies.length ? (d.latencies.reduce(function(a, b) { return a + b; }, 0) / d.latencies.length / 1000).toFixed(2) : '-';
          var parts = key.split('/');
          var provider = parts[0];
          var model = parts.slice(1).join('/');
          var provColor = { ollama: '#f59e0b', openai: '#10b981', 'azure-openai': '#06b6d4', 'azure-foundry': '#8b5cf6' }[provider] || '#94a3b8';
          return '<div>' +
            '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:3px">' +
              '<div style="display:flex;align-items:center;gap:0.4rem">' +
                '<span style="width:6px;height:6px;border-radius:50%;background:' + provColor + ';flex-shrink:0"></span>' +
                '<span style="color:var(--text-1);font-size:0.78rem;font-weight:600">' + escapeHtml(model) + '</span>' +
                '<span style="font-size:0.65rem;color:var(--text-3)">' + provider + '</span>' +
              '</div>' +
              '<div style="display:flex;gap:0.5rem;font-size:0.7rem;color:var(--text-3)">' +
                '<span>' + d.calls + ' calls</span>' +
                '<span>' + llmFmtTokens(d.tokens) + ' tok</span>' +
                '<span style="color:#10b981">' + llmFmtCost(d.cost) + '</span>' +
              '</div>' +
            '</div>' +
            '<div style="height:4px;background:var(--glass-border);border-radius:2px;overflow:hidden">' +
              '<div style="height:100%;width:' + pct + '%;background:' + provColor + ';border-radius:2px;transition:width 0.5s"></div></div></div>';
        }).join('') +
        '</div>';
    }

    /* Cost + token trend chart (raw canvas — no Chart.js dependency) */
    (function() {
      var canvas = document.getElementById('llm-cost-chart');
      if (!canvas) return;
      var recent = entries.slice(0, 24).reverse();
      if (recent.length === 0) {
        canvas.parentElement.innerHTML = '<div style="color:var(--text-3);font-size:0.75rem;display:flex;align-items:center;justify-content:center;height:160px">No activity data yet. <a href="/run-agent" style="margin-left:4px">Run an agent</a></div>';
        return;
      }
      var dpr = window.devicePixelRatio || 1;
      var W = canvas.parentElement.clientWidth - 32 || 300;
      var H = 160;
      canvas.width = W * dpr; canvas.height = H * dpr;
      canvas.style.width = W + 'px'; canvas.style.height = H + 'px';
      var ctx = canvas.getContext('2d');
      ctx.scale(dpr, dpr);

      var padL = 44, padR = 8, padT = 12, padB = 28;
      var chartW = W - padL - padR;
      var chartH = H - padT - padB;

      var tokensData = recent.map(function(e) { return e.total_tokens || 0; });
      var maxTok = Math.max.apply(null, tokensData) || 1;
      var n = recent.length;
      var barW = Math.max(3, Math.floor(chartW / n) - 2);

      /* grid lines */
      ctx.strokeStyle = 'rgba(255,255,255,0.06)';
      ctx.lineWidth = 1;
      for (var gi = 0; gi <= 4; gi++) {
        var gy = padT + chartH - (gi / 4) * chartH;
        ctx.beginPath(); ctx.moveTo(padL, gy); ctx.lineTo(padL + chartW, gy); ctx.stroke();
      }

      /* bars (tokens) */
      recent.forEach(function(e, i) {
        var x = padL + Math.round(i * chartW / n);
        var barH = Math.round((e.total_tokens || 0) / maxTok * chartH);
        var grad = ctx.createLinearGradient(0, padT + chartH - barH, 0, padT + chartH);
        grad.addColorStop(0, 'rgba(6,182,212,0.6)');
        grad.addColorStop(1, 'rgba(6,182,212,0.15)');
        ctx.fillStyle = grad;
        ctx.fillRect(x, padT + chartH - barH, barW, barH);
      });

      /* latency sparkline */
      var latencies = recent.map(function(e) { return e.latency_ms || 0; });
      var maxLat = Math.max.apply(null, latencies) || 1;
      ctx.beginPath();
      ctx.strokeStyle = '#f59e0b';
      ctx.lineWidth = 1.5;
      recent.forEach(function(e, i) {
        var x = padL + Math.round(i * chartW / n) + barW / 2;
        var y = padT + chartH - Math.round((e.latency_ms || 0) / maxLat * chartH);
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      });
      ctx.stroke();

      /* y-axis labels (tokens) */
      ctx.fillStyle = 'rgba(6,182,212,0.8)';
      ctx.font = '9px monospace';
      ctx.textAlign = 'right';
      ctx.fillText(llmFmtTokens(maxTok), padL - 3, padT + 8);
      ctx.fillText('0', padL - 3, padT + chartH);

      /* legend */
      ctx.font = '9px sans-serif';
      ctx.fillStyle = 'rgba(6,182,212,0.8)';
      ctx.textAlign = 'left';
      ctx.fillText('■ Tokens', padL, H - 8);
      ctx.fillStyle = '#f59e0b';
      ctx.fillText('— Latency', padL + 60, H - 8);
    }());

    /* Recent calls table */
    var recentCalls = entries.slice(0, 8);
    if (recentCalls.length === 0) {
      document.getElementById('llm-recent-calls').innerHTML = '<p>No LLM calls recorded. <a href="/run-agent">Run an agent</a> to generate data.</p>';
    } else {
      document.getElementById('llm-recent-calls').innerHTML =
        '<table style="width:100%;border-collapse:collapse">' +
        '<tr style="border-bottom:1px solid var(--glass-border)">' +
          '<th style="text-align:left;padding:0.3rem 0;font-size:0.72rem;color:var(--text-3);font-weight:600">Time</th>' +
          '<th style="text-align:left;padding:0.3rem 0;font-size:0.72rem;color:var(--text-3);font-weight:600">Model</th>' +
          '<th style="text-align:right;padding:0.3rem 0;font-size:0.72rem;color:var(--text-3);font-weight:600">Tokens</th>' +
          '<th style="text-align:right;padding:0.3rem 0;font-size:0.72rem;color:var(--text-3);font-weight:600">Cost</th>' +
          '<th style="text-align:right;padding:0.3rem 0;font-size:0.72rem;color:var(--text-3);font-weight:600">Latency</th>' +
          '<th style="text-align:center;padding:0.3rem 0;font-size:0.72rem;color:var(--text-3);font-weight:600">Guard</th>' +
        '</tr>' +
        recentCalls.map(function(e) {
          var dt = e.created_at ? new Date(e.created_at) : null;
          var timeStr = dt ? dt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '-';
          var model = (e.model || '-');
          var guardColor = e.guardrail_status === 'passed' ? '#10b981' : e.guardrail_status === 'blocked' ? '#f43f5e' : '#94a3b8';
          return '<tr style="border-bottom:1px solid var(--glass-border)">' +
            '<td class="mono" style="padding:0.35rem 0;font-size:0.72rem;color:var(--text-3)">' + timeStr + '</td>' +
            '<td style="padding:0.35rem 0;font-size:0.75rem;max-width:130px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text-1)">' + escapeHtml(model) + '</td>' +
            '<td class="mono" style="text-align:right;padding:0.35rem 0;font-size:0.75rem;color:#06b6d4">' + llmFmtTokens(e.total_tokens || 0) + '</td>' +
            '<td class="mono" style="text-align:right;padding:0.35rem 0;font-size:0.75rem;color:#10b981">' + llmFmtCost(e.estimated_cost) + '</td>' +
            '<td class="mono" style="text-align:right;padding:0.35rem 0;font-size:0.75rem;color:var(--text-3)">' + (e.latency_ms ? (e.latency_ms / 1000).toFixed(2) + 's' : '-') + '</td>' +
            '<td style="text-align:center;padding:0.35rem 0"><span style="font-size:0.65rem;color:' + guardColor + '">&#9679;</span></td>' +
          '</tr>';
        }).join('') +
        '</table>';
    }
  }).catch(function(err) {
    console.error('LLM activity load failed:', err);
    ['llm-summary-chips', 'llm-model-breakdown', 'llm-recent-calls'].forEach(function(id) {
      var el = document.getElementById(id);
      if (el) el.innerHTML = '<p style="color:var(--text-3);font-size:0.78rem">Unable to load. <button class="btn btn-sm" onclick="llmActivityLoad()">Retry</button></p>';
    });
  });
}

function llmActivityRefresh() { llmActivityLoad(); }

llmActivityLoad();

phRefresh();
/* Auto-refresh every 30s */
setInterval(phRefresh, 30000);
<\/script>
