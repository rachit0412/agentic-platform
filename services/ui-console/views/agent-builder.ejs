<%- include('layout', { title: 'Agent Builder', page: 'agent-builder', body: `

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem">
  <div>
    <h1 class="text-glow-cyan" style="margin:0">Agent Builder</h1>
    <p style="color:var(--text-3);font-size:0.82rem;margin:0.35rem 0 0">Visual end-to-end flow: assemble prompts, skills, knowledge, tools, and controls into a deployable agent.</p>
  </div>
  <div style="display:flex;gap:0.5rem;align-items:center">
    <select id="ab-load-agent" class="input" style="min-width:200px;font-size:0.82rem" onchange="abLoadExisting()">
      <option value="">New Agent</option>
    </select>
    <button class="btn btn-secondary btn-sm" onclick="abReset()">Reset</button>
  </div>
</div>

<!-- ═══ AGENT IDENTITY ═══ -->
<div class="card animate-fade-up" style="margin-bottom:1.5rem;padding:1.25rem 1.5rem">
  <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1rem">
    <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,rgba(6,182,212,0.15),rgba(6,182,212,0.08));display:flex;align-items:center;justify-content:center">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#06b6d4" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6" rx="1"/></svg>
    </div>
    <div>
      <h3 style="margin:0;font-size:1rem">Agent Identity</h3>
      <p style="margin:0.15rem 0 0;color:var(--text-3);font-size:0.78rem">Give your agent a name and describe its purpose.</p>
    </div>
  </div>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
    <div>
      <label class="field-label">Agent Name</label>
      <input type="text" id="ab-name" class="input" placeholder="e.g. Research Agent" maxlength="100" oninput="abRenderCollections()">
    </div>
    <div>
      <label class="field-label">Description</label>
      <input type="text" id="ab-desc" class="input" placeholder="Brief purpose of this agent" maxlength="500">
    </div>
  </div>
</div>

<!-- ═══ FLOW PIPELINE ═══ -->
<div id="ab-pipeline" style="display:flex;align-items:stretch;gap:0;margin-bottom:1.5rem;position:relative">

  <!-- ── STEP 1: Prompt ── -->
  <div class="ab-step" id="ab-step-1" onclick="abGoTo(1)">
    <div class="ab-step-num">1</div>
    <div class="ab-step-icon" style="background:linear-gradient(135deg,rgba(139,92,246,0.15),rgba(139,92,246,0.06))">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#8b5cf6" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><line x1="8" y1="9" x2="16" y2="9"/><line x1="8" y1="13" x2="13" y2="13"/></svg>
    </div>
    <div class="ab-step-title">System Prompt</div>
    <div class="ab-step-status" id="ab-status-1">Not configured</div>
  </div>
  <div class="ab-connector"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="var(--text-3)" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></div>

  <!-- ── STEP 2: Skills ── -->
  <div class="ab-step" id="ab-step-2" onclick="abGoTo(2)">
    <div class="ab-step-num">2</div>
    <div class="ab-step-icon" style="background:linear-gradient(135deg,rgba(245,158,11,0.15),rgba(245,158,11,0.06))">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
    </div>
    <div class="ab-step-title">Skills</div>
    <div class="ab-step-status" id="ab-status-2">None selected</div>
  </div>
  <div class="ab-connector"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="var(--text-3)" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></div>

  <!-- ── STEP 3: Knowledge Base ── -->
  <div class="ab-step" id="ab-step-3" onclick="abGoTo(3)">
    <div class="ab-step-num">3</div>
    <div class="ab-step-icon" style="background:linear-gradient(135deg,rgba(6,182,212,0.15),rgba(6,182,212,0.06))">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#06b6d4" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
    </div>
    <div class="ab-step-title">Knowledge Base</div>
    <div class="ab-step-status" id="ab-status-3">Default</div>
  </div>
  <div class="ab-connector"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="var(--text-3)" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></div>

  <!-- ── STEP 4: Tools ── -->
  <div class="ab-step" id="ab-step-4" onclick="abGoTo(4)">
    <div class="ab-step-num">4</div>
    <div class="ab-step-icon" style="background:linear-gradient(135deg,rgba(16,185,129,0.15),rgba(16,185,129,0.06))">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#10b981" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
    </div>
    <div class="ab-step-title">Tools</div>
    <div class="ab-step-status" id="ab-status-4">All enabled</div>
  </div>
  <div class="ab-connector"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="var(--text-3)" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></div>

  <!-- ── STEP 5: Controls ── -->
  <div class="ab-step" id="ab-step-5" onclick="abGoTo(5)">
    <div class="ab-step-num">5</div>
    <div class="ab-step-icon" style="background:linear-gradient(135deg,rgba(244,63,94,0.15),rgba(244,63,94,0.06))">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#f43f5e" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
    </div>
    <div class="ab-step-title">Controls</div>
    <div class="ab-step-status" id="ab-status-5">Defaults</div>
  </div>
  <div class="ab-connector"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="var(--text-3)" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></div>

  <!-- ── STEP 6: Deploy ── -->
  <div class="ab-step" id="ab-step-6" onclick="abGoTo(6)">
    <div class="ab-step-num">6</div>
    <div class="ab-step-icon" style="background:linear-gradient(135deg,rgba(99,102,241,0.15),rgba(99,102,241,0.06))">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#6366f1" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
    </div>
    <div class="ab-step-title">Review & Deploy</div>
    <div class="ab-step-status" id="ab-status-6">Ready</div>
  </div>
</div>

<!-- ═══ STEP PANELS ═══ -->

<!-- ── Panel 1: Prompt ── -->
<div class="ab-panel card animate-fade-up" id="ab-panel-1">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">
    <div style="display:flex;align-items:center;gap:0.75rem">
      <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,rgba(139,92,246,0.15),rgba(139,92,246,0.08));display:flex;align-items:center;justify-content:center">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#8b5cf6" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      </div>
      <div>
        <h3 style="margin:0;font-size:1rem">System Prompt</h3>
        <p style="margin:0.15rem 0 0;color:var(--text-3);font-size:0.78rem">Define agent persona, instructions, and output format. Create new or reuse from library.</p>
      </div>
    </div>
    <div style="display:flex;gap:0.5rem">
      <button class="btn btn-sm" onclick="abPrev()" style="opacity:0.5" disabled>Back</button>
      <button class="btn btn-primary btn-sm" onclick="abNext()">Next: Skills</button>
    </div>
  </div>

  <!-- Reuse from library -->
  <div style="margin-bottom:1rem">
    <label class="field-label" style="display:flex;align-items:center;gap:0.5rem">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/></svg>
      Reuse from Prompt Library
    </label>
    <div style="display:flex;gap:0.5rem;align-items:center">
      <select id="ab-prompt-library" class="input" style="flex:1" onchange="abApplyPromptFromLib()">
        <option value="">-- Write custom or select from library --</option>
      </select>
      <button class="btn btn-sm" onclick="abSavePromptToLib()" title="Save current prompt to library">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
        Save to Library
      </button>
    </div>
  </div>

  <div>
    <label class="field-label">System Prompt <span style="color:var(--text-3);font-weight:400;font-size:0.72rem">Defines agent behavior, persona, and constraints</span></label>
    <textarea id="ab-prompt" class="input" rows="6" placeholder="You are a helpful assistant that...&#10;&#10;Rules:&#10;1. Always cite sources&#10;2. Be concise&#10;3. Ask clarifying questions when needed" style="resize:vertical;font-family:var(--mono);font-size:0.82rem"></textarea>
    <div style="display:flex;justify-content:space-between;margin-top:0.25rem">
      <span style="font-size:0.68rem;color:var(--text-3)" id="ab-prompt-chars">0 chars &middot; ~0 tokens</span>
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap">
        <button class="btn btn-sm" onclick="abInsertTemplate('research')" style="font-size:0.7rem">Research</button>
        <button class="btn btn-sm" onclick="abInsertTemplate('coding')" style="font-size:0.7rem">Coding</button>
        <button class="btn btn-sm" onclick="abInsertTemplate('analysis')" style="font-size:0.7rem">Analysis</button>
        <button class="btn btn-sm" onclick="abInsertTemplate('writing')" style="font-size:0.7rem">Writing</button>
        <button class="btn btn-sm" onclick="abInsertTemplate('customer_support')" style="font-size:0.7rem">Support</button>
        <button class="btn btn-sm" onclick="abInsertTemplate('data_extraction')" style="font-size:0.7rem">Extraction</button>
        <button class="btn btn-sm" onclick="abInsertTemplate('qa')" style="font-size:0.7rem">QA</button>
        <button class="btn btn-sm" onclick="abInsertTemplate('devops')" style="font-size:0.7rem">DevOps</button>
        <button class="btn btn-sm" onclick="abInsertTemplate('legal')" style="font-size:0.7rem">Legal</button>
        <button class="btn btn-sm" onclick="abInsertTemplate('financial')" style="font-size:0.7rem">Finance</button>
        <button class="btn btn-sm" onclick="abInsertTemplate('creative')" style="font-size:0.7rem">Creative</button>
        <button class="btn btn-sm" onclick="abInsertTemplate('translator')" style="font-size:0.7rem">Translator</button>
      </div>
    </div>
  </div>

  <div style="margin-top:1rem">
    <label class="field-label">Agent Constraints <span style="color:var(--text-3);font-weight:400;font-size:0.72rem">Behavioral guardrails that apply to every conversation (comma-separated)</span></label>
    <textarea id="ab-constraints" class="input" rows="3" placeholder="e.g. Always cite sources, Max 500 words per response, Never provide medical advice, Use formal tone" style="resize:vertical;font-family:var(--mono);font-size:0.82rem"></textarea>
    <span style="font-size:0.68rem;color:var(--text-3)">These rules are enforced across all skills and conversations for this agent</span>
  </div>
</div>

<!-- ── Panel 2: Skills ── -->
<div class="ab-panel card animate-fade-up" id="ab-panel-2" style="display:none">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">
    <div style="display:flex;align-items:center;gap:0.75rem">
      <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,rgba(245,158,11,0.15),rgba(245,158,11,0.08));display:flex;align-items:center;justify-content:center">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      </div>
      <div>
        <h3 style="margin:0;font-size:1rem">Skills</h3>
        <p style="margin:0.15rem 0 0;color:var(--text-3);font-size:0.78rem">Attach reusable skill modules that extend agent capabilities with domain-specific behavior.</p>
      </div>
    </div>
    <div style="display:flex;gap:0.5rem">
      <button class="btn btn-sm" onclick="abPrev()">Back</button>
      <button class="btn btn-primary btn-sm" onclick="abNext()">Next: Knowledge Base</button>
    </div>
  </div>

  <div style="display:flex;gap:0.5rem;margin-bottom:0.75rem;align-items:center">
    <input type="text" id="ab-skill-search" class="input" placeholder="Search skills..." oninput="abFilterSkills()" style="flex:1;font-size:0.82rem">
    <span id="ab-skill-count" class="badge" style="font-size:0.72rem">0 selected</span>
  </div>

  <div id="ab-skills-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:0.75rem;max-height:400px;overflow-y:auto;padding:0.25rem">
    <p style="color:var(--text-3);font-size:0.82rem;text-align:center;grid-column:1/-1">Loading skills...</p>
  </div>

  <div style="margin-top:1rem;padding:0.75rem;background:rgba(245,158,11,0.04);border:1px solid rgba(245,158,11,0.12);border-radius:10px;display:flex;align-items:center;gap:0.75rem">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#f59e0b" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <span style="font-size:0.78rem;color:var(--text-3)">Skills are optional. Each skill injects its system prompt and tool bindings into the agent's reasoning loop. <a href="/skills" style="color:#f59e0b">Manage skills library</a></span>
  </div>

  <!-- Inline skill creation -->
  <details style="margin-top:0.75rem">
    <summary style="cursor:pointer;font-size:0.82rem;font-weight:600;color:#f59e0b;user-select:none">+ Create New Skill Inline</summary>
    <div style="margin-top:0.5rem;padding:0.75rem;background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:10px">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem;margin-bottom:0.5rem">
        <div>
          <label class="field-label">Skill Name</label>
          <input type="text" id="ab-new-skill-name" class="input" placeholder="e.g. SQL Expert">
        </div>
        <div>
          <label class="field-label">Description</label>
          <input type="text" id="ab-new-skill-desc" class="input" placeholder="What this skill does">
        </div>
      </div>
      <div>
        <label class="field-label">System Prompt</label>
        <textarea id="ab-new-skill-prompt" class="input" rows="3" placeholder="Skill-specific instructions..." style="resize:vertical;font-size:0.82rem"></textarea>
      </div>
      <button class="btn btn-primary btn-sm" onclick="abCreateSkillInline()" style="margin-top:0.5rem">Create & Attach Skill</button>
    </div>
  </details>

  <!-- ── Skill Workflow ── -->
  <div id="ab-skill-workflow" style="margin-top:1.25rem;display:none">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.5rem">
      <div style="display:flex;align-items:center;gap:0.5rem">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#f59e0b" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>
        <h4 style="margin:0;font-size:0.88rem;color:var(--text-1)">Skill Workflow</h4>
        <span class="badge" style="font-size:0.6rem;background:rgba(245,158,11,0.12);color:#f59e0b">Execution Order</span>
      </div>
      <div style="display:flex;gap:0.35rem;align-items:center">
        <select id="ab-workflow-mode" class="input" onchange="abRenderWorkflow()" style="font-size:0.75rem;padding:0.25rem 0.5rem;width:auto">
          <option value="sequential">Sequential</option>
          <option value="router">Router (LLM decides)</option>
        </select>
      </div>
    </div>
    <p style="font-size:0.72rem;color:var(--text-3);margin:0 0 0.75rem" id="ab-workflow-desc">Skills execute in order. The agent completes each skill's task before moving to the next.</p>

    <!-- Workflow canvas -->
    <div id="ab-workflow-canvas" style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:1rem;min-height:80px;position:relative">
      <!-- Rendered by JS -->
    </div>

    <div style="display:flex;gap:0.75rem;margin-top:0.5rem;flex-wrap:wrap">
      <div style="display:flex;align-items:center;gap:0.3rem;font-size:0.68rem;color:var(--text-3)">
        <div style="width:10px;height:10px;border-radius:3px;background:rgba(245,158,11,0.25);border:1.5px solid #f59e0b"></div> Skill Node
      </div>
      <div style="display:flex;align-items:center;gap:0.3rem;font-size:0.68rem;color:var(--text-3)">
        <svg viewBox="0 0 16 8" width="16" height="8"><line x1="0" y1="4" x2="12" y2="4" stroke="var(--text-3)" stroke-width="1.5"/><polygon points="10,1 16,4 10,7" fill="var(--text-3)"/></svg> Flow Direction
      </div>
      <div style="display:flex;align-items:center;gap:0.3rem;font-size:0.68rem;color:var(--text-3)">
        <svg viewBox="0 0 12 12" width="10" height="10"><circle cx="6" cy="6" r="5" fill="rgba(16,185,129,0.15)" stroke="#10b981" stroke-width="1.5"/></svg> Start
      </div>
      <div style="display:flex;align-items:center;gap:0.3rem;font-size:0.68rem;color:var(--text-3)">
        <svg viewBox="0 0 12 12" width="10" height="10"><rect x="1" y="1" width="10" height="10" rx="2" fill="rgba(244,63,94,0.15)" stroke="#f43f5e" stroke-width="1.5"/></svg> End
      </div>
    </div>
  </div>
</div>

<!-- ── Panel 3: Knowledge Base ── -->
<div class="ab-panel card animate-fade-up" id="ab-panel-3" style="display:none">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">
    <div style="display:flex;align-items:center;gap:0.75rem">
      <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,rgba(6,182,212,0.15),rgba(6,182,212,0.08));display:flex;align-items:center;justify-content:center">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#06b6d4" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
      </div>
      <div>
        <h3 style="margin:0;font-size:1rem">Knowledge Base</h3>
        <p style="margin:0.15rem 0 0;color:var(--text-3);font-size:0.78rem">Select or create the agent's knowledge store. Attach documents, collections, or external sources.</p>
      </div>
    </div>
    <div style="display:flex;gap:0.5rem">
      <button class="btn btn-sm" onclick="abPrev()">Back</button>
      <button class="btn btn-primary btn-sm" onclick="abNext()">Next: Tools</button>
    </div>
  </div>

  <!-- Collection selector -->
  <div style="margin-bottom:1rem">
    <label class="field-label">KB Collection</label>
    <div style="display:flex;gap:0.5rem;align-items:center">
      <select id="ab-kb-collection" class="input" style="flex:1" onchange="abKBChanged()">
        <option value="agentic_docs">agentic_docs (global)</option>
      </select>
