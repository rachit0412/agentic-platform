    analysis: 'You are a data analyst. Analyze information systematically and provide actionable insights.\\n\\nRules:\\n1. Structure your analysis with clear sections\\n2. Use quantitative reasoning when possible\\n3. Highlight key findings and recommendations\\n4. Note any limitations or assumptions',
    writing: 'You are a professional writer. Help users create clear, engaging, and well-structured content.\\n\\nRules:\\n1. Match the tone to the audience\\n2. Use active voice and concise language\\n3. Structure content with headers and bullet points\\n4. Proofread for grammar and clarity',
    customer_support: 'You are a customer support specialist. Handle user inquiries with empathy and efficiency.\\n\\nRules:\\n1. Acknowledge the user\\'s concern before responding\\n2. Provide step-by-step solutions\\n3. Escalate when you cannot resolve an issue\\n4. Follow up to ensure satisfaction\\n5. Never share internal policies or credentials',
    data_extraction: 'You are a data extraction specialist. Extract structured information from unstructured text.\\n\\nRules:\\n1. Return data in JSON format when possible\\n2. Identify entities: names, dates, amounts, locations\\n3. Flag uncertain extractions with confidence scores\\n4. Handle missing data gracefully with null values',
    qa: 'You are a QA engineer. Help test software and identify potential issues.\\n\\nRules:\\n1. Think about edge cases and boundary conditions\\n2. Write clear test case descriptions\\n3. Categorize issues by severity (critical, major, minor)\\n4. Suggest both manual and automated testing approaches\\n5. Consider performance, security, and accessibility',
    devops: 'You are a DevOps engineer. Help with infrastructure, CI/CD, and deployment tasks.\\n\\nRules:\\n1. Prefer Infrastructure as Code (Terraform, ARM, Bicep)\\n2. Follow the principle of least privilege\\n3. Include rollback strategies\\n4. Monitor and alert on key metrics\\n5. Document all configuration changes',
    legal: 'You are a legal document analyst. Help review and summarize legal documents.\\n\\nRules:\\n1. Identify key clauses, obligations, and risks\\n2. Highlight unusual or non-standard terms\\n3. Summarize in plain language\\n4. Always note that this is not legal advice\\n5. Flag items requiring human attorney review',
    financial: 'You are a financial analyst. Help analyze financial data and provide insights.\\n\\nRules:\\n1. Use standard financial metrics (ROI, NPV, IRR)\\n2. Present numbers with appropriate precision\\n3. Compare against industry benchmarks\\n4. Clearly state assumptions\\n5. Include risk factors and sensitivity analysis',
    creative: 'You are a creative writing assistant. Help generate imaginative and original content.\\n\\nRules:\\n1. Be creative but stay on-topic\\n2. Vary sentence structure and vocabulary\\n3. Create vivid imagery and compelling narratives\\n4. Respect content guidelines\\n5. Offer multiple creative directions when asked',
    translator: 'You are a professional translator. Translate text accurately between languages.\\n\\nRules:\\n1. Preserve the original meaning and tone\\n2. Adapt idioms and cultural references appropriately\\n3. Maintain formatting and structure\\n4. Note when direct translation is ambiguous\\n5. Default to formal register unless instructed otherwise'
  };
  document.getElementById('ab-prompt').value = templates[type] || '';
  abUpdatePromptChars();
  abUpdateStatuses();
}

function abUpdatePromptChars() {
  var len = (document.getElementById('ab-prompt').value || '').length;
  var tokens = Math.ceil(len / 4);
  document.getElementById('ab-prompt-chars').textContent = len + ' chars \\u00b7 ~' + tokens + ' tokens';
}
document.getElementById('ab-prompt').addEventListener('input', abUpdatePromptChars);

/* ═══ SKILLS ═══ */
function abRenderSkills() {
  var grid = document.getElementById('ab-skills-grid');
  if (abData.skills.length === 0) {
    grid.innerHTML = '<div style="text-align:center;grid-column:1/-1;padding:2rem"><p style="color:var(--text-3);margin-bottom:0.5rem">No skills created yet</p><a href="/skills" class="btn btn-sm">Create Skills</a></div>';
    return;
  }
  grid.innerHTML = abData.skills.map(function(s) {
    var sel = abData.selectedSkills.indexOf(s.id) >= 0;
    var toolCount = (s.tool_ids || []).length;
    return '<div class="ab-select-card' + (sel ? ' selected' : '') + '" onclick="abToggleSkill(\\'' + s.id + '\\')" data-name="' + escapeHtml(s.name.toLowerCase()) + '">' +
      '<div class="ab-check"></div>' +
      '<div style="flex:1;min-width:0">' +
        '<div style="font-weight:600;font-size:0.82rem;color:var(--text-1)">' + escapeHtml(s.name) + '</div>' +
        '<div style="font-size:0.72rem;color:var(--text-3);margin-top:0.15rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + escapeHtml(s.description || 'No description') + '</div>' +
        '<div style="display:flex;gap:0.35rem;margin-top:0.3rem">' +
          (toolCount > 0 ? '<span class="badge" style="font-size:0.6rem">' + toolCount + ' tools</span>' : '') +
          ((s.constraints||[]).length > 0 ? '<span class="badge" style="font-size:0.6rem">' + (s.constraints||[]).length + ' constraints</span>' : '') +
        '</div>' +
      '</div></div>';
  }).join('');
}

function abToggleSkill(id) {
  var idx = abData.selectedSkills.indexOf(id);
  if (idx >= 0) abData.selectedSkills.splice(idx, 1);
  else abData.selectedSkills.push(id);
  abRenderSkills();
  abUpdateStatuses();
  abUpdateWorkflow();
}

function abFilterSkills() {
  var q = document.getElementById('ab-skill-search').value.toLowerCase();
  var cards = document.querySelectorAll('#ab-skills-grid .ab-select-card');
  cards.forEach(function(c) { c.style.display = c.dataset.name.indexOf(q) >= 0 ? '' : 'none'; });
}

/* ═══ SKILL WORKFLOW ═══ */
var abWorkflowOrder = [];  // ordered skill IDs for sequential mode

function abUpdateWorkflow() {
  var wf = document.getElementById('ab-skill-workflow');
  if (abData.selectedSkills.length < 2) {
    wf.style.display = 'none';
    return;
  }
  wf.style.display = 'block';
  // sync workflow order with selected skills
  abWorkflowOrder = abWorkflowOrder.filter(function(id) { return abData.selectedSkills.indexOf(id) >= 0; });
  abData.selectedSkills.forEach(function(id) {
    if (abWorkflowOrder.indexOf(id) < 0) abWorkflowOrder.push(id);
  });
  abRenderWorkflow();
}

function abRenderWorkflow() {
  var mode = document.getElementById('ab-workflow-mode').value;
  var canvas = document.getElementById('ab-workflow-canvas');
  var desc = document.getElementById('ab-workflow-desc');

  if (mode === 'router') {
    desc.textContent = 'The LLM dynamically selects the best skill for each user request. No fixed execution order.';
    abRenderRouterWorkflow(canvas);
  } else {
    desc.textContent = 'Skills execute in order. Drag to reorder. The agent completes each skill before moving to the next.';
    abRenderSequentialWorkflow(canvas);
  }
}

function abGetSkillById(id) {
  for (var i = 0; i < abData.skills.length; i++) {
    if (abData.skills[i].id === id) return abData.skills[i];
  }
  return null;
}

function abRenderSequentialWorkflow(canvas) {
  var html = '<div style="display:flex;align-items:center;gap:0;flex-wrap:wrap;justify-content:center">';
  // Start node
  html += '<div style="display:flex;flex-direction:column;align-items:center;gap:0.2rem;flex-shrink:0">' +
    '<div style="width:36px;height:36px;border-radius:50%;background:rgba(16,185,129,0.12);border:2px solid #10b981;display:flex;align-items:center;justify-content:center">' +
      '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#10b981" stroke-width="2.5"><polygon points="5 3 19 12 5 21 5 3"/></svg>' +
    '</div>' +
    '<span style="font-size:0.62rem;color:var(--text-3)">Start</span>' +
  '</div>';

  for (var i = 0; i < abWorkflowOrder.length; i++) {
    var s = abGetSkillById(abWorkflowOrder[i]);
    if (!s) continue;
    // Arrow connector
    html += '<div style="display:flex;align-items:center;padding:0 0.25rem;flex-shrink:0">' +
      '<svg viewBox="0 0 32 12" width="32" height="12"><line x1="0" y1="6" x2="26" y2="6" stroke="var(--text-3)" stroke-width="1.5" stroke-dasharray="3,2"/><polygon points="24,2 32,6 24,10" fill="var(--text-3)"/></svg>' +
    '</div>';
    // Skill node
    var toolCount = (s.tool_ids || []).length;
    html += '<div class="ab-wf-node" draggable="true" data-wf-idx="' + i + '" ondragstart="abWfDragStart(event,' + i + ')" ondragover="abWfDragOver(event)" ondrop="abWfDrop(event,' + i + ')" ' +
      'style="display:flex;flex-direction:column;align-items:center;gap:0.2rem;cursor:grab;flex-shrink:0;min-width:90px;max-width:120px">' +
      '<div style="position:relative;width:100%;padding:0.5rem 0.6rem;background:rgba(245,158,11,0.06);border:1.5px solid rgba(245,158,11,0.35);border-radius:10px;text-align:center;transition:border-color 0.2s">' +
        '<div style="position:absolute;top:-8px;left:50%;transform:translateX(-50%);background:var(--bg-1);border:1px solid var(--glass-border);border-radius:50%;width:16px;height:16px;font-size:0.58rem;font-weight:700;display:flex;align-items:center;justify-content:center;color:var(--text-3)">' + (i+1) + '</div>' +
        '<div style="font-size:0.75rem;font-weight:600;color:var(--text-1);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:0.15rem" title="' + escapeHtml(s.name) + '">' + escapeHtml(s.name) + '</div>' +
        (toolCount > 0 ? '<div style="font-size:0.58rem;color:var(--text-3);margin-top:0.1rem">' + toolCount + ' tools</div>' : '') +
      '</div>' +
    '</div>';
  }

  // Arrow + End node
  html += '<div style="display:flex;align-items:center;padding:0 0.25rem;flex-shrink:0">' +
    '<svg viewBox="0 0 32 12" width="32" height="12"><line x1="0" y1="6" x2="26" y2="6" stroke="var(--text-3)" stroke-width="1.5" stroke-dasharray="3,2"/><polygon points="24,2 32,6 24,10" fill="var(--text-3)"/></svg>' +
  '</div>';
  html += '<div style="display:flex;flex-direction:column;align-items:center;gap:0.2rem;flex-shrink:0">' +
    '<div style="width:36px;height:36px;border-radius:8px;background:rgba(244,63,94,0.12);border:2px solid #f43f5e;display:flex;align-items:center;justify-content:center">' +
      '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#f43f5e" stroke-width="2.5"><rect x="6" y="6" width="12" height="12" rx="1"/></svg>' +
    '</div>' +
    '<span style="font-size:0.62rem;color:var(--text-3)">End</span>' +
  '</div>';
  html += '</div>';
  canvas.innerHTML = html;
}

function abRenderRouterWorkflow(canvas) {
  var html = '<div style="display:flex;align-items:flex-start;gap:0;justify-content:center">';
  // LLM router hub
  html += '<div style="display:flex;flex-direction:column;align-items:center;gap:0.2rem;flex-shrink:0">' +
    '<div style="width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,rgba(99,102,241,0.12),rgba(139,92,246,0.12));border:2px solid #6366f1;display:flex;align-items:center;justify-content:center">' +
      '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#6366f1" stroke-width="2"><path d="M12 2a4 4 0 0 0-4 4v2a4 4 0 0 0 8 0V6a4 4 0 0 0-4-4z"/><path d="M6 20v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/></svg>' +
    '</div>' +
    '<span style="font-size:0.68rem;font-weight:600;color:#6366f1">LLM Router</span>' +
    '<span style="font-size:0.58rem;color:var(--text-3)">picks best skill</span>' +
  '</div>';

  // Fan-out lines + skill nodes
  html += '<div style="display:flex;flex-direction:column;gap:0.35rem;margin-left:0.25rem">';
  for (var i = 0; i < abWorkflowOrder.length; i++) {
    var s = abGetSkillById(abWorkflowOrder[i]);
    if (!s) continue;
    var toolCount = (s.tool_ids || []).length;
    html += '<div style="display:flex;align-items:center;gap:0">' +
      '<svg viewBox="0 0 40 12" width="40" height="12"><line x1="0" y1="6" x2="34" y2="6" stroke="var(--text-3)" stroke-width="1" stroke-dasharray="2,2"/><polygon points="32,3 40,6 32,9" fill="var(--text-3)"/></svg>' +
      '<div style="padding:0.35rem 0.65rem;background:rgba(245,158,11,0.06);border:1.5px solid rgba(245,158,11,0.35);border-radius:8px;white-space:nowrap;display:flex;align-items:center;gap:0.4rem">' +
        '<span style="font-size:0.75rem;font-weight:600;color:var(--text-1)">' + escapeHtml(s.name) + '</span>' +
        (toolCount > 0 ? '<span style="font-size:0.58rem;color:var(--text-3)">' + toolCount + ' tools</span>' : '') +
      '</div>' +
    '</div>';
  }
  html += '</div></div>';
  canvas.innerHTML = html;
}

/* Drag-and-drop reorder for sequential */
var _abWfDragIdx = -1;
function abWfDragStart(e, idx) { _abWfDragIdx = idx; e.dataTransfer.effectAllowed = 'move'; }
function abWfDragOver(e) { e.preventDefault(); e.dataTransfer.dropEffect = 'move'; }
function abWfDrop(e, dropIdx) {
  e.preventDefault();
  if (_abWfDragIdx < 0 || _abWfDragIdx === dropIdx) return;
  var item = abWorkflowOrder.splice(_abWfDragIdx, 1)[0];
  abWorkflowOrder.splice(dropIdx, 0, item);
  _abWfDragIdx = -1;
  abRenderWorkflow();
}

/* ═══ TOOLS ═══ */
function abRenderTools() {
  var grid = document.getElementById('ab-tools-grid');
  if (abData.tools.length === 0) {
    grid.innerHTML = '<p style="color:var(--text-3);text-align:center;grid-column:1/-1">No tools found</p>';
    return;
  }
  grid.innerHTML = abData.tools.map(function(t) {
    var id = t.name || t.id;
    var sel = abData.selectedTools.indexOf(id) >= 0;
    var badge = t.type === 'custom' ? '<span class="badge" style="font-size:0.6rem;background:rgba(139,92,246,0.12);color:#8b5cf6">custom</span>' :
                t.type === 'mcp' ? '<span class="badge" style="font-size:0.6rem;background:rgba(6,182,212,0.12);color:#06b6d4">MCP</span>' :
                '<span class="badge" style="font-size:0.6rem">built-in</span>';
    return '<div class="ab-select-card' + (sel ? ' selected' : '') + '" onclick="abToggleTool(\\'' + escapeHtml(id) + '\\')" data-name="' + escapeHtml((t.name||'').toLowerCase()) + '">' +
      '<div class="ab-check"></div>' +
      '<div style="flex:1;min-width:0">' +
        '<div style="display:flex;align-items:center;gap:0.35rem"><span style="font-weight:600;font-size:0.82rem;color:var(--text-1)">' + escapeHtml(t.name||t.id) + '</span>' + badge + '</div>' +
        '<div style="font-size:0.72rem;color:var(--text-3);margin-top:0.15rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + escapeHtml(t.description || '-') + '</div>' +
      '</div></div>';
  }).join('');
}

function abToggleTool(id) {
  var idx = abData.selectedTools.indexOf(id);
  if (idx >= 0) abData.selectedTools.splice(idx, 1);
  else abData.selectedTools.push(id);
  abRenderTools();
  abUpdateStatuses();
}

function abSelectAllTools() {
  abData.selectedTools = abData.tools.map(function(t) { return t.name || t.id; });
  abRenderTools();
  abUpdateStatuses();
}

function abDeselectAllTools() {
  abData.selectedTools = [];
  abRenderTools();
  abUpdateStatuses();
}

function abFilterTools() {
  var q = document.getElementById('ab-tool-search').value.toLowerCase();
  var cards = document.querySelectorAll('#ab-tools-grid .ab-select-card');
  cards.forEach(function(c) { c.style.display = c.dataset.name.indexOf(q) >= 0 ? '' : 'none'; });
}

/* ═══ KNOWLEDGE BASE ═══ */
function abGetAgentCollectionName() {
  var name = (document.getElementById('ab-name').value || '').trim().toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, '');
  return name ? 'agent_' + name + '_kb' : '';
}

function abRenderCollections() {
  var sel = document.getElementById('ab-kb-collection');
  var agentCol = abGetAgentCollectionName();
  sel.innerHTML = '';
  if (agentCol) {
    var opt = document.createElement('option');
    opt.value = agentCol;
    opt.textContent = agentCol + ' (this agent)';
    sel.appendChild(opt);
  }
  var globalOpt = document.createElement('option');
  globalOpt.value = 'agentic_docs';
  globalOpt.textContent = 'agentic_docs (global)';
  sel.appendChild(globalOpt);
  abData.collections.forEach(function(c) {
    var name = typeof c === 'string' ? c : c.name;
    if (name === 'agentic_docs') return;
    if (name === agentCol) return;
    var opt = document.createElement('option');
    opt.value = name;
    opt.textContent = name;
    sel.appendChild(opt);
  });
  if (agentCol) sel.value = agentCol;
  abLoadKBDocs();
}

function abKBChanged() {
  abLoadKBDocs();
  abUpdateStatuses();
}

function abToggleNewKB() {
  var inp = document.getElementById('ab-kb-new');
  var btn = document.getElementById('ab-kb-new-btn');
  if (inp.style.display === 'none') {
    inp.style.display = '';
    btn.textContent = 'Use Existing';
  } else {
    inp.style.display = 'none';
    btn.textContent = '+ New';
    inp.value = '';
  }
}

function abLoadKBDocs() {
  var col = document.getElementById('ab-kb-collection').value || 'agentic_docs';
  fetch('/api/documents?collection=' + encodeURIComponent(col)).then(function(r){return r.json()}).then(function(d) {
    var docs = d.documents || d || [];
    var el = document.getElementById('ab-kb-doc-list');
    if (docs.length === 0) {
      el.innerHTML = '<p style="color:var(--text-3);font-size:0.78rem;text-align:center;padding:1rem">No documents in this collection. Upload some via the Upload tab.</p>';
      return;
    }
    el.innerHTML = docs.map(function(doc) {
      return '<div style="display:flex;align-items:center;justify-content:space-between;padding:0.4rem 0.5rem;border-bottom:1px solid var(--glass-border)">' +
        '<div style="display:flex;align-items:center;gap:0.5rem">' +
          '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#06b6d4" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>' +
          '<span style="font-size:0.82rem;color:var(--text-1)">' + escapeHtml(doc.source || doc.name || '-') + '</span>' +
        '</div>' +
        '<span class="badge" style="font-size:0.65rem">' + (doc.chunks || doc.chunk_count || '?') + ' chunks</span>' +
      '</div>';
    }).join('');
  }).catch(function() {
    document.getElementById('ab-kb-doc-list').innerHTML = '<p style="color:var(--text-3);font-size:0.78rem;text-align:center">Could not load documents</p>';
  });
}

function abKBTab(tab) {
  var tabs = ['docs', 'upload', 'connectors'];
  tabs.forEach(function(t) {
    document.getElementById('ab-kb-panel-' + t).style.display = t === tab ? '' : 'none';
    document.getElementById('ab-kb-tab-' + t).classList.toggle('active', t === tab);
  });
}

function abKBFileSelect(input) {
  document.getElementById('ab-kb-filename').textContent = input.files[0] ? input.files[0].name : 'No file selected';
  if (input.files[0]) {
    var reader = new FileReader();
    reader.onload = function(e) { document.getElementById('ab-kb-text').value = e.target.result; };
    reader.readAsText(input.files[0]);
    if (!document.getElementById('ab-kb-source').value) {
      document.getElementById('ab-kb-source').value = input.files[0].name;
    }
  }
}

function abUploadDoc() {
  var text = document.getElementById('ab-kb-text').value.trim();
  var source = document.getElementById('ab-kb-source').value.trim() || 'uploaded-doc';
  var newCol = document.getElementById('ab-kb-new').value.trim();
  var agentCol = abGetAgentCollectionName();
  var collection = newCol || document.getElementById('ab-kb-collection').value || agentCol || 'agentic_docs';
  if (!text) { alert('Provide text content or select a file'); return; }

  fetch('/api/documents/ingest', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({ text: text, source: source, collection: collection })
  }).then(function(r){return r.json()}).then(function(d) {
    document.getElementById('ab-kb-upload-result').innerHTML = '<span style="color:#10b981">Uploaded ' + source + ' to ' + collection + '</span>';
    document.getElementById('ab-kb-text').value = '';
    document.getElementById('ab-kb-source').value = '';
    if (newCol && abData.collections.indexOf(newCol) < 0) {
      abData.collections.push(newCol);
      abRenderCollections();
      document.getElementById('ab-kb-collection').value = newCol;
    }
    abLoadKBDocs();
  }).catch(function(e) {
    document.getElementById('ab-kb-upload-result').innerHTML = '<span style="color:#f43f5e">Upload failed: ' + e.message + '</span>';
  });
}

/* ═══ MCP ═══ */
function abRenderMCP() {
  var el = document.getElementById('ab-mcp-list');
  if (abData.mcpServers.length === 0) {
    el.innerHTML = '<p style="color:var(--text-3);font-size:0.78rem">No MCP servers registered. <a href="/mcp" style="color:#8b5cf6">Add one</a></p>';
    return;
  }
  el.innerHTML = abData.mcpServers.map(function(s) {
    var statusColor = s.status === 'connected' ? '#10b981' : '#f59e0b';
    var toolCount = (s.tools || []).length;
    return '<div style="display:flex;align-items:center;justify-content:space-between;padding:0.35rem 0">' +
      '<div style="display:flex;align-items:center;gap:0.4rem">' +
        '<span style="width:6px;height:6px;border-radius:50%;background:' + statusColor + '"></span>' +
        '<span style="font-size:0.78rem;color:var(--text-1)">' + escapeHtml(s.name) + '</span>' +
      '</div>' +
      '<span class="badge" style="font-size:0.6rem">' + toolCount + ' tools</span>' +
    '</div>';
  }).join('');
}

/* ═══ GUARDRAILS ═══ */
function abRenderGuardrails() {
  var el = document.getElementById('ab-guardrails-list');
  if (abData.guardrails.length === 0) {
    el.innerHTML = '<p style="color:var(--text-3);font-size:0.78rem">No guardrails configured. <a href="/guardrails" style="color:#f43f5e">Set up guardrails</a></p>';
