  modelSel.innerHTML = list.map(function(m) { return '<option value="' + m + '">' + m + '</option>'; }).join('');
}

/* ═══ REVIEW ═══ */
function abBuildReview() {
  var cfg = abGetConfig();
  var summary = document.getElementById('ab-review-summary');

  // Validation checks
  var warnings = [];
  if (!cfg.name || cfg.name === 'Untitled Agent') warnings.push('Agent name not set');
  if (!cfg.system_prompt) warnings.push('No system prompt defined');
  if (cfg.system_prompt && cfg.system_prompt.length < 20) warnings.push('System prompt is very short');
  if (cfg.temperature > 1.5) warnings.push('Very high temperature may produce incoherent output');
  if (cfg.max_iterations > 10) warnings.push('High iteration count may increase latency and cost');

  var validationHtml = '';
  if (warnings.length > 0) {
    validationHtml = '<div style="grid-column:1/-1;padding:0.6rem 0.75rem;background:rgba(245,158,11,0.06);border:1px solid rgba(245,158,11,0.2);border-radius:10px;margin-bottom:0.25rem">' +
      '<div style="display:flex;align-items:center;gap:0.4rem;margin-bottom:0.35rem"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg><strong style="font-size:0.78rem;color:#f59e0b">Validation Warnings</strong></div>' +
      warnings.map(function(w) { return '<div style="font-size:0.75rem;color:var(--text-3);padding-left:1.1rem">\\u2022 ' + w + '</div>'; }).join('') +
    '</div>';
  }

  var summaryCards = [
    { label: 'Agent', value: cfg.name || '(unnamed)', color: '#6366f1', icon: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6" rx="1"/></svg>' },
    { label: 'Model', value: cfg.provider + '/' + cfg.model, color: '#f43f5e', icon: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/></svg>' },
    { label: 'Prompt', value: cfg.system_prompt ? cfg.system_prompt.length + ' chars' : 'None', color: '#8b5cf6', icon: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>' },
    { label: 'Skills', value: cfg.skill_ids.length + ' attached', color: '#f59e0b', icon: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>' },
    { label: 'Tools', value: cfg.tool_ids.length === 0 ? 'All (' + abData.tools.length + ')' : cfg.tool_ids.length + ' selected', color: '#10b981', icon: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>' },
    { label: 'Knowledge Base', value: cfg.kb_collection, color: '#06b6d4', icon: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>' },
    { label: 'Workflow', value: cfg.skill_ids.length >= 2 ? (cfg.workflow_mode === 'router' ? 'Router' : 'Sequential') : 'N/A', color: '#f59e0b', icon: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4"/></svg>' }
  ].map(function(item) {
    return '<div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:12px;padding:0.75rem;display:flex;align-items:center;gap:0.6rem">' +
      '<div style="width:32px;height:32px;border-radius:8px;background:linear-gradient(135deg,' + item.color + '22,' + item.color + '08);display:flex;align-items:center;justify-content:center;color:' + item.color + '">' + item.icon + '</div>' +
      '<div><div style="font-size:0.68rem;color:var(--text-3);text-transform:uppercase">' + item.label + '</div><div style="font-size:0.88rem;font-weight:600;color:var(--text-1)">' + escapeHtml(item.value) + '</div></div>' +
    '</div>';
  }).join('');

  summary.innerHTML = validationHtml + summaryCards;

  document.getElementById('ab-review-json').textContent = JSON.stringify(cfg, null, 2);
}

function abGetConfig() {
  var newCol = document.getElementById('ab-kb-new').value.trim();
  var name = document.getElementById('ab-name').value.trim();
  var subAgentIds = [];
  document.querySelectorAll('#ab-sub-agents-list input[type=checkbox]:checked').forEach(function(cb) {
    subAgentIds.push(cb.value);
  });
  return {
    name: name || 'Untitled Agent',
    description: document.getElementById('ab-desc').value.trim(),
    system_prompt: document.getElementById('ab-prompt').value.trim(),
    provider: document.getElementById('ab-provider').value,
    model: document.getElementById('ab-model').value,
    temperature: parseFloat(document.getElementById('ab-temperature').value) || 0.7,
    top_p: parseFloat(document.getElementById('ab-top-p').value) || 1,
    max_tokens: parseInt(document.getElementById('ab-max-tokens').value) || 4096,
    timeout: parseInt(document.getElementById('ab-timeout').value) || 120,
    response_format: document.getElementById('ab-response-format').value || 'text',
    skill_ids: abData.selectedSkills.slice(),
    tool_ids: abData.selectedTools.slice(),
    sub_agent_ids: subAgentIds,
    constraints: document.getElementById('ab-constraints').value.split(',').map(function(s){return s.trim()}).filter(Boolean),
    kb_collection: newCol || document.getElementById('ab-kb-collection').value || abGetAgentCollectionName() || 'agentic_docs',
    max_iterations: parseInt(document.getElementById('ab-max-iter').value) || 5,
    memory_enabled: document.getElementById('ab-memory').value === '1',
    memory_window: parseInt(document.getElementById('ab-memory-window').value) || 5,
    workflow_mode: (document.getElementById('ab-workflow-mode') || {}).value || 'sequential',
    workflow_order: abWorkflowOrder.slice()
  };
}

function abCopyConfig() {
  var text = document.getElementById('ab-review-json').textContent;
  navigator.clipboard.writeText(text).then(function() { showToast('Copied!', 'success'); });
}

/* ═══ INLINE SKILL CREATION ═══ */
async function abCreateSkillInline() {
  var name = (document.getElementById('ab-new-skill-name').value || '').trim();
  var desc = (document.getElementById('ab-new-skill-desc').value || '').trim();
  var prompt = (document.getElementById('ab-new-skill-prompt').value || '').trim();
  if (!name) { showToast('Skill name is required', 'error'); return; }
  if (!prompt) { showToast('Skill system prompt is required', 'error'); return; }
  try {
    var r = await fetch('/api/skills', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ name: name, description: desc, system_prompt: prompt })
    });
    if (!r.ok) { showToast('Failed to create skill: ' + r.statusText, 'error'); return; }
    var d = await r.json();
    var skill = d.skill || d;
    abData.skills.push(skill);
    abData.selectedSkills.push(skill.id);
    abRenderSkills();
    abUpdateStatuses();
    abUpdateWorkflow();
    document.getElementById('ab-new-skill-name').value = '';
    document.getElementById('ab-new-skill-desc').value = '';
    document.getElementById('ab-new-skill-prompt').value = '';
    showToast('Skill "' + name + '" created and attached!', 'success');
  } catch(e) { showToast('Error: ' + e.message, 'error'); }
}

/* ═══ QUICK TEST ═══ */
async function abQuickTest() {
  var input = document.getElementById('ab-test-input').value.trim();
  if (!input) { showToast('Type a test message first', 'error'); return; }
  var btn = document.getElementById('ab-test-btn');
  var result = document.getElementById('ab-test-result');
  btn.disabled = true;
  btn.textContent = 'Testing...';
  result.style.display = 'block';
  result.textContent = 'Sending to agent...';

  var cfg = abGetConfig();
  try {
    var r = await fetch('/api/agent-run', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        prompt: input,
        session_id: 'ab-test-' + Date.now(),
        provider: cfg.provider,
        model: cfg.model,
        system_prompt: cfg.system_prompt,
        temperature: cfg.temperature,
        agent_id: abEditingId || undefined
      })
    });
    var d = await r.json();
    result.textContent = d.response || d.output || JSON.stringify(d, null, 2);
  } catch(e) {
    result.textContent = 'Error: ' + e.message;
  }
  btn.disabled = false;
  btn.textContent = 'Test';
}

/* ═══ DEPLOY ═══ */
async function abDeploy() {
  var cfg = abGetConfig();
  if (!cfg.name || cfg.name === 'Untitled Agent') {
    alert('Please provide an agent name in Step 1');
    abGoTo(1);
    return;
  }

  var btn = document.getElementById('ab-deploy-btn');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner"></span> ' + (abEditingId ? 'Updating...' : 'Creating...');

  try {
    var url = abEditingId ? '/api/agents/' + abEditingId : '/api/agents';
    var method = abEditingId ? 'PUT' : 'POST';
    var res = await fetch(url, {
      method: method,
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify(cfg)
    });
    var data = await res.json();

    if (res.ok) {
      var agentId = data.id || (data.agent && data.agent.id) || abEditingId;
      document.getElementById('ab-deploy-result').innerHTML =
        '<div style="padding:1rem;background:rgba(16,185,129,0.06);border:1px solid rgba(16,185,129,0.2);border-radius:12px;display:flex;align-items:center;gap:1rem">' +
          '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#10b981" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>' +
          '<div>' +
            '<strong style="color:#10b981;font-size:0.92rem">Agent ' + (abEditingId ? 'Updated' : 'Created') + ' Successfully!</strong>' +
            '<div style="font-size:0.78rem;color:var(--text-3);margin-top:0.25rem">ID: ' + escapeHtml(agentId || '-') + '</div>' +
            '<div style="display:flex;gap:0.5rem;margin-top:0.5rem">' +
              '<a href="/run-agent" class="btn btn-primary btn-sm">Run Agent</a>' +
              '<a href="/agents" class="btn btn-secondary btn-sm">View Registry</a>' +
            '</div>' +
          '</div>' +
        '</div>';

      // Refresh agent list
      var agentsRes = await fetch('/api/agents').then(function(r){return r.json()});
      abData.agents = agentsRes.agents || agentsRes || [];
      abRenderAgentSelector();
      if (!abEditingId && agentId) {
        abEditingId = agentId;
        document.getElementById('ab-load-agent').value = agentId;
      }
    } else {
      document.getElementById('ab-deploy-result').innerHTML =
        '<div style="padding:0.75rem;background:rgba(244,63,94,0.06);border:1px solid rgba(244,63,94,0.2);border-radius:10px;color:#f43f5e;font-size:0.82rem">' +
          'Error: ' + escapeHtml(data.detail || data.error || JSON.stringify(data)) +
        '</div>';
    }
  } catch(e) {
    document.getElementById('ab-deploy-result').innerHTML =
      '<div style="padding:0.75rem;background:rgba(244,63,94,0.06);border:1px solid rgba(244,63,94,0.2);border-radius:10px;color:#f43f5e;font-size:0.82rem">' +
        'Error: ' + escapeHtml(e.message) +
      '</div>';
  }

  btn.disabled = false;
  abUpdateStatuses();
}

abInit();
<\/script>
