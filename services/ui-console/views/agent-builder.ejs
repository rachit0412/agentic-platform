  }
  el.innerHTML = abData.guardrails.map(function(g) {
    var checked = g.enabled ? ' checked' : '';
    var sevColor = g.severity === 'high' ? '#f43f5e' : g.severity === 'medium' ? '#f59e0b' : '#10b981';
