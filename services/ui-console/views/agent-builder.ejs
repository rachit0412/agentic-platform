    var typeIcon = g.type === 'input' ? '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="' + sevColor + '" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>'
      : g.type === 'output' ? '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="' + sevColor + '" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>'
      : '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="' + sevColor + '" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>';
    return '<div style="display:flex;align-items:center;gap:0.6rem;padding:0.5rem 0.65rem;background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:10px;transition:all 0.2s">' +
      '<input type="checkbox" data-gid="' + g.id + '"' + checked + ' style="accent-color:' + sevColor + ';width:16px;height:16px;flex-shrink:0">' +
      '<div style="flex:1;min-width:0">' +
        '<div style="display:flex;align-items:center;gap:0.35rem">' +
          '<span style="font-size:0.82rem;font-weight:600;color:var(--text-1)">' + escapeHtml(g.name) + '</span>' +
        '</div>' +
        '<div style="font-size:0.68rem;color:var(--text-3);margin-top:0.1rem">' + escapeHtml(g.description || g.type || 'Safety control') + '</div>' +
      '</div>' +
      '<div style="display:flex;flex-direction:column;align-items:flex-end;gap:0.2rem;flex-shrink:0">' +
        '<span style="display:inline-flex;align-items:center;gap:0.2rem;padding:0.15rem 0.4rem;border-radius:6px;font-size:0.62rem;font-weight:600;background:' + sevBg + ';color:' + sevColor + ';text-transform:uppercase">' + typeIcon + ' ' + (g.severity||'medium') + '</span>' +
        '<span style="font-size:0.6rem;color:var(--text-3)">' + (g.type||'input/output') + '</span>' +
      '</div>' +
    '</div>';
  }).join('');
}

/* ═══ AGENT SELECTOR ═══ */
function abRenderSubAgents() {
  var el = document.getElementById('ab-sub-agents-list');
  var agents = abData.agents || [];
  var currentName = (document.getElementById('ab-name').value || '').trim().toLowerCase();
  var available = agents.filter(function(a) { return a.name.toLowerCase() !== currentName; });
  if (available.length === 0) {
    el.innerHTML = '<p style="color:var(--text-3);font-size:0.78rem">No other agents available. Create agents first, then assign them as sub-agents.</p>';
    return;
  }
  el.innerHTML = available.map(function(a) {
    var checked = (abData.selectedSubAgents || []).indexOf(a.id) >= 0 ? ' checked' : '';
    return '<div style="display:flex;align-items:center;gap:0.6rem;padding:0.4rem 0.65rem;background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:10px">' +
      '<input type="checkbox" value="' + a.id + '"' + checked + ' onchange="abSubAgentToggle(this)" style="accent-color:#6366f1;width:16px;height:16px;flex-shrink:0">' +
      '<div style="flex:1;min-width:0">' +
        '<div style="font-size:0.82rem;font-weight:600;color:var(--text-1)">' + escapeHtml(a.name) + '</div>' +
        '<div style="font-size:0.68rem;color:var(--text-3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">' + escapeHtml(a.description || 'No description') + '</div>' +
      '</div>' +
    '</div>';
  }).join('');
}
function abSubAgentToggle(cb) {
  if (!abData.selectedSubAgents) abData.selectedSubAgents = [];
  if (cb.checked) {
    if (abData.selectedSubAgents.indexOf(cb.value) < 0) abData.selectedSubAgents.push(cb.value);
  } else {
    abData.selectedSubAgents = abData.selectedSubAgents.filter(function(id) { return id !== cb.value; });
  }
  abUpdateStatuses();
}

function abRenderAgentSelector() {
  var sel = document.getElementById('ab-load-agent');
  sel.innerHTML = '<option value="">New Agent</option>';
  abData.agents.forEach(function(a) {
    var opt = document.createElement('option');
    opt.value = a.id;
    opt.textContent = a.name + (a.is_default ? ' (default)' : '');
    sel.appendChild(opt);
  });
}

function abLoadExisting() {
  var id = document.getElementById('ab-load-agent').value;
  if (!id) { abReset(); return; }
  var agent = abData.agents.find(function(a) { return a.id === id; });
  if (!agent) return;

  abEditingId = id;
  document.getElementById('ab-name').value = agent.name || '';
  document.getElementById('ab-desc').value = agent.description || '';
  document.getElementById('ab-prompt').value = agent.system_prompt || '';
  abUpdatePromptChars();
  document.getElementById('ab-constraints').value = (agent.constraints || []).join(', ');

  abData.selectedSkills = (agent.skill_ids || []).slice();
  abData.selectedTools = (agent.tool_ids || []).slice();
  abData.selectedSubAgents = (agent.sub_agent_ids || []).slice();

  document.getElementById('ab-provider').value = agent.provider || 'azure-foundry';
  abProviderChanged();
  document.getElementById('ab-model').value = agent.model || 'gpt-5-nano';
  document.getElementById('ab-temperature').value = agent.temperature || 0.7;
  document.getElementById('ab-temp-val').textContent = agent.temperature || 0.7;
  document.getElementById('ab-top-p').value = agent.top_p != null ? agent.top_p : 1;
  document.getElementById('ab-topp-val').textContent = agent.top_p != null ? agent.top_p : 1;
  document.getElementById('ab-max-iter').value = agent.max_iterations || 5;
  document.getElementById('ab-memory').value = agent.memory_enabled ? '1' : '0';
  document.getElementById('ab-max-tokens').value = agent.max_tokens || 4096;
  document.getElementById('ab-timeout').value = agent.timeout || 120;
  document.getElementById('ab-response-format').value = agent.response_format || 'text';
  document.getElementById('ab-memory-window').value = agent.memory_window || 5;

  // Workflow
  if (agent.workflow_mode) {
    document.getElementById('ab-workflow-mode').value = agent.workflow_mode;
  }
  if (agent.workflow_order && agent.workflow_order.length) {
    abWorkflowOrder = agent.workflow_order.slice();
  }

  // KB collection
  if (agent.kb_collection) {
    var kbSel = document.getElementById('ab-kb-collection');
    var found = false;
    for (var i = 0; i < kbSel.options.length; i++) {
      if (kbSel.options[i].value === agent.kb_collection) { found = true; break; }
    }
    if (!found) {
      var opt = document.createElement('option');
      opt.value = agent.kb_collection;
      opt.textContent = agent.kb_collection;
      kbSel.appendChild(opt);
    }
    kbSel.value = agent.kb_collection;
    abLoadKBDocs();
  }

  abRenderSkills();
  abRenderTools();
  abRenderSubAgents();
  abUpdateStatuses();
  abUpdateWorkflow();
  abGoTo(1);
}

function abReset() {
  abEditingId = '';
  document.getElementById('ab-load-agent').value = '';
  document.getElementById('ab-name').value = '';
  document.getElementById('ab-desc').value = '';
  document.getElementById('ab-prompt').value = '';
  document.getElementById('ab-prompt-library').value = '';
  document.getElementById('ab-constraints').value = '';
  abUpdatePromptChars();
  abData.selectedSkills = [];
  abData.selectedTools = [];
  abData.selectedSubAgents = [];
  document.getElementById('ab-provider').value = 'azure-foundry';
  abProviderChanged();
  document.getElementById('ab-model').value = 'gpt-5-nano';
  document.getElementById('ab-temperature').value = 0.7;
  document.getElementById('ab-temp-val').textContent = '0.7';
  document.getElementById('ab-top-p').value = 1;
  document.getElementById('ab-topp-val').textContent = '1';
  document.getElementById('ab-max-iter').value = 5;
  document.getElementById('ab-memory').value = '1';
  document.getElementById('ab-max-tokens').value = 4096;
  document.getElementById('ab-timeout').value = 120;
  document.getElementById('ab-response-format').value = 'text';
  document.getElementById('ab-memory-window').value = 5;
  document.getElementById('ab-kb-collection').value = 'agentic_docs';
  document.getElementById('ab-workflow-mode').value = 'sequential';
  abWorkflowOrder = [];
  document.getElementById('ab-deploy-result').innerHTML = '';
  document.getElementById('ab-test-input').value = '';
  document.getElementById('ab-test-result').style.display = 'none';
  document.getElementById('ab-test-result').textContent = '';
  abRenderSkills();
  abRenderTools();
  abRenderSubAgents();
  abLoadKBDocs();
  abUpdateStatuses();
  abUpdateWorkflow();
  abGoTo(1);
}

/* ═══ PROVIDER / MODEL ═══ */
function abProviderChanged() {
  var prov = document.getElementById('ab-provider').value;
  var modelSel = document.getElementById('ab-model');
  var models = {
    'azure-foundry': ['gpt-5-nano','gpt-5.4-mini','gpt-4.1-mini','gpt-4o'],
    'azure-openai': ['gpt-4o','gpt-4o-mini','gpt-4','gpt-35-turbo'],
