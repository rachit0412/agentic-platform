          <div style="width:28px;height:28px;border-radius:8px;background:rgba(245,158,11,0.12);display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#f59e0b" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          </div>
          <span style="font-size:0.78rem;font-weight:600;color:#f59e0b">Control Logic</span>
          <span style="font-size:0.72rem;color:var(--text-3)">ReAct / planning</span>
