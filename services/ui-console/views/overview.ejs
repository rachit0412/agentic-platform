<!-- Get Started -->
<div class="card animate-fade-up" style="margin-bottom:1.5rem;border:1px solid rgba(6,182,212,0.15);background:linear-gradient(135deg, rgba(6,182,212,0.03), rgba(124,58,237,0.03))">
  <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1rem">
    <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,rgba(6,182,212,0.15),rgba(124,58,237,0.1));display:flex;align-items:center;justify-content:center">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#06b6d4" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
    </div>
    <div>
      <h3 style="margin:0;font-size:1.05rem">Get Started — Build Your First Agentic AI App</h3>
      <p style="margin:0;color:var(--text-3);font-size:0.78rem">Follow these steps to go from zero to a working AI agent</p>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr;gap:0">

    <!-- Step 1 -->
    <a href="/prompts" class="get-started-step" style="display:flex;gap:1rem;padding:1rem;border-radius:12px;text-decoration:none;color:inherit;transition:background 0.2s;border-bottom:1px solid var(--glass-border)">
      <div style="flex-shrink:0;width:32px;height:32px;border-radius:50%;background:rgba(167,139,250,0.12);color:#a78bfa;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.82rem">1</div>
      <div>
        <strong style="font-size:0.88rem;color:var(--text-1)">Create Prompts</strong>
        <span class="badge" style="margin-left:0.5rem;font-size:0.65rem;vertical-align:middle">Prompts</span>
        <p style="margin:0.25rem 0 0;color:var(--text-3);font-size:0.8rem;line-height:1.5">Write system prompts that define agent behavior and persona. Templates, variables, and version control built in. e.g. "You are a research analyst that always cites sources."</p>
      </div>
    </a>

    <!-- Step 2 -->
    <a href="/skills" class="get-started-step" style="display:flex;gap:1rem;padding:1rem;border-radius:12px;text-decoration:none;color:inherit;transition:background 0.2s;border-bottom:1px solid var(--glass-border)">
      <div style="flex-shrink:0;width:32px;height:32px;border-radius:50%;background:rgba(245,158,11,0.12);color:#f59e0b;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.82rem">2</div>
      <div>
        <strong style="font-size:0.88rem;color:var(--text-1)">Define Skills</strong>
        <span class="badge" style="margin-left:0.5rem;font-size:0.65rem;vertical-align:middle">Skills</span>
        <p style="margin:0.25rem 0 0;color:var(--text-3);font-size:0.8rem;line-height:1.5">Package capabilities — a prompt, tools, and constraints into a reusable skill. Think: intelligent functions. e.g. "Code Reviewer", "Data Extractor", "Summarizer".</p>
      </div>
    </a>

    <!-- Step 3 -->
    <a href="/documents" class="get-started-step" style="display:flex;gap:1rem;padding:1rem;border-radius:12px;text-decoration:none;color:inherit;transition:background 0.2s;border-bottom:1px solid var(--glass-border)">
      <div style="flex-shrink:0;width:32px;height:32px;border-radius:50%;background:rgba(16,185,129,0.12);color:#10b981;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.82rem">3</div>
      <div>
        <strong style="font-size:0.88rem;color:var(--text-1)">Feed Knowledge</strong>
        <span class="badge" style="margin-left:0.5rem;font-size:0.65rem;vertical-align:middle">Knowledge</span>
        <p style="margin:0.25rem 0 0;color:var(--text-3);font-size:0.8rem;line-height:1.5">Upload documents, import URLs, or paste text → content is <strong style="color:#10b981">chunked → embedded (nomic-embed-text) → stored in ChromaDB</strong>. Your agent retrieves relevant context via vector similarity search at runtime.</p>
