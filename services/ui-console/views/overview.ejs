      <div style="display:flex;align-items:center;gap:0.3rem"><svg width="18" height="8" viewBox="0 0 18 8"><path d="M1 4 C5 1, 13 7, 17 4" fill="none" stroke="#06b6d4" stroke-width="1.5" stroke-linecap="round"/></svg> Data flow</div>
      <div style="display:flex;align-items:center;gap:0.3rem"><svg width="18" height="8" viewBox="0 0 18 8"><path d="M1 4 C5 1, 13 7, 17 4" fill="none" stroke="#f59e0b" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="3 3"/></svg> Async</div>
      <span style="opacity:0.7">16 containers &middot; 5 layers</span>
    </div>
  </div>

  <script>
  var topoAnimate = true;
  var TOPO_TIPS = {
    user:      { t:'User / Webhook', d:'Entry point — browser UI, REST API, or n8n webhook trigger.', m:'HTTP / SSE' },
    ui:        { t:'UI Console', d:'Express.js + EJS platform dashboard. 25 pages, 115+ API proxy routes to agent-service.', m:'Port 3000' },
    n8nproxy:  { t:'n8n Proxy', d:'Nginx reverse proxy for embedding n8n inside the platform dashboard via iframe.', m:'Port 5679' },
    agent:     { t:'Agent Service', d:'Core runtime — FastAPI + LangGraph ReAct loop. 107+ REST endpoints, agent/skill/A2A/MCP registry, RAG pipeline, guardrails.', m:'Port 8010' },
    tools:     { t:'Tools Service', d:'Sandboxed tool execution — 31 endpoints: web search, code execute, HTTP fetch, file I/O, text transforms, JSON/CSV/YAML ops, regex, hashing, and more.', m:'Port 8011' },
    ollama:    { t:'Ollama', d:'Local LLM inference server. Runs Llama 3, Mistral, and other open models. Runtime-switchable.', m:'Port 11436' },
    chroma:    { t:'ChromaDB', d:'Vector store for embeddings and RAG retrieval. Stores document chunks for semantic search.', m:'Port 8200' },
    sqlite:    { t:'SQLite', d:'Embedded platform database — conversations, memory (STM/LTM), agent configs, skills, guardrails, custom tools, audit log. 16 tables.', m:'Embedded file' },
    postgres:  { t:'PostgreSQL (Datastore)', d:'Document registry with JSONB columns. Stores ingestion metadata, connector configs, structured data.', m:'Port 5433' },
    n8n:       { t:'n8n Workflow Engine', d:'Visual workflow automation — scheduled agent runs, webhook triggers, multi-step pipelines, RAG ingest.', m:'Port 5678' },
    otel:      { t:'OTel Collector', d:'OpenTelemetry Collector — receives OTLP traces from agent-service, routes metrics to Prometheus and logs to Loki.', m:'Port 4317/4318' },
    langfuse:  { t:'Langfuse', d:'LLM observability — trace viewer, cost tracking, latency analysis. Captures every LLM call with full context.', m:'Port 3014' },
    langfusedb:{ t:'Langfuse DB', d:'PostgreSQL backend for Langfuse. Stores LLM traces, sessions, and evaluation data.', m:'Internal' },
    openmcp:   { t:'Open Tools MCP', d:'Pre-configured MCP server — Wikipedia search, weather lookup, dictionary. Zero API keys needed.', m:'Internal :8080' },
    bravemcp:  { t:'Brave Search MCP', d:'Web search via Brave Search API. Requires BRAVE_API_KEY in .env to activate.', m:'Internal :8080' },
    prometheus:{ t:'Prometheus', d:'Time-series metrics store. Scrapes agent-service and OTel Collector for request counts, latencies, errors.', m:'Port 9090' },
    grafana:   { t:'Grafana', d:'Dashboards and visualization. Pre-configured with platform health dashboard, Prometheus and Loki datasources.', m:'Port 3003' },
    loki:      { t:'Loki', d:'Log aggregation system. Receives structured logs from OTel Collector. Queryable from Grafana.', m:'Port 3100' }
  };

  // Draw connections
  function topoDrawLines() {
    var svg = document.getElementById('topoSvg');
    var canvas = document.getElementById('topoCanvas');
    if (!svg || !canvas) return;
    var cr = canvas.getBoundingClientRect();
    svg.setAttribute('viewBox', '0 0 ' + cr.width + ' ' + cr.height);

    var nodes = {};
    canvas.querySelectorAll('.topo-node[data-tip]').forEach(function(n) {
      var r = n.getBoundingClientRect();
      nodes[n.dataset.tip] = {
        cx: r.left - cr.left + r.width/2,
        cy: r.top - cr.top + r.height/2,
        l: r.left - cr.left,
        r: r.left - cr.left + r.width,
        t: r.top - cr.top,
        b: r.top - cr.top + r.height
      };
    });

    var lines = [
      { from:'user', to:'ui', color:'#8b5cf6', marker:'ta-violet', cls:'topo-flow' },
      { from:'ui', to:'agent', color:'#06b6d4', marker:'ta-cyan', cls:'topo-flow', label:'SSE' },
      { from:'agent', to:'tools', color:'#06b6d4', marker:'ta-cyan', cls:'topo-flow' },
      { from:'agent', to:'ollama', color:'#f59e0b', marker:'ta-amber', cls:'topo-flow' },
      { from:'agent', to:'chroma', color:'#06b6d4', marker:'ta-cyan', cls:'topo-flow' },
      { from:'agent', to:'sqlite', color:'#8b5cf6', marker:'ta-violet', cls:'topo-flow-slow' },
      { from:'agent', to:'postgres', color:'#10b981', marker:'ta-green', cls:'topo-flow-slow' },
      { from:'agent', to:'otel', color:'#6366f1', marker:'ta-indigo', cls:'topo-flow-slow' },
      { from:'agent', to:'langfuse', color:'#f43f5e', marker:'ta-rose', cls:'topo-flow-slow' },
      { from:'ui', to:'n8nproxy', color:'#f59e0b', marker:'ta-amber', cls:'topo-flow-slow' },
      { from:'n8nproxy', to:'n8n', color:'#f59e0b', marker:'ta-amber', cls:'topo-flow-slow' },
      { from:'n8n', to:'agent', color:'#f59e0b', marker:'ta-amber', cls:'topo-flow-slow' },
      { from:'agent', to:'openmcp', color:'#10b981', marker:'ta-green', cls:'topo-flow' },
      { from:'agent', to:'bravemcp', color:'#f59e0b', marker:'ta-amber', cls:'topo-flow-slow' },
      { from:'otel', to:'prometheus', color:'#6366f1', marker:'ta-indigo', cls:'topo-flow' },
      { from:'otel', to:'loki', color:'#6366f1', marker:'ta-indigo', cls:'topo-flow' },
      { from:'prometheus', to:'grafana', color:'#6366f1', marker:'ta-indigo', cls:'topo-flow-slow' },
      { from:'loki', to:'grafana', color:'#6366f1', marker:'ta-indigo', cls:'topo-flow-slow' },
      { from:'langfuse', to:'langfusedb', color:'#f43f5e', marker:'ta-rose', cls:'topo-flow-slow' }
    ];

    var html = '';
    lines.forEach(function(l) {
      var a = nodes[l.from], b = nodes[l.to];
      if (!a || !b) return;
      var x1, y1, x2, y2;
      // Determine connection direction and pick edge points
      var goesDown = (b.t - a.b) > -20;
      if (goesDown) {
        x1 = a.cx; y1 = a.b;
        x2 = b.cx; y2 = b.t;
      } else {
        // Horizontal / same-level connection
        x1 = (b.cx > a.cx) ? a.r : a.l;
        y1 = a.cy;
        x2 = (b.cx > a.cx) ? b.l : b.r;
        y2 = b.cy;
      }
      var dy = y2 - y1, dx = x2 - x1;
      if (Math.abs(dy) < 2 && Math.abs(dx) < 2) return;
      // Cubic bezier control points for smooth curves
      var cpOff = Math.max(Math.abs(dy) * 0.4, 25);
      var cp1x, cp1y, cp2x, cp2y;
      if (Math.abs(dx) > Math.abs(dy) * 1.8) {
        // Mostly horizontal
        cp1x = x1 + dx * 0.35; cp1y = y1;
        cp2x = x2 - dx * 0.35; cp2y = y2;
      } else {
        // Mostly vertical — smooth S-curve
        cp1x = x1; cp1y = y1 + cpOff;
        cp2x = x2; cp2y = y2 - cpOff;
      }
      var d = 'M'+x1.toFixed(1)+','+y1.toFixed(1)+' C'+cp1x.toFixed(1)+','+cp1y.toFixed(1)+' '+cp2x.toFixed(1)+','+cp2y.toFixed(1)+' '+x2.toFixed(1)+','+y2.toFixed(1);
      var pauseClass = topoAnimate ? '' : ' paused';
      html += '<path class="topo-line-bg" d="'+d+'"/>';
      html += '<path class="topo-line '+l.cls+pauseClass+'" d="'+d+'" stroke="'+l.color+'" marker-end="url(#'+l.marker+')"/>';
    });
    // Keep existing defs
    var defs = svg.querySelector('defs');
    svg.innerHTML = '';
    svg.appendChild(defs);
    svg.insertAdjacentHTML('beforeend', html);
  }

  function topoToggleAnim() {
    document.querySelectorAll('.topo-flow, .topo-flow-slow').forEach(function(el) {
      el.classList.toggle('paused', !topoAnimate);
    });
  }

  // Tooltip
  var _topoTip = null;
  document.getElementById('topoCanvas').addEventListener('mouseover', function(e) {
    var node = e.target.closest('.topo-node[data-tip]');
    if (!node) return;
    var info = TOPO_TIPS[node.dataset.tip];
    if (!info) return;
    if (_topoTip) _topoTip.remove();
    var tip = document.createElement('div');
    tip.className = 'topo-tooltip';
    tip.innerHTML = '<div class="tt-title">'+info.t+'<\/div><div class="tt-desc">'+info.d+'<\/div><div class="tt-meta">'+info.m+'<\/div>';
    document.body.appendChild(tip);
    var r = node.getBoundingClientRect();
    var x = Math.min(r.right + 10, window.innerWidth - 280);
    var y = r.top;
    if (y + 120 > window.innerHeight) y = window.innerHeight - 130;
    if (x < 10) x = r.left - 270;
    tip.style.left = x + 'px'; tip.style.top = y + 'px';
    _topoTip = tip;
    requestAnimationFrame(function(){ tip.classList.add('active'); });
  });
  document.getElementById('topoCanvas').addEventListener('mouseout', function(e) {
    var node = e.target.closest('.topo-node[data-tip]');
    if (node && _topoTip) { _topoTip.classList.remove('active'); setTimeout(function(){ if(_topoTip){_topoTip.remove();_topoTip=null;} },200); }
  });

  // Draw on load + resize
  window.addEventListener('load', function(){ setTimeout(topoDrawLines, 100); });
  window.addEventListener('resize', topoDrawLines);
  <\/script>
</div>


<!-- What is an Agent? -->
<div class="card animate-fade-up delay-100" style="margin-bottom:1.5rem;border:1px solid rgba(124,58,237,0.12)">
