<%- include('layout', { title: 'Overview', page: 'overview', body: `

<h1 class="text-glow-cyan">Agentic Platform</h1>
<p style="color:var(--text-3);margin:-0.5rem 0 1.5rem;font-size:0.92rem">An <strong style="color:var(--text-1)">agent factory</strong> — build, register, and run hundreds of autonomous AI agents, each with its own model, tools, memory, and control logic.</p>

<!-- Get Started -->
<div class="card animate-fade-up" style="margin-bottom:1.5rem;border:1px solid rgba(6,182,212,0.2);background:linear-gradient(135deg, rgba(6,182,212,0.04), rgba(139,92,246,0.04))">
  <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1rem">
    <div style="width:36px;height:36px;border-radius:10px;background:rgba(6,182,212,0.12);display:flex;align-items:center;justify-content:center">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#06b6d4" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
    </div>
    <div>
      <h3 style="margin:0;font-size:1.05rem">Get Started — Build Your First Agentic AI App</h3>
      <p style="margin:0;color:var(--text-3);font-size:0.78rem">Follow these steps to go from zero to a working AI agent</p>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr;gap:0">

    <!-- Step 1 -->
    <a href="/skills" class="get-started-step" style="display:flex;gap:1rem;padding:1rem;border-radius:12px;text-decoration:none;color:inherit;transition:background 0.2s;border-bottom:1px solid var(--glass-border)">
      <div style="flex-shrink:0;width:32px;height:32px;border-radius:50%;background:rgba(245,158,11,0.12);color:#f59e0b;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.82rem">1</div>
      <div>
        <strong style="font-size:0.88rem;color:var(--text-1)">Define Skills</strong>
        <span class="badge" style="margin-left:0.5rem;font-size:0.65rem;vertical-align:middle">Skills</span>
        <p style="margin:0.25rem 0 0;color:var(--text-3);font-size:0.8rem;line-height:1.5">Create skills — packaged capabilities with a prompt, tools, and constraints. Think: reusable functions with intelligence. e.g. "Code Reviewer", "Research Analyst", "Data Extractor".</p>
      </div>
    </a>

    <!-- Step 2 -->
    <a href="/agents" class="get-started-step" style="display:flex;gap:1rem;padding:1rem;border-radius:12px;text-decoration:none;color:inherit;transition:background 0.2s;border-bottom:1px solid var(--glass-border)">
      <div style="flex-shrink:0;width:32px;height:32px;border-radius:50%;background:rgba(139,92,246,0.12);color:#8b5cf6;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.82rem">2</div>
      <div>
        <strong style="font-size:0.88rem;color:var(--text-1)">Build Agents</strong>
        <span class="badge" style="margin-left:0.5rem;font-size:0.65rem;vertical-align:middle">Agents</span>
        <p style="margin:0.25rem 0 0;color:var(--text-3);font-size:0.8rem;line-height:1.5">Compose an agent: pick a model, attach skills, select tools, upload a knowledge base, and write the prompt that defines its behavior and persona.</p>
      </div>
    </a>

    <!-- Step 3 -->
    <a href="/documents" class="get-started-step" style="display:flex;gap:1rem;padding:1rem;border-radius:12px;text-decoration:none;color:inherit;transition:background 0.2s;border-bottom:1px solid var(--glass-border)">
      <div style="flex-shrink:0;width:32px;height:32px;border-radius:50%;background:rgba(16,185,129,0.12);color:#10b981;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.82rem">3</div>
      <div>
        <strong style="font-size:0.88rem;color:var(--text-1)">Feed Knowledge</strong>
        <span class="badge" style="margin-left:0.5rem;font-size:0.65rem;vertical-align:middle">Documents</span>
        <p style="margin:0.25rem 0 0;color:var(--text-3);font-size:0.8rem;line-height:1.5">Upload documents, import from URLs, or paste text — your agent retrieves relevant context via RAG. Supports file upload, URL import, and direct text input.</p>
      </div>
    </a>

    <!-- Step 4 -->
    <a href="/run-agent" class="get-started-step" style="display:flex;gap:1rem;padding:1rem;border-radius:12px;text-decoration:none;color:inherit;transition:background 0.2s;border-bottom:1px solid var(--glass-border)">
      <div style="flex-shrink:0;width:32px;height:32px;border-radius:50%;background:rgba(6,182,212,0.12);color:#06b6d4;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.82rem">4</div>
      <div>
        <strong style="font-size:0.88rem;color:var(--text-1)">Run & Interact</strong>
        <span class="badge" style="margin-left:0.5rem;font-size:0.65rem;vertical-align:middle">Run Agent</span>
        <p style="margin:0.25rem 0 0;color:var(--text-3);font-size:0.8rem;line-height:1.5">Send prompts to your agent and watch it work in real-time — the activity panel streams every step: KB retrieval, reasoning, tool calls, and response generation with timing.</p>
      </div>
    </a>

    <!-- Step 5 -->
    <a href="/llm-activity" class="get-started-step" style="display:flex;gap:1rem;padding:1rem;border-radius:12px;text-decoration:none;color:inherit;transition:background 0.2s;border-bottom:1px solid var(--glass-border)">
      <div style="flex-shrink:0;width:32px;height:32px;border-radius:50%;background:rgba(244,63,94,0.12);color:#f43f5e;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.82rem">5</div>
      <div>
        <strong style="font-size:0.88rem;color:var(--text-1)">Trace & Debug</strong>
        <span class="badge" style="margin-left:0.5rem;font-size:0.65rem;vertical-align:middle">LLM Activity</span>
        <p style="margin:0.25rem 0 0;color:var(--text-3);font-size:0.8rem;line-height:1.5">Inspect every LLM call in Langfuse — see latency, token usage, tool invocations, and full conversation traces. Debug and optimize your agent's behavior.</p>
      </div>
    </a>

    <!-- Step 6 -->
    <a href="/workflows" class="get-started-step" style="display:flex;gap:1rem;padding:1rem;border-radius:12px;text-decoration:none;color:inherit;transition:background 0.2s">
      <div style="flex-shrink:0;width:32px;height:32px;border-radius:50%;background:rgba(245,158,11,0.12);color:#f59e0b;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.82rem">6</div>
      <div>
        <strong style="font-size:0.88rem;color:var(--text-1)">Automate with Workflows</strong>
        <span class="badge" style="margin-left:0.5rem;font-size:0.65rem;vertical-align:middle">n8n</span>
        <p style="margin:0.25rem 0 0;color:var(--text-3);font-size:0.8rem;line-height:1.5">Connect your agent to external triggers — scheduled runs, webhooks, multi-step pipelines. n8n orchestrates the <em>outside world</em> while LangGraph handles the <em>agent brain</em>.</p>
      </div>
    </a>
  </div>
</div>

<!-- What is an Agent? -->
<div class="card animate-fade-up delay-100" style="margin-bottom:1.5rem;border:1px solid rgba(139,92,246,0.18)">
  <h3 style="margin-bottom:0.25rem">What is an Agent?</h3>
  <p style="color:var(--text-3);font-size:0.82rem;margin-bottom:1rem">An agent is <strong style="color:var(--text-1)">not</strong> a model. It is <strong style="color:#8b5cf6">LLM + Tools + Memory + Control Logic + Context</strong> wrapped into a loop that keeps working until the task is done or it hits a stop condition.</p>

  <!-- Agent formula -->
  <div style="background:linear-gradient(135deg, rgba(139,92,246,0.08), rgba(6,182,212,0.06));border:1px solid rgba(139,92,246,0.2);border-radius:14px;padding:1.25rem;margin-bottom:1.25rem;text-align:center">
    <div style="font-size:1.1rem;font-weight:700;letter-spacing:0.02em;color:var(--text-1);margin-bottom:0.5rem">
      Agent&nbsp; =&nbsp; <span style="color:#8b5cf6">LLM</span>&nbsp; +&nbsp; <span style="color:#06b6d4">Tools</span>&nbsp; +&nbsp; <span style="color:#f43f5e">Memory</span>&nbsp; +&nbsp; <span style="color:#f59e0b">Control Logic</span>&nbsp; +&nbsp; <span style="color:#10b981">Context</span>
    </div>
    <div style="display:flex;justify-content:center;gap:0.35rem;align-items:center;margin-bottom:0.6rem">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#8b5cf6" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
    </div>
    <div style="display:flex;justify-content:center;gap:0.5rem;flex-wrap:wrap">
      <span style="background:rgba(139,92,246,0.12);border:1px solid rgba(139,92,246,0.25);padding:0.3rem 0.8rem;border-radius:20px;font-size:0.78rem;color:#8b5cf6;font-weight:600">Observe</span>
      <span style="color:var(--text-3);font-size:0.78rem;display:flex;align-items:center">→</span>
      <span style="background:rgba(6,182,212,0.12);border:1px solid rgba(6,182,212,0.25);padding:0.3rem 0.8rem;border-radius:20px;font-size:0.78rem;color:#06b6d4;font-weight:600">Reason</span>
      <span style="color:var(--text-3);font-size:0.78rem;display:flex;align-items:center">→</span>
      <span style="background:rgba(245,158,11,0.12);border:1px solid rgba(245,158,11,0.25);padding:0.3rem 0.8rem;border-radius:20px;font-size:0.78rem;color:#f59e0b;font-weight:600">Act</span>
      <span style="color:var(--text-3);font-size:0.78rem;display:flex;align-items:center">→</span>
      <span style="background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.25);padding:0.3rem 0.8rem;border-radius:20px;font-size:0.78rem;color:#10b981;font-weight:600">Repeat until done</span>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.25rem">
    <!-- Left: Agent anatomy -->
    <div style="padding:1.25rem;border-radius:14px;background:linear-gradient(135deg, rgba(139,92,246,0.06), rgba(6,182,212,0.04));border:1px solid var(--glass-border)">
      <strong style="font-size:0.9rem;color:#8b5cf6;display:block;margin-bottom:0.75rem">Each Agent Has:</strong>
      <div style="display:flex;flex-direction:column;gap:0.5rem">
        <div style="display:flex;align-items:center;gap:0.6rem">
          <div style="width:28px;height:28px;border-radius:8px;background:rgba(139,92,246,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#8b5cf6" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83"/></svg>
          </div>
          <div><strong style="font-size:0.8rem">LLM (brain)</strong> <span style="color:var(--text-3);font-size:0.75rem">— Ollama local or Azure OpenAI cloud</span></div>
        </div>
        <div style="display:flex;align-items:center;gap:0.6rem">
          <div style="width:28px;height:28px;border-radius:8px;background:rgba(6,182,212,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#06b6d4" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <div><strong style="font-size:0.8rem">Tools (actions)</strong> <span style="color:var(--text-3);font-size:0.75rem">— web_search, code_execute, file_read, http_fetch</span></div>
        </div>
        <div style="display:flex;align-items:center;gap:0.6rem">
          <div style="width:28px;height:28px;border-radius:8px;background:rgba(244,63,94,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#f43f5e" stroke-width="2"><path d="M12 2a9 9 0 0 1 9 9c0 3.9-3.1 7.1-5 8.9a13 13 0 0 1-4 2.1 13 13 0 0 1-4-2.1C6.1 18.1 3 14.9 3 11a9 9 0 0 1 9-9z"/></svg>
          </div>
          <div><strong style="font-size:0.8rem">Memory (state)</strong> <span style="color:var(--text-3);font-size:0.75rem">— conversation history + session context</span></div>
        </div>
        <div style="display:flex;align-items:center;gap:0.6rem">
          <div style="width:28px;height:28px;border-radius:8px;background:rgba(245,158,11,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <div><strong style="font-size:0.8rem">Control Logic (skills)</strong> <span style="color:var(--text-3);font-size:0.75rem">— prompt + behavior constraints</span></div>
        </div>
        <div style="display:flex;align-items:center;gap:0.6rem">
          <div style="width:28px;height:28px;border-radius:8px;background:rgba(16,185,129,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#10b981" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          </div>
          <div><strong style="font-size:0.8rem">Knowledge Base (RAG)</strong> <span style="color:var(--text-3);font-size:0.75rem">— ChromaDB vector retrieval</span></div>
        </div>
      </div>
    </div>

    <!-- Right: Scale vision -->
    <div style="padding:1.25rem;border-radius:14px;background:linear-gradient(135deg, rgba(245,158,11,0.04), rgba(16,185,129,0.04));border:1px solid var(--glass-border)">
      <strong style="font-size:0.9rem;color:#f59e0b;display:block;margin-bottom:0.5rem">Think: 100s of Agents</strong>
      <p style="color:var(--text-3);font-size:0.8rem;line-height:1.6;margin:0 0 0.75rem">This platform is an <strong style="color:var(--text-1)">agent registry</strong>. Each use case gets its own agent with a dedicated configuration. All share the same runtime engine.</p>
      <div style="display:flex;flex-direction:column;gap:0.4rem">
        <div style="padding:0.55rem 0.85rem;border-radius:10px;background:rgba(139,92,246,0.08);border:1px solid rgba(139,92,246,0.15);display:flex;justify-content:space-between;align-items:center">
          <div><strong style="font-size:0.78rem;color:#8b5cf6">Research Analyst</strong> <span style="color:var(--text-3);font-size:0.68rem">llama3 &bull; web_search, file_read</span></div>
          <span style="font-size:0.65rem;color:var(--text-3)">Agent #1</span>
        </div>
        <div style="padding:0.55rem 0.85rem;border-radius:10px;background:rgba(6,182,212,0.08);border:1px solid rgba(6,182,212,0.15);display:flex;justify-content:space-between;align-items:center">
          <div><strong style="font-size:0.78rem;color:#06b6d4">Code Assistant</strong> <span style="color:var(--text-3);font-size:0.68rem">gpt-4o &bull; code_execute, file_read</span></div>
          <span style="font-size:0.65rem;color:var(--text-3)">Agent #2</span>
        </div>
        <div style="padding:0.55rem 0.85rem;border-radius:10px;background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.15);display:flex;justify-content:space-between;align-items:center">
          <div><strong style="font-size:0.78rem;color:#10b981">Support Bot</strong> <span style="color:var(--text-3);font-size:0.68rem">llama3 &bull; notes &bull; KB: faq-docs</span></div>
          <span style="font-size:0.65rem;color:var(--text-3)">Agent #3</span>
        </div>
        <div style="padding:0.55rem 0.85rem;border-radius:10px;background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.15);display:flex;justify-content:space-between;align-items:center">
          <div><strong style="font-size:0.78rem;color:#f59e0b">Data Analyst</strong> <span style="color:var(--text-3);font-size:0.68rem">gpt-4o &bull; code_execute, http_fetch</span></div>
          <span style="font-size:0.65rem;color:var(--text-3)">Agent #4</span>
        </div>
        <div style="padding:0.55rem 0.85rem;border-radius:10px;background:rgba(139,92,246,0.05);border:1px dashed var(--glass-border);display:flex;justify-content:space-between;align-items:center">
          <div><span style="color:var(--text-3);font-size:0.78rem;font-style:italic">... Content Writer, QA Tester, Sales Rep, Compliance Checker ...</span></div>
          <span style="font-size:0.65rem;color:var(--text-3)">Agent #N</span>
        </div>
      </div>
      <p style="color:var(--text-3);font-size:0.72rem;margin:0.6rem 0 0;line-height:1.5">Every agent runs the same <strong style="color:#06b6d4">LangGraph ReAct loop</strong> — but each with its own LLM, tools, memory, knowledge base, and skills. Create one agent or create hundreds.</p>
    </div>
  </div>
</div>

<!-- Create Your First Agent — Concrete Tutorial -->
<div class="card animate-fade-up delay-100" style="margin-bottom:1.5rem;border:1px solid rgba(16,185,129,0.2);background:linear-gradient(135deg, rgba(16,185,129,0.03), rgba(6,182,212,0.03))">
  <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1rem">
    <div style="width:36px;height:36px;border-radius:10px;background:rgba(16,185,129,0.12);display:flex;align-items:center;justify-content:center">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#10b981" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
    </div>
    <div>
      <h3 style="margin:0;font-size:1.05rem">Create an Agent from Scratch</h3>
      <p style="margin:0;color:var(--text-3);font-size:0.78rem">Example: build a "Research Analyst" agent step by step</p>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
    <!-- Left column: Steps 1-2 -->
    <div>
      <div style="padding:0.85rem;border-radius:10px;background:var(--input-bg);border:1px solid var(--glass-border);margin-bottom:0.75rem">
        <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem">
          <span style="background:rgba(245,158,11,0.15);color:#f59e0b;font-weight:700;font-size:0.7rem;padding:2px 8px;border-radius:6px">STEP 1</span>
          <strong style="font-size:0.82rem">Create a Skill</strong>
        </div>
        <p style="color:var(--text-3);font-size:0.78rem;line-height:1.5;margin:0 0 0.5rem">Go to <a href="/skills" style="color:#f59e0b;text-decoration:none;font-weight:600">Skills</a> → Click <strong>Create Skill</strong></p>
        <div style="background:rgba(0,0,0,0.3);border-radius:8px;padding:0.6rem 0.8rem;font-family:monospace;font-size:0.72rem;color:var(--text-2);line-height:1.6">
          <span style="color:#f59e0b">Name:</span> Deep Research<br>
          <span style="color:#f59e0b">Prompt:</span> You are a research analyst. Find authoritative sources, cross-reference facts, and produce structured reports with citations.<br>
          <span style="color:#f59e0b">Tools:</span> web_search, file_read<br>
          <span style="color:#f59e0b">Constraints:</span> Always cite sources, max 3 search queries
        </div>
      </div>

      <div style="padding:0.85rem;border-radius:10px;background:var(--input-bg);border:1px solid var(--glass-border)">
        <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem">
          <span style="background:rgba(139,92,246,0.15);color:#8b5cf6;font-weight:700;font-size:0.7rem;padding:2px 8px;border-radius:6px">STEP 2</span>
          <strong style="font-size:0.82rem">Create the Agent</strong>
        </div>
        <p style="color:var(--text-3);font-size:0.78rem;line-height:1.5;margin:0 0 0.5rem">Go to <a href="/agents" style="color:#8b5cf6;text-decoration:none;font-weight:600">Agents</a> → Click <strong>Create Agent</strong></p>
        <div style="background:rgba(0,0,0,0.3);border-radius:8px;padding:0.6rem 0.8rem;font-family:monospace;font-size:0.72rem;color:var(--text-2);line-height:1.6">
          <span style="color:#8b5cf6">Name:</span> Research Analyst<br>
          <span style="color:#8b5cf6">Provider:</span> ollama &nbsp;|&nbsp; <span style="color:#8b5cf6">Model:</span> llama3<br>
          <span style="color:#8b5cf6">Temperature:</span> 0.3<br>
          <span style="color:#8b5cf6">Skills:</span> ✅ Deep Research<br>
          <span style="color:#8b5cf6">Tools:</span> web_search, file_read<br>
          <span style="color:#8b5cf6">KB Collection:</span> agentic_docs<br>
          <span style="color:#8b5cf6">Memory:</span> enabled
        </div>
      </div>
    </div>

    <!-- Right column: Steps 3-4 -->
    <div>
      <div style="padding:0.85rem;border-radius:10px;background:var(--input-bg);border:1px solid var(--glass-border);margin-bottom:0.75rem">
        <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem">
          <span style="background:rgba(16,185,129,0.15);color:#10b981;font-weight:700;font-size:0.7rem;padding:2px 8px;border-radius:6px">STEP 3</span>
          <strong style="font-size:0.82rem">Upload Knowledge (optional)</strong>
        </div>
