    <div class="topo-band" style="top:0;height:90px;background:rgba(139,92,246,0.03);border-color:rgba(139,92,246,0.12);border-radius:14px 14px 0 0">
      <span class="topo-band-label" style="top:4px;color:rgba(139,92,246,0.5)">PRESENTATION</span>
