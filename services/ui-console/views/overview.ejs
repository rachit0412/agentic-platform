<!-- What is an Agent? -->
<div class="card animate-fade-up delay-100" style="margin-bottom:1.5rem;border:1px solid rgba(124,58,237,0.12)">
  <h3 style="margin-bottom:0.25rem">What is an Agent?</h3>
  <p style="color:var(--text-3);font-size:0.82rem;margin-bottom:1rem">An agent is <strong style="color:var(--text-1)">not</strong> a model. It is <strong style="color:#8b5cf6">LLM + Tools + Memory + Control Logic + Context</strong> wrapped into a loop that keeps working until the task is done or it hits a stop condition.</p>

  <!-- Agent formula -->
  <div style="background:linear-gradient(135deg, rgba(139,92,246,0.08), rgba(6,182,212,0.06));border:1px solid rgba(139,92,246,0.2);border-radius:14px;padding:1.25rem;margin-bottom:1.25rem;text-align:center">
    <div style="font-size:1.1rem;font-weight:700;letter-spacing:0.02em;color:var(--text-1);margin-bottom:0.5rem">
      Agent&nbsp; =&nbsp; <span style="color:#8b5cf6">LLM</span>&nbsp; +&nbsp; <span style="color:#06b6d4">Tools</span>&nbsp; +&nbsp; <span style="color:#f43f5e">Memory</span>&nbsp; +&nbsp; <span style="color:#f59e0b">Control Logic</span>&nbsp; +&nbsp; <span style="color:#10b981">Context</span>
    </div>
    <div style="display:flex;justify-content:center;gap:0.35rem;align-items:center;margin-bottom:0.6rem">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#8b5cf6" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
    </div>
    <div style="display:flex;justify-content:center;gap:0.5rem;flex-wrap:wrap">
      <span style="background:rgba(139,92,246,0.12);border:1px solid rgba(139,92,246,0.25);padding:0.3rem 0.8rem;border-radius:20px;font-size:0.78rem;color:#8b5cf6;font-weight:600">Observe</span>
      <span style="color:var(--text-3);font-size:0.78rem;display:flex;align-items:center">→</span>
      <span style="background:rgba(6,182,212,0.12);border:1px solid rgba(6,182,212,0.25);padding:0.3rem 0.8rem;border-radius:20px;font-size:0.78rem;color:#06b6d4;font-weight:600">Reason</span>
      <span style="color:var(--text-3);font-size:0.78rem;display:flex;align-items:center">→</span>
      <span style="background:rgba(245,158,11,0.12);border:1px solid rgba(245,158,11,0.25);padding:0.3rem 0.8rem;border-radius:20px;font-size:0.78rem;color:#f59e0b;font-weight:600">Act</span>
      <span style="color:var(--text-3);font-size:0.78rem;display:flex;align-items:center">→</span>
      <span style="background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.25);padding:0.3rem 0.8rem;border-radius:20px;font-size:0.78rem;color:#10b981;font-weight:600">Repeat until done</span>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.25rem">
    <!-- Left: Agent anatomy -->
    <div style="padding:1.25rem;border-radius:14px;background:linear-gradient(135deg, rgba(139,92,246,0.06), rgba(6,182,212,0.04));border:1px solid var(--glass-border)">
      <strong style="font-size:0.9rem;color:#8b5cf6;display:block;margin-bottom:0.75rem">Each Agent Has:</strong>
      <div style="display:flex;flex-direction:column;gap:0.5rem">
        <div style="display:flex;align-items:center;gap:0.6rem">
          <div style="width:28px;height:28px;border-radius:8px;background:rgba(139,92,246,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#8b5cf6" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83"/></svg>
          </div>
          <div><strong style="font-size:0.8rem">LLM (brain)</strong> <span style="color:var(--text-3);font-size:0.75rem">— Ollama, Azure OpenAI, OpenAI, or Foundry</span></div>
        </div>
        <div style="display:flex;align-items:center;gap:0.6rem">
          <div style="width:28px;height:28px;border-radius:8px;background:rgba(6,182,212,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#06b6d4" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <div><strong style="font-size:0.8rem">Tools (actions)</strong> <span style="color:var(--text-3);font-size:0.75rem">— web_search, code_execute, file_read, http_fetch</span></div>
        </div>
        <div style="display:flex;align-items:center;gap:0.6rem">
          <div style="width:28px;height:28px;border-radius:8px;background:rgba(244,63,94,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#f43f5e" stroke-width="2"><path d="M12 2a9 9 0 0 1 9 9c0 3.9-3.1 7.1-5 8.9a13 13 0 0 1-4 2.1 13 13 0 0 1-4-2.1C6.1 18.1 3 14.9 3 11a9 9 0 0 1 9-9z"/></svg>
          </div>
          <div><strong style="font-size:0.8rem">Memory (state)</strong> <span style="color:var(--text-3);font-size:0.75rem">— conversation history + session context</span></div>
        </div>
        <div style="display:flex;align-items:center;gap:0.6rem">
          <div style="width:28px;height:28px;border-radius:8px;background:rgba(245,158,11,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <div><strong style="font-size:0.8rem">Control Logic (skills)</strong> <span style="color:var(--text-3);font-size:0.75rem">— prompt + behavior constraints</span></div>
        </div>
        <div style="display:flex;align-items:center;gap:0.6rem">
          <div style="width:28px;height:28px;border-radius:8px;background:rgba(16,185,129,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#10b981" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          </div>
          <div><strong style="font-size:0.8rem">Knowledge Base (RAG)</strong> <span style="color:var(--text-3);font-size:0.75rem">— embed → ChromaDB → similarity search</span></div>
        </div>
        <div style="display:flex;align-items:center;gap:0.6rem">
          <div style="width:28px;height:28px;border-radius:8px;background:rgba(59,130,246,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#3b82f6" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <div><strong style="font-size:0.8rem">Context (input)</strong> <span style="color:var(--text-3);font-size:0.75rem">— system prompt + user prompt + injected RAG docs</span></div>
        </div>
      </div>
    </div>

    <!-- Right: Scale vision -->
    <div style="padding:1.25rem;border-radius:14px;background:linear-gradient(135deg, rgba(245,158,11,0.04), rgba(16,185,129,0.04));border:1px solid var(--glass-border)">
      <strong style="font-size:0.9rem;color:#f59e0b;display:block;margin-bottom:0.5rem">Think: 100s of Agents</strong>
      <p style="color:var(--text-3);font-size:0.8rem;line-height:1.6;margin:0 0 0.75rem">This platform is an <strong style="color:var(--text-1)">agent registry</strong>. Each use case gets its own agent with a dedicated configuration. All share the same runtime engine.</p>
      <div style="display:flex;flex-direction:column;gap:0.4rem">
        <div style="padding:0.55rem 0.85rem;border-radius:10px;background:rgba(139,92,246,0.08);border:1px solid rgba(139,92,246,0.15);display:flex;justify-content:space-between;align-items:center">
          <div><strong style="font-size:0.78rem;color:#8b5cf6">Finance Analyst</strong> <span style="color:var(--text-3);font-size:0.68rem">llama3 &bull; web_search, file_read</span></div>
          <span style="font-size:0.65rem;color:var(--text-3)">Agent #1</span>
        </div>
        <div style="padding:0.55rem 0.85rem;border-radius:10px;background:rgba(6,182,212,0.08);border:1px solid rgba(6,182,212,0.15);display:flex;justify-content:space-between;align-items:center">
          <div><strong style="font-size:0.78rem;color:#06b6d4">Customer Support</strong> <span style="color:var(--text-3);font-size:0.68rem">gpt-4.1-mini (foundry) &bull; KB: faq-docs</span></div>
          <span style="font-size:0.65rem;color:var(--text-3)">Agent #2</span>
        </div>
        <div style="padding:0.55rem 0.85rem;border-radius:10px;background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.15);display:flex;justify-content:space-between;align-items:center">
          <div><strong style="font-size:0.78rem;color:#10b981">Content Writer</strong> <span style="color:var(--text-3);font-size:0.68rem">llama3 &bull; web_search, notes</span></div>
          <span style="font-size:0.65rem;color:var(--text-3)">Agent #3</span>
        </div>
        <div style="padding:0.55rem 0.85rem;border-radius:10px;background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.15);display:flex;justify-content:space-between;align-items:center">
          <div><strong style="font-size:0.78rem;color:#f59e0b">QA Tester</strong> <span style="color:var(--text-3);font-size:0.68rem">gpt-4o (azure) &bull; code_execute, http_fetch</span></div>
          <span style="font-size:0.65rem;color:var(--text-3)">Agent #4</span>
        </div>
        <div style="padding:0.55rem 0.85rem;border-radius:10px;background:rgba(139,92,246,0.05);border:1px dashed var(--glass-border);display:flex;justify-content:space-between;align-items:center">
          <div><span style="color:var(--text-3);font-size:0.78rem;font-style:italic">... Data Analyst, Compliance Checker, Sales Rep, Research Analyst ...</span></div>
          <span style="font-size:0.65rem;color:var(--text-3)">Agent #N</span>
        </div>
      </div>
      <p style="color:var(--text-3);font-size:0.72rem;margin:0.6rem 0 0;line-height:1.5">Every agent runs the same <strong style="color:#06b6d4">LangGraph ReAct loop</strong> — but each with its own LLM, tools, memory, knowledge base, and skills. Create one agent or create hundreds.</p>
    </div>
  </div>
</div>


<!-- Get Started -->
<div class="card animate-fade-up" style="margin-bottom:1.5rem;border:1px solid rgba(6,182,212,0.15);background:linear-gradient(135deg, rgba(6,182,212,0.03), rgba(124,58,237,0.03))">
  <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1rem">
    <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,rgba(6,182,212,0.15),rgba(124,58,237,0.1));display:flex;align-items:center;justify-content:center">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#06b6d4" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
    </div>
    <div>
      <h3 style="margin:0;font-size:1.05rem">Get Started — Build Your First Agentic AI App</h3>
      <p style="margin:0;color:var(--text-3);font-size:0.78rem">Follow these steps to go from zero to a working AI agent</p>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr;gap:0">

    <!-- Step 1 -->
    <a href="/prompts" class="get-started-step" style="display:flex;gap:1rem;padding:1rem;border-radius:12px;text-decoration:none;color:inherit;transition:background 0.2s;border-bottom:1px solid var(--glass-border)">
      <div style="flex-shrink:0;width:32px;height:32px;border-radius:50%;background:rgba(167,139,250,0.12);color:#a78bfa;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.82rem">1</div>
      <div>
        <strong style="font-size:0.88rem;color:var(--text-1)">Create Prompts</strong>
        <span class="badge" style="margin-left:0.5rem;font-size:0.65rem;vertical-align:middle">Prompts</span>
        <p style="margin:0.25rem 0 0;color:var(--text-3);font-size:0.8rem;line-height:1.5">Write system prompts that define agent behavior and persona. Templates, variables, and version control built in. e.g. "You are a research analyst that always cites sources."</p>
      </div>
    </a>

    <!-- Step 2 -->
    <a href="/skills" class="get-started-step" style="display:flex;gap:1rem;padding:1rem;border-radius:12px;text-decoration:none;color:inherit;transition:background 0.2s;border-bottom:1px solid var(--glass-border)">
      <div style="flex-shrink:0;width:32px;height:32px;border-radius:50%;background:rgba(245,158,11,0.12);color:#f59e0b;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.82rem">2</div>
      <div>
        <strong style="font-size:0.88rem;color:var(--text-1)">Define Skills</strong>
        <span class="badge" style="margin-left:0.5rem;font-size:0.65rem;vertical-align:middle">Skills</span>
        <p style="margin:0.25rem 0 0;color:var(--text-3);font-size:0.8rem;line-height:1.5">Package capabilities — a prompt, tools, and constraints into a reusable skill. Think: intelligent functions. e.g. "Code Reviewer", "Data Extractor", "Summarizer".</p>
      </div>
    </a>

