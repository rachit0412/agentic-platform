  <script>
  var topoAnimate = true;
  var TOPO_TIPS = {
    user:      { t:'User / Webhook', d:'Entry point — browser UI, REST API, or n8n webhook trigger.', m:'HTTP / SSE' },
    ui:        { t:'UI Console', d:'Express.js + EJS platform dashboard. 24 pages, 70+ API proxy routes to agent-service.', m:'Port 3000' },
    n8nproxy:  { t:'n8n Proxy', d:'Nginx reverse proxy for embedding n8n inside the platform dashboard via iframe.', m:'Port 5679' },
    agent:     { t:'Agent Service', d:'Core runtime — FastAPI + LangGraph ReAct loop. 69+ REST endpoints, agent/skill/A2A/MCP registry, RAG pipeline, guardrails.', m:'Port 8010' },
    tools:     { t:'Tools Service', d:'Sandboxed tool execution — web_search, code_execute, http_fetch, file I/O, datetime.', m:'Port 8011' },
    ollama:    { t:'Ollama', d:'Local LLM inference server. Runs Llama 3, Mistral, and other open models. Runtime-switchable.', m:'Port 11436' },
    chroma:    { t:'ChromaDB', d:'Vector store for embeddings and RAG retrieval. Stores document chunks for semantic search.', m:'Port 8200' },
    sqlite:    { t:'SQLite', d:'Embedded platform database — conversations, memory (STM/LTM), agent configs, skills, audit log. 13 tables.', m:'Embedded file' },
    postgres:  { t:'PostgreSQL (Datastore)', d:'Document registry with JSONB columns. Stores ingestion metadata, connector configs, structured data.', m:'Port 5433' },
    n8n:       { t:'n8n Workflow Engine', d:'Visual workflow automation — scheduled agent runs, webhook triggers, multi-step pipelines, RAG ingest.', m:'Port 5678' },
    otel:      { t:'OTel Collector', d:'OpenTelemetry Collector — receives OTLP traces from agent-service, routes metrics to Prometheus and logs to Loki.', m:'Port 4317/4318' },
    langfuse:  { t:'Langfuse', d:'LLM observability — trace viewer, cost tracking, latency analysis. Captures every LLM call with full context.', m:'Port 3014' },
    langfusedb:{ t:'Langfuse DB', d:'PostgreSQL backend for Langfuse. Stores LLM traces, sessions, and evaluation data.', m:'Internal' },
    prometheus:{ t:'Prometheus', d:'Time-series metrics store. Scrapes agent-service and OTel Collector for request counts, latencies, errors.', m:'Port 9090' },
    grafana:   { t:'Grafana', d:'Dashboards and visualization. Pre-configured with platform health dashboard, Prometheus and Loki datasources.', m:'Port 3003' },
    loki:      { t:'Loki', d:'Log aggregation system. Receives structured logs from OTel Collector. Queryable from Grafana.', m:'Port 3100' }
  };

  // Draw connections
  function topoDrawLines() {
    var svg = document.getElementById('topoSvg');
    var canvas = document.getElementById('topoCanvas');
    if (!svg || !canvas) return;
    var cr = canvas.getBoundingClientRect();
    svg.setAttribute('viewBox', '0 0 ' + cr.width + ' ' + cr.height);

    var nodes = {};
    canvas.querySelectorAll('.topo-node[data-tip]').forEach(function(n) {
      var r = n.getBoundingClientRect();
      nodes[n.dataset.tip] = {
        cx: r.left - cr.left + r.width/2,
        cy: r.top - cr.top + r.height/2,
        l: r.left - cr.left,
        r: r.left - cr.left + r.width,
        t: r.top - cr.top,
        b: r.top - cr.top + r.height
      };
    });

    var lines = [
      { from:'user', to:'ui', color:'#8b5cf6', marker:'ta-violet', cls:'topo-flow' },
      { from:'ui', to:'agent', color:'#06b6d4', marker:'ta-cyan', cls:'topo-flow', label:'SSE' },
      { from:'agent', to:'tools', color:'#06b6d4', marker:'ta-cyan', cls:'topo-flow' },
      { from:'agent', to:'ollama', color:'#f59e0b', marker:'ta-amber', cls:'topo-flow' },
      { from:'agent', to:'chroma', color:'#06b6d4', marker:'ta-cyan', cls:'topo-flow' },
      { from:'agent', to:'sqlite', color:'#8b5cf6', marker:'ta-violet', cls:'topo-flow-slow' },
      { from:'agent', to:'postgres', color:'#10b981', marker:'ta-green', cls:'topo-flow-slow' },
      { from:'agent', to:'otel', color:'#6366f1', marker:'ta-indigo', cls:'topo-flow-slow' },
      { from:'agent', to:'langfuse', color:'#f43f5e', marker:'ta-rose', cls:'topo-flow-slow' },
      { from:'ui', to:'n8nproxy', color:'#f59e0b', marker:'ta-amber', cls:'topo-flow-slow' },
      { from:'n8nproxy', to:'n8n', color:'#f59e0b', marker:'ta-amber', cls:'topo-flow-slow' },
      { from:'n8n', to:'agent', color:'#f59e0b', marker:'ta-amber', cls:'topo-flow-slow' },
      { from:'otel', to:'prometheus', color:'#6366f1', marker:'ta-indigo', cls:'topo-flow' },
      { from:'otel', to:'loki', color:'#6366f1', marker:'ta-indigo', cls:'topo-flow' },
      { from:'prometheus', to:'grafana', color:'#6366f1', marker:'ta-indigo', cls:'topo-flow-slow' },
      { from:'loki', to:'grafana', color:'#6366f1', marker:'ta-indigo', cls:'topo-flow-slow' },
      { from:'langfuse', to:'langfusedb', color:'#f43f5e', marker:'ta-rose', cls:'topo-flow-slow' }
    ];

    var html = '';
    lines.forEach(function(l) {
      var a = nodes[l.from], b = nodes[l.to];
      if (!a || !b) return;
      var x1 = a.cx, y1 = a.cy, x2 = b.cx, y2 = b.cy;
      // Adjust endpoints to node edges
      var dx = x2-x1, dy = y2-y1, dist = Math.sqrt(dx*dx+dy*dy);
      if (dist < 1) return;
      var nx = dx/dist, ny = dy/dist;
      x1 += nx*Math.min(50, dist*0.3); y1 += ny*Math.min(25, dist*0.3);
      x2 -= nx*Math.min(50, dist*0.3); y2 -= ny*Math.min(25, dist*0.3);
      var pauseClass = topoAnimate ? '' : ' paused';
      html += '<line class="topo-line-bg" x1="'+x1+'" y1="'+y1+'" x2="'+x2+'" y2="'+y2+'"/>';
      html += '<line class="topo-line '+l.cls+pauseClass+'" x1="'+x1+'" y1="'+y1+'" x2="'+x2+'" y2="'+y2+'" stroke="'+l.color+'" marker-end="url(#'+l.marker+')"/>';
    });
    // Keep existing defs
    var defs = svg.querySelector('defs');
    svg.innerHTML = '';
    svg.appendChild(defs);
    svg.insertAdjacentHTML('beforeend', html);
  }

  function topoToggleAnim() {
    document.querySelectorAll('.topo-flow, .topo-flow-slow').forEach(function(el) {
      el.classList.toggle('paused', !topoAnimate);
    });
  }

  // Tooltip
  var _topoTip = null;
  document.getElementById('topoCanvas').addEventListener('mouseover', function(e) {
    var node = e.target.closest('.topo-node[data-tip]');
    if (!node) return;
    var info = TOPO_TIPS[node.dataset.tip];
    if (!info) return;
    if (_topoTip) _topoTip.remove();
    var tip = document.createElement('div');
    tip.className = 'topo-tooltip';
    tip.innerHTML = '<div class="tt-title">'+info.t+'<\/div><div class="tt-desc">'+info.d+'<\/div><div class="tt-meta">'+info.m+'<\/div>';
    document.body.appendChild(tip);
    var r = node.getBoundingClientRect();
    var x = Math.min(r.right + 10, window.innerWidth - 280);
    var y = r.top;
    if (y + 120 > window.innerHeight) y = window.innerHeight - 130;
    if (x < 10) x = r.left - 270;
    tip.style.left = x + 'px'; tip.style.top = y + 'px';
    _topoTip = tip;
    requestAnimationFrame(function(){ tip.classList.add('active'); });
  });
  document.getElementById('topoCanvas').addEventListener('mouseout', function(e) {
    var node = e.target.closest('.topo-node[data-tip]');
    if (node && _topoTip) { _topoTip.classList.remove('active'); setTimeout(function(){ if(_topoTip){_topoTip.remove();_topoTip=null;} },200); }
  });

  // Draw on load + resize
  window.addEventListener('load', function(){ setTimeout(topoDrawLines, 100); });
  window.addEventListener('resize', topoDrawLines);
  <\/script>
</div>


<!-- What is an Agent? -->
<div class="card animate-fade-up delay-100" style="margin-bottom:1.5rem;border:1px solid rgba(124,58,237,0.12)">
  <h3 style="margin-bottom:0.25rem">What is an Agent?</h3>
  <p style="color:var(--text-3);font-size:0.82rem;margin-bottom:1rem">An agent is <strong style="color:var(--text-1)">not</strong> a model. It is <strong style="color:#8b5cf6">LLM + Tools + Memory + Control Logic + Context</strong> wrapped into a loop that keeps working until the task is done or it hits a stop condition.</p>

  <!-- Agent formula -->
  <div style="background:linear-gradient(135deg, rgba(139,92,246,0.08), rgba(6,182,212,0.06));border:1px solid rgba(139,92,246,0.2);border-radius:14px;padding:1.25rem;margin-bottom:1.25rem;text-align:center">
    <div style="font-size:1.1rem;font-weight:700;letter-spacing:0.02em;color:var(--text-1);margin-bottom:0.5rem">
      Agent&nbsp; =&nbsp; <span style="color:#8b5cf6">LLM</span>&nbsp; +&nbsp; <span style="color:#06b6d4">Tools</span>&nbsp; +&nbsp; <span style="color:#f43f5e">Memory</span>&nbsp; +&nbsp; <span style="color:#f59e0b">Control Logic</span>&nbsp; +&nbsp; <span style="color:#10b981">Context</span>
    </div>
    <div style="display:flex;justify-content:center;gap:0.35rem;align-items:center;margin-bottom:0.6rem">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#8b5cf6" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
    </div>
    <div style="display:flex;justify-content:center;gap:0.5rem;flex-wrap:wrap">
      <span style="background:rgba(139,92,246,0.12);border:1px solid rgba(139,92,246,0.25);padding:0.3rem 0.8rem;border-radius:20px;font-size:0.78rem;color:#8b5cf6;font-weight:600">Observe</span>
      <span style="color:var(--text-3);font-size:0.78rem;display:flex;align-items:center">→</span>
      <span style="background:rgba(6,182,212,0.12);border:1px solid rgba(6,182,212,0.25);padding:0.3rem 0.8rem;border-radius:20px;font-size:0.78rem;color:#06b6d4;font-weight:600">Reason</span>
      <span style="color:var(--text-3);font-size:0.78rem;display:flex;align-items:center">→</span>
      <span style="background:rgba(245,158,11,0.12);border:1px solid rgba(245,158,11,0.25);padding:0.3rem 0.8rem;border-radius:20px;font-size:0.78rem;color:#f59e0b;font-weight:600">Act</span>
      <span style="color:var(--text-3);font-size:0.78rem;display:flex;align-items:center">→</span>
      <span style="background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.25);padding:0.3rem 0.8rem;border-radius:20px;font-size:0.78rem;color:#10b981;font-weight:600">Repeat until done</span>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.25rem">
    <!-- Left: Agent anatomy -->
    <div style="padding:1.25rem;border-radius:14px;background:linear-gradient(135deg, rgba(139,92,246,0.06), rgba(6,182,212,0.04));border:1px solid var(--glass-border)">
      <strong style="font-size:0.9rem;color:#8b5cf6;display:block;margin-bottom:0.75rem">Each Agent Has:</strong>
      <div style="display:flex;flex-direction:column;gap:0.5rem">
        <div style="display:flex;align-items:center;gap:0.6rem">
          <div style="width:28px;height:28px;border-radius:8px;background:rgba(139,92,246,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#8b5cf6" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83"/></svg>
          </div>
          <div><strong style="font-size:0.8rem">LLM (brain)</strong> <span style="color:var(--text-3);font-size:0.75rem">— Ollama, Azure OpenAI, OpenAI, or Foundry</span></div>
        </div>
        <div style="display:flex;align-items:center;gap:0.6rem">
          <div style="width:28px;height:28px;border-radius:8px;background:rgba(6,182,212,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#06b6d4" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <div><strong style="font-size:0.8rem">Tools (actions)</strong> <span style="color:var(--text-3);font-size:0.75rem">— web_search, code_execute, file_read, http_fetch</span></div>
        </div>
        <div style="display:flex;align-items:center;gap:0.6rem">
          <div style="width:28px;height:28px;border-radius:8px;background:rgba(244,63,94,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#f43f5e" stroke-width="2"><path d="M12 2a9 9 0 0 1 9 9c0 3.9-3.1 7.1-5 8.9a13 13 0 0 1-4 2.1 13 13 0 0 1-4-2.1C6.1 18.1 3 14.9 3 11a9 9 0 0 1 9-9z"/></svg>
          </div>
          <div><strong style="font-size:0.8rem">Memory (state)</strong> <span style="color:var(--text-3);font-size:0.75rem">— conversation history + session context</span></div>
        </div>
        <div style="display:flex;align-items:center;gap:0.6rem">
          <div style="width:28px;height:28px;border-radius:8px;background:rgba(245,158,11,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <div><strong style="font-size:0.8rem">Control Logic (skills)</strong> <span style="color:var(--text-3);font-size:0.75rem">— prompt + behavior constraints</span></div>
        </div>
        <div style="display:flex;align-items:center;gap:0.6rem">
          <div style="width:28px;height:28px;border-radius:8px;background:rgba(16,185,129,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#10b981" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          </div>
          <div><strong style="font-size:0.8rem">Knowledge Base (RAG)</strong> <span style="color:var(--text-3);font-size:0.75rem">— embed → ChromaDB → similarity search</span></div>
        </div>
        <div style="display:flex;align-items:center;gap:0.6rem">
