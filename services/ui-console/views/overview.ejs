<!-- Services Topology -->
<div class="card animate-fade-up delay-300" style="margin-top:1.5rem">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.5rem">
    <h3 style="margin:0">Services Topology</h3>
    <div style="display:flex;gap:0.5rem;align-items:center">
      <button onclick="topoAnimate=!topoAnimate;this.textContent=topoAnimate?'Pause':'Animate';topoToggleAnim()" style="padding:0.3rem 0.7rem;border-radius:7px;background:var(--glass-bg);border:1px solid var(--glass-border);color:var(--text-2);font-size:0.7rem;font-weight:600;cursor:pointer;transition:all 0.15s">Pause</button>
      <a href="/docs/architecture-diagram" target="_blank" style="display:inline-flex;align-items:center;gap:0.4rem;padding:0.35rem 0.85rem;border-radius:8px;background:linear-gradient(135deg,rgba(139,92,246,0.12),rgba(6,182,212,0.08));border:1px solid rgba(139,92,246,0.2);color:#8b5cf6;font-size:0.75rem;font-weight:600;text-decoration:none;transition:all 0.2s">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        Full Diagram
      </a>
    </div>
  </div>
  <p style="color:var(--text-3);font-size:0.82rem;margin-bottom:1.25rem">14 containerized services across 5 layers on <code style="font-size:0.75rem">platform-net</code> — hover any node for details, watch the data flow animate.</p>

  <style>
    .topo-canvas { position:relative; min-height:540px; overflow:hidden; border-radius:14px; background:linear-gradient(180deg, rgba(139,92,246,0.02), rgba(6,182,212,0.02), rgba(16,185,129,0.02)); border:1px solid var(--glass-border); padding:1rem 1.5rem; }
    .topo-node { position:absolute; border-radius:12px; padding:0.5rem 0.7rem; cursor:pointer; transition:all 0.25s cubic-bezier(0.4,0,0.2,1); z-index:2; min-width:105px; text-align:center; backdrop-filter:blur(8px); }
    .topo-node:hover { transform:translateY(-3px) scale(1.04); z-index:10; box-shadow:0 8px 32px rgba(0,0,0,0.15); }
    .topo-node .tn-name { font-size:0.75rem; font-weight:700; display:block; margin-bottom:0.1rem; }
    .topo-node .tn-tech { font-size:0.6rem; color:var(--text-3); display:block; }
    .topo-node .tn-port { font-size:0.56rem; font-weight:600; opacity:0.7; display:block; margin-top:0.1rem; }
    .topo-node .tn-pulse { position:absolute; top:0.4rem; right:0.4rem; width:6px; height:6px; border-radius:50%; }
    .topo-node .tn-pulse::after { content:''; position:absolute; inset:-3px; border-radius:50%; animation:topoPulse 2s ease-in-out infinite; }
    .topo-node .tn-pulse.live { background:#10b981; }
    .topo-node .tn-pulse.live::after { border:1.5px solid rgba(16,185,129,0.4); }
    @keyframes topoPulse { 0%,100%{transform:scale(1);opacity:1} 50%{transform:scale(1.8);opacity:0} }

    .topo-tooltip { position:fixed; z-index:9999; background:var(--bg); border:1px solid var(--glass-border); border-radius:12px; padding:0.85rem 1rem; max-width:260px; box-shadow:0 12px 40px rgba(0,0,0,0.25); backdrop-filter:blur(16px); pointer-events:none; opacity:0; transform:translateY(6px); transition:all 0.2s ease; }
    .topo-tooltip.active { opacity:1; transform:translateY(0); }
    .topo-tooltip .tt-title { font-size:0.82rem; font-weight:700; color:var(--text-1); margin-bottom:0.2rem; }
    .topo-tooltip .tt-desc { font-size:0.72rem; color:var(--text-2); line-height:1.5; margin-bottom:0.25rem; }
    .topo-tooltip .tt-meta { font-size:0.65rem; color:var(--text-3); }

    /* Connection lines via SVG overlay */
    .topo-svg { position:absolute; inset:0; width:100%; height:100%; z-index:1; pointer-events:none; }
    .topo-line { stroke-width:1.5; fill:none; }
    .topo-line-bg { stroke:var(--glass-border); stroke-width:2; fill:none; }
    @keyframes topoFlowDash { to { stroke-dashoffset:-40; } }
    .topo-flow { stroke-dasharray:8 6; animation:topoFlowDash 1.5s linear infinite; }
    .topo-flow-slow { stroke-dasharray:4 8; animation:topoFlowDash 3s linear infinite; }
    .topo-flow.paused, .topo-flow-slow.paused { animation-play-state:paused; }

    /* Horizontal layer bands */
    .topo-band { position:absolute; left:0; right:0; z-index:0; border-bottom:1px dashed; display:flex; align-items:flex-start; }
    .topo-band-label { position:absolute; left:0.75rem; font-size:0.58rem; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; z-index:1; }
  </style>

  <div class="topo-canvas" id="topoCanvas">
