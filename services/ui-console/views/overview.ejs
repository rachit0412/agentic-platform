<script>
function loadHealth() {
  fetch('/api/health-check').then(r=>r.json()).then(d=>{
    const el=document.getElementById('health-grid');
    el.innerHTML=d.services.map(s=>\`
      <div class="health-item">
        <div style="display:flex;align-items:center;gap:10px">
          <span class="pulse-dot-\${s.status==='healthy'?'emerald':'rose'}"></span>
          <strong style="font-size:0.875rem">\${escapeHtml(s.name)}</strong>
        </div>
        <span class="badge \${s.status==='healthy'?'badge-success':'badge-error'}">\${escapeHtml(s.status)}</span>
      </div>
    \`).join('');
  }).catch(()=>{
    document.getElementById('health-grid').innerHTML='<div class="health-item"><span style="color:var(--text-3)">Failed to load health status</span></div>';
  });
}
loadHealth();

async function loadPlatformStats() {
  try {
    const [agents, skills, prompts, models, tools, memStats, docs] = await Promise.all([
      fetch('/api/agents').then(r=>r.json()).catch(()=>[]),
      fetch('/api/skills').then(r=>r.json()).catch(()=>[]),
      fetch('/api/prompts').then(r=>r.json()).catch(()=>({})),
      fetch('/api/models').then(r=>r.json()).catch(()=>({})),
      fetch('/api/tools').then(r=>r.json()).catch(()=>({})),
      fetch('/api/memory/stats').then(r=>r.json()).catch(()=>({})),
      fetch('/api/documents/stats').then(r=>r.json()).catch(()=>({})),
    ]);
    document.getElementById('stat-agents').textContent = (agents.agents||[]).length;
    document.getElementById('stat-skills').textContent = (skills.skills||[]).length;
    document.getElementById('stat-prompts').textContent = (prompts.prompts||[]).length;
    document.getElementById('stat-models').textContent = (models.models||[]).length;
    document.getElementById('stat-tools').textContent = (tools.tools||[]).length;
    document.getElementById('stat-sessions').textContent = (memStats.memory?.total_sessions || 0);
    document.getElementById('stat-docs').textContent = (docs.unique_documents || memStats.knowledge_base?.unique_documents || 0);
  } catch(e) {
    ['stat-agents','stat-skills','stat-prompts','stat-models','stat-tools','stat-sessions','stat-docs'].forEach(id => {
      const el = document.getElementById(id);
      if (el && el.textContent === '-') el.textContent = '0';
    });
  }
}
loadPlatformStats();
<\/script>


