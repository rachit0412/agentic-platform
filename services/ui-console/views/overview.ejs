<%- include('layout', { title: 'Overview', page: 'overview', body: `

<!-- Hero Banner -->
<style>
  .overview-hero { position:relative; border-radius:20px; padding:2.25rem 2rem; margin-bottom:1.75rem; overflow:hidden; backdrop-filter:blur(20px); }
  .hero-orb { position:absolute; border-radius:50%; filter:blur(60px); pointer-events:none; z-index:0; }
  .hero-orb-1 { width:200px; height:200px; background:rgba(139,92,246,0.12); top:-50px; right:10%; animation:heroFloat 8s ease-in-out infinite; }
  .hero-orb-2 { width:150px; height:150px; background:rgba(6,182,212,0.1); bottom:-40px; left:15%; animation:heroFloat 10s ease-in-out infinite reverse; }
  .hero-orb-3 { width:100px; height:100px; background:rgba(16,185,129,0.08); top:30%; right:30%; animation:heroFloat 12s ease-in-out infinite; animation-delay:-4s; }
  @keyframes heroFloat { 0%,100% { transform:translateY(0) scale(1); } 50% { transform:translateY(-18px) scale(1.06); } }
  .hero-cta { display:inline-flex; align-items:center; gap:0.4rem; padding:0.5rem 1.1rem; border-radius:10px; font-size:0.8rem; font-weight:600; text-decoration:none; transition:all 0.25s cubic-bezier(0.4,0,0.2,1); cursor:pointer; }
  .hero-cta-primary { background:linear-gradient(135deg,#8b5cf6,#06b6d4); color:#fff; box-shadow:0 4px 16px rgba(139,92,246,0.25); border:none; }
  .hero-cta-primary:hover { box-shadow:0 8px 28px rgba(139,92,246,0.35); transform:translateY(-2px); }
  .hero-cta-outline { background:transparent; border:1px solid var(--glass-border); color:var(--text-1); backdrop-filter:blur(8px); }
  .hero-cta-outline:hover { border-color:rgba(139,92,246,0.35); background:rgba(139,92,246,0.05); transform:translateY(-1px); }
  .overview-stats .stat-card:nth-child(1) { border-top:2.5px solid rgba(139,92,246,0.5); }
  .overview-stats .stat-card:nth-child(2) { border-top:2.5px solid rgba(245,158,11,0.5); }
  .overview-stats .stat-card:nth-child(3) { border-top:2.5px solid rgba(139,92,246,0.5); }
  .overview-stats .stat-card:nth-child(4) { border-top:2.5px solid rgba(6,182,212,0.5); }
  .overview-stats .stat-card:nth-child(5) { border-top:2.5px solid rgba(139,92,246,0.5); }
  .overview-stats .stat-card:nth-child(6) { border-top:2.5px solid rgba(16,185,129,0.5); }
  .overview-stats .stat-card:nth-child(7) { border-top:2.5px solid rgba(16,185,129,0.5); }
</style>

<div class="overview-hero animate-fade-up" style="background:linear-gradient(135deg, rgba(139,92,246,0.05), rgba(6,182,212,0.035), rgba(16,185,129,0.025));border:1px solid var(--glass-border)">
  <div class="hero-orb hero-orb-1"></div>
  <div class="hero-orb hero-orb-2"></div>
  <div class="hero-orb hero-orb-3"></div>
  <div style="position:relative;z-index:2">
    <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1rem">
      <div style="width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,#8b5cf6,#06b6d4);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(139,92,246,0.3)">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#fff" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83"/></svg>
      </div>
      <span style="font-size:0.68rem;font-weight:600;padding:0.2rem 0.65rem;border-radius:20px;background:rgba(139,92,246,0.1);border:1px solid rgba(139,92,246,0.2);color:#8b5cf6;letter-spacing:0.04em">ENTERPRISE AI</span>
    </div>
    <h1 class="animate-fade-up" style="font-size:2.1rem;font-weight:800;margin-bottom:0.4rem;line-height:1.15;letter-spacing:-0.025em;background:linear-gradient(135deg,var(--text-1) 30%,#8b5cf6 65%,#06b6d4);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">Agentic Platform</h1>
    <p class="animate-fade-up delay-100" style="color:var(--text-2);font-size:0.92rem;line-height:1.6;margin-bottom:1.25rem;max-width:600px">An <strong style="color:var(--text-1)">agent factory</strong> — build, register, and run hundreds of autonomous AI agents, each with its own model, tools, memory, and control logic.</p>
    <div class="animate-fade-up delay-200" style="display:flex;gap:0.6rem;flex-wrap:wrap">
      <a href="/run-agent" class="hero-cta hero-cta-primary">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="5 3 19 12 5 21 5 3"/></svg>
        Run Agent
      </a>
      <a href="/agent-builder" class="hero-cta hero-cta-outline">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        Build Agent
      </a>
      <a href="/docs" class="hero-cta hero-cta-outline">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        Docs
      </a>
    </div>
  </div>
</div>


<!-- Stats Row -->
<div class="overview-stats" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(130px, 1fr));gap:0.65rem;margin-bottom:1.75rem">
  <a href="/agents" class="stat-card animate-fade-up" style="text-decoration:none;color:inherit;cursor:pointer">
    <div class="stat-icon stat-icon-violet">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 1 0-16 0"/></svg>
    </div>
    <div class="stat-label">Agents</div>
    <div class="stat-number" id="stat-agents">-</div>
  </a>
  <a href="/skills" class="stat-card animate-fade-up delay-100" style="text-decoration:none;color:inherit;cursor:pointer">
    <div class="stat-icon stat-icon-amber">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
    </div>
    <div class="stat-label">Skills</div>
    <div class="stat-number" id="stat-skills">-</div>
  </a>
  <a href="/prompts" class="stat-card animate-fade-up delay-100" style="text-decoration:none;color:inherit;cursor:pointer">
    <div class="stat-icon stat-icon-violet">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
    </div>
    <div class="stat-label">Prompts</div>
    <div class="stat-number" id="stat-prompts">-</div>
  </a>
  <a href="/admin" class="stat-card animate-fade-up delay-100" style="text-decoration:none;color:inherit;cursor:pointer">
    <div class="stat-icon stat-icon-cyan">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83"/></svg>
    </div>
    <div class="stat-label">Models</div>
    <div class="stat-number" id="stat-models">-</div>
  </a>
  <a href="/tools" class="stat-card animate-fade-up delay-200" style="text-decoration:none;color:inherit;cursor:pointer">
    <div class="stat-icon stat-icon-violet">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
    </div>
    <div class="stat-label">Tools</div>
    <div class="stat-number" id="stat-tools">-</div>
  </a>
  <a href="/run-agent" class="stat-card animate-fade-up delay-200" style="text-decoration:none;color:inherit;cursor:pointer">
    <div class="stat-icon stat-icon-emerald">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    </div>
    <div class="stat-label">Sessions</div>
    <div class="stat-number" id="stat-sessions">-</div>
  </a>
  <a href="/documents" class="stat-card animate-fade-up delay-300" style="text-decoration:none;color:inherit;cursor:pointer">
    <div class="stat-icon stat-icon-emerald">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
    </div>
    <div class="stat-label">Documents</div>
    <div class="stat-number" id="stat-docs">-</div>
  </a>
</div>


<!-- Enterprise Architecture — Layered View (Build / Scale / Govern / Optimize) -->
<div class="card animate-fade-up delay-300" style="margin-top:1.5rem">
  <h3 style="margin-bottom:0.5rem">Platform Architecture</h3>
  <p style="color:var(--text-3);font-size:0.82rem;margin-bottom:1.25rem">Enterprise-grade agentic platform — four layers from <strong style="color:#8b5cf6">Build</strong> to <strong style="color:#06b6d4">Scale</strong> to <strong style="color:#10b981">Govern</strong> to <strong style="color:#f59e0b">Optimize</strong>. Each layer maps directly to platform capabilities.</p>

  <div style="overflow-x:auto">

    <!-- ════════════ BUILD LAYER ════════════ -->
    <div style="border:2px solid rgba(139,92,246,0.35);border-radius:16px;padding:1.25rem;margin-bottom:1rem;background:linear-gradient(135deg, rgba(139,92,246,0.04), rgba(139,92,246,0.01))">
      <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1rem">
        <div style="font-size:1.1rem;font-weight:700;color:#8b5cf6;letter-spacing:0.5px">Build</div>
        <span style="font-size:0.72rem;color:var(--text-3)">Agent Factory & Model Hub & Tools, Data, and Other Agents</span>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
        <!-- Left: Agent Factory & Model Hub -->
        <div>
          <div style="font-size:0.72rem;color:#a78bfa;font-weight:600;margin-bottom:0.5rem;letter-spacing:0.3px">Model Hub</div>
          <div style="display:flex;flex-wrap:wrap;gap:0.4rem">
            <span class="arch-pill arch-pill-active">Ollama (Local)</span>
            <span class="arch-pill arch-pill-active">Azure OpenAI</span>
            <span class="arch-pill arch-pill-active">OpenAI</span>
            <span class="arch-pill arch-pill-active">Azure AI Foundry</span>
            <span class="arch-pill arch-pill-warn" title="Planned: via LangChain ChatAnthropic">Anthropic Claude</span>
            <span class="arch-pill arch-pill-warn" title="Planned: via LangChain ChatGoogleGenerativeAI">Google Gemini</span>
            <span class="arch-pill arch-pill-warn" title="Planned: ultra-fast inference via Groq API">Groq</span>
            <span class="arch-pill arch-pill-warn" title="Planned: via LangChain ChatMistralAI">Mistral AI</span>
          </div>
          <div style="font-size:0.72rem;color:#a78bfa;font-weight:600;margin:0.75rem 0 0.5rem;letter-spacing:0.3px">Agent Factory</div>
          <div style="display:flex;flex-wrap:wrap;gap:0.4rem">
            <span class="arch-pill arch-pill-active">Agent Builder</span>
            <span class="arch-pill arch-pill-active">Skills Designer</span>
            <span class="arch-pill arch-pill-active">Prompt Library</span>
            <span class="arch-pill arch-pill-active">Agent Registry</span>
          </div>
          <div style="font-size:0.72rem;color:#a78bfa;font-weight:600;margin:0.75rem 0 0.5rem;letter-spacing:0.3px">Frameworks</div>
          <div style="display:flex;flex-wrap:wrap;gap:0.4rem">
            <span class="arch-pill arch-pill-active">LangChain</span>
            <span class="arch-pill arch-pill-active">LangGraph (ReAct)</span>
            <span class="arch-pill arch-pill-active">LlamaIndex (RAG)</span>
            <span class="arch-pill arch-pill-active">Langfuse Tracing</span>
            <span class="arch-pill arch-pill-warn" title="Planned: LangGraph interrupt nodes for human approval workflows">LangGraph HITL</span>
            <span class="arch-pill arch-pill-warn" title="Planned: LangGraph checkpoint-based state persistence across runs">LangGraph Checkpointing</span>
            <span class="arch-pill arch-pill-warn" title="Planned: JSON mode / structured output enforcement via Pydantic models">Structured Output</span>
          </div>
        </div>
        <!-- Right: Tools, Data & Connectivity -->
        <div>
          <div style="font-size:0.72rem;color:#a78bfa;font-weight:600;margin-bottom:0.5rem;letter-spacing:0.3px">Tools, Data & Connectivity</div>
          <div style="display:flex;flex-wrap:wrap;gap:0.4rem">
            <span class="arch-pill arch-pill-active">A2A Protocol</span>
            <span class="arch-pill arch-pill-active">MCP Servers</span>
            <span class="arch-pill arch-pill-active">RAG Pipeline</span>
            <span class="arch-pill arch-pill-active">Web Search</span>
            <span class="arch-pill arch-pill-active">Code Execution</span>
            <span class="arch-pill arch-pill-active">APIs & Connectors</span>
            <span class="arch-pill arch-pill-active">Marketplace</span>
            <span class="arch-pill arch-pill-warn" title="Planned: Google's open A2A interoperability protocol for cross-framework agent communication">Google A2A (open)</span>
            <span class="arch-pill arch-pill-warn" title="Planned: MCP 1.x Streamable HTTP transport (replaces SSE transport)">MCP 1.x Transport</span>
          </div>
          <div style="font-size:0.72rem;color:#a78bfa;font-weight:600;margin:0.75rem 0 0.5rem;letter-spacing:0.3px">Knowledge & Grounding</div>
          <div style="display:flex;flex-wrap:wrap;gap:0.4rem">
            <span class="arch-pill arch-pill-active">ChromaDB (vectors)</span>
            <span class="arch-pill arch-pill-active">Unstructured Docs</span>
            <span class="arch-pill arch-pill-active">Structured Data (SQL/CSV)</span>
            <span class="arch-pill arch-pill-active">RAG Evaluation</span>
            <span class="arch-pill arch-pill-warn">Grounding / Citations</span>
            <span class="arch-pill arch-pill-warn" title="Planned: BM25 + vector hybrid retrieval for higher precision">Hybrid Search (BM25+Vec)</span>
            <span class="arch-pill arch-pill-warn" title="Planned: Re-ranking retrieved chunks via cross-encoder for quality">Re-Ranking</span>
          </div>
          <div style="font-size:0.72rem;color:#a78bfa;font-weight:600;margin:0.75rem 0 0.5rem;letter-spacing:0.3px">Workflow Orchestration</div>
          <div style="display:flex;flex-wrap:wrap;gap:0.4rem">
            <span class="arch-pill arch-pill-active">n8n Automation</span>
            <span class="arch-pill arch-pill-active">Scheduled Runs</span>
            <span class="arch-pill arch-pill-active">Webhook Triggers</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ════════════ SCALE LAYER ════════════ -->
    <div style="border:2px solid rgba(6,182,212,0.35);border-radius:16px;padding:1.25rem;margin-bottom:1rem;background:linear-gradient(135deg, rgba(6,182,212,0.04), rgba(6,182,212,0.01))">
      <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1rem">
        <div style="font-size:1.1rem;font-weight:700;color:#06b6d4;letter-spacing:0.5px">Scale</div>
        <span style="font-size:0.72rem;color:var(--text-3)">Agent Runtime, Sessions, Sandbox & Memory</span>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:0.4rem">
        <span class="arch-pill arch-pill-active">Agent Runtime (FastAPI)</span>
        <span class="arch-pill arch-pill-active">Agent Sessions</span>
        <span class="arch-pill arch-pill-active">Short-Term Memory</span>
        <span class="arch-pill arch-pill-active">Long-Term Summaries</span>
        <span class="arch-pill arch-pill-active">Agent Registry (SQLite)</span>
        <span class="arch-pill arch-pill-active">SSE Streaming</span>
        <span class="arch-pill arch-pill-warn">Agent Sandbox</span>
        <span class="arch-pill arch-pill-warn">Semantic Memory Bank</span>
        <span class="arch-pill arch-pill-warn">Multi-Tenant</span>
        <span class="arch-pill arch-pill-warn" title="Planned: LangGraph interrupt nodes — pause mid-run for human review/approval">Interrupt / HITL</span>
        <span class="arch-pill arch-pill-warn" title="Planned: Checkpoint-based state persistence — resume long-running agents after interruption">LangGraph Checkpoints</span>
        <span class="arch-pill arch-pill-warn" title="Planned: Enforce JSON output schema via Pydantic models with .with_structured_output()">Structured Output Mode</span>
      </div>
    </div>

    <!-- ════════════ GOVERN LAYER ════════════ -->
    <div style="border:2px solid rgba(16,185,129,0.35);border-radius:16px;padding:1.25rem;margin-bottom:1rem;background:linear-gradient(135deg, rgba(16,185,129,0.04), rgba(16,185,129,0.01))">
      <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1rem">
        <div style="font-size:1.1rem;font-weight:700;color:#10b981;letter-spacing:0.5px">Govern</div>
        <span style="font-size:0.72rem;color:var(--text-3)">Guardrails, Observability, Traceability &amp; Evaluation</span>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
        <!-- Left column -->
        <div>
          <!-- Guardrails -->
          <div style="border:1.5px solid rgba(245,158,11,0.25);border-radius:12px;padding:0.85rem;margin-bottom:0.75rem;background:rgba(245,158,11,0.03)">
            <div style="display:flex;align-items:center;gap:0.4rem;margin-bottom:0.5rem">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span style="font-size:0.78rem;font-weight:700;color:#f59e0b">Guardrails</span>
              <span style="font-size:0.62rem;color:var(--text-3);margin-left:auto">Runtime Safety</span>
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:0.35rem">
              <span class="arch-pill arch-pill-active">PII Detection</span>
              <span class="arch-pill arch-pill-active">Prompt Injection Guard</span>
              <span class="arch-pill arch-pill-active">Toxicity Filter</span>
              <span class="arch-pill arch-pill-active">Output Length Control</span>
              <span class="arch-pill arch-pill-active">Topic Restriction</span>
              <span class="arch-pill arch-pill-active">Data Leak Prevention</span>
              <span class="arch-pill arch-pill-active">10 Guardrails (runtime)</span>
              <span class="arch-pill arch-pill-warn" title="Planned: Azure AI Content Safety integration for enterprise-grade content moderation">Azure AI Content Safety</span>
              <span class="arch-pill arch-pill-warn" title="Planned: Jailbreak detection patterns for adversarial prompt resistance">Jailbreak Detection</span>
            </div>
          </div>
          <!-- Traceability -->
          <div style="border:1.5px solid rgba(6,182,212,0.25);border-radius:12px;padding:0.85rem;background:rgba(6,182,212,0.03)">
            <div style="display:flex;align-items:center;gap:0.4rem;margin-bottom:0.5rem">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#06b6d4" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
              <span style="font-size:0.78rem;font-weight:700;color:#06b6d4">Traceability</span>
              <span style="font-size:0.62rem;color:var(--text-3);margin-left:auto">Distributed Traces</span>
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:0.35rem">
              <span class="arch-pill arch-pill-active">OpenTelemetry</span>
              <span class="arch-pill arch-pill-active">LLM Tracing (Langfuse)</span>
              <span class="arch-pill arch-pill-active">Traceability Dashboard</span>
            </div>
          </div>
        </div>
        <!-- Right column -->
        <div>
          <!-- Observability -->
          <div style="border:1.5px solid rgba(99,102,241,0.25);border-radius:12px;padding:0.85rem;margin-bottom:0.75rem;background:rgba(99,102,241,0.03)">
            <div style="display:flex;align-items:center;gap:0.4rem;margin-bottom:0.5rem">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#6366f1" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
              <span style="font-size:0.78rem;font-weight:700;color:#6366f1">Observability</span>
              <span style="font-size:0.62rem;color:var(--text-3);margin-left:auto">Metrics &amp; Dashboards</span>
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:0.35rem">
              <span class="arch-pill arch-pill-active">Prometheus Metrics</span>
              <span class="arch-pill arch-pill-active">Grafana Dashboards</span>
              <span class="arch-pill arch-pill-active">Loki Log Aggregation</span>
              <span class="arch-pill arch-pill-active">Intelligence Hub</span>
              <span class="arch-pill arch-pill-active">Control Matrix</span>
            </div>
          </div>
          <!-- Evaluation -->
          <div style="border:1.5px solid rgba(139,92,246,0.25);border-radius:12px;padding:0.85rem;background:rgba(139,92,246,0.03)">
            <div style="display:flex;align-items:center;gap:0.4rem;margin-bottom:0.5rem">
