<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> — Agentic Platform</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/theme-enterprise.css" />
  <link rel="stylesheet" href="/theme-softui.css" />
  <link rel="stylesheet" href="/theme-flux.css" />
  <script>
    // Apply saved design theme BEFORE render to avoid flash
    (function(){
      var dt = localStorage.getItem('designTheme');
      if (dt === 'enterprise') document.documentElement.classList.add('theme-enterprise');
      else if (dt === 'softui') document.documentElement.classList.add('theme-softui');
      else if (dt === 'flux') document.documentElement.classList.add('theme-flux');
      if (localStorage.getItem('sidebarExpanded') === 'true') document.documentElement.classList.add('sidebar-expanded');
    })();
  </script>
</head>
<body>
  <!-- ── Icon Rail ── -->
  <aside class="icon-rail">
    <!-- Logo -->
    <div class="rail-logo">
      <div class="rail-logo-icon">
        <svg viewBox="0 0 48 48" width="42" height="42" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="lg-s1" x1="0" y1="0" x2="48" y2="48" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#f472b6"/><stop offset="100%" stop-color="#ec4899"/>
            </linearGradient>
            <linearGradient id="lg-s2" x1="48" y1="0" x2="0" y2="48" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#c084fc"/><stop offset="100%" stop-color="#a78bfa"/>
            </linearGradient>
            <linearGradient id="lg-s3" x1="24" y1="48" x2="24" y2="0" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#38bdf8"/><stop offset="100%" stop-color="#0ea5e9"/>
            </linearGradient>
            <linearGradient id="lg-s4" x1="0" y1="48" x2="48" y2="0" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#34d399"/><stop offset="100%" stop-color="#10b981"/>
            </linearGradient>
            <linearGradient id="lg-s5" x1="0" y1="24" x2="48" y2="24" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#fbbf24"/><stop offset="100%" stop-color="#f59e0b"/>
            </linearGradient>
            <filter id="lg-glow"><feGaussianBlur stdDeviation="0.8" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
          </defs>
          <g filter="url(#lg-glow)">
            <path d="M23 2 L14 22 L24 20 Z" fill="url(#lg-s1)" opacity="0.9" transform="translate(-1,-0.5)"/>
            <path d="M25 2 L44 44 L25 22 Z" fill="url(#lg-s2)" opacity="0.85" transform="translate(1,0)"/>
            <path d="M13 23 L4 44 L24 34 Z" fill="url(#lg-s3)" opacity="0.8" transform="translate(-1,1)"/>
            <path d="M25 23 L44 44 L25 34 Z" fill="url(#lg-s4)" opacity="0.75" transform="translate(0.5,1)"/>
            <path d="M5 44 L43 44 L24 35 Z" fill="url(#lg-s5)" opacity="0.6" transform="translate(0,1.5)"/>
            <circle cx="24" cy="24" r="2" fill="white" opacity="0.5"/>
            <circle cx="24" cy="24" r="5" fill="white" opacity="0.08"/>
          </g>
        </svg>
      </div>
      <span class="rail-tooltip">Agentic Platform</span>
    </div>

    <!-- Nav Items -->
    <ul class="rail-nav">
      <!-- ── Landing ── -->
      <li>
        <a href="/" class="rail-item <%= page === 'overview' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <span class="rail-tooltip">Overview</span>
        </a>
      </li>
      <!-- ── Primary Action ── -->
      <li>
        <a href="/run-agent" class="rail-item <%= page === 'run-agent' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
          <span class="rail-tooltip">Run Agent</span>
        </a>
      </li>
      <li>
        <a href="/agent-builder" class="rail-item <%= page === 'agent-builder' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="M3 12h18"/><circle cx="12" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><circle cx="6" cy="12" r="2"/><circle cx="18" cy="12" r="2"/></svg>
          <span class="rail-tooltip">Agent Builder</span>
        </a>
      </li>
      <!-- ── Agent Configuration ── -->
      <li class="rail-group">
        <a href="/agent-hub" class="rail-item <%= ['agent-hub','agents','skills','prompts','tools'].includes(page) ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6" rx="1"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>
          <span class="rail-tooltip">Agent Factory</span>
        </a>
        <div class="rail-submenu">
          <div class="rail-submenu-title">Agent Factory</div>
          <a href="/agent-hub" class="<%= page === 'agent-hub' ? 'sub-active' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
            Overview
          </a>
          <a href="/agents" class="<%= page === 'agents' ? 'sub-active' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6" rx="1"/></svg>
            Agent Registry
          </a>
          <a href="/skills" class="<%= page === 'skills' ? 'sub-active' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            Skill Family
          </a>
          <a href="/prompts" class="<%= page === 'prompts' ? 'sub-active' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            Prompt Library
          </a>
          <a href="/tools" class="<%= page === 'tools' ? 'sub-active' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            Tools
          </a>
        </div>
      </li>
      <li>
        <a href="/ai-studio" class="rail-item <%= page === 'ai-studio' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/><polyline points="7 8 10 11 7 14"/><line x1="12" y1="14" x2="17" y2="14"/></svg>
          <span class="rail-tooltip">AI Studio <span style="font-size:0.55rem;padding:1px 4px;border-radius:3px;background:rgba(245,158,11,0.15);color:#f59e0b;margin-left:4px;font-weight:600">DEV</span></span>
        </a>
      </li>
      <!-- ── Data & Automation ── -->
      <li><div class="rail-divider"></div></li>
      <li>
        <a href="/documents" class="rail-item <%= page === 'documents' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
          <span class="rail-tooltip">Knowledge</span>
        </a>
      </li>
      <li>
        <a href="/data-ingestion" class="rail-item <%= page === 'data-ingestion' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><polyline points="8 11 12 15 16 11"/><path d="M20 21H4"/><path d="M20 16v5"/><path d="M4 16v5"/></svg>
          <span class="rail-tooltip">Data Ingestion</span>
        </a>
      </li>
      <li>
        <a href="/workflows" class="rail-item <%= page === 'workflows' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="3" x2="6" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/></svg>
          <span class="rail-tooltip">Workflows</span>
        </a>
      </li>
      <!-- ── Protocols ── -->
      <li><div class="rail-divider"></div></li>
      <li class="rail-group">
        <a href="/a2a" class="rail-item <%= ['a2a','mcp','rest'].includes(page) ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2v6"/><path d="M15 2v6"/><path d="M12 17v5"/><path d="M5 8h14a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z"/><circle cx="7.5" cy="11" r="1"/><circle cx="12" cy="11" r="1"/><circle cx="16.5" cy="11" r="1"/></svg>
          <span class="rail-tooltip">Protocols</span>
        </a>
        <div class="rail-submenu">
          <div class="rail-submenu-title">Protocols <span style="font-size:0.55rem;padding:1px 4px;border-radius:3px;background:rgba(245,158,11,0.15);color:#f59e0b;margin-left:4px;font-weight:600">DEV</span></div>
          <a href="/a2a" class="<%= page === 'a2a' ? 'sub-active' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            A2A Protocol <span style="font-size:0.55rem;padding:1px 4px;border-radius:3px;background:rgba(139,92,246,0.15);color:#8b5cf6;margin-left:3px;font-weight:600">BETA</span>
          </a>
          <a href="/mcp" class="<%= page === 'mcp' ? 'sub-active' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v6m0 8v6"/><circle cx="12" cy="12" r="4"/><path d="M4.93 4.93l4.24 4.24"/><path d="M14.83 14.83l4.24 4.24"/><path d="M2 12h6m8 0h6"/></svg>
            MCP Registry <span style="font-size:0.55rem;padding:1px 4px;border-radius:3px;background:rgba(139,92,246,0.15);color:#8b5cf6;margin-left:3px;font-weight:600">BETA</span>
          </a>
          <a href="/rest" class="<%= page === 'rest' ? 'sub-active' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            REST Console <span style="font-size:0.55rem;padding:1px 4px;border-radius:3px;background:rgba(245,158,11,0.15);color:#f59e0b;margin-left:3px;font-weight:600">DEV</span>
          </a>
        </div>
      </li>
      <!-- ── Monitoring ── -->
      <li><div class="rail-divider"></div></li>
      <li class="rail-group">
        <a href="/intelligence-hub" class="rail-item <%= ['intelligence-hub','traceability','evaluation','observability','llm-activity'].includes(page) ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          <span class="rail-tooltip">Intelligence Hub</span>
        </a>
        <div class="rail-submenu">
          <div class="rail-submenu-title">Intelligence Hub</div>
          <a href="/intelligence-hub" class="<%= page === 'intelligence-hub' ? 'sub-active' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            Overview
          </a>
          <a href="/llm-activity" class="<%= page === 'llm-activity' ? 'sub-active' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>
            LLM Activity
          </a>
          <a href="/traceability" class="<%= page === 'traceability' ? 'sub-active' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="2"/><path d="M22 12h-4"/><path d="M6 12H2"/></svg>
            Traceability
          </a>
          <a href="/evaluation" class="<%= page === 'evaluation' ? 'sub-active' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            Evaluation
          </a>
          <a href="/observability" class="<%= page === 'observability' ? 'sub-active' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            Observability
          </a>
        </div>
      </li>
      <li>
        <a href="/guardrails" class="rail-item <%= page === 'guardrails' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span class="rail-tooltip">Guardrails</span>
        </a>
      </li>
      <!-- ── System ── -->
      <li><div class="rail-divider"></div></li>
      <li>
        <a href="/marketplace" class="rail-item <%= page === 'marketplace' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
          <span class="rail-tooltip">Marketplace</span>
        </a>
      </li>
    </ul>

    <!-- Bottom: docs + admin + status -->
    <div class="rail-bottom">
      <a href="/docs" class="rail-item <%= page === 'docs' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        <span class="rail-tooltip">Documentation</span>
      </a>
      <% if (typeof user !== 'undefined' && user.role === 'admin') { %>
      <a href="/admin" class="rail-item <%= page === 'admin' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        <span class="rail-tooltip">Admin Plane <span style="font-size:0.55rem;padding:1px 4px;border-radius:3px;background:rgba(139,92,246,0.15);color:#8b5cf6;margin-left:3px;font-weight:600">BETA</span></span>
      </a>
      <% } %>
      <div class="rail-item" id="system-status-dot">
        <span class="pulse-dot-emerald"></span>
        <span class="rail-tooltip">System Healthy</span>
      </div>
    </div>
    <!-- Sidebar Toggle -->
    <button class="rail-toggle" onclick="toggleSidebar()" title="Expand sidebar">
      <svg class="rail-toggle-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </aside>

  <!-- ── Main Area ── -->
  <div class="main-wrapper">
    <!-- ── Top Bar ── -->
    <header class="topbar">
      <div class="topbar-left">
        <button class="mobile-hamburger" onclick="toggleMobileNav()" aria-label="Open navigation">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <span class="topbar-section">Agentic</span>
        <span class="topbar-slash">/</span>
        <span class="topbar-page"><%= title %></span>
      </div>
      <div class="topbar-right">
        <!-- Workspace Selector -->
        <div class="workspace-selector" style="display:flex;align-items:center;gap:6px;">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.6;flex-shrink:0"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <select id="workspace-select" onchange="switchWorkspace(this.value)" style="background:var(--card-bg);color:var(--text-primary);border:1px solid var(--border-color);border-radius:6px;padding:2px 8px;font-size:0.7rem;cursor:pointer;min-width:90px;">
            <option value="default">Default</option>
          </select>
        </div>
        <div class="topbar-divider"></div>
        <span class="badge badge-info" style="font-size:0.62rem;padding:2px 8px">local</span>
        <div class="topbar-divider"></div>
        <!-- User Profile Dropdown -->
        <div class="user-menu-wrapper" style="position:relative;">
          <button onclick="toggleUserMenu()" class="user-menu-trigger" style="display:flex;align-items:center;gap:6px;padding:4px 8px;border-radius:8px;border:none;background:transparent;cursor:pointer;transition:background 0.2s;" onmouseover="this.style.background='var(--hover-bg,rgba(148,163,184,0.08))'" onmouseout="this.style.background='transparent'">
            <div class="user-avatar-text" style="width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,rgba(139,92,246,0.3),rgba(6,182,212,0.3));display:flex;align-items:center;justify-content:center;font-size:0.65rem;font-weight:700;color:var(--text-1);border:1px solid rgba(148,163,184,0.15);">
              <%= (typeof user !== 'undefined' && user.display_name ? user.display_name.charAt(0).toUpperCase() : 'U') %>
            </div>
            <div style="display:flex;flex-direction:column;line-height:1.15;text-align:left;">
              <span class="user-display-name" style="font-size:0.7rem;font-weight:600;color:var(--text-1)"><%= (typeof user !== 'undefined' && user.display_name ? user.display_name : 'User') %></span>
              <span style="font-size:0.55rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.04em"><%= (typeof user !== 'undefined' && user.role ? user.role : 'member') %></span>
            </div>
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.4;flex-shrink:0;margin-left:2px;"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div id="user-dropdown" style="display:none;position:absolute;right:0;top:calc(100% + 6px);min-width:200px;border-radius:10px;border:1px solid var(--border-color);background:var(--card-bg);box-shadow:0 8px 32px rgba(0,0,0,0.18);z-index:100;overflow:hidden;backdrop-filter:blur(16px);">
            <div style="padding:12px 14px;border-bottom:1px solid var(--border-color);">
              <div style="font-size:0.75rem;font-weight:600;color:var(--text-1);"><%= (typeof user !== 'undefined' && user.display_name ? user.display_name : 'User') %></div>
              <div style="font-size:0.6rem;color:var(--text-3);margin-top:2px;"><%= (typeof user !== 'undefined' && user.email ? user.email : '') %></div>
            </div>
            <div style="padding:4px 0;">
              <button onclick="openProfileModal()" class="user-dropdown-item" style="display:flex;align-items:center;gap:8px;width:100%;padding:8px 14px;border:none;background:transparent;color:var(--text-2);font-size:0.7rem;cursor:pointer;transition:background 0.15s,color 0.15s;text-align:left;" onmouseover="this.style.background='var(--hover-bg,rgba(148,163,184,0.08))';this.style.color='var(--text-1)'" onmouseout="this.style.background='transparent';this.style.color='var(--text-2)'">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                My Profile
              </button>
              <button onclick="openChangePasswordModal()" class="user-dropdown-item" style="display:flex;align-items:center;gap:8px;width:100%;padding:8px 14px;border:none;background:transparent;color:var(--text-2);font-size:0.7rem;cursor:pointer;transition:background 0.15s,color 0.15s;text-align:left;" onmouseover="this.style.background='var(--hover-bg,rgba(148,163,184,0.08))';this.style.color='var(--text-1)'" onmouseout="this.style.background='transparent';this.style.color='var(--text-2)'">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Change Password
              </button>
            </div>
            <div style="border-top:1px solid var(--border-color);padding:4px 0;">
              <a href="/auth/logout" class="user-dropdown-item" style="display:flex;align-items:center;gap:8px;width:100%;padding:8px 14px;border:none;background:transparent;color:var(--text-2);font-size:0.7rem;cursor:pointer;transition:background 0.15s,color 0.15s;text-decoration:none;text-align:left;" onmouseover="this.style.background='rgba(239,68,68,0.08)';this.style.color='#ef4444'" onmouseout="this.style.background='transparent';this.style.color='var(--text-2)'">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                Sign Out
              </a>
            </div>
          </div>
        </div>
        <div class="topbar-divider"></div>
        <div class="topbar-status">
          <span class="pulse-dot-emerald" id="topbar-health-dot"></span>
          <span class="topbar-status-text" id="topbar-health-text">Connecting...</span>
        </div>
        <div class="topbar-divider"></div>
        <span class="topbar-version">v2.1.0</span>
        <div class="topbar-divider"></div>
        <button class="theme-toggle" onclick="toggleTheme()" title="Toggle theme">
          <svg id="theme-icon-sun" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;flex-shrink:0"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <svg id="theme-icon-moon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          <span id="theme-label">Light</span>
        </button>
      </div>
    </header>

    <!-- ── Page Content ── -->
    <main class="main-content">
      <div class="content-container">
        <%- body %>
      </div>
    </main>
  </div>

  <script>
    // ── Workspace Context ──
    function getWorkspaceId() {
      return localStorage.getItem('workspaceId') || 'default';
    }
    function switchWorkspace(wsId) {
      localStorage.setItem('workspaceId', wsId);
      location.reload();
    }
    async function loadWorkspaces() {
      try {
        const res = await fetch('/api/workspaces');
        const data = await res.json();
        const sel = document.getElementById('workspace-select');
        if (!sel || !Array.isArray(data)) return;
        sel.innerHTML = '';
        const current = getWorkspaceId();
        data.forEach(ws => {
          const opt = document.createElement('option');
          opt.value = ws.id;
          opt.textContent = ws.name;
          if (ws.id === current) opt.selected = true;
          sel.appendChild(opt);
        });
      } catch(e) { /* ignore */ }
    }
    // Override fetch to inject workspace header
    const _origFetch = window.fetch;
    window.fetch = function(url, opts) {
      opts = opts || {};
      opts.headers = opts.headers || {};
      if (typeof opts.headers.set === 'function') {
        if (!opts.headers.has('x-workspace-id')) opts.headers.set('x-workspace-id', getWorkspaceId());
        if (!opts.headers.has('x-user-role')) opts.headers.set('x-user-role', window.__userRole || 'member');
      } else {
        if (!opts.headers['x-workspace-id']) opts.headers['x-workspace-id'] = getWorkspaceId();
        if (!opts.headers['x-user-role']) opts.headers['x-user-role'] = window.__userRole || 'member';
      }
      return _origFetch.call(this, url, opts);
    };
    // Expose user context from server session
    window.__userRole = '<%= (typeof user !== "undefined" && user.role ? user.role : "member") %>';
    window.__userName = '<%= (typeof user !== "undefined" && user.username ? user.username : "") %>';
    window.__userDisplayName = '<%= (typeof user !== "undefined" && user.display_name ? user.display_name : "User") %>';
    window.__userEmail = '<%= (typeof user !== "undefined" && user.email ? user.email : "") %>';
    document.addEventListener('DOMContentLoaded', loadWorkspaces);

    // ── User Dropdown Menu ──
    function toggleUserMenu() {
      var dd = document.getElementById('user-dropdown');
      dd.style.display = dd.style.display === 'none' ? 'block' : 'none';
    }
    // Close dropdown when clicking outside
    document.addEventListener('click', function(e) {
      var wrapper = document.querySelector('.user-menu-wrapper');
      var dd = document.getElementById('user-dropdown');
      if (wrapper && dd && !wrapper.contains(e.target)) {
        dd.style.display = 'none';
      }
    });

    // ── Profile Modal ──
    function openProfileModal() {
      document.getElementById('user-dropdown').style.display = 'none';
      var existing = document.getElementById('profile-modal');
      if (existing) existing.remove();
      var m = document.createElement('div');
      m.id = 'profile-modal';
      m.style.cssText = 'position:fixed;inset:0;z-index:200;display:flex;align-items:center;justify-content:center;background:var(--modal-overlay);backdrop-filter:blur(6px);';
      m.onclick = function(e) { if (e.target === m) m.remove(); };
      m.innerHTML = '<div style="background:var(--modal-bg);border:1px solid var(--modal-border);border-radius:16px;padding:28px 32px;min-width:360px;max-width:440px;box-shadow:var(--modal-shadow);">'
        + '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;"><h3 style="margin:0;font-size:1.05rem;font-weight:700;color:var(--text-1);">My Profile</h3><button onclick="document.getElementById(\'profile-modal\').remove()" style="border:none;background:transparent;cursor:pointer;color:var(--text-3);font-size:1.3rem;line-height:1;padding:4px;">&times;</button></div>'
        + '<div style="display:flex;align-items:center;gap:16px;margin-bottom:24px;padding:16px;border-radius:12px;background:var(--modal-field-bg);">'
        + '<div style="width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,var(--accent),rgba(139,92,246,0.8));display:flex;align-items:center;justify-content:center;font-size:1.2rem;font-weight:700;color:#fff;flex-shrink:0;">' + escapeHtml(window.__userDisplayName.charAt(0).toUpperCase()) + '</div>'
        + '<div><div style="font-size:0.75rem;color:var(--text-3);margin-top:2px;">@' + escapeHtml(window.__userName) + '</div></div></div>'
        + '<div style="display:grid;gap:14px;">'
        + '<div><label style="display:block;font-size:0.68rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-3);margin-bottom:6px;">Display Name</label><input type="text" id="profile-display-name" value="' + escapeHtml(window.__userDisplayName) + '" style="width:100%;padding:10px 14px;border-radius:10px;background:var(--modal-field-bg);border:1px solid var(--modal-border);color:var(--text-1);font-size:0.82rem;box-sizing:border-box;" /></div>'
        + '<div style="display:flex;justify-content:space-between;align-items:center;padding:10px 14px;border-radius:10px;background:var(--modal-field-bg);"><span style="font-size:0.75rem;font-weight:500;color:var(--text-3);">Email</span><span style="font-size:0.75rem;color:var(--text-1);">' + escapeHtml(window.__userEmail) + '</span></div>'
        + '<div style="display:flex;justify-content:space-between;align-items:center;padding:10px 14px;border-radius:10px;background:var(--modal-field-bg);"><span style="font-size:0.75rem;font-weight:500;color:var(--text-3);">Role</span><span style="font-size:0.75rem;color:var(--text-1);text-transform:capitalize;">' + escapeHtml(window.__userRole) + '</span></div>'
        + '<div id="profile-save-msg" style="display:none;font-size:0.75rem;text-align:center;padding:10px 14px;border-radius:10px;"></div>'
        + '<button onclick="saveProfileName()" class="btn btn-primary" style="width:100%;padding:11px;border-radius:10px;font-size:0.78rem;font-weight:600;cursor:pointer;margin-top:4px;">Save Changes</button>'
        + '</div></div>';
      document.body.appendChild(m);
      document.getElementById('profile-display-name').focus();
    }
    async function saveProfileName() {
      var nameInput = document.getElementById('profile-display-name');
      var msgEl = document.getElementById('profile-save-msg');
      var newName = nameInput.value.trim();
      if (!newName) { msgEl.style.display = 'block'; msgEl.style.background = 'var(--danger-bg)'; msgEl.style.color = 'var(--danger)'; msgEl.textContent = 'Display name cannot be empty'; return; }
      try {
        var r = await fetch('/api/update-profile', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ display_name: newName }) });
        if (!r.ok) { var d = await r.json(); throw new Error(d.error || 'Failed'); }
        window.__userDisplayName = newName;
        var avatarEl = document.querySelector('.user-menu-wrapper .user-avatar-text');
        if (avatarEl) avatarEl.textContent = newName.charAt(0).toUpperCase();
        var nameEl = document.querySelector('.user-menu-wrapper .user-display-name');
        if (nameEl) nameEl.textContent = newName;
        msgEl.style.display = 'block'; msgEl.style.background = 'var(--success-bg)'; msgEl.style.color = 'var(--success)'; msgEl.textContent = 'Profile updated!';
        setTimeout(function() { var m = document.getElementById('profile-modal'); if (m) m.remove(); }, 1200);
      } catch(err) { msgEl.style.display = 'block'; msgEl.style.background = 'var(--danger-bg)'; msgEl.style.color = 'var(--danger)'; msgEl.textContent = err.message; }
    }

    // ── Change Password Modal ──
    function openChangePasswordModal() {
      document.getElementById('user-dropdown').style.display = 'none';
      var existing = document.getElementById('password-modal');
      if (existing) existing.remove();
      var m = document.createElement('div');
      m.id = 'password-modal';
      m.style.cssText = 'position:fixed;inset:0;z-index:200;display:flex;align-items:center;justify-content:center;background:var(--modal-overlay);backdrop-filter:blur(6px);';
      m.onclick = function(e) { if (e.target === m) m.remove(); };
      m.innerHTML = '<div style="background:var(--modal-bg);border:1px solid var(--modal-border);border-radius:16px;padding:28px 32px;min-width:360px;max-width:440px;box-shadow:var(--modal-shadow);">'
        + '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;"><h3 style="margin:0;font-size:1.05rem;font-weight:700;color:var(--text-1);">Change Password</h3><button onclick="document.getElementById(\'password-modal\').remove()" style="border:none;background:transparent;cursor:pointer;color:var(--text-3);font-size:1.3rem;line-height:1;padding:4px;">&times;</button></div>'
        + '<div id="pw-error" style="display:none;margin-bottom:14px;padding:10px 14px;border-radius:10px;background:var(--danger-bg);border:1px solid var(--danger-border);color:var(--danger);font-size:0.75rem;"></div>'
        + '<div id="pw-success" style="display:none;margin-bottom:14px;padding:10px 14px;border-radius:10px;background:var(--success-bg);border:1px solid var(--success-border);color:var(--success);font-size:0.75rem;"></div>'
        + '<form onsubmit="handleChangePassword(event)" style="display:grid;gap:14px;">'
        + '<div><label style="display:block;font-size:0.68rem;font-weight:600;text-transform:uppercase;letter-spacing:0.04em;color:var(--text-3);margin-bottom:6px;">New Password</label><input type="password" id="pw-new" required minlength="8" placeholder="Min. 8 characters" style="width:100%;padding:10px 14px;border-radius:10px;border:1px solid var(--modal-border);background:var(--modal-field-bg);color:var(--text-1);font-size:0.82rem;box-sizing:border-box;" /></div>'
        + '<div><label style="display:block;font-size:0.68rem;font-weight:600;text-transform:uppercase;letter-spacing:0.04em;color:var(--text-3);margin-bottom:6px;">Confirm Password</label><input type="password" id="pw-confirm" required minlength="8" placeholder="Re-enter password" style="width:100%;padding:10px 14px;border-radius:10px;border:1px solid var(--modal-border);background:var(--modal-field-bg);color:var(--text-1);font-size:0.82rem;box-sizing:border-box;" /></div>'
        + '<button type="submit" class="btn btn-primary" style="padding:11px;border-radius:10px;font-size:0.78rem;font-weight:600;cursor:pointer;margin-top:4px;">Update Password</button>'
        + '</form></div>';
      document.body.appendChild(m);
    }
    async function handleChangePassword(e) {
      e.preventDefault();
      var errEl = document.getElementById('pw-error');
      var succEl = document.getElementById('pw-success');
      errEl.style.display = 'none';
      succEl.style.display = 'none';
      var np = document.getElementById('pw-new').value;
      var cp = document.getElementById('pw-confirm').value;
      if (np.length < 8) { errEl.textContent = 'Password must be at least 8 characters.'; errEl.style.display = 'block'; return; }
      if (np !== cp) { errEl.textContent = 'Passwords do not match.'; errEl.style.display = 'block'; return; }
      try {
        var r = await fetch('/api/change-password', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ new_password: np }) });
        var d = await r.json();
        if (!r.ok) throw new Error(d.error || 'Failed');
        succEl.textContent = 'Password updated successfully!';
        succEl.style.display = 'block';
        document.getElementById('pw-new').value = '';
        document.getElementById('pw-confirm').value = '';
        setTimeout(function() { var m = document.getElementById('password-modal'); if (m) m.remove(); }, 1500);
      } catch(err) {
        errEl.textContent = err.message;
        errEl.style.display = 'block';
      }
    }

    // ── Global HTML Escape (XSS Prevention) ──
    function escapeHtml(str) {
      if (str == null) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    // ── Theme Toggle ──
    function toggleTheme() {
      const html = document.documentElement;
      const isDark = html.classList.contains('dark');
      html.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'light' : 'dark');
      updateThemeIcons();
    }
    function updateThemeIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      document.getElementById('theme-icon-sun').style.display = isDark ? 'block' : 'none';
      document.getElementById('theme-icon-moon').style.display = isDark ? 'none' : 'block';
      const label = document.getElementById('theme-label');
      if (label) label.textContent = isDark ? 'Light' : 'Dark';
    }
    // Restore theme
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme === 'light') document.documentElement.classList.remove('dark');
    updateThemeIcons();

    // ── Sidebar Toggle ──
    function toggleSidebar() {
      var html = document.documentElement;
      html.classList.toggle('sidebar-expanded');
      localStorage.setItem('sidebarExpanded', html.classList.contains('sidebar-expanded'));
    }

    // ── Expandable Rail Groups (collapsed by default in expanded sidebar) ──
    document.querySelectorAll('.rail-group > .rail-item').forEach(function(item) {
      item.addEventListener('click', function(e) {
        if (!document.documentElement.classList.contains('sidebar-expanded')) return;
        e.preventDefault();
        var group = item.closest('.rail-group');
        group.classList.toggle('open');
      });
    });
    // Enable smooth transitions after initial render (prevents flash on page load)
    requestAnimationFrame(function() {
      requestAnimationFrame(function() {
        document.documentElement.classList.add('sidebar-animated');
      });
    });

    // ── Design Theme Switcher ──
    function setDesignTheme(name) {
      var html = document.documentElement;
      html.classList.remove('theme-enterprise', 'theme-softui', 'theme-flux');
      if (name === 'enterprise') html.classList.add('theme-enterprise');
      else if (name === 'softui') html.classList.add('theme-softui');
      else if (name === 'flux') html.classList.add('theme-flux');
      localStorage.setItem('designTheme', name);
    }
    function getDesignTheme() {
      return localStorage.getItem('designTheme') || 'glass';
    }

    // ── Topbar Health Indicator ──
    fetch('/api/health-check').then(r=>r.json()).then(d=>{
      const allHealthy = d.services.every(s => s.status === 'healthy');
      const dot = document.getElementById('topbar-health-dot');
      const text = document.getElementById('topbar-health-text');
      if (allHealthy) {
        dot.className = 'pulse-dot-emerald';
        text.textContent = 'All Systems Healthy';
      } else {
        dot.className = 'pulse-dot-rose';
        text.textContent = d.services.filter(s=>s.status!=='healthy').length + ' service(s) down';
      }
    }).catch(()=>{
      document.getElementById('topbar-health-dot').className = 'pulse-dot-rose';
      document.getElementById('topbar-health-text').textContent = 'Disconnected';
    });

    // ── Toast Notifications ──
    function showToast(message, type = 'info', duration = 3500) {
      let container = document.getElementById('toast-container');
      if (!container) {
        container = document.createElement('div');
        container.id = 'toast-container';
        container.style.cssText = 'position:fixed;top:1rem;right:1rem;z-index:99999;display:flex;flex-direction:column;gap:0.5rem;pointer-events:none';
        document.body.appendChild(container);
      }
      const colors = { success:'#10b981', error:'#ef4444', info:'#06b6d4', warning:'#f59e0b' };
      const icons = { success:'✓', error:'✕', info:'ℹ', warning:'⚠' };
      const toast = document.createElement('div');
      toast.style.cssText = 'pointer-events:auto;display:flex;align-items:center;gap:0.5rem;padding:0.65rem 1rem;border-radius:10px;font-size:0.82rem;color:#fff;background:rgba(15,23,42,0.92);border:1px solid ' + (colors[type]||colors.info) + '40;backdrop-filter:blur(12px);box-shadow:0 8px 32px rgba(0,0,0,0.3);transform:translateX(120%);transition:transform 0.3s ease';
      toast.innerHTML = '<span style="font-size:1rem;color:' + (colors[type]||colors.info) + '">' + (icons[type]||icons.info) + '</span><span>' + escapeHtml(message) + '</span>';
      container.appendChild(toast);
      requestAnimationFrame(() => { toast.style.transform = 'translateX(0)'; });
      setTimeout(() => {
        toast.style.transform = 'translateX(120%)';
        setTimeout(() => toast.remove(), 350);
      }, duration);
    }

    // ── Global Detail Modal ──
    function showDetailModal(title, contentHtml) {
      let overlay = document.getElementById('detail-modal-overlay');
      if (!overlay) {
        overlay = document.createElement('div');
        overlay.id = 'detail-modal-overlay';
        overlay.style.cssText = 'position:fixed;inset:0;z-index:99998;background:rgba(0,0,0,0.6);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity 0.2s ease';
        overlay.addEventListener('click', function(e) { if (e.target === overlay) closeDetailModal(); });
        document.body.appendChild(overlay);
      }
      overlay.innerHTML = '<div style="background:var(--bg);border:1px solid var(--glass-border);border-radius:16px;padding:1.5rem;max-width:640px;width:90%;max-height:80vh;overflow-y:auto;box-shadow:0 25px 50px rgba(0,0,0,0.5);backdrop-filter:blur(12px);transform:scale(0.95);transition:transform 0.2s ease" id="detail-modal-body">' +
        '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">' +
          '<h3 style="margin:0;font-size:1.1rem">' + title + '</h3>' +
          '<button onclick="closeDetailModal()" style="background:none;border:none;color:var(--text-3);cursor:pointer;font-size:1.2rem;padding:0.25rem" title="Close">✕</button>' +
        '</div>' +
        '<div>' + contentHtml + '</div>' +
      '</div>';
      requestAnimationFrame(() => {
        overlay.style.opacity = '1';
        document.getElementById('detail-modal-body').style.transform = 'scale(1)';
      });
      document.addEventListener('keydown', _modalEscHandler);
    }
    function closeDetailModal() {
      const overlay = document.getElementById('detail-modal-overlay');
      if (overlay) {
        overlay.style.opacity = '0';
        setTimeout(() => overlay.remove(), 200);
      }
      document.removeEventListener('keydown', _modalEscHandler);
    }
    function _modalEscHandler(e) { if (e.key === 'Escape') closeDetailModal(); }
  </script>

  <!-- ── Test Agent Chat Panel ── -->
