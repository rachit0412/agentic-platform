<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> — Agentic Platform</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <!-- ── Icon Rail ── -->
  <aside class="icon-rail">
    <!-- Logo -->
    <div class="rail-logo">
      <div class="rail-logo-icon">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
      </div>
      <span class="rail-tooltip">Agentic Platform</span>
    </div>

    <!-- Nav Items -->
    <ul class="rail-nav">
      <li>
        <a href="/" class="rail-item <%= page === 'overview' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
          <span class="rail-tooltip">Overview</span>
        </a>
      </li>
      <li>
        <a href="/run-agent" class="rail-item <%= page === 'run-agent' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          <span class="rail-tooltip">Run Agent</span>
        </a>
      </li>
      <li>
        <a href="/documents" class="rail-item <%= page === 'documents' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          <span class="rail-tooltip">Documents</span>
        </a>
      </li>
      <li>
        <a href="/workflows" class="rail-item <%= page === 'workflows' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/></svg>
          <span class="rail-tooltip">Workflows</span>
        </a>
      </li>
      <li>
        <a href="/llm-activity" class="rail-item <%= page === 'llm-activity' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a9 9 0 0 1 9 9c0 3.9-3.1 7.1-5 8.9a13 13 0 0 1-4 2.1 13 13 0 0 1-4-2.1C6.1 18.1 3 14.9 3 11a9 9 0 0 1 9-9z"/><circle cx="12" cy="11" r="3"/></svg>
          <span class="rail-tooltip">LLM Activity</span>
        </a>
      </li>
      <li>
        <a href="/observability" class="rail-item <%= page === 'observability' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          <span class="rail-tooltip">Observability</span>
        </a>
      </li>
      <li>
        <a href="/marketplace" class="rail-item <%= page === 'marketplace' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          <span class="rail-tooltip">Marketplace</span>
        </a>
      </li>
      <li>
        <a href="/admin" class="rail-item <%= page === 'admin' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          <span class="rail-tooltip">Admin</span>
        </a>
      </li>
    </ul>

    <!-- Bottom: theme toggle + status -->
    <div class="rail-bottom">
      <button class="theme-toggle" onclick="toggleTheme()" title="Toggle theme">
        <svg id="theme-icon-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <svg id="theme-icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <div class="rail-item" id="system-status-dot">
        <span class="pulse-dot-emerald"></span>
        <span class="rail-tooltip">System Healthy</span>
      </div>
    </div>
  </aside>

  <!-- ── Main Area ── -->
  <div class="main-wrapper">
    <!-- ── Top Bar ── -->
    <header class="topbar">
      <div class="topbar-left">
        <span class="topbar-section">Agentic</span>
        <span class="topbar-slash">/</span>
        <span class="topbar-page"><%= title %></span>
      </div>
      <div class="topbar-right">
        <div class="topbar-status">
          <span class="pulse-dot-emerald" id="topbar-health-dot"></span>
          <span class="topbar-status-text" id="topbar-health-text">Connecting...</span>
        </div>
        <div class="topbar-divider"></div>
        <span class="topbar-version">v2.0.0</span>
      </div>
    </header>

    <!-- ── Page Content ── -->
    <main class="main-content">
      <div class="content-container">
        <%- body %>
      </div>
    </main>
  </div>

  <script>
    // ── Theme Toggle ──
    function toggleTheme() {
      const html = document.documentElement;
      const isDark = html.classList.contains('dark');
      html.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'light' : 'dark');
      updateThemeIcons();
    }
    function updateThemeIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      document.getElementById('theme-icon-sun').style.display = isDark ? 'block' : 'none';
      document.getElementById('theme-icon-moon').style.display = isDark ? 'none' : 'block';
    }
    // Restore theme
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme === 'light') document.documentElement.classList.remove('dark');
    updateThemeIcons();

    // ── Topbar Health Indicator ──
    fetch('/api/health-check').then(r=>r.json()).then(d=>{
      const allHealthy = d.services.every(s => s.status === 'healthy');
      const dot = document.getElementById('topbar-health-dot');
      const text = document.getElementById('topbar-health-text');
      if (allHealthy) {
        dot.className = 'pulse-dot-emerald';
        text.textContent = 'All Systems Healthy';
      } else {
        dot.className = 'pulse-dot-rose';
        text.textContent = d.services.filter(s=>s.status!=='healthy').length + ' service(s) down';
      }
    }).catch(()=>{
      document.getElementById('topbar-health-dot').className = 'pulse-dot-rose';
      document.getElementById('topbar-health-text').textContent = 'Disconnected';
    });
  </script>
</body>
</html>
