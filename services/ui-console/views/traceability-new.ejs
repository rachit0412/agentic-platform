<%- include('layout', { title: 'Traceability', page: 'traceability', body: `

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem">
  <div>
    <h1 class="text-glow-cyan" style="margin:0">Traceability</h1>
    <p style="color:var(--text-3);font-size:0.82rem;margin:0.25rem 0 0">LLM trace analytics, token usage &amp; latency distribution</p>
  </div>
  <div style="display:flex;gap:0.5rem;align-items:center">
    <label style="font-size:0.78rem;color:var(--text-3)">Agent:</label>
    <select id="la-agent-select" class="input" style="min-width:180px;font-size:0.82rem" onchange="laAgentChanged()">
      <option value="__all__">All Agents</option>
    </select>
    <button class="btn btn-sm" onclick="laRefresh()">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
      Refresh
    </button>
  </div>
</div>

<!-- Stats Row -->
<div class="grid-4 mb-2" style="margin-bottom:1.25rem">
  <div class="stat-card animate-fade-up">
    <div class="stat-icon stat-icon-cyan"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></div>
    <div class="stat-label">Total Traces</div>
    <div class="stat-number" id="stat-traces">-</div>
  </div>
  <div class="stat-card animate-fade-up delay-100">
    <div class="stat-icon stat-icon-emerald"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
    <div class="stat-label">Avg Latency</div>
    <div class="stat-number" id="stat-latency">-</div>
  </div>
  <div class="stat-card animate-fade-up delay-200">
    <div class="stat-icon stat-icon-violet"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg></div>
    <div class="stat-label">Tool Calls</div>
    <div class="stat-number" id="stat-tool-calls">-</div>
  </div>
  <div class="stat-card animate-fade-up delay-300">
    <div class="stat-icon" style="background:linear-gradient(135deg,rgba(244,63,94,0.15),rgba(244,63,94,0.08));color:#f43f5e"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg></div>
    <div class="stat-label">Errors</div>
    <div class="stat-number" id="stat-errors">-</div>
  </div>
</div>

<!-- Langfuse Dashboard -->
<div class="card animate-fade-up" style="margin-bottom:1.25rem">
  <div class="section-header mb-1">
    <div style="display:flex;align-items:center;gap:0.75rem">
      <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,rgba(244,63,94,0.15),rgba(244,63,94,0.08));display:flex;align-items:center;justify-content:center">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#f43f5e" stroke-width="2"><path d="M12 2a9 9 0 0 1 9 9c0 3.9-3.1 7.1-5 8.9a13 13 0 0 1-4 2.1 13 13 0 0 1-4-2.1C6.1 18.1 3 14.9 3 11a9 9 0 0 1 9-9z"/><circle cx="12" cy="11" r="3"/></svg>
      </div>
      <div>
        <h3 style="margin:0;font-size:0.95rem">Langfuse Analytics</h3>
        <p style="margin:0.15rem 0 0;color:var(--text-3);font-size:0.78rem">Token usage, latency distribution &amp; trace timeline</p>
      </div>
    </div>
    <a href="${urls.langfuse}" target="_blank" class="btn btn-primary btn-sm">Open Langfuse</a>
  </div>

  <!-- KPI row -->
  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:0.75rem;margin-bottom:1rem">
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:10px;padding:0.6rem 0.75rem;text-align:center">
      <div style="font-size:0.68rem;color:var(--text-3);margin-bottom:0.2rem">Total Tokens</div>
      <div style="font-size:1.05rem;font-weight:700;color:var(--text-1)" id="lf-tokens">-</div>
    </div>
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:10px;padding:0.6rem 0.75rem;text-align:center">
      <div style="font-size:0.68rem;color:var(--text-3);margin-bottom:0.2rem">Avg Tokens/Trace</div>
      <div style="font-size:1.05rem;font-weight:700;color:var(--text-1)" id="lf-avg-tokens">-</div>
    </div>
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:10px;padding:0.6rem 0.75rem;text-align:center">
      <div style="font-size:0.68rem;color:var(--text-3);margin-bottom:0.2rem">Success Rate</div>
      <div style="font-size:1.05rem;font-weight:700;color:#10b981" id="lf-success">-</div>
    </div>
    <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:10px;padding:0.6rem 0.75rem;text-align:center">
      <div style="font-size:0.68rem;color:var(--text-3);margin-bottom:0.2rem">P95 Latency</div>
      <div style="font-size:1.05rem;font-weight:700;color:#f59e0b" id="lf-p95">-</div>
    </div>
  </div>

  <!-- Latency distribution -->
  <div style="margin-bottom:1rem">
    <div style="font-size:0.75rem;font-weight:600;color:var(--text-2);margin-bottom:0.4rem">Latency Distribution</div>
    <div id="lf-latency-bars" style="display:flex;gap:2px;height:36px;align-items:flex-end;border-radius:6px;overflow:hidden"></div>
    <div style="display:flex;justify-content:space-between;font-size:0.62rem;color:var(--text-3);margin-top:0.2rem">
      <span>&lt;1s</span><span>1-3s</span><span>3-5s</span><span>5-10s</span><span>10s+</span>
    </div>
  </div>

  <!-- Trace Timeline -->
  <div>
    <div style="font-size:0.75rem;font-weight:600;color:var(--text-2);margin-bottom:0.4rem">Trace Timeline</div>
    <div id="lf-timeline" style="display:flex;flex-direction:column;gap:0.3rem;max-height:160px;overflow-y:auto"></div>
  </div>
</div>

<!-- Recent Traces Table -->
<div class="card animate-fade-up delay-100">
  <div class="section-header">
    <h3 style="font-size:0.95rem">Recent Traces</h3>
    <button class="btn btn-secondary btn-sm" onclick="loadTraces()">Refresh</button>
  </div>
  <div id="traces-table" class="mt-1" style="color:var(--text-3);font-size:0.82rem">Loading...</div>
</div>

<script>
/* ── STATE ── */
var laAllAgents = [];
var laAllTraces = [];
var laSelectedAgent = '__all__';

function laAgentChanged() {
  laSelectedAgent = document.getElementById('la-agent-select').value;
  renderTraces();
}

function laRefresh() { fetchAllData(); }
function loadTraces() { fetchAllData(); }

/* ── TRACE HELPERS ── */
function _traceLatency(t) {
  if (t.latency && t.latency > 0) return t.latency;
  if (t.updatedAt && t.timestamp) { var diff = new Date(t.updatedAt) - new Date(t.timestamp); if (diff > 0) return diff; }
  var meta = t.metadata || {};
  if (meta.duration_ms) return meta.duration_ms;
  return 0;
}

function _traceTokens(t) {
  var u = t.usage || t.totalUsage || {};
  var meta = t.metadata || {};
  if (meta.usage) u = meta.usage;
  return {
    input: u.promptTokens || u.inputTokens || u.input_tokens || u.prompt_tokens || u.input || 0,
    output: u.completionTokens || u.outputTokens || u.output_tokens || u.completion_tokens || u.output || 0,
    total: u.totalTokens || u.total_tokens || u.total || 0
  };
}

function _traceModel(t) {
  var meta = t.metadata || {};
  if (meta.model) return (meta.provider ? meta.provider + '/' : '') + meta.model;
  return '';
}

function getFilteredTraces() {
  if (laSelectedAgent === '__all__') return laAllTraces;
  var agent = laAllAgents.find(function(a) { return a.id === laSelectedAgent; });
  if (!agent) return laAllTraces;
  var agentName = agent.name.toLowerCase();
  var agentId = agent.id.toLowerCase();
  return laAllTraces.filter(function(t) {
    var name = (t.name || '').toLowerCase();
    var meta = JSON.stringify(t.metadata || {}).toLowerCase();
    return name.indexOf(agentName) !== -1 || meta.indexOf(agentName) !== -1 || meta.indexOf(agentId) !== -1;
  });
}

/* ── DATA FETCH ── */
function fetchAllData() {
  Promise.all([
    fetch('/api/agents').then(function(r) { return r.json(); }).catch(function() { return []; }),
    fetch('/api/traces').then(function(r) { return r.json(); }).catch(function() { return { traces: [] }; })
  ]).then(function(results) {
    laAllAgents = results[0].agents || results[0] || [];
    laAllTraces = results[1].traces || [];

    /* populate agent selector */
    var sel = document.getElementById('la-agent-select');
    var curVal = sel.value;
    var html = '<option value="__all__">All Agents</option>';
    laAllAgents.forEach(function(a) {
      html += '<option value="' + escapeHtml(a.id) + '"' + (a.id === curVal ? ' selected' : '') + '>' + escapeHtml(a.name) + (a.is_default ? ' (default)' : '') + '</option>';
    });
    sel.innerHTML = html;
    if (curVal && curVal !== '__all__') sel.value = curVal;
    laSelectedAgent = sel.value;

    renderTraces();
  }).catch(function(e) { console.error('fetchAllData failed:', e); });
}

/* ── RENDER TRACES ── */
function renderTraces() {
  var traces = getFilteredTraces();
  var el = document.getElementById('traces-table');

  document.getElementById('stat-traces').textContent = traces.length;
  var durations = traces.map(_traceLatency).filter(function(d) { return d > 0; });
  var avgMs = durations.length ? durations.reduce(function(a, b) { return a + b; }, 0) / durations.length : 0;
  document.getElementById('stat-latency').textContent = durations.length ? (avgMs / 1000).toFixed(1) + 's' : '-';

  var toolCount = 0;
  traces.forEach(function(t) {
    var meta = t.metadata || {};
    if (meta.tools_used && Array.isArray(meta.tools_used)) { toolCount += meta.tools_used.length; return; }
    if (t.observations) toolCount += t.observations.filter(function(o) { return o.type === 'SPAN' && (o.name || '').toLowerCase().indexOf('tool') !== -1; }).length;
  });
  document.getElementById('stat-tool-calls').textContent = toolCount;
  document.getElementById('stat-errors').textContent = traces.filter(function(t) { return t.status === 'ERROR'; }).length;

  /* Langfuse KPIs */
  var totalTokens = 0, tracesWithTokens = 0;
  traces.forEach(function(t) { var toks = _traceTokens(t); if (toks.total > 0) { totalTokens += toks.total; tracesWithTokens++; } });
  document.getElementById('lf-tokens').textContent = totalTokens > 0 ? totalTokens.toLocaleString() : '-';
  document.getElementById('lf-avg-tokens').textContent = tracesWithTokens > 0 ? Math.round(totalTokens / tracesWithTokens).toLocaleString() : '-';

  var successCount = traces.filter(function(t) { return t.status !== 'ERROR'; }).length;
  document.getElementById('lf-success').textContent = traces.length > 0 ? Math.round(successCount / traces.length * 100) + '%' : '-';
  document.getElementById('lf-success').style.color = (traces.length > 0 && successCount / traces.length < 0.9) ? '#f43f5e' : '#10b981';

  if (durations.length > 0) {
    var sorted = durations.slice().sort(function(a, b) { return a - b; });
    var p95idx = Math.min(Math.floor(sorted.length * 0.95), sorted.length - 1);
    document.getElementById('lf-p95').textContent = (sorted[p95idx] / 1000).toFixed(1) + 's';
  } else {
    document.getElementById('lf-p95').textContent = '-';
  }

  /* Latency bars */
  var buckets = [0, 0, 0, 0, 0];
  durations.forEach(function(ms) { var s = ms / 1000; if (s < 1) buckets[0]++; else if (s < 3) buckets[1]++; else if (s < 5) buckets[2]++; else if (s < 10) buckets[3]++; else buckets[4]++; });
  var maxBucket = Math.max.apply(null, buckets.concat([1]));
  var colors = ['#10b981', '#06b6d4', '#f59e0b', '#f97316', '#f43f5e'];
  document.getElementById('lf-latency-bars').innerHTML = buckets.map(function(b, i) {
    var h = Math.max(4, b / maxBucket * 36);
    return '<div style="flex:1;background:' + colors[i] + ';height:' + h + 'px;border-radius:3px;opacity:0.85;position:relative" title="' + b + ' traces"><span style="position:absolute;top:-13px;left:50%;transform:translateX(-50%);font-size:0.58rem;color:var(--text-3)">' + b + '</span></div>';
  }).join('');

  /* Timeline */
  var timelineEl = document.getElementById('lf-timeline');
  if (traces.length === 0) {
    timelineEl.innerHTML = '<div style="color:var(--text-3);font-size:0.78rem;padding:0.5rem">No traces yet \\u2014 run an agent prompt to generate data</div>';
  } else {
    var maxDuration = Math.max.apply(null, durations.concat([1]));
    timelineEl.innerHTML = traces.slice(0, 12).map(function(t) {
      var lat = _traceLatency(t);
      var dur = lat > 0 ? (lat / 1000).toFixed(1) + 's' : '-';
      var time = t.timestamp ? new Date(t.timestamp).toLocaleTimeString() : '-';
      var statusColor = t.status === 'ERROR' ? '#f43f5e' : '#10b981';
      var barWidth = lat > 0 ? Math.max(8, Math.min(100, lat / maxDuration * 100)) : 8;
      return '<div style="display:flex;align-items:center;gap:0.4rem;font-size:0.72rem">' +
        '<span style="width:6px;height:6px;border-radius:50%;background:' + statusColor + ';flex-shrink:0"></span>' +
        '<span style="width:55px;flex-shrink:0;color:var(--text-3);font-family:monospace;font-size:0.65rem">' + time + '</span>' +
        '<span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text-2)">' + escapeHtml(t.name || (t.id ? t.id.slice(0, 12) : '-')) + '</span>' +
        '<div style="width:90px;height:7px;background:var(--glass-bg);border-radius:4px;overflow:hidden;flex-shrink:0"><div style="width:' + barWidth + '%;height:100%;background:' + (lat > 5000 ? '#f59e0b' : '#06b6d4') + ';border-radius:4px"></div></div>' +
        '<span style="width:36px;text-align:right;font-family:monospace;font-size:0.65rem;color:var(--text-3);flex-shrink:0">' + dur + '</span></div>';
    }).join('');
  }

  /* Table */
  if (traces.length === 0) {
    el.innerHTML = '<p style="color:var(--text-3)">No traces found. Run an agent prompt to generate traces.</p>';
    return;
  }
  var rows = traces.map(function(t) {
    var lat = _traceLatency(t);
    var latStr = lat > 0 ? (lat / 1000).toFixed(2) + 's' : '-';
    var toks = _traceTokens(t);
    var tokStr = toks.total > 0 ? toks.total.toLocaleString() : '-';
    var model = _traceModel(t);
    var statusBadge = t.status === 'ERROR'
      ? '<span style="color:#f43f5e;font-size:0.72rem">\\u2716 Error</span>'
      : '<span style="color:#10b981;font-size:0.72rem">\\u2714 OK</span>';
    var inputText = '-';
    if (t.input) { inputText = (typeof t.input === 'string' ? t.input : JSON.stringify(t.input)).slice(0, 50); }
    return '<tr>' +
      '<td class="mono" style="font-size:0.78rem">' + escapeHtml((t.id || '').slice(0, 10)) + '</td>' +
      '<td>' + escapeHtml(t.name || '-') + '</td>' +
      '<td class="mono" style="font-size:0.78rem">' + escapeHtml((t.sessionId || '-').slice(0, 12)) + '</td>' +
      '<td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + escapeHtml(inputText) + '</td>' +
      '<td class="mono" style="font-size:0.72rem;color:var(--text-3)">' + escapeHtml(model || '-') + '</td>' +
      '<td class="mono" style="font-size:0.78rem;color:' + (toks.total > 0 ? '#8b5cf6' : 'var(--text-3)') + '">' + tokStr + '</td>' +
      '<td class="mono" style="font-size:0.78rem;color:' + (lat > 5000 ? '#f59e0b' : lat > 0 ? '#10b981' : 'var(--text-3)') + '">' + latStr + '</td>' +
      '<td>' + statusBadge + '</td>' +
      '<td><button class="btn btn-secondary btn-sm" onclick="viewTrace(\\'' + escapeHtml(t.id || '') + '\\')">Detail</button></td></tr>';
  });
  el.innerHTML = '<table><tr><th>Trace ID</th><th>Name</th><th>Session</th><th>Input</th><th>Model</th><th>Tokens</th><th>Latency</th><th>Status</th><th></th></tr>' + rows.join('') + '</table>';
}

function viewTrace(traceId) {
  if (!traceId) return;
  showDetailModal('Loading Trace...', '<p style="color:var(--text-3)">Fetching trace detail...</p>');
  fetch('/api/traces/' + encodeURIComponent(traceId)).then(function(r) { return r.json(); }).then(function(d) {
    var t = d.trace || d;
    var lat = _traceLatency(t);
    var toks = _traceTokens(t);
    var model = _traceModel(t);

    var html = '<div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;margin-bottom:1rem">';
    html += '<div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:10px;padding:0.85rem">';
    html += '<div style="font-size:0.68rem;font-weight:600;color:var(--text-3);text-transform:uppercase;margin-bottom:0.5rem">Trace Info</div>';
    html += '<div style="display:flex;flex-direction:column;gap:0.35rem">';
    html += '<div style="display:flex;justify-content:space-between"><span style="color:var(--text-3);font-size:0.75rem">Trace ID</span><span class="mono" style="font-size:0.72rem">' + escapeHtml((t.id || '-').slice(0, 16)) + '</span></div>';
    html += '<div style="display:flex;justify-content:space-between"><span style="color:var(--text-3);font-size:0.75rem">Session</span><span class="mono" style="font-size:0.72rem">' + escapeHtml(t.sessionId || '-') + '</span></div>';
    html += '<div style="display:flex;justify-content:space-between"><span style="color:var(--text-3);font-size:0.75rem">Timestamp</span><span style="font-size:0.75rem">' + (t.timestamp ? new Date(t.timestamp).toLocaleString() : '-') + '</span></div>';
    html += '<div style="display:flex;justify-content:space-between"><span style="color:var(--text-3);font-size:0.75rem">Status</span><span style="color:' + (t.status === 'ERROR' ? '#f43f5e' : '#10b981') + ';font-weight:600;font-size:0.75rem">' + (t.status === 'ERROR' ? '\\u2716 Error' : '\\u2714 Success') + '</span></div>';
    html += '</div></div>';

    html += '<div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:10px;padding:0.85rem">';
    html += '<div style="font-size:0.68rem;font-weight:600;color:var(--text-3);text-transform:uppercase;margin-bottom:0.5rem">Performance</div>';
    html += '<div style="display:flex;flex-direction:column;gap:0.35rem">';
    html += '<div style="display:flex;justify-content:space-between"><span style="color:var(--text-3);font-size:0.75rem">Latency</span><span style="font-weight:600;font-size:0.78rem;color:' + (lat > 5000 ? '#f59e0b' : '#10b981') + '">' + (lat > 0 ? (lat / 1000).toFixed(2) + 's' : '-') + '</span></div>';
    if (model) html += '<div style="display:flex;justify-content:space-between"><span style="color:var(--text-3);font-size:0.75rem">Model</span><span class="mono" style="font-size:0.72rem">' + escapeHtml(model) + '</span></div>';
    html += '<div style="display:flex;justify-content:space-between"><span style="color:var(--text-3);font-size:0.75rem">Tokens In</span><span class="mono" style="font-size:0.75rem;color:#8b5cf6">' + (toks.input > 0 ? toks.input.toLocaleString() : '-') + '</span></div>';
    html += '<div style="display:flex;justify-content:space-between"><span style="color:var(--text-3);font-size:0.75rem">Tokens Out</span><span class="mono" style="font-size:0.75rem;color:#06b6d4">' + (toks.output > 0 ? toks.output.toLocaleString() : '-') + '</span></div>';
    html += '<div style="display:flex;justify-content:space-between"><span style="color:var(--text-3);font-size:0.75rem">Total Tokens</span><span class="mono" style="font-size:0.75rem;font-weight:600">' + (toks.total > 0 ? toks.total.toLocaleString() : '-') + '</span></div>';
    html += '</div></div></div>';

    html += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;margin-bottom:1rem">';
    var inputStr = t.input ? (typeof t.input === 'string' ? t.input : JSON.stringify(t.input, null, 2)).slice(0, 500) : '-';
    var outputStr = t.output ? (typeof t.output === 'string' ? t.output : JSON.stringify(t.output, null, 2)).slice(0, 1000) : '-';
    html += '<div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:10px;padding:0.85rem"><div style="font-size:0.68rem;font-weight:600;color:var(--text-3);text-transform:uppercase;margin-bottom:0.4rem">Input</div><div style="white-space:pre-wrap;font-size:0.78rem;color:var(--text-1);max-height:120px;overflow-y:auto;word-break:break-word">' + escapeHtml(inputStr) + '</div></div>';
    html += '<div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:10px;padding:0.85rem"><div style="font-size:0.68rem;font-weight:600;color:var(--text-3);text-transform:uppercase;margin-bottom:0.4rem">Output</div><div style="white-space:pre-wrap;font-size:0.78rem;color:var(--text-1);max-height:180px;overflow-y:auto;word-break:break-word">' + escapeHtml(outputStr) + '</div></div></div>';

    var obs = d.observations || [];
    if (obs.length > 0) {
      html += '<div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:10px;padding:0.85rem">';
      html += '<div style="font-size:0.68rem;font-weight:600;color:var(--text-3);text-transform:uppercase;margin-bottom:0.5rem">Steps (' + obs.length + ')</div>';
      html += '<div style="display:flex;flex-direction:column;gap:0.4rem">';
      obs.forEach(function(o) {
        var isGen = o.type === 'GENERATION';
        var isTool = (o.name || '').toLowerCase().indexOf('tool') !== -1;
