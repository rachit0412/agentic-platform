  // ── Best-practice validation ──
  var SECRET_PATTERNS = ['sk-','api_key','apikey','secret','password','token','aws_access','aws_secret','bearer ','ghp_','gho_','-----begin','akia'];
  var VALID_PARAM_TYPES = ['string','number','boolean','array','object'];

  function validateSkill(payload) {
    var warnings = [];
    var errors = [];

    // Required fields
    if (!payload.name) errors.push('Name is required');
    if (!payload.description) warnings.push('Missing description \u2014 agents won\\x27t know when to activate this skill');
    if (!payload.system_prompt) warnings.push('Missing prompt \u2014 skill has no instructions for the model');

    // Security: secrets in prompt or constraints
    var lower = (payload.system_prompt || '').toLowerCase();
    SECRET_PATTERNS.forEach(function(pat) {
      if (lower.indexOf(pat.toLowerCase()) !== -1) {
        errors.push('Prompt contains a possible secret/credential ("' + pat + '"). Use env vars or MCP connections instead.');
      }
    });
    (payload.constraints || []).forEach(function(c, i) {
      SECRET_PATTERNS.forEach(function(pat) {
        if (c.toLowerCase().indexOf(pat.toLowerCase()) !== -1) {
          errors.push('Constraint ' + (i+1) + ' contains a possible secret ("' + pat + '").');
        }
      });
    });

    // Prompt length (~5k tokens = ~20k chars)
    if ((payload.system_prompt || '').length > 20000) {
      warnings.push('Prompt exceeds ~5,000 tokens. Consider moving reference docs to external files.');
    }

    // Input parameters validation
    var seenNames = {};
    (payload.input_parameters || []).forEach(function(p, i) {
      if (!p.name || !p.name.trim()) {
        errors.push('Input parameter ' + (i+1) + ': name is required');
      } else {
        if (seenNames[p.name]) errors.push('Duplicate parameter name: "' + p.name + '"');
        seenNames[p.name] = true;
        if (!/^[a-zA-Z0-9_-]+$/.test(p.name)) {
          errors.push('Parameter "' + p.name + '": name must be alphanumeric (underscores/hyphens allowed)');
        }
      }
      if (p.type && VALID_PARAM_TYPES.indexOf(p.type) === -1) {
        errors.push('Parameter "' + (p.name||i) + '": invalid type "' + p.type + '"');
      }
    });

    // Best-practice warnings (non-blocking)
    if ((payload.tool_ids || []).length === 0 && allTools.length > 0) {
      warnings.push('No tools selected \u2014 skill will have access to ALL tools (consider least privilege)');
    }
    if ((payload.constraints || []).length === 0) {
      warnings.push('No constraints defined \u2014 consider adding behavioral guardrails');
    }
    if ((payload.input_parameters || []).length === 0) {
      warnings.push('No input parameters \u2014 consider defining arguments for reusability');
    }

    return { errors: errors, warnings: warnings };
  }

  async function saveSkill() {
    const id = document.getElementById('edit-id').value;
    const payload = {
      name: document.getElementById('skill-name').value.trim(),
      description: document.getElementById('skill-desc').value.trim(),
      system_prompt: document.getElementById('skill-prompt').value.trim(),
      tool_ids: getSelectedTools(),
      constraints: document.getElementById('skill-constraints').value.split(',').map(s=>s.trim()).filter(Boolean),
      input_parameters: getParameters(),
    };

    // Run client-side validation
    var v = validateSkill(payload);
    if (v.errors.length) {
      showToast(v.errors[0], 'error');
      return;
    }
    if (v.warnings.length) {
      var msg = 'Validation warnings:\\n\\n' + v.warnings.map(function(w,i){return (i+1) + '. ' + w}).join('\\n') + '\\n\\nSave anyway?';
      if (!confirm(msg)) return;
    }

    try {
      const url = id ? '/api/skills/' + id : '/api/skills';
      const method = id ? 'PUT' : 'POST';
      const res = await fetch(url, { method, headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
      if (!res.ok) {
        var errBody;
        try { errBody = await res.json(); } catch(e2) { errBody = null; }
        var errMsg = (errBody && errBody.detail) ? (Array.isArray(errBody.detail) ? errBody.detail.map(function(d){return d.msg || d}).join('; ') : errBody.detail) : res.statusText;
        showToast('Save failed: ' + errMsg, 'error');
        return;
      }
      showToast(id ? 'Skill updated' : 'Skill created', 'success');
      clearDraft();
      hideForm();
      loadSkills();
    } catch(e) { showToast('Error: ' + e.message, 'error'); }
  }

  async function deleteSkill(id) {
    if (!confirm('Delete this skill?')) return;
    try {
      const res = await fetch('/api/skills/' + id, { method: 'DELETE' });
      if (!res.ok) { showToast('Delete failed: ' + res.statusText, 'error'); return; }
      showToast('Skill deleted', 'success');
      loadSkills();
    } catch(e) { showToast('Error: ' + e.message, 'error'); }
  }

  // ── Best Practices management (editable, stored in localStorage) ──
  const BP_KEY = 'skillBestPractices';
  const DEFAULT_BP = [
    'Write a clear, specific description so agents know WHEN to activate this skill (progressive disclosure)',
    'Keep prompts under 5,000 tokens \u2014 move reference docs, templates, and assets to external files',
    'Define input parameters with types and defaults for reusable, composable skills (like function arguments)',
    'Limit allowed tools to only what the skill needs (principle of least privilege)',
    'Add constraints as behavioral guardrails (e.g. "Max 500 words", "Always cite sources", "Never output PII")',
    'Include examples of expected inputs & outputs in the prompt for consistency and auditability',
    'Bundle scripts, reference materials, and templates alongside the skill for self-contained execution',
    'Capture domain expertise and org-specific workflows as repeatable, version-controlled procedures',
    'Design skills to be portable and cross-product \u2014 follow the Agent Skills open standard (agentskills.io)',
    'Use MCP connections for external services instead of hardcoding credentials or secrets',
    'Test your skill with edge cases and adversarial inputs before deploying to production'
  ];

  function getBP() {
    try {
      const stored = localStorage.getItem(BP_KEY);
      if (stored) return JSON.parse(stored);
    } catch(e) {}
    return DEFAULT_BP.slice();
  }

  function renderBP() {
    var items = getBP();
    document.getElementById('bp-list').innerHTML = items.map(function(item) {
      return '<li>' + escapeHtml(item) + '</li>';
    }).join('');
  }

  function toggleBPEdit() {
    var editor = document.getElementById('bp-editor');
    var view = document.getElementById('bp-view');
    var btn = document.getElementById('bp-edit-btn');
    if (editor.style.display === 'none') {
      document.getElementById('bp-textarea').value = getBP().join('\\n');
      editor.style.display = 'block';
      view.style.display = 'none';
      btn.textContent = 'Cancel';
    } else {
      editor.style.display = 'none';
      view.style.display = 'block';
      btn.textContent = 'Edit';
    }
  }

  function saveBP() {
    var lines = document.getElementById('bp-textarea').value.split('\\n').map(function(l){return l.trim()}).filter(Boolean);
    if (lines.length === 0) lines = DEFAULT_BP.slice();
    localStorage.setItem(BP_KEY, JSON.stringify(lines));
    renderBP();
    toggleBPEdit();
    showToast('Best practices updated', 'success');
  }

  function resetBP() {
    localStorage.removeItem(BP_KEY);
    renderBP();
    document.getElementById('bp-textarea').value = DEFAULT_BP.join('\\n');
    toggleBPEdit();
    showToast('Best practices reset to defaults', 'success');
  }

  // ── AI Enrich ──
  let _enrichResult = null;

  async function _loadEnrichModels() {
    var sel = document.getElementById('enrich-model');
    if (sel.options.length > 1) return;
    try {
      var r = await fetch('/api/models', { signal: AbortSignal.timeout(5000) });
      var d = await r.json();
      if (!d.models) return;
      d.models.forEach(function(m) {
        var opt = document.createElement('option');
        opt.value = m.provider + ':' + m.model;
        var provLabel = m.provider === 'azure-openai' ? 'Azure' : m.provider === 'openai' ? 'OpenAI' : m.provider === 'azure-foundry' ? 'Foundry' : 'Ollama';
        opt.textContent = provLabel + ' \u2014 ' + m.model;
        if (m.active) opt.selected = true;
        sel.appendChild(opt);
      });
    } catch(e) {}
  }

  async function enrichWithAI() {
    var name = document.getElementById('skill-name').value.trim();
    var desc = document.getElementById('skill-desc').value.trim();
    if (!name && !desc) {
      showToast('Enter at least a name or description before enriching', 'error');
      return;
    }
    var btn = document.getElementById('enrich-btn');
    btn.disabled = true;
    btn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:4px;animation:spin 1s linear infinite"><path d="M12 2v4m0 12v4m-7.07-3.93l2.83-2.83m8.48-8.48l2.83-2.83M2 12h4m12 0h4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83"/></svg> Enriching...';

    var payload = {
      name: name,
      description: desc,
      system_prompt: document.getElementById('skill-prompt').value.trim(),
      constraints: document.getElementById('skill-constraints').value.split(',').map(function(s){return s.trim()}).filter(Boolean),
      input_parameters: getParameters(),
      available_tools: allTools,
      best_practices: document.getElementById('enrich-bp-override').value.trim() || getBP().join('. '),
      directions: document.getElementById('enrich-directions').value.trim() || undefined
    };

    var modelVal = document.getElementById('enrich-model').value;
    if (modelVal) {
      var parts = modelVal.split(':');
      payload.provider = parts[0];
      payload.model = parts.slice(1).join(':');
    }

    try {
      showLlmUsageToastLoading('Enrich Skill');
      var r = await fetch('/api/skills/enrich', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify(payload)
      });
      var d = await r.json();
      if (d._llm_usage) showLlmUsageToast(d._llm_usage);
      if (d.error && !d.system_prompt) {
        showToast('Enrichment failed: ' + d.error, 'error');
        return;
      }
      _enrichResult = d;

      // Show preview
      var score = d.score || 0;
      var scoreEl = document.getElementById('enrich-score');
      scoreEl.textContent = score + '/10';
      scoreEl.style.background = score >= 7 ? '#10b98122' : score >= 4 ? '#f59e0b22' : '#ef444422';
      scoreEl.style.color = score >= 7 ? '#10b981' : score >= 4 ? '#f59e0b' : '#ef4444';

      var improvements = d.improvements || [];
      document.getElementById('enrich-improvements').innerHTML = improvements.length
        ? '<strong style="color:var(--text-2)">Improvements:</strong> ' + improvements.map(function(i){return '<span class="badge" style="margin:0.15rem">' + escapeHtml(i) + '</span>'}).join(' ')
        : '<span style="color:var(--text-2)">AI enrichment complete</span>';

      document.getElementById('ai-enrich-preview').style.display = 'block';
      document.getElementById('ai-enrich-preview').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      showToast('AI enrichment ready \u2014 review and accept', 'success');
    } catch(e) {
      showToast('Error: ' + e.message, 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:4px"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 16.8l-6.2 4.5 2.4-7.4L2 9.4h7.6z"/></svg> AI Enrich';
    }
  }

  function acceptEnrichment() {
    if (!_enrichResult) return;
    var d = _enrichResult;
    if (d.name) document.getElementById('skill-name').value = d.name;
    if (d.description) document.getElementById('skill-desc').value = d.description;
    if (d.system_prompt) document.getElementById('skill-prompt').value = d.system_prompt;
    if (d.constraints && d.constraints.length) document.getElementById('skill-constraints').value = d.constraints.join(', ');
    if (d.input_parameters && d.input_parameters.length) loadParametersIntoForm(d.input_parameters);
    if (d.suggested_tools && d.suggested_tools.length) {
      var validTools = d.suggested_tools.filter(function(t){return allTools.includes(t)});
      if (validTools.length) renderToolsDropdown(validTools);
    }
    dismissEnrichment();
    saveDraft();
    showToast('AI enrichment applied to form', 'success');
  }

  function dismissEnrichment() {
    document.getElementById('ai-enrich-preview').style.display = 'none';
    _enrichResult = null;
  }

  // ── Skill Family / Decompose ──
  let _decomposeResult = null;

  function toggleDecomposePanel() {
    var panel = document.getElementById('decompose-panel');
    if (panel.style.display === 'none') {
      panel.style.display = 'block';
      document.getElementById('decompose-concept').focus();
      // Load models into decompose selector
      var src = document.getElementById('enrich-model');
      var dst = document.getElementById('decompose-model');
      if (dst.options.length <= 1 && src.options.length > 1) {
        for (var i = 1; i < src.options.length; i++) {
          var opt = document.createElement('option');
          opt.value = src.options[i].value;
          opt.textContent = src.options[i].textContent;
          if (src.options[i].selected) opt.selected = true;
          dst.appendChild(opt);
        }
      }
      // Populate prompt library picker for decompose
      var picker = document.getElementById('decompose-prompt-picker');
      if (picker.options.length <= 1 && libraryPrompts.length) {
        picker.innerHTML = '<option value="">\u2014 Select from Prompt Library \u2014</option>' +
          libraryPrompts.map(function(p) {
            return '<option value="' + escapeHtml(p.id) + '">' + escapeHtml(p.name) + ' (' + escapeHtml(p.category) + ')' + '</option>';
          }).join('');
      }
    } else {
      panel.style.display = 'none';
    }
  }

  function applyLibraryPromptToDecompose() {
    var picker = document.getElementById('decompose-prompt-picker');
    var selected = libraryPrompts.find(function(p) { return p.id === picker.value; });
    if (selected) {
      document.getElementById('decompose-prompt').value = selected.content;
      if (!document.getElementById('decompose-concept').value.trim()) {
        document.getElementById('decompose-concept').value = selected.name;
      }
    }
    picker.value = '';
  }

  async function decomposeSkills() {
    var concept = document.getElementById('decompose-concept').value.trim();
    var basePrompt = document.getElementById('decompose-prompt').value.trim();
    if (!concept && !basePrompt) {
      showToast('Enter a concept or paste a base prompt', 'error');
      return;
    }
    var btn = document.getElementById('decompose-btn');
    btn.disabled = true;
    btn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:4px;animation:spin 1s linear infinite"><path d="M12 2v4m0 12v4m-7.07-3.93l2.83-2.83m8.48-8.48l2.83-2.83M2 12h4m12 0h4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83"/></svg> Generating...';

    var payload = {
      concept: concept,
      base_prompt: basePrompt,
      count: document.getElementById('decompose-count').value.trim() ? parseInt(document.getElementById('decompose-count').value) : null,
      available_tools: allTools,
      best_practices: getBP().join('. '),
      directions: document.getElementById('decompose-directions').value.trim() || undefined
    };
    var modelVal = document.getElementById('decompose-model').value;
    if (modelVal) {
      var parts = modelVal.split(':');
      payload.provider = parts[0];
      payload.model = parts.slice(1).join(':');
    }

    try {
      showLlmUsageToastLoading('Decompose Skills');
      var r = await fetch('/api/skills/decompose', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify(payload)
      });
      var d = await r.json();
      if (d._llm_usage) showLlmUsageToast(d._llm_usage);
      if (d.error && !d.skills) {
        showToast('Decompose failed: ' + d.error, 'error');
        return;
      }
      _decomposeResult = d;
      renderDecomposeResults(d);
      document.getElementById('decompose-panel').style.display = 'none';
      showToast('Skill family generated \u2014 review and save', 'success');
    } catch(e) {
      showToast('Error: ' + e.message, 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:4px"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg> Generate Skill Family';
    }
  }

  function renderDecomposeResults(d) {
    document.getElementById('decompose-family-name').textContent = d.family_name || 'Skill Family';
    document.getElementById('decompose-family-desc').textContent = d.family_description || '';
    var grid = document.getElementById('decompose-skills-grid');
    var skills = d.skills || [];
    grid.innerHTML = skills.map(function(s, idx) {
      var paramCount = (s.input_parameters || []).length;
      var constraintCount = (s.constraints || []).length;
      return '<div class="card animate-fade-up" id="decompose-skill-' + idx + '" style="position:relative;border:1px solid var(--glass-border)">' +
        '<div style="position:absolute;top:0.5rem;right:0.5rem;display:flex;gap:0.35rem">' +
          '<button class="btn btn-sm btn-primary" onclick="saveDecomposedSkill(' + idx + ')" style="font-size:0.7rem;padding:0.2rem 0.5rem" title="Save this skill">Save</button>' +
          '<button class="btn btn-sm" onclick="editDecomposedSkill(' + idx + ')" style="font-size:0.7rem;padding:0.2rem 0.5rem" title="Edit in form">Edit</button>' +
          '<button class="btn btn-sm btn-danger" onclick="removeDecomposedSkill(' + idx + ')" style="font-size:0.7rem;padding:0.2rem 0.35rem" title="Remove">' +
            '<svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>' +
          '</button>' +
        '</div>' +
        '<div style="margin-right:6rem">' +
          '<h4 style="margin:0;font-size:0.92rem;color:var(--text-1)">' + escapeHtml(s.name) + '</h4>' +
          '<span class="badge" style="font-size:0.65rem;margin-top:0.25rem;background:#f59e0b22;color:#f59e0b">' + escapeHtml(s.role_in_family || 'Skill') + '</span>' +
        '</div>' +
        '<p style="font-size:0.78rem;color:var(--text-3);margin:0.5rem 0;line-height:1.5">' + escapeHtml(s.description || '') + '</p>' +
        (s.system_prompt ? '<div style="background:var(--input-bg);border-radius:6px;padding:0.4rem 0.6rem;font-size:0.72rem;font-family:var(--mono);color:var(--text-2);max-height:50px;overflow:hidden;margin-bottom:0.4rem">' + escapeHtml((s.system_prompt||'').slice(0,120)) + (s.system_prompt.length > 120 ? '...' : '') + '</div>' : '') +
        '<div style="display:flex;flex-wrap:wrap;gap:0.25rem">' +
          (paramCount ? '<span class="badge" style="font-size:0.65rem;background:#6366f122;color:#818cf8">' + paramCount + ' param' + (paramCount > 1 ? 's' : '') + '</span>' : '') +
          (constraintCount ? '<span class="badge" style="font-size:0.65rem;background:#ef444422;color:#ef4444">' + constraintCount + ' constraint' + (constraintCount > 1 ? 's' : '') + '</span>' : '') +
          ((s.suggested_tools||[]).length ? '<span class="badge" style="font-size:0.65rem">' + (s.suggested_tools||[]).length + ' tool' + ((s.suggested_tools||[]).length > 1 ? 's' : '') + '</span>' : '') +
        '</div>' +
      '</div>';
    }).join('');
    document.getElementById('decompose-results').style.display = 'block';
    document.getElementById('decompose-results').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  async function saveDecomposedSkill(idx) {
    if (!_decomposeResult || !_decomposeResult.skills[idx]) return;
    var s = _decomposeResult.skills[idx];
    var payload = {
      name: s.name,
      description: s.description || '',
      system_prompt: s.system_prompt || '',
      tool_ids: (s.suggested_tools || []).filter(function(t){return allTools.includes(t)}),
      constraints: s.constraints || [],
      input_parameters: s.input_parameters || []
    };
    try {
      var res = await fetch('/api/skills', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(payload) });
      if (!res.ok) {
        var errBody;
        try { errBody = await res.json(); } catch(e2) { errBody = null; }
        var errMsg = (errBody && errBody.detail) ? (Array.isArray(errBody.detail) ? errBody.detail.map(function(d){return d.msg || d}).join('; ') : errBody.detail) : res.statusText;
        showToast('Save failed: ' + errMsg, 'error');
        return;
      }
      showToast(s.name + ' saved', 'success');
      var el = document.getElementById('decompose-skill-' + idx);
      if (el) el.remove();
      _decomposeResult.skills[idx]._saved = true;
      loadSkills();
      // Auto-dismiss if all skills saved
      if (_decomposeResult.skills.every(function(sk){ return sk._saved; })) {
        setTimeout(function(){ dismissDecompose(); }, 600);
      }
    } catch(e) { showToast('Error: ' + e.message, 'error'); }
  }

  function editDecomposedSkill(idx) {
    if (!_decomposeResult || !_decomposeResult.skills[idx]) return;
    var s = _decomposeResult.skills[idx];
    showCreateForm();
    document.getElementById('skill-name').value = s.name || '';
    document.getElementById('skill-desc').value = s.description || '';
    document.getElementById('skill-prompt').value = s.system_prompt || '';
    document.getElementById('skill-constraints').value = (s.constraints || []).join(', ');
    var validTools = (s.suggested_tools || []).filter(function(t){return allTools.includes(t)});
    if (validTools.length) renderToolsDropdown(validTools);
    if (s.input_parameters && s.input_parameters.length) loadParametersIntoForm(s.input_parameters);
    document.getElementById('skill-form').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function removeDecomposedSkill(idx) {
    var el = document.getElementById('decompose-skill-' + idx);
    if (el) el.remove();
  }

  async function saveAllDecomposed() {
    if (!_decomposeResult || !_decomposeResult.skills) return;
    var count = 0;
    for (var i = 0; i < _decomposeResult.skills.length; i++) {
      if (_decomposeResult.skills[i]._saved) continue;
      var el = document.getElementById('decompose-skill-' + i);
      if (!el) continue;
      await saveDecomposedSkill(i);
      count++;
    }
    if (count > 0) showToast(count + ' skill' + (count > 1 ? 's' : '') + ' saved', 'success');
    dismissDecompose();
  }

  function dismissDecompose() {
    document.getElementById('decompose-results').style.display = 'none';
    _decomposeResult = null;
  }

  async function suggestSkillsFromPrompt() {
    var prompt = document.getElementById('skill-prompt').value.trim();
    if (!prompt) {
      showToast('Write or paste a prompt first, then let AI suggest skills', 'error');
      return;
    }
    var btn = document.getElementById('suggest-from-prompt-btn');
    btn.disabled = true;
    var origHTML = btn.innerHTML;
    btn.innerHTML = '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" style="animation:spin 1s linear infinite"><path d="M12 2v4m0 12v4m-7.07-3.93l2.83-2.83m8.48-8.48l2.83-2.83M2 12h4m12 0h4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83"/></svg> Analyzing prompt...';

    var payload = {
      base_prompt: prompt,
      concept: '',
      count: 5,
      available_tools: allTools,
      best_practices: getBP().join('. '),
      directions: document.getElementById('enrich-directions').value.trim() || undefined
    };
    var modelVal = document.getElementById('enrich-model').value;
    if (modelVal) {
      var parts = modelVal.split(':');
      payload.provider = parts[0];
      payload.model = parts.slice(1).join(':');
    }

    try {
      showLlmUsageToastLoading('Decompose Skills');
      var r = await fetch('/api/skills/decompose', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify(payload)
      });
      var d = await r.json();
      if (d._llm_usage) showLlmUsageToast(d._llm_usage);
      if (d.error && !d.skills) {
        showToast('Failed: ' + d.error, 'error');
        return;
      }
      _decomposeResult = d;
      renderDecomposeResults(d);
      showToast('AI suggested ' + (d.skills||[]).length + ' skills from your prompt \u2014 review below', 'success');
    } catch(e) {
      showToast('Error: ' + e.message, 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = origHTML;
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    renderBP();
    loadSkills();
    loadTools().then(() => restoreDraft());
    loadLibraryPrompts();
    _loadEnrichModels();
  });
<\/script>

` }) %>
