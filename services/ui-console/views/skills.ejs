<%- include('layout', { title: 'Skills', page: 'skills', body: `

<h1 class="text-glow-cyan">Skills</h1>
<p class="subtitle" style="color:var(--text-3);margin-bottom:0.75rem">A skill is a <strong style="color:var(--text-1)">packaged capability</strong> that performs a specific task — logic + tools + optional data access, invoked by an agent or workflow.</p>
<p style="color:var(--text-3);font-size:0.78rem;margin-bottom:1.5rem;line-height:1.5">Think: <strong style="color:#f59e0b">reusable function with intelligence</strong>. Each skill contains a <em>prompt</em> (what the model should do), <em>tools</em> (what actions it can take), and <em>constraints</em> (behavioral guardrails).</p>

<!-- Action Bar -->
<div class="flex-between mb-2">
  <div style="display:flex;gap:0.5rem;align-items:center">
    <span id="skill-count" class="badge" style="font-size:0.78rem">0 skills</span>
  </div>
  <button class="btn btn-primary" onclick="showCreateForm()">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    New Skill
  </button>
</div>

<!-- Create / Edit Form -->
<div class="card animate-fade-up" id="skill-form" style="display:none">
  <h3 id="form-title">Create Skill</h3>
  <input type="hidden" id="edit-id" value="">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1rem">
    <div>
      <label class="field-label">Name</label>
      <input type="text" id="skill-name" class="input" placeholder="e.g. Code Reviewer" maxlength="100">
    </div>
    <div>
      <label class="field-label">Description</label>
      <input type="text" id="skill-desc" class="input" placeholder="Brief description" maxlength="1000">
    </div>
  </div>
  <div style="margin-top:1rem">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.25rem">
      <label class="field-label" style="margin-bottom:0">Prompt <span style="color:var(--text-3);font-weight:400;font-size:0.75rem">— the instructional context: what the model should do, how it should behave, what output is expected</span></label>
      <select id="prompt-library-picker" class="input" style="width:220px;height:30px;font-size:0.75rem" onchange="applyLibraryPrompt()">
        <option value="">— Select from Prompt Library —</option>
      </select>
    </div>
    <textarea id="skill-prompt" class="input" rows="5" placeholder="e.g. You are a deep research analyst. Break complex topics into sub-questions, search for evidence, cite sources, and synthesize a structured report..." style="resize:vertical;font-family:var(--mono)"></textarea>
  </div>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1rem">
    <div>
      <label class="field-label">Allowed Tools <span style="color:var(--text-3);font-weight:400">(select multiple, empty = all)</span></label>
      <select id="skill-tools" class="input" multiple style="height:120px;font-size:0.82rem"></select>
    </div>
    <div>
      <label class="field-label">Constraints <span style="color:var(--text-3);font-weight:400">(comma-separated rules)</span></label>
      <input type="text" id="skill-constraints" class="input" placeholder="e.g. Always cite sources, Max 500 words">
    </div>
  </div>
  <div style="display:flex;gap:0.75rem;margin-top:1.25rem">
    <button class="btn btn-primary" onclick="saveSkill()">Save</button>
    <button class="btn" onclick="hideForm()">Cancel</button>
  </div>
</div>

<!-- Skills Grid -->
<div id="skills-grid" class="grid-3" style="margin-top:1rem"></div>

<script>
  let allTools = [];
  let libraryPrompts = [];

  async function loadTools() {
    try {
      const r = await fetch('/api/tools');
      const d = await r.json();
      allTools = (d.tools || []).map(t => t.name);
      renderToolsDropdown([]);
    } catch(e) {}
  }

  function renderToolsDropdown(selectedIds) {
    const el = document.getElementById('skill-tools');
    el.innerHTML = allTools.map(t =>
      '<option value="' + escapeHtml(t) + '"' + (selectedIds.includes(t) ? ' selected' : '') + '>🔧 ' + escapeHtml(t) + '</option>'
    ).join('');
  }

  function getSelectedTools() {
    return Array.from(document.getElementById('skill-tools').selectedOptions).map(o => o.value);
  }

  async function loadLibraryPrompts() {
    try {
      const r = await fetch('/api/prompts');
      const d = await r.json();
      libraryPrompts = d.prompts || [];
      const picker = document.getElementById('prompt-library-picker');
      picker.innerHTML = '<option value="">— Select from Prompt Library —</option>' +
        libraryPrompts.map(p => '<option value="' + escapeHtml(p.id) + '">' + escapeHtml(p.name) + ' (' + escapeHtml(p.category) + ')' + '</option>').join('');
    } catch(e) {}
  }

  function applyLibraryPrompt() {
    const picker = document.getElementById('prompt-library-picker');
    const selected = libraryPrompts.find(p => p.id === picker.value);
    if (selected) {
      document.getElementById('skill-prompt').value = selected.content;
    }
    picker.value = '';
  }

  async function loadSkills() {
    try {
      const r = await fetch('/api/skills');
      const d = await r.json();
      const skills = d.skills || [];
      document.getElementById('skill-count').textContent = skills.length + ' skill' + (skills.length !== 1 ? 's' : '');
      const grid = document.getElementById('skills-grid');
      if (skills.length === 0) {
        grid.innerHTML = '<div class="card" style="grid-column:1/-1;text-align:center;padding:3rem;color:var(--text-3)"><p style="font-size:1.1rem">No skills created yet</p><p style="margin-top:0.5rem">Create your first skill to get started</p></div>';
        return;
      }
      grid.innerHTML = skills.map(s => {
        const toolBadges = (s.tool_ids || []).slice(0,4).map(t => '<span class="badge">' + escapeHtml(t) + '</span>').join(' ');
        const extra = (s.tool_ids || []).length > 4 ? ' <span class="badge">+' + ((s.tool_ids||[]).length - 4) + '</span>' : '';
        return '<div class="card animate-fade-up" style="display:flex;flex-direction:column;justify-content:space-between">' +
          '<div>' +
            '<div style="display:flex;align-items:center;justify-content:space-between">' +
              '<h3 style="margin:0;font-size:1rem">⚡ ' + escapeHtml(s.name) + '</h3>' +
              '<span class="mono" style="font-size:0.68rem;color:var(--text-3)">' + escapeHtml(s.id) + '</span>' +
            '</div>' +
            '<p style="color:var(--text-3);font-size:0.82rem;margin:0.5rem 0">' + escapeHtml(s.description || 'No description') + '</p>' +
            (s.system_prompt ? '<div style="background:var(--input-bg);border-radius:8px;padding:0.5rem 0.75rem;font-size:0.75rem;font-family:var(--mono);color:var(--text-2);max-height:60px;overflow:hidden;margin-bottom:0.5rem">' + escapeHtml(s.system_prompt.slice(0,150)) + (s.system_prompt.length > 150 ? '...' : '') + '</div>' : '') +
            '<div style="display:flex;flex-wrap:wrap;gap:0.25rem;margin-top:0.5rem">' + toolBadges + extra + '</div>' +
          '</div>' +
          '<div style="display:flex;gap:0.5rem;margin-top:1rem;border-top:1px solid var(--glass-border);padding-top:0.75rem">' +
            '<button class="btn btn-sm" onclick="editSkill(\\'' + escapeHtml(s.id) + '\\')">Edit</button>' +
            '<button class="btn btn-sm btn-danger" onclick="deleteSkill(\\'' + escapeHtml(s.id) + '\\')">Delete</button>' +
          '</div>' +
        '</div>';
      }).join('');
    } catch(e) {
      document.getElementById('skills-grid').innerHTML = '<div class="card" style="color:var(--danger)">Error loading skills: ' + escapeHtml(e.message) + '</div>';
    }
  }

  function showCreateForm() {
    document.getElementById('form-title').textContent = 'Create Skill';
    document.getElementById('edit-id').value = '';
    document.getElementById('skill-name').value = '';
    document.getElementById('skill-desc').value = '';
    document.getElementById('skill-prompt').value = '';
    renderToolsDropdown([]);
    document.getElementById('skill-constraints').value = '';
    document.getElementById('skill-form').style.display = 'block';
    document.getElementById('skill-name').focus();
  }

  function hideForm() {
    document.getElementById('skill-form').style.display = 'none';
  }

  async function editSkill(id) {
    try {
      const r = await fetch('/api/skills/' + id);
      const s = await r.json();
      document.getElementById('form-title').textContent = 'Edit Skill';
      document.getElementById('edit-id').value = s.id;
      document.getElementById('skill-name').value = s.name;
      document.getElementById('skill-desc').value = s.description || '';
      document.getElementById('skill-prompt').value = s.system_prompt || '';
      renderToolsDropdown(s.tool_ids || []);
      document.getElementById('skill-constraints').value = (s.constraints || []).join(', ');
      document.getElementById('skill-form').style.display = 'block';
      document.getElementById('skill-name').focus();
    } catch(e) { alert('Error: ' + e.message); }
  }

  async function saveSkill() {
    const id = document.getElementById('edit-id').value;
    const payload = {
      name: document.getElementById('skill-name').value.trim(),
      description: document.getElementById('skill-desc').value.trim(),
      system_prompt: document.getElementById('skill-prompt').value.trim(),
      tool_ids: getSelectedTools(),
      constraints: document.getElementById('skill-constraints').value.split(',').map(s=>s.trim()).filter(Boolean),
    };
    if (!payload.name) { alert('Name is required'); return; }
    try {
      const url = id ? '/api/skills/' + id : '/api/skills';
      const method = id ? 'PUT' : 'POST';
      await fetch(url, { method, headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
      hideForm();
      loadSkills();
    } catch(e) { alert('Error: ' + e.message); }
  }

  async function deleteSkill(id) {
    if (!confirm('Delete this skill?')) return;
    try {
      await fetch('/api/skills/' + id, { method: 'DELETE' });
      loadSkills();
    } catch(e) { alert('Error: ' + e.message); }
  }

  loadSkills();
  loadTools();
  loadLibraryPrompts();
</script>

` }) %>
