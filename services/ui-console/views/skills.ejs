<%- include('layout', { title: 'Skills', page: 'skills', body: `

<h1 class="text-glow-cyan">Skills</h1>
<style>@keyframes spin{to{transform:rotate(360deg)}}</style>
<p class="subtitle" style="color:var(--text-3);margin-bottom:0.75rem">A <strong style="color:var(--text-1)">skill</strong> is a packaged capability: code + prompt(s) + tools + contracts, exposed as a callable function.</p>
<p style="color:var(--text-3);font-size:0.78rem;margin-bottom:1.5rem;line-height:1.5">Think: <strong style="color:#f59e0b">reusable function with intelligence</strong>. Each skill contains a <em>prompt</em> (what the model should do), <em>tools</em> (what actions it can take), <em>input parameters</em> (what data it receives), and <em>constraints</em> (behavioral guardrails).</p>

<!-- Security & Best Practices (read-only — editable in Admin Plane) -->
<details style="margin-bottom:1.25rem;border:1px solid var(--glass-border);border-radius:10px;padding:0;background:var(--glass-bg)">
  <summary style="cursor:pointer;padding:0.75rem 1rem;font-weight:600;font-size:0.85rem;color:var(--text-1);display:flex;align-items:center;gap:0.5rem">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
    Security Considerations &amp; Best Practices
    <span style="font-size:0.72rem;font-weight:400;color:var(--text-3);margin-left:0.25rem">&mdash; applied during AI-assisted skill creation</span>
  </summary>
  <div style="padding:0 1rem 1rem;display:grid;grid-template-columns:1fr 1fr;gap:1rem">
    <!-- Security (read-only, fetched from API) -->
    <div style="background:rgba(239,68,68,0.05);border:1px solid rgba(239,68,68,0.15);border-radius:8px;padding:0.75rem 1rem">
      <h4 style="margin:0 0 0.5rem;font-size:0.82rem;color:#ef4444;display:flex;align-items:center;gap:0.35rem">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Security
      </h4>
      <ul id="sc-list" style="margin:0;padding-left:1.1rem;font-size:0.78rem;color:var(--text-3);line-height:1.7"></ul>
    </div>
    <!-- Best Practices (read-only) -->
    <div style="background:rgba(34,197,94,0.05);border:1px solid rgba(34,197,94,0.15);border-radius:8px;padding:0.75rem 1rem">
      <h4 style="margin:0 0 0.5rem;font-size:0.82rem;color:#22c55e;display:flex;align-items:center;gap:0.35rem">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Best Practices
      </h4>
      <ul id="bp-list" style="margin:0;padding-left:1.1rem;font-size:0.78rem;color:var(--text-3);line-height:1.7"></ul>
    </div>
  </div>
  <div style="padding:0 1rem 0.75rem;text-align:right">
    <a href="/admin#config" style="font-size:0.72rem;color:#f59e0b;text-decoration:none;display:inline-flex;align-items:center;gap:0.3rem;opacity:0.85">
      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      Manage in Admin Plane
    </a>
  </div>
</details>

<!-- Global Constraints (read-only — editable in Admin Plane) -->
<details style="margin-bottom:1.25rem;border:1px solid rgba(245,158,11,0.3);border-radius:10px;padding:0;background:linear-gradient(135deg,rgba(245,158,11,0.03),rgba(249,115,22,0.03))">
  <summary style="cursor:pointer;padding:0.75rem 1rem;font-weight:600;font-size:0.85rem;color:var(--text-1);display:flex;align-items:center;gap:0.5rem">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
    Global Constraints
    <span id="gc-count-badge" class="badge" style="background:rgba(245,158,11,0.15);color:#f59e0b;font-size:0.72rem;margin-left:0.25rem">0</span>
    <span style="font-size:0.72rem;font-weight:400;color:var(--text-3);margin-left:0.25rem">&mdash; inherited by every skill automatically</span>
  </summary>
  <div style="padding:0.75rem 1rem 1rem">
    <div id="gc-tags" style="min-height:28px"></div>
    <div style="display:flex;align-items:center;margin-top:0.6rem">
      <a href="/admin#config" style="font-size:0.72rem;color:#f59e0b;text-decoration:none;display:inline-flex;align-items:center;gap:0.3rem;opacity:0.85">
        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        Manage in Admin Plane
      </a>
      <span style="margin-left:auto;font-size:0.7rem;color:var(--text-3)">Injected into every agent run automatically</span>
    </div>
  </div>
</details>

<!-- Action Bar -->
<div class="flex-between mb-2">
  <div style="display:flex;gap:0.5rem;align-items:center">
    <span id="skill-count" class="badge" style="font-size:0.78rem">0 skills</span>
    <select id="owner-filter" class="input" style="width:auto;min-width:160px;height:34px;font-size:0.78rem;display:none" onchange="loadSkills()">
      <option value="">All Users</option>
    </select>
  </div>
  <div style="display:flex;gap:0.5rem">
    <button class="btn" onclick="toggleDecomposePanel()" style="background:linear-gradient(135deg,#f59e0b22,#f9731622);border-color:#f59e0b44;color:#f59e0b;font-weight:600">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:3px"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>
      Skill Family
    </button>
    <button class="btn btn-primary" onclick="showCreateForm()">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      New Skill
    </button>
  </div>
</div>

<!-- Skill Family / Decompose Panel -->
<div class="card animate-fade-up" id="decompose-panel" style="display:none;border:1px solid #f59e0b44;background:linear-gradient(135deg,rgba(245,158,11,0.04),rgba(249,115,22,0.04))">
  <h3 style="display:flex;align-items:center;gap:0.5rem;margin:0 0 0.75rem">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>
    Create Skill Family
    <span style="font-size:0.75rem;font-weight:400;color:var(--text-3);margin-left:0.5rem">&mdash; decompose a concept or prompt into multiple complementary skills</span>
  </h3>
  <p style="font-size:0.78rem;color:var(--text-3);margin:0 0 1rem;line-height:1.6">
    A <strong style="color:var(--text-2)">prompt</strong> defines <em>how</em> to do something. A <strong style="color:var(--text-2)">skill family</strong> defines how that capability <em>works in the organization</em> &mdash; covering the full lifecycle: create, update, validate, convert, compare, extract.
  </p>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
    <div>
      <label class="field-label">Concept / Domain <span style="color:var(--text-3);font-weight:400;font-size:0.72rem">&mdash; what capability area?</span></label>
      <input type="text" id="decompose-concept" class="input" placeholder="e.g. Technical Documentation, Code Review, Data Analysis Pipeline">
    </div>
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.5rem">
      <div>
        <label class="field-label">Number of Skills <span style="color:var(--text-3);font-weight:400;font-size:0.72rem">(blank = AI decides)</span></label>
        <input type="number" id="decompose-count" class="input" min="2" max="10" placeholder="auto" style="width:100%">
      </div>
      <div>
        <label class="field-label">Model</label>
        <select id="decompose-model" class="input" style="min-height:38px;font-size:0.82rem;min-width:160px">
          <option value="">Active Model</option>
        </select>
      </div>
    </div>
  </div>
  <div style="margin-top:0.75rem">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.25rem">
      <label class="field-label" style="margin-bottom:0">Base Prompt <span style="color:var(--text-3);font-weight:400;font-size:0.72rem">&mdash; optional: paste an existing prompt or pick from your library</span></label>
      <select id="decompose-prompt-picker" class="input" style="width:auto;min-width:240px;min-height:34px;font-size:0.75rem;position:relative;z-index:10" onchange="applyLibraryPromptToDecompose()">
        <option value="">&mdash; Select from Prompt Library &mdash;</option>
      </select>
    </div>
    <textarea id="decompose-prompt" class="input" rows="4" placeholder="e.g. You are a technical documentation writer. Write clear, accurate docs for engineers..." style="resize:vertical;font-family:var(--mono)"></textarea>
  </div>
  <!-- Skill Family Advanced Directions -->
  <details style="margin-top:0.75rem;border:1px solid var(--glass-border);border-radius:8px;padding:0.75rem;background:var(--card-bg)">
    <summary style="cursor:pointer;font-size:0.82rem;font-weight:600;color:var(--text-2);user-select:none">Advanced Directions <span style="font-weight:400;color:var(--text-3);font-size:0.72rem">&mdash; org standards, naming, structure, or any guidance</span></summary>
    <div style="margin-top:0.75rem">
      <label class="field-label">AI Directions <span style="color:var(--text-3);font-weight:400;font-size:0.72rem">&mdash; steer how the AI decomposes &amp; generates skills</span></label>
      <textarea id="decompose-directions" class="input" rows="3" placeholder="e.g.\nEach skill should have at most 2 input parameters\nUse imperative verbs in skill names (Analyze, Generate, Validate)\nInclude error handling constraints\nFocus on data validation use cases" style="font-size:0.78rem;font-family:var(--mono);resize:vertical"></textarea>
    </div>
  </details>
  <div style="display:flex;gap:0.75rem;margin-top:1rem;align-items:center">
    <button class="btn btn-primary" id="decompose-btn" onclick="decomposeSkills()" style="background:linear-gradient(135deg,#f59e0b,#f97316);border:none;font-weight:600">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:4px"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>
      Generate Skill Family
    </button>
    <button class="btn" onclick="toggleDecomposePanel()">Cancel</button>
    <span style="font-size:0.72rem;color:var(--text-3);margin-left:auto">AI will generate complementary skills. You review &amp; save each one individually.</span>
  </div>
</div>

<!-- Decompose Results -->
<div class="card animate-fade-up" id="decompose-results" style="display:none;border:1px solid #f59e0b44;background:linear-gradient(135deg,rgba(245,158,11,0.03),rgba(249,115,22,0.03))">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.5rem">
    <h3 style="margin:0;display:flex;align-items:center;gap:0.5rem">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>
      <span id="decompose-family-name">Skill Family</span>
    </h3>
    <div style="display:flex;gap:0.5rem">
      <button class="btn btn-primary btn-sm" onclick="saveAllDecomposed()">Save All</button>
      <button class="btn btn-sm" onclick="dismissDecompose()">Dismiss</button>
    </div>
  </div>
  <p id="decompose-family-desc" style="font-size:0.78rem;color:var(--text-3);margin:0 0 1rem"></p>
  <div id="decompose-skills-grid" class="grid-3" style="gap:0.75rem"></div>
</div>

<!-- AI Enrich Preview -->
<div class="card animate-fade-up" id="ai-enrich-preview" style="display:none;border:1px solid #6366f144;background:linear-gradient(135deg,rgba(99,102,241,0.05),rgba(139,92,246,0.05))">
  <h3 style="display:flex;align-items:center;gap:0.5rem;margin:0">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#8b5cf6" stroke-width="2"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 16.8l-6.2 4.5 2.4-7.4L2 9.4h7.6z"/></svg>
    AI Enrichment Result
    <span id="enrich-score" class="badge" style="margin-left:auto"></span>
  </h3>
  <div id="enrich-improvements" style="margin:0.75rem 0;font-size:0.78rem;color:var(--text-3)"></div>
  <div style="display:flex;gap:0.75rem">
    <button class="btn btn-primary" onclick="acceptEnrichment()">Accept &amp; Apply</button>
    <button class="btn" onclick="dismissEnrichment()">Dismiss</button>
  </div>
</div>

<!-- Create / Edit Form -->
<div class="card animate-fade-up" id="skill-form" style="display:none">
  <h3 id="form-title">Create Skill</h3>
  <input type="hidden" id="edit-id" value="">
  <div style="display:grid;grid-template-columns:1fr 1fr auto;gap:1rem;margin-top:1rem">
    <div>
      <label class="field-label">Name</label>
      <input type="text" id="skill-name" class="input" placeholder="e.g. Code Reviewer" maxlength="100">
    </div>
    <div>
      <label class="field-label">Description</label>
      <input type="text" id="skill-desc" class="input" placeholder="Brief description" maxlength="1000">
    </div>
    <div>
      <label class="field-label">Scope</label>
      <select id="skill-scope" class="input" style="min-width:110px">
        <option value="private">Private</option>
        <option value="global" id="skill-scope-global">Global</option>
      </select>
      <script>(function(){
        var isAdmin = window.__canCreateGlobal;
        var scopeEl = document.getElementById('skill-scope');
        var globalOpt = document.getElementById('skill-scope-global');
        if (!isAdmin) { globalOpt.disabled = true; globalOpt.textContent = 'Global (admin only)'; }
        else { scopeEl.value = 'global'; /* admin defaults to global */ }
      })();</script>
    </div>
  </div>
  <div style="margin-top:1rem">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.25rem">
      <label class="field-label" style="margin-bottom:0">Prompt <span style="color:var(--text-3);font-weight:400;font-size:0.75rem">— the instructional context: what the model should do, how it should behave, what output is expected</span></label>
      <select id="prompt-library-picker" class="input" style="width:auto;min-width:240px;min-height:34px;font-size:0.75rem;position:relative;z-index:10" onchange="applyLibraryPrompt()">
        <option value="">&mdash; Select from Prompt Library &mdash;</option>
      </select>
    </div>
    <textarea id="skill-prompt" class="input" rows="5" placeholder="e.g. You are a deep research analyst. Break complex topics into sub-questions, search for evidence, cite sources, and synthesize a structured report..." style="resize:vertical;font-family:var(--mono)"></textarea>
    <div style="display:flex;justify-content:flex-end;margin-top:0.35rem">
      <button type="button" class="btn btn-sm" id="suggest-from-prompt-btn" onclick="suggestSkillsFromPrompt()" style="font-size:0.72rem;padding:0.2rem 0.6rem;color:#f59e0b;border-color:#f59e0b44;gap:0.3rem">
        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>
        AI: Suggest skills from this prompt
      </button>
    </div>
  </div>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1rem">
    <div>
      <label class="field-label">Allowed Tools <span style="color:var(--text-3);font-weight:400">(select multiple, empty = all)</span></label>
      <select id="skill-tools" class="input" multiple style="height:120px;font-size:0.82rem"></select>
    </div>
    <div>
      <label class="field-label">Skill-Specific Constraints <span style="color:var(--text-3);font-weight:400">(comma-separated, only rules unique to this skill &mdash; global constraints are inherited automatically)</span></label>
      <input type="text" id="skill-constraints" class="input" placeholder="e.g. Always cite sources, Max 500 words">
    </div>
  </div>

  <!-- Input Parameters -->
  <div style="margin-top:1rem">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.5rem">
      <label class="field-label" style="margin-bottom:0">Input Parameters <span style="color:var(--text-3);font-weight:400;font-size:0.75rem">&mdash; define the data this skill receives when invoked (like function arguments)</span></label>
      <button type="button" class="btn btn-sm" onclick="addParameter()" style="font-size:0.75rem;padding:0.25rem 0.6rem">
        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add Parameter
      </button>
    </div>
    <div id="params-container"></div>
    <div id="params-empty" style="text-align:center;padding:1rem;color:var(--text-3);font-size:0.78rem;border:1px dashed var(--glass-border);border-radius:8px;display:block">
      No input parameters defined. Click <strong>Add Parameter</strong> to define arguments this skill accepts.
    </div>
  </div>

  <!-- Skill Files (Scripts / References / Assets) -->
  <div style="margin-top:1rem" id="skill-files-section">
    <label class="field-label" style="margin-bottom:0.5rem;display:flex;align-items:center;gap:0.4rem">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="var(--text-2)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      Skill Files
      <span style="color:var(--text-3);font-weight:400;font-size:0.75rem">&mdash; attach scripts, reference docs, and templates to this skill</span>
    </label>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:0.75rem">
      <!-- Scripts -->
      <div class="file-drop-zone" data-category="scripts" style="border:1px dashed rgba(34,197,94,0.3);border-radius:10px;padding:0.75rem;background:rgba(34,197,94,0.03);min-height:100px;transition:all 0.2s">
        <div style="display:flex;align-items:center;gap:0.35rem;margin-bottom:0.4rem">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#22c55e" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          <strong style="font-size:0.78rem;color:#22c55e">Scripts</strong>
          <span style="font-size:0.65rem;color:var(--text-3)">.py .sh .js .ts .ps1</span>
        </div>
        <div class="file-list" data-category="scripts"></div>
        <label style="cursor:pointer;display:flex;align-items:center;justify-content:center;gap:0.3rem;padding:0.4rem;border-radius:6px;font-size:0.72rem;color:var(--text-3);border:1px dashed var(--glass-border);margin-top:0.35rem;transition:background 0.2s" onmouseover="this.style.background='var(--glass-bg)'" onmouseout="this.style.background='transparent'">
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Upload
          <input type="file" class="file-input-hidden" data-category="scripts" accept=".py,.sh,.bash,.js,.ts,.ps1" multiple style="display:none" onchange="handleFileUpload(this)">
        </label>
      </div>
      <!-- References -->
      <div class="file-drop-zone" data-category="references" style="border:1px dashed rgba(99,102,241,0.3);border-radius:10px;padding:0.75rem;background:rgba(99,102,241,0.03);min-height:100px;transition:all 0.2s">
        <div style="display:flex;align-items:center;gap:0.35rem;margin-bottom:0.4rem">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#6366f1" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          <strong style="font-size:0.78rem;color:#6366f1">References</strong>
          <span style="font-size:0.65rem;color:var(--text-3)">.md .txt .pdf .json .yaml</span>
        </div>
        <div class="file-list" data-category="references"></div>
        <label style="cursor:pointer;display:flex;align-items:center;justify-content:center;gap:0.3rem;padding:0.4rem;border-radius:6px;font-size:0.72rem;color:var(--text-3);border:1px dashed var(--glass-border);margin-top:0.35rem;transition:background 0.2s" onmouseover="this.style.background='var(--glass-bg)'" onmouseout="this.style.background='transparent'">
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Upload
          <input type="file" class="file-input-hidden" data-category="references" accept=".md,.txt,.pdf,.docx,.json,.yaml,.yml,.csv,.html" multiple style="display:none" onchange="handleFileUpload(this)">
        </label>
      </div>
      <!-- Assets -->
      <div class="file-drop-zone" data-category="assets" style="border:1px dashed rgba(245,158,11,0.3);border-radius:10px;padding:0.75rem;background:rgba(245,158,11,0.03);min-height:100px;transition:all 0.2s">
        <div style="display:flex;align-items:center;gap:0.35rem;margin-bottom:0.4rem">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#f59e0b" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
          <strong style="font-size:0.78rem;color:#f59e0b">Assets</strong>
          <span style="font-size:0.65rem;color:var(--text-3)">.md .json .xml .tmpl .j2</span>
        </div>
        <div class="file-list" data-category="assets"></div>
        <label style="cursor:pointer;display:flex;align-items:center;justify-content:center;gap:0.3rem;padding:0.4rem;border-radius:6px;font-size:0.72rem;color:var(--text-3);border:1px dashed var(--glass-border);margin-top:0.35rem;transition:background 0.2s" onmouseover="this.style.background='var(--glass-bg)'" onmouseout="this.style.background='transparent'">
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Upload
          <input type="file" class="file-input-hidden" data-category="assets" accept=".md,.txt,.json,.yaml,.yml,.csv,.html,.xml,.tmpl,.jinja,.j2" multiple style="display:none" onchange="handleFileUpload(this)">
        </label>
      </div>
    </div>
    <div style="font-size:0.65rem;color:var(--text-3);margin-top:0.35rem">📁 Max 1MB per file, 5MB total per skill. Files are available to the agent as context when this skill is active.</div>
  </div>

  <!-- AI Enrich Options -->
  <details style="margin-top:1rem;border:1px solid var(--glass-border);border-radius:8px;padding:0.75rem;background:var(--card-bg)">
    <summary style="cursor:pointer;font-size:0.82rem;font-weight:600;color:var(--text-2);user-select:none">Advanced &mdash; AI Model, Directions &amp; Best Practices</summary>
    <div style="margin-top:0.75rem">
      <label class="field-label">AI Directions <span style="color:var(--text-3);font-weight:400;font-size:0.72rem">&mdash; org standards, naming conventions, structure, constraints, or any guidance for the AI</span></label>
      <textarea id="enrich-directions" class="input" rows="3" placeholder="e.g.\nDon't add more than 3 parameters\nUse structured JSON output format\nFollow our internal naming convention: snake_case for params\nKeep the prompt under 500 words" style="font-size:0.78rem;font-family:var(--mono);resize:vertical"></textarea>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:0.75rem">
      <div>
        <label class="field-label">AI Model <span style="color:var(--text-3);font-weight:400;font-size:0.72rem">&mdash; used for AI Enrich</span></label>
        <select id="enrich-model" class="input" style="min-height:36px;font-size:0.82rem">
          <option value="">Active Model</option>
        </select>
      </div>
      <div>
        <label class="field-label">Org Best Practices <span style="color:var(--text-3);font-weight:400;font-size:0.72rem">&mdash; fed to AI during enrichment</span></label>
        <textarea id="enrich-bp-override" class="input" rows="3" placeholder="Loaded automatically from your best practices. Override here if needed." style="font-size:0.78rem;font-family:var(--mono);resize:vertical"></textarea>
      </div>
    </div>
  </details>

  <div style="display:flex;gap:0.75rem;margin-top:1.25rem;align-items:center">
    <button class="btn btn-primary" onclick="saveSkill()">Save</button>
    <button class="btn" onclick="hideForm()">Cancel</button>
    <button class="btn" id="enrich-btn" onclick="enrichWithAI()" style="margin-left:auto;background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;border:none;font-weight:600;box-shadow:0 2px 8px rgba(99,102,241,0.25)">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:4px"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 16.8l-6.2 4.5 2.4-7.4L2 9.4h7.6z"/></svg>
      AI Enrich
    </button>
  </div>
</div>

<!-- Skills Grid -->
<div id="skills-grid" class="grid-3" style="margin-top:1rem"></div>

<script>
  let allTools = [];
  let libraryPrompts = [];
  let paramCounter = 0;

  // ── Input Parameters helpers ──
  function addParameter(data) {
    const c = document.getElementById('params-container');
    document.getElementById('params-empty').style.display = 'none';
    const idx = paramCounter++;
    const row = document.createElement('div');
    row.className = 'param-row';
    row.dataset.idx = idx;
    row.style.cssText = 'display:grid;grid-template-columns:1fr 110px 60px 1fr auto;gap:0.5rem;align-items:start;margin-bottom:0.5rem;padding:0.6rem 0.75rem;background:var(--input-bg);border-radius:8px;border:1px solid var(--glass-border)';
    const d = data || {};
    row.innerHTML =
      '<div><label style="font-size:0.7rem;color:var(--text-3);display:block;margin-bottom:2px">Name *</label>' +
      '<input type="text" class="input param-name" placeholder="e.g. topic" value="' + escapeHtml(d.name || '') + '" style="height:32px;font-size:0.8rem"></div>' +
      '<div><label style="font-size:0.7rem;color:var(--text-3);display:block;margin-bottom:2px">Type</label>' +
      '<select class="input param-type" style="min-height:32px;font-size:0.8rem">' +
        '<option value="string"' + (d.type === 'string' || !d.type ? ' selected' : '') + '>string</option>' +
        '<option value="number"' + (d.type === 'number' ? ' selected' : '') + '>number</option>' +
        '<option value="boolean"' + (d.type === 'boolean' ? ' selected' : '') + '>boolean</option>' +
        '<option value="array"' + (d.type === 'array' ? ' selected' : '') + '>array</option>' +
        '<option value="object"' + (d.type === 'object' ? ' selected' : '') + '>object</option>' +
      '</select></div>' +
      '<div style="text-align:center"><label style="font-size:0.7rem;color:var(--text-3);display:block;margin-bottom:2px">Req?</label>' +
      '<input type="checkbox" class="param-required"' + (d.required ? ' checked' : '') + ' style="margin-top:6px;width:16px;height:16px;accent-color:var(--accent-cyan)"></div>' +
      '<div><label style="font-size:0.7rem;color:var(--text-3);display:block;margin-bottom:2px">Default / Description</label>' +
      '<input type="text" class="input param-default" placeholder="default value or description" value="' + escapeHtml(d.default_value || d.description || '') + '" style="height:32px;font-size:0.8rem"></div>' +
      '<button type="button" class="btn btn-sm btn-danger" onclick="removeParameter(this)" style="margin-top:16px;padding:0.2rem 0.5rem;font-size:0.72rem">' +
        '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>' +
      '</button>';
    c.appendChild(row);
    // Auto-save draft on param changes
    row.querySelectorAll('input,select').forEach(el => {
      el.addEventListener('input', saveDraft);
      el.addEventListener('change', saveDraft);
    });
  }

  function removeParameter(btn) {
    btn.closest('.param-row').remove();
    const c = document.getElementById('params-container');
    if (!c.children.length) document.getElementById('params-empty').style.display = 'block';
    saveDraft();
  }

  function getParameters() {
    const rows = document.querySelectorAll('.param-row');
    const params = [];
    rows.forEach(row => {
      const name = row.querySelector('.param-name').value.trim();
      if (!name) return;
      params.push({
        name: name,
        type: row.querySelector('.param-type').value,
        required: row.querySelector('.param-required').checked,
        default_value: row.querySelector('.param-default').value.trim()
      });
    });
    return params;
  }

  function clearParameters() {
    document.getElementById('params-container').innerHTML = '';
    document.getElementById('params-empty').style.display = 'block';
    paramCounter = 0;
  }

  function loadParametersIntoForm(params) {
    clearParameters();
    (params || []).forEach(p => addParameter(p));
  }

  // ── Skill File Upload ──
  var _editingSkillId = null;  // set when editing an existing skill
  var _categoryColors = { scripts: '#22c55e', references: '#6366f1', assets: '#f59e0b' };

  function renderFileList(category, files) {
    var list = document.querySelector('.file-list[data-category="' + category + '"]');
    if (!list) return;
    var catFiles = (files || []).filter(function(f) { return f.category === category; });
    if (catFiles.length === 0) { list.innerHTML = ''; return; }
    list.innerHTML = catFiles.map(function(f) {
      var sizeKB = (f.size_bytes / 1024).toFixed(1);
      return '<div style="display:flex;align-items:center;justify-content:space-between;padding:0.3rem 0.5rem;margin-bottom:0.25rem;border-radius:6px;background:var(--glass-bg);font-size:0.72rem">' +
        '<span style="color:var(--text-1);font-family:var(--mono);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:150px" title="' + escapeHtml(f.name) + '">' + escapeHtml(f.name) + '</span>' +
        '<span style="display:flex;align-items:center;gap:0.35rem">' +
          '<span style="color:var(--text-3)">' + sizeKB + 'KB</span>' +
          '<button type="button" onclick="deleteSkillFile(\\'' + escapeHtml(category) + '\\', \\'' + escapeHtml(f.name) + '\\')" style="background:none;border:none;color:#ef4444;cursor:pointer;padding:0;font-size:0.72rem" title="Remove">&times;</button>' +
        '</span>' +
      '</div>';
    }).join('');
  }

  function renderAllFileLists(files) {
    ['scripts', 'references', 'assets'].forEach(function(cat) { renderFileList(cat, files); });
  }

  function clearAllFileLists() {
    ['scripts', 'references', 'assets'].forEach(function(cat) {
      var list = document.querySelector('.file-list[data-category="' + cat + '"]');
      if (list) list.innerHTML = '';
    });
  }

  async function handleFileUpload(inputEl) {
    var category = inputEl.getAttribute('data-category');
    var skillId = _editingSkillId;
    if (!skillId) {
      showToast('Save the skill first before uploading files', 'warning');
      inputEl.value = '';
      return;
    }
    var files = inputEl.files;
    if (!files || files.length === 0) return;
    for (var i = 0; i < files.length; i++) {
      var f = files[i];
      if (f.size > 1024 * 1024) {
        showToast(f.name + ' exceeds 1MB limit', 'error');
        continue;
      }
      var form = new FormData();
      form.append('file', f);
      form.append('category', category);
      try {
        var r = await fetch('/api/skills/' + encodeURIComponent(skillId) + '/files', { method: 'POST', body: form });
        if (!r.ok) {
          var err = await r.json().catch(function() { return {}; });
          showToast('Upload failed: ' + (err.error || r.statusText), 'error');
          continue;
        }
        showToast(f.name + ' uploaded', 'success');
      } catch(e) {
        showToast('Upload error: ' + e.message, 'error');
      }
    }
    inputEl.value = '';
    // Refresh file list
    await refreshSkillFiles(skillId);
    loadSkills();
  }

  async function deleteSkillFile(category, filename) {
    if (!_editingSkillId) return;
    try {
      var r = await fetch('/api/skills/' + encodeURIComponent(_editingSkillId) + '/files/' + encodeURIComponent(category) + '/' + encodeURIComponent(filename), { method: 'DELETE' });
      if (!r.ok) {
        showToast('Delete failed', 'error');
        return;
      }
      showToast(filename + ' removed', 'success');
      await refreshSkillFiles(_editingSkillId);
      loadSkills();
    } catch(e) { showToast('Error: ' + e.message, 'error'); }
  }

  async function refreshSkillFiles(skillId) {
    try {
      var r = await fetch('/api/skills/' + encodeURIComponent(skillId) + '/files');
      var d = await r.json();
      renderAllFileLists(d.files || []);
    } catch(e) { clearAllFileLists(); }
  }

  // Drag & drop support
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.file-drop-zone').forEach(function(zone) {
      zone.addEventListener('dragover', function(e) { e.preventDefault(); zone.style.borderStyle = 'solid'; zone.style.opacity = '0.85'; });
      zone.addEventListener('dragleave', function() { zone.style.borderStyle = 'dashed'; zone.style.opacity = '1'; });
      zone.addEventListener('drop', function(e) {
        e.preventDefault();
        zone.style.borderStyle = 'dashed';
        zone.style.opacity = '1';
        var cat = zone.getAttribute('data-category');
        var input = zone.querySelector('.file-input-hidden');
        if (input && e.dataTransfer.files.length) {
          input.files = e.dataTransfer.files;
          handleFileUpload(input);
        }
      });
    });
  });

  async function loadTools() {
    try {
      const r = await fetch('/api/tools');
      const d = await r.json();
      allTools = (d.tools || []).map(t => t.name);
      renderToolsDropdown([]);
    } catch(e) {}
  }

  function renderToolsDropdown(selectedIds) {
    const el = document.getElementById('skill-tools');
    el.innerHTML = allTools.map(t =>
      '<option value="' + escapeHtml(t) + '"' + (selectedIds.includes(t) ? ' selected' : '') + '>🔧 ' + escapeHtml(t) + '</option>'
    ).join('');
  }

  function getSelectedTools() {
    return Array.from(document.getElementById('skill-tools').selectedOptions).map(o => o.value);
  }

  async function loadLibraryPrompts() {
    try {
      const r = await fetch('/api/prompts');
      const d = await r.json();
      libraryPrompts = d.prompts || [];
      const picker = document.getElementById('prompt-library-picker');
      picker.innerHTML = '<option value="">— Select from Prompt Library —</option>' +
        libraryPrompts.map(p => '<option value="' + escapeHtml(p.id) + '">' + escapeHtml(p.name) + ' (' + escapeHtml(p.category) + ')' + '</option>').join('');
    } catch(e) {}
  }

  function applyLibraryPrompt() {
    const picker = document.getElementById('prompt-library-picker');
    const selected = libraryPrompts.find(p => p.id === picker.value);
    if (selected) {
      document.getElementById('skill-prompt').value = selected.content;
    }
    picker.value = '';
  }

  async function loadSkills() {
    try {
      var ownerFilter = document.getElementById('owner-filter').value;
      var qs = ownerFilter ? '?created_by=' + encodeURIComponent(ownerFilter) : '';
      const r = await fetch('/api/skills' + qs);
      const d = await r.json();
      const skills = d.skills || [];

      // Populate owner filter dropdown (admin only)
      if (window.__userRole === 'admin') {
        var ownerEl = document.getElementById('owner-filter');
        ownerEl.style.display = '';
        var owners = [...new Set(skills.map(function(s){ return s.created_by || 'system'; }))].sort();
        var curVal = ownerEl.value;
        ownerEl.innerHTML = '<option value="">All Users</option>' + owners.map(function(o){ return '<option value="' + escapeHtml(o) + '"' + (o === curVal ? ' selected' : '') + '>' + escapeHtml(o) + '</option>'; }).join('');
      }

      document.getElementById('skill-count').textContent = skills.length + ' skill' + (skills.length !== 1 ? 's' : '');
      const grid = document.getElementById('skills-grid');
      if (skills.length === 0) {
        grid.innerHTML = '<div class="card" style="grid-column:1/-1;text-align:center;padding:3rem;color:var(--text-3)"><p style="font-size:1.1rem">No skills created yet</p><p style="margin-top:0.5rem">Create your first skill to get started</p></div>';
        return;
      }
      grid.innerHTML = skills.map(s => {
        const toolBadges = (s.tool_ids || []).slice(0,4).map(t => '<span class="badge">' + escapeHtml(t) + '</span>').join(' ');
        const extra = (s.tool_ids || []).length > 4 ? ' <span class="badge">+' + ((s.tool_ids||[]).length - 4) + '</span>' : '';
        const paramCount = (s.input_parameters || []).length;
        const paramBadge = paramCount > 0
          ? ' <span class="badge" style="background:rgba(99,102,241,0.15);color:#818cf8;font-size:0.7rem">' + paramCount + ' param' + (paramCount > 1 ? 's' : '') + '</span>'
          : '';
        const paramSig = paramCount > 0
          ? '<div style="margin:0.4rem 0;font-size:0.72rem;color:var(--text-3);font-family:var(--mono);background:var(--input-bg);padding:0.4rem 0.6rem;border-radius:6px;overflow:hidden;max-height:48px">' +
              (s.input_parameters||[]).map(function(p){return '<span style="color:#818cf8">' + escapeHtml(p.name) + '</span><span style="color:var(--text-3)">:</span><span style="color:#f59e0b">' + escapeHtml(p.type||'string') + '</span>' + (p.required ? '<span style="color:#ef4444">*</span>' : '')}).join('<span style="color:var(--text-3)">, </span>') +
            '</div>' : '';
        const constraintsList = (s.constraints || []);
        const constraintsHtml = constraintsList.length > 0
          ? '<div style="margin:0.4rem 0">' +
              '<div style="font-size:0.68rem;color:var(--text-3);margin-bottom:0.25rem;font-weight:600">Skill-Specific Constraints</div>' +
              '<div style="display:flex;flex-wrap:wrap;gap:0.25rem">' +
                constraintsList.map(function(c){ return '<span style="display:inline-block;font-size:0.7rem;padding:0.15rem 0.5rem;border-radius:20px;background:rgba(245,158,11,0.1);color:#f59e0b;border:1px solid rgba(245,158,11,0.2)">' + escapeHtml(c) + '</span>' }).join('') +
              '</div>' +
            '</div>'
          : '';
        const constraintBadge = constraintsList.length > 0
          ? ' <span class="badge" style="background:rgba(245,158,11,0.15);color:#f59e0b;font-size:0.7rem">' + constraintsList.length + ' rule' + (constraintsList.length > 1 ? 's' : '') + '</span>'
          : '';
        const filesList = s.files || [];
        const scriptsCount = filesList.filter(function(f){return f.category==='scripts'}).length;
        const refsCount = filesList.filter(function(f){return f.category==='references'}).length;
        const assetsCount = filesList.filter(function(f){return f.category==='assets'}).length;
        const fileBadges = (scriptsCount ? ' <span class="badge" style="background:rgba(34,197,94,0.15);color:#22c55e;font-size:0.7rem">' + scriptsCount + ' script' + (scriptsCount>1?'s':'') + '</span>' : '')
          + (refsCount ? ' <span class="badge" style="background:rgba(99,102,241,0.15);color:#818cf8;font-size:0.7rem">' + refsCount + ' ref' + (refsCount>1?'s':'') + '</span>' : '')
          + (assetsCount ? ' <span class="badge" style="background:rgba(245,158,11,0.15);color:#f59e0b;font-size:0.7rem">' + assetsCount + ' asset' + (assetsCount>1?'s':'') + '</span>' : '');
        var ownerBadge = s.created_by ? '<span class="badge" style="background:rgba(99,102,241,0.12);color:#818cf8;font-size:0.65rem;font-weight:500">' + escapeHtml(s.created_by) + '</span>' : '';
        var scopeBadge = s.scope === 'global'
          ? '<span class="badge" style="background:rgba(16,185,129,0.12);color:#10b981;font-size:0.6rem;font-weight:600">GLOBAL</span>'
          : '<span class="badge" style="background:rgba(245,158,11,0.12);color:#f59e0b;font-size:0.6rem;font-weight:600">PRIVATE</span>';
        return '<div class="card animate-fade-up" style="display:flex;flex-direction:column;justify-content:space-between">' +
          '<div>' +
            '<div style="display:flex;align-items:center;justify-content:space-between">' +
              '<h3 style="margin:0;font-size:1rem">' + String.fromCharCode(9889) + ' ' + escapeHtml(s.name) + '</h3>' +
              '<div style="display:flex;align-items:center;gap:0.4rem">' + scopeBadge + ownerBadge + '<span class="mono" style="font-size:0.68rem;color:var(--text-3)">' + escapeHtml(s.id) + '</span></div>' +
            '</div>' +
            '<p style="color:var(--text-3);font-size:0.82rem;margin:0.5rem 0">' + escapeHtml(s.description || 'No description') + '</p>' +
            (s.system_prompt ? '<div style="background:var(--input-bg);border-radius:8px;padding:0.5rem 0.75rem;font-size:0.75rem;font-family:var(--mono);color:var(--text-2);max-height:60px;overflow:hidden;margin-bottom:0.5rem">' + escapeHtml(s.system_prompt.slice(0,150)) + (s.system_prompt.length > 150 ? '...' : '') + '</div>' : '') +
            paramSig +
            constraintsHtml +
            '<div style="display:flex;flex-wrap:wrap;gap:0.25rem;margin-top:0.5rem">' + toolBadges + extra + paramBadge + constraintBadge + fileBadges + '</div>' +
          '</div>' +
          '<div style="display:flex;gap:0.5rem;margin-top:1rem;border-top:1px solid var(--glass-border);padding-top:0.75rem">' +
            '<button class="btn btn-sm" onclick="editSkill(\\'' + escapeHtml(s.id) + '\\')">Edit</button>' +
            '<button class="btn btn-sm btn-danger" onclick="deleteSkill(\\'' + escapeHtml(s.id) + '\\')">Delete</button>' +
          '</div>' +
        '</div>';
      }).join('');
    } catch(e) {
      document.getElementById('skills-grid').innerHTML = '<div class="card" style="color:var(--danger)">Error loading skills: ' + escapeHtml(e.message) + '</div>';
    }
  }

  // ── Form state persistence (survives navigation) ──
  const DRAFT_KEY = 'skillDraft';
  function saveDraft() {
    const draft = {
      id: document.getElementById('edit-id').value,
      name: document.getElementById('skill-name').value,
      desc: document.getElementById('skill-desc').value,
      prompt: document.getElementById('skill-prompt').value,
      tools: Array.from(document.getElementById('skill-tools').selectedOptions).map(o => o.value),
      constraints: document.getElementById('skill-constraints').value,
      input_parameters: getParameters(),
      formTitle: document.getElementById('form-title').textContent,
    };
    if (draft.name || draft.prompt || draft.desc || draft.constraints || draft.input_parameters.length) {
      localStorage.setItem(DRAFT_KEY, JSON.stringify(draft));
    }
  }
  function clearDraft() { localStorage.removeItem(DRAFT_KEY); }
  function restoreDraft() {
    const raw = localStorage.getItem(DRAFT_KEY);
    if (!raw) return;
    try {
      const d = JSON.parse(raw);
      document.getElementById('edit-id').value = d.id || '';
      document.getElementById('skill-name').value = d.name || '';
      document.getElementById('skill-desc').value = d.desc || '';
      document.getElementById('skill-prompt').value = d.prompt || '';
      if (d.tools && d.tools.length) renderToolsDropdown(d.tools);
      document.getElementById('skill-constraints').value = d.constraints || '';
      if (d.input_parameters && d.input_parameters.length) loadParametersIntoForm(d.input_parameters);
      document.getElementById('form-title').textContent = d.formTitle || 'Create Skill';
      document.getElementById('skill-form').style.display = 'block';
    } catch(e) { clearDraft(); }
  }
  // Auto-save on input
  ['skill-name','skill-desc','skill-prompt','skill-constraints'].forEach(id => {
    document.getElementById(id).addEventListener('input', saveDraft);
    document.getElementById(id).addEventListener('change', saveDraft);
  });
  document.getElementById('skill-tools').addEventListener('change', saveDraft);

  function showCreateForm() {
    clearDraft();
    document.getElementById('form-title').textContent = 'Create Skill';
    document.getElementById('edit-id').value = '';
