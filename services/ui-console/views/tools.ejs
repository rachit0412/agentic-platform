<%- include('layout', { title: 'Tools', page: 'tools', body: `

<h1 class="text-glow-cyan">Tools</h1>
<p class="subtitle" style="color:var(--text-3);margin-bottom:0.75rem">Tools are <strong style="color:var(--text-1)">executable capabilities</strong> that agents invoke to interact with the outside world — APIs, databases, files, search, and more.</p>
<p style="color:var(--text-3);font-size:0.78rem;margin-bottom:1.5rem;line-height:1.5">Each tool has a <strong style="color:#06b6d4">name</strong>, <strong style="color:#f59e0b">description</strong> (used by the LLM to decide when to call it), and a <strong style="color:#10b981">backend endpoint</strong> it proxies to. Tools are assigned to agents via Skills or directly.</p>

<!-- Stats Row -->
<div class="grid-4 mb-2" style="margin-bottom:1.5rem">
  <div class="stat-card animate-fade-up">
    <div class="stat-icon stat-icon-cyan">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
    </div>
    <div class="stat-label">Total Tools</div>
    <div class="stat-number" id="stat-total">-</div>
  </div>
  <div class="stat-card animate-fade-up delay-100">
    <div class="stat-icon stat-icon-emerald">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    </div>
    <div class="stat-label">Proxy Tools</div>
    <div class="stat-number" id="stat-proxy">-</div>
  </div>
  <div class="stat-card animate-fade-up delay-200">
    <div class="stat-icon stat-icon-violet">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
    </div>
    <div class="stat-label">Local Tools</div>
    <div class="stat-number" id="stat-local">-</div>
  </div>
  <div class="stat-card animate-fade-up delay-300">
    <div class="stat-icon" style="background:linear-gradient(135deg,rgba(244,63,94,0.15),rgba(244,63,94,0.08));color:#f43f5e">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
    </div>
    <div class="stat-label">Tools Service</div>
    <div class="stat-number" id="stat-svc-status" style="font-size:0.85rem">-</div>
  </div>
</div>

<!-- Action Bar -->
<div class="flex-between mb-2">
  <div style="display:flex;gap:0.5rem;align-items:center">
    <span id="tool-count" class="badge" style="font-size:0.78rem">0 tools</span>
    <input type="text" id="tool-search" class="input" placeholder="Search tools..." style="width:220px;height:34px;font-size:0.82rem" oninput="filterTools()">
  </div>
  <button class="btn btn-secondary" onclick="loadTools()">
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
    Refresh
  </button>
</div>

<!-- Tools Grid -->
<div id="tools-grid" class="grid-3" style="margin-top:1rem">
  <div style="color:var(--text-3);font-size:0.82rem;grid-column:1/-1;text-align:center;padding:2rem">Loading tools...</div>
</div>

<!-- Architecture: How Tools Work -->
<div class="card animate-fade-up" style="margin-top:1.5rem">
  <h3>How Tools Work</h3>
  <div style="margin-top:0.75rem;padding:1.25rem;border-radius:12px;background:var(--input-bg);border:1px solid var(--glass-border);font-family:monospace;font-size:0.78rem;line-height:2;color:var(--text-2)">
    <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap">
      <span style="background:rgba(139,92,246,0.15);padding:4px 10px;border-radius:8px;color:#8b5cf6;font-weight:600">User Prompt</span>
      <span style="color:var(--text-3)">→</span>
      <span style="background:rgba(6,182,212,0.15);padding:4px 10px;border-radius:8px;color:#06b6d4;font-weight:600">LLM decides tool</span>
      <span style="color:var(--text-3)">→</span>
      <span style="background:rgba(245,158,11,0.15);padding:4px 10px;border-radius:8px;color:#f59e0b;font-weight:600">Agent calls tool</span>
      <span style="color:var(--text-3)">→</span>
      <span style="background:rgba(16,185,129,0.15);padding:4px 10px;border-radius:8px;color:#10b981;font-weight:600">Result → LLM</span>
      <span style="color:var(--text-3)">→</span>
      <span style="background:rgba(244,63,94,0.15);padding:4px 10px;border-radius:8px;color:#f43f5e;font-weight:600">Response</span>
    </div>
    <div style="margin-top:1rem;font-size:0.78rem;color:var(--text-3);line-height:1.6">
      <strong style="color:var(--text-2)">Proxy tools</strong> call the external <code style="color:#06b6d4">tools-service</code> (math, http-fetch, file-write, file-read, datetime, web-search, code-execute).<br>
      <strong style="color:var(--text-2)">Local tools</strong> run inside the agent process (vector-search, vector-store — ChromaDB operations).
    </div>
  </div>
</div>

<script>
let allToolsData = [];

const TOOL_ICONS = {
  'math': '🧮',
  'http_fetch': '🌐',
  'file_write': '💾',
  'file_read': '📄',
  'datetime_tool': '🕐',
  'web_search': '🔍',
  'code_execute': '💻',
  'vector_search': '🔎',
  'vector_store': '📦'
};

const TOOL_CATEGORIES = {
  'math': 'proxy',
  'http_fetch': 'proxy',
  'file_write': 'proxy',
  'file_read': 'proxy',
  'datetime_tool': 'proxy',
  'web_search': 'proxy',
  'code_execute': 'proxy',
  'vector_search': 'local',
  'vector_store': 'local'
};

const TOOL_ENDPOINTS = {
  'math': 'POST /tools/math',
  'http_fetch': 'POST /tools/http-fetch',
  'file_write': 'POST /tools/file-write',
  'file_read': 'POST /tools/file-read',
  'datetime_tool': 'POST /tools/datetime',
  'web_search': 'POST /tools/web-search',
  'code_execute': 'POST /tools/code-execute',
  'vector_search': 'In-process (ChromaDB)',
  'vector_store': 'In-process (ChromaDB)'
};

const TOOL_PARAMS = {
  'math': [{ name: 'expression', type: 'string', desc: 'Arithmetic expression like 2+2 or (10*5)/3' }],
  'http_fetch': [{ name: 'url', type: 'string', desc: 'URL to fetch (allowed: httpbin.org, jsonplaceholder.typicode.com)' }],
  'file_write': [{ name: 'filename', type: 'string', desc: 'Simple filename (no path separators)' }, { name: 'content', type: 'string', desc: 'Text content to save' }],
  'file_read': [{ name: 'filename', type: 'string', desc: 'Previously saved filename' }],
  'datetime_tool': [],
  'web_search': [{ name: 'query', type: 'string', desc: 'Search query' }, { name: 'max_results', type: 'int', desc: 'Max results (default: 5)' }],
  'code_execute': [{ name: 'code', type: 'string', desc: 'Code to execute' }, { name: 'language', type: 'string', desc: 'Language (default: python)' }],
  'vector_search': [{ name: 'query', type: 'string', desc: 'Semantic search query' }, { name: 'k', type: 'int', desc: 'Number of results (default: 5)' }],
  'vector_store': [{ name: 'text', type: 'string', desc: 'Document text content' }, { name: 'source', type: 'string', desc: 'Source name / label' }]
};

async function loadTools() {
  try {
    const r = await fetch('/api/tools');
    const d = await r.json();
    allToolsData = d.tools || [];
    renderTools(allToolsData);
    updateStats(allToolsData);
    document.getElementById('tool-count').textContent = allToolsData.length + ' tools';
  } catch(e) {
    document.getElementById('tools-grid').innerHTML = '<div style="color:#ef4444;grid-column:1/-1;text-align:center;padding:2rem">Failed to load tools: ' + escapeHtml(e.message) + '</div>';
  }
}

function updateStats(tools) {
  document.getElementById('stat-total').textContent = tools.length;
  const proxy = tools.filter(t => TOOL_CATEGORIES[t.name] === 'proxy').length;
  const local = tools.filter(t => TOOL_CATEGORIES[t.name] === 'local').length;
  document.getElementById('stat-proxy').textContent = proxy;
  document.getElementById('stat-local').textContent = local;

  // Tools service health
  fetch('/api/health-check').then(r=>r.json()).then(d=>{
    const ts = (d.services||[]).find(s=>s.name==='tools-service');
    const el = document.getElementById('stat-svc-status');
    if (ts && ts.status === 'healthy') {
      el.textContent = 'Healthy';
      el.style.color = '#10b981';
    } else {
      el.textContent = 'Down';
      el.style.color = '#ef4444';
    }
  }).catch(()=>{
    document.getElementById('stat-svc-status').textContent = '?';
  });
}

function renderTools(tools) {
  const grid = document.getElementById('tools-grid');
  if (!tools.length) {
    grid.innerHTML = '<div style="color:var(--text-3);grid-column:1/-1;text-align:center;padding:2rem">No tools available</div>';
    return;
  }
  grid.innerHTML = tools.map(t => {
    const icon = TOOL_ICONS[t.name] || '🔧';
    const cat = TOOL_CATEGORIES[t.name] || 'unknown';
    const catColor = cat === 'proxy' ? '#06b6d4' : cat === 'local' ? '#8b5cf6' : '#666';
    const endpoint = TOOL_ENDPOINTS[t.name] || '-';
    return '<div class="card animate-fade-up" style="position:relative">' +
      '<div style="display:flex;align-items:start;gap:0.75rem;margin-bottom:0.75rem">' +
        '<div style="font-size:1.5rem;line-height:1">' + icon + '</div>' +
        '<div style="flex:1;min-width:0">' +
          '<div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap">' +
            '<h4 style="margin:0;font-size:0.95rem;color:var(--text-1)">' + escapeHtml(t.name) + '</h4>' +
            '<span class="badge" style="font-size:0.65rem;background:' + catColor + '20;color:' + catColor + ';border:1px solid ' + catColor + '30">' + cat + '</span>' +
          '</div>' +
          '<p style="margin:0.25rem 0 0;font-size:0.8rem;color:var(--text-3);line-height:1.4">' + escapeHtml(t.description) + '</p>' +
        '</div>' +
      '</div>' +
      '<div style="font-size:0.72rem;color:var(--text-3);font-family:var(--mono);margin-bottom:0.5rem">' +
        '<span style="color:var(--text-2);font-weight:600">Endpoint:</span> ' + escapeHtml(endpoint) +
      '</div>' +
      '<div style="display:flex;gap:0.5rem">' +
        '<button class="btn btn-sm" onclick="showToolDetail(\\'' + escapeHtml(t.name) + '\\')">ℹ️ Details</button>' +
        '<button class="btn btn-sm btn-secondary" onclick="testTool(\\'' + escapeHtml(t.name) + '\\')">▶ Test</button>' +
      '</div>' +
    '</div>';
  }).join('');
}

function filterTools() {
  const q = document.getElementById('tool-search').value.toLowerCase();
  const filtered = allToolsData.filter(t =>
    t.name.toLowerCase().includes(q) || (t.description||'').toLowerCase().includes(q)
  );
  renderTools(filtered);
}

function showToolDetail(name) {
  const t = allToolsData.find(x => x.name === name);
  if (!t) return;
  const icon = TOOL_ICONS[name] || '🔧';
  const cat = TOOL_CATEGORIES[name] || 'unknown';
  const endpoint = TOOL_ENDPOINTS[name] || '-';
  const params = TOOL_PARAMS[name] || [];

  let html = '<table style="width:100%;font-size:0.82rem">';
  html += '<tr><td style="color:var(--text-3);padding:0.3rem 1rem 0.3rem 0;width:120px">Name</td><td><strong>' + escapeHtml(name) + '</strong></td></tr>';
  html += '<tr><td style="color:var(--text-3);padding:0.3rem 1rem 0.3rem 0">Category</td><td><span class="badge" style="font-size:0.72rem">' + cat + '</span></td></tr>';
  html += '<tr><td style="color:var(--text-3);padding:0.3rem 1rem 0.3rem 0">Endpoint</td><td class="mono" style="font-size:0.78rem">' + escapeHtml(endpoint) + '</td></tr>';
  html += '<tr><td style="color:var(--text-3);padding:0.3rem 1rem 0.3rem 0;vertical-align:top">Description</td><td style="line-height:1.5">' + escapeHtml(t.description) + '</td></tr>';
  html += '</table>';

  if (params.length) {
    html += '<h4 style="margin:1rem 0 0.5rem;color:var(--text-1);font-size:0.88rem">Parameters</h4>';
    html += '<table style="width:100%;font-size:0.78rem"><tr><th style="text-align:left;padding:0.3rem 0.5rem;border-bottom:1px solid var(--glass-border)">Name</th><th style="text-align:left;padding:0.3rem 0.5rem;border-bottom:1px solid var(--glass-border)">Type</th><th style="text-align:left;padding:0.3rem 0.5rem;border-bottom:1px solid var(--glass-border)">Description</th></tr>';
    params.forEach(p => {
      html += '<tr><td style="padding:0.3rem 0.5rem;color:#06b6d4;font-family:var(--mono)">' + escapeHtml(p.name) + '</td><td style="padding:0.3rem 0.5rem;color:var(--text-3)">' + escapeHtml(p.type) + '</td><td style="padding:0.3rem 0.5rem;color:var(--text-2)">' + escapeHtml(p.desc) + '</td></tr>';
    });
    html += '</table>';
  } else {
    html += '<p style="margin-top:0.75rem;font-size:0.78rem;color:var(--text-3)"><em>No parameters required</em></p>';
  }

  html += '<h4 style="margin:1rem 0 0.5rem;color:var(--text-1);font-size:0.88rem">Usage in Agent</h4>';
  html += '<div style="background:var(--input-bg);border:1px solid var(--glass-border);border-radius:8px;padding:0.75rem;font-family:var(--mono);font-size:0.75rem;color:var(--text-2);line-height:1.6">';
  html += 'The LLM automatically decides to call <span style="color:#06b6d4">' + escapeHtml(name) + '</span> based on the user prompt.<br>Assign via <strong>Skills</strong> or directly in the <strong>Agent</strong> config.';
  html += '</div>';

  showDetailModal(icon + ' ' + escapeHtml(name), html);
}

function testTool(name) {
  const params = TOOL_PARAMS[name] || [];
  let html = '<div style="font-size:0.82rem;margin-bottom:1rem;color:var(--text-3)">Send a test call to <strong style="color:var(--text-1)">' + escapeHtml(name) + '</strong></div>';

  if (params.length === 0) {
    html += '<p style="font-size:0.78rem;color:var(--text-3)"><em>No parameters — will call directly</em></p>';
  } else {
    params.forEach(p => {
      html += '<div style="margin-bottom:0.75rem">';
      html += '<label class="field-label" style="font-size:0.78rem">' + escapeHtml(p.name) + ' <span style="color:var(--text-3);font-weight:400">(' + escapeHtml(p.type) + ')</span></label>';
      html += '<input type="text" class="input" id="test-param-' + escapeHtml(p.name) + '" placeholder="' + escapeHtml(p.desc) + '" style="font-size:0.82rem">';
      html += '</div>';
    });
  }

  html += '<button class="btn btn-primary" onclick="_runToolTest(\\'' + escapeHtml(name) + '\\')">Run Test</button>';
  html += '<div id="test-result" style="margin-top:1rem"></div>';

  showDetailModal('▶ Test: ' + escapeHtml(name), html);
}

async function _runToolTest(name) {
  const params = TOOL_PARAMS[name] || [];
  const payload = {};
  params.forEach(p => {
    const el = document.getElementById('test-param-' + p.name);
    if (el) {
      let val = el.value;
      if (p.type === 'int') val = parseInt(val) || 0;
      payload[p.name] = val;
    }
  });

  const resultEl = document.getElementById('test-result');
  resultEl.innerHTML = '<p style="color:var(--text-3);font-size:0.78rem">Running...</p>';

  try {
    const prompt = 'Use the ' + name + ' tool with: ' + JSON.stringify(payload);
    const r = await fetch('/api/agent-run', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ prompt: prompt })
    });
    const d = await r.json();
    resultEl.innerHTML = '<div style="background:var(--input-bg);border:1px solid var(--glass-border);border-radius:8px;padding:0.75rem;font-size:0.78rem;max-height:200px;overflow-y:auto">' +
      '<strong style="color:var(--text-1)">Result:</strong><br>' +
      '<pre style="margin:0.5rem 0 0;white-space:pre-wrap;color:var(--text-2)">' + escapeHtml(d.response || d.error || JSON.stringify(d, null, 2)) + '</pre>' +
      '</div>';
  } catch(e) {
    resultEl.innerHTML = '<p style="color:#ef4444;font-size:0.78rem">Error: ' + escapeHtml(e.message) + '</p>';
  }
}

loadTools();
</script>
` }) %>
