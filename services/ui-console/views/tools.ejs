  'text_diff': 'POST /tools/text-diff', 'text_extract': 'POST /tools/text-extract',
  'json_transform': 'POST /tools/json-transform', 'csv_parse': 'POST /tools/csv-parse',
  'yaml_convert': 'POST /tools/yaml-convert', 'base64_codec': 'POST /tools/base64-codec',
  'hash_generate': 'POST /tools/hash-generate', 'uuid_generate': 'POST /tools/uuid-generate',
  'regex_match': 'POST /tools/regex-match', 'url_parse': 'POST /tools/url-parse',
  'html_strip': 'POST /tools/html-strip', 'markdown_to_html': 'POST /tools/markdown-to-html',
  'webpage_extract': 'POST /tools/webpage-extract', 'dns_lookup': 'POST /tools/dns-lookup',
  'json_schema_validate': 'POST /tools/json-schema-validate', 'cron_parse': 'POST /tools/cron-parse',
