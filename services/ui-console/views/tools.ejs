  'vector_search': 'In-process (ChromaDB)', 'vector_store': 'In-process (ChromaDB)',
  'delegate_to_agent': 'In-process (agent)', 'advanced_search': 'In-process (LlamaIndex)',
  'query_database': 'In-process (SQL)', 'query_csv_data': 'In-process (Pandas)',
