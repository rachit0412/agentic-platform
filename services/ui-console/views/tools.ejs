  'file_write': 'POST /tools/file-write', 'file_read': 'POST /tools/file-read',
  'file_list': 'POST /tools/file-list', 'file_search_content': 'POST /tools/file-search-content',
  'datetime_tool': 'POST /tools/datetime', 'web_search': 'POST /tools/web-search',
