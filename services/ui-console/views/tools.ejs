<%- include('layout', { title: 'Tools', page: 'tools', body: `

<h1 class="text-glow-cyan">Tools</h1>
<p class="subtitle" style="color:var(--text-3);margin-bottom:0.75rem">Tools are <strong style="color:var(--text-1)">executable capabilities</strong> that agents invoke to interact with the outside world — APIs, databases, files, search, and more.</p>
<p style="color:var(--text-3);font-size:0.78rem;margin-bottom:1.5rem;line-height:1.5"><strong style="color:#06b6d4">Built-in tools</strong> ship with the platform. <strong style="color:#f59e0b">Custom tools</strong> connect to any HTTP endpoint you define — add new capabilities without code changes.</p>

<!-- Stats Row -->
<div class="grid-4 mb-2" style="margin-bottom:1.5rem">
  <div class="stat-card animate-fade-up" style="cursor:pointer" onclick="document.getElementById('tool-type-filter').value='all';filterTools();document.getElementById('tools-grid').scrollIntoView({behavior:'smooth',block:'start'})" title="View all tools">
    <div class="stat-icon stat-icon-cyan">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
    </div>
    <div class="stat-label">Total Tools</div>
    <div class="stat-number" id="stat-total">-</div>
  </div>
  <div class="stat-card animate-fade-up delay-100" style="cursor:pointer" onclick="document.getElementById('tool-type-filter').value='builtin';filterTools();document.getElementById('tools-grid').scrollIntoView({behavior:'smooth',block:'start'})" title="Filter built-in tools">
    <div class="stat-icon stat-icon-emerald">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    </div>
    <div class="stat-label">Built-in</div>
    <div class="stat-number" id="stat-builtin">-</div>
  </div>
  <div class="stat-card animate-fade-up delay-200" style="cursor:pointer" onclick="document.getElementById('tool-type-filter').value='custom';filterTools();document.getElementById('tools-grid').scrollIntoView({behavior:'smooth',block:'start'})" title="Filter custom tools">
    <div class="stat-icon stat-icon-violet">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
    </div>
    <div class="stat-label">Custom</div>
    <div class="stat-number" id="stat-custom">-</div>
  </div>
  <div class="stat-card animate-fade-up delay-300" style="cursor:pointer" onclick="document.getElementById('tool-type-filter').value='all';filterTools();document.getElementById('tools-grid').scrollIntoView({behavior:'smooth',block:'start'})" title="View disabled tools">
    <div class="stat-icon" style="background:linear-gradient(135deg,rgba(244,63,94,0.15),rgba(244,63,94,0.08));color:#f43f5e">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
    </div>
    <div class="stat-label">Enabled / Disabled</div>
    <div class="stat-number" id="stat-enabled-count" style="font-size:0.85rem">-</div>
  </div>
</div>

<!-- Action Bar -->
<div class="flex-between mb-2">
  <div style="display:flex;gap:0.5rem;align-items:center">
    <span id="tool-count" class="badge" style="font-size:0.78rem">0 tools</span>
    <input type="text" id="tool-search" class="input" placeholder="Search tools..." style="width:220px;height:34px;font-size:0.82rem" oninput="filterTools()">
    <select id="tool-type-filter" class="input" style="width:auto;min-width:120px;height:34px;font-size:0.82rem" onchange="filterTools()">
      <option value="all">All Types</option>
      <option value="builtin">Built-in</option>
      <option value="custom">Custom</option>
    </select>
    <select id="owner-filter" class="input" style="width:auto;min-width:160px;height:34px;font-size:0.78rem;display:none" onchange="filterTools()">
      <option value="">All Users</option>
    </select>
  </div>
  <div style="display:flex;gap:0.5rem">
    <button class="btn btn-primary" onclick="showCreateToolModal()">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
      New Tool
    </button>
    <button class="btn btn-secondary" onclick="loadTools()">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
      Refresh
    </button>
  </div>
</div>

<!-- Tools Grid -->
<div id="tools-grid" class="grid-3" style="margin-top:1rem">
  <div style="color:var(--text-3);font-size:0.82rem;grid-column:1/-1;text-align:center;padding:2rem">Loading tools...</div>
</div>

<!-- Architecture: How Tools Work -->
<div class="card animate-fade-up" style="margin-top:1.5rem">
  <h3>How Tools Work</h3>
  <div style="margin-top:0.75rem;padding:1.25rem;border-radius:12px;background:var(--input-bg);border:1px solid var(--glass-border);font-family:monospace;font-size:0.78rem;line-height:2;color:var(--text-2)">
    <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap">
      <span style="background:rgba(139,92,246,0.15);padding:4px 10px;border-radius:8px;color:#8b5cf6;font-weight:600">User Prompt</span>
      <span style="color:var(--text-3)">→</span>
      <span style="background:rgba(6,182,212,0.15);padding:4px 10px;border-radius:8px;color:#06b6d4;font-weight:600">LLM decides tool</span>
      <span style="color:var(--text-3)">→</span>
      <span style="background:rgba(245,158,11,0.15);padding:4px 10px;border-radius:8px;color:#f59e0b;font-weight:600">Agent calls tool</span>
      <span style="color:var(--text-3)">→</span>
      <span style="background:rgba(16,185,129,0.15);padding:4px 10px;border-radius:8px;color:#10b981;font-weight:600">Result → LLM</span>
      <span style="color:var(--text-3)">→</span>
      <span style="background:rgba(244,63,94,0.15);padding:4px 10px;border-radius:8px;color:#f43f5e;font-weight:600">Response</span>
    </div>
    <div style="margin-top:1rem;font-size:0.78rem;color:var(--text-3);line-height:1.6">
      <strong style="color:var(--text-2)">Built-in tools</strong> are shipped with the platform (math, http-fetch, file I/O, web-search, code-execute, vector ops).<br>
      <strong style="color:var(--text-2)">Custom tools</strong> call any HTTP endpoint you configure — add new APIs, webhooks, or microservices as tools.
    </div>
  </div>
</div>

<!-- Developer Guide: How to Add a New Tool -->
<details class="card animate-fade-up" style="margin-top:1rem;cursor:pointer">
  <summary style="font-weight:600;font-size:0.95rem;color:var(--text-1);list-style:none;display:flex;align-items:center;gap:0.5rem">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#06b6d4" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    How to Add a New Tool
    <span style="font-size:0.7rem;color:var(--text-3);font-weight:400;margin-left:auto">Click to expand</span>
  </summary>
  <div style="margin-top:1rem;font-size:0.82rem;line-height:1.7;color:var(--text-2)">
    <p style="margin-bottom:0.75rem;color:var(--text-3)">Adding a new tool takes <strong style="color:var(--text-1)">3 steps</strong>. Each tool is an HTTP endpoint in the tools-service that agents can call.</p>

    <div style="display:flex;gap:1rem;flex-wrap:wrap">
      <!-- Step 1 -->
      <div style="flex:1;min-width:280px;padding:1rem;border-radius:10px;background:var(--input-bg);border:1px solid var(--glass-border)">
        <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem">
          <span style="background:rgba(6,182,212,0.2);color:#06b6d4;font-weight:700;width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.75rem">1</span>
          <strong style="color:var(--text-1)">Add endpoint in tools-service</strong>
        </div>
        <div style="font-family:monospace;font-size:0.72rem;background:var(--bg-2);padding:0.75rem;border-radius:8px;line-height:1.8;overflow-x:auto">
          <span style="color:#06b6d4"># services/tools/main.py</span><br>
          <span style="color:#c084fc">class</span> <span style="color:#f59e0b">MyToolRequest</span>(BaseModel):<br>
          &nbsp;&nbsp;input_text: str = Field(...)<br><br>
          <span style="color:#c084fc">@app.post</span>(<span style="color:#10b981">"/tools/my-tool"</span>)<br>
          <span style="color:#c084fc">async def</span> <span style="color:#f59e0b">tool_my_tool</span>(body: MyToolRequest):<br>
          &nbsp;&nbsp;result = do_something(body.input_text)<br>
          &nbsp;&nbsp;<span style="color:#c084fc">return</span> {"result": result}
        </div>
      </div>

      <!-- Step 2 -->
      <div style="flex:1;min-width:280px;padding:1rem;border-radius:10px;background:var(--input-bg);border:1px solid var(--glass-border)">
        <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem">
          <span style="background:rgba(139,92,246,0.2);color:#8b5cf6;font-weight:700;width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.75rem">2</span>
          <strong style="color:var(--text-1)">Register proxy in agent</strong>
        </div>
        <div style="font-family:monospace;font-size:0.72rem;background:var(--bg-2);padding:0.75rem;border-radius:8px;line-height:1.8;overflow-x:auto">
          <span style="color:#06b6d4"># services/agent/agent/tools.py</span><br>
          <span style="color:#c084fc">@tool</span><br>
          <span style="color:#c084fc">async def</span> <span style="color:#f59e0b">my_tool</span>(input_text: str) -> str:<br>
          &nbsp;&nbsp;<span style="color:#10b981">"""Describe what this tool does."""</span><br>
          &nbsp;&nbsp;r = <span style="color:#c084fc">await</span> _proxy_call(<br>
          &nbsp;&nbsp;&nbsp;&nbsp;<span style="color:#10b981">"/tools/my-tool"</span>,<br>
          &nbsp;&nbsp;&nbsp;&nbsp;{"input_text": input_text})<br>
          &nbsp;&nbsp;<span style="color:#c084fc">return</span> json.dumps(r)<br><br>
          <span style="color:#06b6d4"># Add to get_all_tools() list:</span><br>
          builtin = [..., my_tool]
        </div>
      </div>

      <!-- Step 3 -->
      <div style="flex:1;min-width:280px;padding:1rem;border-radius:10px;background:var(--input-bg);border:1px solid var(--glass-border)">
        <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem">
          <span style="background:rgba(16,185,129,0.2);color:#10b981;font-weight:700;width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.75rem">3</span>
          <strong style="color:var(--text-1)">Rebuild &amp; test</strong>
        </div>
        <div style="font-family:monospace;font-size:0.72rem;background:var(--bg-2);padding:0.75rem;border-radius:8px;line-height:1.8;overflow-x:auto">
          <span style="color:#06b6d4"># Rebuild containers</span><br>
          docker-compose up -d --build \<br>
          &nbsp;&nbsp;tools-service agent-service<br><br>
          <span style="color:#06b6d4"># Test the endpoint</span><br>
          curl -X POST localhost:8011\<br>
          &nbsp;&nbsp;/tools/my-tool \<br>
          &nbsp;&nbsp;-H "Content-Type: application/json" \<br>
          &nbsp;&nbsp;-d '{"input_text": "hello"}'
        </div>
      </div>
    </div>

    <div style="margin-top:0.75rem;padding:0.75rem;border-radius:8px;background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.2);font-size:0.75rem;color:var(--text-3)">
      <strong style="color:#f59e0b">Tips:</strong>&nbsp;
      Use Pydantic <code style="color:var(--text-2)">Field(...)</code> for validation. Keep param names identical between the endpoint model and the <code style="color:var(--text-2)">@tool</code> function. Add any new pip deps to <code style="color:var(--text-2)">services/tools/requirements.txt</code>. Or skip coding entirely — click <strong style="color:var(--text-1)">New Tool</strong> above to create a custom HTTP tool via the UI.
    </div>
  </div>
</details>

<script>
let allToolsData = [];

const TOOL_ICONS = {
