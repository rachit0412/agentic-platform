<%- include('layout', { title: 'Marketplace', page: 'marketplace', body: `

<h1 class="text-glow-cyan">Marketplace</h1>

<div class="card animate-fade-up" style="margin-bottom:1.5rem">
  <div class="flex" style="gap:1rem;align-items:center">
    <div style="position:relative;flex:1;max-width:350px">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--text-3)" stroke-width="2" style="position:absolute;left:12px;top:50%;transform:translateY(-50%)"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input id="search" placeholder="Search templates..." style="padding-left:36px" oninput="loadTemplates()" />
    </div>
    <select id="typeFilter" style="max-width:200px" onchange="loadTemplates()">
      <option value="">All Types</option>
      <option value="n8n-workflow">n8n Workflows</option>
      <option value="tool">Tools</option>
      <option value="agent-template">Agent Templates</option>
    </select>
  </div>
</div>

<div id="templates" class="grid"></div>

<script>
async function loadTemplates() {
  const search = document.getElementById('search').value;
  const type = document.getElementById('typeFilter').value;
  const params = new URLSearchParams();
  if (search) params.set('search', search);
  if (type) params.set('type', type);

  try {
    const r = await fetch('/api/marketplace/templates?' + params);
    const d = await r.json();
    const el = document.getElementById('templates');
    el.innerHTML = d.templates.map(t => \`
      <div class="card card-hover animate-fade-up">
        <div style="display:flex;justify-content:space-between;align-items:start;margin-bottom:0.75rem">
          <strong style="color:var(--text-1)">\${t.name}</strong>
          <span class="badge \${t.installed ? 'badge-success' : 'badge-info'}">\${t.installed ? 'Installed' : t.type}</span>
        </div>
        <p style="font-size:0.82rem;color:var(--text-3);margin-bottom:1rem;line-height:1.5">\${t.description}</p>
        <button class="btn \${t.installed ? 'btn-danger' : 'btn-primary'} btn-sm"
                onclick="\${t.installed ? \`uninstall('\${t.id}')\` : \`install('\${t.id}')\`}">
          \${t.installed ? 'Uninstall' : 'Install'}
        </button>
      </div>
    \`).join('');
  } catch(e) {
    document.getElementById('templates').innerHTML = '<div class="card"><p style="color:var(--text-3)">Failed to load templates</p></div>';
  }
}

async function install(id) {
  await fetch('/api/marketplace/templates/' + id + '/install', { method: 'POST' });
  loadTemplates();
}

async function uninstall(id) {
  await fetch('/api/marketplace/templates/' + id + '/uninstall', { method: 'POST' });
  loadTemplates();
}

loadTemplates();
</script>
` }) %>
