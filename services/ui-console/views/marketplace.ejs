<%- include('layout', { title: 'Marketplace', page: 'marketplace', body: `

<h1 class="text-glow-cyan">Marketplace</h1>

<div class="card animate-fade-up" style="margin-bottom:1.5rem">
  <div class="flex" style="gap:1rem;align-items:center">
    <div style="position:relative;flex:1;max-width:350px">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--text-3)" stroke-width="2" style="position:absolute;left:12px;top:50%;transform:translateY(-50%)"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input id="search" placeholder="Search templates..." style="padding-left:36px" oninput="loadTemplates()" />
    </div>
    <select id="typeFilter" style="width:auto;min-width:160px" onchange="loadTemplates()">
      <option value="">All Types</option>
      <option value="n8n-workflow">n8n Workflows</option>
      <option value="tool">Tools</option>
      <option value="agent-template">Agent Templates</option>
    </select>
  </div>
</div>

<div id="templates" class="grid"></div>

<script>
async function loadTemplates() {
  const search = document.getElementById('search').value;
  const type = document.getElementById('typeFilter').value;
  const params = new URLSearchParams();
  if (search) params.set('search', search);
  if (type) params.set('type', type);

  try {
    const r = await fetch('/api/marketplace/templates?' + params);
    const d = await r.json();
    const el = document.getElementById('templates');
    el.innerHTML = d.templates.map(t => \`
      <div class="card card-hover animate-fade-up">
        <div style="display:flex;justify-content:space-between;align-items:start;margin-bottom:0.75rem">
          <strong style="color:var(--text-1)">\${escapeHtml(t.name)}</strong>
          <span class="badge \${t.installed ? 'badge-success' : 'badge-info'}">\${t.installed ? 'Installed' : escapeHtml(t.type)}</span>
        </div>
        <p style="font-size:0.82rem;color:var(--text-3);margin-bottom:1rem;line-height:1.5">\${escapeHtml(t.description)}</p>
        <button class="btn \${t.installed ? 'btn-danger' : 'btn-primary'} btn-sm"
                onclick="\${t.installed ? \`uninstall('\${escapeHtml(t.id)}')\` : \`install('\${escapeHtml(t.id)}')\`}">
          \${t.installed ? 'Uninstall' : 'Install'}
        </button>
      </div>
    \`).join('');
  } catch(e) {
    document.getElementById('templates').innerHTML = '<div class="card"><p style="color:var(--text-3)">Failed to load templates</p></div>';
  }
}

async function install(id) {
  try {
    var r = await fetch('/api/marketplace/templates/' + id + '/install', { method: 'POST' });
    if (!r.ok) throw new Error('Install failed: ' + r.status);
    loadTemplates();
  } catch(e) {
    console.error(e);
    if (typeof showToast === 'function') showToast('Install failed: ' + e.message, 'error');
  }
}

async function uninstall(id) {
  try {
    var r = await fetch('/api/marketplace/templates/' + id + '/uninstall', { method: 'POST' });
    if (!r.ok) throw new Error('Uninstall failed: ' + r.status);
    loadTemplates();
  } catch(e) {
    console.error(e);
    if (typeof showToast === 'function') showToast('Uninstall failed: ' + e.message, 'error');
  }
}

loadTemplates();
<\/script>

<!-- ── Guides: How to Add Tools & Marketplace Agents ── -->
<div style="margin-top:2.5rem;border-top:1px solid var(--glass-border);padding-top:2rem">
  <h2 class="text-glow-cyan" style="font-size:1.25rem;margin-bottom:1rem">How to Add & Maintain Custom Tools, Agents & Templates</h2>

  <div class="grid" style="grid-template-columns:1fr 1fr 1fr;gap:1rem">
    <!-- Guide 1: Creating a New Tool -->
    <div class="card" style="border-left:3px solid #10b981">
      <h3 style="margin:0 0 0.75rem;font-size:0.95rem;color:#10b981">🔧 Creating a New Tool</h3>
      <ol style="color:var(--text-2);font-size:0.8rem;line-height:1.7;padding-left:1.25rem;margin:0">
        <li>Open <code>services/agent/agent/tools.py</code></li>
        <li>Add a new function with the <code>@tool</code> decorator:
          <pre style="background:var(--input-bg);border-radius:6px;padding:0.5rem;margin:0.5rem 0;font-size:0.72rem;overflow-x:auto"><code>@tool
async def my_tool(param: str) -> str:
    """Description of what this tool does."""
    result = await _proxy_call(
        "/tools/my-endpoint",
        {"param": param}
    )
    return json.dumps(result)</code></pre>
        </li>
        <li>If it calls tools-service, add the endpoint in <code>services/tools/main.py</code></li>
        <li>Register it in the <code>get_tools()</code> list at the bottom of <code>tools.py</code></li>
        <li>Rebuild: <code>docker-compose build agent-service</code></li>
      </ol>
      <p style="color:var(--text-3);font-size:0.72rem;margin-top:0.75rem"><strong>Tip:</strong> Use <code>_proxy_call()</code> for tools-service proxied tools, or write logic directly for local tools.</p>
    </div>

    <!-- Guide 2: Creating a Marketplace Agent Template -->
    <div class="card" style="border-left:3px solid #6366f1">
      <h3 style="margin:0 0 0.75rem;font-size:0.95rem;color:#6366f1">🤖 Creating a Marketplace Agent</h3>
      <ol style="color:var(--text-2);font-size:0.8rem;line-height:1.7;padding-left:1.25rem;margin:0">
        <li>Open <code>services/ui-console/marketplace.js</code></li>
        <li>Add a new entry to the <code>TEMPLATES</code> array:
          <pre style="background:var(--input-bg);border-radius:6px;padding:0.5rem;margin:0.5rem 0;font-size:0.72rem;overflow-x:auto"><code>{
  id: "my-agent-template",
  name: "My Custom Agent",
  type: "agent-template",
  description: "Does X using Y tools",
  config: {
    name: "My Agent",
    description: "...",
    provider: "ollama",
    model: "llama3",
    system_prompt: "You are...",
    tool_ids: ["web_search"],
    skill_ids: []
  }
}</code></pre>
        </li>
        <li>The <code>install</code> action auto-creates the agent via the API</li>
        <li>Restart: <code>docker-compose restart ui-console</code></li>
      </ol>
      <p style="color:var(--text-3);font-size:0.72rem;margin-top:0.75rem"><strong>Types:</strong> <code>agent-template</code>, <code>tool</code>, <code>n8n-workflow</code></p>
    </div>

    <!-- Guide 3: Maintaining & Contributing -->
    <div class="card" style="border-left:3px solid #f59e0b">
      <h3 style="margin:0 0 0.75rem;font-size:0.95rem;color:#f59e0b">📦 Maintaining & Contributing</h3>
      <div style="color:var(--text-2);font-size:0.8rem;line-height:1.7">
        <p style="margin:0 0 0.5rem"><strong>File Locations:</strong></p>
        <ul style="padding-left:1.25rem;margin:0 0 0.75rem">
          <li><code>services/agent/agent/tools.py</code> — tool definitions</li>
          <li><code>services/tools/main.py</code> — tools-service endpoints</li>
          <li><code>services/ui-console/marketplace.js</code> — marketplace templates</li>
          <li><code>n8n/workflows/</code> — n8n workflow JSON files</li>
        </ul>
        <p style="margin:0 0 0.5rem"><strong>Best Practices:</strong></p>
        <ul style="padding-left:1.25rem;margin:0">
          <li>Always add a docstring to tools — it's the LLM's description</li>
          <li>Use <code>async</code> for all tool functions</li>
          <li>Keep marketplace <code>id</code> fields unique and URL-safe</li>
          <li>Test tools locally before adding to marketplace</li>
          <li>n8n workflows: export JSON from n8n UI, save to <code>n8n/workflows/</code></li>
        </ul>
      </div>
    </div>
  </div>
</div>

` }) %>
