<script>
  // Initialize Mermaid
  mermaid.initialize({
    startOnLoad: false,
    theme: document.documentElement.classList.contains('dark') ? 'dark' : 'default',
    themeVariables: {
      primaryColor: '#0e7490',
      primaryTextColor: '#e2e8f0',
      primaryBorderColor: '#06b6d4',
      lineColor: '#64748b',
      sectionBkgColor: 'transparent'
    }
  });

  function showDoc(id) {
    document.querySelectorAll('.docs-section').forEach(function(s) { s.classList.remove('active'); });
    document.querySelectorAll('.ds-link').forEach(function(l) { l.classList.remove('active'); });
    var section = document.getElementById('doc-' + id);
    if (section) {
      section.classList.add('active');
      // Re-render mermaid diagrams in the newly visible section
      section.querySelectorAll('.mermaid').forEach(function(el) {
        if (!el.getAttribute('data-processed')) {
          mermaid.run({ nodes: [el] });
        }
      });
    }
    var link = document.querySelector('[data-section="' + id + '"]');
    if (link) link.classList.add('active');
    // Update URL without reload
    history.replaceState(null, '', '/docs#' + id);
    // Scroll content to top
    document.querySelector('.docs-content').scrollTop = 0;
  }

  function filterDocs(query) {
    var q = query.toLowerCase();
    document.querySelectorAll('.ds-link').forEach(function(link) {
      var text = link.textContent.toLowerCase();
      var section = document.getElementById('doc-' + link.dataset.section);
      var sectionText = section ? section.textContent.toLowerCase() : '';
      link.style.display = (!q || text.includes(q) || sectionText.includes(q)) ? '' : 'none';
    });
  }

  // Handle hash navigation
  var hash = window.location.hash.replace('#', '');
  if (hash) showDoc(hash);

  // Render mermaid in initial visible section
  document.addEventListener('DOMContentLoaded', function() {
    var active = document.querySelector('.docs-section.active');
    if (active) {
      active.querySelectorAll('.mermaid').forEach(function(el) {
        mermaid.run({ nodes: [el] });
      });
    }
  });
<\/script>

