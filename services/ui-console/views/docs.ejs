│   │   │   ├── tools.py        # Tool definitions
│   │   │   ├── vectorstore.py  # ChromaDB integration
│   │   │   └── observability.py # OTel + Langfuse
│   │   └── main.py     # FastAPI app & routes
│   ├── tools/           # External tools microservice
│   ├── ui-console/      # Express.js dashboard
│   └── otel/            # OpenTelemetry collector config
├── n8n/workflows/       # n8n workflow definitions
├── observability/       # Grafana, Prometheus, Loki configs
├── tests/               # Unit, integration, e2e, load tests
├── docs/                # Generated documentation
└── docker-compose.yml   # 13-service orchestration</code></pre>
