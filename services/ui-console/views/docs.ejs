<%- include('layout', {
  page: 'docs',
  title: 'Documentation',
  urls: urls,
  body: `

<style>
  .docs-layout { display:grid; grid-template-columns:240px 1fr; gap:0; min-height:calc(100vh - 80px); }
  .docs-sidebar { background:var(--glass-bg); border-right:1px solid var(--glass-border); padding:1.25rem 0; position:sticky; top:60px; height:calc(100vh - 80px); overflow-y:auto; }
  .docs-sidebar .ds-group { margin-bottom:0.75rem; }
  .docs-sidebar .ds-group-title { padding:0.4rem 1.25rem; font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-3); }
  .docs-sidebar .ds-link { display:block; padding:0.4rem 1.25rem 0.4rem 1.5rem; font-size:0.82rem; color:var(--text-2); text-decoration:none; border-left:2px solid transparent; transition:all 0.15s; cursor:pointer; }
  .docs-sidebar .ds-link:hover { color:var(--text-1); background:rgba(6,182,212,0.05); }
  .docs-sidebar .ds-link.active { color:#06b6d4; border-left-color:#06b6d4; background:rgba(6,182,212,0.08); font-weight:600; }
  .docs-content { padding:2rem 2.5rem; max-width:1100px; overflow-y:auto; }
  .docs-content h1 { font-size:1.8rem; font-weight:700; margin-bottom:0.5rem; }
  .docs-content h2 { font-size:1.25rem; font-weight:700; margin:2rem 0 0.75rem; padding-bottom:0.5rem; border-bottom:1px solid var(--glass-border); }
  .docs-content h3 { font-size:1rem; font-weight:600; margin:1.5rem 0 0.5rem; }
  .docs-content p { line-height:1.7; color:var(--text-2); margin-bottom:1rem; }
  .docs-content ul, .docs-content ol { padding-left:1.5rem; margin-bottom:1rem; color:var(--text-2); line-height:1.8; }
  .docs-content code { background:var(--glass-bg); border:1px solid var(--glass-border); border-radius:4px; padding:0.15rem 0.4rem; font-size:0.82rem; font-family:'Fira Code',monospace; }
  .docs-content pre { background:var(--glass-bg); border:1px solid var(--glass-border); border-radius:10px; padding:1rem 1.25rem; overflow-x:auto; margin-bottom:1rem; font-size:0.82rem; line-height:1.6; }
  .docs-content pre code { background:none; border:none; padding:0; }
  .docs-table { width:100%; border-collapse:collapse; margin-bottom:1rem; font-size:0.85rem; }
  .docs-table th { text-align:left; padding:0.6rem 0.75rem; background:var(--glass-bg); border:1px solid var(--glass-border); font-weight:600; color:var(--text-1); }
  .docs-table td { padding:0.5rem 0.75rem; border:1px solid var(--glass-border); color:var(--text-2); }
  .docs-search { width:100%; padding:0.5rem 0.75rem; border:1px solid var(--glass-border); border-radius:8px; background:var(--glass-bg); color:var(--text-1); font-size:0.82rem; margin:0 0 0.75rem; }
  .docs-search:focus { outline:none; border-color:#06b6d4; }
  .docs-toc { position:sticky; top:100px; right:2rem; width:200px; font-size:0.8rem; color:var(--text-3); }
  .docs-toc ul { list-style:none; padding:0; margin:0; }
  .docs-toc li { padding:0.3rem 0; }
  .docs-toc a { color:#06b6d4; text-decoration:none; }
  .docs-loading { text-align:center; padding:3rem; color:var(--text-3); }
  .docs-error { padding:1.5rem; background:rgba(239,68,68,0.1); border-left:3px solid #ef4444; color:#ef4444; border-radius:6px; }
  @media (max-width:900px) { .docs-toc { display:none; } }
</style>

<div class="docs-layout">
  <div class="docs-sidebar">
    <input type="text" class="docs-search" id="docs-search" placeholder="Search docs...">
    <div id="docs-nav">Loading documentation...</div>
  </div>
  <div class="docs-content" id="docs-main">
    <div class="docs-loading">Loading documentation...</div>
  </div>
</div>

<script src="/js/docs-client.js"><\/script>
<script>
const docsList = {
  'Getting Started': {
    'Platform Overview': 'PLATFORM-OVERVIEW',
    'Quick Start Guide': 'QUICK-START',
    'Installation': 'INSTALLATION'
  },
  'Architecture': {
    'Principles': 'PRINCIPLES',
    'Building Blocks': 'BUILDING-BLOCKS',
    'Decisions (ADRs)': 'DECISIONS',
    'System Architecture': 'ARCHITECTURE',
    'Data Flow': 'DATA-FLOW',
    'Network Architecture': 'NETWORK-ARCHITECTURE',
    'Service Reference': 'SERVICE-REFERENCE'
  },
  'Core Features': {
    'Agent System': 'AGENT-SYSTEM',
    'LLM Providers': 'LLM-PROVIDERS',
    'Memory & Knowledge': 'MEMORY-KNOWLEDGE',
    'Guardrails': 'GUARDRAILS',
    'Tools & MCP': 'TOOLS-MCP'
  },
  'Operations': {
    'Observability': 'OBSERVABILITY',
    'Workflows (n8n)': 'WORKFLOWS-N8N',
    'Deployment': 'DEPLOYMENT'
  },
  'Reference': {
    'API Reference': 'API-REFERENCE',
    'Configuration': 'CONFIGURATION',
    'Security Controls': 'SECURITY-CONTROLS-INTEGRATION',
    'Dynamic Content Guide': 'DYNAMIC-CONTENT-GUIDE'
  }
};

const docMap = {};
Object.values(docsList).forEach(section => {
  Object.entries(section).forEach(([label, docName]) => {
    docMap[label] = docName;
  });
});

let currentDoc = null;

// Build navigation
function renderNav() {
  let html = '';
  for (const [section, docs] of Object.entries(docsList)) {
    html += \`<div class="ds-group">
      <div class="ds-group-title">\${section}</div>\`;
    for (const [label, docName] of Object.entries(docs)) {
      html += \`<a class="ds-link" data-doc="\${docName}" onclick="loadDoc(event)">\${label}</a>\`;
    }
    html += '</div>';
  }
  document.getElementById('docs-nav').innerHTML = html;
}

// Load documentation
async function loadDoc(event) {
  const docName = event.currentTarget.getAttribute('data-doc');
  if (!docName) return;

  currentDoc = docName;

  // Update active link
  document.querySelectorAll('.ds-link').forEach(link => {
    link.classList.toggle('active', link.getAttribute('data-doc') === docName);
  });

  try {
    await DocsClient.loadIntoElement(docName, '#docs-main', {
      format: 'raw',
      showToc: false,
      forceRefresh: false
    });
  } catch (e) {
    document.getElementById('docs-main').innerHTML =
      \`<div class="docs-error"><strong>Error loading documentation:</strong> \${escapeHtml(e.message)}</div>\`;
  }

  // Update URL hash
  window.location.hash = '#' + docName.toLowerCase().replace(/[^a-z0-9]/g, '-');
}

// Load from hash
function loadFromHash() {
  const hash = window.location.hash.replace('#', '');
  if (!hash) {
    loadDoc({currentTarget: {getAttribute: () => 'PRINCIPLES'}});
    return;
  }

  // Find doc matching hash
  for (const [label, docName] of Object.entries(docMap)) {
    if (docName.toLowerCase().replace(/[^a-z0-9]/g, '-') === hash) {
      loadDoc({currentTarget: {getAttribute: () => docName}});
      return;
    }
  }

  // Default to principles
  loadDoc({currentTarget: {getAttribute: () => 'PRINCIPLES'}});
}

// Escape HTML
function escapeHtml(text) {
  const div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
}

// Initialize
renderNav();
loadFromHash();

// Re-render on hash change
window.addEventListener('hashchange', loadFromHash);
<\/script>

` }) %>
