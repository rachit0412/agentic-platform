      <h2>Request: Run Agent</h2>
      <pre><code>POST /agent/run
Content-Type: application/json

{
  "message": "What is the capital of France?",
  "session_id": "optional-session-id",
  "model": "llama3",
  "provider": "ollama",
  "tools": ["web_search", "calculator"]
}</code></pre>

      <h2>Response: SSE Stream</h2>
      <pre><code>event: token
data: {"token": "The"}

event: token
data: {"token": " capital"}

event: tool_call
data: {"tool": "web_search", "input": "capital of France"}

event: done
data: {"tools_used": ["web_search"], "guardrails": {...}, "usage": {...}}</code></pre>
