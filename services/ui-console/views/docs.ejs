  var _activeNodePopup = null;
  function dismissNodePopup() {
    if (_activeNodePopup) {
      _activeNodePopup.classList.remove('active');
      var ref = _activeNodePopup;
      setTimeout(function() { if (ref && ref.parentNode) ref.remove(); }, 200);
      _activeNodePopup = null;
    }
  }

  function showNodeInfo(label, evt) {
    dismissNodePopup();
    var info = NODE_INFO[label];
    if (!info) return;

    var popup = document.createElement('div');
    popup.className = 'node-info-popup';
    popup.innerHTML = '<div class="node-info-popup-title">' + info.title + '<\/div>' +
      '<div class="node-info-popup-desc">' + info.desc + '<\/div>' +
      '<div class="node-info-popup-meta">' + info.meta + '<\/div>' +
      (info.section ? '<a class="node-info-popup-link" onclick="dismissNodePopup();showDoc(\\'' + info.section + '\\');">Learn more →<\/a>' : '');

    document.body.appendChild(popup);
    var x = Math.min(evt.clientX + 12, window.innerWidth - 360);
    var y = Math.min(evt.clientY - 10, window.innerHeight - 200);
    if (x < 10) x = 10;
    if (y < 10) y = 10;
    popup.style.left = x + 'px';
    popup.style.top = y + 'px';
    _activeNodePopup = popup;
    requestAnimationFrame(function() { popup.classList.add('active'); });

    setTimeout(function() {
      document.addEventListener('click', function handler(e) {
        if (!popup.contains(e.target)) {
          dismissNodePopup();
          document.removeEventListener('click', handler);
        }
      });
    }, 50);
  }

  function attachNodeClickHandlers() {
    document.querySelectorAll('.docs-diagram svg .node').forEach(function(node) {
      if (node.hasAttribute('data-node-click')) return;
      node.setAttribute('data-node-click', 'true');
      node.style.cursor = 'pointer';
      var textEl = node.querySelector('.nodeLabel') || node.querySelector('text') || node.querySelector('foreignObject span');
      var label = textEl ? textEl.textContent.trim() : '';
      if (!label) return;
      node.addEventListener('click', function(e) { e.stopPropagation(); showNodeInfo(label, e); });
    });
    document.querySelectorAll('.docs-diagram svg .statediagram-state').forEach(function(node) {
      if (node.hasAttribute('data-node-click')) return;
      node.setAttribute('data-node-click', 'true');
      node.style.cursor = 'pointer';
      var textEl = node.querySelector('.state-title-text') || node.querySelector('text');
      var label = textEl ? textEl.textContent.trim() : '';
      if (!label) return;
      node.addEventListener('click', function(e) { e.stopPropagation(); showNodeInfo(label, e); });
    });
    document.querySelectorAll('.docs-diagram svg text.actor').forEach(function(textNode) {
      if (textNode.hasAttribute('data-node-click')) return;
      textNode.setAttribute('data-node-click', 'true');
      textNode.style.cursor = 'pointer';
      var label = textNode.textContent.trim();
      if (!label) return;
      textNode.addEventListener('click', function(e) { e.stopPropagation(); showNodeInfo(label, e); });
    });
  }

  /* ── HD Diagram Zoom Lightbox ── */
  function openDiagramLightbox(diagramEl) {
    var existing = document.querySelector('.diagram-lightbox');
    if (existing) existing.remove();

    var overlay = document.createElement('div');
    overlay.className = 'diagram-lightbox';
    overlay.innerHTML = '<button class="diagram-lightbox-close" title="Close">&times;<\/button>' +
      '<div class="diagram-lightbox-inner"><\/div>' +
      '<div class="diagram-lightbox-hint">Press Esc or click outside to close<\/div>';

    var inner = overlay.querySelector('.diagram-lightbox-inner');

    // Try to re-render mermaid source at full size for HD quality
    var mermaidEl = diagramEl.querySelector('.mermaid');
    var source = mermaidEl ? mermaidEl.getAttribute('data-original-source') : null;

    if (source && source.trim()) {
      var renderDiv = document.createElement('div');
      renderDiv.style.width = '100%';
      inner.appendChild(renderDiv);
      var renderId = 'lightbox-' + Date.now();
      mermaid.render(renderId, source.trim()).then(function(result) {
        renderDiv.innerHTML = result.svg;
        var svg = renderDiv.querySelector('svg');
        if (svg) {
          svg.style.width = '100%';
          svg.style.height = 'auto';
          svg.style.maxHeight = '78vh';
        }
      }).catch(function() {
        cloneSvgIntoLightbox(diagramEl, inner);
      });
    } else {
      cloneSvgIntoLightbox(diagramEl, inner);
    }

    document.body.appendChild(overlay);
    requestAnimationFrame(function() { overlay.classList.add('active'); });

    function closeBox() {
      overlay.classList.remove('active');
      setTimeout(function() { overlay.remove(); }, 200);
    }
    overlay.querySelector('.diagram-lightbox-close').addEventListener('click', function(e) { e.stopPropagation(); closeBox(); });
    overlay.addEventListener('click', function(e) { if (e.target === overlay) closeBox(); });
    document.addEventListener('keydown', function handler(e) {
      if (e.key === 'Escape') { closeBox(); document.removeEventListener('keydown', handler); }
    });
  }

  function cloneSvgIntoLightbox(diagramEl, container) {
    var svg = diagramEl.querySelector('svg');
    if (svg) {
      var clone = svg.cloneNode(true);
      var vb = svg.getAttribute('viewBox');
      if (!vb) {
        var bbox = svg.getBBox ? svg.getBBox() : null;
        if (bbox) clone.setAttribute('viewBox', '0 0 ' + (bbox.width + bbox.x * 2) + ' ' + (bbox.height + bbox.y * 2));
      }
      clone.removeAttribute('width');
      clone.removeAttribute('height');
      clone.removeAttribute('style');
      clone.setAttribute('preserveAspectRatio', 'xMidYMid meet');
      clone.style.width = '100%';
      clone.style.height = 'auto';
      clone.style.maxHeight = '78vh';
      container.appendChild(clone);
    } else {
      container.innerHTML = '<p style="color:var(--text-3)">Unable to load diagram<\/p>';
    }
  }

  // Save mermaid source before rendering (for HD re-render in lightbox)
  function saveMermaidSources() {
    document.querySelectorAll('.mermaid').forEach(function(el) {
      if (!el.getAttribute('data-original-source') && !el.querySelector('svg')) {
        el.setAttribute('data-original-source', el.textContent);
      }
    });
  }
  saveMermaidSources();

  // Attach zoom to all diagrams
  function attachDiagramZoom() {
    document.querySelectorAll('.docs-diagram').forEach(function(el) {
      if (!el.hasAttribute('data-zoom')) {
        el.setAttribute('data-zoom', 'true');
        el.addEventListener('click', function(e) {
          if (e.target.closest('.node') || e.target.closest('.statediagram-state') || e.target.closest('.actor')) return;
          openDiagramLightbox(el);
        });
      }
    });
  }

  function showDoc(id) {
    dismissNodePopup();
    document.querySelectorAll('.docs-section').forEach(function(s) { s.classList.remove('active'); });
    document.querySelectorAll('.ds-link').forEach(function(l) { l.classList.remove('active'); });
    var section = document.getElementById('doc-' + id);
    if (section) {
      section.classList.add('active');
      section.querySelectorAll('.mermaid').forEach(function(el) {
        if (!el.getAttribute('data-original-source') && !el.querySelector('svg')) {
          el.setAttribute('data-original-source', el.textContent);
        }
      });
      section.querySelectorAll('.mermaid').forEach(function(el) {
        if (!el.getAttribute('data-processed')) {
          mermaid.run({ nodes: [el] }).then(function() {
            attachDiagramZoom();
            attachNodeClickHandlers();
          });
        }
      });
    }
    var link = document.querySelector('[data-section="' + id + '"]');
    if (link) link.classList.add('active');
    history.replaceState(null, '', '/docs#' + id);
    document.querySelector('.docs-content').scrollTop = 0;
    attachDiagramZoom();
    attachNodeClickHandlers();
  }

  function filterDocs(query) {
    var q = query.toLowerCase();
    document.querySelectorAll('.ds-link').forEach(function(link) {
      var text = link.textContent.toLowerCase();
      var section = document.getElementById('doc-' + link.dataset.section);
      var sectionText = section ? section.textContent.toLowerCase() : '';
      link.style.display = (!q || text.includes(q) || sectionText.includes(q)) ? '' : 'none';
    });
  }

  // Handle hash navigation
  var hash = window.location.hash.replace('#', '');
  if (hash) showDoc(hash);

  // Render mermaid in initial visible section + attach interactions
  document.addEventListener('DOMContentLoaded', function() {
    saveMermaidSources();
    var active = document.querySelector('.docs-section.active');
    if (active) {
      active.querySelectorAll('.mermaid').forEach(function(el) {
        if (!el.getAttribute('data-original-source') && !el.querySelector('svg')) {
          el.setAttribute('data-original-source', el.textContent);
        }
      });
      active.querySelectorAll('.mermaid').forEach(function(el) {
        mermaid.run({ nodes: [el] }).then(function() {
          attachDiagramZoom();
          attachNodeClickHandlers();
        });
      });
    }
    attachDiagramZoom();
    attachNodeClickHandlers();
  });
<\/script>

