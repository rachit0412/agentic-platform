var currentDomain = 'execution';

function getAgentDocsUrl() {
  var u = window.location.origin.replace(':3000', ':8010');
  return u + '/openapi.json';
}
function getSwaggerUrl() {
  var u = window.location.origin.replace(':3000', ':8010');
  return u + '/docs';
}

