<%- include('layout', { title: 'REST Console', page: 'rest', body: `

<style>
/* ── Layout ───────────────────────────────── */
.rest-layout { display:flex; gap:1.25rem; height:calc(100vh - 220px); }
.rest-sidebar { width:220px; flex-shrink:0; overflow-y:auto; }
.rest-main { flex:1; overflow-y:auto; min-width:0; }

/* ── Domain sidebar ──────────────────────── */
.domain-item { display:flex; align-items:center; justify-content:space-between; padding:0.5rem 0.75rem; border-radius:8px; cursor:pointer; font-size:0.82rem; color:var(--text-2); transition:all 0.15s; margin-bottom:2px; }
.domain-item:hover { background:var(--glass-bg); color:var(--text-1); }
.domain-item.active { background:var(--accent-bg); color:var(--accent-text); font-weight:600; }
.domain-count { font-size:0.7rem; background:var(--glass-bg); padding:1px 6px; border-radius:10px; color:var(--text-3); }
.domain-item.active .domain-count { background:rgba(6,182,212,0.2); color:var(--accent-text); }

/* ── Endpoint cards ──────────────────────── */
.ep-card { border:1px solid var(--glass-border); border-radius:10px; padding:1rem; margin-bottom:0.75rem; background:var(--glass-bg); transition:border-color 0.15s; }
.ep-card:hover { border-color:var(--glass-hover-border); }
.ep-header { display:flex; align-items:center; gap:0.75rem; cursor:pointer; }
.ep-method { font-size:0.7rem; font-weight:700; padding:3px 8px; border-radius:5px; font-family:var(--mono); letter-spacing:0.5px; min-width:52px; text-align:center; }
.ep-method.get { background:rgba(16,185,129,0.15); color:#10b981; }
.ep-method.post { background:rgba(59,130,246,0.15); color:#3b82f6; }
.ep-method.put { background:rgba(245,158,11,0.15); color:#f59e0b; }
.ep-method.delete { background:rgba(239,68,68,0.15); color:#ef4444; }
.ep-path { font-family:var(--mono); font-size:0.82rem; color:var(--text-1); font-weight:500; }
.ep-path .param { color:#8b5cf6; }
.ep-desc { font-size:0.78rem; color:var(--text-3); margin-left:auto; }
.ep-try { display:none; margin-top:1rem; padding-top:1rem; border-top:1px solid var(--glass-border); }
.ep-try.open { display:block; }
.ep-try-grid { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
.ep-response { margin-top:0.75rem; border-radius:8px; background:var(--input-bg); max-height:300px; overflow-y:auto; font-family:var(--mono); font-size:0.78rem; color:var(--text-2); }
.ep-response pre { margin:0; padding:1rem; white-space:pre-wrap; word-break:break-all; }
.ep-status { display:inline-block; font-size:0.72rem; font-weight:700; padding:2px 8px; border-radius:4px; font-family:var(--mono); }
.ep-status.s2xx { background:rgba(16,185,129,0.15); color:#10b981; }
.ep-status.s4xx { background:rgba(245,158,11,0.15); color:#f59e0b; }
.ep-status.s5xx { background:rgba(239,68,68,0.15); color:#ef4444; }
.ep-timing { font-size:0.72rem; color:var(--text-3); margin-left:0.5rem; }

/* ── Base URL bar ────────────────────────── */
.base-url-bar { display:flex; align-items:center; gap:0.75rem; padding:0.5rem 0.75rem; background:var(--glass-bg); border:1px solid var(--glass-border); border-radius:8px; margin-bottom:1rem; font-family:var(--mono); font-size:0.8rem; color:var(--text-2); }
.base-url-bar code { color:var(--accent-text); font-weight:600; }
.base-url-bar .toggle-svc { font-size:0.72rem; padding:3px 8px; border-radius:5px; cursor:pointer; border:1px solid var(--glass-border); background:var(--glass-bg); color:var(--text-2); transition:all 0.15s; }
.base-url-bar .toggle-svc.active { background:var(--accent-bg); color:var(--accent-text); border-color:var(--accent-text); }
.quick-links { display:flex; gap:0.5rem; margin-left:auto; }
.quick-links a { font-size:0.72rem; padding:3px 10px; border-radius:5px; background:var(--glass-bg); border:1px solid var(--glass-border); color:var(--text-2); text-decoration:none; transition:all 0.15s; }
.quick-links a:hover { background:var(--accent-bg); color:var(--accent-text); }

/* ── Endpoint Index Modal ────────────────── */
.ep-index-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.45); z-index:1000; backdrop-filter:blur(6px); }
.ep-index-overlay.open { display:flex; align-items:center; justify-content:center; }
.ep-index-modal { background:var(--bg); border:1px solid var(--glass-border); border-radius:12px; width:720px; max-width:90vw; max-height:80vh; display:flex; flex-direction:column; box-shadow:0 20px 60px rgba(0,0,0,0.25); }
.ep-index-header { display:flex; align-items:center; justify-content:space-between; padding:1rem 1.25rem; border-bottom:1px solid var(--glass-border); }
.ep-index-header h3 { margin:0; font-size:1rem; color:var(--text-1); }
.ep-index-search { margin:0; padding:0.5rem 1.25rem; border-bottom:1px solid var(--glass-border); }
.ep-index-search input { width:100%; background:var(--input-bg); border:1px solid var(--input-border); border-radius:6px; padding:0.4rem 0.6rem; font-size:0.8rem; color:var(--text-1); outline:none; }
.ep-index-search input:focus { border-color:var(--accent-text); background:var(--glass-hover-bg); }
.ep-index-body { overflow-y:auto; padding:0.5rem 0; flex:1; }
.ep-index-item { display:flex; align-items:center; gap:0.6rem; padding:0.35rem 1.25rem; cursor:pointer; font-size:0.8rem; transition:background 0.1s; }
.ep-index-item:hover { background:var(--glass-hover-bg); }
.ep-index-item .eii-domain { font-size:0.65rem; color:var(--text-3); margin-left:auto; min-width:80px; text-align:right; }
.ep-index-close { background:none; border:none; color:var(--text-3); cursor:pointer; font-size:1.2rem; padding:4px 8px; border-radius:4px; }
.ep-index-close:hover { background:var(--glass-hover-bg); color:var(--text-1); }

/* ── Method Breakdown Modal ──────────────── */
.method-breakdown-bar { display:flex; align-items:flex-end; gap:0.75rem; height:140px; padding:0.5rem 0; }
.mb-col { display:flex; flex-direction:column; align-items:center; gap:0.35rem; flex:1; }
.mb-bar { width:100%; border-radius:6px 6px 0 0; min-height:4px; transition:height 0.4s ease; }
.mb-bar.get { background:linear-gradient(to top,rgba(16,185,129,0.6),#10b981); }
.mb-bar.post { background:linear-gradient(to top,rgba(59,130,246,0.6),#3b82f6); }
.mb-bar.put { background:linear-gradient(to top,rgba(245,158,11,0.6),#f59e0b); }
.mb-bar.delete { background:linear-gradient(to top,rgba(239,68,68,0.6),#ef4444); }
.mb-label { font-size:0.72rem; font-weight:700; font-family:var(--mono); }
.mb-count { font-size:0.9rem; font-weight:700; color:var(--text-1); }
.mb-domain-list { margin-top:0.75rem; max-height:180px; overflow-y:auto; }
.mb-domain-row { display:flex; align-items:center; justify-content:space-between; padding:0.3rem 0; border-bottom:1px solid var(--glass-border); font-size:0.78rem; }
.mb-domain-row:last-child { border-bottom:none; }
.mb-domain-name { color:var(--text-2); }
.mb-domain-counts { display:flex; gap:0.5rem; }
.mb-dc { font-size:0.68rem; font-weight:600; font-family:var(--mono); padding:1px 6px; border-radius:4px; }

/* ── Swagger link in domain header ───────── */
.domain-swagger { font-size:0.68rem; color:var(--text-3); text-decoration:none; margin-left:0.5rem; padding:1px 6px; border-radius:4px; border:1px solid var(--glass-border); transition:all 0.15s; }
.domain-swagger:hover { color:var(--accent-text); border-color:var(--accent-text); }

/* ── Health inline chip ──────────────────── */
.svc-health-chip { display:inline-flex; align-items:center; gap:5px; font-size:0.72rem; padding:3px 10px; border-radius:20px; background:var(--glass-bg); border:1px solid var(--glass-border); font-weight:600; transition:all 0.2s; }
.svc-health-chip .h-dot { width:7px; height:7px; border-radius:50%; flex-shrink:0; }
.svc-health-chip .h-dot.online { background:#10b981; box-shadow:0 0 6px rgba(16,185,129,0.5); }
.svc-health-chip .h-dot.offline { background:#ef4444; box-shadow:0 0 6px rgba(239,68,68,0.5); }
.svc-health-chip .h-dot.pending { background:#f59e0b; animation:pulse 1s infinite; }
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }

/* ── Method filter pills ─────────────────── */
.method-pill { display:inline-flex; align-items:center; gap:4px; font-size:0.68rem; font-weight:700; padding:3px 10px; border-radius:5px; font-family:var(--mono); cursor:pointer; border:1px solid transparent; transition:all 0.15s; opacity:0.7; }
.method-pill:hover, .method-pill.active { opacity:1; transform:scale(1.05); }
.method-pill.get { background:rgba(16,185,129,0.12); color:#10b981; }
.method-pill.post { background:rgba(59,130,246,0.12); color:#3b82f6; }
.method-pill.put { background:rgba(245,158,11,0.12); color:#f59e0b; }
.method-pill.delete { background:rgba(239,68,68,0.12); color:#ef4444; }
.method-pill.active { border-color:currentColor; opacity:1; }
</style>

<!-- ── Page Header ────────────────────────────── -->
<div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:1.25rem">
  <div>
    <div style="display:flex;align-items:center;gap:0.6rem;margin-bottom:0.25rem">
      <h1 style="margin:0;font-size:1.5rem;color:var(--text-1);font-weight:700">REST Console</h1>
      <span style="font-size:0.6rem;padding:2px 8px;border-radius:4px;background:rgba(245,158,11,0.15);color:#f59e0b;font-weight:700;letter-spacing:0.5px">DEV</span>
    </div>
    <p style="color:var(--text-3);font-size:0.78rem;margin:0;line-height:1.4">Browse, test, and integrate with every API endpoint across all services.</p>
  </div>
  <div style="display:flex;align-items:center;gap:0.75rem">
    <div class="svc-health-chip" title="Agent Service" style="cursor:pointer" onclick="checkHealth()">
      <span class="h-dot pending" id="hd-agent"></span>
      <span id="hl-agent" style="color:var(--text-2)">Agent</span>
    </div>
    <div class="svc-health-chip" title="Tools Service" style="cursor:pointer" onclick="checkHealth()">
      <span class="h-dot pending" id="hd-tools"></span>
      <span id="hl-tools" style="color:var(--text-2)">Tools</span>
    </div>
  </div>
</div>

<!-- ── Stats Row ──────────────────────────────── -->
<div class="grid-4 mb-2" style="margin-bottom:1rem">
  <div class="stat-card animate-fade-up" style="cursor:pointer" onclick="openEndpointIndex()" title="Browse all endpoints">
    <div class="stat-icon stat-icon-cyan">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
    </div>
    <div class="stat-label">Total Endpoints</div>
    <div class="stat-number" id="stat-total">-</div>
  </div>
  <div class="stat-card animate-fade-up delay-100" style="cursor:pointer" onclick="document.getElementById('rest-sidebar').scrollIntoView({behavior:'smooth',block:'start'})" title="View API domains">
    <div class="stat-icon stat-icon-violet">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
    </div>
    <div class="stat-label">API Domains</div>
    <div class="stat-number" id="stat-domains">-</div>
  </div>
  <div class="stat-card animate-fade-up delay-200" style="cursor:pointer" onclick="openMethodBreakdown()" title="View method breakdown">
    <div class="stat-icon stat-icon-emerald">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
    </div>
    <div class="stat-label">Methods</div>
    <div class="stat-number" id="stat-methods">-</div>
  </div>
  <div class="stat-card animate-fade-up delay-300" style="cursor:pointer" onclick="checkHealth()" title="Check service health">
    <div class="stat-icon" id="health-icon-wrap" style="background:linear-gradient(135deg,rgba(245,158,11,0.15),rgba(245,158,11,0.08));color:#f59e0b">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
    </div>
    <div class="stat-label">Service Health</div>
    <div class="stat-number" id="stat-health" style="font-size:0.9rem">Checking...</div>
  </div>
</div>

<!-- ── Method Filter Pills ───────────────────── -->
<div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1rem">
  <span style="font-size:0.72rem;color:var(--text-3);font-weight:600;margin-right:0.25rem">FILTER:</span>
  <span class="method-pill get active" onclick="toggleMethodFilter(this, 'GET')">GET <span id="mc-get">-</span></span>
  <span class="method-pill post active" onclick="toggleMethodFilter(this, 'POST')">POST <span id="mc-post">-</span></span>
  <span class="method-pill put active" onclick="toggleMethodFilter(this, 'PUT')">PUT <span id="mc-put">-</span></span>
  <span class="method-pill delete active" onclick="toggleMethodFilter(this, 'DELETE')">DELETE <span id="mc-delete">-</span></span>
  <span style="margin-left:auto;font-size:0.72rem;color:var(--text-3)" id="filter-count"></span>
</div>

<!-- ── Base URL Bar ──────────────────────────── -->
<div class="base-url-bar">
  <span>Base URL:</span>
  <code id="rest-base-url">/api</code>
  <span class="toggle-svc active" onclick="setSvc('agent')" id="svc-agent">Agent Service</span>
  <span class="toggle-svc" onclick="setSvc('tools')" id="svc-tools">Tools Service</span>
  <div class="quick-links">
    <a href="javascript:void(0)" onclick="window.open(getSwaggerUrl(), '_blank')">
      <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-1px"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      Swagger UI</a>
    <a href="javascript:void(0)" onclick="window.open(getAgentDocsUrl(), '_blank')">OpenAPI JSON</a>
  </div>
</div>

<!-- ── Endpoint Index Modal ──────────────────── -->
<div class="ep-index-overlay" id="ep-index-overlay" onclick="if(event.target===this)closeEndpointIndex()">
  <div class="ep-index-modal">
    <div class="ep-index-header">
      <h3>All Endpoints</h3>
      <button class="ep-index-close" onclick="closeEndpointIndex()">&times;</button>
    </div>
    <div class="ep-index-search"><input type="text" id="ep-index-filter" placeholder="Filter endpoints..." oninput="filterEndpointIndex()"></div>
    <div class="ep-index-body" id="ep-index-body"></div>
  </div>
</div>

<!-- ── Method Breakdown Modal ────────────────── -->
<div class="ep-index-overlay" id="method-overlay" onclick="if(event.target===this)closeMethodBreakdown()">
  <div class="ep-index-modal" style="width:520px">
    <div class="ep-index-header">
      <h3>Method Breakdown</h3>
      <button class="ep-index-close" onclick="closeMethodBreakdown()">&times;</button>
    </div>
    <div style="padding:1.25rem" id="method-breakdown-body"></div>
  </div>
</div>

<!-- ── Main Layout ───────────────────────────── -->
<div class="rest-layout">
  <div class="rest-sidebar" id="rest-sidebar"></div>
  <div class="rest-main" id="rest-main"></div>
</div>

<script>
var currentSvc = 'agent';
var currentDomain = 'execution';
var activeMethodFilters = { GET:true, POST:true, PUT:true, DELETE:true };

// Local escapeHtml (available before layout script loads)
function _esc(str) {
  if (str == null) return '';
  return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function getAgentDocsUrl() {
  var u = window.location.origin.replace(':3000', ':8010');
  return u + '/openapi.json';
}
function getSwaggerUrl() {
  var u = window.location.origin.replace(':3000', ':8010');
  return u + '/docs';
}

var API_CATALOG = {
  execution: {
    label: 'Agent Execution',
    endpoints: [
      { method: 'POST', path: '/agent-run', desc: 'Run agent (blocking request/response)', body: '{"message":"What is 2+2?","session_id":"optional","model":"llama3","provider":"ollama","tools":["calculator"]}' },
      { method: 'POST', path: '/agent-run/stream', desc: 'Run agent with SSE streaming', body: '{"message":"Hello","session_id":"optional"}' }
    ]
  },
  agents: {
    label: 'Agents',
    endpoints: [
      { method: 'GET', path: '/agents', desc: 'List all registered agents' },
      { method: 'POST', path: '/agents', desc: 'Create a new agent', body: '{"name":"my-agent","model":"llama3","provider":"ollama","temperature":0.7,"system_prompt":"You are helpful.","skills":[],"tools":[],"guardrails":[]}' },
      { method: 'GET', path: '/agents/:id', desc: 'Get agent configuration' },
      { method: 'PUT', path: '/agents/:id', desc: 'Update agent', body: '{"name":"updated-agent","temperature":0.5}' },
      { method: 'DELETE', path: '/agents/:id', desc: 'Delete agent (cannot delete default)' }
    ]
  },
  skills: {
    label: 'Skills',
    endpoints: [
      { method: 'GET', path: '/skills', desc: 'List all skills' },
      { method: 'POST', path: '/skills', desc: 'Create a skill', body: '{"name":"researcher","description":"Web research skill","system_prompt":"You research topics.","tool_ids":["web_search"],"constraints":"Stay factual"}' },
      { method: 'GET', path: '/skills/:id', desc: 'Get skill details' },
      { method: 'PUT', path: '/skills/:id', desc: 'Update skill', body: '{"name":"updated-skill"}' },
      { method: 'DELETE', path: '/skills/:id', desc: 'Delete skill' }
    ]
  },
  prompts: {
    label: 'Prompts',
    endpoints: [
      { method: 'GET', path: '/prompts', desc: 'List all prompts' },
      { method: 'POST', path: '/prompts', desc: 'Create a prompt', body: '{"name":"summarizer","content":"Summarize the following: {{input}}","category":"utility","description":"Summarization prompt","tags":["summary"]}' },
      { method: 'GET', path: '/prompts/:id', desc: 'Get prompt details' },
      { method: 'PUT', path: '/prompts/:id', desc: 'Update prompt', body: '{"content":"Updated prompt text"}' },
      { method: 'DELETE', path: '/prompts/:id', desc: 'Delete prompt' }
    ]
  },
  tools: {
    label: 'Tools',
    endpoints: [
      { method: 'GET', path: '/tools', desc: 'List built-in + custom tools' },
      { method: 'GET', path: '/custom-tools', desc: 'List custom tools only' },
      { method: 'POST', path: '/custom-tools', desc: 'Create a custom tool', body: '{"name":"my-api","description":"Calls my API","url":"https://api.example.com/data","method":"GET","category":"api","headers":"{}","body_template":""}' },
      { method: 'GET', path: '/custom-tools/:id', desc: 'Get custom tool details' },
      { method: 'PUT', path: '/custom-tools/:id', desc: 'Update custom tool', body: '{"description":"Updated description"}' },
      { method: 'DELETE', path: '/custom-tools/:id', desc: 'Delete custom tool' }
    ]
  },
  documents: {
    label: 'Documents',
    endpoints: [
      { method: 'GET', path: '/documents', desc: 'List documents by collection' },
      { method: 'GET', path: '/documents/stats', desc: 'Vector store statistics' },
      { method: 'GET', path: '/documents/collections', desc: 'List ChromaDB collections' },
      { method: 'POST', path: '/documents/ingest', desc: 'Ingest text into vector store', body: '{"text":"Document content here","source":"my-doc.txt","collection":"default","folder":"/","chunk_size":500}' },
      { method: 'POST', path: '/documents/search', desc: 'Semantic search across documents', body: '{"query":"search query","k":5}' },
      { method: 'POST', path: '/documents/fetch-url', desc: 'Fetch & extract text from URL', body: '{"url":"https://example.com"}' },
      { method: 'DELETE', path: '/documents/:source', desc: 'Delete document by source name' },
      { method: 'POST', path: '/documents/copy', desc: 'Copy documents between collections', body: '{"source_collection":"default","target_collection":"archive","source":"doc.txt"}' },
      { method: 'GET', path: '/documents/registry', desc: 'List documents with filters (folder, agent_id, search)' },
      { method: 'GET', path: '/documents/folders', desc: 'List unique folder paths with counts' },
      { method: 'PUT', path: '/documents/registry/:doc_id/tags', desc: 'Set agent tags for a document', body: '{"agent_ids":["agent-1"]}' },
      { method: 'PUT', path: '/documents/registry/:doc_id/folder', desc: 'Move document to folder', body: '{"folder":"/archive"}' },
      { method: 'DELETE', path: '/documents/registry/:doc_id', desc: 'Delete document from registry' }
    ]
  },
  sessions: {
    label: 'Sessions',
    endpoints: [
      { method: 'GET', path: '/sessions', desc: 'List all conversation sessions' },
      { method: 'GET', path: '/sessions/:session_id/history', desc: 'Get message history (limit=100)' },
      { method: 'GET', path: '/sessions/:session_id/summary', desc: 'Get rolling conversation summary' },
      { method: 'DELETE', path: '/sessions/:session_id', desc: 'Delete session and all messages' }
    ]
  },
  guardrails: {
    label: 'Guardrails',
    endpoints: [
      { method: 'GET', path: '/guardrails', desc: 'List all guardrails (built-in + custom)' },
      { method: 'GET', path: '/guardrails/:id', desc: 'Get guardrail configuration' },
      { method: 'PUT', path: '/guardrails/:id', desc: 'Update guardrail (enabled, severity, config)', body: '{"enabled":true,"severity":"high"}' }
    ]
  },
  a2a: {
    label: 'A2A Protocol',
    endpoints: [
      { method: 'GET', path: '/a2a/peers', desc: 'List registered peer agents' },
      { method: 'POST', path: '/a2a/peers', desc: 'Register a peer agent', body: '{"name":"peer-agent","url":"http://peer:8010","description":"Remote agent","capabilities":["research"]}' },
      { method: 'GET', path: '/a2a/peers/:id', desc: 'Get peer agent details' },
      { method: 'PUT', path: '/a2a/peers/:id', desc: 'Update peer agent', body: '{"description":"Updated peer"}' },
      { method: 'DELETE', path: '/a2a/peers/:id', desc: 'Unregister peer agent' },
