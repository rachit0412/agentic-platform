<%- include('layout', { title: 'REST Console', page: 'rest', body: `

<style>
.rest-layout { display:flex; gap:1.25rem; height:calc(100vh - 140px); }
.rest-sidebar { width:220px; flex-shrink:0; overflow-y:auto; }
.rest-main { flex:1; overflow-y:auto; min-width:0; }
.domain-item { display:flex; align-items:center; justify-content:space-between; padding:0.5rem 0.75rem; border-radius:8px; cursor:pointer; font-size:0.82rem; color:var(--text-2); transition:all 0.15s; margin-bottom:2px; }
.domain-item:hover { background:var(--glass-bg); color:var(--text-1); }
.domain-item.active { background:var(--accent-bg); color:var(--accent-text); font-weight:600; }
.domain-count { font-size:0.7rem; background:var(--glass-bg); padding:1px 6px; border-radius:10px; color:var(--text-3); }
.domain-item.active .domain-count { background:rgba(6,182,212,0.2); color:var(--accent-text); }
.ep-card { border:1px solid var(--border); border-radius:10px; padding:1rem; margin-bottom:0.75rem; background:var(--glass-bg); transition:border-color 0.15s; }
.ep-card:hover { border-color:var(--glass-hover-border); }
.ep-header { display:flex; align-items:center; gap:0.75rem; cursor:pointer; }
.ep-method { font-size:0.7rem; font-weight:700; padding:3px 8px; border-radius:5px; font-family:var(--mono); letter-spacing:0.5px; min-width:52px; text-align:center; }
.ep-method.get { background:rgba(16,185,129,0.15); color:#10b981; }
.ep-method.post { background:rgba(59,130,246,0.15); color:#3b82f6; }
.ep-method.put { background:rgba(245,158,11,0.15); color:#f59e0b; }
.ep-method.delete { background:rgba(239,68,68,0.15); color:#ef4444; }
.ep-path { font-family:var(--mono); font-size:0.82rem; color:var(--text-1); font-weight:500; }
.ep-path .param { color:#8b5cf6; }
.ep-desc { font-size:0.78rem; color:var(--text-3); margin-left:auto; }
.ep-try { display:none; margin-top:1rem; padding-top:1rem; border-top:1px solid var(--border); }
.ep-try.open { display:block; }
.ep-try-grid { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
.ep-response { margin-top:0.75rem; border-radius:8px; background:var(--surface-2); max-height:300px; overflow-y:auto; font-family:var(--mono); font-size:0.78rem; color:var(--text-2); }
.ep-response pre { margin:0; padding:1rem; white-space:pre-wrap; word-break:break-all; }
.ep-status { display:inline-block; font-size:0.72rem; font-weight:700; padding:2px 8px; border-radius:4px; font-family:var(--mono); }
.ep-status.s2xx { background:rgba(16,185,129,0.15); color:#10b981; }
.ep-status.s4xx { background:rgba(245,158,11,0.15); color:#f59e0b; }
.ep-status.s5xx { background:rgba(239,68,68,0.15); color:#ef4444; }
.ep-timing { font-size:0.72rem; color:var(--text-3); margin-left:0.5rem; }
.base-url-bar { display:flex; align-items:center; gap:0.75rem; padding:0.5rem 0.75rem; background:var(--glass-bg); border:1px solid var(--border); border-radius:8px; margin-bottom:1rem; font-family:var(--mono); font-size:0.8rem; color:var(--text-2); }
.base-url-bar code { color:var(--accent-text); font-weight:600; }
.base-url-bar .toggle-svc { font-size:0.72rem; padding:3px 8px; border-radius:5px; cursor:pointer; border:1px solid var(--border); background:var(--glass-bg); color:var(--text-2); transition:all 0.15s; }
.base-url-bar .toggle-svc.active { background:var(--accent-bg); color:var(--accent-text); border-color:var(--accent-text); }
.quick-links { display:flex; gap:0.5rem; margin-left:auto; }
.quick-links a { font-size:0.72rem; padding:3px 10px; border-radius:5px; background:var(--glass-bg); border:1px solid var(--border); color:var(--text-2); text-decoration:none; transition:all 0.15s; }
.quick-links a:hover { background:var(--accent-bg); color:var(--accent-text); }
/* Stat tiles */
.rest-stat { text-align:center; padding:1rem; cursor:pointer; transition:all 0.2s; position:relative; }
.rest-stat:hover { border-color:var(--accent-text); transform:translateY(-1px); }
.rest-stat .stat-val { font-size:1.75rem; font-weight:700; }
.rest-stat .stat-label { font-size:0.75rem; color:var(--text-3); }
.rest-stat .stat-hint { font-size:0.62rem; color:var(--text-3); opacity:0; transition:opacity 0.15s; margin-top:2px; }
.rest-stat:hover .stat-hint { opacity:1; }
/* Method breakdown mini-bars */
.method-bars { display:flex; gap:6px; justify-content:center; margin-top:6px; }
.method-bars .mb { font-size:0.62rem; font-weight:700; padding:1px 5px; border-radius:3px; font-family:var(--mono); }
/* Health dots */
.health-row { display:flex; align-items:center; gap:6px; justify-content:center; margin-top:4px; }
.health-dot { width:8px; height:8px; border-radius:50%; }
.health-dot.online { background:#10b981; box-shadow:0 0 6px rgba(16,185,129,0.5); }
.health-dot.offline { background:#ef4444; box-shadow:0 0 6px rgba(239,68,68,0.5); }
.health-dot.pending { background:#f59e0b; animation:pulse 1s infinite; }
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }
/* Endpoint Index Modal */
.ep-index-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:1000; backdrop-filter:blur(4px); }
.ep-index-overlay.open { display:flex; align-items:center; justify-content:center; }
.ep-index-modal { background:var(--bg-1); border:1px solid var(--border); border-radius:12px; width:720px; max-width:90vw; max-height:80vh; display:flex; flex-direction:column; box-shadow:0 20px 60px rgba(0,0,0,0.4); }
.ep-index-header { display:flex; align-items:center; justify-content:space-between; padding:1rem 1.25rem; border-bottom:1px solid var(--border); }
.ep-index-header h3 { margin:0; font-size:1rem; color:var(--text-1); }
.ep-index-search { margin:0; padding:0.5rem 1.25rem; border-bottom:1px solid var(--border); }
.ep-index-search input { width:100%; background:var(--glass-bg); border:1px solid var(--border); border-radius:6px; padding:0.4rem 0.6rem; font-size:0.8rem; color:var(--text-1); outline:none; }
.ep-index-search input:focus { border-color:var(--accent-text); }
.ep-index-body { overflow-y:auto; padding:0.5rem 0; flex:1; }
.ep-index-item { display:flex; align-items:center; gap:0.6rem; padding:0.35rem 1.25rem; cursor:pointer; font-size:0.8rem; transition:background 0.1s; }
.ep-index-item:hover { background:var(--glass-bg); }
.ep-index-item .eii-domain { font-size:0.65rem; color:var(--text-3); margin-left:auto; min-width:80px; text-align:right; }
.ep-index-close { background:none; border:none; color:var(--text-3); cursor:pointer; font-size:1.2rem; padding:4px 8px; border-radius:4px; }
.ep-index-close:hover { background:var(--glass-bg); color:var(--text-1); }
/* Swagger link in domain header */
.domain-swagger { font-size:0.68rem; color:var(--text-3); text-decoration:none; margin-left:0.5rem; padding:1px 6px; border-radius:4px; border:1px solid var(--border); transition:all 0.15s; }
.domain-swagger:hover { color:var(--accent-text); border-color:var(--accent-text); }
</style>

<div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.25rem">
  <h1 class="text-glow-cyan" style="margin:0">REST Console</h1>
  <span style="font-size:0.65rem;padding:2px 8px;border-radius:4px;background:rgba(245,158,11,0.15);color:#f59e0b;font-weight:700;letter-spacing:0.5px">DEV</span>
</div>
<p style="color:var(--text-3);font-size:0.78rem;margin-bottom:1.25rem;line-height:1.5">Browse, test, and integrate with every API endpoint. Click tiles below for details.</p>

<!-- Stats Row -->
<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-bottom:1.25rem">
  <div class="card rest-stat" onclick="openEndpointIndex()">
    <div class="stat-val" style="color:var(--cyan)" id="stat-total">69</div>
    <div class="stat-label">Total Endpoints</div>
    <div class="stat-hint">Click to browse all</div>
  </div>
  <div class="card rest-stat" onclick="openEndpointIndex()">
    <div class="stat-val" style="color:#8b5cf6" id="stat-methods">—</div>
    <div class="stat-label">Methods</div>
    <div class="method-bars" id="method-bars"></div>
    <div class="stat-hint">Click to filter</div>
  </div>
  <div class="card rest-stat" onclick="refreshHealth()">
    <div style="display:flex;align-items:center;justify-content:center;gap:1rem;margin-bottom:4px">
      <div style="text-align:center">
        <div class="health-row"><span class="health-dot pending" id="hd-agent"></span><span style="font-size:0.78rem;font-weight:600;color:var(--text-2)" id="hl-agent">...</span></div>
        <div style="font-size:0.62rem;color:var(--text-3)">Agent :8010</div>
      </div>
      <div style="width:1px;height:24px;background:var(--border)"></div>
      <div style="text-align:center">
        <div class="health-row"><span class="health-dot pending" id="hd-tools"></span><span style="font-size:0.78rem;font-weight:600;color:var(--text-2)" id="hl-tools">...</span></div>
        <div style="font-size:0.62rem;color:var(--text-3)">Tools :8011</div>
      </div>
    </div>
    <div class="stat-label">Service Health</div>
    <div class="stat-hint">Click to refresh</div>
  </div>
</div>

<!-- Base URL Bar -->
<div class="base-url-bar">
  <span>Base URL:</span>
  <code id="rest-base-url">/api</code>
  <span class="toggle-svc active" onclick="setSvc('agent')" id="svc-agent">Agent Service</span>
  <span class="toggle-svc" onclick="setSvc('tools')" id="svc-tools">Tools Service</span>
  <div class="quick-links">
    <a href="javascript:void(0)" onclick="window.open(getSwaggerUrl(), '_blank')">
      <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-1px"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      Swagger UI</a>
    <a href="javascript:void(0)" onclick="window.open(getAgentDocsUrl(), '_blank')">OpenAPI JSON</a>
  </div>
</div>

<!-- Endpoint Index Modal -->
<div class="ep-index-overlay" id="ep-index-overlay" onclick="if(event.target===this)closeEndpointIndex()">
  <div class="ep-index-modal">
    <div class="ep-index-header">
      <h3>All Endpoints</h3>
      <button class="ep-index-close" onclick="closeEndpointIndex()">&times;</button>
    </div>
    <div class="ep-index-search"><input type="text" id="ep-index-filter" placeholder="Filter endpoints..." oninput="filterEndpointIndex()"></div>
    <div class="ep-index-body" id="ep-index-body"></div>
  </div>
</div>

<!-- Main Layout -->
<div class="rest-layout">
  <div class="rest-sidebar" id="rest-sidebar"></div>
  <div class="rest-main" id="rest-main"></div>
</div>

<script>
