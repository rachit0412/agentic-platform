function setSvc(svc) {
  currentSvc = svc;
  document.getElementById('svc-agent').className = 'toggle-svc' + (svc === 'agent' ? ' active' : '');
  document.getElementById('svc-tools').className = 'toggle-svc' + (svc === 'tools' ? ' active' : '');
  document.getElementById('rest-base-url').textContent = svc === 'agent' ? '/api' : '/api/tools-svc';
}

// ── Compute stats ──────────────────────────────
function computeStats() {
  var counts = { GET:0, POST:0, PUT:0, DELETE:0 };
  var total = 0;
  var keys = Object.keys(API_CATALOG);
  for (var i = 0; i < keys.length; i++) {
    var eps = API_CATALOG[keys[i]].endpoints;
    total += eps.length;
    for (var j = 0; j < eps.length; j++) counts[eps[j].method]++;
  }
  document.getElementById('stat-total').textContent = total;
  document.getElementById('stat-domains').textContent = keys.length;
  document.getElementById('stat-methods').textContent = Object.values(counts).filter(function(v){return v>0}).length + ' types';
  document.getElementById('mc-get').textContent = counts.GET;
  document.getElementById('mc-post').textContent = counts.POST;
  document.getElementById('mc-put').textContent = counts.PUT;
  document.getElementById('mc-delete').textContent = counts.DELETE;
  updateFilterCount();
}

// ── Method filter toggle ──────────────────────
function toggleMethodFilter(el, method) {
  activeMethodFilters[method] = !activeMethodFilters[method];
  el.classList.toggle('active');
  renderEndpoints();
  updateFilterCount();
}

function updateFilterCount() {
  var total = 0; var shown = 0;
  var keys = Object.keys(API_CATALOG);
  for (var i = 0; i < keys.length; i++) {
    var eps = API_CATALOG[keys[i]].endpoints;
    for (var j = 0; j < eps.length; j++) {
      total++;
      if (activeMethodFilters[eps[j].method]) shown++;
    }
  }
  var el = document.getElementById('filter-count');
  if (el) el.textContent = shown === total ? total + ' endpoints' : shown + ' of ' + total + ' shown';
}

// ── Endpoint Index Modal ──────────────────────
function getAllEndpoints() {
  var all = [];
  var keys = Object.keys(API_CATALOG);
  for (var i = 0; i < keys.length; i++) {
    var d = API_CATALOG[keys[i]];
    for (var j = 0; j < d.endpoints.length; j++) {
      all.push({ domain: keys[i], domainLabel: d.label, method: d.endpoints[j].method, path: d.endpoints[j].path, desc: d.endpoints[j].desc });
    }
  }
  return all;
}

function openEndpointIndex() {
  var overlay = document.getElementById('ep-index-overlay');
  overlay.classList.add('open');
  document.getElementById('ep-index-filter').value = '';
  renderEndpointIndex('');
  setTimeout(function(){ document.getElementById('ep-index-filter').focus(); }, 50);
}
function closeEndpointIndex() { document.getElementById('ep-index-overlay').classList.remove('open'); }
function filterEndpointIndex() { renderEndpointIndex(document.getElementById('ep-index-filter').value); }

function renderEndpointIndex(filter) {
  var all = getAllEndpoints();
  var q = filter.toLowerCase();
  var body = document.getElementById('ep-index-body');
  var html = '';
  var shown = 0;
  for (var i = 0; i < all.length; i++) {
    var ep = all[i];
    if (q && ep.method.toLowerCase().indexOf(q) === -1 && ep.path.toLowerCase().indexOf(q) === -1 && ep.desc.toLowerCase().indexOf(q) === -1 && ep.domainLabel.toLowerCase().indexOf(q) === -1) continue;
    var m = ep.method.toLowerCase();
    html += '<div class="ep-index-item" onclick="jumpToEndpoint(\\'' + ep.domain + '\\', \\'' + ep.path + '\\')">';
    html += '<span class="ep-method ' + m + '">' + ep.method + '</span>';
    html += '<span class="ep-path">' + highlightPath(ep.path) + '</span>';
    html += '<span class="eii-domain">' + _esc(ep.domainLabel) + '</span>';
    html += '</div>';
    shown++;
  }
  if (shown === 0) html = '<div style="padding:2rem;text-align:center;color:var(--text-3)">No endpoints match filter</div>';
  body.innerHTML = html;
}

function jumpToEndpoint(domain, path) {
  closeEndpointIndex();
  selectDomain(domain);
  setTimeout(function() {
    var eps = API_CATALOG[domain].endpoints;
    for (var i = 0; i < eps.length; i++) {
      if (eps[i].path === path) {
        var card = document.getElementById('card-' + domain + '-' + i);
        if (card) { card.scrollIntoView({ behavior:'smooth', block:'center' }); card.style.borderColor = 'var(--accent-text)'; setTimeout(function(){ card.style.borderColor = ''; }, 1500); }
        break;
      }
    }
  }, 100);
}

// ── Sidebar ───────────────────────────────────
function renderSidebar() {
  var sb = document.getElementById('rest-sidebar');
  var html = '';
  var keys = Object.keys(API_CATALOG);
  for (var i = 0; i < keys.length; i++) {
    var k = keys[i];
    var d = API_CATALOG[k];
    var cnt = d.endpoints.length;
    var cls = k === currentDomain ? ' active' : '';
    html += '<div class="domain-item' + cls + '" onclick="selectDomain(\\'' + k + '\\')">';
    html += '<span>' + _esc(d.label) + '</span>';
    html += '<span class="domain-count">' + cnt + '</span>';
    html += '</div>';
  }
  sb.innerHTML = html;
}

function selectDomain(domain) {
  currentDomain = domain;
  renderSidebar();
  renderEndpoints();
}

function highlightPath(path) {
  return path.replace(/:[a-z_]+/g, function(m) {
    return '<span class="param">' + m + '</span>';
  });
}

// ── Endpoint rendering ───────────────────────
function renderEndpoints() {
  var main = document.getElementById('rest-main');
  var d = API_CATALOG[currentDomain];
  if (!d) { main.innerHTML = ''; return; }
  var swaggerUrl = getSwaggerUrl() + '#/' + encodeURIComponent(d.label);
  var html = '<div style="display:flex;align-items:center;margin-bottom:1rem">';
  html += '<h2 style="font-size:1.1rem;margin:0;color:var(--text-1)">' + _esc(d.label) + ' <span style="font-size:0.78rem;color:var(--text-3);font-weight:400">(' + d.endpoints.length + ' endpoints)</span></h2>';
  html += '<a class="domain-swagger" href="' + swaggerUrl + '" target="_blank" rel="noopener">Swagger &#x2197;</a>';
  html += '</div>';
  var visibleCount = 0;
  for (var i = 0; i < d.endpoints.length; i++) {
    var ep = d.endpoints[i];
    if (!activeMethodFilters[ep.method]) continue;
    visibleCount++;
    var m = ep.method.toLowerCase();
    var epId = currentDomain + '-' + i;
    html += '<div class="ep-card" id="card-' + epId + '">';
    html += '<div class="ep-header" onclick="toggleTry(\\'' + epId + '\\')">';
    html += '<span class="ep-method ' + m + '">' + ep.method + '</span>';
    html += '<span class="ep-path">' + highlightPath(ep.path) + '</span>';
    html += '<span class="ep-desc">' + _esc(ep.desc) + '</span>';
    html += '</div>';
    html += '<div class="ep-try" id="try-' + epId + '">';
    var params = ep.path.match(/:[a-z_]+/g) || [];
    if (params.length > 0 || ep.body) {
      html += '<div class="ep-try-grid">';
      html += '<div>';
      if (params.length > 0) {
        html += '<label class="field-label">Path Parameters</label>';
        for (var p = 0; p < params.length; p++) {
          var pname = params[p].substring(1);
          html += '<div style="margin-bottom:0.5rem"><label style="font-size:0.72rem;color:var(--text-3)">' + pname + '</label>';
          html += '<input type="text" class="input" id="param-' + epId + '-' + pname + '" placeholder="' + pname + '" style="font-size:0.8rem;margin-top:2px"></div>';
        }
      }
      if (!ep.body && params.length === 0) {
        html += '<p style="font-size:0.78rem;color:var(--text-3)">No parameters required</p>';
      }
      html += '</div>';
      html += '<div>';
      if (ep.body) {
        html += '<label class="field-label">Request Body (JSON)</label>';
        html += '<textarea class="input" id="body-' + epId + '" rows="6" style="font-family:var(--mono);font-size:0.78rem;resize:vertical">' + _esc(ep.body) + '</textarea>';
      }
      html += '</div>';
      html += '</div>';
    } else {
      html += '<p style="font-size:0.78rem;color:var(--text-3);margin-bottom:0.75rem">No parameters required</p>';
    }
    html += '<div style="display:flex;gap:0.5rem;align-items:center;margin-top:0.75rem">';
    html += '<button class="btn btn-primary" onclick="sendRequest(\\'' + epId + '\\', \\'' + ep.method + '\\', \\'' + ep.path + '\\')">';
    html += '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg> Send</button>';
    html += '<span id="status-' + epId + '"></span>';
    html += '</div>';
    html += '<div class="ep-response" id="resp-' + epId + '" style="display:none"><pre></pre></div>';
    html += '</div>';
    html += '</div>';
  }
  if (visibleCount === 0) {
    html += '<div style="padding:2rem;text-align:center;color:var(--text-3);font-size:0.85rem">No endpoints match current method filters</div>';
  }
  main.innerHTML = html;
}

function toggleTry(epId) {
  var el = document.getElementById('try-' + epId);
  if (el) el.classList.toggle('open');
}

async function sendRequest(epId, method, pathTemplate) {
  var path = pathTemplate;
  var params = pathTemplate.match(/:[a-z_]+/g) || [];
  for (var i = 0; i < params.length; i++) {
    var pname = params[i].substring(1);
    var input = document.getElementById('param-' + epId + '-' + pname);
    var val = input ? input.value.trim() : '';
    if (!val) { showToast('Please fill in parameter: ' + pname, 'warning'); return; }
    path = path.replace(params[i], encodeURIComponent(val));
  }

  var statusEl = document.getElementById('status-' + epId);
  var respEl = document.getElementById('resp-' + epId);
  var preEl = respEl.querySelector('pre');
  statusEl.innerHTML = '<span style="color:#f59e0b;font-size:0.78rem">Sending...</span>';
  respEl.style.display = 'none';

  var url = '/api' + path;
  var opts = { method: method, headers: {} };
  if (method === 'POST' || method === 'PUT') {
    opts.headers['Content-Type'] = 'application/json';
    var bodyEl = document.getElementById('body-' + epId);
    if (bodyEl && bodyEl.value.trim()) {
      try {
        JSON.parse(bodyEl.value);
        opts.body = bodyEl.value.trim();
      } catch(e) {
        showToast('Invalid JSON in request body', 'error');
        statusEl.innerHTML = '';
        return;
      }
    }
  }

  var t0 = performance.now();
  try {
    var resp = await fetch(url, opts);
    var elapsed = Math.round(performance.now() - t0);
    var data;
    var ct = resp.headers.get('content-type') || '';
    if (ct.includes('json')) {
      data = await resp.json();
      preEl.textContent = JSON.stringify(data, null, 2);
    } else {
      data = await resp.text();
      preEl.textContent = data;
    }
    var sCls = resp.status < 300 ? 's2xx' : resp.status < 500 ? 's4xx' : 's5xx';
    statusEl.innerHTML = '<span class="ep-status ' + sCls + '">' + resp.status + '</span><span class="ep-timing">' + elapsed + 'ms</span>';
    respEl.style.display = 'block';
  } catch(e) {
    statusEl.innerHTML = '<span class="ep-status s5xx">ERR</span><span class="ep-timing">' + e.message + '</span>';
    preEl.textContent = e.message;
    respEl.style.display = 'block';
  }
}

// ── Health check ──────────────────────────────
async function checkHealth() {
  var dotAgent = document.getElementById('hd-agent');
  var lblAgent = document.getElementById('hl-agent');
  var dotTools = document.getElementById('hd-tools');
  var lblTools = document.getElementById('hl-tools');
  var statHealth = document.getElementById('stat-health');
  var iconWrap = document.getElementById('health-icon-wrap');

  dotAgent.className = 'h-dot pending';
  dotTools.className = 'h-dot pending';
  lblAgent.textContent = 'Agent';
  lblTools.textContent = 'Tools';
  lblAgent.style.color = 'var(--text-2)';
  lblTools.style.color = 'var(--text-2)';
  statHealth.textContent = 'Checking...';
  statHealth.style.color = '#f59e0b';
  iconWrap.style.background = 'linear-gradient(135deg,rgba(245,158,11,0.15),rgba(245,158,11,0.08))';
  iconWrap.style.color = '#f59e0b';

  try {
    var r = await fetch('/api/health-check', { signal: AbortSignal.timeout(5000) });
    var data = await r.json();
    var agentSvc = data.services.find(function(s){ return s.name === 'agent-service'; });
    var toolsSvc = data.services.find(function(s){ return s.name === 'tools-service'; });

    var agentOk = agentSvc && agentSvc.status === 'healthy';
    var toolsOk = toolsSvc && toolsSvc.status === 'healthy';

    dotAgent.className = 'h-dot ' + (agentOk ? 'online' : 'offline');
    lblAgent.style.color = agentOk ? '#10b981' : '#ef4444';

    dotTools.className = 'h-dot ' + (toolsOk ? 'online' : 'offline');
    lblTools.style.color = toolsOk ? '#10b981' : '#ef4444';

    var allOk = agentOk && toolsOk;
    var noneOk = !agentOk && !toolsOk;
    if (allOk) {
      statHealth.textContent = 'All Healthy';
      statHealth.style.color = '#10b981';
      iconWrap.style.background = 'linear-gradient(135deg,rgba(16,185,129,0.15),rgba(16,185,129,0.08))';
      iconWrap.style.color = '#10b981';
    } else if (noneOk) {
      statHealth.textContent = 'Services Down';
      statHealth.style.color = '#ef4444';
      iconWrap.style.background = 'linear-gradient(135deg,rgba(239,68,68,0.15),rgba(239,68,68,0.08))';
      iconWrap.style.color = '#ef4444';
    } else {
      statHealth.textContent = 'Degraded';
      statHealth.style.color = '#f59e0b';
    }
  } catch(e) {
    dotAgent.className = 'h-dot offline';
    dotTools.className = 'h-dot offline';
    lblAgent.style.color = '#ef4444';
    lblTools.style.color = '#ef4444';
    statHealth.textContent = 'Unreachable';
    statHealth.style.color = '#ef4444';
    iconWrap.style.background = 'linear-gradient(135deg,rgba(239,68,68,0.15),rgba(239,68,68,0.08))';
    iconWrap.style.color = '#ef4444';
  }
}
var refreshHealth = checkHealth;

// ── Method Breakdown Modal ─────────────────────
function openMethodBreakdown() {
  var counts = { GET:0, POST:0, PUT:0, DELETE:0 };
  var total = 0;
  var domainData = [];
  var keys = Object.keys(API_CATALOG);
  for (var i = 0; i < keys.length; i++) {
    var d = API_CATALOG[keys[i]];
    var dc = { label: d.label, GET:0, POST:0, PUT:0, DELETE:0 };
    for (var j = 0; j < d.endpoints.length; j++) {
      var m = d.endpoints[j].method;
      counts[m]++; dc[m]++; total++;
    }
    domainData.push(dc);
  }
  var maxCount = Math.max(counts.GET, counts.POST, counts.PUT, counts.DELETE, 1);
  var methods = [
    { key:'GET', color:'get', label:'GET' },
    { key:'POST', color:'post', label:'POST' },
    { key:'PUT', color:'put', label:'PUT' },
    { key:'DELETE', color:'delete', label:'DELETE' }
  ];
  var html = '<div class="method-breakdown-bar">';
  for (var m = 0; m < methods.length; m++) {
    var mi = methods[m];
    var pct = Math.max(8, (counts[mi.key] / maxCount) * 100);
    html += '<div class="mb-col">';
    html += '<div class="mb-count">' + counts[mi.key] + '</div>';
    html += '<div class="mb-bar ' + mi.color + '" style="height:' + pct + '%"></div>';
    html += '<div class="mb-label" style="color:' + getMethodColor(mi.key) + '">' + mi.label + '</div>';
    html += '</div>';
  }
  html += '</div>';
  html += '<div style="text-align:center;font-size:0.78rem;color:var(--text-3);margin:0.5rem 0 0.75rem">' + total + ' total endpoints</div>';
  html += '<div style="font-size:0.72rem;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.35rem">By Domain</div>';
  html += '<div class="mb-domain-list">';
  for (var d = 0; d < domainData.length; d++) {
    var dd = domainData[d];
    html += '<div class="mb-domain-row">';
    html += '<span class="mb-domain-name">' + _esc(dd.label) + '</span>';
    html += '<span class="mb-domain-counts">';
    if (dd.GET) html += '<span class="mb-dc" style="background:rgba(16,185,129,0.12);color:#10b981">' + dd.GET + ' GET</span>';
    if (dd.POST) html += '<span class="mb-dc" style="background:rgba(59,130,246,0.12);color:#3b82f6">' + dd.POST + ' POST</span>';
    if (dd.PUT) html += '<span class="mb-dc" style="background:rgba(245,158,11,0.12);color:#f59e0b">' + dd.PUT + ' PUT</span>';
    if (dd.DELETE) html += '<span class="mb-dc" style="background:rgba(239,68,68,0.12);color:#ef4444">' + dd.DELETE + ' DEL</span>';
    html += '</span></div>';
  }
  html += '</div>';
  document.getElementById('method-breakdown-body').innerHTML = html;
  document.getElementById('method-overlay').classList.add('open');
}
function closeMethodBreakdown() { document.getElementById('method-overlay').classList.remove('open'); }
function getMethodColor(m) {
  if (m === 'GET') return '#10b981';
  if (m === 'POST') return '#3b82f6';
  if (m === 'PUT') return '#f59e0b';
  return '#ef4444';
}

// ── Init (deferred so layout scripts load first) ──
setTimeout(function() {
  computeStats();
  renderSidebar();
  renderEndpoints();
  checkHealth();
}, 0);
<\/script>

