      { method: 'DELETE', path: '/prompts/:id', desc: 'Delete prompt' }
    ]
  },
  tools: {
    label: 'Tools',
    endpoints: [
      { method: 'GET', path: '/tools', desc: 'List built-in + custom tools' },
      { method: 'GET', path: '/custom-tools', desc: 'List custom tools only' },
      { method: 'POST', path: '/custom-tools', desc: 'Create a custom tool', body: '{"name":"my-api","description":"Calls my API","url":"https://api.example.com/data","method":"GET","category":"api","headers":"{}","body_template":""}' },
      { method: 'GET', path: '/custom-tools/:id', desc: 'Get custom tool details' },
      { method: 'PUT', path: '/custom-tools/:id', desc: 'Update custom tool', body: '{"description":"Updated description"}' },
      { method: 'DELETE', path: '/custom-tools/:id', desc: 'Delete custom tool' }
    ]
  },
