# ── n8n ──────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=changeme
N8N_PORT=5678

# ── Ollama ───────────────────────────────────────────────
OLLAMA_MODEL=llama3
OLLAMA_PORT=11436

# ── Agent service ────────────────────────────────────────
AGENT_PORT=8010

# ── Tools service ────────────────────────────────────────
TOOLS_PORT=8011

# ── UI (platform dashboard) ──────────────────────────────
UI_PORT=3000

# ── Langfuse (LLM observability) ────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev
LANGFUSE_PORT=3002
LANGFUSE_DB_PASSWORD=langfuse
LANGFUSE_NEXTAUTH_SECRET=supersecret-nextauth
LANGFUSE_SALT=supersecret-salt

# ── Grafana ──────────────────────────────────────────────
GRAFANA_PORT=3003
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── Prometheus ───────────────────────────────────────────
PROMETHEUS_PORT=9090

# ── Loki ─────────────────────────────────────────────────
LOKI_PORT=3100

# ── OpenTelemetry Collector ──────────────────────────────
OTEL_HTTP_PORT=4318
OTEL_GRPC_PORT=4317

# ── (Optional) ChromaDB — enable with: docker compose --profile vector up -d
CHROMA_URL=http://chromadb:8000
CHROMA_PORT=8200
