# ── Docker Image Versions (Optional: Override for compatibility) ───────────
# Default versions are security-patched and tested. Override with caution.
# To use: Set environment variable before running docker compose
#   export N8N_IMAGE_TAG=latest  # To always use latest (not recommended for production)
N8N_IMAGE_TAG=latest
NGINX_IMAGE_TAG=1.27.0-alpine
OLLAMA_IMAGE_TAG=latest
PROMETHEUS_IMAGE_TAG=latest
LANGFUSE_IMAGE_TAG=latest

# ── n8n ──────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=changeme
N8N_PORT=5678

# ── Ollama ───────────────────────────────────────────────
OLLAMA_MODEL=llama3
OLLAMA_PORT=11436

# ── Agent service ────────────────────────────────────────
AGENT_PORT=8010

# ── Tools service ────────────────────────────────────────
TOOLS_PORT=8011

# ── UI (platform dashboard) ──────────────────────────────
UI_PORT=3005

# ── Session & Auth (CHANGE THESE IN PRODUCTION!) ────────
# Generate with: openssl rand -base64 64 | tr -d '\n'
SESSION_SECRET=
# Seed user passwords — set before first startup. After DB is seeded, change via admin UI.
ADMIN_SEED_PASSWORD=
RACHIT_SEED_PASSWORD=

# ── Langfuse (LLM observability) ────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev
LANGFUSE_PORT=3012
LANGFUSE_DB_PASSWORD=langfuse
LANGFUSE_NEXTAUTH_SECRET=supersecret-nextauth
LANGFUSE_SALT=supersecret-salt

# ── Grafana ──────────────────────────────────────────────
GRAFANA_PORT=3013
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── Prometheus ───────────────────────────────────────────
PROMETHEUS_PORT=9090

# ── Loki ─────────────────────────────────────────────────
LOKI_PORT=3100

# ── OpenTelemetry Collector ──────────────────────────────
OTEL_HTTP_PORT=4318
OTEL_GRPC_PORT=4317

# ── Azure OpenAI (optional — much faster than local Ollama) ──────────────
# Get these from Azure Portal → your OpenAI resource → Keys and Endpoint
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-06-01
# Set LLM_PROVIDER=azure-openai to use Azure OpenAI by default
LLM_PROVIDER=ollama

# ── OpenAI (optional — alternative to Azure, faster than Ollama) ─────────
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set LLM_PROVIDER=openai to use OpenAI by default

# ── Azure AI Foundry (optional — enterprise-grade models) ────────────────
# Get these from Azure AI Foundry portal → your project → API keys
# Set LLM_PROVIDER=azure-foundry to use Foundry by default
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_MODEL=
AZURE_FOUNDRY_MODELS=
AZURE_FOUNDRY_API_VERSION=2024-10-21

# ── Groq (optional — very fast open-source models) ────────────────────────
# Get from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=mixtral-8x7b-32768
# Set LLM_PROVIDER=groq to use Groq by default

# ── Anthropic (Claude models) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-1

# ── Social Sign-On (SSO) — Optional ─────────────────────────────────────────
# Google OAuth2 (https://console.cloud.google.com/)
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=

# GitHub OAuth2 (https://github.com/settings/developers)
SSO_GITHUB_CLIENT_ID=
SSO_GITHUB_CLIENT_SECRET=

# Microsoft/Entra ID (https://portal.azure.com/)
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=

# Base URL for SSO callbacks (must match your OAuth app redirect URIs)
SSO_BASE_URL=http://localhost:3005

# ── External Tool Integrations (optional) ───────────────────────────────────
# Brave Search (for web search tool)
BRAVE_API_KEY=

# (Optional) ChromaDB — enable with: docker compose --profile vector up -d
CHROMA_URL=http://chromadb:8000
CHROMA_PORT=8200
